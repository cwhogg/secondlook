  "diagnosticCriteria": {
    "formalCriteriaName": "Biochemical and Genetic Diagnostic Criteria for CACT Deficiency",
    "criteria": [
      {
        "id": "hypoketotic-hypoglycemia",
        "description": "Presence of hypoketotic hypoglycemia during metabolic crisis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-acylcarnitines",
        "description": "Elevated long-chain acylcarnitines (C16, C18:1) on tandem mass spectrometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the SLC25A20 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiomyopathy",
        "description": "Clinical or echocardiographic evidence of cardiomyopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-weakness",
        "description": "Presence of hypotonia or muscle weakness",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypoketotic hypoglycemia, elevated long-chain acylcarnitines, and pathogenic SLC25A20 variants",
    "notes": "Early diagnosis is critical due to risk of sudden infant death; newborn screening may detect biochemical abnormalities."
  },
