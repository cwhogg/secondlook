  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Thalidomide Embryopathy",
    "criteria": [
      {
        "id": "limb-malformations",
        "description": "Presence of characteristic limb defects such as phocomelia or amelia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ear-abnormalities",
        "description": "External ear malformations including microtia or anotia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "Ocular defects such as coloboma or microphthalmia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-malformations",
        "description": "Congenital heart defects including septal defects",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "maternal-thalidomide-exposure",
        "description": "Confirmed history of maternal thalidomide use during pregnancy",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of major limb malformations and ear abnormalities with confirmed maternal thalidomide exposure",
    "notes": "Diagnosis is primarily clinical supported by maternal drug history; genetic testing is not diagnostic."
  },
