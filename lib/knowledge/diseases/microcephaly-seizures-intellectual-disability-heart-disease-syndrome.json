  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for MSIHD Syndrome",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Head circumference significantly below the 3rd percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "Recurrent unprovoked seizures beginning in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability confirmed by neuropsychological testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-disease",
        "description": "Structural heart defects identified by echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Presence of facial dysmorphisms such as micrognathia or low-set ears",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "abnormal-mri",
        "description": "Brain MRI showing cortical malformations or simplified gyral pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all four major criteria: microcephaly, seizures, intellectual disability, and congenital heart disease",
    "notes": "Genetic testing may support diagnosis but is not mandatory; exclusion of other syndromes with overlapping features is essential."
  },
