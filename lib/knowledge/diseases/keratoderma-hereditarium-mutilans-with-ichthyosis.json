  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Keratoderma Hereditarium Mutilans with Ichthyosis",
    "criteria": [
      {
        "id": "palmoplantar-keratoderma",
        "description": "Diffuse or punctate palmoplantar keratoderma with mutilating features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ichthyosis",
        "description": "Generalized ichthyosis characterized by widespread scaling of the skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pseudoainhum",
        "description": "Constriction bands leading to autoamputation of digits (pseudoainhum)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in GJB2 gene (connexin 26)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of diffuse palmoplantar keratoderma with ichthyosis and pseudoainhum; genetic confirmation supports diagnosis",
    "notes": "Diagnosis is primarily clinical; genetic testing can confirm but is not mandatory."
  },
