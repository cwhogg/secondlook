  "diagnosticCriteria": {
    "formalCriteriaName": "Fountain Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including microcephaly, prominent nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal anomalies such as clinodactyly, brachydactyly, and joint contractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-features",
        "description": "Hypotonia and motor delay",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (craniofacial dysmorphism, intellectual disability, and skeletal abnormalities)",
    "notes": "Diagnosis is clinical; genetic testing may assist but no specific gene identified"
  },
