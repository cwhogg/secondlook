  "keyFindings": {
    "laboratory": [
      "Hypophosphatemia with renal phosphate wasting",
      "Glycosuria with normal blood glucose",
      "Elevated liver enzymes",
      "Fasting hypoglycemia and postprandial hyperglycemia",
      "Metabolic acidosis"
    ],
    "imaging": [
      "Hepatomegaly on abdominal ultrasound",
      "Radiographic evidence of rickets",
      "Possible hepatic fibrosis on liver imaging"
    ],
    "genetic": [
      "Pathogenic mutations in SLC2A2 gene encoding GLUT2 transporter"
    ],
    "other": [
      "Abnormal glucose tolerance test",
      "Elevated serum lactate"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "glycogen-storage-disease-type-ia",
      "distinguishingFeatures": [
        "Severe fasting hypoglycemia",
        "Lactic acidosis more prominent",
        "No renal tubular dysfunction"
      ]
    },
    {
      "diseaseId": "fanconi-syndrome-secondary",
      "distinguishingFeatures": [
        "Renal tubular dysfunction due to acquired causes",
        "Absence of hepatomegaly and glycogen accumulation",
        "No SLC2A2 mutations"
      ]
    },
    {
      "diseaseId": "hereditary-fructose-intolerance",
      "distinguishingFeatures": [
        "Symptoms triggered by fructose ingestion",
        "No renal tubular dysfunction",
        "Different genetic mutation (ALDOB gene)"
      ]
    }
  ],
