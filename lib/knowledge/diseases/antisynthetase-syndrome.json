  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (CK)",
      "Positive antisynthetase antibodies (anti-Jo-1, anti-PL-7, anti-PL-12)",
      "Elevated inflammatory markers (ESR, CRP)"
    ],
    "imaging": [
      "High-resolution CT showing ground-glass opacities and fibrosis consistent with interstitial lung disease",
      "MRI of muscles showing edema and inflammation"
    ],
    "genetic": [
      "No specific genetic mutation identified; association with HLA-DRB1*03 allele reported"
    ],
    "other": [
      "Electromyography showing myopathic changes",
      "Muscle biopsy demonstrating inflammatory infiltrates"
    ]
  },
