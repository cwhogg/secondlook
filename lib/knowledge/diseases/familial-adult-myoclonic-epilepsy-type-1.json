          "adult generalized convulsions"
        ]
      },
      {
        "symptomName": "Electroencephalographic cortical reflex myoclonus",
        "frequency": 0.75,
        "bodySystem": "neurological",
        "notes": "EEG correlate of myoclonic jerks",
        "searchTerms": [
          "brain wave abnormalities causing jerks",
          "EEG showing reflex myoclonus",
          "involuntary muscle jerks triggered by stimuli"
        ]
      }
    ],
    "common": [
