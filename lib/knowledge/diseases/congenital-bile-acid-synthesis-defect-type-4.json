  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Congenital Bile Acid Synthesis Defects",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Neonatal or infantile cholestatic liver disease with jaundice and hepatomegaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-abnormalities",
        "description": "Abnormal bile acid profile detected by mass spectrometry showing atypical bile acid intermediates",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the HSD3B7 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-biopsy",
        "description": "Histological evidence of cholestasis and giant cell hepatitis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-treatment",
        "description": "Improvement with bile acid replacement therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus abnormal bile acid profile and confirmation by genetic testing",
    "notes": "Early diagnosis is critical to prevent progressive liver damage and improve prognosis."
  },
