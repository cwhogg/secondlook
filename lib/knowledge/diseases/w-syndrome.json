        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay with delayed motor milestones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-cardiac-defects",
        "description": "Presence of congenital cardiac malformations such as ventricular septal defect",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variant in W gene or associated loci",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation below the 5th percentile",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria including craniofacial dysmorphism, developmental delay, and genetic confirmation",
    "notes": "Genetic testing is essential to confirm diagnosis due to phenotypic overlap with other syndromes"
  },
