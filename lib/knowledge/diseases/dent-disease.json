    "formalCriteriaName": "Dent Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "lmwp",
        "description": "Presence of low molecular weight proteinuria",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypercalciuria",
        "description": "Hypercalciuria documented on urine analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nephrocalcinosis",
        "description": "Evidence of nephrocalcinosis or nephrolithiasis on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in CLCN5 or OCRL genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of low molecular weight proteinuria, hypercalciuria, and nephrocalcinosis/nephrolithiasis",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical criteria are met."
