  "diagnosticCriteria": {
    "formalCriteriaName": "Postnatal Microcephaly Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "postnatal-microcephaly",
        "description": "Progressive reduction in head circumference occurring after birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "infantile-hypotonia",
        "description": "Generalized decreased muscle tone presenting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "spastic-diplegia",
        "description": "Bilateral lower limb spasticity with increased deep tendon reflexes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysarthria",
        "description": "Impaired articulation of speech due to neuromuscular dysfunction",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "intellectual-disability",
        "description": "Cognitive impairment ranging from mild to severe",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of postnatal microcephaly, infantile hypotonia, spastic diplegia, and intellectual disability",
    "notes": "Diagnosis is clinical and supported by neuroimaging and genetic testing when available."
  },
