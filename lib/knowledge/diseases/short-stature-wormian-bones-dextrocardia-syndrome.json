  "diagnosticCriteria": {
    "formalCriteriaName": "No formal criteria established",
    "criteria": [
      {
        "id": "criterion-1",
        "description": "Presence of short stature below the 3rd percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-2",
        "description": "Radiological identification of multiple wormian bones in the cranial sutures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-3",
        "description": "Confirmed dextrocardia by imaging studies (chest X-ray, echocardiogram)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-4",
        "description": "Exclusion of other syndromes causing wormian bones or dextrocardia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (short stature, wormian bones, and dextrocardia) must be present",
    "notes": "Diagnosis is primarily clinical and radiological; genetic testing may be supportive but is not definitive."
  },
