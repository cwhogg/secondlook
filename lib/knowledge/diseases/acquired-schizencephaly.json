        "requiredForDiagnosis": true
      },
      {
        "id": "absence-congenital-malformations",
        "description": "Lack of associated congenital cortical malformations such as polymicrogyria or heterotopia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-neurological-deficits",
        "description": "Neurological deficits consistent with cortical disruption such as hemiparesis or seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic cleft on neuroimaging with documented postnatal brain insult",
    "notes": "Differentiation from congenital schizencephaly requires clinical history and imaging correlation"
