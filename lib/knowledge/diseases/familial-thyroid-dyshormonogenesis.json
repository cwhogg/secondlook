  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Congenital Hypothyroidism due to Dyshormonogenesis",
    "criteria": [
      {
        "id": "elevated-tsh",
        "description": "Persistently elevated serum thyroid-stimulating hormone (TSH) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-thyroid-hormones",
        "description": "Low serum free thyroxine (FT4) and triiodothyronine (T3) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-thyroid-gland-size",
        "description": "Normal or enlarged thyroid gland on imaging (thyroid gland present, excluding agenesis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "defective-iodide-organification",
        "description": "Abnormal iodide organification demonstrated by perchlorate discharge test",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes involved in thyroid hormone synthesis (e.g., TPO, TG, DUOX2)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated TSH with low thyroid hormones and presence of thyroid gland on imaging; confirmation by defective iodide organification or genetic testing supports diagnosis",
    "notes": "Newborn screening for congenital hypothyroidism is critical for early detection."
  },
