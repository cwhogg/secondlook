  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Arthrogryposis Multiplex Congenita",
    "criteria": [
      {
        "id": "multiple-joint-contractures",
        "description": "Presence of multiple joint contractures involving two or more body areas at birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "reduced-fetal-movement",
        "description": "History or evidence of decreased fetal movement during pregnancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-hypoplasia-or-fibrosis",
        "description": "Muscle hypoplasia or fibrosis confirmed by clinical or imaging studies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-cognitive-development",
        "description": "Normal cognitive development unless associated syndromic forms",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple joint contractures at birth involving two or more body areas plus evidence of decreased fetal movement",
    "notes": "Diagnosis is primarily clinical; genetic testing may assist in subclassification."
  },
