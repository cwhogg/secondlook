  "diagnosticCriteria": {
    "formalCriteriaName": "G6PD Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced glucose-6-phosphate dehydrogenase enzyme activity in red blood cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of Mediterranean variant mutation in the G6PD gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemolytic-episodes",
        "description": "Episodic hemolytic anemia triggered by oxidative stress (e.g., infections, certain drugs, fava beans)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "blood-smear",
        "description": "Peripheral blood smear showing bite cells and Heinz bodies during hemolytic episodes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced G6PD enzyme activity and identification of Mediterranean variant mutation with clinical history of hemolytic episodes",
    "notes": "Diagnosis may be complicated by normal enzyme levels during remission; testing during or shortly after hemolytic episodes is recommended."
  },
