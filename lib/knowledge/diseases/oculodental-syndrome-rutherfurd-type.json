  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Oculodental Syndrome, Rutherfurd Type",
    "criteria": [
      {
        "id": "ocular-anomalies",
        "description": "Presence of microphthalmia or other congenital ocular malformations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-anomalies",
        "description": "Hypoplastic or absent teeth, enamel hypoplasia, and abnormal tooth morphology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (ocular anomalies and dental anomalies) with or without minor/supportive criteria",
    "notes": "Genetic testing for mutations in the MSX1 gene may support diagnosis but is not mandatory."
  },
