      "Sural nerve biopsy demonstrating onion bulb formations and segmental demyelination"
    ],
    "imaging": [
      "MRI may show muscle atrophy in distal limbs",
      "Spinal imaging may reveal scoliosis"
    ],
    "genetic": [
      "NDRG1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography showing chronic denervation and reinnervation patterns"
    ]
  },
