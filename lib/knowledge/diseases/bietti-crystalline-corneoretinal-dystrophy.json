  "diagnosticCriteria": {
    "formalCriteriaName": "Bietti Crystalline Dystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "crystalline-deposits",
        "description": "Presence of characteristic yellow-white crystalline deposits in the cornea and retina",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-retinal-atrophy",
        "description": "Progressive chorioretinal atrophy observed on fundus examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biallelic-cyp4v2-mutation",
        "description": "Identification of pathogenic biallelic mutations in the CYP4V2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroretinogram-abnormalities",
        "description": "Electroretinogram showing reduced rod and cone responses",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of crystalline deposits and progressive chorioretinal atrophy with confirmation of biallelic CYP4V2 mutations",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical presentation may vary."
  },
