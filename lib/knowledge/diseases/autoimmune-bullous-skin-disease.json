        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoantibody-detection",
        "description": "Detection of circulating autoantibodies against epidermal or basement membrane antigens by ELISA or immunoblot",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing subepidermal or intraepidermal blister formation with inflammatory infiltrate",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical blistering plus positive direct immunofluorescence and detection of circulating autoantibodies",
    "notes": "Diagnosis requires integration of clinical, histological, and immunological findings."
