  "diagnosticCriteria": {
    "formalCriteriaName": "HSD10 Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of 3-hydroxyacyl-CoA dehydrogenase enzyme activity in fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Progressive neurodegenerative symptoms including developmental delay and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Pathogenic variants in the HSD17B10 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-markers",
        "description": "Elevated urinary 2-methyl-3-hydroxybutyric acid and tiglylglycine",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "brain-imaging",
        "description": "MRI showing cerebral atrophy and basal ganglia abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic HSD17B10 variants plus enzyme deficiency and compatible clinical features",
    "notes": "Diagnosis may be supported by metabolic and imaging findings but requires genetic confirmation."
  },
