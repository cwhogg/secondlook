  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed criteria for Developmental and Epileptic Encephalopathy with Spike-Wave Activation in Sleep",
    "criteria": [
      {
        "id": "clinical-onset",
        "description": "Onset of developmental delay or regression in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epilepsy",
        "description": "Presence of early-onset epilepsy with multiple seizure types including focal and generalized seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eeg-spike-wave",
        "description": "EEG demonstrating spike-wave activation predominantly during non-REM sleep",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with DEE (e.g., SCN2A, KCNQ2)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-etiologies",
        "description": "Exclusion of other metabolic, structural, or acquired causes of encephalopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of developmental delay/regression, early-onset epilepsy, and EEG showing spike-wave activation during sleep",
    "notes": "Genetic testing can support diagnosis but is not mandatory; exclusion of other causes is essential."
  },
