  "diagnosticCriteria": {
    "formalCriteriaName": "OSLAM Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "osteosclerosis",
        "description": "Radiologically confirmed diffuse osteosclerosis predominantly affecting long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphadenopathy",
        "description": "Chronic, non-malignant lymphadenopathy involving cervical and axillary lymph nodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-pain",
        "description": "Recurrent bone pain episodes without evidence of infection or malignancy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-hematology",
        "description": "Absence of hematological abnormalities despite bone changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (osteosclerosis and lymphadenopathy) with exclusion of other causes",
    "notes": "Diagnosis requires radiological confirmation and exclusion of malignancy or infectious causes."
  },
