    },
    {
      "vsCondition": "neurofibromatosis-type-2",
      "feature": "Bilateral vestibular schwannomas are characteristic of NF2, not NF1; NF1 has cutaneous neurofibromas and Lisch nodules."
    },
    {
      "vsCondition": "mccune-albright-syndrome",
