  "keyFindings": {
    "laboratory": [
      "Hyperglycemia with insulin dependence",
      "Polyuria and polydipsia with low urine osmolality in diabetes insipidus",
      "Abnormal audiometry showing sensorineural hearing loss"
    ],
    "imaging": [
      "Optic nerve atrophy on MRI or fundoscopy",
      "Brain MRI may show cerebellar atrophy"
    ],
    "genetic": [
      "WFS1 (causative, loss-of-function)",
      "CISD2 (causative)",
      "Pathogenic mutations in WFS1 gene (autosomal recessive inheritance)"
    ],
    "other": [
      "Reduced vasopressin secretion on water deprivation test",
      "Urodynamic studies showing neurogenic bladder"
    ]
  },
