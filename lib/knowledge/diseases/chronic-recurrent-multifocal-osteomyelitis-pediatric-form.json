  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP during active disease",
      "Negative bacterial cultures",
      "Mild anemia in some cases"
    ],
    "imaging": [
      "MRI showing multifocal bone marrow edema",
      "Osteolytic and sclerotic bone lesions on X-ray",
      "Bone scintigraphy revealing multiple active sites"
    ],
    "genetic": [
      "No single causative gene identified; possible association with LPIN2 and FBLIM1 mutations in some cases",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Bone biopsy showing sterile chronic inflammation",
      "Exclusion of infectious and malignant causes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "bacterial-osteomyelitis",
