  "keyFindings": {
    "laboratory": [
      "No specific laboratory test; diagnosis is clinical",
      "Elevated ESR and CRP during flares",
      "Positive pathergy test (40-60% in endemic regions, lower in Western populations)",
      "HLA-B51 positive (not diagnostic but supportive)",
      "Elevated immunoglobulins",
      "Neutrophilia during flares"
    ],
    "imaging": [
      "MRI brain: brainstem/diencephalic lesions in neuro-Behcet",
      "CT angiography: pulmonary artery aneurysms, arterial/venous thrombosis",
      "MR venography: cerebral venous sinus thrombosis",
      "Fundoscopy/fluorescein angiography: retinal vasculitis, macular edema"
    ],
    "genetic": [
      "IL10 (susceptibility)",
      "HLA-B (susceptibility)",
      "FAS (susceptibility)",
      "UBAC2 (susceptibility)",
      "IL23R (susceptibility)",
      "MEFV (susceptibility)",
      "STAT4 (susceptibility)",
      "C4A (susceptibility)",
      "IL12A (susceptibility)",
      "TLR4 (susceptibility)",
      "CCR1 (susceptibility)",
      "KLRC4 (susceptibility)",
      "IL12A-AS1 (susceptibility)",
      "ERAP1 (susceptibility)",
      "IFNGR1 (susceptibility)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Pathergy test: intradermal needle prick with reading at 24-48 hours",
      "Skin biopsy: neutrophilic vascular reaction",
      "GI endoscopy: deep round ulcers in ileocecal region"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "inflammatory-bowel-disease-crohn",
      "distinguishingFeatures": [
        "Transmural inflammation",
        "Skip lesions",
        "Granulomas on biopsy",
        "No genital ulcers or pathergy"
      ]
    },
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "ANA and anti-dsDNA positive",
        "Malar rash",
        "Lupus nephritis",
        "Complement consumption"
      ]
    },
    {
      "diseaseId": "reactive-arthritis",
      "distinguishingFeatures": [
        "Preceding infection (urethritis, dysentery)",
        "HLA-B27 positive",
        "Keratoderma blennorrhagicum"
      ]
    },
    {
      "diseaseId": "herpes-simplex-virus",
      "distinguishingFeatures": [
        "Viral culture/PCR positive",
        "Vesicular lesions",
        "Dermatomal distribution in HSV-2"
      ]
    }
  ],
  "redFlags": [
    "Sudden vision loss (ocular emergency from retinal vasculitis)",
    "Severe headache with papilledema (cerebral venous sinus thrombosis)",
    "Hemoptysis (pulmonary artery aneurysm - life-threatening)",
    "Progressive neurological deficits (neuro-Behcet)",
    "GI hemorrhage or perforation"
  ],
  "specialistType": [
