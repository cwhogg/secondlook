  "keyFindings": {
    "laboratory": [
      "Reactive non-treponemal tests (VDRL, RPR) in infant serum",
      "Reactive treponemal tests (FTA-ABS, TP-PA)",
      "CSF abnormalities (pleocytosis, elevated protein) in neurosyphilis"
    ],
    "imaging": [
      "Long bone radiographs showing metaphyseal lucencies and periostitis",
      "Skull X-rays showing frontal bossing"
    ],
    "genetic": [],
    "other": [
      "Direct detection of Treponema pallidum by darkfield microscopy or PCR from lesions or body fluids"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "neonatal-herpes-simplex-virus-infection",
      "distinguishingFeatures": [
        "Vesicular skin lesions rather than maculopapular rash",
        "Positive HSV PCR",
        "No characteristic bone changes"
      ]
    },
    {
      "diseaseId": "neonatal-hepatitis",
      "distinguishingFeatures": [
        "Liver dysfunction without serologic evidence of syphilis",
        "Negative treponemal tests",
        "Different rash morphology"
      ]
    }
  ],
  "redFlags": [
    "Persistent snuffles with bloody nasal discharge",
    "Failure to thrive with hepatosplenomegaly",
    "Characteristic radiologic bone abnormalities"
  ],
