  "diagnosticCriteria": {
    "formalCriteriaName": "WHIM Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cxcr4-mutation",
        "description": "Presence of heterozygous gain-of-function mutation in CXCR4 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "myelokathexis",
        "description": "Bone marrow myelokathexis characterized by retention of mature neutrophils",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-triad",
        "description": "Clinical triad of warts, hypogammaglobulinemia, and recurrent bacterial infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neutropenia",
        "description": "Chronic peripheral neutropenia documented by blood counts",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "immunoglobulin-deficiency",
        "description": "Low serum immunoglobulin levels, especially IgG and IgA",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of CXCR4 mutation plus clinical triad or myelokathexis on bone marrow biopsy",
    "notes": "Genetic testing is confirmatory; clinical presentation may vary."
  },
  "symptoms": {
