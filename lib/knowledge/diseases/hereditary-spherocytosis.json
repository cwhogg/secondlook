  "diagnosticCriteria": {
    "formalCriteriaName": "British Committee for Standards in Haematology (BCSH) Guidelines",
    "criteria": [
      {
        "id": "hs-c1",
        "description": "Family history of spherocytosis or compatible symptoms",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hs-c2",
        "description": "Spherocytes on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hs-c3",
        "description": "Positive direct antiglobulin test (DAT/Coombs) is NEGATIVE (excludes autoimmune)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hs-c4",
        "description": "Positive eosin-5-maleimide (EMA) binding test (decreased fluorescence)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hs-c5",
        "description": "Increased osmotic fragility (incubated)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hs-c6",
        "description": "Elevated MCHC (>36 g/dL)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hs-c7",
        "description": "Elevated reticulocyte count",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical hemolytic anemia with spherocytes on smear, negative DAT, and positive EMA binding test or osmotic fragility; family history supports but is not always present (de novo mutations ~25%)",
    "notes": "Severity ranges from asymptomatic carrier to severe transfusion-dependent hemolytic anemia. SDS-PAGE of red cell membrane proteins can identify specific protein deficiencies."
  },
