  "diagnosticCriteria": {
    "formalCriteriaName": "Shohat Type SEMD Diagnostic Criteria",
    "criteria": [
      {
        "id": "short-trunk-dwarfism",
        "description": "Presence of disproportionate short stature with short trunk",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-epimetaphyseal-abnormalities",
        "description": "Radiographic evidence of epimetaphyseal dysplasia with characteristic metaphyseal irregularities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "platyspondyly",
        "description": "Flattened vertebral bodies (platyspondyly) on spinal imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Mild facial dysmorphic features including midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of disproportionate short trunk dwarfism plus radiographic evidence of epimetaphyseal abnormalities and platyspondyly",
    "notes": "Genetic testing may assist but is not always definitive due to limited known mutations."
  },
