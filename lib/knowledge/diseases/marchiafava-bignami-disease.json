  "diagnosticCriteria": {
    "formalCriteriaName": "Marchiafava-Bignami Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "corpus-callosum-lesions",
        "description": "Bilateral symmetrical lesions of the corpus callosum demonstrated by MRI or CT",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chronic-alcoholism",
        "description": "History of chronic alcohol abuse or malnutrition",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-neurological-features",
        "description": "Presence of neurological symptoms such as altered consciousness, dysarthria, or cognitive impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of corpus callosum lesions such as multiple sclerosis or infarction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral corpus callosum lesions on imaging plus clinical neurological features in the context of chronic alcoholism or malnutrition",
    "notes": "Diagnosis is primarily clinical supported by neuroimaging; biopsy is rarely performed."
  },
