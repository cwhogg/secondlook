        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-anomalies",
        "description": "Distinctive craniofacial features including microcephaly, prominent forehead, and midface hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genital-hypoplasia",
        "description": "Hypoplasia of external genitalia, often micropenis or cryptorchidism in males",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal anomalies such as clinodactyly or brachydactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: short stature, craniofacial anomalies, and genital hypoplasia",
    "notes": "Diagnosis is clinical and supported by genetic testing when available"
