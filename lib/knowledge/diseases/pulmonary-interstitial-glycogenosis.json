  "keyFindings": {
    "laboratory": [
      "Arterial blood gas showing hypoxemia and respiratory acidosis",
      "Normal inflammatory markers"
    ],
    "imaging": [
      "High-resolution CT showing diffuse interstitial thickening without fibrosis or honeycombing",
      "Chest X-ray with diffuse reticulonodular pattern"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Lung biopsy demonstrating glycogen-laden mesenchymal cells in the interstitium with PAS-positive staining"
    ]
  },
