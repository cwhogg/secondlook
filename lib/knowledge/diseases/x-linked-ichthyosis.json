  "prevalence": {
    "estimate": "1-5 in 10,000",
    "range": "1-5 / 10 000",
    "classification": "uncommon"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 2,
      "max": 65,
      "peak": 14
    },
    "sexPredilection": "male",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for X-linked Ichthyosis",
    "criteria": [
      {
        "id": "clinical-skin-findings",
        "description": "Presence of dark, adherent, polygonal scales predominantly on the neck, trunk, and extensor surfaces",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "steroid-sulfatase-deficiency",
        "description": "Demonstration of steroid sulfatase enzyme deficiency in leukocytes or skin fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic deletion or mutation in the STS gene on Xp22.31",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-ichthyosis",
        "description": "Exclusion of other forms of ichthyosis by clinical and laboratory evaluation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical skin findings plus either steroid sulfatase deficiency or pathogenic STS gene mutation",
    "notes": "Genetic testing is confirmatory and essential for definitive diagnosis."
  },
