  "keyFindings": {
    "laboratory": [
      "Elevated urinary indican detected by urine chromatography or colorimetric assays",
      "Abnormal amino acid profile indicating tryptophan malabsorption",
      "Metabolic acidosis and electrolyte disturbances on blood tests"
    ],
    "imaging": [
      "Renal ultrasound may show nephrocalcinosis or structural abnormalities in advanced disease"
    ],
    "genetic": [
      "Mutations affecting intestinal tryptophan absorption or metabolism (specific gene not well defined)"
    ],
    "other": [
      "Blue staining of diapers and urine upon exposure to air due to oxidation of indican"
    ]
  },
