  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria; diagnosis based on clinical, biochemical, and genetic findings",
    "criteria": [
      {
        "id": "elevated-homocysteine",
        "description": "Markedly elevated plasma total homocysteine levels (>100 µmol/L)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cbs-enzyme-activity",
        "description": "Reduced or absent cystathionine beta-synthase enzyme activity in cultured fibroblasts or liver tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pathogenic-cbs-variants",
        "description": "Identification of biallelic pathogenic variants in the CBS gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features such as ectopia lentis, marfanoid habitus, and thromboembolism",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated plasma homocysteine plus either reduced CBS enzyme activity or biallelic pathogenic CBS variants",
    "notes": "Newborn screening may detect elevated methionine; confirmatory testing required."
  },
