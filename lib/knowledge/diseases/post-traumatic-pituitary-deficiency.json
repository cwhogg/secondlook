  "keyFindings": {
    "laboratory": [
      "Low serum cortisol with low or inappropriately normal ACTH",
      "Low free T4 with low or normal TSH",
      "Low LH and FSH with low sex steroids",
      "Low IGF-1 indicating growth hormone deficiency",
      "Hyponatremia"
    ],
    "imaging": [
      "MRI showing pituitary stalk transection or thickening",
      "Pituitary gland atrophy or hemorrhage",
      "Empty sella turcica"
    ],
    "genetic": [],
    "other": [
      "Dynamic pituitary function testing (e.g., insulin tolerance test)",
      "Visual field testing for optic chiasm involvement"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pituitary-adenoma",
      "distinguishingFeatures": [
        "Presence of pituitary mass on imaging",
        "Possible hormone hypersecretion",
