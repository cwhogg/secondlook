  "diagnosticCriteria": {
    "formalCriteriaName": "ACAD9 Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the ACAD9 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-evidence",
        "description": "Elevated plasma acylcarnitine profile consistent with long-chain fatty acid oxidation defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of cardiomyopathy and/or exercise intolerance with muscle weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Reduced complex I activity in muscle biopsy or fibroblasts",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-cardiac",
        "description": "Echocardiographic evidence of hypertrophic or dilated cardiomyopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biallelic pathogenic ACAD9 variants plus either biochemical evidence of fatty acid oxidation defect or clinical features of cardiomyopathy and muscle weakness",
    "notes": "Muscle biopsy and imaging findings support diagnosis but are not mandatory."
  },
