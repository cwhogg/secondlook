  "keyFindings": {
    "laboratory": [
      "Neutropenia (absolute neutrophil count <1500/mm³)",
      "Positive rheumatoid factor",
      "Elevated anti-CCP antibodies",
      "Anemia of chronic disease",
      "Elevated ESR and CRP"
    ],
    "imaging": [
      "Ultrasound or CT showing splenomegaly",
      "X-ray evidence of rheumatoid arthritis joint damage"
    ],
    "genetic": [
      "Association with HLA-DR4 allele"
    ],
    "other": [
      "Bone marrow biopsy typically shows hypercellularity with myeloid maturation arrest"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "large-granular-lymphocyte-leukemia",
      "distinguishingFeatures": [
        "Clonal expansion of large granular lymphocytes",
        "Presence of LGL cells in peripheral blood",
        "May have neutropenia and splenomegaly but lacks typical rheumatoid arthritis features"
      ]
    },
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "Positive ANA and anti-dsDNA antibodies",
        "Multisystem involvement including renal and dermatological manifestations",
        "Neutropenia may occur but without chronic rheumatoid arthritis"
      ]
    }
  ],
