  "keyFindings": {
    "laboratory": [
      "Low serum IgG, IgA, and/or IgM levels",
      "Reduced CD27+ memory B cells on flow cytometry",
      "Lymphopenia in some cases"
    ],
    "imaging": [
      "Lymphadenopathy and splenomegaly on ultrasound or CT",
      "Possible bronchiectasis on chest CT due to recurrent infections"
    ],
    "genetic": [
      "Biallelic pathogenic mutations in the CD27 gene confirmed by sequencing"
    ],
    "other": [
      "Poor vaccine response to polysaccharide antigens",
      "Elevated EBV viral load in peripheral blood"
    ]
  },
