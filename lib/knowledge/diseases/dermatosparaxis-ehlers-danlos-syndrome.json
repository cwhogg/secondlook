  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria; diagnosis based on clinical and molecular findings",
    "criteria": [
      {
        "id": "skin-fragility",
        "description": "Severe skin fragility with easy bruising and tearing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "extreme-cutaneous-hyperextensibility",
        "description": "Marked skin hyperextensibility with redundant, sagging skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "collagen-processing-defect",
        "description": "Deficiency or absence of procollagen I N-proteinase activity confirmed by biochemical or genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "easy-scarring",
        "description": "Characteristic atrophic scarring with cigarette-paper appearance",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "joint-hypermobility",
        "description": "Generalized joint hypermobility with recurrent dislocations",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of major clinical features (skin fragility, extreme cutaneous hyperextensibility) plus biochemical or genetic confirmation of procollagen I N-proteinase deficiency",
    "notes": "Molecular genetic testing of ADAMTS2 gene mutations is confirmatory."
  },
