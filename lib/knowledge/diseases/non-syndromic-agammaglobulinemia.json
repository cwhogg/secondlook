  "diagnosticCriteria": {
    "formalCriteriaName": "ESID Diagnostic Criteria for X-linked Agammaglobulinemia",
    "criteria": [
      {
        "id": "absent-bcells",
        "description": "Markedly reduced or absent peripheral B cells (<2% of lymphocytes)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-serum-immunoglobulins",
        "description": "Severe reduction in all serum immunoglobulin isotypes (IgG, IgA, IgM)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "btk-mutation",
        "description": "Pathogenic mutation in the BTK gene identified by genetic testing",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "recurrent-bacterial-infections",
        "description": "History of recurrent bacterial infections, especially respiratory tract infections",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of markedly reduced or absent B cells and low serum immunoglobulins with compatible clinical history; genetic confirmation supports diagnosis",
    "notes": "Genetic testing for BTK mutations is confirmatory but not mandatory if clinical and immunological criteria are met."
  },
