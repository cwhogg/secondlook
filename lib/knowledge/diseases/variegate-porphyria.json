  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for acute porphyrias",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Reduced activity of protoporphyrinogen oxidase enzyme in erythrocytes or liver",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "porphyrin-elevation",
        "description": "Elevated plasma and fecal porphyrin levels, especially protoporphyrin and coproporphyrin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the PPOX gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of acute neurovisceral attacks or cutaneous photosensitivity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of enzyme deficiency or pathogenic PPOX mutation plus elevated porphyrins with compatible clinical features",
    "notes": "Diagnosis is confirmed by biochemical testing and genetic analysis; clinical presentation varies widely."
  },
