  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Vitamin K Antagonist Embryopathy",
    "criteria": [
      {
        "id": "exposure-history",
        "description": "Confirmed maternal exposure to vitamin K antagonists during the first trimester of pregnancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nasal-hypoplasia",
        "description": "Presence of nasal hypoplasia or hypoplastic nasal bone on clinical examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Characteristic skeletal abnormalities including stippled epiphyses (chondrodysplasia punctata)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-malformations",
        "description": "Presence of congenital cardiac malformations such as ventricular septal defects",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Intrauterine growth retardation or low birth weight",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Maternal exposure plus presence of nasal hypoplasia and stippled epiphyses",
    "notes": "Diagnosis is clinical and supported by radiographic findings; genetic testing is not diagnostic."
  },
