  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Fibrodysplasia Ossificans Progressiva",
    "criteria": [
      {
        "id": "congenital-great-toe-malformation",
        "description": "Congenital malformation of the great toes (hallux valgus or monophalangism)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-heterotopic-ossification",
        "description": "Progressive heterotopic ossification in characteristic anatomic patterns involving soft tissues",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acvr1-gene-mutation",
        "description": "Presence of pathogenic mutation in the ACVR1 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "flare-ups",
        "description": "Recurrent painful soft tissue swellings (flare-ups) preceding ossification",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital great toe malformation plus progressive heterotopic ossification",
    "notes": "Genetic testing for ACVR1 mutation confirms diagnosis but is not mandatory if clinical criteria are met."
  },
