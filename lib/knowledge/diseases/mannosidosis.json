  "diagnosticCriteria": {
    "formalCriteriaName": "Alpha-Mannosidosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficient alpha-mannosidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the MAN2B1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of developmental delay, skeletal abnormalities, and immune deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-oligosaccharides",
        "description": "Elevated urinary excretion of mannose-rich oligosaccharides",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient alpha-mannosidase enzyme activity plus either pathogenic MAN2B1 variants or characteristic clinical features",
    "notes": "Diagnosis is confirmed by enzyme assay and molecular genetic testing."
  },
