  "keyFindings": {
    "laboratory": [
      "Hyperglycemia consistent with diabetes mellitus",
      "Low serum pancreatic enzyme levels indicating exocrine insufficiency",
      "Mild anemia of chronic disease"
    ],
    "imaging": [
      "Pancreatic hypoplasia or aplasia on abdominal ultrasound or MRI",
      "Echocardiography showing congenital heart defects such as septal defects or outflow tract anomalies",
      "Occasional pancreatic cysts on imaging"
    ],
    "genetic": [
      "GATA6 (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histological confirmation of pancreatic hypoplasia if biopsy performed"
    ]
  },
