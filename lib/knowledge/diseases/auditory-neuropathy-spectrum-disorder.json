  "diagnosticCriteria": {
    "formalCriteriaName": "Auditory Neuropathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "otoacoustic-emissions",
        "description": "Presence of normal otoacoustic emissions indicating intact outer hair cell function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-or-abnormal-auditory-brainstem-response",
        "description": "Absent or severely abnormal auditory brainstem response (ABR) despite normal otoacoustic emissions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-speech-perception",
        "description": "Disproportionately poor speech perception relative to pure tone audiometry thresholds",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-tympanometry",
        "description": "Normal middle ear function as evidenced by normal tympanometry",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of normal otoacoustic emissions, absent or abnormal ABR, and impaired speech perception",
    "notes": "Diagnosis requires exclusion of middle ear pathology and cochlear hearing loss."
  },
