  "diagnosticCriteria": {
    "formalCriteriaName": "ATS/ERS Classification of Idiopathic Interstitial Pneumonias",
    "criteria": [
      {
        "id": "histopathology-macrophage-accumulation",
        "description": "Diffuse accumulation of pigmented macrophages within alveolar spaces",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "interstitial-fibrosis-mild",
        "description": "Mild interstitial fibrosis with uniform involvement of alveolar walls",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-smoking-history",
        "description": "History of cigarette smoking",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-ground-glass-opacity",
        "description": "High-resolution CT showing diffuse ground-glass opacities predominantly in lower lung zones",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic histopathology (macrophage accumulation and mild fibrosis) plus compatible HRCT findings, with exclusion of other causes",
    "notes": "Diagnosis requires lung biopsy in most cases; smoking history supports diagnosis but is not mandatory"
  },
