        "requiredForDiagnosis": true
      },
      {
        "id": "paroxysmal-muscle-contractions",
        "description": "Episodes of paroxysmal muscle contractions and trismus triggered by feeding or cold exposure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cold-induced-sweating",
        "description": "Cold-induced excessive sweating episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "feeding-difficulties",
        "description": "Severe feeding difficulties and failure to thrive in infancy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing-crlf1",
        "description": "Identification of pathogenic variants in the CRLF1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of neonatal facial dysmorphism, paroxysmal muscle contractions or trismus, cold-induced sweating, and confirmation by genetic testing",
    "notes": "Diagnosis is primarily clinical supported by molecular genetic testing of CRLF1 or CLCF1 genes."
  },
