  "keyFindings": {
    "laboratory": [
      "Elevated serum bile acids",
      "Normal or low gamma-glutamyl transferase (GGT)",
      "Elevated serum bilirubin (conjugated hyperbilirubinemia)",
      "Fat-soluble vitamin deficiencies"
    ],
    "imaging": [
      "Ultrasound may show hepatomegaly and exclude biliary obstruction",
      "MRI/MRCP typically normal biliary tree"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Liver biopsy showing canalicular cholestasis and absent or reduced BSEP protein by immunostaining"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "progressive-familial-intrahepatic-cholestasis-type-1",
      "distinguishingFeatures": [
        "Mutations in ATP8B1 gene",
        "Low GGT cholestasis but with different clinical course",
        "Less risk of hepatocellular carcinoma"
      ]
    },
    {
      "diseaseId": "bile-acid-synthesis-defects",
      "distinguishingFeatures": [
        "Abnormal bile acid profiles on specialized testing",
        "May respond to bile acid replacement therapy",
        "Different genetic mutations affecting bile acid synthesis enzymes"
      ]
    }
  ],
  "redFlags": [
    "Onset of severe pruritus and jaundice in infancy",
    "Persistently low or normal GGT despite cholestasis",
    "Development of hepatocellular carcinoma in a young child"
  ],
