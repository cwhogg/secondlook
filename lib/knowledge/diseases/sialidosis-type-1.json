  "diagnosticCriteria": {
    "formalCriteriaName": "Sialidosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of alpha-N-acetyl neuraminidase enzyme activity in cultured fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of progressive myoclonus epilepsy with ataxia and visual impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cherry-red-spot",
        "description": "Ophthalmological finding of cherry-red spot in the macula",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the NEU1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of enzyme deficiency plus at least two major clinical features or genetic confirmation",
    "notes": "Genetic testing is confirmatory but enzyme assay remains gold standard."
  },
