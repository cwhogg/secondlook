        "description": "Consanguinity or affected siblings supporting autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the KLC2 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive spastic paraplegia, bilateral optic atrophy, and sensorimotor neuropathy",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if clinical criteria are met"
