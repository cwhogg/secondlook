  "diagnosticCriteria": {
    "formalCriteriaName": "Dihydropyrimidinuria Diagnostic Criteria",
    "criteria": [
      {
        "id": "urinary-dihydropyrimidine-elevation",
        "description": "Elevated levels of dihydrouracil and dihydrothymine in urine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dihydropyrimidine-dehydrogenase-activity",
        "description": "Reduced or absent dihydropyrimidine dehydrogenase enzyme activity in peripheral blood mononuclear cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the DPYD gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of neurological symptoms such as developmental delay or seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated urinary dihydrouracil and dihydrothymine levels plus reduced DPD enzyme activity or pathogenic DPYD variants",
    "notes": "Genetic testing is confirmatory but not always required if biochemical testing is conclusive."
  },
