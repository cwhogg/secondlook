  "diagnosticCriteria": {
    "formalCriteriaName": "Neonatal Marfan Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "aortic-root-dilatation",
        "description": "Severe aortic root dilatation or aneurysm in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ectopia-lentis",
        "description": "Ectopia lentis (dislocation of the ocular lens)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "severe-musculoskeletal-features",
        "description": "Severe musculoskeletal manifestations including arachnodactyly, joint contractures, and pectus deformities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fibrillin-1-mutation",
        "description": "Pathogenic FBN1 gene mutation consistent with Marfan syndrome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiorespiratory-complications",
        "description": "Early onset congestive heart failure or respiratory distress",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe aortic root dilatation and pathogenic FBN1 mutation with characteristic musculoskeletal features in infancy",
    "notes": "Diagnosis is supported by genetic testing and clinical presentation; early recognition is critical due to rapid progression."
  },
