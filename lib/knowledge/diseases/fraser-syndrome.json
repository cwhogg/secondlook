  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific biochemical markers"
    ],
    "imaging": [
      "Ultrasound showing renal agenesis or dysplasia",
      "MRI or CT demonstrating craniofacial anomalies",
      "Chest X-ray or CT for respiratory tract malformations"
    ],
    "genetic": [
      "FRAS1 (causative)",
      "FREM2 (causative)",
      "GRIP1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Prenatal ultrasound may detect cryptophthalmos and renal anomalies",
      "Postmortem examination often reveals multiple congenital anomalies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ankyloblepharon-ectodermal-dysplasia-clefting-syndrome",
      "distinguishingFeatures": [
        "Presence of ankyloblepharon (eyelid fusion) rather than cryptophthalmos",
        "Ectodermal dysplasia features such as hair and teeth abnormalities",
        "Cleft lip/palate more frequent"
      ]
    },
    {
      "diseaseId": "mocm1-syndrome",
      "distinguishingFeatures": [
        "Ocular malformations without syndactyly",
        "Distinct genetic cause (MOCS1 gene mutations)",
        "Less frequent genitourinary anomalies"
      ]
    }
  ],
  "redFlags": [
    "Complete cryptophthalmos with absent eyelids",
    "Severe renal agenesis leading to oligohydramnios",
    "Respiratory distress due to laryngeal or tracheal malformations"
  ],
