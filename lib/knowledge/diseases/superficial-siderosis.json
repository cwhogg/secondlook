  "keyFindings": {
    "laboratory": [
      "CSF analysis may show xanthochromia and elevated ferritin",
      "Iron studies typically normal"
    ],
    "imaging": [
      "MRI with T2*-weighted gradient echo or susceptibility-weighted imaging showing hypointense rim along the surface of the brain and spinal cord consistent with hemosiderin deposition"
    ],
    "genetic": [
      "No known genetic mutations directly linked; usually acquired"
    ],
    "other": [
      "Identification of bleeding source such as dural defects, vascular malformations, or tumors"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cerebral-amyloid-angiopathy",
      "distinguishingFeatures": [
        "Lobar intracerebral hemorrhages without superficial hemosiderin deposition",
        "Older age group",
        "Absence of progressive cerebellar ataxia"
      ]
    },
    {
      "diseaseId": "multiple-system-atrophy",
      "distinguishingFeatures": [
        "Autonomic failure with parkinsonism or cerebellar features",
        "No hemosiderin deposition on MRI",
        "Rapid progression"
      ]
    },
    {
      "diseaseId": "hereditary-hemosiderosis",
      "distinguishingFeatures": [
        "Systemic iron overload",
        "Elevated serum ferritin and transferrin saturation",
        "No isolated CNS superficial siderosis"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive cerebellar dysfunction",
    "Sudden onset or worsening of sensorineural hearing loss",
    "Signs of acute subarachnoid hemorrhage or new neurological deficits"
  ],
