  "diagnosticCriteria": {
    "formalCriteriaName": "Meier-Gorlin Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "patellar-aplasia",
        "description": "Absent or hypoplastic patellae confirmed by clinical and radiological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microtia",
        "description": "Small or absent external ears (microtia) with or without hearing impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Severe pre- and postnatal growth retardation resulting in short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in DNA replication genes (e.g., ORC1, ORC4, ORC6, CDT1, CDC6)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-features",
        "description": "Characteristic facial features including micrognathia and a narrow nose",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical features (patellar aplasia/hypoplasia, microtia, and short stature) with or without genetic confirmation",
    "notes": "Genetic testing is recommended to confirm diagnosis and identify causative mutations."
  },
