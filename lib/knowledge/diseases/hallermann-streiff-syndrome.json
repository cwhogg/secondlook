  "differentialDiagnoses": [
    {
      "diseaseId": "progeria",
      "distinguishingFeatures": [
        "Accelerated aging phenotype",
        "Absence of congenital cataracts",
        "Distinct genetic mutation in LMNA gene"
      ]
    },
    {
      "diseaseId": "mandibulo-facial-dysostosis",
      "distinguishingFeatures": [
        "Ear anomalies and hearing loss more prominent",
        "No congenital cataracts",
        "Different pattern of craniofacial anomalies"
      ]
    },
    {
      "diseaseId": "oculo-dento-digital-dysplasia",
      "distinguishingFeatures": [
        "Syndactyly of fingers and toes",
        "Neurological involvement common",
        "Distinct genetic mutation in GJA1 gene"
      ]
    }
  ],
