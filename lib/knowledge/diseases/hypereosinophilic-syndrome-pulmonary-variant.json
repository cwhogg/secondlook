  "diagnosticCriteria": {
    "formalCriteriaName": "Chusid Criteria for Hypereosinophilic Syndrome",
    "criteria": [
      {
        "id": "persistent-eosinophilia",
        "description": "Peripheral blood eosinophil count >1.5 x 10^9/L persisting for more than 6 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "organ-involvement",
        "description": "Evidence of pulmonary involvement such as eosinophilic pneumonia or lung tissue damage attributable to eosinophilia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of secondary causes of eosinophilia including parasitic infections, allergic diseases, and malignancies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-eosinophilia",
        "description": "Bone marrow biopsy showing increased eosinophils without evidence of clonal hematologic malignancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-findings",
        "description": "Radiologic evidence of pulmonary infiltrates consistent with eosinophilic lung disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent eosinophilia >1.5 x 10^9/L for >6 months, pulmonary involvement attributable to eosinophilia, and exclusion of secondary causes",
    "notes": "Diagnosis requires careful exclusion of secondary eosinophilia and hematologic malignancies"
  },
