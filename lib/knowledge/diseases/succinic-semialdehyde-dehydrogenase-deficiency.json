  "diagnosticCriteria": {
    "formalCriteriaName": "SSADH Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-4-hydroxybutyric-acid",
        "description": "Elevated levels of 4-hydroxybutyric acid (GHB) in urine, plasma, or CSF",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aldh5a1-gene-mutation",
        "description": "Identification of pathogenic variants in the ALDH5A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-manifestations",
        "description": "Presence of developmental delay, hypotonia, and ataxia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroencephalogram-abnormalities",
        "description": "EEG abnormalities including generalized spike-wave discharges",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "brain-mri-findings",
        "description": "Non-specific T2 hyperintensities in globus pallidus or dentate nuclei on MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated 4-hydroxybutyric acid plus pathogenic ALDH5A1 mutation and compatible neurological symptoms",
    "notes": "Diagnosis is confirmed by biochemical and genetic testing; clinical presentation can be variable."
  },
