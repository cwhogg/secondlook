  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for familial isolated hypoparathyroidism",
    "criteria": [
      {
        "id": "hypocalcemia",
        "description": "Persistent hypocalcemia with low serum calcium levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-pth",
        "description": "Inappropriately low or absent parathyroid hormone (PTH) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of hypoparathyroidism without other syndromic features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of secondary causes such as autoimmune, surgical, or infiltrative hypoparathyroidism",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with isolated hypoparathyroidism (e.g., CASR, GCM2, PTH)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent hypocalcemia with low PTH levels and positive family history, after exclusion of secondary causes",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory."
  },
