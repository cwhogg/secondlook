  "diagnosticCriteria": {
    "formalCriteriaName": "PNP Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Markedly reduced or absent purine nucleoside phosphorylase enzyme activity in erythrocytes or lymphocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the PNP gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Clinical evidence of combined immunodeficiency with low T-cell counts and impaired cellular immunity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-features",
        "description": "Presence of progressive neurological abnormalities such as developmental delay or hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "urinary-metabolites",
        "description": "Elevated urinary inosine and guanosine levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of markedly reduced PNP enzyme activity and biallelic pathogenic variants in PNP gene with clinical immunodeficiency",
    "notes": "Diagnosis is confirmed by enzyme assay and genetic testing; clinical features support diagnosis."
  },
