    "formalCriteriaName": "Clinical diagnostic criteria for Piebaldism",
    "criteria": [
      {
        "id": "white-forelock",
        "description": "Presence of a stable white forelock of hair",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "depigmented-skin-patches",
        "description": "Stable, well-demarcated depigmented patches of skin present from birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-progressive-pigment-loss",
        "description": "Lack of progressive pigment loss or systemic involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of white forelock and congenital stable depigmented skin patches",
    "notes": "Genetic testing for KIT or SNAI2 mutations can support diagnosis"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Congenital white forelock",
        "frequency": 0.85,
        "bodySystem": "dermatological",
        "notes": "Typically present at birth or early infancy"
      },
      {
        "symptomName": "Stable depigmented skin patches",
        "frequency": 0.95,
        "bodySystem": "dermatological",
        "notes": "Non-progressive, well-demarcated areas of hypopigmentation"
      },
      {
        "symptomName": "Poliosis affecting scalp hair",
        "frequency": 0.75,
        "bodySystem": "dermatological",
        "notes": "Localized white hair patches beyond the forelock"
      }
    ],
    "common": [
      {
        "symptomName": "Depigmented eyebrows or eyelashes",
        "frequency": 0.65,
        "bodySystem": "dermatological",
        "notes": "May accompany scalp hair depigmentation"
      },
      {
        "symptomName": "Depigmented patches on trunk and limbs",
        "frequency": 0.7,
        "bodySystem": "dermatological",
        "notes": "Typically symmetrical and stable"
      },
      {
        "symptomName": "Mild café-au-lait spots",
        "frequency": 0.55,
        "bodySystem": "dermatological",
        "notes": "Occasionally observed but not diagnostic"
      },
      {
        "symptomName": "Normal skin texture in depigmented areas",
        "frequency": 0.6,
        "bodySystem": "dermatological",
        "notes": "No scaling or atrophy"
      }
    ],
    "occasional": [
      {
        "symptomName": "Hypopigmented eyelashes",
        "frequency": 0.3,
        "bodySystem": "dermatological",
        "notes": "Less frequent than eyebrow involvement"
      },
      {
        "symptomName": "Mild sensorineural hearing loss",
        "frequency": 0.15,
        "bodySystem": "neurological",
        "notes": "Rarely reported in some cases"
      },
      {
        "symptomName": "Mild heterochromia iridis",
        "frequency": 0.2,
        "bodySystem": "ophthalmological",
        "notes": "Occasional iris pigment variation"
      },
      {
        "symptomName": "Transient erythema in depigmented areas",
