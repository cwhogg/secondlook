  "diagnosticCriteria": {
    "formalCriteriaName": "Cricoarytenoid Arthritis Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of hoarseness and laryngeal pain localized to the cricoarytenoid joint",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "laryngoscopy-findings",
        "description": "Visualization of cricoarytenoid joint inflammation or fixation on laryngoscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-evidence",
        "description": "Radiologic evidence of cricoarytenoid joint erosion or swelling on CT or MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "associated-autoimmune-disease",
        "description": "Presence of underlying autoimmune disease such as rheumatoid arthritis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Both major criteria (clinical presentation and laryngoscopy findings) must be present; supportive criteria aid confirmation.",
    "notes": "Diagnosis is often clinical supported by imaging and laryngoscopy; biopsy is rarely performed."
  },
