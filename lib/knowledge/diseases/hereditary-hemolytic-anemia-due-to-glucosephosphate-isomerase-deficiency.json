  "keyFindings": {
    "laboratory": [
      "Decreased GPI enzyme activity in red blood cells",
      "Elevated reticulocyte count",
      "Elevated indirect bilirubin",
      "Anemia with normocytic or slightly macrocytic indices",
      "Peripheral blood smear showing hemolytic features without spherocytes"
    ],
    "imaging": [
      "Ultrasound showing splenomegaly",
      "Ultrasound evidence of gallstones"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Exclusion of other hemolytic anemias by enzyme assays and molecular testing"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "glucose-6-phosphate-dehydrogenase-deficiency",
      "distinguishingFeatures": [
        "X-linked inheritance",
        "Episodes of acute hemolysis triggered by oxidative stress",
        "Normal GPI enzyme activity"
      ]
    },
    {
      "diseaseId": "pyruvate-kinase-deficiency",
      "distinguishingFeatures": [
        "Reduced pyruvate kinase enzyme activity",
        "Similar chronic hemolytic anemia but different enzyme defect",
        "Different genetic mutations (PKLR gene)"
      ]
    },
    {
      "diseaseId": "hereditary-spherocytosis",
      "distinguishingFeatures": [
        "Presence of spherocytes on peripheral smear",
        "Positive osmotic fragility test",
        "Defects in red cell membrane proteins"
      ]
    }
  ],
  "redFlags": [
    "Severe anemia requiring frequent transfusions",
    "Sudden worsening of hemolysis with infection or stress",
    "Signs of iron overload or organ damage"
