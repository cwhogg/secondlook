  "keyFindings": {
    "laboratory": [
      "Non-specific; prenatal serum markers may be abnormal due to fetal demise"
    ],
    "imaging": [
      "Prenatal ultrasound showing large ventral wall defect with evisceration",
      "MRI demonstrating limb abnormalities and short umbilical cord"
    ],
    "genetic": [
      "No consistent genetic mutation identified; mostly sporadic cases"
    ],
    "other": [
      "Pathological examination confirms body wall defect and limb anomalies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "gastroschisis",
      "distinguishingFeatures": [
        "Smaller abdominal wall defect usually right of umbilicus",
        "No severe limb abnormalities",
        "Normal umbilical cord"
      ]
    },
    {
      "diseaseId": "pentalogy-of-cantrell",
      "distinguishingFeatures": [
        "Midline supraumbilical defect with ectopia cordis",
        "Less severe limb defects",
        "Presence of sternal and diaphragmatic defects"
      ]
    }
  ],
