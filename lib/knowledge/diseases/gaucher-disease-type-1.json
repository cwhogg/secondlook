  "diagnosticCriteria": {
    "formalCriteriaName": "Gaucher Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficient activity of glucocerebrosidase enzyme in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the GBA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features such as hepatosplenomegaly and cytopenias",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-examination",
        "description": "Bone marrow biopsy showing Gaucher cells (lipid-laden macrophages)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient glucocerebrosidase enzyme activity plus biallelic pathogenic GBA variants with compatible clinical features",
    "notes": "Enzyme assay is the gold standard; genetic testing confirms diagnosis and subtype."
  },
