  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Congenital Dyserythropoietic Anemia Type III",
    "criteria": [
      {
        "id": "giant-multinucleated-erythroblasts",
        "description": "Presence of giant multinucleated erythroblasts in bone marrow aspirate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "macrocytic-anemia",
        "description": "Macrocytic anemia with reticulocytopenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the KIF23 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ineffective-erythropoiesis",
        "description": "Evidence of ineffective erythropoiesis on bone marrow examination",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hemolysis-markers",
        "description": "Elevated lactate dehydrogenase (LDH) and indirect hyperbilirubinemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of giant multinucleated erythroblasts in bone marrow, macrocytic anemia, and pathogenic KIF23 mutation",
    "notes": "Diagnosis is confirmed by bone marrow morphology combined with genetic testing."
  },
