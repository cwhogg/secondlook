  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for CM-AVM",
    "criteria": [
      {
        "id": "capillary-malformation",
        "description": "Presence of multiple small, round to oval pink to red capillary malformations typically on the face, trunk, or limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "arteriovenous-malformation",
        "description": "Identification of fast-flow arteriovenous malformations or fistulas by imaging studies (MRI, Doppler ultrasound, or angiography)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of CM-AVM or related vascular anomalies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Detection of pathogenic variants in RASA1 or EPHB4 genes",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic capillary malformations plus imaging-confirmed arteriovenous malformations or identification of pathogenic mutation in RASA1 or EPHB4",
    "notes": "Genetic testing is recommended to confirm diagnosis and guide family counseling."
  },
