  "keyFindings": {
    "laboratory": [
      "Anemia with normocytic or macrocytic indices",
      "Elevated indirect bilirubin",
      "Increased lactate dehydrogenase (LDH)",
      "Reticulocytosis",
      "Hypoglycosylation of erythrocyte membrane proteins"
    ],
    "imaging": [
      "Ultrasound showing splenomegaly and possible gallstones"
    ],
    "genetic": [
      "Pathogenic mutations in SEC23B gene"
    ],
