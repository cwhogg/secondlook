        "requiredForDiagnosis": true
      },
      {
        "id": "chronic-widespread-adipose-pain",
        "description": "Chronic, widespread pain localized to adipose tissue lasting more than 3 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of lipomatosis and chronic pain such as fibromyalgia or lipedema",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "associated-symptoms",
        "description": "Presence of associated symptoms such as fatigue, weakness, or cognitive disturbances",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple painful lipomas and chronic widespread adipose tissue pain with exclusion of other causes",
    "notes": "Diagnosis is clinical; no definitive laboratory or imaging test exists."
