  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Fetal Trimethadione Syndrome",
    "criteria": [
      {
        "id": "facial-dysmorphia",
        "description": "Characteristic facial dysmorphia including midface hypoplasia, micrognathia, and short upturned nose",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-malformations",
        "description": "Presence of congenital cardiac defects such as ventricular septal defect or atrial septal defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intrauterine-growth-retardation",
        "description": "Documented intrauterine growth retardation (IUGR) with low birth weight",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Limb anomalies including clinodactyly or hypoplastic nails",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "maternal-history",
        "description": "Maternal history of trimethadione use during pregnancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (facial dysmorphia, cardiac malformations, and intrauterine growth retardation) plus confirmed maternal trimethadione exposure",
    "notes": "Diagnosis is clinical and supported by maternal drug exposure history; genetic testing is not diagnostic."
  },
