  "diagnosticCriteria": {
    "formalCriteriaName": "Second consensus diagnostic criteria for multiple system atrophy",
    "criteria": [
      {
        "id": "cerebellar-ataxia",
        "description": "Presence of cerebellar ataxia manifested by gait instability, limb ataxia, or dysarthria",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autonomic-dysfunction",
        "description": "Autonomic failure including orthostatic hypotension and urinary incontinence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "parkinsonism",
        "description": "Poorly levodopa-responsive parkinsonism with rigidity and bradykinesia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-support",
        "description": "MRI evidence of pontocerebellar atrophy or 'hot cross bun' sign",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of cerebellar ataxia and autonomic failure with supportive clinical and imaging findings",
    "notes": "Definitive diagnosis requires neuropathological confirmation; clinical diagnosis is probable or possible based on criteria."
  },
