  "diagnosticCriteria": {
    "formalCriteriaName": "ESID Diagnostic Criteria for Severe Combined Immunodeficiency",
    "criteria": [
      {
        "id": "absent-t-cells",
        "description": "Profound deficiency or absence of circulating T lymphocytes (CD3+ cells)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-b-cells",
        "description": "Absent or severely reduced B lymphocytes (CD19+ cells)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cd3-subunit-mutation",
        "description": "Identification of pathogenic mutations in CD3D, CD3E, or CD3Z genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-lymphocyte-proliferation",
        "description": "Impaired lymphocyte proliferative response to mitogens and antigens",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-infections",
        "description": "Recurrent, severe, or opportunistic infections in early infancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of absent T and B cells combined with confirmed pathogenic mutations in CD3D, CD3E, or CD3Z genes",
    "notes": "Genetic confirmation is critical due to overlapping clinical features with other SCID subtypes."
  },
