  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Apparent Mineralocorticoid Excess",
    "criteria": [
      {
        "id": "hypertension",
        "description": "Early-onset severe hypertension resistant to standard therapy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypokalemia",
        "description": "Persistent hypokalemia with metabolic alkalosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-renin-aldosterone",
        "description": "Low plasma renin activity and low aldosterone levels despite hypertension",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-cortisol-cortisone-ratio",
        "description": "Increased urinary cortisol to cortisone metabolite ratio indicating 11β-HSD2 deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the HSD11B2 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset hypertension with hypokalemia, low renin and aldosterone levels, and elevated cortisol to cortisone ratio; genetic confirmation supports diagnosis",
    "notes": "Diagnosis is supported by biochemical testing and confirmed by genetic analysis of HSD11B2."
  },
