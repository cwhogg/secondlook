  "differentialDiagnoses": [
    {
      "diseaseId": "primary-aldosteronism",
      "distinguishingFeatures": [
        "Elevated aldosterone levels",
        "Hypertension rather than hypotension",
        "Suppressed plasma renin activity"
      ]
    },
    {
      "diseaseId": "addison-disease",
      "distinguishingFeatures": [
        "Deficiency of all adrenal steroids including cortisol",
        "Presence of hyperpigmentation",
        "Low cortisol levels with elevated ACTH"
      ]
    },
    {
      "diseaseId": "pseudohypoaldosteronism",
      "distinguishingFeatures": [
        "Elevated aldosterone levels with renal resistance",
        "Normal or elevated renin",
        "No genetic mutations in aldosterone synthesis genes"
      ]
    }
  ],
  "redFlags": [
    "Severe hyperkalemia with ECG changes",
    "Refractory hypotension despite fluid resuscitation",
    "Family history of sudden cardiac death"
