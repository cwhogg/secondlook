  "diagnosticCriteria": {
    "formalCriteriaName": "Mevalonate Kinase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-mevalonic-acid",
        "description": "Elevated urinary mevalonic acid levels during febrile episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mevalonate-kinase-activity",
        "description": "Reduced or absent mevalonate kinase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biallelic-mvk-mutations",
        "description": "Identification of biallelic pathogenic variants in the MVK gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of recurrent febrile attacks with systemic inflammation and developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated urinary mevalonic acid, reduced mevalonate kinase activity, and biallelic pathogenic MVK mutations",
    "notes": "Diagnosis is confirmed by biochemical and genetic testing; clinical features support diagnosis."
  },
