    "formalCriteriaName": "Echocardiographic Diagnostic Criteria for Atrial Septal Defect",
    "criteria": [
      {
        "id": "echocardiographic-visualization",
        "description": "Visualization of a defect in the atrial septum at the fossa ovalis region by echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "left-to-right-shunt",
        "description": "Evidence of left-to-right shunting across the atrial septal defect on color Doppler imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "right-heart-volume-overload",
        "description": "Signs of right atrial and right ventricular volume overload on imaging or ECG",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of an atrial septal defect at the fossa ovalis with left-to-right shunting demonstrated by echocardiography",
    "notes": "Cardiac catheterization may be used if noninvasive imaging is inconclusive."
  },
