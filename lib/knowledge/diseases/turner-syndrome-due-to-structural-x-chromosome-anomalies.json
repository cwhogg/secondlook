  "keyFindings": {
    "laboratory": [
      "Elevated serum gonadotropins (FSH, LH) indicating gonadal failure",
      "Thyroid function tests may show hypothyroidism"
    ],
    "imaging": [
      "Echocardiogram showing bicuspid aortic valve or coarctation of the aorta",
      "Renal ultrasound revealing horseshoe kidney or other anomalies",
      "Bone age assessment often delayed"
    ],
    "genetic": [
      "Karyotype demonstrating structural abnormalities of the X chromosome (e.g., isochromosome, deletions, ring chromosome)",
      "Fluorescence in situ hybridization (FISH) or array CGH confirming X chromosome anomalies"
    ],
    "other": [
      "Physical examination findings: webbed neck, low posterior hairline, broad chest with widely spaced nipples"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "noonan-syndrome",
      "distinguishingFeatures": [
        "Normal female karyotype (46,XX)",
        "Presence of pulmonary valve stenosis",
        "Characteristic facial features distinct from Turner syndrome"
      ]
    },
    {
      "diseaseId": "klinefelter-syndrome",
      "distinguishingFeatures": [
        "Male phenotype with 47,XXY karyotype",
        "Tall stature rather than short stature",
        "Hypogonadism but with different clinical presentation"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive aortic dilation or chest pain suggesting aortic dissection",
    "Delayed or absent puberty with primary amenorrhea",
    "Severe congenital heart defects causing heart failure or cyanosis"
  ],
  "specialistType": [
    "Medical geneticist",
    "Endocrinologist",
    "Cardiologist",
    "Pediatrician",
    "Reproductive endocrinologist"
  ],
