  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiographic Diagnostic Criteria for Spondyloepiphyseal Dysplasia Congenita",
    "criteria": [
      {
        "id": "short-trunk-dwarfism",
        "description": "Presence of disproportionate short-trunk dwarfism with normal limb length",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-vertebral-epiphyseal-abnormalities",
        "description": "Radiographic evidence of flattened vertebral bodies (platyspondyly) and delayed epiphyseal ossification",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-and-hearing-impairment",
        "description": "Presence of myopia, retinal detachment, and sensorineural hearing loss",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic COL2A1 gene mutation",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of disproportionate short-trunk dwarfism with characteristic radiographic skeletal abnormalities; genetic confirmation supports diagnosis",
    "notes": "Diagnosis is primarily clinical and radiographic; genetic testing can confirm but is not always necessary."
  },
