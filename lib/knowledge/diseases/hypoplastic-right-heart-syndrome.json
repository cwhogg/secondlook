  "keyFindings": {
    "laboratory": [
      "Arterial blood gas showing hypoxemia",
      "Elevated brain natriuretic peptide (BNP) indicating heart failure"
    ],
    "imaging": [
      "Echocardiography demonstrating hypoplastic right ventricle, pulmonary valve atresia/stenosis, and atrial septal defect",
      "Chest X-ray showing cardiomegaly and decreased pulmonary vascular markings",
      "Cardiac MRI for detailed anatomical assessment"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electrocardiogram showing right atrial enlargement and right axis deviation"
    ]
  },
  "differentialDiagnoses": [
