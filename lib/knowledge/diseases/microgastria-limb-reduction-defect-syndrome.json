        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Intrauterine growth retardation or postnatal growth deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microgastria and at least one limb reduction defect",
    "notes": "Diagnosis is primarily clinical supported by imaging and exclusion of other syndromes"
