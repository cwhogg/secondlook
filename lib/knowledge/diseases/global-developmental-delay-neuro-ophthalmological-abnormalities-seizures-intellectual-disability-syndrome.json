  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for GDD-NOA-S-ID Syndrome",
    "criteria": [
      {
        "id": "global-developmental-delay",
        "description": "Significant delay in two or more developmental domains including motor, speech, and cognitive skills",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuro-ophthalmological-abnormalities",
        "description": "Presence of structural or functional ophthalmological abnormalities such as optic nerve hypoplasia or nystagmus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "Recurrent unprovoked seizures or epilepsy documented clinically or by EEG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Cognitive impairment confirmed by standardized intellectual assessment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-neuroimaging",
        "description": "Brain MRI showing nonspecific white matter abnormalities or cortical dysplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of global developmental delay, neuro-ophthalmological abnormalities, seizures, and intellectual disability",
    "notes": "Diagnosis is clinical and supported by neuroimaging and genetic testing when available."
  },
