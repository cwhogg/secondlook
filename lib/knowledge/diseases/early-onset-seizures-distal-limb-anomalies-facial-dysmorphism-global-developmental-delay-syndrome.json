  "diagnosticCriteria": {
    "formalCriteriaName": "Early-onset seizures-distal limb anomalies-facial dysmorphism-global developmental delay syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "early-seizures",
        "description": "Onset of seizures within the first 6 months of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distal-limb-anomalies",
        "description": "Presence of distal limb anomalies including brachydactyly, clinodactyly, or syndactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features such as hypertelorism, broad nasal bridge, and thin upper lip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "global-developmental-delay",
        "description": "Global developmental delay affecting motor, cognitive, and speech milestones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-neuroimaging",
        "description": "Neuroimaging showing nonspecific cerebral atrophy or delayed myelination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset seizures, distal limb anomalies, facial dysmorphism, and global developmental delay",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
