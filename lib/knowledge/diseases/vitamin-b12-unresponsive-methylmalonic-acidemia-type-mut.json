  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Methylmalonic Acidemia Type mut",
    "criteria": [
      {
        "id": "elevated-methylmalonic-acid",
        "description": "Persistent elevation of methylmalonic acid in plasma and/or urine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mutase-activity-deficiency",
        "description": "Deficiency or absence of methylmalonyl-CoA mutase enzyme activity in fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation-mmut",
        "description": "Identification of pathogenic mutations in the MMUT gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lack-of-vitamin-b12-response",
        "description": "No clinical or biochemical improvement after vitamin B12 supplementation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Neonatal or early infancy onset of metabolic acidosis with ketosis and hyperammonemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated methylmalonic acid, mutase enzyme deficiency, pathogenic MMUT gene mutations, and lack of response to vitamin B12 supplementation",
    "notes": "Diagnosis is confirmed by biochemical, enzymatic, and genetic testing; vitamin B12 responsiveness must be excluded."
  },
