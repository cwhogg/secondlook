  "diagnosticCriteria": {
    "formalCriteriaName": "Jeavons Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "eyelid-myoclonia",
        "description": "Presence of eyelid myoclonia characterized by brief, repetitive, involuntary eyelid jerks often triggered by eye closure or photic stimulation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absences",
        "description": "Occurrence of absences (brief lapses of consciousness) associated with eyelid myoclonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "photoparoxysmal-response",
        "description": "Electroencephalogram (EEG) demonstrating generalized photoparoxysmal response on intermittent photic stimulation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-neuroimaging",
        "description": "Normal brain MRI excluding structural lesions",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of eyelid myoclonia with absences and EEG evidence of photoparoxysmal response",
    "notes": "Diagnosis is clinical supported by EEG findings; neuroimaging is typically normal."
  },
