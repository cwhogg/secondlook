        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of similar encephalopathic episodes or confirmed pathogenic mutation in RANBP2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-infectious",
        "description": "Exclusion of infectious encephalitis and other metabolic causes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-csf-protein",
        "description": "Elevated cerebrospinal fluid protein without pleocytosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acute encephalopathy with bilateral thalamic necrotizing lesions and positive family history or pathogenic RANBP2 mutation",
    "notes": "Genetic testing for RANBP2 mutations is critical for confirmation"
