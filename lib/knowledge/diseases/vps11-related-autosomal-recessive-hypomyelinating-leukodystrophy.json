        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-mri",
        "description": "MRI showing diffuse hypomyelination with relative preservation of cerebral structures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the VPS11 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies showing peripheral neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-course",
        "description": "Progressive spasticity and ataxia developing after initial hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset neurological symptoms, characteristic MRI findings, and biallelic VPS11 pathogenic variants",
    "notes": "Diagnosis requires integration of clinical, radiological, and genetic data."
  },
