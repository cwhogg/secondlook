  "keyFindings": {
    "laboratory": [
      "Elevated cerebrospinal fluid protein with normal cell count (albuminocytologic dissociation)",
      "Normal routine blood tests"
    ],
    "imaging": [
      "MRI brain may show optic nerve atrophy",
      "Spinal cord MRI typically normal"
    ],
    "genetic": [
      "Pathogenic variants in genes associated with axonal neuropathies and optic atrophy (specific gene not yet well defined)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Nerve conduction studies showing reduced amplitude consistent with axonal neuropathy",
      "Electromyography demonstrating chronic denervation"
    ]
  },
