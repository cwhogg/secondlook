  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiographic Criteria for Multiple Epiphyseal Dysplasia",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of joint pain and stiffness predominantly in large joints starting in childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-epiphyseal-abnormalities",
        "description": "Radiographic evidence of delayed and irregular ossification of multiple epiphyses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in COL9A1, COL9A2, or COL9A3 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical features, radiographic abnormalities, and pathogenic COL9A gene mutation",
    "notes": "Genetic testing is essential for confirmation due to phenotypic overlap with other skeletal dysplasias."
  },
