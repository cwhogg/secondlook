  "diagnosticCriteria": {
    "formalCriteriaName": "No formal standardized criteria; clinical diagnosis based on exposure and symptom resolution",
    "criteria": [
      {
        "id": "drug-exposure",
        "description": "History of exposure to a known lupus-inducing drug",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of lupus-like clinical manifestations (e.g., arthralgia, serositis, rash)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoantibodies",
        "description": "Positive antinuclear antibodies (ANA) and/or antihistone antibodies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "symptom-resolution",
        "description": "Improvement or resolution of symptoms after discontinuation of the offending drug",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Exposure to a known lupus-inducing drug plus lupus-like clinical features with symptom resolution after drug withdrawal",
    "notes": "Diagnosis is clinical and supported by serology; no formal validated criteria exist."
  },
