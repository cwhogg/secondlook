  "diagnosticCriteria": {
    "formalCriteriaName": "No formal criteria established",
    "criteria": [
      {
        "id": "renal-tubulopathy",
        "description": "Presence of renal tubular dysfunction characterized by electrolyte imbalances such as hypokalemia, hypomagnesemia, and metabolic alkalosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dilated-cardiomyopathy",
        "description": "Echocardiographic evidence of dilated cardiomyopathy with reduced left ventricular systolic function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the gene(s) associated with the syndrome (e.g., RRAGD mutations)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other known causes of renal tubulopathy and cardiomyopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of renal tubulopathy and dilated cardiomyopathy with exclusion of other causes; genetic confirmation supports diagnosis",
    "notes": "Genetic testing is recommended for confirmation but diagnosis can be made clinically based on characteristic renal and cardiac findings."
  },
