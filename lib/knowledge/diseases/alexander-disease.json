  "diagnosticCriteria": {
    "formalCriteriaName": "Alexander Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "gfap-mutation",
        "description": "Presence of pathogenic mutation in the GFAP gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "white-matter-degeneration",
        "description": "MRI evidence of frontal predominant white matter abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rosenthal-fibers",
        "description": "Histopathological identification of Rosenthal fibers in astrocytes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Progressive neurological deterioration including developmental delay and spasticity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic GFAP mutation plus characteristic MRI findings",
    "notes": "Histopathology is confirmatory but not always required if genetic and imaging criteria are met."
  },
