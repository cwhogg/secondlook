    ],
    "imaging": [
      "Echocardiogram showing restrictive cardiomyopathy with thickened ventricular walls",
      "MRI demonstrating amyloid infiltration in affected organs"
    ],
    "genetic": [
      "No known pathogenic mutations; typically sporadic amyloidogenic deposition of wild-type apolipoprotein A-IV"
    ],
    "other": [
