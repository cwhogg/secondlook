  "keyFindings": {
    "laboratory": [
      "CSF biomarkers consistent with Alzheimer's disease pathology (elevated tau, decreased beta-amyloid 42)"
    ],
    "imaging": [
      "MRI showing atrophy predominantly in occipital and parietal cortices",
      "FDG-PET demonstrating hypometabolism in posterior cortical regions"
    ],
    "genetic": [
      "No specific genetic mutations identified; some cases associated with familial Alzheimer's disease mutations"
    ],
    "other": [
      "Neuropsychological testing revealing visuospatial and visuoperceptual deficits"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "alzheimer-disease",
