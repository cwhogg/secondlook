  "diagnosticCriteria": {
    "formalCriteriaName": "Xq12-q13.3 Duplication Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of duplication at Xq12-q13.3 region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Presence of characteristic craniofacial dysmorphic features including hypertelorism and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Neonatal or infantile hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-issues",
        "description": "Behavioral abnormalities such as autistic features or attention deficits",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of Xq12-q13.3 duplication plus presence of developmental delay",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support but are variable."
  },
