{
  "id": "hereditary-hemorrhagic-telangiectasia-with-coagulopathy",
  "name": "Hereditary Hemorrhagic Telangiectasia with Coagulopathy",
  "aliases": [
    "Osler-Weber-Rendu Syndrome with Coagulopathy",
    "HHT with Bleeding Disorder"
  ],
  "icd10Codes": [
    "I78.0",
    "D68.9"
  ],
  "omimId": "187300",
  "orphanetId": "284",
  "prevalence": {
    "estimate": "1 in 5,000 to 1 in 8,000",
    "range": "0.01%-0.02%",
    "classification": "rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 10,
      "max": 60,
      "peak": 30
    },
    "sexPredilection": "equal",
    "ethnicAssociations": [
      "Caucasian",
      "Hispanic",
      "Asian"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Curaçao Criteria",
    "criteria": [
      {
        "id": "epistaxis",
        "description": "Spontaneous and recurrent nosebleeds",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "telangiectasia",
        "description": "Multiple telangiectasias at characteristic sites (lips, oral cavity, fingers, nose)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "visceral-lesions",
        "description": "Presence of arteriovenous malformations in lungs, liver, brain, or gastrointestinal tract",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "First-degree relative with HHT according to these criteria",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "coagulopathy",
        "description": "Laboratory evidence of coagulation defects contributing to bleeding tendency",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least three major criteria or two major plus two minor criteria",
    "notes": "Coagulopathy is considered an additional supportive feature complicating classical HHT diagnosis."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Recurrent spontaneous epistaxis",
        "frequency": 0.95,
        "bodySystem": "otolaryngological",
        "notes": "Often the earliest and most common presenting symptom"
      },
      {
        "symptomName": "Mucocutaneous telangiectasias",
        "frequency": 0.85,
        "bodySystem": "dermatological",
        "notes": "Visible dilated capillaries on lips, tongue, fingertips, and nasal mucosa"
      },
      {
        "symptomName": "Arteriovenous malformations in visceral organs",
        "frequency": 0.75,
        "bodySystem": "cardiovascular",
        "notes": "Commonly affects lungs, liver, and brain"
      }
    ],
    "common": [
      {
        "symptomName": "Gastrointestinal bleeding",
        "frequency": 0.65,
        "bodySystem": "gastrointestinal",
        "notes": "May cause iron deficiency anemia"
      },
      {
        "symptomName": "Easy bruising",
        "frequency": 0.6,
        "bodySystem": "hematological",
        "notes": "Due to combined vascular fragility and coagulation defects"
      },
      {
        "symptomName": "Fatigue related to chronic anemia",
        "frequency": 0.58,
        "bodySystem": "constitutional",
        "notes": "Secondary to recurrent bleeding"
      },
      {
        "symptomName": "Shortness of breath",
        "frequency": 0.55,
        "bodySystem": "respiratory",
        "notes": "Due to pulmonary AVMs causing hypoxemia"
      },
      {
        "symptomName": "Telangiectasias on conjunctiva",
        "frequency": 0.52,
        "bodySystem": "ophthalmological",
        "notes": "May be observed on eye examination"
      }
    ],
    "occasional": [
      {
        "symptomName": "Hemoptysis",
        "frequency": 0.4,
        "bodySystem": "respiratory",
        "notes": "Bleeding from pulmonary AVMs"
      },
      {
        "symptomName": "Neurological deficits",
        "frequency": 0.3,
        "bodySystem": "neurological",
        "notes": "Due to cerebral AVMs or paradoxical emboli"
      },
      {
        "symptomName": "Abdominal pain",
        "frequency": 0.25,
        "bodySystem": "gastrointestinal",
        "notes": "Related to hepatic AVMs or bleeding"
      },
      {
        "symptomName": "Prolonged bleeding after minor trauma",
        "frequency": 0.2,
        "bodySystem": "hematological",
        "notes": "Reflects underlying coagulopathy"
      },
      {
        "symptomName": "Iron deficiency anemia",
        "frequency": 0.15,
        "bodySystem": "hematological",
        "notes": "Secondary to chronic blood loss"
      }
    ],
    "rare": [
      {
        "symptomName": "High-output cardiac failure",
        "frequency": 0.08,
        "bodySystem": "cardiovascular",
        "notes": "Due to large hepatic AVMs causing shunting"
      },
      {
        "symptomName": "Seizures",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Secondary to cerebral AVMs or hemorrhage"
      },
      {
        "symptomName": "Portal hypertension",
        "frequency": 0.04,
        "bodySystem": "gastrointestinal",
        "notes": "Complication of hepatic vascular malformations"
      },
      {
        "symptomName": "Thrombocytopenia",
        "frequency": 0.03,
        "bodySystem": "hematological",
        "notes": "May exacerbate bleeding tendency"
      }
    ]
  },
  "systemsAffected": [
    "hematological",
