  "keyFindings": {
    "laboratory": [
      "Severe anemia with low reticulocyte count",
      "Elevated lactate dehydrogenase (LDH)",
      "Indirect hyperbilirubinemia",
      "Bone marrow erythroid hyperplasia with dyserythropoiesis"
    ],
    "imaging": [
      "Ultrasound evidence of splenomegaly",
      "Gallstones on abdominal ultrasound"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Ineffective erythropoiesis demonstrated by bone marrow biopsy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-dyserythropoietic-anemia-type-ii",
      "distinguishingFeatures": [
        "Presence of binucleated erythroblasts but absence of nuclear bridging",
        "Mutations in CDAN1 gene",
        "Less severe anemia and different bone marrow morphology"
      ]
    },
    {
      "diseaseId": "hereditary-spherocytosis",
      "distinguishingFeatures": [
        "Spherocytes on peripheral smear",
        "Positive osmotic fragility test",
        "No multinuclear erythroblasts or nuclear bridging"
      ]
    }
  ],
  "redFlags": [
    "Severe transfusion-dependent anemia in infancy or early childhood",
    "Progressive splenomegaly with risk of hypersplenism",
    "Signs of iron overload despite no or minimal transfusions"
  ],
