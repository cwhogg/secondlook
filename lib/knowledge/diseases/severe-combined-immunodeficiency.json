  "keyFindings": {
    "laboratory": [
      "Profound T-cell lymphopenia",
      "Absent or severely reduced T-cell proliferation response to mitogens",
      "Hypogammaglobulinemia",
      "Elevated serum IgE in some variants"
    ],
    "imaging": [
      "Chest X-ray showing pneumonia or absent thymic shadow"
    ],
    "genetic": [
      "Pathogenic mutations in genes such as IL2RG, ADA, RAG1, RAG2, JAK3"
    ],
    "other": [
      "Positive family history of early infant deaths or immunodeficiency",
      "Abnormal newborn screening for T-cell receptor excision circles (TRECs)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "wiskott-aldrich-syndrome",
