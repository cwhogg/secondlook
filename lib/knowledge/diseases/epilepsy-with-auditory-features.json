        "description": "Positive family history of epilepsy with auditory features",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ictal-eeg",
        "description": "EEG showing ictal or interictal epileptiform discharges localized to temporal regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-imaging",
        "description": "Normal brain MRI excluding structural lesions",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of auditory auras and focal temporal lobe seizures confirmed by EEG",
    "notes": "Diagnosis relies on clinical history, EEG findings, and exclusion of structural brain abnormalities."
