  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Sponastrime Dysplasia",
    "criteria": [
      {
        "id": "nasal-bone-dysplasia",
        "description": "Characteristic dysplastic changes of the nasal bone with striations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metaphyseal-striations",
        "description": "Radiographic metaphyseal striations and abnormalities in long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Postnatal short stature with disproportionate skeletal growth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Midface hypoplasia and characteristic facial features",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "spinal-abnormalities",
        "description": "Mild platyspondyly and vertebral anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: nasal bone dysplasia, metaphyseal striations, and short stature",
    "notes": "Genetic testing may support diagnosis but is not mandatory; diagnosis is primarily clinical and radiological."
  },
