  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed diagnostic criteria for SAVI",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic gain-of-function mutation in TMEM173 (STING gene)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-vasculopathy",
        "description": "Presence of early-onset cutaneous vasculopathy including violaceous plaques, ulcerations, and acral necrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "interstitial-lung-disease",
        "description": "Evidence of interstitial lung disease with fibrosis and restrictive lung function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-interferon-signature",
        "description": "Elevated type I interferon signature in peripheral blood",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "systemic-inflammation",
        "description": "Chronic systemic inflammation with elevated acute phase reactants",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic TMEM173 mutation plus at least two major clinical features (cutaneous vasculopathy and interstitial lung disease)",
    "notes": "Diagnosis is confirmed by genetic testing; clinical features support diagnosis and guide management."
  },
