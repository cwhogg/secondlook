  "keyFindings": {
    "laboratory": [
      "Low serum luteinizing hormone (LH) and follicle-stimulating hormone (FSH)",
      "Low serum testosterone or estradiol levels",
      "Normal or low prolactin levels"
    ],
    "imaging": [
      "MRI showing hypoplastic or absent olfactory bulbs and tracts",
      "Echocardiography revealing septal defects or valvular abnormalities",
      "Bone age radiographs showing delayed skeletal maturation"
    ],
    "genetic": [
      "Pathogenic variants in KAL1, FGFR1, PROKR2, or other genes implicated in Kallmann syndrome and cardiac defects",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Olfactory testing confirming anosmia or hyposmia",
      "Cardiac catheterization or ECG for arrhythmia evaluation"
    ]
  },
