  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Congenital Dyserythropoietic Anemia Type II",
    "criteria": [
      {
        "id": "bone-marrow-morphology",
        "description": "Presence of binucleated and multinucleated erythroblasts in bone marrow aspirate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypoglycosylation-erythrocyte-membrane-proteins",
        "description": "Hypoglycosylation of erythrocyte membrane proteins demonstrated by lectin binding assays or SDS-PAGE",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "positive-acidified-serum-test",
        "description": "Positive acidified serum test (HEMPAS test) indicating increased erythrocyte membrane fragility",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the SEC23B gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic bone marrow morphology plus either hypoglycosylation of erythrocyte membrane proteins or pathogenic SEC23B mutation",
    "notes": "Genetic testing is confirmatory but not always available; bone marrow findings are essential."
  },
