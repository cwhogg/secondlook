  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electrophysiological Diagnostic Criteria for CMT",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of distal muscle weakness and atrophy predominantly in the lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensory-loss",
        "description": "Distal sensory loss including reduced vibration and proprioception",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-conduction",
        "description": "Electrophysiological evidence of axonal neuropathy with normal or mildly reduced nerve conduction velocities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with CMT2 (e.g., MFN2, MPZ)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of distal muscle weakness and sensory loss with electrophysiological evidence of axonal neuropathy",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory."
  },
