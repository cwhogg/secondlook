  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible mild anemia",
      "Metabolic screening usually unremarkable"
    ],
    "imaging": [
      "Echocardiogram revealing congenital heart defects",
      "Skeletal X-rays showing clinodactyly or scoliosis",
      "Brain MRI may show nonspecific white matter changes"
    ],
    "genetic": [
      "Chromosomal microarray showing duplication of distal 5q region (5q35.2-qter)",
      "Fluorescence in situ hybridization (FISH) confirming duplication",
      "Karyotype may reveal unbalanced translocation involving 5q"
    ],
    "other": [
      "Developmental assessments confirming intellectual disability",
      "Audiological evaluation for hearing impairment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cri-du-chat-syndrome",
      "distinguishingFeatures": [
        "Deletion of 5p rather than duplication of 5q",
        "Characteristic high-pitched cat-like cry",
        "Microcephaly more prominent"
      ]
    },
    {
      "diseaseId": "duplication-15q11-q13-syndrome",
      "distinguishingFeatures": [
        "Duplication involves chromosome 15q region",
        "More prominent autism spectrum disorder features",
        "Distinct facial dysmorphisms different from 5q duplication"
      ]
    }
  ],
