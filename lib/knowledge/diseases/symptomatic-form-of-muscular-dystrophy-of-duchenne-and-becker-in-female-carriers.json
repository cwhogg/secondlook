        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-serum-creatine-kinase",
        "description": "Elevated serum creatine kinase (CK) levels above normal range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic DMD gene mutation consistent with Duchenne or Becker muscular dystrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes and reduced or absent dystrophin expression",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-evaluation",
        "description": "Evidence of cardiomyopathy or conduction abnormalities on cardiac imaging or ECG",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal muscle weakness, elevated serum CK, and confirmed pathogenic DMD mutation",
    "notes": "Diagnosis may be supported by muscle biopsy and cardiac evaluation findings."
  },
