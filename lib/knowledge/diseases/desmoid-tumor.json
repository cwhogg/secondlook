  "diagnosticCriteria": {
    "formalCriteriaName": "Desmoid Tumor Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histological confirmation of spindle cell proliferation with infiltrative growth pattern",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-characteristics",
        "description": "MRI showing a well-defined, homogenous soft tissue mass with low to intermediate signal intensity on T1 and variable T2 signal",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "beta-catenin-immunostaining",
        "description": "Positive nuclear beta-catenin immunohistochemical staining",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of a slow-growing, firm, painless mass in musculoskeletal or abdominal wall regions",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation with supportive imaging and positive beta-catenin staining",
    "notes": "Genetic testing for CTNNB1 mutations can support diagnosis but is not mandatory."
  },
