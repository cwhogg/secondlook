  "keyFindings": {
    "laboratory": [
      "Histopathology showing hyperkeratosis with acanthosis",
      "Normal routine blood tests"
    ],
    "imaging": [
      "X-rays may show soft tissue constriction bands",
      "MRI to assess extent of digital constriction"
    ],
    "genetic": [
      "GJB2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Audiometry confirming sensorineural hearing loss",
      "Clinical observation of constriction bands and keratoderma"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "mal-de-marcheskeratoderma",
      "distinguishingFeatures": [
        "Diffuse palmoplantar keratoderma without pseudoainhum",
        "No starfish-shaped keratoses",
        "Lack of sensorineural hearing loss"
      ]
    },
    {
      "diseaseId": "pachyonychia-congenita",
      "distinguishingFeatures": [
        "Nail thickening and dystrophy predominant",
        "Oral leukokeratosis present",
        "No pseudoainhum or starfish keratoses"
      ]
    }
  ],
  "redFlags": [
    "Progressive constriction bands causing ischemia and autoamputation",
