  "diagnosticCriteria": {
    "formalCriteriaName": "Dysferlinopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal or distal muscle weakness with onset in adolescence or early adulthood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing reduced or absent dysferlin protein expression by immunohistochemistry or immunoblot",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the DYSF gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serum-creatine-kinase",
        "description": "Elevated serum creatine kinase (CK) levels, often markedly increased",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "Electromyographic evidence of myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive muscle weakness plus either muscle biopsy showing absent/reduced dysferlin or pathogenic DYSF gene mutations",
    "notes": "Genetic confirmation is considered definitive; muscle biopsy is essential when genetic testing is inconclusive."
  },
