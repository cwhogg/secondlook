  "keyFindings": {
    "laboratory": [
      "Elevated serum calcium and parathyroid hormone levels",
      "Elevated gastrin, insulin, or prolactin depending on tumor type",
      "Hypoglycemia in insulinoma"
    ],
    "imaging": [
      "Parathyroid sestamibi scan showing adenomas",
      "MRI or CT of pituitary gland revealing adenomas",
      "CT or MRI of pancreas showing neuroendocrine tumors"
    ],
    "genetic": [
      "Germline mutation in MEN1 tumor suppressor gene on chromosome 11q13"
    ],
    "other": [
      "Family history of MEN1-associated tumors",
      "Histopathology confirming neuroendocrine tumors"
    ]
  },
