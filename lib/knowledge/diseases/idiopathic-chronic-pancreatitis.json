  "diagnosticCriteria": {
    "formalCriteriaName": "Idiopathic Chronic Pancreatitis Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-pancreatic-pain",
        "description": "Recurrent or chronic abdominal pain consistent with pancreatitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-evidence",
        "description": "Imaging findings of pancreatic ductal irregularities, calcifications, or atrophy on CT/MRI/ERCP",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exocrine-insufficiency",
        "description": "Evidence of pancreatic exocrine insufficiency such as steatorrhea or abnormal fecal elastase",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-known-causes",
        "description": "Exclusion of other known causes of chronic pancreatitis including alcohol, genetic mutations, autoimmune pancreatitis, and obstructive etiologies",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of chronic pancreatic-type abdominal pain, characteristic imaging findings, and exclusion of other known causes",
    "notes": "Diagnosis is primarily clinical supported by imaging and exclusion of secondary causes."
  },
