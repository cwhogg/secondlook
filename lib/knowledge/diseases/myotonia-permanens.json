    "laboratory": [
      "Normal serum creatine kinase levels or mildly elevated",
      "Normal metabolic panel"
    ],
    "imaging": [
      "Muscle MRI may show hypertrophy without fatty infiltration"
    ],
    "genetic": [
      "SCN4A (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography demonstrating myotonic discharges with waxing and waning frequency"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "myotonic-dystrophy-type-1",
      "distinguishingFeatures": [
