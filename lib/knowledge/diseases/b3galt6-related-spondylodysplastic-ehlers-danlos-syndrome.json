  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed diagnostic criteria for spondylodysplastic Ehlers-Danlos syndrome",
    "criteria": [
      {
        "id": "connective-tissue-fragility",
        "description": "Generalized joint hypermobility and skin hyperextensibility",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-dysmorphism",
        "description": "Short stature with skeletal dysplasia including platyspondyly and metaphyseal changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "b3galt6-pathogenic-variant",
        "description": "Biallelic pathogenic variants in B3GALT6 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-hypotonia",
        "description": "Congenital muscle hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "craniofacial-features",
        "description": "Characteristic craniofacial features including midface hypoplasia and prominent forehead",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized joint hypermobility and skeletal dysplasia plus biallelic pathogenic variants in B3GALT6",
    "notes": "Diagnosis is confirmed by molecular genetic testing; clinical features overlap with other spondylodysplastic EDS subtypes."
  },
