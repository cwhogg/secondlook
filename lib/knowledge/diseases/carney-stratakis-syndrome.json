  "diagnosticCriteria": {
    "formalCriteriaName": "Carney-Stratakis Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "paraganglioma",
        "description": "Presence of paraganglioma confirmed by histopathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gastrointestinal-stromal-tumor",
        "description": "Presence of gastrointestinal stromal tumor (GIST) confirmed by histopathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "germline-sdh-mutation",
        "description": "Identification of germline mutation in SDHB, SDHC, or SDHD genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of paraganglioma and/or GIST",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both paraganglioma and gastrointestinal stromal tumor with identification of germline SDH mutation or compatible family history",
    "notes": "Diagnosis relies on combination of tumor types and genetic testing; absence of one tumor type requires strong genetic or family evidence."
  },
