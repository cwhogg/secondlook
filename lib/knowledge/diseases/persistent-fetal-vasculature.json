  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Ultrasound showing persistent hyaloid artery or fibrovascular stalk",
      "MRI demonstrating persistent fetal vasculature and vitreoretinal abnormalities"
    ],
    "genetic": [
      "Usually sporadic; rare familial cases reported with mutations in NDP or ATOH7 genes"
    ],
    "other": [
      "Clinical examination revealing leukocoria, microphthalmia, and vitreoretinal traction"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "retinoblastoma",
      "distinguishingFeatures": [
        "Calcifications on imaging",
        "Rapidly progressive intraocular mass",
        "Possible bilateral involvement"
      ]
    },
    {
      "diseaseId": "congenital-cataract",
      "distinguishingFeatures": [
        "Lens opacity without persistent hyaloid artery",
        "No vitreoretinal stalk",
        "Usually no microphthalmia"
      ]
    },
    {
      "diseaseId": "retinopathy-of-prematurity",
      "distinguishingFeatures": [
        "History of prematurity and oxygen therapy",
        "Retinal neovascularization and scarring",
        "Absence of persistent hyaloid artery"
      ]
    }
  ],
  "redFlags": [
    "Leukocoria in a neonate or infant",
    "Rapidly progressive vision loss",
    "Signs suggestive of intraocular tumor (e.g., retinoblastoma)"
  ],
