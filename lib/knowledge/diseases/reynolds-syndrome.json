  "keyFindings": {
    "laboratory": [
      "Elevated alkaline phosphatase and gamma-glutamyl transferase",
      "Positive antimitochondrial antibodies (AMA)",
      "Presence of anti-centromere or anti-Scl-70 antibodies",
      "Elevated liver transaminases"
    ],
    "imaging": [
      "Liver ultrasound showing chronic liver disease features",
      "High-resolution CT chest for interstitial lung disease",
      "Echocardiography for pulmonary hypertension"
    ],
    "genetic": [
