  "keyFindings": {
    "laboratory": [
      "Severe T-cell lymphopenia with normal or reduced B cells and NK cells",
      "Hypogammaglobulinemia (low IgG, IgA, IgM)",
      "Absent T-cell proliferative response to mitogens",
      "Elevated serum alpha-fetoprotein in some cases"
    ],
    "imaging": [
      "Absent or hypoplastic thymus on chest X-ray or CT scan",
      "Possible hepatosplenomegaly on abdominal ultrasound"
    ],
    "genetic": [
      "DCLRE1C (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Bone marrow biopsy may show hypocellularity",
      "Flow cytometry demonstrating absent T-cell receptor excision circles (TRECs)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "severe-combined-immunodeficiency-due-to-rag1-rag2-deficiency",
      "distinguishingFeatures": [
        "Presence of T-B- NK+ phenotype",
        "RAG1/RAG2 mutations instead of DCLRE1C",
        "Variable radiosensitivity"
      ]
    },
    {
      "diseaseId": "adenosine-deaminase-deficiency-severe-combined-immunodeficiency",
      "distinguishingFeatures": [
        "Elevated toxic metabolites (dATP)",
        "ADA enzyme deficiency",
        "Additional skeletal abnormalities"
      ]
    }
  ],
  "redFlags": [
    "Severe, recurrent, and opportunistic infections in early infancy",
    "Failure to thrive despite adequate nutrition",
    "Profound lymphopenia on complete blood count"
  ],
