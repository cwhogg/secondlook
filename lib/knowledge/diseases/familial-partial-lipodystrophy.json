  "differentialDiagnoses": [
    {
      "diseaseId": "generalized-lipodystrophy",
      "distinguishingFeatures": [
        "Complete or near-complete absence of adipose tissue rather than regional loss",
        "Earlier onset in infancy or childhood",
        "More severe metabolic complications"
      ]
    },
    {
      "diseaseId": "acquired-partial-lipodystrophy",
      "distinguishingFeatures": [
        "Onset typically in childhood or adolescence without family history",
        "Loss of fat predominantly in face and upper body",
        "Associated with complement abnormalities"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset of severe insulin resistance with regional fat loss",
    "Family history of similar fat distribution abnormalities",
    "Early development of diabetes and dyslipidemia in young adults"
  ],
