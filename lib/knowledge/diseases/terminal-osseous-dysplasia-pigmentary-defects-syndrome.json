  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Terminal Osseous Dysplasia-Pigmentary Defects Syndrome",
    "criteria": [
      {
        "id": "pigmentary-skin-lesions",
        "description": "Presence of distinctive hyperpigmented macules and papules primarily on the face and extremities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "osseous-dysplasia",
        "description": "Radiographic evidence of terminal osseous dysplasia including bone abnormalities of the distal phalanges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "germline-flna-mutation",
        "description": "Identification of pathogenic mutation in the FLNA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digital-malformations",
        "description": "Presence of digital anomalies such as brachydactyly or syndactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Mild facial dysmorphic features including prominent forehead and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic pigmentary skin lesions and osseous dysplasia confirmed by radiographic findings plus identification of a pathogenic FLNA mutation",
    "notes": "Diagnosis is primarily clinical supported by genetic testing; skin biopsy may assist in differential diagnosis."
  },
