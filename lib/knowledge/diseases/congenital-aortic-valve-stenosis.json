  "diagnosticCriteria": {
    "formalCriteriaName": "Echocardiographic Diagnostic Criteria for Congenital Aortic Valve Stenosis",
    "criteria": [
      {
        "id": "valve-morphology",
        "description": "Presence of congenital malformation of the aortic valve (bicuspid, unicuspid, or dysplastic valve) confirmed by echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "valve-gradient",
        "description": "Elevated transvalvular aortic pressure gradient measured by Doppler echocardiography consistent with stenosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-signs",
        "description": "Clinical evidence of left ventricular outflow obstruction such as systolic murmur and reduced exercise tolerance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital aortic valve malformation with elevated transvalvular gradient on echocardiography",
    "notes": "Diagnosis is primarily based on echocardiographic findings supported by clinical presentation."
  },
