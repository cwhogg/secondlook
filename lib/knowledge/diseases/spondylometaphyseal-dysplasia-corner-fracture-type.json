        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vertebral-platyspondyly",
        "description": "Platyspondyly (flattened vertebral bodies) evident on spinal imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-limbs",
        "description": "Shortened long bones with metaphyseal irregularities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-trauma-history",
        "description": "No history of trauma to explain metaphyseal lesions",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of metaphyseal corner fracture-like lesions, platyspondyly on spinal imaging, and short limbs with metaphyseal irregularities",
    "notes": "Diagnosis is primarily radiological supported by clinical features; genetic testing may assist but is not always definitive."
  },
