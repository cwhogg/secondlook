  "diagnosticCriteria": {
    "formalCriteriaName": "ALG12-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypotonia",
        "description": "Congenital hypotonia presenting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-glycosylation",
        "description": "Demonstration of abnormal serum transferrin glycosylation pattern by isoelectric focusing or mass spectrometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alg12-mutation",
        "description": "Identification of pathogenic biallelic variants in the ALG12 gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multisystem-involvement",
        "description": "Presence of multisystem clinical features consistent with CDG (neurological, gastrointestinal, skeletal abnormalities)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of abnormal glycosylation pattern plus identification of pathogenic ALG12 variants, with supportive clinical features",
    "notes": "Diagnosis requires biochemical and genetic confirmation; clinical presentation can be variable."
  },
