  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible elevated BNP in heart failure"
    ],
    "imaging": [
      "Echocardiography showing ostium primum ASD and cleft mitral valve",
      "Chest X-ray with cardiomegaly and increased pulmonary vascular markings",
      "Cardiac MRI for detailed anatomical assessment"
    ],
    "genetic": [
      "Association with trisomy 21 (Down syndrome) in some cases"
    ],
    "other": [
      "Electrocardiogram showing left axis deviation and atrial enlargement"
    ]
  },
