  "keyFindings": {
    "laboratory": [
      "Elevated serum alkaline phosphatase in osteosarcoma",
      "Mild anemia or cytopenias in some cases"
    ],
    "imaging": [
      "Radiographs showing radial ray defects and skeletal dysplasia",
      "MRI or CT for tumor detection (osteosarcoma)"
    ],
    "genetic": [
      "Biallelic pathogenic variants in RECQL4 gene confirmed by molecular testing"
    ],
    "other": [
      "Skin biopsy showing poikiloderma with epidermal atrophy and telangiectasia"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "xeroderma-pigmentosum",
      "distinguishingFeatures": [
        "Extreme photosensitivity with early skin cancers",
        "Neurological degeneration",
        "Defective nucleotide excision repair genes"
      ]
    },
    {
      "diseaseId": "kindler-syndrome",
      "distinguishingFeatures": [
        "Blistering and skin fragility",
        "Poikiloderma develops later",
        "Mutations in FERMT1 gene"
      ]
    },
    {
      "diseaseId": "dyskeratosis-congenita",
      "distinguishingFeatures": [
        "Mucocutaneous triad (nail dystrophy, leukoplakia, reticulated pigmentation)",
        "Bone marrow failure",
        "Telomere shortening"
      ]
    }
  ],
  "redFlags": [
