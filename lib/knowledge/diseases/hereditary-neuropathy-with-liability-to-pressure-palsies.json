  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for HNPP",
    "criteria": [
      {
        "id": "recurrent-focal-neuropathies",
        "description": "Recurrent, transient focal neuropathies triggered by minor trauma or compression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Detection of PMP22 gene deletion or mutation by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-conduction-studies",
        "description": "Electrophysiological evidence of demyelinating neuropathy with conduction block",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Tomacula formation on nerve biopsy (focal myelin thickenings)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent focal neuropathies plus either positive family history or confirmed PMP22 gene deletion/mutation",
    "notes": "Genetic testing is considered the gold standard for diagnosis."
  },
