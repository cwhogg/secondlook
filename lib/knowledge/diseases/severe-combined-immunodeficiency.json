        "X-linked inheritance"
      ]
    },
    {
      "diseaseId": "x-linked-agammaglobulinemia",
      "distinguishingFeatures": [
        "Absent B cells with normal T-cell function",
        "Later onset than SCID",
        "Recurrent bacterial infections without opportunistic infections"
      ]
    }
  ],
