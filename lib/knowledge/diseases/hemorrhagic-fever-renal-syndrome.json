  "keyFindings": {
    "laboratory": [
      "Thrombocytopenia",
      "Elevated serum creatinine and blood urea nitrogen",
      "Proteinuria and hematuria on urinalysis",
      "Elevated liver transaminases",
      "Positive hantavirus-specific IgM and IgG antibodies"
    ],
    "imaging": [
      "Renal ultrasound showing enlarged kidneys with increased echogenicity",
      "Chest X-ray may show pulmonary edema in severe cases"
    ],
    "genetic": [],
    "other": [
      "Epidemiological link to rodent exposure",
      "Detection of hantavirus RNA by PCR in blood or tissue samples"
    ]
  },
