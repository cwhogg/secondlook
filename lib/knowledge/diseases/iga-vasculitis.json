  "diagnosticCriteria": {
    "formalCriteriaName": "EULAR/PRINTO/PRES 2010 Classification Criteria for IgA Vasculitis",
    "criteria": [
      {
        "id": "igav-1",
        "description": "Palpable purpura (mandatory criterion) with lower limb predominance, not related to thrombocytopenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "igav-2",
        "description": "Diffuse abdominal pain (acute onset)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "igav-3",
        "description": "Biopsy showing predominant IgA deposition (skin or kidney)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "igav-4",
        "description": "Arthritis or arthralgia (acute onset)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "igav-5",
        "description": "Renal involvement: proteinuria >0.3 g/24h or albumin/creatinine ratio >30 mmol/mg, or hematuria or red cell casts",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Palpable purpura plus at least one of the four additional criteria",
    "notes": "More severe in adults than children. Adult-onset IgA vasculitis has higher rates of renal involvement and worse renal prognosis."
  },
