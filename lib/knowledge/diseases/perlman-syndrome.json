  "keyFindings": {
    "laboratory": [
      "Transient neonatal hypoglycemia",
      "Elevated alpha-fetoprotein levels in some cases"
    ],
    "imaging": [
      "Renal ultrasound showing nephroblastomatosis or cystic dysplasia",
      "Abdominal ultrasound for Wilms tumor detection",
      "Chest X-ray showing cardiomegaly or respiratory complications"
    ],
    "genetic": [
      "DIS3L2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology of nephroblastomatosis lesions",
      "Prenatal ultrasound showing polyhydramnios and fetal overgrowth"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "beckwith-wiedemann-syndrome",
      "distinguishingFeatures": [
