  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for CPT II deficiency severe infantile form",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early onset of hypoketotic hypoglycemia, cardiomyopathy, and liver dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-testing",
        "description": "Elevated long-chain acylcarnitines in plasma and abnormal fatty acid oxidation profile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the CPT2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Reduced CPT II enzyme activity in muscle tissue",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus either biochemical abnormalities or pathogenic CPT2 gene variants",
    "notes": "Early diagnosis is critical due to rapid progression and high mortality in infancy."
  },
