  "diagnosticCriteria": {
    "formalCriteriaName": "Griscelli Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypopigmentation",
        "description": "Presence of silvery-gray hair and hypopigmentation of skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "giant-granules",
        "description": "Identification of large melanosome aggregates (giant granules) in hair shaft microscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Detection of pathogenic mutations in RAB27A, MYO5A, or MLPH genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemophagocytic-lymphohistiocytosis",
        "description": "Clinical or laboratory evidence of hemophagocytic lymphohistiocytosis (HLH)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-involvement",
        "description": "Neurological symptoms such as hypotonia or developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypopigmentation with characteristic hair shaft findings plus identification of pathogenic mutation in one of the associated genes",
    "notes": "Subtypes are classified based on the mutated gene and clinical presentation."
  },
