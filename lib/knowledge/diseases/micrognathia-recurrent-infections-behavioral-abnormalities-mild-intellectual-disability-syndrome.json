  "diagnosticCriteria": {
    "formalCriteriaName": "MRIB Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "micrognathia",
        "description": "Presence of congenital micrognathia confirmed by clinical examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-infections",
        "description": "History of recurrent bacterial or viral infections indicative of immunodeficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-abnormalities",
        "description": "Documented behavioral abnormalities including hyperactivity, anxiety, or autistic features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mild-intellectual-disability",
        "description": "Cognitive impairment consistent with mild intellectual disability (IQ 50-70)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunological-assessment",
        "description": "Laboratory evidence of immunodeficiency such as decreased immunoglobulin levels or lymphocyte dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variant(s) in associated gene(s) if known",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of micrognathia, recurrent infections, behavioral abnormalities, and mild intellectual disability",
    "notes": "Diagnosis is clinical; genetic testing may support but is not mandatory."
  },
