  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Duane Retraction Syndrome",
    "criteria": [
      {
        "id": "limited-lateral-eye-movement",
        "description": "Congenital limitation of abduction and/or adduction of the affected eye",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "globe-retraction",
        "description": "Retraction of the globe on attempted adduction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "palpebral-fissure-narrowing",
        "description": "Narrowing of the palpebral fissure on adduction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyographic-findings",
        "description": "Electromyography showing co-contraction of medial and lateral rectus muscles",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-or-hypoplasia-of-sixth-nerve",
        "description": "Imaging evidence of absent or hypoplastic abducens nerve",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital limitation of lateral eye movement with globe retraction and palpebral fissure narrowing on adduction",
    "notes": "Diagnosis is primarily clinical; imaging and electromyography can support diagnosis"
  },
