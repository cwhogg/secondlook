  "diagnosticCriteria": {
    "formalCriteriaName": "Sjögren-Larsson Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "ichthyosis",
        "description": "Congenital ichthyosis with generalized dry, scaly skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "spastic-diplegia",
        "description": "Spastic diplegia or tetraplegia with increased muscle tone and hyperreflexia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mental-retardation",
        "description": "Cognitive impairment ranging from mild to moderate intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "retinal-crystals",
        "description": "Presence of glistening white retinal crystals on ophthalmologic exam",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "fatty-acid-hydroxylase-deficiency",
        "description": "Deficiency of fatty aldehyde dehydrogenase enzyme activity in fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of congenital ichthyosis, spastic diplegia or tetraplegia, and intellectual disability with confirmation by enzyme assay or genetic testing",
    "notes": "Genetic testing for ALDH3A2 mutations confirms diagnosis"
  },
