  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Trisomy 4p Syndrome",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Presence of an extra copy of the short arm of chromosome 4 confirmed by karyotyping or chromosomal microarray",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including microcephaly, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital heart defects such as ventricular septal defect",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Prenatal and postnatal growth retardation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of trisomy 4p plus presence of characteristic craniofacial dysmorphism and developmental delay",
    "notes": "Diagnosis relies heavily on cytogenetic analysis; clinical features may vary depending on size and location of duplicated segment."
  },
