  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Spinal Muscular Atrophy",
    "criteria": [
      {
        "id": "proximal-weakness",
        "description": "Symmetrical proximal muscle weakness with onset between 6 and 18 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "motor-milestone-delay",
        "description": "Delayed motor milestones without ability to walk independently",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Homozygous deletion or mutation in SMN1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyography showing denervation and chronic reinnervation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-cognitive-function",
        "description": "Preserved cognitive function",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of symmetrical proximal muscle weakness with onset between 6-18 months, delayed motor milestones without independent walking, and genetic confirmation of SMN1 mutation or deletion",
    "notes": "Electromyography and preserved cognition support diagnosis but are not mandatory"
  },
