  "diagnosticCriteria": {
    "formalCriteriaName": "Revised Ghent Nosology (2010)",
    "criteria": [
      {
        "id": "mfs-c1",
        "description": "Aortic root dilation (Z-score >= 2) or aortic dissection",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-c2",
        "description": "Ectopia lentis (lens subluxation)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-c3",
        "description": "FBN1 mutation known to be associated with Marfan syndrome",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-c4",
        "description": "Systemic score >= 7 points (using revised Ghent scoring system)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-s1",
        "description": "Wrist AND thumb sign (3 points)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-s2",
        "description": "Wrist OR thumb sign (1 point)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-s3",
        "description": "Pectus carinatum (2 points)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-s4",
        "description": "Pectus excavatum or chest asymmetry (1 point)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-s5",
        "description": "Hindfoot valgus deformity (2 points)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-s6",
        "description": "Plain pes planus (1 point)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-s7",
        "description": "Pneumothorax (2 points)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-s8",
        "description": "Dural ectasia (2 points)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-s9",
        "description": "Protrusio acetabuli (2 points)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-s10",
        "description": "Reduced upper segment/lower segment ratio AND increased arm span/height (1 point)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-s11",
        "description": "Scoliosis or thoracolumbar kyphosis (1 point)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-s12",
        "description": "Reduced elbow extension (1 point)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-s13",
        "description": "Facial features (dolichocephaly, enophthalmos, downslanting palpebral fissures, malar hypoplasia, retrognathia) (1 point)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-s14",
        "description": "Skin striae (1 point)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-s15",
        "description": "Myopia > 3 diopters (1 point)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mfs-s16",
        "description": "Mitral valve prolapse (1 point)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Without family history: (1) Aortic root dilation (Z >= 2) + ectopia lentis = MFS; (2) Aortic root dilation + FBN1 = MFS; (3) Aortic root dilation + systemic score >= 7 = MFS; (4) Ectopia lentis + FBN1 known to cause aortic disease = MFS. With family history: (1) Ectopia lentis + family history = MFS; (2) Systemic score >= 7 + family history = MFS; (3) Aortic root dilation (Z >= 2 for adults, Z >= 3 for <20) + family history = MFS.",
    "notes": "The revised Ghent nosology emphasizes aortic root dilation/dissection and ectopia lentis as cardinal features."
  },
