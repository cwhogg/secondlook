  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for Tyrosinemia Type 2",
    "criteria": [
      {
        "id": "ocular-lesions",
        "description": "Presence of painful photophobia and corneal epithelial lesions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-lesions",
        "description": "Hyperkeratotic painful plaques on palms and soles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-tyrosine",
        "description": "Elevated plasma tyrosine levels confirmed by biochemical analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tyrosine-amino-transferase-deficiency",
        "description": "Demonstration of tyrosine aminotransferase enzyme deficiency in liver biopsy or genetic testing",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the TAT gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic ocular and cutaneous lesions combined with elevated plasma tyrosine levels",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if clinical and biochemical criteria are met."
  },
