  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Crouzon Syndrome-Acanthosis Nigricans",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of cranial sutures leading to abnormal skull shape",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acanthosis-nigricans",
        "description": "Presence of hyperpigmented, velvety thickening of the skin, especially in flexural areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fgfr3-mutation",
        "description": "Identification of pathogenic FGFR3 gene mutation (commonly p.A391E)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midface-hypoplasia",
        "description": "Underdevelopment of the midfacial bones resulting in characteristic facial appearance",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "dental-anomalies",
        "description": "Malocclusion and dental crowding",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis and acanthosis nigricans with confirmed FGFR3 mutation",
    "notes": "Genetic testing is essential to confirm diagnosis due to phenotypic overlap with classic Crouzon syndrome."
  },
