      ]
    },
    {
      "diseaseId": "refsum-disease",
      "distinguishingFeatures": [
        "Adult onset",
        "Phytanic acid accumulation without peroxisomal biogenesis defect",
        "Retinitis pigmentosa and peripheral neuropathy"
      ]
