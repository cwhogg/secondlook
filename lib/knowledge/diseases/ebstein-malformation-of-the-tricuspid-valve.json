  "diagnosticCriteria": {
    "formalCriteriaName": "Echocardiographic Diagnostic Criteria for Ebstein Malformation",
    "criteria": [
      {
        "id": "apical-displacement",
        "description": "Apical displacement of the septal and posterior leaflets of the tricuspid valve by ≥8 mm/m² body surface area",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "atrialized-right-ventricle",
        "description": "Presence of atrialized portion of the right ventricle due to downward displacement of the tricuspid valve",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tricuspid-regurgitation",
        "description": "Moderate to severe tricuspid valve regurgitation demonstrated by Doppler echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "right-atrial-enlargement",
        "description": "Right atrial enlargement on imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-signs",
        "description": "Clinical signs of right heart failure or cyanosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of apical displacement of the tricuspid valve leaflets plus evidence of tricuspid regurgitation and atrialized right ventricle on echocardiography",
    "notes": "Diagnosis is primarily based on echocardiographic findings; cardiac MRI may be used for further anatomical assessment."
  },
