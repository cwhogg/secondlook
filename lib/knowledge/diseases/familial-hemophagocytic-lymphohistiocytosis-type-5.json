  "diagnosticCriteria": {
    "formalCriteriaName": "HLH-2004 Diagnostic Criteria",
    "criteria": [
      {
        "id": "fever",
        "description": "Persistent high fever (>38.5°C)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cytopenias",
        "description": "Cytopenias affecting ≥2 of 3 lineages in the peripheral blood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemophagocytosis",
        "description": "Hemophagocytosis in bone marrow, spleen, or lymph nodes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hyperferritinemia",
        "description": "Elevated serum ferritin >500 µg/L",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "lowNKactivity",
        "description": "Decreased or absent natural killer (NK) cell activity",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevatedCD25",
        "description": "Elevated soluble CD25 (sIL-2 receptor) levels",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular diagnosis consistent with FHL5 or fulfillment of 5 out of 8 HLH-2004 criteria",
    "notes": "Genetic testing for STXBP2 mutations confirms diagnosis of FHL5"
  },
