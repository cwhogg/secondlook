  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for primary acid-labile subunit deficiency",
    "criteria": [
      {
        "id": "criterion-1",
        "description": "Documented short stature with height below the 3rd percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-2",
        "description": "Biochemical evidence of isolated acid-labile subunit (ALS) deficiency with normal growth hormone and IGF-1 levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-3",
        "description": "Identification of pathogenic variants in the IGFALS gene by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-4",
        "description": "Exclusion of other causes of short stature including growth hormone deficiency and systemic diseases",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: short stature, biochemical ALS deficiency, and pathogenic IGFALS variants",
    "notes": "Diagnosis requires integration of clinical, biochemical, and genetic findings."
  },
