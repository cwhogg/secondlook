  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for Myhre Syndrome",
    "criteria": [
      {
        "id": "smad4-mutation",
        "description": "Presence of heterozygous pathogenic variant in SMAD4 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Postnatal short stature with slow growth velocity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facies",
        "description": "Distinctive facial features including brachycephaly, midface hypoplasia, and prognathism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-stiffness",
        "description": "Progressive joint stiffness and limited range of motion",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skin-thickening",
        "description": "Thickened, tight skin resembling scleroderma",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural or conductive hearing loss",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic SMAD4 mutation plus at least two major clinical features",
    "notes": "Molecular confirmation is essential due to phenotypic overlap with other connective tissue disorders."
  },
