  "diagnosticCriteria": {
    "formalCriteriaName": "2019 ACR/EULAR Classification Criteria for IgG4-Related Disease",
    "criteria": [
      {
        "id": "igg4-1",
        "description": "Characteristic organ involvement (pancreas, biliary tree, salivary glands, lacrimal glands, retroperitoneum, aorta, kidneys, lungs)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "igg4-2",
        "description": "Elevated serum IgG4 (>135 mg/dL)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "igg4-3",
        "description": "Histopathology: dense lymphoplasmacytic infiltrate with increased IgG4+ plasma cells (>10/HPF) and IgG4:IgG ratio >40%",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "igg4-4",
        "description": "Storiform fibrosis on biopsy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "igg4-5",
        "description": "Obliterative phlebitis on biopsy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "igg4-6",
        "description": "Response to glucocorticoid therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "igg4-7",
        "description": "Exclusion criteria: known malignancy, infection, or other autoimmune disease that better explains findings",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Entry criterion (characteristic clinical/radiologic involvement of typical organ) plus total inclusion/exclusion criteria score meeting classification threshold",
    "notes": "The 2019 ACR/EULAR criteria use a three-step process: (1) entry criteria (organ involvement), (2) exclusion criteria (must be absent), (3) inclusion criteria with weighted scoring across 8 domains. Serum IgG4 is elevated in only 50-70% of cases."
  },
