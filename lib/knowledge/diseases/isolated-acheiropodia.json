  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Acheiropodia",
    "criteria": [
      {
        "id": "congenital-limb-absence",
        "description": "Bilateral congenital absence of distal upper and lower limbs distal to the elbow and knee",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-proximal-limb-development",
        "description": "Normal development of proximal limb segments (humerus and femur intact)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-malformations",
        "description": "No associated visceral or craniofacial malformations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-confirmation",
        "description": "Radiographic evidence confirming absence of distal limb bones",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of homozygous deletion or mutation in the LMBR1 gene regulatory region",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral congenital absence of distal limbs with normal proximal limb development and absence of other malformations",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory"
  },
