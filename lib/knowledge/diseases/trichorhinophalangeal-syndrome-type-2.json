  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for TRPS Type II",
    "criteria": [
      {
        "id": "cone-shaped-epiphyses",
        "description": "Presence of cone-shaped epiphyses on hand radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial features including bulbous nose, sparse scalp hair, and long philtrum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multiple-exostoses",
        "description": "Multiple osteochondromas (exostoses) detected clinically or radiographically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "short-stature",
        "description": "Short stature below the 3rd percentile for age and sex",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: cone-shaped epiphyses, distinctive facial features, and multiple exostoses",
    "notes": "Genetic testing for deletions involving TRPS1 and EXT1 genes can confirm diagnosis"
  },
