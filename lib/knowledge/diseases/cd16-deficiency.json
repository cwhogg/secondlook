  "keyFindings": {
    "laboratory": [
      "Absent or reduced CD16 expression on NK cells by flow cytometry",
      "Reduced NK cell antibody-dependent cellular cytotoxicity assays",
      "Normal total lymphocyte and NK cell counts",
      "Elevated viral load during infections"
    ],
    "imaging": [
      "Possible hepatosplenomegaly on abdominal ultrasound during infections",
      "Lymphadenopathy on CT or MRI in some cases"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Impaired NK cell-mediated cytotoxicity functional assays",
      "Normal immunoglobulin levels"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "natural-killer-cell-deficiency",
      "distinguishingFeatures": [
        "Global NK cell absence or severe reduction",
        "Broader susceptibility to infections beyond viral",
        "Reduced NK cell counts rather than isolated CD16 deficiency"
      ]
    },
    {
      "diseaseId": "common-variable-immunodeficiency",
      "distinguishingFeatures": [
        "Hypogammaglobulinemia",
        "Broad antibody deficiency",
        "Recurrent bacterial infections predominant"
      ]
    }
  ],
  "redFlags": [
    "Severe or recurrent herpesvirus infections",
    "Failure to clear viral infections despite standard treatment",
    "Markedly reduced NK cell ADCC activity"
  ],
