  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Atypical PKAN",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of extrapyramidal symptoms including dystonia and parkinsonism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-mri-iron",
        "description": "MRI evidence of iron accumulation in the globus pallidus with 'eye of the tiger' sign absent or atypical",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pank2-mutation",
        "description": "Identification of pathogenic mutations in the PANK2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-neurological-decline",
        "description": "Progressive neurological deterioration over months to years",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of extrapyramidal symptoms plus MRI evidence of brain iron accumulation and pathogenic PANK2 mutation",
    "notes": "Diagnosis may be supported by exclusion of other NBIA subtypes and related disorders."
  },
