  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for 11q22.2q22.3 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of heterozygous microdeletion involving chromosome 11q22.2q22.3 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital heart defects such as ventricular septal defect or atrial septal defect",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of genetic confirmation plus at least two major clinical features",
    "notes": "Diagnosis relies heavily on molecular genetic testing due to phenotypic variability."
  },
