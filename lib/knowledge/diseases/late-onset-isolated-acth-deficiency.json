  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for isolated ACTH deficiency",
    "criteria": [
      {
        "id": "low-acth",
        "description": "Low or undetectable plasma ACTH levels despite low cortisol",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "secondary-adrenal-insufficiency",
        "description": "Evidence of secondary adrenal insufficiency with low serum cortisol",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-other-pituitary-hormones",
        "description": "Normal secretion of other anterior pituitary hormones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-pituitary-lesion",
        "description": "No structural pituitary abnormalities on MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-response-to-glucocorticoids",
        "description": "Clinical improvement after glucocorticoid replacement therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of low ACTH and cortisol levels with normal other pituitary hormones and exclusion of pituitary lesions",
    "notes": "Diagnosis requires exclusion of other causes of secondary adrenal insufficiency and pituitary disease."
  },
