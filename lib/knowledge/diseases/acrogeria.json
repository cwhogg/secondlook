        "requiredForDiagnosis": false
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development and intelligence",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (acrogeric skin thinness and premature skin aging) with supportive radiological findings",
    "notes": "Diagnosis is primarily clinical supported by radiographic findings; genetic testing may be inconclusive."
