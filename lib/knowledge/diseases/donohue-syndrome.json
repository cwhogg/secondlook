  "keyFindings": {
    "laboratory": [
      "Marked hyperinsulinemia despite hypoglycemia or euglycemia",
      "Elevated fasting insulin levels",
      "Abnormal glucose tolerance tests"
    ],
    "imaging": [
      "Echocardiogram may show cardiomyopathy",
      "Ultrasound may reveal hepatomegaly"
    ],
    "genetic": [
      "Biallelic pathogenic mutations in the INSR gene (insulin receptor gene)"
    ],
    "other": [
      "Characteristic facial dysmorphism on clinical examination",
      "Skin biopsy may show acanthosis nigricans"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "type-a-insulin-resistance-syndrome",
      "distinguishingFeatures": [
        "Milder insulin resistance",
        "Later onset",
        "Lack of severe growth retardation and characteristic facial features"
      ]
    },
    {
      "diseaseId": "rabson-mendenhall-syndrome",
      "distinguishingFeatures": [
        "Less severe insulin resistance than Donohue syndrome",
        "Presence of dental abnormalities and pineal hyperplasia",
        "Longer survival"
      ]
    }
  ],
  "redFlags": [
    "Severe hypoglycemia in neonate or infant",
    "Failure to thrive with characteristic facial features",
    "Refractory hyperinsulinemia despite treatment"
  ],
