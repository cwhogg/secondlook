  "diagnosticCriteria": {
    "formalCriteriaName": "Endocrine Society Clinical Practice Guidelines for Pheochromocytoma/Paraganglioma",
    "criteria": [
      {
        "id": "pheo-c1",
        "description": "Elevated plasma free metanephrines (metanephrine and/or normetanephrine) >2x upper limit of normal",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pheo-c2",
        "description": "Adrenal mass identified on cross-sectional imaging (CT or MRI)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pheo-c3",
        "description": "Histopathological confirmation of chromaffin cell tumor after surgical resection",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pheo-c4",
        "description": "Positive functional imaging (MIBG scan, 68Ga-DOTATATE PET/CT, or 18F-FDG PET)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "pheo-c5",
        "description": "Elevated 24-hour urinary fractionated metanephrines and catecholamines",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "pheo-c6",
        "description": "Classic triad of episodic headache, sweating, and tachycardia with hypertension",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biochemical evidence of catecholamine excess (elevated plasma metanephrines) plus anatomic localization by imaging. Definitive diagnosis by histopathology after resection.",
    "notes": "Up to 40% of pheochromocytomas are associated with germline mutations. The 'rule of 10s' (10% bilateral, 10% extra-adrenal, 10% malignant, 10% familial) is now considered outdated as hereditary rates are closer to 30-40%."
  },
