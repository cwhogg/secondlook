  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of metabolic and infectious causes"
    ],
    "imaging": [
      "MRI brain and spinal cord typically normal or showing mild corticospinal tract hyperintensities",
      "No evidence of demyelination or structural lesions"
    ],
    "genetic": [
      "ALDH18A1 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography (EMG) may show mild chronic neurogenic changes",
      "Nerve conduction studies usually normal or mildly reduced sensory nerve action potentials"
    ]
  },
