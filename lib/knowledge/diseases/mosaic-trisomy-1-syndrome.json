  "keyFindings": {
    "laboratory": [
      "Karyotype analysis showing mosaic trisomy 1",
      "Normal routine blood counts unless secondary complications"
    ],
    "imaging": [
      "Echocardiography revealing congenital heart defects",
      "Skeletal X-rays showing limb anomalies",
      "Brain MRI may show nonspecific abnormalities"
    ],
    "genetic": [
      "Presence of an additional copy of chromosome 1 in a subset of cells",
      "Mosaicism confirmed by FISH or chromosomal microarray"
    ],
    "other": [
      "Prenatal ultrasound may detect growth retardation and structural anomalies"
    ]
  },
