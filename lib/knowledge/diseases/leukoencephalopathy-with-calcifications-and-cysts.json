  "keyFindings": {
    "laboratory": [
      "Mild anemia or pancytopenia in some cases",
      "Normal or mildly elevated inflammatory markers"
    ],
    "imaging": [
      "MRI showing diffuse leukoencephalopathy with cystic lesions",
      "CT demonstrating bilateral intracranial calcifications",
      "Retinal imaging showing telangiectasia and exudates"
    ],
    "genetic": [
      "SNORD118 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology of cyst walls showing gliosis and microangiopathy"
    ]
  },
