  "diagnosticCriteria": {
    "formalCriteriaName": "European Centre for Disease Prevention and Control (ECDC) case definition",
    "criteria": [
      {
        "id": "clinical-manifestation",
        "description": "Presence of clinical signs of central nervous system involvement such as meningitis, meningoencephalitis, or meningoencephalomyelitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "laboratory-confirmation",
        "description": "Detection of specific IgM and IgG antibodies against TBE virus in serum or cerebrospinal fluid",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epidemiological-link",
        "description": "History of tick exposure or residence/travel in endemic areas",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical signs of CNS involvement plus laboratory confirmation of TBE virus-specific antibodies",
    "notes": "PCR testing may be supportive but is often negative in CNS phase"
  },
