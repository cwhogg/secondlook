  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Hypohidrotic Ectodermal Dysplasia",
    "criteria": [
      {
        "id": "hypohidrosis",
        "description": "Reduced or absent sweating (hypohidrosis or anhidrosis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotrichosis",
        "description": "Sparse, thin, or absent scalp hair and eyebrows",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypodontia",
        "description": "Congenital absence of multiple teeth or abnormal tooth shape",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-features",
        "description": "Characteristic facial features including frontal bossing, saddle nose, and periorbital hyperpigmentation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (hypohidrosis, hypotrichosis, and hypodontia) or genetic confirmation of EDA gene mutation",
    "notes": "Genetic testing for mutations in the EDA gene can confirm diagnosis; clinical variability exists."
  },
