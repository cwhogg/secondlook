  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Fazio-Londe Syndrome",
    "criteria": [
      {
        "id": "progressive-bulbar-palsy",
        "description": "Progressive weakness of bulbar muscles leading to dysarthria and dysphagia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-sensory-involvement",
        "description": "No sensory nerve involvement or sensory deficits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "childhood-onset",
        "description": "Onset of symptoms during childhood or adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyography showing motor neuron degeneration without sensory abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in SLC52A3 or related genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive bulbar palsy in childhood without sensory involvement, supported by EMG and/or genetic testing",
    "notes": "Diagnosis is clinical but supported by electrophysiological and genetic studies; exclusion of other motor neuron diseases is essential."
  },
