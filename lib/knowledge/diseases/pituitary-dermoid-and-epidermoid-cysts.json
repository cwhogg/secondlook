  "keyFindings": {
    "laboratory": [
      "Hormonal assays showing pituitary hormone deficiencies (e.g., low ACTH, TSH, LH/FSH)",
      "Water deprivation test abnormalities in diabetes insipidus cases"
    ],
    "imaging": [
      "MRI: well-circumscribed cystic lesion with variable signal intensity on T1 and T2 weighted images",
      "CT: hypodense lesion with possible calcifications in sellar region"
    ],
    "genetic": [
      "No known genetic mutations associated"
    ],
    "other": [
      "Histopathology: keratinized stratified squamous epithelium lining cyst wall; dermoid cysts may contain dermal appendages"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "craniopharyngioma",
      "distinguishingFeatures": [
        "Presence of calcifications and solid-cystic components on imaging",
        "Histology shows adamantinomatous or papillary epithelium rather than keratinized squamous epithelium"
      ]
    },
    {
      "diseaseId": "pituitary-adenoma",
      "distinguishingFeatures": [
        "Solid enhancing mass on imaging without cystic keratin debris",
        "Hormonal hypersecretion syndromes more common"
      ]
    },
    {
      "diseaseId": "arachnoid-cyst",
      "distinguishingFeatures": [
        "CSF-like signal intensity on MRI without keratin debris",
        "No epithelial lining on histology"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset of visual field loss",
