  "diagnosticCriteria": {
    "formalCriteriaName": "EORTC/MSG Consensus Criteria for Invasive Fusariosis",
    "criteria": [
      {
        "id": "microbiological-evidence",
        "description": "Isolation of Fusarium species from sterile site cultures or histopathological evidence of fungal hyphae consistent with Fusarium",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical signs such as necrotic skin lesions or disseminated infection in immunocompromised patients",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-findings",
        "description": "Imaging evidence of invasive fungal infection such as pulmonary nodules or sinus involvement",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "host-factors",
        "description": "Immunocompromised status including neutropenia, hematologic malignancy, or stem cell transplantation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Isolation of Fusarium spp. from sterile site or histopathological confirmation plus compatible clinical features in an immunocompromised host",
    "notes": "Diagnosis is challenging due to similarity with other mold infections; culture and histopathology remain gold standards."
  },
