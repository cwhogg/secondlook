  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnosis of Dracunculiasis",
    "criteria": [
      {
        "id": "emergence-of-adult-worm",
        "description": "Emergence of a female Guinea worm through the skin, typically on lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "localized-vesicular-lesion",
        "description": "Presence of a painful, burning blister or vesicle on the skin at the site of worm emergence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "history-of-exposure",
        "description": "History of drinking unsafe stagnant water in endemic regions",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "eosinophilia",
        "description": "Peripheral blood eosinophilia during early infection",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of adult worm emergence through skin with characteristic blister plus history of exposure in endemic area",
    "notes": "Laboratory confirmation is rarely necessary; diagnosis is primarily clinical."
  },
