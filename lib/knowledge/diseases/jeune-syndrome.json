  "diagnosticCriteria": {
    "formalCriteriaName": "Jeune Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "narrow-thorax",
        "description": "Narrow, bell-shaped thorax with short ribs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-limbs",
        "description": "Shortened long bones (rhizomelic or mesomelic limb shortening)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "respiratory-insufficiency",
        "description": "Respiratory distress or insufficiency due to thoracic restriction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-cystic-disease",
        "description": "Presence of renal cystic disease or nephronophthisis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "polydactyly",
        "description": "Postaxial polydactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in known causative genes (e.g., IFT80, DYNC2H1)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (narrow thorax, short limbs, respiratory insufficiency) with or without supportive genetic or minor clinical features",
    "notes": "Genetic testing can support diagnosis but is not mandatory; clinical presentation is key."
  },
