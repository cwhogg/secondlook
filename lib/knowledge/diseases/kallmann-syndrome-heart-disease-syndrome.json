        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-cardiac-anomaly",
        "description": "Presence of congenital heart disease, including septal defects or valvular abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
