    "formalCriteriaName": "HLRCC Diagnostic Criteria",
    "criteria": [
      {
        "id": "cutaneous-leiomyomas",
        "description": "Presence of multiple cutaneous piloleiomyomas confirmed by histopathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "uterine-leiomyomas",
        "description": "Early-onset multiple uterine leiomyomas in females",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-cell-carcinoma",
        "description": "Diagnosis of type 2 papillary renal cell carcinoma or other RCC subtypes associated with HLRCC",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "fh-gene-mutation",
        "description": "Identification of pathogenic germline FH gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
