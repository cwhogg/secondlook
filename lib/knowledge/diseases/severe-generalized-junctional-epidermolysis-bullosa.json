  "keyFindings": {
    "laboratory": [
      "Anemia with normocytic or microcytic indices",
      "Elevated inflammatory markers during infections"
    ],
    "imaging": [
      "Barium swallow showing esophageal strictures",
      "Chest X-ray may reveal airway narrowing"
    ],
    "genetic": [
      "LAMB3 (causative)",
      "LAMC2 (causative)",
      "LAMA3 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Immunofluorescence mapping demonstrating reduced or absent laminin-332",
      "Electron microscopy showing lamina lucida cleavage"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dystrophic-epidermolysis-bullosa",
      "distinguishingFeatures": [
        "Blistering occurs below the basement membrane (sublamina densa)",
        "Mutations in COL7A1 gene",
        "More prominent scarring and milia formation"
      ]
    },
    {
      "diseaseId": "epidermolysis-bullosa-simplex",
      "distinguishingFeatures": [
        "Blistering occurs intraepidermally (basal keratinocytes)",
        "Usually milder phenotype with localized blistering",
        "Mutations in KRT5 or KRT14 genes"
      ]
    }
  ],
  "redFlags": [
    "Neonatal onset of widespread blistering with mucosal involvement",
    "Rapid progression to extensive skin loss and secondary infections",
    "Failure to thrive despite nutritional support"
  ],
