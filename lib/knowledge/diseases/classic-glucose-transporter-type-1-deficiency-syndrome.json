  "diagnosticCriteria": {
    "formalCriteriaName": "GLUT1 Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "low-csf-glucose",
        "description": "Hypoglycorrhachia (low cerebrospinal fluid glucose) with normal blood glucose",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of early-onset seizures, developmental delay, and movement disorders",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic SLC2A1 gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ketogenic-diet-response",
        "description": "Clinical improvement with ketogenic diet",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypoglycorrhachia plus either pathogenic SLC2A1 mutation or characteristic clinical features",
    "notes": "CSF glucose measurement should be performed after fasting; genetic testing confirms diagnosis."
  },
