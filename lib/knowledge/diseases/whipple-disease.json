  "keyFindings": {
    "laboratory": [
      "PAS-positive, diastase-resistant macrophages in duodenal biopsies (hallmark)",
      "Anemia (iron and/or folate deficiency from malabsorption)",
      "Hypoalbuminemia",
      "Elevated ESR and CRP",
      "T. whipplei PCR positive in tissue, stool, saliva, or CSF"
    ],
    "imaging": [
      "CT abdomen: mesenteric/retroperitoneal lymphadenopathy, often with low-density centers",
      "MRI brain: focal lesions in hypothalamus, periventricular regions in CNS disease",
      "Small bowel imaging may show thickened mucosal folds"
    ],
    "genetic": [
      "IRF4 (susceptibility)"
    ],
    "other": [
      "Upper endoscopy: pale, shaggy duodenal mucosa with whitish-yellow patches (lymphatic obstruction)",
      "CSF analysis recommended in all cases (PCR for T. whipplei) to assess for CNS involvement",
      "Electron microscopy: rod-shaped bacilli within macrophages"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "celiac-disease",
      "distinguishingFeatures": [
        "Celiac has villous atrophy but no PAS-positive macrophages",
        "Celiac responds to gluten-free diet",
        "Positive anti-tTG/anti-endomysial antibodies in celiac"
      ]
    },
    {
      "diseaseId": "mycobacterium-avium-complex",
      "distinguishingFeatures": [
        "MAC is acid-fast positive, PAS-positive",
        "MAC occurs in severely immunocompromised (AIDS)",
        "Differentiated by AFB staining and culture"
      ]
    },
    {
      "diseaseId": "sarcoidosis",
      "distinguishingFeatures": [
        "Sarcoidosis shows non-caseating granulomas, not PAS-positive macrophages",
        "Sarcoidosis has elevated ACE levels"
      ]
    }
  ],
  "redFlags": [
    "Neurological symptoms (oculomasticatory myorhythmia, cognitive changes, seizures) suggesting CNS involvement",
    "Culture-negative endocarditis with systemic symptoms",
    "Relapse of symptoms during or after treatment (especially neurological relapse)",
    "Severe malnutrition requiring parenteral support"
  ],
