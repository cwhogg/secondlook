  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for PLA2G6-associated neurodegeneration",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Progressive dystonia and parkinsonism with onset in childhood or adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-iron-accumulation",
        "description": "MRI evidence of iron accumulation in the globus pallidus and substantia nigra",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the PLA2G6 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-neuroimaging",
        "description": "Cerebral and cerebellar atrophy on neuroimaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of neurodegeneration with brain iron accumulation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive dystonia/parkinsonism, MRI evidence of brain iron accumulation, and biallelic pathogenic PLA2G6 variants",
    "notes": "Genetic testing is essential for definitive diagnosis."
  },
