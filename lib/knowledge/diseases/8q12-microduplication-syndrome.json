  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of a microduplication involving the 8q12 chromosomal region confirmed by chromosomal microarray or other molecular cytogenetic techniques",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including broad forehead, hypertelorism, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or skeletal abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 8q12 microduplication plus at least one major clinical feature such as developmental delay or characteristic craniofacial dysmorphism",
    "notes": "Diagnosis relies primarily on molecular genetic testing; clinical features are variable and nonspecific."
  },
