  "keyFindings": {
    "laboratory": [
      "Elevated liver transaminases (AST, ALT)",
      "Hypoglycemia with fasting",
      "Elevated serum bilirubin",
      "Coagulopathy due to liver dysfunction"
    ],
    "imaging": [
      "Ultrasound showing hepatosplenomegaly and nodular liver surface",
      "MRI indicating liver fibrosis and cirrhosis"
    ],
    "genetic": [
      "Pathogenic mutations in GBE1 gene confirmed by molecular genetic testing"
    ],
    "other": [
      "Liver biopsy showing abnormal glycogen with reduced branching enzyme activity",
      "Electron microscopy revealing amylopectin-like inclusions"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "glycogen-storage-disease-type-iii",
      "distinguishingFeatures": [
        "Deficiency of debranching enzyme instead of branching enzyme",
        "Less severe liver fibrosis",
        "Different genetic mutations (AGL gene)"
      ]
    },
    {
      "diseaseId": "glycogen-storage-disease-type-vi",
      "distinguishingFeatures": [
        "Deficiency of liver phosphorylase",
        "Milder hepatomegaly and hypoglycemia",
        "No amylopectin-like glycogen deposits"
      ]
    },
    {
      "diseaseId": "progressive familial intrahepatic cholestasis",
      "distinguishingFeatures": [
        "Cholestasis predominant",
        "Different genetic mutations (e.g. ATP8B1, ABCB11)",
        "Absence of abnormal glycogen deposits"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive liver failure in infancy",
