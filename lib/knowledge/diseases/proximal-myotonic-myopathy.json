  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Proximal Myotonic Myopathy",
    "criteria": [
      {
        "id": "clinical-myotonia",
        "description": "Presence of clinical myotonia demonstrated by delayed muscle relaxation after contraction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "proximal-muscle-weakness",
        "description": "Proximal muscle weakness predominantly affecting limb girdle muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of CCTG repeat expansion in the CNBP gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Electromyographic evidence of myotonic discharges",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing type 2 fiber atrophy and nuclear clumps",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical myotonia, proximal muscle weakness, and confirmation by genetic testing",
    "notes": "Genetic confirmation is essential for definitive diagnosis; clinical and EMG findings support diagnosis."
  },
