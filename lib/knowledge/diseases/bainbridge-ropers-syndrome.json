    "laboratory": [
      "Normal routine labs; no specific biochemical markers identified"
    ],
    "imaging": [
      "Brain MRI may show nonspecific cerebral atrophy or delayed myelination",
      "Skeletal X-rays may reveal scoliosis or other skeletal anomalies"
    ],
    "genetic": [
      "ASXL3 (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electroencephalogram (EEG) abnormalities in patients with seizures"
    ]
  },
