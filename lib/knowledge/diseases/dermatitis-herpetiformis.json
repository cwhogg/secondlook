  "diagnosticCriteria": {
    "formalCriteriaName": "Dermatitis Herpetiformis Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Chronic, intensely pruritic grouped papulovesicular eruption on extensor surfaces",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "direct-immunofluorescence",
        "description": "Granular IgA deposits in dermal papillae on direct immunofluorescence of perilesional skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gluten-sensitivity",
        "description": "Evidence of gluten sensitivity or celiac disease (serologic or histologic)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Subepidermal blister with neutrophilic microabscesses in dermal papillae",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical lesions plus granular IgA deposits on direct immunofluorescence",
    "notes": "Serologic tests for anti-tissue transglutaminase and anti-endomysial antibodies support diagnosis"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Grouped pruritic papulovesicles on extensor surfaces",
        "frequency": 0.9,
        "bodySystem": "dermatological"
      },
      {
        "symptomName": "Granular IgA deposits in dermal papillae",
        "frequency": 0.95,
        "bodySystem": "immunological"
      }
    ],
    "common": [
      {
        "symptomName": "Intense pruritus",
        "frequency": 0.85,
        "bodySystem": "dermatological"
      },
      {
        "symptomName": "Symmetric distribution of lesions on elbows and knees",
        "frequency": 0.8,
        "bodySystem": "dermatological"
      },
      {
        "symptomName": "Excoriations and crusting secondary to scratching",
        "frequency": 0.75,
        "bodySystem": "dermatological"
      },
      {
        "symptomName": "Associated gluten-sensitive enteropathy symptoms (e.g. diarrhea, bloating)",
        "frequency": 0.6,
        "bodySystem": "gastrointestinal"
      }
    ],
    "occasional": [
      {
        "symptomName": "Lesions on scalp, buttocks, or back",
        "frequency": 0.3,
        "bodySystem": "dermatological"
      },
      {
        "symptomName": "Mild anemia related to malabsorption",
        "frequency": 0.25,
        "bodySystem": "hematological"
      },
      {
        "symptomName": "Fatigue due to associated celiac disease",
        "frequency": 0.2,
        "bodySystem": "constitutional"
      },
      {
        "symptomName": "Oral mucosal lesions",
        "frequency": 0.15,
        "bodySystem": "otolaryngological"
      }
    ],
    "rare": [
      {
        "symptomName": "Peripheral neuropathy",
        "frequency": 0.05,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Arthralgia or arthritis",
        "frequency": 0.04,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Weight loss due to malabsorption",
        "frequency": 0.03,
        "bodySystem": "constitutional"
      }
    ]
  },
