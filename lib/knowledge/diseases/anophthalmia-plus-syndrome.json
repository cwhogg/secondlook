  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Anophthalmia Plus Syndrome",
    "criteria": [
      {
        "id": "anophthalmia",
        "description": "Complete absence of one or both eyes (anophthalmia) confirmed by clinical and imaging examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-anomalies",
        "description": "Presence of craniofacial malformations such as micrognathia, cleft palate, or midface hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "systemic-malformations",
        "description": "Associated systemic anomalies including cardiac, renal, or skeletal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes known to be associated with anophthalmia plus syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of anophthalmia plus at least one major systemic or craniofacial anomaly",
    "notes": "Diagnosis is primarily clinical supported by imaging and genetic testing when available."
  },
