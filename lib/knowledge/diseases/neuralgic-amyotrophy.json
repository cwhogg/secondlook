  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Neuralgic Amyotrophy",
    "criteria": [
      {
        "id": "acute-onset-pain",
        "description": "Sudden onset of severe, often unilateral, shoulder and upper arm pain",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-weakness-atrophy",
        "description": "Subsequent weakness and atrophy of muscles innervated by affected nerves",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrodiagnostic-confirmation",
        "description": "Electromyography (EMG) showing denervation in affected muscles",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "sensory-disturbances",
        "description": "Sensory symptoms such as numbness or paresthesia in affected nerve distribution",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes such as cervical radiculopathy or rotator cuff pathology",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Acute onset of severe shoulder/upper arm pain followed by muscle weakness/atrophy with exclusion of other causes",
    "notes": "Diagnosis is primarily clinical supported by electrodiagnostic studies; imaging may be used to exclude other pathologies."
  },
