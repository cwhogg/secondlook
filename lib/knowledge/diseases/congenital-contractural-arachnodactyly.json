  "diagnosticCriteria": {
    "formalCriteriaName": "Beals Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "arachnodactyly",
        "description": "Presence of long, slender fingers and toes (arachnodactyly)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-contractures",
        "description": "Congenital contractures of large joints (elbows, knees, hips)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "crumpled-ears",
        "description": "Characteristic crumpled or folded external ears",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dolichostenomelia",
        "description": "Disproportionate limb lengthening (dolichostenomelia)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "kyphoscoliosis",
        "description": "Progressive kyphoscoliosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "fibrillin-2-mutation",
        "description": "Identification of pathogenic FBN2 gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (arachnodactyly, congenital contractures, and crumpled ears) or identification of pathogenic FBN2 mutation with supportive clinical features",
    "notes": "Genetic testing for FBN2 mutations can confirm diagnosis; differentiation from Marfan syndrome is critical."
  },
