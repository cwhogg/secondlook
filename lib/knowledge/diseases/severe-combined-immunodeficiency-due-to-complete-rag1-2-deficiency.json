  "diagnosticCriteria": {
    "formalCriteriaName": "ESID Diagnostic Criteria for SCID",
    "criteria": [
      {
        "id": "lymphopenia",
        "description": "Profound T-cell lymphopenia with absent or severely reduced B and NK cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in RAG1 or RAG2 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-vaccine-response",
        "description": "Absent or severely impaired response to vaccines and mitogens",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-presentation",
        "description": "Early onset of severe infections including opportunistic infections",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of profound T-cell lymphopenia plus biallelic pathogenic variants in RAG1 or RAG2 genes, with compatible clinical presentation",
    "notes": "Genetic confirmation is essential for definitive diagnosis; newborn screening for T-cell receptor excision circles (TRECs) may aid early detection."
  },
