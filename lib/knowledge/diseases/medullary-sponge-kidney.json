  "keyFindings": {
    "laboratory": [
      "Microscopic hematuria on urinalysis",
      "Possible mild elevation of serum creatinine in advanced cases",
      "Urine culture positive in urinary tract infections"
    ],
    "imaging": [
      "Contrast-enhanced CT or intravenous pyelogram showing cystic dilatation of collecting ducts",
      "Medullary nephrocalcinosis visible on ultrasound or CT",
      "'Brush-like' or 'paintbrush' appearance of papillae on imaging"
    ],
    "genetic": [
      "MTHFR (causative)",
      "No specific gene mutation identified; considered sporadic or familial with unclear inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Recurrent nephrolithiasis and urinary tract infections as clinical sequelae"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "nephrocalcinosis",
      "distinguishingFeatures": [
        "Diffuse calcium deposition in renal parenchyma without cystic dilatation",
        "Often secondary to metabolic disorders"
      ]
    },
    {
      "diseaseId": "autosomal-dominant-polycystic-kidney-disease",
      "distinguishingFeatures": [
        "Multiple large cysts throughout cortex and medulla",
        "Family history positive",
        "Progressive renal enlargement and failure"
      ]
    },
    {
      "diseaseId": "medullary-cystic-kidney-disease",
      "distinguishingFeatures": [
        "Medullary cysts with tubulointerstitial fibrosis",
        "Progressive renal failure",
        "No nephrocalcinosis"
      ]
    }
  ],
  "redFlags": [
    "Recurrent severe urinary tract infections",
    "Progressive renal insufficiency",
    "Uncontrolled hypertension in young patient"
  ],
