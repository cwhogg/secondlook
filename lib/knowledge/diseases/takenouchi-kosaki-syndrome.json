  "diagnosticCriteria": {
    "formalCriteriaName": "Takenouchi-Kosaki syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "heterozygous-cdc42-mutation",
        "description": "Presence of heterozygous pathogenic variants in the CDC42 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-developmental-delay",
        "description": "Congenital developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facial-dysmorphism",
        "description": "Distinctive facial features including hypertelorism, downslanting palpebral fissures, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital heart defects such as ventricular septal defect or patent ductus arteriosus",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Sensorineural hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Identification of a pathogenic CDC42 variant plus presence of congenital developmental delay and characteristic facial dysmorphism",
    "notes": "Genetic testing is essential for confirmation; clinical features may vary in severity."
  },
