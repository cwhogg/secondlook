  "diagnosticCriteria": {
    "formalCriteriaName": "MEN1 Clinical Diagnostic Criteria",
    "criteria": [
      {
        "id": "parathyroid-tumor",
        "description": "Presence of two or more primary MEN1-associated endocrine tumors (parathyroid, pancreatic islets, pituitary)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "first-degree-relative",
        "description": "First-degree relative with MEN1 diagnosis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "men1-gene-mutation",
        "description": "Detection of MEN1 gene mutation by genetic testing",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of two or more primary MEN1-associated endocrine tumors or one tumor plus a first-degree relative with MEN1 or a confirmed MEN1 gene mutation",
    "notes": "Genetic testing is recommended for at-risk family members."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Primary hyperparathyroidism",
        "frequency": 0.9,
        "bodySystem": "endocrine",
        "notes": "Most common initial manifestation"
      },
      {
        "symptomName": "Pancreatic neuroendocrine tumors",
        "frequency": 0.75,
        "bodySystem": "endocrine",
        "notes": "Includes gastrinomas, insulinomas"
      },
      {
        "symptomName": "Pituitary adenomas",
        "frequency": 0.7,
        "bodySystem": "endocrine",
        "notes": "Prolactinomas most frequent subtype"
      }
    ],
    "common": [
      {
        "symptomName": "Hypercalcemia-related fatigue",
        "frequency": 0.65,
        "bodySystem": "constitutional",
        "notes": "Due to hyperparathyroidism"
      },
      {
        "symptomName": "Peptic ulcer disease",
        "frequency": 0.6,
        "bodySystem": "gastrointestinal",
        "notes": "Often related to gastrinoma"
      },
      {
        "symptomName": "Kidney stones",
        "frequency": 0.58,
        "bodySystem": "renal",
        "notes": "Secondary to hypercalcemia"
      },
      {
        "symptomName": "Galactorrhea",
        "frequency": 0.55,
        "bodySystem": "endocrine",
        "notes": "Associated with prolactin-secreting pituitary adenomas"
      },
      {
        "symptomName": "Hypoglycemia episodes",
        "frequency": 0.5,
        "bodySystem": "endocrine",
        "notes": "Due to insulinoma"
      }
    ],
    "occasional": [
      {
        "symptomName": "Abdominal pain",
        "frequency": 0.4,
        "bodySystem": "gastrointestinal",
        "notes": "From pancreatic tumors or ulcers"
      },
      {
        "symptomName": "Headache",
        "frequency": 0.35,
        "bodySystem": "neurological",
        "notes": "Due to pituitary adenomas"
      },
      {
        "symptomName": "Visual field defects",
        "frequency": 0.3,
        "bodySystem": "ophthalmological",
        "notes": "Compression from pituitary tumors"
      },
      {
        "symptomName": "Nausea and vomiting",
        "frequency": 0.25,
        "bodySystem": "gastrointestinal",
        "notes": "Related to gastrinomas or hypercalcemia"
      },
      {
        "symptomName": "Constipation",
        "frequency": 0.2,
        "bodySystem": "gastrointestinal",
        "notes": "Secondary to hypercalcemia"
      }
    ],
    "rare": [
      {
        "symptomName": "Carcinoid syndrome",
        "frequency": 0.08,
        "bodySystem": "endocrine",
        "notes": "Rarely associated with MEN1"
      },
      {
        "symptomName": "Cutaneous angiofibromas",
        "frequency": 0.07,
        "bodySystem": "dermatological",
        "notes": "May be present in some patients"
      },
      {
        "symptomName": "Lipomas",
        "frequency": 0.05,
        "bodySystem": "dermatological",
        "notes": "Benign fatty tumors occasionally observed"
      },
      {
        "symptomName": "Adrenal adenomas",
        "frequency": 0.04,
        "bodySystem": "endocrine",
        "notes": "Nonfunctional or rarely functional"
      }
    ]
  },
