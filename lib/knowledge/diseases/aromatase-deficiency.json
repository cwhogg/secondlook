  "diagnosticCriteria": {
    "formalCriteriaName": "No formal standardized criteria; diagnosis based on clinical, biochemical, and genetic findings",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of ambiguous genitalia or virilization in 46,XX individuals and undervirilization in 46,XY individuals",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-profile",
        "description": "Elevated serum testosterone with low or undetectable estradiol levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the CYP19A1 gene encoding aromatase",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-maturation-delay",
        "description": "Delayed bone age and osteoporosis on imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical features plus biochemical abnormalities and confirmation by genetic testing",
    "notes": "Diagnosis requires integration of clinical, hormonal, and molecular data."
  },
