  "diagnosticCriteria": {
    "formalCriteriaName": "American College of Rheumatology (ACR) 1990 Criteria for EGPA",
    "criteria": [
      {
        "id": "asthma",
        "description": "History of asthma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eosinophilia",
        "description": "Peripheral blood eosinophilia >10%",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-infiltrates",
        "description": "Transient pulmonary infiltrates on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuropathy",
        "description": "Mononeuropathy or polyneuropathy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "histology",
        "description": "Biopsy showing eosinophilic infiltration and vasculitis",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of 4 or more criteria including asthma, eosinophilia, pulmonary infiltrates, and histologic evidence of vasculitis",
    "notes": "Diagnosis requires exclusion of other vasculitides and eosinophilic disorders."
  },
