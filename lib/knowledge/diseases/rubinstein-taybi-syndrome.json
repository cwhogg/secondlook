  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific biomarkers",
      "Possible mild anemia or thrombocytopenia in some cases"
    ],
    "imaging": [
      "Skeletal X-rays showing broad thumbs and halluces",
      "Brain MRI may show nonspecific findings or structural abnormalities",
      "Echocardiography to detect congenital heart defects"
    ],
    "genetic": [
      "Pathogenic variants in CREBBP gene (~50-60% cases)",
      "Pathogenic variants in EP300 gene (~5-10% cases)",
      "De novo mutations are common"
    ],
    "other": [
      "Developmental assessments confirming intellectual disability",
      "Clinical dysmorphology evaluation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cornelia-de-lange-syndrome",
      "distinguishingFeatures": [
        "Distinctive synophrys and limb abnormalities different from broad thumbs",
        "More severe growth retardation",
        "Different facial features such as arched eyebrows"
      ]
    },
    {
      "diseaseId": "floating-harbor-syndrome",
      "distinguishingFeatures": [
        "Triangular face with deep-set eyes",
        "Delayed bone age",
        "Speech delay more prominent than intellectual disability"
      ]
    }
  ],
  "redFlags": [
    "Severe congenital heart defects requiring urgent intervention",
    "Progressive respiratory compromise due to recurrent infections",
    "Seizures or neurological deterioration"
  ],
