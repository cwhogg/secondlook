  "keyFindings": {
    "laboratory": [
      "Elevated serum electrolyte abnormalities due to dehydration",
      "Secondary bacterial cultures from skin fissures"
    ],
    "imaging": [
      "Chest X-ray may show restricted lung expansion"
    ],
    "genetic": [
      "Pathogenic mutations in ABCA12 gene detected by molecular genetic testing"
    ],
    "other": [
      "Histopathology shows thickened stratum corneum with lipid abnormalities"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "lamellar-ichthyosis",
      "distinguishingFeatures": [
        "Less severe scaling without thick plate-like armor",
        "Onset typically after neonatal period",
        "No ectropion or eclabium"
      ]
    },
    {
      "diseaseId": "congenital-ichthyosiform-erythroderma",
      "distinguishingFeatures": [
        "Generalized erythema with fine scaling",
        "Less severe skin thickening",
        "Absence of severe fissuring and ectropion"
      ]
    }
  ],
  "redFlags": [
    "Respiratory distress due to restricted chest wall movement",
    "Severe dehydration and electrolyte imbalance",
    "Neonatal sepsis secondary to skin barrier breakdown"
  ],
