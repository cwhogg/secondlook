  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Hereditary Hypophosphatemic Rickets with Normocalciuria",
    "criteria": [
      {
        "id": "hypophosphatemia",
        "description": "Persistent hypophosphatemia due to renal phosphate wasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normocalciuria",
        "description": "Normal urinary calcium excretion (normocalciuria)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rickets-clinical-radiologic",
        "description": "Clinical and radiologic evidence of rickets or osteomalacia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in SLC34A3 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent hypophosphatemia with renal phosphate wasting, normocalciuria, and clinical/radiologic evidence of rickets",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory"
  },
