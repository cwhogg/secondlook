  "diagnosticCriteria": {
    "formalCriteriaName": "Fryns Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "diaphragmatic-hernia",
        "description": "Congenital diaphragmatic hernia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distal-digital-hypoplasia",
        "description": "Hypoplasia or absence of distal phalanges and nails",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic facial features including coarse face, broad flat nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-hypoplasia",
        "description": "Pulmonary hypoplasia or agenesis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-malformations",
        "description": "Congenital heart defects such as ventricular septal defect",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital diaphragmatic hernia plus at least two major criteria including distal digital hypoplasia and characteristic craniofacial dysmorphism",
    "notes": "Diagnosis is clinical; genetic testing may be inconclusive as causative gene(s) are not definitively identified."
  },
