  "keyFindings": {
    "laboratory": [
      "Routine metabolic and genetic testing usually normal",
      "Exclusion of metabolic disorders such as mitochondrial diseases"
    ],
    "imaging": [
      "Brain MRI typically normal or nonspecific cerebral atrophy",
      "EEG may show nonspecific abnormalities or epileptiform activity"
    ],
    "genetic": [
      "No consistent genetic mutation identified; some cases may have rare genetic variants"
    ],
    "other": [
      "Developmental regression documented by clinical history and standardized developmental assessments"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autism-spectrum-disorder",
      "distinguishingFeatures": [
        "Earlier onset before 2 years",
        "No prior normal development phase",
        "Less dramatic loss of previously acquired skills"
      ]
    },
    {
      "diseaseId": "rett-syndrome",
      "distinguishingFeatures": [
        "Primarily affects females",
        "Characteristic hand-wringing stereotypies",
        "MECP2 gene mutation"
      ]
    },
    {
      "diseaseId": "childhood-onset-neurodegenerative-disorders",
      "distinguishingFeatures": [
        "Progressive neurological deterioration",
        "Abnormal neuroimaging findings",
        "Presence of metabolic or genetic markers"
      ]
    }
  ],
  "redFlags": [
