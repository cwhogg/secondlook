  "diagnosticCriteria": {
    "formalCriteriaName": "Factor X Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "prolonged-pt-apt",
        "description": "Prolonged prothrombin time (PT) and activated partial thromboplastin time (aPTT) not corrected by mixing studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "factor-x-activity",
        "description": "Reduced Factor X activity level below 10-15% of normal",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-bleeding-history",
        "description": "History of bleeding symptoms consistent with coagulation disorder",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the F10 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of prolonged PT/aPTT with reduced Factor X activity and clinical bleeding history",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory."
  },
