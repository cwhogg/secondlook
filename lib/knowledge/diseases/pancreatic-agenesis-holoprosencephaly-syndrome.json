      "Brain MRI showing holoprosencephaly spectrum abnormalities",
      "Abdominal ultrasound or MRI demonstrating absent pancreatic tissue"
    ],
    "genetic": [
      "CNOT1 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology confirming absence of pancreatic tissue",
      "Clinical observation of craniofacial midline defects"
    ]
  },
