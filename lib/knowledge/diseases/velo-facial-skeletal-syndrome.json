  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for 22q11.2 Deletion Syndrome",
    "criteria": [
      {
        "id": "palatal-abnormalities",
        "description": "Presence of velopharyngeal insufficiency or cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including long face, prominent nose, and small chin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-defects",
        "description": "Congenital heart defects, especially conotruncal anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal anomalies such as scoliosis or vertebral anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypocalcemia",
        "description": "Hypocalcemia due to hypoparathyroidism",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least two major criteria including palatal abnormalities, characteristic facial dysmorphism, and/or congenital heart defects, supported by genetic testing",
    "notes": "Genetic confirmation via detection of 22q11.2 deletion is definitive"
  },
