  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Megalocornea-Intellectual Disability Syndrome",
    "criteria": [
      {
        "id": "megalocornea",
        "description": "Bilateral enlargement of the cornea with horizontal diameter >13 mm",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability confirmed by standardized testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including broad nasal bridge and prominent forehead",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Generalized hypotonia observed in infancy or early childhood",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral megalocornea and intellectual disability with at least one additional minor or supportive criterion",
    "notes": "Diagnosis is clinical; genetic testing may assist but no specific gene identified."
  },
