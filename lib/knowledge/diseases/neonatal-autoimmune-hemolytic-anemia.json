  "diagnosticCriteria": {
    "formalCriteriaName": "Neonatal Autoimmune Hemolytic Anemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "positive-direct-antiglobulin-test",
        "description": "Positive direct antiglobulin (Coombs) test indicating antibody or complement coating of red blood cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "evidence-hemolysis",
        "description": "Laboratory evidence of hemolysis including elevated reticulocyte count, elevated lactate dehydrogenase (LDH), and decreased haptoglobin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anemia-newborn",
        "description": "Anemia presenting within the neonatal period not explained by other causes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of neonatal hemolytic anemia such as hemoglobinopathies, infections, or alloimmune hemolytic disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of anemia in the neonatal period with positive direct antiglobulin test and laboratory evidence of hemolysis, excluding other causes",
    "notes": "Diagnosis requires careful exclusion of alloimmune hemolytic disease and hemoglobinopathies."
  },
