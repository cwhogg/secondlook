  "diagnosticCriteria": {
    "formalCriteriaName": "Revised Ghent Criteria (for Marfan-related aortopathy)",
    "criteria": [
      {
        "id": "aortic-root-dilation",
        "description": "Aortic root dilation or aneurysm (Z-score ≥2) on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of thoracic aortic aneurysm or dissection",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "fibrillin-1-mutation",
        "description": "Pathogenic mutation in FBN1 or other related genes (e.g., TGFBR1, TGFBR2, SMAD3)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "systemic-features",
        "description": "Presence of systemic features such as skeletal or ocular abnormalities consistent with connective tissue disorder",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of aortic root dilation plus either a pathogenic mutation or family history",
    "notes": "Diagnostic criteria vary depending on specific syndrome (e.g., Marfan, Loeys-Dietz, Ehlers-Danlos). Genetic testing is critical."
  },
