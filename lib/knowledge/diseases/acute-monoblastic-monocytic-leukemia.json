  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Tumors of Hematopoietic and Lymphoid Tissues",
    "criteria": [
      {
        "id": "blast-percentage",
        "description": "Presence of ≥20% monoblasts and promonocytes in bone marrow or peripheral blood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "monocytic-differentiation",
        "description": "Immunophenotyping showing monocytic lineage markers (e.g., CD14, CD64, CD11b)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cytogenetic-abnormalities",
        "description": "Detection of characteristic cytogenetic abnormalities such as t(9;11)(p22;q23)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "≥20% monoblasts/promonocytes in marrow or blood with monocytic immunophenotype",
    "notes": "Diagnosis requires exclusion of other AML subtypes and confirmation by morphology and immunophenotyping."
  },
