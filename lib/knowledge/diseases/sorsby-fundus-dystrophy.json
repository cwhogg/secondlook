  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Sorsby Fundus Dystrophy",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in the TIMP3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of night blindness and progressive central vision loss in mid-adulthood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fundus-findings",
        "description": "Characteristic macular changes including yellowish subretinal deposits and choroidal neovascularization",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features and fundus findings plus genetic confirmation of TIMP3 mutation",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical presentation may overlap with other macular dystrophies."
  },
