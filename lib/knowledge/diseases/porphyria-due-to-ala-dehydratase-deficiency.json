  "keyFindings": {
    "laboratory": [
      "Markedly elevated urinary delta-aminolevulinic acid (ALA)",
      "Reduced erythrocyte ALA dehydratase enzyme activity",
      "Normal or mildly elevated porphobilinogen (PBG) levels"
    ],
    "imaging": [
      "Neuroimaging may show nonspecific findings during acute attacks",
      "Electromyography (EMG) indicating axonal neuropathy"
    ],
    "genetic": [
      "ALAD (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Negative urine porphobilinogen test differentiates from other acute porphyrias"
    ]
  },
