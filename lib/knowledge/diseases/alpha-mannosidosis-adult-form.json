  "diagnosticCriteria": {
    "formalCriteriaName": "Alpha-mannosidosis diagnostic criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of deficient alpha-mannosidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the MAN2B1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of progressive intellectual disability, hearing impairment, and skeletal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-oligosaccharides",
        "description": "Detection of elevated mannose-rich oligosaccharides in urine",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient alpha-mannosidase enzyme activity plus either pathogenic MAN2B1 variants or characteristic clinical features",
    "notes": "Diagnosis is confirmed by enzymatic assay and genetic testing; clinical features support diagnosis."
  },
