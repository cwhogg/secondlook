  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for RNU12-Related Congenital Cerebellar Ataxia",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Presence of congenital or early-onset cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic biallelic mutations in the RNU12 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging-findings",
        "description": "MRI evidence of cerebellar hypoplasia or atrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-ataxias",
        "description": "Exclusion of other known genetic or acquired causes of cerebellar ataxia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital cerebellar ataxia with confirmatory biallelic RNU12 mutation and supportive neuroimaging findings",
    "notes": "Diagnosis relies heavily on genetic confirmation due to phenotypic overlap with other congenital ataxias."
  },
