  "keyFindings": {
    "laboratory": [
      "Low complement levels (C3, C4, CH50)",
      "Presence of anti-C1q antibodies",
      "Elevated inflammatory markers (ESR, CRP)",
      "Proteinuria and hematuria in renal involvement"
    ],
    "imaging": [
      "Chest X-ray or CT showing pleural effusions or interstitial lung disease",
      "Renal ultrasound if indicated"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy demonstrating leukocytoclastic vasculitis with fibrinoid necrosis",
      "Direct immunofluorescence showing immune complex deposition"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "chronic-urticaria",
      "distinguishingFeatures": [
        "Urticarial lesions resolve within 24 hours",
        "No vasculitis on skin biopsy",
        "Normal complement levels"
      ]
    },
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "Positive ANA and other lupus serologies",
        "Multisystem involvement with characteristic clinical features",
        "Different skin lesion morphology"
      ]
    },
    {
      "diseaseId": "hypersensitivity-vasculitis",
      "distinguishingFeatures": [
        "Often related to drug or infection exposure",
        "Skin lesions may be palpable purpura rather than urticarial",
        "Complement levels usually normal"
      ]
    }
  ],
  "redFlags": [
    "Persistent urticarial lesions lasting more than 24 hours",
    "Evidence of systemic involvement (renal, pulmonary, ocular)",
    "Hypocomplementemia indicating immune complex disease"
  ],
