  "diagnosticCriteria": {
    "formalCriteriaName": "Amsterdam Criteria II (modified for FCC Type X)",
    "criteria": [
      {
        "id": "family-history",
        "description": "Presence of at least three relatives with colorectal cancer, one of whom is a first-degree relative of the other two",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-onset",
        "description": "At least two successive generations affected by colorectal cancer",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mismatch-repair-protein-expression",
        "description": "Absence of mismatch repair gene mutations and normal immunohistochemistry for MMR proteins",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-lynch-syndrome",
        "description": "Exclusion of Lynch syndrome by genetic testing and tumor studies",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "All major criteria must be met including family history, generational involvement, absence of MMR mutations, and exclusion of Lynch syndrome",
    "notes": "Diagnosis is clinical and based on family history and molecular exclusion of Lynch syndrome"
  },
