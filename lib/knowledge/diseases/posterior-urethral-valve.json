  "diagnosticCriteria": {
    "formalCriteriaName": "Posterior Urethral Valve Diagnostic Criteria",
    "criteria": [
      {
        "id": "valve-visualization",
        "description": "Endoscopic visualization of obstructing posterior urethral leaflets",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "voiding-cystourethrogram",
        "description": "Radiologic evidence of dilated posterior urethra with valve leaflets on voiding cystourethrogram (VCUG)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "prenatal-ultrasound",
        "description": "Prenatal ultrasound showing bilateral hydronephrosis and thickened bladder wall",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Endoscopic visualization of valves or characteristic VCUG findings demonstrating posterior urethral obstruction",
    "notes": "Prenatal ultrasound findings support diagnosis but are not definitive without confirmatory imaging or endoscopy."
  },
