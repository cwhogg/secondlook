  "diagnosticCriteria": {
    "formalCriteriaName": "Lipoprotein Glomerulopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "lipoprotein-thrombi",
        "description": "Presence of lipoprotein thrombi in glomerular capillaries on renal biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nephrotic-syndrome",
        "description": "Clinical presentation with nephrotic syndrome including proteinuria and edema",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "apoE-mutation",
        "description": "Detection of pathogenic mutations in the apolipoprotein E (APOE) gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "lipid-profile",
        "description": "Abnormal lipid profile with elevated plasma lipoproteins",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of lipoprotein thrombi in glomerular capillaries plus clinical nephrotic syndrome",
    "notes": "Genetic testing for APOE mutations supports diagnosis but is not mandatory"
  },
