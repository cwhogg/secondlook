  "diagnosticCriteria": {
    "formalCriteriaName": "Sialidosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of neuraminidase enzyme activity in cultured fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of coarse facial features, developmental delay, and cherry-red macular spots",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the NEU1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-oligosaccharides",
        "description": "Elevated urinary sialylated oligosaccharides",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of neuraminidase enzyme activity plus either characteristic clinical features or pathogenic NEU1 mutations",
    "notes": "Diagnosis is confirmed by enzymatic assay and/or molecular genetic testing."
  },
