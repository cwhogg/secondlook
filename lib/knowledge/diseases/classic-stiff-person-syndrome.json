  "diagnosticCriteria": {
    "formalCriteriaName": "Dalakas Criteria for Stiff Person Syndrome",
    "criteria": [
      {
        "id": "muscle-stiffness",
        "description": "Progressive axial and limb muscle stiffness with episodic spasms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anti-gad65-antibodies",
        "description": "Presence of elevated anti-glutamic acid decarboxylase (GAD65) antibodies in serum or CSF",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Continuous motor unit activity on electromyography (EMG) in stiff muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-disorders",
        "description": "Exclusion of other neurological or neuromuscular disorders causing stiffness",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive muscle stiffness and spasms plus either positive anti-GAD65 antibodies or characteristic EMG findings",
    "notes": "Diagnosis is clinical supported by serology and electrophysiology; response to benzodiazepines is supportive."
  },
