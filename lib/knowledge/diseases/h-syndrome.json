  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria",
    "criteria": [
      {
        "id": "cutaneous-hyperpigmentation",
        "description": "Symmetrical hyperpigmented indurated patches with hypertrichosis predominantly on lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "systemic-involvement",
        "description": "Presence of systemic manifestations such as hepatosplenomegaly, lymphadenopathy, or cardiac anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "SLC29A3-mutation",
        "description": "Identification of biallelic pathogenic variants in the SLC29A3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing dermal infiltration by histiocytes with fibrosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic cutaneous lesions plus systemic involvement and confirmation of SLC29A3 mutation",
    "notes": "Diagnosis is primarily clinical supported by genetic testing and histopathology"
  },
