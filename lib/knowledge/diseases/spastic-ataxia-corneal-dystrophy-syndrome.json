  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Spastic Ataxia-Corneal Dystrophy Syndrome",
    "criteria": [
      {
        "id": "spasticity",
        "description": "Presence of progressive lower limb spasticity with hyperreflexia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-ataxia",
        "description": "Manifestation of cerebellar ataxia including gait instability and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "corneal-dystrophy",
        "description": "Bilateral corneal stromal opacities consistent with corneal dystrophy on ophthalmological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in associated gene(s) if known",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electrophysiology",
        "description": "Electromyography or nerve conduction studies showing no peripheral neuropathy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (progressive spasticity, cerebellar ataxia, and corneal dystrophy) with exclusion of other causes",
    "notes": "Genetic testing may support diagnosis but is not mandatory; diagnosis primarily clinical."
  },
