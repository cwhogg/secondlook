  "keyFindings": {
    "laboratory": [
      "Hypogammaglobulinemia with low IgG, IgA, and/or IgM",
      "Lymphopenia",
      "Autoimmune hemolytic anemia in some cases"
    ],
    "imaging": [
      "Chest X-ray showing recurrent pneumonia or bronchiectasis",
      "Brain MRI may show nonspecific findings related to developmental delay"
    ],
    "genetic": [
      "DNMT3B (causative)",
      "ZBTB24 (causative)",
      "CDCA7 (causative)",
      "HELLS (causative)",
      "UHRF1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Characteristic facial dysmorphisms",
      "Recurrent severe infections"
    ]
  },
  "differentialDiagnoses": [
