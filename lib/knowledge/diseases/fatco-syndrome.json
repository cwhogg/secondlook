  "diagnosticCriteria": {
    "formalCriteriaName": "FATCO Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "fibular-aplasia",
        "description": "Congenital absence or aplasia of the fibula",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tibial-campomelia",
        "description": "Congenital bowing or angulation (campomelia) of the tibia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oligosyndactyly",
        "description": "Presence of oligodactyly and/or syndactyly affecting the hands or feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-length-discrepancy",
        "description": "Significant limb length discrepancy involving lower limbs",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-cognitive-development",
        "description": "Normal intellectual and cognitive development",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: fibular aplasia, tibial campomelia, and oligosyndactyly",
    "notes": "Diagnosis is primarily clinical supported by radiographic imaging; genetic testing may be inconclusive."
  },
