  "keyFindings": {
    "laboratory": [
      "Presence of anti-PL-12 antibodies by ELISA or immunoprecipitation",
      "Elevated creatine kinase (mild elevation)",
      "Elevated inflammatory markers (ESR, CRP)"
    ],
    "imaging": [
      "High-resolution CT showing ground-glass opacities and reticulation consistent with interstitial lung disease",
      "Pulmonary function tests showing restrictive pattern and reduced diffusion capacity"
    ],
    "genetic": [],
    "other": [
      "Muscle biopsy may show mild inflammatory myopathy",
      "Electromyography consistent with myositis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "anti-pl-7-antisynthetase-syndrome",
      "distinguishingFeatures": [
        "Presence of anti-PL-7 antibodies instead of anti-PL-12",
        "More prominent myositis than lung disease"
      ]
    },
    {
      "diseaseId": "idiopathic-inflammatory-myopathy",
      "distinguishingFeatures": [
        "Absence of antisynthetase antibodies",
        "More severe muscle involvement",
        "Less frequent lung involvement"
      ]
    },
    {
      "diseaseId": "systemic-sclerosis",
      "distinguishingFeatures": [
        "Presence of sclerodactyly and skin thickening",
        "Different autoantibody profile (e.g., anti-Scl-70)",
        "More prominent vascular manifestations"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive interstitial lung disease",
    "Severe hypoxemia or respiratory failure",
    "Marked muscle weakness with dysphagia or respiratory muscle involvement"
  ],
