  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Hypotrichosis with Juvenile Macular Degeneration",
    "criteria": [
      {
        "id": "hypotrichosis",
        "description": "Congenital or early-onset sparse scalp hair (hypotrichosis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "juvenile-macular-degeneration",
        "description": "Progressive juvenile-onset macular degeneration with central vision loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic mutations in the CDH3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroretinography",
        "description": "Electroretinography showing reduced macular function",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypotrichosis and juvenile macular degeneration with confirmation of pathogenic CDH3 mutations",
    "notes": "Diagnosis is confirmed by genetic testing; clinical features may overlap with other ectodermal dysplasias."
  },
