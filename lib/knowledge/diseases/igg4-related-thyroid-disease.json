  "differentialDiagnoses": [
    {
      "diseaseId": "hashimotos-thyroiditis",
      "distinguishingFeatures": [
        "Lacks significant IgG4-positive plasma cell infiltration",
        "Usually female predominance",
        "Less fibrosis and no storiform pattern"
      ]
    },
    {
      "diseaseId": "riedels-thyroiditis",
      "distinguishingFeatures": [
        "Extensive fibrosis causing 'woody' hard thyroid",
        "Often negative for IgG4 elevation",
        "More aggressive local invasion"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive thyroid enlargement",
