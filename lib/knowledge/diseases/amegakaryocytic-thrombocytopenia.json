        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of thrombocytopenia including immune thrombocytopenic purpura and bone marrow failure syndromes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in the MPL gene or other associated genes (supportive)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe thrombocytopenia with absent or markedly reduced megakaryocytes on bone marrow biopsy and exclusion of other causes",
    "notes": "Genetic testing can support diagnosis but is not mandatory"
  },
