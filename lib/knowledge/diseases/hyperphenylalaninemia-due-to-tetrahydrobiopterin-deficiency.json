  "diagnosticCriteria": {
    "formalCriteriaName": "Biopterin Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-phenylalanine",
        "description": "Elevated blood phenylalanine levels detected on newborn screening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-bh4-levels",
        "description": "Reduced tetrahydrobiopterin (BH4) concentration in cerebrospinal fluid or blood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dihydropteridine-reductase-activity",
        "description": "Decreased dihydropteridine reductase enzyme activity in blood or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes involved in BH4 synthesis or recycling (e.g., PTS, QDPR, GCH1)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-neurological-features",
        "description": "Presence of neurological symptoms consistent with BH4 deficiency such as developmental delay or movement disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated phenylalanine with reduced BH4 levels and decreased dihydropteridine reductase activity",
    "notes": "Newborn screening programs often detect elevated phenylalanine prompting further BH4-specific testing."
  },
