  "diagnosticCriteria": {
    "formalCriteriaName": "Van der Burgt Scoring System for Noonan Syndrome",
    "criteria": [
      {
        "id": "ns-c1",
        "description": "Typical facial features (hypertelorism, down-slanting palpebral fissures, ptosis, low-set posteriorly rotated ears)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ns-c2",
        "description": "Congenital heart defect (especially pulmonary valve stenosis, hypertrophic cardiomyopathy)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ns-c3",
        "description": "Short stature (<3rd percentile)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ns-c4",
        "description": "Broad or webbed neck",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ns-c5",
        "description": "Pectus deformity (carinatum superiorly, excavatum inferiorly)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ns-c6",
        "description": "Cryptorchidism in males",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ns-c7",
        "description": "Bleeding diathesis or lymphatic abnormality",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ns-c8",
        "description": "Pathogenic variant in a RASopathy gene (PTPN11, SOS1, RAF1, KRAS, RIT1, etc.)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Typical facial features plus one other major criterion; or suggestive facial features plus two other major criteria. Genetic confirmation increasingly used.",
    "notes": "Noonan syndrome is the most common RASopathy. PTPN11 mutations account for ~50% of cases. Phenotype overlaps with other RASopathies (CFC syndrome, Costello syndrome, Noonan syndrome with multiple lentigines)."
  },
