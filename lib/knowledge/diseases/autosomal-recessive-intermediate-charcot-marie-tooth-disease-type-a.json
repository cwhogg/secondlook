  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Charcot-Marie-Tooth Disease",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of progressive distal muscle weakness and atrophy predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiological-findings",
        "description": "Nerve conduction studies showing intermediate slowing of motor nerve conduction velocities (25-45 m/s)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the relevant CMT-associated gene (e.g., GDAP1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consistent autosomal recessive inheritance pattern or consanguinity",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-sensory-loss",
        "description": "Presence of distal sensory loss and diminished deep tendon reflexes",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal muscle weakness and atrophy with intermediate nerve conduction velocities plus genetic confirmation of biallelic pathogenic variants",
    "notes": "Electrophysiological and genetic testing are essential to differentiate from other CMT subtypes."
  },
