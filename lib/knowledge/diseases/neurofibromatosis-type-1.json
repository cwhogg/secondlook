  "diagnosticCriteria": {
    "formalCriteriaName": "NIH Revised Diagnostic Criteria for NF1 (2021 Update)",
    "criteria": [
      {
        "id": "nf1-c1",
        "description": ">= 6 cafe-au-lait macules (>5 mm in prepubertal, >15 mm in postpubertal individuals)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "nf1-c2",
        "description": ">= 2 neurofibromas of any type OR 1 plexiform neurofibroma",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "nf1-c3",
        "description": "Freckling in axillary or inguinal region (Crowe sign)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "nf1-c4",
        "description": "Optic pathway glioma",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "nf1-c5",
        "description": ">= 2 Lisch nodules (iris hamartomas) or >= 2 choroidal abnormalities",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "nf1-c6",
        "description": "A distinctive osseous lesion (sphenoid dysplasia, anterolateral tibial bowing, long bone pseudarthrosis)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "nf1-c7",
        "description": "A heterozygous pathogenic NF1 variant with variant allele fraction >= 50% in apparently normal tissue",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "nf1-c8",
        "description": "A parent meeting the above NF1 diagnostic criteria (in the presence of one of the above criteria in the child)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Two or more of the above criteria (without a parent with NF1), OR one of the above criteria plus a first-degree relative with NF1",
    "notes": "NF1 is one of the most common autosomal dominant genetic disorders. ~50% are de novo mutations. Complete penetrance by age 8 years. Expression is highly variable, even within families."
  },
