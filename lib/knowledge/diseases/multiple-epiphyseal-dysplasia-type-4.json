  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Multiple Epiphyseal Dysplasia",
    "criteria": [
      {
        "id": "epiphyseal-abnormalities",
        "description": "Radiographic evidence of delayed and irregular ossification of multiple epiphyses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-pain-stiffness",
        "description": "Early-onset joint pain and stiffness predominantly affecting large joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the SLC26A2 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "short-stature",
        "description": "Mild to moderate short stature relative to family norms",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of radiographic epiphyseal abnormalities plus clinical symptoms of joint pain/stiffness; genetic confirmation supports diagnosis",
    "notes": "Genetic testing for SLC26A2 mutations is confirmatory but not always available."
  },
