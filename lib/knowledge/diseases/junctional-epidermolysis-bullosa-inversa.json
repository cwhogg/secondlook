  "diagnosticCriteria": {
    "formalCriteriaName": "Junctional Epidermolysis Bullosa Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of blistering and erosions predominantly in intertriginous and flexural areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Immunofluorescence showing reduced or absent expression of laminin-332 or other basement membrane zone proteins",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in genes encoding laminin-332 subunits (LAMA3, LAMB3, or LAMC2)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Subepidermal blister formation with cleavage within the lamina lucida on skin biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus either immunofluorescence mapping abnormalities or pathogenic mutations in laminin-332 genes",
    "notes": "Diagnosis requires integration of clinical, immunopathological, and genetic findings."
  },
