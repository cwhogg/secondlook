  "diagnosticCriteria": {
    "formalCriteriaName": "Mercury Poisoning Diagnostic Criteria",
    "criteria": [
      {
        "id": "history-exposure",
        "description": "Documented history of mercury exposure or contact with mercury-containing compounds",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-mercury-levels",
        "description": "Elevated mercury concentration in blood, urine, or hair samples above reference limits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-symptoms",
        "description": "Presence of characteristic neurological symptoms such as tremors, memory impairment, or sensory disturbances",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-dysfunction",
        "description": "Evidence of renal impairment or proteinuria associated with mercury exposure",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "dermatological-manifestations",
        "description": "Presence of acrodynia or other mercury-induced skin changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "History of mercury exposure plus elevated mercury levels in biological samples and at least one major clinical symptom",
    "notes": "Diagnosis is supported by exclusion of other causes and response to chelation therapy."
  },
