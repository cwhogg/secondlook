  "keyFindings": {
    "laboratory": [
      "Markedly reduced or absent plasma apolipoprotein B",
      "Presence of acanthocytes on peripheral blood smear",
      "Low plasma cholesterol and triglyceride levels",
      "Fatty stools with increased fecal fat content",
      "Vitamin E deficiency"
    ],
    "imaging": [
      "MRI showing cerebellar atrophy",
      "Retinal imaging consistent with retinitis pigmentosa"
    ],
    "genetic": [
      "Biallelic mutations in the MTTP gene encoding microsomal triglyceride transfer protein"
    ],
    "other": [
      "Electrophysiological studies showing peripheral neuropathy",
      "Electroretinogram abnormalities"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "familial-hypobetalipoproteinemia",
      "distinguishingFeatures": [
        "Presence of apolipoprotein B but at reduced levels",
        "Usually milder clinical presentation",
        "Dominant inheritance pattern"
      ]
    },
    {
      "diseaseId": "hypobetalipoproteinemia",
      "distinguishingFeatures": [
        "Partial deficiency of apolipoprotein B",
        "Less severe neurological symptoms",
        "No acanthocytosis"
      ]
    },
    {
      "diseaseId": "vitamin-e-deficiency-neurological-syndrome",
      "distinguishingFeatures": [
        "Neurological symptoms due to isolated vitamin E deficiency",
        "No lipid abnormalities or acanthocytosis",
        "Secondary causes of vitamin E deficiency present"
      ]
    }
  ],
