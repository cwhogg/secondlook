  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for X-linked Mandibulofacial Dysostosis",
    "criteria": [
      {
        "id": "mandibular-hypoplasia",
        "description": "Bilateral mandibular hypoplasia with micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "malar-hypoplasia",
        "description": "Hypoplasia of the zygomatic arches (malar hypoplasia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ear-malformations",
        "description": "Characteristic external ear malformations including microtia and malformed pinnae",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cleft-palate",
        "description": "Presence of cleft palate or high-arched palate",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Conductive hearing loss due to middle ear anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (mandibular hypoplasia, malar hypoplasia, and ear malformations) with or without minor criteria",
    "notes": "Genetic testing for mutations in the TCOF1 gene may support diagnosis but is not always conclusive."
  },
