  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological and Genetic Diagnostic Criteria for ACD/MPV",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of misaligned pulmonary veins and decreased alveolar capillary density on lung biopsy or autopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants or deletions in the FOXF1 gene or its regulatory region",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Neonatal onset of severe, persistent pulmonary hypertension unresponsive to conventional therapies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-findings",
        "description": "Chest radiograph showing diffuse hazy opacities and decreased lung volumes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation or pathogenic FOXF1 variant plus clinical presentation of neonatal persistent pulmonary hypertension",
    "notes": "Definitive diagnosis requires lung histology or genetic confirmation; clinical suspicion is critical due to rapid progression."
  },
