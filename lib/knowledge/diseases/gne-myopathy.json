  "keyFindings": {
    "laboratory": [
      "Normal or mildly elevated serum creatine kinase (CK) levels"
    ],
    "imaging": [
      "Muscle MRI showing selective involvement and fatty replacement of anterior tibialis and other distal muscles"
    ],
    "genetic": [
      "Biallelic pathogenic mutations in the GNE gene"
    ],
    "other": [
      "Muscle biopsy demonstrating rimmed vacuoles, fiber atrophy, and inclusion bodies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "inclusion-body-myositis",
      "distinguishingFeatures": [
        "Older age of onset (usually >50 years)",
        "Presence of inflammatory infiltrates on biopsy",
        "Proximal and distal muscle involvement",
        "Elevated CK levels"
      ]
    },
    {
      "diseaseId": "distal-limb-girdle-muscular-dystrophy",
      "distinguishingFeatures": [
        "Genetic mutations in other genes (e.g. dysferlin, calpain)",
        "Absence of rimmed vacuoles on biopsy",
        "More prominent proximal weakness"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive muscle weakness",
    "Sensory loss or neuropathy",
    "Severe respiratory compromise"
  ],
