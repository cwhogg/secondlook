  "keyFindings": {
    "laboratory": [
      "Markedly decreased or absent CD19+ B cells in peripheral blood",
      "Severe hypogammaglobulinemia (low IgG, IgA, IgM)",
      "Normal or elevated T cell counts"
    ],
    "imaging": [
      "Chest X-ray or CT showing recurrent pneumonia or bronchiectasis",
      "Sinus imaging showing chronic sinusitis"
    ],
    "genetic": [
      "Pathogenic mutation in the BTK gene on X chromosome"
    ],
    "other": [
      "Family history consistent with X-linked inheritance",
      "Poor response to vaccines requiring antibody production"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "common-variable-immunodeficiency",
      "distinguishingFeatures": [
        "Onset typically later in childhood or adulthood",
        "Presence of B cells in peripheral blood",
        "More variable immunoglobulin levels"
      ]
    },
    {
      "diseaseId": "severe-combined-immunodeficiency",
      "distinguishingFeatures": [
        "Both B and T cell deficiencies",
        "More severe infections in infancy",
        "Failure to thrive and chronic diarrhea"
      ]
    }
  ],
  "redFlags": [
    "Recurrent severe bacterial infections starting in infancy",
    "Absence of tonsils and lymph nodes on physical exam",
    "Family history of male relatives with immunodeficiency"
  ],
