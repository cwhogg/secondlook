  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 40,
      "peak": 20
    },
    "sexPredilection": "equal",
    "ethnicAssociations": [
      "Mediterranean",
      "Middle Eastern",
      "Japanese"
    ]
