  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and biochemical diagnostic criteria for gyrate atrophy",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Progressive chorioretinal atrophy with characteristic scalloped peripheral lesions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyperornithinemia",
        "description": "Elevated plasma ornithine levels (>400 µmol/L) confirmed by biochemical assay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the OAT gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "electroretinography",
        "description": "Reduced or extinguished rod and cone responses on electroretinogram",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic chorioretinal atrophy and elevated plasma ornithine levels",
    "notes": "Genetic testing supports diagnosis but is not mandatory if clinical and biochemical criteria are met."
  },
