  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Yellow Fever Case Definition",
    "criteria": [
      {
        "id": "fever",
        "description": "Acute onset of high fever",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "jaundice",
        "description": "Development of jaundice within 7 days of symptom onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemorrhagic-symptoms",
        "description": "Presence of hemorrhagic manifestations such as bleeding gums or hematemesis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "laboratory-confirmation",
        "description": "Detection of yellow fever virus RNA by PCR or seroconversion of IgM antibodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epidemiological-link",
        "description": "History of travel to or residence in endemic areas",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Acute high fever plus jaundice within 7 days and laboratory confirmation of yellow fever virus infection",
    "notes": "Diagnosis is supported by epidemiological context and clinical presentation; laboratory confirmation is essential for definitive diagnosis."
  },
