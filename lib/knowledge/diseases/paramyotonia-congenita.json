  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Serum creatine kinase may be mildly elevated during episodes"
    ],
    "imaging": [
      "Typically normal muscle MRI; may show mild edema during episodes"
    ],
    "genetic": [
      "Mutations in SCN4A gene encoding voltage-gated sodium channel Nav1.4"
    ],
    "other": [
      "Electromyography showing myotonic discharges with paradoxical myotonia pattern"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "myotonia-congenita",
      "distinguishingFeatures": [
        "Myotonia improves with repeated activity (warm-up phenomenon)",
        "No worsening with cold exposure",
        "Mutations in CLCN1 gene"
      ]
    },
    {
      "diseaseId": "hyperkalemic-periodic-paralysis",
      "distinguishingFeatures": [
        "Episodes of muscle weakness with elevated serum potassium",
        "Myotonia less prominent or absent",
        "SCN4A mutations but different phenotype"
      ]
    },
    {
      "diseaseId": "hypokalemic-periodic-paralysis",
      "distinguishingFeatures": [
        "Episodes of muscle weakness with low serum potassium",
        "No myotonia",
        "Mutations in CACNA1S or SCN4A genes"
      ]
    }
  ],
  "redFlags": [
    "Progressive muscle weakness leading to respiratory compromise",
    "Severe episodic paralysis with respiratory involvement",
    "Cardiac arrhythmias or syncope"
  ],
