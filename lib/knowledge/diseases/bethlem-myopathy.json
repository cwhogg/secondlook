  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate)",
      "Normal or mildly elevated aldolase"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle involvement with fatty infiltration",
      "X-rays showing joint contractures and scoliosis"
    ],
    "genetic": [
      "HBB (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy demonstrating collagen VI deficiency or abnormal collagen VI immunostaining"
    ]
  },
