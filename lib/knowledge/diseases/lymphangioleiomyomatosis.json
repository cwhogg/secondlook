  "keyFindings": {
    "laboratory": [
      "Elevated serum VEGF-D levels",
      "Mild hypoxemia on arterial blood gas"
    ],
    "imaging": [
      "High-resolution CT showing diffuse, thin-walled cystic lung lesions",
      "Chest X-ray may show hyperinflation or pneumothorax",
      "Abdominal CT or MRI showing lymphangioleiomyomas or renal angiomyolipomas"
    ],
    "genetic": [
      "PEPD (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology demonstrating proliferation of abnormal smooth muscle-like LAM cells",
      "Immunohistochemical staining positive for HMB-45"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pulmonary-langerhans-cell-histiocytosis",
      "distinguishingFeatures": [
        "Predominantly affects young smokers",
        "Nodular and cystic lesions on HRCT with upper lobe predominance",
        "Presence of Langerhans cells on biopsy"
      ]
    },
    {
      "diseaseId": "birt-hogg-dube-syndrome",
      "distinguishingFeatures": [
        "Multiple lung cysts with lower lobe predominance",
        "Associated skin fibrofolliculomas and renal tumors",
        "Family history of autosomal dominant inheritance"
      ]
    }
  ],
  "redFlags": [
    "Recurrent spontaneous pneumothorax",
    "Rapidly progressive dyspnea with hypoxemia",
    "Development of chylous pleural effusions"
  ],
