  "keyFindings": {
    "laboratory": [
      "Elevated serum IgG4 concentration (>135 mg/dL)",
      "Mildly elevated ESR and CRP",
      "Polyclonal hypergammaglobulinemia"
    ],
    "imaging": [
      "CT or MRI showing aortic wall thickening and periaortic soft tissue mass",
      "PET-CT demonstrating increased FDG uptake in affected aortic segments",
      "Ultrasound showing hypoechoic thickening of the aortic wall"
    ],
    "genetic": [
      "No specific genetic mutations identified; possible HLA associations reported"
    ],
    "other": [
      "Histopathology demonstrating dense lymphoplasmacytic infiltrate rich in IgG4-positive plasma cells, storiform fibrosis, and obliterative phlebitis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "takayasu-arteritis",
      "distinguishingFeatures": [
        "Younger age of onset (typically <40 years)",
        "Absence of elevated serum IgG4",
        "Granulomatous inflammation on histology"
      ]
    },
    {
      "diseaseId": "giant-cell-arteritis",
      "distinguishingFeatures": [
        "Predominantly affects temporal arteries",
        "Elevated ESR and CRP but normal IgG4 levels",
        "Presence of multinucleated giant cells on biopsy"
      ]
    },
    {
      "diseaseId": "infectious-aortitis",
      "distinguishingFeatures": [
        "Positive blood cultures or infectious source",
        "Rapid progression with systemic sepsis",
        "Histology showing neutrophilic infiltration"
      ]
    }
  ],
  "redFlags": [
    "Rapidly expanding aortic aneurysm",
    "Signs of aortic dissection (sudden severe chest or back pain)",
    "Neurological deficits indicating spinal cord ischemia"
  ],
