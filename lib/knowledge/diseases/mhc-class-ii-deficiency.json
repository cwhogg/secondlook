  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for MHC Class II Deficiency",
    "criteria": [
      {
        "id": "absent-mhc-class-ii-expression",
        "description": "Absent or markedly reduced expression of MHC class II molecules on antigen-presenting cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-cd4-t-cell-count",
        "description": "Profoundly decreased CD4+ T-cell numbers in peripheral blood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-opportunistic-infections",
        "description": "History of recurrent severe bacterial, viral, and fungal infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of mutations in genes regulating MHC class II expression (e.g., CIITA, RFXANK, RFX5, RFXAP)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "immunoglobulin-levels",
        "description": "Variable hypogammaglobulinemia or normal immunoglobulin levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of absent MHC class II expression on antigen-presenting cells plus decreased CD4+ T-cell count and clinical history of recurrent infections",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if clinical and immunological criteria are met."
  },
