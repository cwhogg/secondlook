        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in relevant genes (e.g., WNK1/HSN2)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-deep-tendon-reflexes",
        "description": "Reduced or absent deep tendon reflexes in affected limbs",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "motor-function-preserved",
        "description": "Preserved motor strength with predominant sensory involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal loss of pain and temperature sensation plus distal limb ulcerations, confirmed by genetic testing",
    "notes": "Diagnosis is supported by clinical presentation and confirmed by molecular genetic testing."
