        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic or likely pathogenic variants in ALPL gene consistent with mild phenotype",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of low serum alkaline phosphatase, prenatal radiologic findings consistent with hypophosphatasia, and elevated ALP substrates",
    "notes": "Diagnosis requires exclusion of severe perinatal lethal hypophosphatasia and other skeletal dysplasias"
