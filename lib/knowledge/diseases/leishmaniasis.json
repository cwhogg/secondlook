  "keyFindings": {
    "laboratory": [
      "Identification of Leishmania amastigotes in tissue biopsy or aspirate",
      "Positive serology (rK39, direct agglutination test)",
      "Pancytopenia on complete blood count",
      "Elevated liver enzymes in visceral leishmaniasis"
    ],
    "imaging": [
      "Ultrasound showing hepatosplenomegaly",
      "Chest X-ray may show secondary infections",
      "MRI or CT rarely used but may show mucosal destruction in mucocutaneous form"
    ],
    "genetic": [
      "No specific genetic markers; host genetic susceptibility factors under study"
    ],
    "other": [
      "PCR detection of Leishmania DNA in clinical specimens",
      "Histopathology showing granulomatous inflammation"
    ]
  },
