  "diagnosticCriteria": {
    "formalCriteriaName": "Bartter Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypokalemia",
        "description": "Persistent hypokalemia with renal potassium wasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-alkalosis",
        "description": "Metabolic alkalosis with elevated serum bicarbonate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clcnkb-mutation",
        "description": "Identification of pathogenic mutations in the CLCNKB gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-bp",
        "description": "Normal or low blood pressure despite renin-angiotensin-aldosterone system activation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hyperreninemia",
        "description": "Elevated plasma renin activity and aldosterone levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent hypokalemia and metabolic alkalosis with confirmed CLCNKB gene mutation",
    "notes": "Genetic testing is essential for definitive diagnosis; biochemical abnormalities may overlap with other Bartter subtypes."
  },
