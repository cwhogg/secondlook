  "diagnosticCriteria": {
    "formalCriteriaName": "International Myeloma Working Group (IMWG) Diagnostic Criteria",
    "criteria": [
      {
        "id": "clonal-plasma-cells",
        "description": "Clonal bone marrow plasma cells ≥10% or biopsy-proven plasmacytoma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "myeloma-defining-events",
        "description": "Presence of one or more myeloma-defining events (CRAB features or biomarkers)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "CRAB-features",
        "description": "Evidence of hyperCalcemia, Renal failure, Anemia, or Bone lesions attributable to plasma cell disorder",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biomarkers",
        "description": "Biomarkers of malignancy including involved/uninvolved serum free light chain ratio ≥100, >1 focal lesion on MRI, or clonal plasma cells ≥60%",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clonal plasma cells ≥10% plus at least one myeloma-defining event (CRAB feature or biomarker)",
    "notes": "Diagnosis requires exclusion of other plasma cell dyscrasias and correlation with clinical findings."
  },
