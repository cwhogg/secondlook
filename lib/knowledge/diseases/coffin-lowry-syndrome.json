  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Coffin-Lowry Syndrome",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Moderate to severe intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Characteristic skeletal abnormalities including tapering of distal phalanges and short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features such as prominent forehead, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-neurological-decline",
        "description": "Progressive neurological deterioration including hypotonia and gait abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the RPS6KA3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of intellectual disability, characteristic skeletal abnormalities, and either distinctive facial features or pathogenic RPS6KA3 mutation",
    "notes": "Genetic testing is confirmatory; clinical diagnosis can be made based on phenotype in absence of genetic confirmation."
  },
