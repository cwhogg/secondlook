  "diagnosticCriteria": {
    "formalCriteriaName": "No established formal criteria",
    "criteria": [
      {
        "id": "criterion-1",
        "description": "Short stature defined as height below the 3rd percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-2",
        "description": "Delayed bone age assessed by radiographic evaluation compared to chronological age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-3",
        "description": "Biochemical evidence of thyroid hormone metabolism deficiency (e.g., low serum T3 with normal or elevated T4 and TSH)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-4",
        "description": "Exclusion of other causes of growth retardation and delayed bone age",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: short stature, delayed bone age, and biochemical evidence of thyroid hormone metabolism deficiency",
    "notes": "Diagnosis requires careful biochemical and radiological assessment to differentiate from other growth disorders."
  },
