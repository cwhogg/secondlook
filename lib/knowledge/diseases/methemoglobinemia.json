  "diagnosticCriteria": {
    "formalCriteriaName": "Methemoglobinemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-methemoglobin",
        "description": "Methemoglobin level >1.5% of total hemoglobin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cyanosis-with-normal-pao2",
        "description": "Presence of cyanosis with normal arterial oxygen tension (PaO2)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-methylene-blue",
        "description": "Improvement of symptoms following administration of methylene blue",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of methemoglobinemia or related enzyme deficiencies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated methemoglobin level >1.5% plus clinical cyanosis with normal PaO2",
    "notes": "Diagnosis confirmed by co-oximetry and clinical correlation; genetic testing may support diagnosis."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Central cyanosis unresponsive to oxygen therapy",
        "frequency": 0.85,
        "bodySystem": "dermatological",
        "notes": "Bluish discoloration of skin and mucous membranes"
      },
      {
        "symptomName": "Chocolate-brown colored blood",
        "frequency": 0.75,
        "bodySystem": "hematological",
        "notes": "Characteristic appearance of blood due to oxidized hemoglobin"
      }
    ],
    "common": [
      {
        "symptomName": "Dyspnea",
        "frequency": 0.7,
        "bodySystem": "respiratory",
        "notes": "Shortness of breath due to impaired oxygen delivery"
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.65,
        "bodySystem": "constitutional",
        "notes": "Generalized weakness and tiredness"
      },
      {
        "symptomName": "Headache",
        "frequency": 0.6,
        "bodySystem": "neurological",
        "notes": "Due to hypoxia"
      },
      {
        "symptomName": "Tachycardia",
        "frequency": 0.55,
        "bodySystem": "cardiovascular",
        "notes": "Compensatory increase in heart rate"
      }
    ],
    "occasional": [
      {
        "symptomName": "Confusion",
        "frequency": 0.3,
        "bodySystem": "neurological",
        "notes": "Cognitive impairment secondary to hypoxia"
      },
      {
        "symptomName": "Dizziness",
        "frequency": 0.25,
        "bodySystem": "neurological",
        "notes": "Lightheadedness related to decreased oxygen delivery"
      },
      {
        "symptomName": "Chest pain",
        "frequency": 0.2,
        "bodySystem": "cardiovascular",
        "notes": "Due to myocardial hypoxia"
      },
      {
        "symptomName": "Nausea",
        "frequency": 0.15,
        "bodySystem": "gastrointestinal",
        "notes": "Non-specific symptom"
      }
    ],
    "rare": [
      {
        "symptomName": "Seizures",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Severe hypoxia-induced neurologic event"
      },
      {
        "symptomName": "Coma",
        "frequency": 0.03,
        "bodySystem": "neurological",
        "notes": "In extreme cases of methemoglobinemia"
      },
      {
        "symptomName": "Arrhythmias",
        "frequency": 0.04,
        "bodySystem": "cardiovascular",
        "notes": "Secondary to hypoxia"
      }
    ]
  },
