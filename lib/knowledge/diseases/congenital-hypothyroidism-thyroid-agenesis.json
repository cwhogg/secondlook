  "keyFindings": {
    "laboratory": [
      "Elevated serum TSH",
      "Low serum free T4",
      "Normal or low serum thyroglobulin"
    ],
    "imaging": [
      "Absent thyroid gland on ultrasound",
      "No uptake on radionuclide thyroid scan (e.g., 99mTc-pertechnetate or I-123)"
    ],
    "genetic": [
      "Mutations rarely identified; mostly sporadic cases",
      "Some familial cases linked to genes involved in thyroid development (e.g., TSHR, PAX8)"
    ],
    "other": [
      "Newborn screening programs critical for early detection",
      "Response to levothyroxine therapy confirms diagnosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dyshormonogenetic-congenital-hypothyroidism",
      "distinguishingFeatures": [
        "Presence of thyroid gland on imaging",
        "Elevated TSH with goiter",
        "Defects in thyroid hormone synthesis enzymes"
      ]
    },
    {
      "diseaseId": "central-congenital-hypothyroidism",
      "distinguishingFeatures": [
        "Low or normal TSH despite low T4",
        "Pituitary or hypothalamic abnormalities",
        "No thyroid agenesis on imaging"
      ]
    }
  ],
  "redFlags": [
    "Delayed diagnosis leading to irreversible intellectual disability",
