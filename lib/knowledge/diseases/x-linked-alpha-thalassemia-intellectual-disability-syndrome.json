        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alpha-thalassemia",
        "description": "Presence of alpha-thalassemia confirmed by hematological studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism, depressed nasal bridge, and tented upper lip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Pathogenic mutation in ATRX gene on X chromosome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "other-features",
        "description": "Additional features such as genital abnormalities and hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of intellectual disability, alpha-thalassemia, characteristic facial dysmorphism, and pathogenic ATRX gene mutation",
    "notes": "Diagnosis is confirmed by molecular genetic testing identifying ATRX gene mutations."
