  "keyFindings": {
    "laboratory": [
      "Low serum vitamin B12 levels",
      "Megaloblastic changes on peripheral blood smear",
      "Elevated methylmalonic acid and homocysteine",
      "Proteinuria on urinalysis"
    ],
    "imaging": [
      "Usually normal renal ultrasound",
      "Occasional mild hepatosplenomegaly on abdominal ultrasound"
    ],
    "genetic": [
      "Pathogenic mutations in CUBN gene (cubilin)",
      "Pathogenic mutations in AMN gene (amnionless)"
    ],
    "other": [
      "Normal intrinsic factor antibody test",
      "Positive response to parenteral vitamin B12 supplementation"
    ]
  },
