  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnosis of RAAS blocker-induced angioedema",
    "criteria": [
      {
        "id": "exposure-history",
        "description": "History of exposure to renin-angiotensin-aldosterone system blockers (e.g., ACE inhibitors, ARBs)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "angioedema-localization",
        "description": "Presence of non-pitting, non-pruritic swelling of the face, lips, tongue, or upper airway",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-allergic-features",
        "description": "Lack of urticaria or other allergic manifestations",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-complement-levels",
        "description": "Normal C4 and C1 esterase inhibitor levels to exclude hereditary or acquired angioedema",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "History of RAAS blocker exposure plus characteristic angioedema without urticaria",
    "notes": "Diagnosis is clinical; laboratory tests mainly exclude other causes."
  },
