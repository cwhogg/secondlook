  "diagnosticCriteria": {
    "formalCriteriaName": "Infantile Myofibromatosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "multifocal-nodules",
        "description": "Presence of multiple firm, painless subcutaneous or cutaneous nodules",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological confirmation showing spindle-shaped myofibroblastic proliferation with hemangiopericytoma-like vascular pattern",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-characteristics",
        "description": "Imaging (ultrasound/MRI) demonstrating well-circumscribed soft tissue masses without aggressive features",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-malignancy",
        "description": "Exclusion of malignant tumors by clinical and pathological evaluation",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation plus presence of one or more characteristic nodules clinically or on imaging, with exclusion of malignancy",
    "notes": "Genetic testing may support diagnosis in familial cases but is not routinely required."
  },
