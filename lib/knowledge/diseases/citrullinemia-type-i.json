    "criteria": [
      {
        "id": "hyperammonemia",
        "description": "Elevated plasma ammonia levels exceeding normal reference range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-citrulline",
        "description": "Markedly increased plasma citrulline concentration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ass1-gene-mutation",
        "description": "Identification of pathogenic variants in the ASS1 gene via molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-orotic-acid",
        "description": "Elevated urinary orotic acid levels supporting urea cycle dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "enzyme-activity-assay",
        "description": "Reduced argininosuccinate synthetase enzyme activity in liver biopsy or fibroblasts",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hyperammonemia and elevated plasma citrulline combined with identification of pathogenic ASS1 gene mutations",
    "notes": "Early diagnosis is critical to prevent irreversible neurological damage."
