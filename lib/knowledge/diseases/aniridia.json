  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Aniridia",
    "criteria": [
      {
        "id": "iris-hypoplasia",
        "description": "Congenital absence or hypoplasia of the iris",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "foveal-hypoplasia",
        "description": "Presence of foveal hypoplasia confirmed by ophthalmologic examination or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glaucoma",
        "description": "Development of glaucoma or elevated intraocular pressure",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital iris hypoplasia or absence plus foveal hypoplasia",
    "notes": "Genetic testing for PAX6 mutations supports diagnosis"
  },
