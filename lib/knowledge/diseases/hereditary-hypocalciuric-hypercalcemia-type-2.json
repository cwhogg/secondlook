  "diagnosticCriteria": {
    "formalCriteriaName": "Hereditary Hypocalciuric Hypercalcemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "persistent-hypercalcemia",
        "description": "Persistent mild to moderate hypercalcemia with normal or mildly elevated serum magnesium",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-urinary-calcium-excretion",
        "description": "Low urinary calcium excretion (hypocalciuria) despite hypercalcemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "caSR-gene-mutation",
        "description": "Identification of inactivating mutation in AP2S1 gene (Type 2 HHC)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of hypercalcemia with hypocalciuria",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-symptoms",
        "description": "Typically asymptomatic or mild symptoms without complications of hypercalcemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent hypercalcemia with low urinary calcium excretion and identification of AP2S1 gene mutation",
    "notes": "Differentiation from primary hyperparathyroidism is critical; genetic testing confirms diagnosis."
  },
