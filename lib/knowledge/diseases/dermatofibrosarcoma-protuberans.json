  "keyFindings": {
    "laboratory": [
      "Histopathology showing spindle cell proliferation in storiform pattern",
      "Immunohistochemistry positive for CD34",
      "Negative for factor XIIIa"
    ],
    "imaging": [
      "MRI showing poorly defined dermal and subcutaneous mass",
      "Ultrasound may show hypoechoic lesion with irregular margins"
    ],
    "genetic": [
      "PTEN (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "High local recurrence rate after incomplete excision",
      "Low metastatic potential"
    ]
  },
