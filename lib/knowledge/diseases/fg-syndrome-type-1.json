  "differentialDiagnoses": [
    {
      "diseaseId": "opitz-kaveggia-syndrome",
      "distinguishingFeatures": [
        "FG syndrome type 1 is synonymous with Opitz-Kaveggia syndrome; differentiation from other FG syndromes is based on MED12 mutation"
      ]
    },
    {
      "diseaseId": "x-linked-intellectual-disability-syndromes",
      "distinguishingFeatures": [
        "Other X-linked intellectual disability syndromes lack the characteristic facial features and MED12 mutations seen in FG syndrome type 1"
      ]
    },
    {
      "diseaseId": "agenesis-of-corpus-callosum-syndromes",
      "distinguishingFeatures": [
        "Isolated corpus callosum agenesis without intellectual disability or characteristic facial features"
      ]
    }
  ],
