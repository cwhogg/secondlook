  "diagnosticCriteria": {
    "formalCriteriaName": "DSM-5 Catatonia Specifier Criteria",
    "criteria": [
      {
        "id": "mutism",
        "description": "Marked reduction in verbal response or complete mutism",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "stupor",
        "description": "No psychomotor activity; not actively relating to environment",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "posturing",
        "description": "Spontaneous and active maintenance of a posture against gravity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation affecting neurotransmission or neurodevelopment genes",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of at least two major catatonic signs plus genetic confirmation of pathogenic mutation",
    "notes": "Diagnosis requires exclusion of secondary causes such as metabolic or toxic etiologies."
  },
