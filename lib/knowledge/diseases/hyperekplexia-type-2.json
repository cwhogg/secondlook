  "diagnosticCriteria": {
    "formalCriteriaName": "Hyperekplexia Diagnostic Criteria",
    "criteria": [
      {
        "id": "exaggerated-startle",
        "description": "Presence of an exaggerated startle reflex to unexpected stimuli",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glycine-transporter-mutation",
        "description": "Identification of pathogenic mutations in the SLC6A5 gene encoding the glycine transporter 2",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neonatal-hypertonia",
        "description": "Neonatal hypertonia or stiffness observed in early infancy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-neurological-signs",
        "description": "Lack of other neurological abnormalities such as cognitive impairment or seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of exaggerated startle reflex plus identification of pathogenic SLC6A5 mutation",
    "notes": "Genetic testing is critical for confirmation; clinical presentation may overlap with other startle syndromes."
  },
