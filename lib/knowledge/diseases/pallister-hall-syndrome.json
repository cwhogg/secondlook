    ],
    "genetic": [
      "GLI3 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Clinical observation of gelastic seizures",
      "Physical exam revealing polydactyly and facial dysmorphism"
    ]
  },
