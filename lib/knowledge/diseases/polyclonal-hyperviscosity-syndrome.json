  "diagnosticCriteria": {
    "formalCriteriaName": "Polyclonal Hyperviscosity Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-serum-viscosity",
        "description": "Serum viscosity elevated above normal reference range without monoclonal protein predominance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "polyclonal-hypergammaglobulinemia",
        "description": "Presence of polyclonal hypergammaglobulinemia confirmed by serum protein electrophoresis and immunofixation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features-of-hyperviscosity",
        "description": "Clinical symptoms attributable to hyperviscosity such as mucosal bleeding, visual disturbances, or neurological deficits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-monoclonal-gammopathy",
        "description": "Exclusion of monoclonal gammopathy or plasma cell dyscrasia by immunophenotyping and bone marrow biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-plasmapheresis",
        "description": "Improvement of symptoms and serum viscosity following plasmapheresis treatment",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated serum viscosity with polyclonal hypergammaglobulinemia and clinical features of hyperviscosity, excluding monoclonal gammopathy",
    "notes": "Diagnosis requires exclusion of monoclonal gammopathies and other causes of hyperviscosity."
  },
