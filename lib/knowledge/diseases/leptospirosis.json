  "keyFindings": {
    "laboratory": [
      "Elevated serum bilirubin and transaminases",
      "Leukocytosis or leukopenia",
      "Elevated serum creatinine and blood urea nitrogen",
      "Positive microscopic agglutination test (MAT)",
      "PCR detection of Leptospira DNA"
    ],
    "imaging": [
      "Chest X-ray showing pulmonary infiltrates or hemorrhage",
      "Ultrasound may show hepatomegaly or renal changes"
    ],
    "genetic": [],
    "other": [
      "Isolation of Leptospira from blood or urine cultures",
      "Electrolyte abnormalities including hypokalemia"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dengue-fever",
      "distinguishingFeatures": [
        "Thrombocytopenia more prominent",
        "Rash and hemorrhagic manifestations",
        "Negative Leptospira serology"
      ]
    },
    {
      "diseaseId": "viral-hepatitis",
      "distinguishingFeatures": [
        "Predominant liver enzyme elevation without renal failure",
        "Absence of conjunctival suffusion",
        "Negative exposure history to contaminated water"
      ]
    },
    {
      "diseaseId": "malaria",
      "distinguishingFeatures": [
        "Parasitic identification on blood smear",
        "Cyclic fever pattern",
        "No conjunctival suffusion"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset of jaundice with renal failure",
    "Pulmonary hemorrhage or severe respiratory distress",
    "Hypotension refractory to fluids"
  ],
