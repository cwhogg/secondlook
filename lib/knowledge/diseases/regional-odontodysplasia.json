  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Radiographs showing 'ghost teeth' with thin enamel and dentin and enlarged pulp chambers",
      "Cone-beam CT may reveal hypoplastic alveolar bone and delayed tooth eruption"
    ],
    "genetic": [
      "No consistent genetic mutation identified; considered non-hereditary or sporadic"
    ],
    "other": [
      "Clinical examination reveals localized enamel hypoplasia and tooth malformation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "amelogenesis-imperfecta",
      "distinguishingFeatures": [
        "Generalized enamel defects affecting all teeth rather than localized involvement",
        "Family history often positive",
        "Radiographs do not show 'ghost teeth' appearance"
      ]
    },
    {
      "diseaseId": "dentinogenesis-imperfecta",
      "distinguishingFeatures": [
        "Generalized dentin defects with opalescent teeth",
        "Radiographs show obliterated pulp chambers rather than enlarged",
        "Usually affects both primary and permanent dentition diffusely"
      ]
    }
  ],
  "redFlags": [
