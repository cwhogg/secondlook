  "differentialDiagnoses": [
    {
      "diseaseId": "freeman-sheldon-syndrome",
      "distinguishingFeatures": [
        "More severe facial contractures including 'whistling face' appearance",
        "More pronounced orofacial involvement",
        "Higher frequency of respiratory complications"
      ]
    },
    {
      "diseaseId": "distal-arthrogryposis-type-1",
      "distinguishingFeatures": [
        "Primarily distal joint contractures without significant facial involvement",
        "Less prominent facial dysmorphism",
        "Usually no muscle weakness"
      ]
    }
  ],
  "redFlags": [
