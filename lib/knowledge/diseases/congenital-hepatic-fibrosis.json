  "keyFindings": {
    "laboratory": [
      "Normal liver function tests with possible mild elevation of transaminases",
      "Thrombocytopenia due to hypersplenism",
      "Mild elevation of bilirubin during cholangitis episodes"
    ],
    "imaging": [
      "Ultrasound showing enlarged echogenic liver with periportal thickening",
      "Splenomegaly and signs of portal hypertension on Doppler ultrasound",
      "MRI/MRCP demonstrating biliary abnormalities and fibrosis"
    ],
    "genetic": [
      "Pathogenic variants in PKHD1 gene"
    ],
    "other": [
      "Liver biopsy showing periportal fibrosis with preserved lobular architecture"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "caroli-disease",
      "distinguishingFeatures": [
        "Intrahepatic bile duct dilatation",
        "Recurrent cholangitis more prominent",
        "Associated with Caroli syndrome when combined with CHF"
      ]
    },
    {
      "diseaseId": "cirrhosis",
      "distinguishingFeatures": [
        "Disrupted liver architecture with regenerative nodules",
        "Impaired liver synthetic function",
        "Usually acquired rather than congenital"
      ]
    }
  ],
  "redFlags": [
    "Severe gastrointestinal bleeding from varices",
    "Recurrent cholangitis with sepsis",
    "Rapidly progressive renal failure"
  ],
