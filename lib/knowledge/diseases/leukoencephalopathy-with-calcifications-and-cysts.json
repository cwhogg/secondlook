        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Neurological symptoms including developmental delay, seizures, and motor impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the CTC1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of leukoencephalopathy with calcifications and cysts",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic neuroimaging findings plus either compatible clinical features or genetic confirmation",
    "notes": "Genetic testing for CTC1 mutations is strongly recommended to confirm diagnosis."
  },
