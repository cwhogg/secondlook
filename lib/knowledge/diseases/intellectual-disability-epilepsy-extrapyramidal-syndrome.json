  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Intellectual Disability-Epilepsy-Extrapyramidal Syndrome",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of global developmental delay or intellectual disability confirmed by standardized cognitive testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epilepsy",
        "description": "Recurrent unprovoked seizures consistent with epilepsy, documented clinically or by EEG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "extrapyramidal-features",
        "description": "Clinical evidence of extrapyramidal motor symptoms such as dystonia, rigidity, or bradykinesia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variant in associated gene if available",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuroimaging",
        "description": "Neuroimaging findings excluding alternative causes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of intellectual disability, epilepsy, and extrapyramidal motor symptoms clinically",
    "notes": "Genetic testing may support diagnosis but is not mandatory; exclusion of other metabolic or neurodegenerative disorders is essential."
  },
