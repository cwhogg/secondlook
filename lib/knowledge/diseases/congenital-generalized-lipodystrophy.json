  "prevalence": {
    "estimate": "1 in 10,000,000",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 1,
      "peak": 0
    },
    "sexPredilection": "equal",
    "ethnicAssociations": [
      "Brazilian",
      "Middle Eastern",
      "North African"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Berardinelli-Seip Diagnostic Criteria",
    "criteria": [
      {
        "id": "absence-adipose-tissue",
        "description": "Near-total absence of subcutaneous adipose tissue from birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-insulin-resistance",
        "description": "Severe insulin resistance with hyperinsulinemia and early-onset diabetes mellitus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypertriglyceridemia",
        "description": "Marked hypertriglyceridemia often exceeding 500 mg/dL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepatomegaly-fatty-liver",
        "description": "Hepatomegaly with fatty infiltration (steatosis)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "acanthosis-nigricans",
        "description": "Presence of acanthosis nigricans indicating insulin resistance",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscular-hypertrophy",
        "description": "Apparent muscular hypertrophy due to lack of fat masking muscle bulk",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: near-total absence of adipose tissue from birth, severe insulin resistance, and hypertriglyceridemia",
    "notes": "Genetic testing can confirm diagnosis by identifying mutations in AGPAT2, BSCL2, or other related genes."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Near-total absence of subcutaneous adipose tissue",
        "frequency": 0.98,
        "bodySystem": "dermatological",
        "notes": "Visible from birth, generalized fat loss"
      },
      {
        "symptomName": "Severe insulin resistance with hyperinsulinemia",
        "frequency": 0.95,
        "bodySystem": "endocrine",
        "notes": "Leads to early-onset diabetes mellitus"
      },
      {
        "symptomName": "Hypertriglyceridemia",
        "frequency": 0.9,
        "bodySystem": "endocrine",
        "notes": "Markedly elevated serum triglycerides"
      }
    ],
    "common": [
      {
        "symptomName": "Hepatomegaly with fatty infiltration",
        "frequency": 0.85,
        "bodySystem": "gastrointestinal",
        "notes": "Fatty liver disease common in early childhood"
      },
      {
        "symptomName": "Acanthosis nigricans",
        "frequency": 0.8,
        "bodySystem": "dermatological",
        "notes": "Hyperpigmented velvety plaques, especially in neck and axilla"
      },
      {
        "symptomName": "Muscular hypertrophy appearance",
        "frequency": 0.75,
        "bodySystem": "musculoskeletal",
        "notes": "Due to lack of subcutaneous fat masking muscles"
      },
      {
        "symptomName": "Hyperphagia",
        "frequency": 0.7,
        "bodySystem": "constitutional",
        "notes": "Increased appetite due to metabolic disturbances"
      }
    ],
    "occasional": [
      {
        "symptomName": "Cardiomyopathy",
        "frequency": 0.4,
        "bodySystem": "cardiovascular",
        "notes": "Dilated or hypertrophic cardiomyopathy reported"
      },
      {
        "symptomName": "Polycystic ovary syndrome (PCOS)",
        "frequency": 0.35,
        "bodySystem": "reproductive",
        "notes": "In females, due to insulin resistance"
      },
      {
        "symptomName": "Neuropathy",
        "frequency": 0.3,
        "bodySystem": "neurological",
        "notes": "Peripheral neuropathy secondary to diabetes"
      },
      {
        "symptomName": "Hepatic fibrosis",
        "frequency": 0.25,
        "bodySystem": "gastrointestinal",
        "notes": "Progression from fatty liver to fibrosis"
      },
      {
        "symptomName": "Pancreatitis",
        "frequency": 0.2,
        "bodySystem": "gastrointestinal",
        "notes": "Due to severe hypertriglyceridemia"
      }
    ],
    "rare": [
      {
        "symptomName": "Aortic stenosis",
        "frequency": 0.08,
        "bodySystem": "cardiovascular",
        "notes": "Reported in some cases"
      },
      {
        "symptomName": "Hearing loss",
        "frequency": 0.05,
        "bodySystem": "otolaryngological",
        "notes": "Rarely reported"
      },
      {
        "symptomName": "Psychiatric manifestations",
        "frequency": 0.04,
        "bodySystem": "psychiatric",
        "notes": "Depression or anxiety secondary to chronic illness"
      }
    ]
  },
  "systemsAffected": [
    "dermatological",
    "endocrine",
    "gastrointestinal",
    "musculoskeletal",
    "cardiovascular",
