  "diagnosticCriteria": {
    "formalCriteriaName": "Arginase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-arginine",
        "description": "Persistent hyperargininemia detected by plasma amino acid analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "arginase-activity-deficiency",
        "description": "Reduced or absent arginase enzyme activity in red blood cells or liver tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the ARG1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Progressive spasticity and developmental delay consistent with argininemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent hyperargininemia plus either reduced arginase enzyme activity or pathogenic ARG1 gene variants",
    "notes": "Diagnosis is confirmed by biochemical and genetic testing; clinical features support but are not solely diagnostic."
  },
