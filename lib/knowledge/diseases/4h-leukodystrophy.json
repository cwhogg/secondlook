  "diagnosticCriteria": {
    "formalCriteriaName": "4H Leukodystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypomyelination",
        "description": "MRI evidence of diffuse hypomyelination with relative preservation of cerebellar structures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogonadotropic-hypogonadism",
        "description": "Clinical and biochemical evidence of hypogonadotropic hypogonadism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypodontia",
        "description": "Congenital absence or delayed eruption of permanent teeth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in POLR3A or POLR3B genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-features",
        "description": "Presence of cerebellar ataxia and pyramidal signs",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (hypomyelination on MRI, hypogonadotropic hypogonadism, and hypodontia) with supportive genetic testing if available",
    "notes": "Genetic confirmation is helpful but not mandatory if clinical and radiological criteria are met"
  },
