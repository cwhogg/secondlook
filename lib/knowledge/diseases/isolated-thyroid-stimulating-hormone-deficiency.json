  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Isolated TSH Deficiency",
    "criteria": [
      {
        "id": "low-ts-h",
        "description": "Persistently low or inappropriately normal serum thyroid-stimulating hormone (TSH) levels despite low free thyroxine (FT4)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-pituitary-imaging",
        "description": "Normal pituitary gland morphology on MRI excluding structural lesions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-pituitary-hormone-deficiencies",
        "description": "No evidence of deficiencies in other anterior pituitary hormones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-hypothyroidism",
        "description": "Clinical signs and symptoms consistent with hypothyroidism",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-thyrotropin-releasing-hormone-stimulation",
        "description": "Blunted or absent TSH response to thyrotropin-releasing hormone (TRH) stimulation test",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met: low/inappropriately normal TSH with low FT4, normal pituitary imaging, and absence of other pituitary hormone deficiencies.",
    "notes": "Diagnosis requires exclusion of secondary causes of hypothyroidism and other pituitary disorders."
  },
