  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria; diagnosis based on clinical and radiological features",
    "criteria": [
      {
        "id": "acro-osteolysis",
        "description": "Presence of acro-osteolysis of distal phalanges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-abnormalities",
        "description": "Characteristic craniofacial features including micrognathia, midface hypoplasia, and wormian bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "generalized-osteoporosis",
        "description": "Radiological evidence of generalized osteoporosis with fractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "familial-history",
        "description": "Family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "NOTCH2-mutation",
        "description": "Identification of pathogenic NOTCH2 gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acro-osteolysis plus characteristic craniofacial abnormalities and generalized osteoporosis",
    "notes": "Genetic testing for NOTCH2 mutations can support diagnosis but is not mandatory"
  },
