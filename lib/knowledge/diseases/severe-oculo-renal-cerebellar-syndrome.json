  "diagnosticCriteria": {
    "formalCriteriaName": "Severe Oculo-Renal-Cerebellar Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "ocular-anomalies",
        "description": "Presence of congenital ocular malformations including microphthalmia or coloboma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-dysplasia",
        "description": "Evidence of bilateral renal dysplasia or cystic kidney disease on imaging or biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-hypoplasia",
        "description": "Neuroimaging demonstrating cerebellar hypoplasia or atrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism and broad nasal bridge",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (ocular anomalies, renal dysplasia, and cerebellar hypoplasia) must be present for diagnosis.",
    "notes": "Genetic testing may support diagnosis but is not mandatory."
  },
