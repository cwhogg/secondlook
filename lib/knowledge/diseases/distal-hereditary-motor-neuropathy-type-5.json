  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Creatine kinase levels usually normal or mildly elevated"
    ],
    "imaging": [
      "Muscle MRI may show selective muscle atrophy and fatty infiltration in distal limb muscles"
    ],
    "genetic": [
      "REEP1 (causative)",
      "BSCL2 (causative)",
      "GARS1 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography (EMG) shows chronic denervation and reinnervation changes in distal muscles",
      "Nerve conduction studies reveal reduced motor amplitudes with normal sensory conduction"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "charcot-marie-tooth-disease-type-2",
      "distinguishingFeatures": [
        "Presence of sensory neuropathy",
        "Slower progression",
        "Different genetic mutations (e.g., MFN2)"
      ]
    },
    {
      "diseaseId": "amyotrophic-lateral-sclerosis",
      "distinguishingFeatures": [
        "Upper and lower motor neuron signs",
        "Rapid progression",
        "No family history in most cases"
      ]
    },
    {
      "diseaseId": "spinal muscular atrophy",
      "distinguishingFeatures": [
        "Proximal muscle weakness predominant",
        "Genetic testing for SMN1 gene deletion",
        "Earlier onset in most cases"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive weakness over weeks to months",
    "Presence of sensory loss or neuropathic pain",
    "Bulbar symptoms such as dysphagia or dysarthria"
  ],
