  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiographic Diagnostic Criteria for Cleidocranial Dysplasia",
    "criteria": [
      {
        "id": "clavicular-hypoplasia",
        "description": "Hypoplasia or aplasia of the clavicles allowing abnormal shoulder approximation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "delayed-cranial-suture-closure",
        "description": "Delayed closure or persistence of open cranial sutures and fontanelles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-anomalies",
        "description": "Multiple supernumerary teeth, delayed eruption of permanent teeth, and dental malocclusion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "RUNX2-mutation",
        "description": "Identification of pathogenic RUNX2 gene mutation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "short-stature",
        "description": "Mild short stature relative to family norms",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "broad-skull",
        "description": "Brachycephaly or broad skull with frontal bossing",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clavicular hypoplasia or aplasia plus delayed closure of cranial sutures and dental anomalies; genetic confirmation supportive but not mandatory",
    "notes": "Genetic testing for RUNX2 mutations can confirm diagnosis but clinical and radiographic findings are primary."
  },
