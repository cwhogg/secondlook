        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Neonatal onset of hypotonia, lethargy, and myoclonic seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes encoding the glycine cleavage system (e.g., GLDC, AMT, GCSH)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroencephalogram",
        "description": "Burst suppression pattern or hypsarrhythmia on EEG",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-ketosis",
        "description": "Normal ketone bodies in plasma and urine despite severe encephalopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated CSF glycine with increased CSF-to-plasma glycine ratio plus neonatal clinical presentation and/or pathogenic variants in glycine cleavage system genes",
    "notes": "Diagnosis is confirmed by biochemical and genetic testing; EEG findings support clinical suspicion."
  },
