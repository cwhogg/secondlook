  "diagnosticCriteria": {
    "formalCriteriaName": "ARSACS Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-triad",
        "description": "Presence of the clinical triad: early-onset cerebellar ataxia, spasticity, and peripheral neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging-findings",
        "description": "MRI showing linear hypointensities in the pons and cerebellar atrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the SACS gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electroneuromyography demonstrating sensorimotor peripheral neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or affected siblings consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of the clinical triad plus either neuroimaging findings or genetic confirmation",
    "notes": "Genetic testing is definitive; clinical and imaging findings support diagnosis."
  },
