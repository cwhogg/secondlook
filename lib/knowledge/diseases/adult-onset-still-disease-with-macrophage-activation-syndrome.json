  "diagnosticCriteria": {
    "formalCriteriaName": "Yamaguchi Criteria for Adult-Onset Still Disease with MAS",
    "criteria": [
      {
        "id": "fever",
        "description": "High spiking fever ≥39°C lasting ≥1 week",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "arthralgia",
        "description": "Arthralgia or arthritis lasting ≥2 weeks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "typical-rash",
        "description": "Evanescent, salmon-pink maculopapular rash",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "leukocytosis",
        "description": "Leukocytosis with neutrophilia (>10,000/mm³)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hepatosplenomegaly",
        "description": "Hepatosplenomegaly or lymphadenopathy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "negative-rf-ana",
        "description": "Negative rheumatoid factor and antinuclear antibodies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hemophagocytosis",
        "description": "Evidence of hemophagocytosis in bone marrow or other tissues",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cytopenias",
        "description": "Cytopenias affecting ≥2 cell lines (anemia, leukopenia, thrombocytopenia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyperferritinemia",
        "description": "Markedly elevated serum ferritin (>5000 ng/mL)",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "At least 3 major criteria including fever, typical rash, and evidence of macrophage activation (hemophagocytosis, cytopenias, or hyperferritinemia), plus exclusion of infections and malignancies",
    "notes": "Diagnosis requires exclusion of infectious, malignant, and other autoimmune causes; MAS is a life-threatening complication of AOSD."
  },
