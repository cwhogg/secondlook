  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; exclusion of metabolic causes"
    ],
    "imaging": [
      "Midbrain atrophy with 'hummingbird sign' on MRI",
      "Reduced uptake in basal ganglia on DaTscan"
    ],
    "genetic": [
      "No consistent genetic mutation identified; some cases show MAPT gene haplotypes association"
    ],
    "other": [
      "Poor or absent response to levodopa therapy",
      "Progressive clinical course over several years"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "parkinson-disease",
      "distinguishingFeatures": [
        "Good initial response to levodopa",
        "Absence of early vertical gaze palsy",
        "Slower progression of postural instability"
      ]
    },
    {
      "diseaseId": "multiple-system-atrophy",
      "distinguishingFeatures": [
        "Prominent autonomic failure early in disease",
        "Cerebellar signs more common",
        "Lack of vertical gaze palsy"
      ]
    },
    {
      "diseaseId": "corticobasal-degeneration",
      "distinguishingFeatures": [
        "Asymmetric limb rigidity and apraxia",
        "Cortical sensory deficits",
        "Alien limb phenomenon"
      ]
    }
  ],
