  "keyFindings": {
    "laboratory": [
      "Elevated direct (conjugated) bilirubin",
      "Elevated serum gamma-glutamyl transferase (GGT)",
      "Prolonged prothrombin time (PT) due to vitamin K deficiency"
    ],
    "imaging": [
      "Absent or small gallbladder on ultrasound",
      "Triangular cord sign on ultrasound",
      "Cholangiography showing obliteration of extrahepatic bile ducts"
    ],
    "genetic": [
      "No definitive genetic mutation identified; possible multifactorial etiology"
    ],
    "other": [
      "Liver biopsy showing bile duct proliferation, portal fibrosis, and bile plugs"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "neonatal-hepatitis",
      "distinguishingFeatures": [
        "Presence of hepatocellular inflammation without bile duct obliteration",
        "Normal or mildly abnormal bile ducts on cholangiography"
      ]
    },
    {
      "diseaseId": "alpha-1-antitrypsin-deficiency",
      "distinguishingFeatures": [
        "Serum alpha-1 antitrypsin deficiency",
        "PAS-positive diastase-resistant globules on liver biopsy"
      ]
    },
    {
      "diseaseId": "cystic-fibrosis-related-liver-disease",
      "distinguishingFeatures": [
        "Positive sweat chloride test",
        "Multisystem involvement including pulmonary symptoms"
      ]
    }
  ],
  "redFlags": [
    "Progressive jaundice beyond 2 weeks of age",
    "Acholic stools indicating bile flow obstruction",
    "Rapidly worsening liver function tests"
  ],
