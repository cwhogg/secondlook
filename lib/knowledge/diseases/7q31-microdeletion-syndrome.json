  "diagnosticCriteria": {
    "formalCriteriaName": "7q31 Microdeletion Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of a microdeletion at chromosome 7q31 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including hypertelorism and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-issues",
        "description": "Behavioral abnormalities such as autistic features or hyperactivity",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or musculoskeletal abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 7q31 microdeletion plus at least two major clinical features including developmental delay and craniofacial dysmorphism",
    "notes": "Diagnosis relies heavily on molecular genetic testing due to phenotypic variability"
  },
