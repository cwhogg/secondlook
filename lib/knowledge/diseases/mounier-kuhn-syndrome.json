  "differentialDiagnoses": [
    {
      "diseaseId": "bronchiectasis",
      "distinguishingFeatures": [
        "Localized bronchial dilation without tracheal enlargement",
        "Often secondary to infection or obstruction"
      ]
    },
    {
      "diseaseId": "relapsing-polychondritis",
      "distinguishingFeatures": [
        "Inflammatory cartilage destruction",
        "Systemic symptoms and involvement of other cartilaginous structures"
      ]
    },
    {
      "diseaseId": "tracheomalacia",
      "distinguishingFeatures": [
        "Dynamic airway collapse without fixed tracheal dilation",
        "Often diagnosed with bronchoscopy or dynamic imaging"
      ]
    }
  ],
