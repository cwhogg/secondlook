  "diagnosticCriteria": {
    "formalCriteriaName": "Wilson-Turner Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Moderate to severe intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogonadism",
        "description": "Hypogonadism with micropenis and cryptorchidism in males",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "obesity",
        "description": "Childhood-onset obesity with truncal fat distribution",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Characteristic facial dysmorphism including prominent supraorbital ridges, broad nasal bridge, and thin upper lip",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-problems",
        "description": "Behavioral abnormalities including hyperactivity and autistic features",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of intellectual disability, hypogonadism, and childhood-onset obesity",
    "notes": "Genetic testing confirming mutations in the HDAC8 gene supports diagnosis"
  },
