  "keyFindings": {
    "laboratory": [
      "Elevated urinary heparan sulfate",
      "Deficient lysosomal enzyme activity in leukocytes or fibroblasts"
    ],
    "imaging": [
      "Brain MRI showing cerebral atrophy and white matter changes",
      "Skeletal X-rays demonstrating dysostosis multiplex"
    ],
    "genetic": [
      "Pathogenic variants in SGSH, NAGLU, HGSNAT, or GNS genes"
    ],
    "other": [
      "Neurophysiological studies may show delayed evoked potentials"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hunter-syndrome-mps-ii",
      "distinguishingFeatures": [
        "X-linked inheritance",
        "Presence of coarse facial features with more prominent somatic involvement",
        "Less prominent behavioral problems compared to Sanfilippo syndrome"
      ]
    },
    {
      "diseaseId": "mucopolysaccharidosis-type-iva",
      "distinguishingFeatures": [
        "Severe skeletal dysplasia with normal intelligence",
        "Corneal clouding more prominent",
        "Absence of severe neurodegeneration"
      ]
    }
  ],
  "redFlags": [
    "Progressive loss of developmental milestones after initial normal development",
    "Severe behavioral problems including hyperactivity and aggression",
    "Elevated urinary glycosaminoglycans with normal enzyme activity for other MPS types"
  ],
