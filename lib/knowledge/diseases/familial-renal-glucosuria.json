  "keyFindings": {
    "laboratory": [
      "Persistent glucosuria with normal blood glucose levels",
      "Normal serum electrolytes or mild imbalances",
      "Normal renal function tests"
    ],
    "imaging": [
      "Renal ultrasound typically normal"
    ],
    "genetic": [
      "Pathogenic mutations in SGLT2 (SLC5A2) gene"
    ],
    "other": [
      "Negative oral glucose tolerance test for diabetes",
      "Absence of ketonuria"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "diabetes-mellitus",
      "distinguishingFeatures": [
        "Presence of hyperglycemia",
        "Positive oral glucose tolerance test",
        "Absence of SGLT2 mutations"
      ]
    },
    {
      "diseaseId": "renal-tubular-acidosis",
      "distinguishingFeatures": [
        "Metabolic acidosis with normal anion gap",
        "Electrolyte disturbances more severe",
        "Possible glucosuria but with acid-base imbalance"
      ]
    },
    {
      "diseaseId": "fanconi-syndrome",
      "distinguishingFeatures": [
        "Generalized proximal tubular dysfunction",
        "Glucosuria with aminoaciduria, phosphaturia, bicarbonate loss",
        "Associated with other systemic symptoms"
      ]
    }
  ],
