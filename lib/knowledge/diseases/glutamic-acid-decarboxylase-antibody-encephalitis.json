    "respiratory"
  ],
  "keyFindings": {
    "laboratory": [
      "Elevated anti-GAD antibodies in serum and/or CSF",
      "Mild CSF pleocytosis or elevated protein"
    ],
    "imaging": [
      "MRI showing medial temporal lobe hyperintensities on FLAIR or T2-weighted sequences"
    ],
    "genetic": [],
    "other": [
      "Electromyography showing continuous motor unit activity in stiff-person syndrome",
      "Exclusion of infectious or neoplastic etiologies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "limbic-encephalitis-other-autoimmune",
      "distinguishingFeatures": [
        "Presence of other specific autoantibodies (e.g., anti-NMDA receptor)",
        "Different clinical presentation such as prominent movement disorders"
      ]
    },
    {
      "diseaseId": "paraneoplastic-encephalitis",
      "distinguishingFeatures": [
        "Association with underlying malignancy",
        "Presence of paraneoplastic antibodies (e.g., anti-Hu, anti-Ma2)"
      ]
    },
    {
      "diseaseId": "infectious-encephalitis",
      "distinguishingFeatures": [
        "Positive infectious agent identification",
        "Fever and systemic signs of infection"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive neurological decline",
    "Refractory seizures despite standard treatment",
    "Development of respiratory failure due to muscle rigidity"
  ],
