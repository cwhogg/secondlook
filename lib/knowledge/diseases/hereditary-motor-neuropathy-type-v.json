  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Normal creatine kinase levels"
    ],
    "imaging": [
      "Muscle MRI may show selective muscle atrophy in distal upper limbs"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography showing chronic denervation and reinnervation",
      "Nerve conduction studies showing reduced motor amplitudes with normal sensory conduction"
    ]
  },
