  "differentialDiagnoses": [
    {
      "diseaseId": "cutaneous-mastocytosis",
      "distinguishingFeatures": [
        "Mast cell infiltration limited to skin without systemic involvement",
        "Absence of hematologic neoplasm",
        "Normal or mildly elevated serum tryptase"
      ]
    },
    {
      "diseaseId": "myelodysplastic-syndrome",
      "distinguishingFeatures": [
        "Dysplastic hematopoiesis without mast cell aggregates",
        "No KIT D816V mutation in mast cells",
        "Lack of systemic mastocytosis criteria"
      ]
    },
    {
      "diseaseId": "chronic-myelomonocytic-leukemia",
      "distinguishingFeatures": [
        "Monocytosis and myeloid dysplasia without mast cell infiltration",
        "Absence of mast cell aggregates in bone marrow biopsy",
        "Different genetic mutation profile"
      ]
    }
  ],
