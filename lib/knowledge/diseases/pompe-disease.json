  "diagnosticCriteria": {
    "formalCriteriaName": "ACMG and expert consensus guidelines for Pompe disease diagnosis",
    "criteria": [
      {
        "id": "pompe-c1",
        "description": "Deficient acid alpha-glucosidase (GAA) enzyme activity in dried blood spot (DBS), leukocytes, or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pompe-c2",
        "description": "Biallelic pathogenic variants in GAA gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pompe-c3",
        "description": "Elevated creatine kinase (CK)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "pompe-c4",
        "description": "Elevated urine glucose tetrasaccharide (Glc4, Hex4)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "pompe-c5",
        "description": "Muscle biopsy showing vacuolar myopathy with glycogen accumulation and acid phosphatase reactivity",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "pompe-c6",
        "description": "Clinical features consistent with infantile-onset (cardiomyopathy, hypotonia, respiratory failure) or late-onset (proximal myopathy, respiratory insufficiency) Pompe disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient GAA enzyme activity confirmed in two separate sample types (e.g., DBS confirmed in leukocytes or fibroblasts) or GAA enzyme deficiency plus biallelic GAA mutations",
    "notes": "Infantile-onset Pompe disease (IOPD) presents before age 12 months with cardiomyopathy and is fatal within 1-2 years without treatment. Late-onset Pompe disease (LOPD) presents from childhood to adulthood with limb-girdle weakness and respiratory insufficiency without significant cardiomyopathy. Newborn screening is expanding globally."
  },
