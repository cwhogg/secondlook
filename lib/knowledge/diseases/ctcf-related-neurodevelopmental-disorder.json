    "laboratory": [
      "Normal routine blood tests; no specific biochemical markers identified"
    ],
    "imaging": [
      "Brain MRI may show nonspecific findings such as delayed myelination or mild cerebral atrophy"
    ],
    "genetic": [
      "CTCF (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Characteristic facial dysmorphisms on clinical examination"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cornelia-de-lange-syndrome",
      "distinguishingFeatures": [
        "Distinctive limb abnormalities",
        "More severe growth retardation",
