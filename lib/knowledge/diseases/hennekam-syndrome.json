  "diagnosticCriteria": {
    "formalCriteriaName": "Hennekam Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "lymphedema",
        "description": "Presence of congenital or early-onset lymphedema affecting limbs or face",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features including flat midface, hypertelorism, broad nasal bridge, and epicanthal folds",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intestinal-lymphangiectasia",
        "description": "Evidence of intestinal lymphangiectasia causing protein-losing enteropathy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic variants in CCBE1 or FAT4 genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (lymphedema, distinctive facial features, and intellectual disability) with or without genetic confirmation",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical criteria are met."
  },
