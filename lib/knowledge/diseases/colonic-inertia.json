  "diagnosticCriteria": {
    "formalCriteriaName": "Colonic Transit Study Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-constipation",
        "description": "Chronic constipation lasting more than 6 months with infrequent bowel movements",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "delayed-colonic-transit",
        "description": "Demonstrated delayed colonic transit on radiopaque marker or scintigraphic transit studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-mechanical-obstruction",
        "description": "Exclusion of mechanical obstruction by colonoscopy or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "manometry-findings",
        "description": "Colonic manometry showing impaired or absent colonic peristalsis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic constipation with delayed colonic transit and exclusion of mechanical obstruction",
    "notes": "Colonic manometry is supportive but not mandatory for diagnosis."
  },
