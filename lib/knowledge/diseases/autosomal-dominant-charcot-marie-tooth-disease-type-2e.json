  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for CMT2E",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Progressive distal muscle weakness and atrophy predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electrophysiological evidence of axonal neuropathy with normal or mildly reduced nerve conduction velocities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the NEFL gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-sensory-loss",
        "description": "Presence of distal sensory loss and diminished deep tendon reflexes",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal muscle weakness and atrophy with electrophysiological evidence of axonal neuropathy plus identification of a pathogenic NEFL gene mutation",
    "notes": "Genetic confirmation is essential for definitive diagnosis due to phenotypic overlap with other CMT subtypes."
  },
