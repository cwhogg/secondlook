        "Different genetic causes"
      ]
    },
    {
      "diseaseId": "juvenile-nephronophthisis",
      "distinguishingFeatures": [
        "Progressive renal failure without cystine crystal deposition",
        "No Fanconi syndrome",
        "Negative CTNS mutation testing"
      ]
    }
  ],
