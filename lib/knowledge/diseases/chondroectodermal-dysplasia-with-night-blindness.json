  "diagnosticCriteria": {
    "formalCriteriaName": "Ellis-van Creveld Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "chondrodysplasia",
        "description": "Short-limbed dwarfism with disproportionate shortening of the limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ectodermal-dysplasia",
        "description": "Nail dysplasia, dental anomalies including hypodontia and conical teeth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defect",
        "description": "Presence of congenital heart defects, commonly atrial septal defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "night-blindness",
        "description": "Impaired vision in low light or darkness due to retinal dystrophy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "polydactyly",
        "description": "Postaxial polydactyly of hands or feet",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: chondrodysplasia, ectodermal dysplasia, and congenital heart defect",
    "notes": "Night blindness is a distinctive but not mandatory feature; genetic testing can confirm diagnosis"
  },
