  "diagnosticCriteria": {
    "formalCriteriaName": "Varadi-Papp Diagnostic Criteria for OFD6",
    "criteria": [
      {
        "id": "oral-anomalies",
        "description": "Presence of oral anomalies including cleft lip and/or palate, tongue hamartomas, or lobulated tongue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features such as hypertelorism, broad nasal bridge, and midface hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digital-malformations",
        "description": "Postaxial polydactyly or mesoaxial polydactyly of hands and/or feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-hypoplasia",
        "description": "Radiological evidence of cerebellar vermis hypoplasia or molar tooth sign",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-anomalies",
        "description": "Presence of renal cystic dysplasia or other renal malformations",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (oral anomalies, facial dysmorphism, and digital malformations) with supportive imaging findings",
    "notes": "Genetic testing for TMEM216 mutations can confirm diagnosis"
  },
