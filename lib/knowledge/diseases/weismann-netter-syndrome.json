  "diagnosticCriteria": {
    "formalCriteriaName": "Weismann-Netter Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "bilateral-anterior-tibial-bowing",
        "description": "Presence of bilateral anterior bowing of the tibiae and fibulae",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cortical-thickening",
        "description": "Radiographic evidence of cortical thickening and sclerosis of the tibiae and fibulae",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-metabolic-bone-disease",
        "description": "Exclusion of metabolic bone diseases such as rickets or osteomalacia",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-serum-calcium-and-phosphate",
        "description": "Normal serum calcium and phosphate levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history suggestive of autosomal dominant inheritance",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Bilateral anterior tibial bowing with cortical thickening on imaging and exclusion of metabolic bone diseases",
    "notes": "Diagnosis is primarily clinical and radiological; genetic testing is not routinely available."
  },
