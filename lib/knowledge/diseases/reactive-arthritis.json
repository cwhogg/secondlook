  "diagnosticCriteria": {
    "formalCriteriaName": "No universally accepted formal criteria; clinical diagnosis based on temporal association with preceding infection",
    "criteria": [
      {
        "id": "rea-c1",
        "description": "Asymmetric oligoarthritis (predominantly lower limbs)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rea-c2",
        "description": "Preceding symptomatic infection (urogenital or enteric) 1-4 weeks before arthritis onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rea-c3",
        "description": "Laboratory evidence of preceding triggering infection (culture, serology, PCR)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "rea-s1",
        "description": "Conjunctivitis or anterior uveitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "rea-s2",
        "description": "Urethritis or cervicitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "rea-s3",
        "description": "Enthesitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "rea-s4",
        "description": "Dactylitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "rea-s5",
        "description": "Mucocutaneous lesions (keratoderma blennorrhagica, circinate balanitis, oral ulcers)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "rea-s6",
        "description": "HLA-B27 positivity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Typical asymmetric oligoarthritis with evidence of or history of preceding infection (urogenital or enteric) within 1-4 weeks. Exclusion of other causes of arthritis.",
    "notes": "Common triggering organisms: Chlamydia trachomatis, Salmonella, Shigella, Yersinia, Campylobacter. The classic triad of arthritis + urethritis + conjunctivitis occurs in only a minority of patients."
  },
