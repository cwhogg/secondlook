  "keyFindings": {
    "laboratory": [
      "Normal or mildly elevated serum creatine kinase (CK) levels"
    ],
    "imaging": [
      "Muscle MRI may show mild fatty infiltration or edema in affected muscles"
    ],
    "genetic": [
      "Mutations in CAV3 gene (encoding caveolin-3) commonly identified"
    ],
    "other": [
      "Electromyography showing myopathic changes without myotonia",
      "Muscle biopsy may show nonspecific myopathic features"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "myotonia-congenita",
      "distinguishingFeatures": [
        "Presence of myotonia on EMG",
        "Absence of visible muscle rippling",
        "Different genetic mutations (CLCN1 gene)"
      ]
    },
    {
      "diseaseId": "paramyotonia-congenita",
      "distinguishingFeatures": [
        "Cold-induced muscle stiffness",
        "Myotonia worsens with repeated activity",
        "Mutations in SCN4A gene"
      ]
    },
    {
      "diseaseId": "fascioscapulohumeral-muscular-dystrophy",
      "distinguishingFeatures": [
        "Progressive muscle weakness without rippling",
        "Characteristic facial and scapular muscle involvement",
        "Genetic deletion on chromosome 4q35"
      ]
    }
  ],
  "redFlags": [
