  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnosis of Distal 17p13.1 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of a microdeletion involving the distal 17p13.1 region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability presenting in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial features including microcephaly, prominent forehead, and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-abnormalities",
        "description": "Hypotonia and/or seizures",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of distal 17p13.1 microdeletion plus at least one major clinical feature such as developmental delay or craniofacial dysmorphism",
    "notes": "Diagnosis relies heavily on genetic testing due to phenotypic overlap with other microdeletion syndromes."
  },
