  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Chylomicronemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "fasting-chylomicronemia",
        "description": "Presence of fasting chylomicronemia with triglyceride levels >2000 mg/dL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lipoprotein-lipase-deficiency",
        "description": "Demonstration of lipoprotein lipase deficiency or pathogenic mutations in LPL or related genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-pancreatitis",
        "description": "History of recurrent episodes of acute pancreatitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-secondary-causes",
        "description": "Exclusion of secondary causes of hypertriglyceridemia (e.g., diabetes, alcohol use)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "lipemic-serum",
        "description": "Lipemic (milky) appearance of serum on fasting blood samples",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of fasting chylomicronemia with triglycerides >2000 mg/dL, confirmed lipoprotein lipase deficiency or pathogenic mutation, and history of recurrent pancreatitis",
    "notes": "Genetic testing is recommended to confirm diagnosis and differentiate from other hyperlipoproteinemias."
  },
