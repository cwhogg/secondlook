  "keyFindings": {
    "laboratory": [
      "Elevated homogentisic acid in urine detected by chromatography or spectrophotometry",
      "Urine darkens on standing due to oxidation of homogentisic acid"
    ],
    "imaging": [
      "Calcification and narrowing of intervertebral discs on spinal X-rays",
      "Degenerative changes in large joints on radiographs",
      "Cardiac valve calcification on echocardiogram or CT"
    ],
    "genetic": [
      "Pathogenic variants in the HGD gene identified by molecular genetic testing"
    ],
    "other": [
      "Histopathological demonstration of ochronotic pigment in connective tissues"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ochronosis-secondary",
      "distinguishingFeatures": [
        "Pigmentation due to exogenous ochronosis (e.g., hydroquinone exposure)",
        "No homogentisic aciduria",
        "Lack of systemic involvement"
      ]
    },
    {
      "diseaseId": "juvenile-osteoarthritis",
      "distinguishingFeatures": [
        "Absence of urine darkening",
        "No ochronotic pigmentation",
        "Different genetic and clinical profile"
      ]
    }
  ],
