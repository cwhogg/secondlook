  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for HNF1A-related Hyperinsulinism",
    "criteria": [
      {
        "id": "persistent-hypoglycemia",
        "description": "Documented persistent hypoglycemia with inappropriately elevated insulin levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hnf1a-pathogenic-variant",
        "description": "Identification of a pathogenic or likely pathogenic variant in the HNF1A gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of hyperinsulinism such as mutations in ABCC8, KCNJ11, or GLUD1",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of maturity-onset diabetes of the young (MODY) or hyperinsulinism",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-medical-therapy",
        "description": "Clinical response to diazoxide or other medical therapies targeting insulin secretion",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent hypoglycemia with elevated insulin and identification of a pathogenic HNF1A variant, with exclusion of other hyperinsulinism causes",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical presentation may overlap with other forms of congenital hyperinsulinism."
  },
