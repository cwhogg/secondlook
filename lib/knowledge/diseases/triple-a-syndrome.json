  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Triad Diagnostic Criteria for Triple A Syndrome",
    "criteria": [
      {
        "id": "achalasia",
        "description": "Presence of esophageal achalasia confirmed by manometry or radiographic studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alacrima",
        "description": "Documented absence or severe reduction of tear production (alacrima)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "adrenal-insufficiency",
        "description": "Evidence of primary adrenal insufficiency with elevated ACTH and low cortisol",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-features",
        "description": "Presence of neurological abnormalities such as peripheral neuropathy or autonomic dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the AAAS gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of the clinical triad of achalasia, alacrima, and primary adrenal insufficiency",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical triad is present"
  },
