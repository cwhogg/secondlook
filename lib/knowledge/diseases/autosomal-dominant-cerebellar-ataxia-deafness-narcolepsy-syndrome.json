  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Autosomal Dominant Cerebellar Ataxia-Deafness-Narcolepsy Syndrome",
    "criteria": [
      {
        "id": "cerebellar-ataxia",
        "description": "Progressive cerebellar ataxia evidenced by gait disturbance and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-deafness",
        "description": "Bilateral sensorineural hearing loss confirmed by audiometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "narcolepsy",
        "description": "Excessive daytime sleepiness with documented narcolepsy features including cataplexy or sleep-onset REM periods",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variant in associated gene (e.g., DNMT1 mutations)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: progressive cerebellar ataxia, bilateral sensorineural deafness, and narcolepsy",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical criteria are met"
  },
