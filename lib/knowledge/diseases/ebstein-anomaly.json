  "diagnosticCriteria": {
    "formalCriteriaName": "Echocardiographic Diagnostic Criteria for Ebstein Anomaly",
    "criteria": [
      {
        "id": "apical-displacement",
        "description": "Apical displacement of the septal and posterior leaflets of the tricuspid valve by >8 mm/m² body surface area",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "atrialization-rv",
        "description": "Atrialization of a portion of the right ventricle due to abnormal tricuspid valve insertion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tricuspid-regurgitation",
        "description": "Presence of tricuspid valve regurgitation on Doppler echocardiography",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "right-atrial-enlargement",
        "description": "Right atrial enlargement evident on imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of apical displacement of tricuspid valve leaflets and atrialization of right ventricle confirmed by echocardiography",
    "notes": "Diagnosis is primarily based on echocardiographic findings; cardiac MRI may be used for further anatomical detail."
  },
