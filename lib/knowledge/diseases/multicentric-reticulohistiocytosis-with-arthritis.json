  "keyFindings": {
    "laboratory": [
      "Negative rheumatoid factor and anti-CCP antibodies",
      "Elevated ESR and CRP",
      "Mild anemia of chronic disease"
    ],
    "imaging": [
      "X-rays showing symmetric joint erosions and joint space narrowing, especially in distal interphalangeal joints",
      "MRI may show synovial inflammation and erosions"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin or synovial biopsy demonstrating multinucleated giant cells with ground-glass eosinophilic cytoplasm"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "rheumatoid-arthritis",
      "distinguishingFeatures": [
        "Positive rheumatoid factor and anti-CCP antibodies",
        "Predominantly affects proximal interphalangeal and metacarpophalangeal joints",
        "Absence of characteristic papulonodular skin lesions"
      ]
    },
    {
      "diseaseId": "dermatofibroma",
      "distinguishingFeatures": [
        "Localized skin nodules without systemic arthritis",
        "Histopathology lacking multinucleated giant cells typical of MRH"
      ]
    },
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "Presence of ANA and other autoantibodies",
        "Multisystem involvement with characteristic malar rash",
        "Non-erosive arthritis"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive erosive arthritis leading to joint destruction",
    "Development of systemic symptoms such as unexplained fever and weight loss",
    "Presence of pulmonary or ocular involvement indicating systemic spread"
  ],
  "specialistType": [
    "Rheumatologist",
