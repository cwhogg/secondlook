  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Sporadic Infantile Bilateral Striatal Necrosis",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive extrapyramidal movement disorder presenting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Bilateral necrosis of the striatum demonstrated on brain MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of metabolic, infectious, and genetic causes through laboratory and genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-laboratory",
        "description": "Elevated lactate or other metabolic abnormalities in some cases",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive extrapyramidal symptoms in infancy combined with characteristic bilateral striatal necrosis on MRI and exclusion of other known causes",
    "notes": "Diagnosis is primarily clinical and radiological; genetic testing may be used to exclude inherited conditions."
  },
