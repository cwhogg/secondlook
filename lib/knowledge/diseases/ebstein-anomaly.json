  "keyFindings": {
    "laboratory": [
      "Elevated brain natriuretic peptide (BNP) in heart failure",
      "Hypoxemia on arterial blood gas if cyanosis present"
    ],
    "imaging": [
      "Echocardiography showing apical displacement of tricuspid valve leaflets and atrialized right ventricle",
      "Cardiac MRI for detailed anatomical assessment",
      "Chest X-ray showing cardiomegaly and right atrial enlargement"
    ],
    "genetic": [
      "No specific gene identified; sporadic cases predominate",
      "Rare familial cases reported"
    ],
