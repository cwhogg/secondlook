  "diagnosticCriteria": {
    "formalCriteriaName": "No formal standardized criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Chronic monoarticular joint swelling and pain",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "MRI showing synovial hypertrophy with low signal intensity on T2-weighted images due to hemosiderin deposition",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Synovial biopsy demonstrating villous or nodular proliferation with hemosiderin-laden macrophages and multinucleated giant cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-conditions",
        "description": "Exclusion of other causes of monoarthritis such as infection or malignancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical presentation plus confirmatory imaging and histopathology",
    "notes": "Diagnosis is primarily based on clinical suspicion supported by imaging and confirmed by biopsy."
  },
