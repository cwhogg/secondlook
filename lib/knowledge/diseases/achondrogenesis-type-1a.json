  "diagnosticCriteria": {
    "formalCriteriaName": "Achondrogenesis type 1A diagnostic criteria",
    "criteria": [
      {
        "id": "skeletal-dysplasia",
        "description": "Severe micromelic dwarfism with extremely short limbs and narrow thorax",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-features",
        "description": "Absent or severely delayed ossification of vertebral bodies and pelvis on prenatal or neonatal imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the TRIP11 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "respiratory-distress",
        "description": "Respiratory insufficiency due to small thoracic cage",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic skeletal dysplasia and radiological features plus genetic confirmation or consistent clinical presentation with radiological findings",
    "notes": "Diagnosis is often made prenatally or at birth due to lethality and characteristic features."
  },
