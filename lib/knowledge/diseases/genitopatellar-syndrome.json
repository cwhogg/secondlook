  "diagnosticCriteria": {
    "formalCriteriaName": "Genitopatellar Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "patellar-hypoplasia",
        "description": "Congenital absence or hypoplasia of the patellae",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genitourinary-anomalies",
        "description": "Genitourinary malformations including cryptorchidism or hypoplastic genitalia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-impairment",
        "description": "Severe developmental delay or intellectual disability with hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "flexion-contractures",
        "description": "Flexion contractures of large joints, especially knees and hips",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "microcephaly",
        "description": "Microcephaly or other craniofacial dysmorphisms",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: patellar hypoplasia or aplasia, genitourinary anomalies, and neurological impairment",
    "notes": "Diagnosis is clinical and supported by genetic testing for KAT6B mutations"
  },
