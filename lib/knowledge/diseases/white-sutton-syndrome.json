      "Occasional hypothyroidism on thyroid function tests"
    ],
    "imaging": [
      "Brain MRI may show corpus callosum hypoplasia or nonspecific white matter changes",
      "Echocardiogram may reveal congenital heart defects"
    ],
    "genetic": [
      "POGZ (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Neurodevelopmental assessments confirming intellectual disability and developmental delay",
      "Behavioral evaluations for autism spectrum disorder and ADHD"
    ]
  },
