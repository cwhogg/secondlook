  "diagnosticCriteria": {
    "formalCriteriaName": "FAHN Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the FA2H gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-mri-findings",
        "description": "Characteristic MRI findings including iron accumulation in the globus pallidus and substantia nigra",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Progressive spasticity, dystonia, and cerebellar ataxia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-nbias",
        "description": "Exclusion of other neurodegenerative disorders with brain iron accumulation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic FA2H gene variants plus characteristic clinical features and supportive MRI findings",
    "notes": "Genetic testing is essential for definitive diagnosis; MRI findings aid in clinical suspicion."
  },
