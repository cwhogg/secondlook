  "keyFindings": {
    "laboratory": [
      "Profound T-cell lymphopenia (CD3+ cells <300/µL)",
      "Absent or severely reduced B cells (CD19+ cells)",
      "Hypogammaglobulinemia",
      "Impaired lymphocyte proliferation to mitogens",
      "Elevated serum IgM in some cases"
    ],
    "imaging": [
      "Chest X-ray showing pneumonia or absent thymic shadow"
    ],
    "genetic": [
      "CD3D (causative)",
      "CD3E (causative)",
      "CD247 (causative)",
      "Autosomal recessive inheritance"
    ],
