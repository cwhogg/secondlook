  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Chronic Intestinal Pseudo-Obstruction",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Recurrent symptoms of intestinal obstruction without mechanical cause",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-evidence",
        "description": "Imaging showing dilated bowel loops with air-fluid levels without mechanical obstruction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "manometric-abnormalities",
        "description": "Abnormal intestinal motility demonstrated by manometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "secondary-cause-identification",
        "description": "Identification of underlying systemic or metabolic disorder causing dysmotility",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent obstructive symptoms without mechanical cause plus radiologic evidence and abnormal motility studies",
    "notes": "Exclusion of mechanical obstruction is mandatory; secondary causes must be investigated."
  },
