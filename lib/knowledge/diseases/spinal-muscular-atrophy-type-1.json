  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for SMA",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Onset of severe hypotonia and muscle weakness before 6 months of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Homozygous deletion or mutation of SMN1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electromyography showing denervation and reduced motor unit potentials",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing grouped atrophy of anterior horn cell denervation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation consistent with SMA type 1 plus genetic confirmation of SMN1 mutation",
    "notes": "Electrophysiology and muscle biopsy support diagnosis but are not mandatory if genetic testing is confirmatory."
  },
