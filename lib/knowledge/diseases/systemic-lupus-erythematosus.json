  "keyFindings": {
    "laboratory": [
      "ANA positive (>95% sensitivity)",
      "Anti-dsDNA antibodies (60-70%, high specificity)",
      "Anti-Smith antibodies (30%, high specificity)",
      "Low C3 and/or C4 complement levels",
      "Cytopenias (leukopenia, lymphopenia, thrombocytopenia, hemolytic anemia)",
      "Elevated ESR with often normal CRP",
      "Anti-RNP, anti-Ro/SSA, anti-La/SSB antibodies",
      "Positive direct Coombs test",
      "Urinalysis showing proteinuria, hematuria, cellular casts"
    ],
    "imaging": [
      "Chest X-ray: pleural effusion, pericardial effusion",
      "Echocardiography: pericardial effusion, Libman-Sacks vegetations",
      "MRI brain: white matter lesions in neuropsychiatric lupus",
      "Renal ultrasound: increased echogenicity in lupus nephritis"
    ],
    "genetic": [
      "HLA-DR2 and HLA-DR3 associations",
      "Complement deficiencies (C1q, C2, C4) increase risk",
      "IRF5, STAT4, ITGAM polymorphisms"
    ],
    "other": [
      "Renal biopsy: ISN/RPS classification of lupus nephritis (Class I-VI)",
      "Skin biopsy: interface dermatitis, granular IgG/IgM/C3 at dermal-epidermal junction (lupus band test)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sjogren-syndrome",
      "distinguishingFeatures": [
        "Sicca symptoms predominate in Sjogren",
        "Anti-Ro/La more prominent",
        "Less renal involvement"
      ]
    },
    {
      "diseaseId": "rheumatoid-arthritis",
      "distinguishingFeatures": [
        "Erosive arthritis in RA",
        "No malar rash",
        "RF and anti-CCP positive"
      ]
    },
    {
      "diseaseId": "antiphospholipid-syndrome",
      "distinguishingFeatures": [
        "Thrombosis predominates",
        "Lupus anticoagulant/aCL/anti-beta2GP1",
        "Can coexist with SLE"
      ]
    },
    {
      "diseaseId": "mixed-connective-tissue-disease",
      "distinguishingFeatures": [
        "High titer anti-U1 RNP",
        "Overlapping features of SLE, scleroderma, polymyositis"
      ]
    },
    {
      "diseaseId": "drug-induced-lupus",
      "distinguishingFeatures": [
        "Temporal relationship with offending drug",
        "Anti-histone antibodies",
        "Resolves on drug withdrawal"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive glomerulonephritis",
    "New-onset seizures or psychosis",
    "Pulmonary hemorrhage",
    "Severe thrombocytopenia (<50,000)",
    "Hemolytic anemia with reticulocytosis",
    "Acute abdominal pain suggesting mesenteric vasculitis"
  ],
