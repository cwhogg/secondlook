      "Cleft palate/lip visible on craniofacial imaging",
      "Possible lacrimal duct obstruction on dacryocystography"
    ],
    "genetic": [
      "Heterozygous mutations in TP63 gene",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology of scalp erosions showing epidermal dysplasia",
      "Clinical ophthalmological examination confirming ankyloblepharon"
    ]
  },
