  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Informal Working Group on Echinococcosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "imaging-cystic-lesion",
        "description": "Identification of characteristic cystic lesions on ultrasound or CT scan",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serology-positive",
        "description": "Positive serological tests for Echinococcus antibodies (ELISA, indirect hemagglutination)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epidemiological-exposure",
        "description": "History of exposure to endemic areas or contact with definitive hosts (dogs, canids)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Histopathological confirmation of hydatid cyst material after biopsy or surgery",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic cystic lesions on imaging plus positive serology or histopathological confirmation",
    "notes": "Biopsy is generally avoided due to risk of cyst rupture and anaphylaxis"
  },
