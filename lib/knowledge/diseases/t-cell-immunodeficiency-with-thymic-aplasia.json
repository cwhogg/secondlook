  "diagnosticCriteria": {
    "formalCriteriaName": "Immunodeficiency Diagnostic Criteria for Thymic Aplasia",
    "criteria": [
      {
        "id": "thymic-aplasia",
        "description": "Absence or severe hypoplasia of the thymus confirmed by imaging or biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "t-cell-lymphopenia",
        "description": "Marked reduction in circulating CD3+ T lymphocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-t-cell-function",
        "description": "Demonstrated impaired T-cell proliferative response to mitogens",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypocalcemia",
        "description": "Hypocalcemia due to parathyroid hypoplasia or aplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "22q11-deletion",
        "description": "Presence of 22q11.2 microdeletion (if applicable)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of thymic aplasia or hypoplasia plus marked T-cell lymphopenia and impaired T-cell function",
    "notes": "Genetic testing for 22q11.2 deletion syndrome may support diagnosis but is not mandatory."
  },
