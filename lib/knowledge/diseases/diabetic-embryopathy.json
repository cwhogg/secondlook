  "keyFindings": {
    "laboratory": [
      "Maternal hyperglycemia documented during early pregnancy",
      "Neonatal hypoglycemia in some cases"
    ],
    "imaging": [
      "Prenatal ultrasound showing congenital malformations",
      "Postnatal MRI or CT confirming neural tube defects and skeletal anomalies",
      "Echocardiography revealing cardiac defects"
    ],
    "genetic": [
      "No specific genetic mutation identified; genetic testing used to exclude other syndromes"
    ],
    "other": [
      "Detailed maternal history of diabetes and glycemic control",
      "Physical examination revealing characteristic malformations"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "caudal-regression-syndrome",
      "distinguishingFeatures": [
        "May occur independently of maternal diabetes",
        "Primarily involves sacral and lower spinal anomalies without other systemic malformations"
      ]
    },
    {
      "diseaseId": "neural-tube-defect-syndromes",
      "distinguishingFeatures": [
        "Genetic or environmental causes other than maternal diabetes",
        "May lack associated cardiac or renal anomalies"
      ]
    }
  ],
  "redFlags": [
    "Poorly controlled maternal diabetes during first trimester",
    "Presence of multiple congenital malformations in neonate",
    "Neonatal hypoglycemia or respiratory distress"
  ],
