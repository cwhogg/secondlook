    ],
    "imaging": [
      "Brain MRI may show corpus callosum agenesis or hypoplasia",
      "Abdominal imaging for Hirschsprung disease (contrast enema)"
    ],
    "genetic": [
      "ZEB2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Characteristic facial gestalt observed clinically",
      "Developmental assessment confirming intellectual disability"
    ]
  },
