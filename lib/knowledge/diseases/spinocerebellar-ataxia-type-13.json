  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Spinocerebellar Ataxias",
    "criteria": [
      {
        "id": "progressive-cerebellar-ataxia",
        "description": "Progressive cerebellar ataxia manifesting as gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "kcng1-gene-mutation",
        "description": "Pathogenic mutation in the KCNG1 gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-ataxia-causes",
        "description": "Exclusion of other acquired or genetic causes of ataxia",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "cognitive-impairment",
        "description": "Presence of mild cognitive impairment or developmental delay (variable)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive cerebellar ataxia plus pathogenic KCNG1 mutation with exclusion of other causes",
    "notes": "Genetic confirmation is essential for definitive diagnosis."
  },
