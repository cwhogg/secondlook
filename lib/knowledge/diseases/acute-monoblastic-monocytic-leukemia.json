  "keyFindings": {
    "laboratory": [
      "Peripheral blood smear showing >20% monoblasts and promonocytes",
      "Anemia, thrombocytopenia, and leukocytosis or leukopenia on CBC",
      "Elevated lactate dehydrogenase (LDH)"
    ],
    "imaging": [
      "Chest X-ray may show leukostasis-related pulmonary infiltrates",
      "CT or MRI for CNS involvement assessment"
    ],
    "genetic": [
      "t(9;11)(p22;q23) MLL gene rearrangement",
      "Other cytogenetic abnormalities involving 11q23"
    ],
    "other": [
      "Bone marrow biopsy confirming monocytic lineage proliferation",
      "Immunophenotyping positive for CD14, CD64, CD11b, CD33"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "acute-myeloid-leukemia-other-subtypes",
