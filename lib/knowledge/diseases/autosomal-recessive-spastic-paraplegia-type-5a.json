  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for SPG5A",
    "criteria": [
      {
        "id": "progressive-spasticity",
        "description": "Progressive lower limb spasticity and weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "corticospinal-tract-signs",
        "description": "Signs of corticospinal tract involvement including hyperreflexia and extensor plantar responses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cyp7b1-mutation",
        "description": "Biallelic pathogenic variants in the CYP7B1 gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-brain-mri",
        "description": "Brain MRI showing no significant abnormalities except possible mild spinal cord atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-oxysterols",
        "description": "Elevated levels of 27-hydroxycholesterol in plasma or CSF",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive lower limb spasticity with corticospinal tract signs plus identification of biallelic pathogenic CYP7B1 mutations",
    "notes": "Genetic confirmation is essential due to phenotypic overlap with other hereditary spastic paraplegias."
  },
