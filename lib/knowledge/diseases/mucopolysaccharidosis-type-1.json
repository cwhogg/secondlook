  "diagnosticCriteria": {
    "formalCriteriaName": "MPS I Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of alpha-L-iduronidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-gags",
        "description": "Elevated urinary glycosaminoglycans (dermatan sulfate and heparan sulfate)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the IDUA gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features such as coarse facial features, corneal clouding, and hepatosplenomegaly",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of alpha-L-iduronidase enzyme activity plus elevated urinary glycosaminoglycans; genetic confirmation supportive",
    "notes": "Early diagnosis is critical for treatment options such as enzyme replacement therapy or hematopoietic stem cell transplantation."
  },
