  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Digestive System Neuroendocrine Neoplasms",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histological confirmation of neuroendocrine tumor cells in colonic tissue biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Positive immunohistochemical staining for neuroendocrine markers such as chromogranin A and synaptophysin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Radiologic evidence of a colonic mass consistent with neuroendocrine tumor on CT or MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "biochemical",
        "description": "Elevated serum chromogranin A or 5-HIAA levels supporting neuroendocrine activity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation with positive immunohistochemical staining for neuroendocrine markers",
    "notes": "Grading and staging according to WHO criteria are essential for prognosis and treatment planning."
  },
