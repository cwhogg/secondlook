  "diagnosticCriteria": {
    "formalCriteriaName": "Hyperekplexia Diagnostic Criteria",
    "criteria": [
      {
        "id": "exaggerated-startle",
        "description": "Presence of an exaggerated startle response to unexpected stimuli",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neonatal-stiffness",
        "description": "Generalized neonatal hypertonia or stiffness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glycine-receptor-mutation",
        "description": "Identification of pathogenic mutation in glycine receptor genes (e.g., GLRA1)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-neurological-signs",
        "description": "Lack of progressive neurological deterioration or other neurological deficits",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of exaggerated startle response and neonatal stiffness with or without genetic confirmation",
    "notes": "Genetic testing supports diagnosis but is not mandatory; clinical presentation is key."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Exaggerated startle response to unexpected stimuli",
        "frequency": 0.95,
        "bodySystem": "neurological",
        "notes": "Triggered by tactile, auditory, or visual stimuli"
      },
      {
        "symptomName": "Neonatal generalized hypertonia (stiffness)",
        "frequency": 0.9,
        "bodySystem": "musculoskeletal",
        "notes": "Often present from birth"
      },
      {
        "symptomName": "Brief generalized tonic stiffening following startle",
        "frequency": 0.85,
        "bodySystem": "neurological",
        "notes": "May cause falls or apnea in infants"
      }
    ],
    "common": [
      {
        "symptomName": "Apnea episodes triggered by startle",
        "frequency": 0.7,
        "bodySystem": "respiratory",
        "notes": "Particularly in neonates"
      },
      {
        "symptomName": "Hypertonia persisting beyond neonatal period",
        "frequency": 0.65,
        "bodySystem": "musculoskeletal",
        "notes": "May improve with age"
      },
      {
        "symptomName": "Delayed motor milestones",
        "frequency": 0.6,
        "bodySystem": "neurological",
        "notes": "Mild developmental delay possible"
      },
      {
        "symptomName": "Falls due to startle-induced stiffening",
        "frequency": 0.55,
        "bodySystem": "musculoskeletal",
        "notes": "Common in childhood"
      }
    ],
    "occasional": [
      {
        "symptomName": "Sleep disturbances",
        "frequency": 0.4,
        "bodySystem": "psychiatric",
        "notes": "Secondary to frequent startle episodes"
      },
      {
        "symptomName": "Anxiety related to startle episodes",
        "frequency": 0.3,
        "bodySystem": "psychiatric",
        "notes": "May develop in older children or adults"
      },
      {
        "symptomName": "Mild intellectual disability",
        "frequency": 0.2,
        "bodySystem": "neurological",
        "notes": "Rare and usually mild"
      },
      {
        "symptomName": "Muscle spasms unrelated to startle",
        "frequency": 0.15,
        "bodySystem": "musculoskeletal",
        "notes": "Occasional"
      }
    ],
    "rare": [
      {
        "symptomName": "Seizures",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Rarely reported"
      },
      {
        "symptomName": "Hearing impairment",
        "frequency": 0.03,
        "bodySystem": "otolaryngological",
        "notes": "Very rare association"
      },
      {
        "symptomName": "Cardiac arrhythmias during severe startle",
        "frequency": 0.02,
        "bodySystem": "cardiovascular",
        "notes": "Extremely rare"
      }
    ]
  },
  "systemsAffected": [
    "neurological",
    "musculoskeletal",
    "respiratory",
    "psychiatric",
    "otolaryngological",
    "cardiovascular"
  ],
  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Electromyography showing exaggerated reflex responses"
    ],
    "imaging": [
      "Normal brain MRI",
      "No structural abnormalities"
    ],
    "genetic": [
      "Mutations in GLRA1 gene (glycine receptor alpha 1 subunit)",
      "Mutations in GLRB or SLC6A5 genes in some cases"
    ],
    "other": [
      "Electrophysiological studies showing abnormal startle reflex",
      "Response to clonazepam treatment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "startle-epilepsy",
      "distinguishingFeatures": [
        "Presence of epileptiform activity on EEG",
        "Seizure semiology different from startle-induced stiffening"
      ]
    },
    {
      "diseaseId": "stiff-person-syndrome",
      "distinguishingFeatures": [
        "Progressive muscle rigidity",
        "Presence of anti-GAD antibodies",
        "Adult onset"
      ]
    },
    {
      "diseaseId": "neonatal-seizures",
      "distinguishingFeatures": [
        "Electrographic seizures on EEG",
        "Lack of exaggerated startle reflex pattern"
      ]
    }
  ],
  "redFlags": [
    "Apnea causing cyanosis or respiratory distress",
    "Progressive neurological deterioration",
    "Seizures or loss of consciousness unrelated to startle"
  ],
  "specialistType": [
    "Neurologist",
