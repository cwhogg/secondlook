  "diagnosticCriteria": {
    "formalCriteriaName": "No formal diagnostic criteria established",
    "criteria": [
      {
        "id": "biochemical-glycosylation-defect",
        "description": "Demonstration of defective N-linked glycosylation pattern on serum transferrin analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic biallelic variants in the DPM1 gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features including developmental delay, hypotonia, and seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-activity",
        "description": "Reduced dolichol-phosphate mannose synthase enzyme activity in fibroblasts or leukocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus biochemical evidence of glycosylation defect and confirmation of pathogenic DPM1 variants",
    "notes": "Diagnosis relies heavily on molecular genetic testing combined with biochemical and clinical findings."
  },
