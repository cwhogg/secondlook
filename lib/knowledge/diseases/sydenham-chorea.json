  "diagnosticCriteria": {
    "formalCriteriaName": "Revised Jones Criteria (for rheumatic fever)",
    "criteria": [
      {
        "id": "chorea",
        "description": "Presence of choreiform movements characterized by rapid, irregular, involuntary muscle contractions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "evidence-of-streptococcal-infection",
        "description": "Recent group A beta-hemolytic streptococcal infection confirmed by positive throat culture or elevated antistreptolysin O titers",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "carditis",
        "description": "Clinical or echocardiographic evidence of rheumatic carditis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "other-major-criteria",
        "description": "Other major Jones criteria such as polyarthritis, erythema marginatum, or subcutaneous nodules",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chorea plus evidence of preceding streptococcal infection; other major or minor Jones criteria may support diagnosis",
    "notes": "Diagnosis is clinical and supported by laboratory evidence of prior streptococcal infection; exclusion of other causes of chorea is essential"
  },
