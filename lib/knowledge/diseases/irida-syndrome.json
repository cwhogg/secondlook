  "diagnosticCriteria": {
    "formalCriteriaName": "IRIDA Diagnostic Criteria",
    "criteria": [
      {
        "id": "microcytic-hypochromic-anemia",
        "description": "Presence of microcytic hypochromic anemia unresponsive to oral iron therapy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-transferrin-saturation",
        "description": "Low transferrin saturation despite normal or elevated ferritin levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biallelic-tmprss6-mutations",
        "description": "Identification of biallelic pathogenic variants in the TMPRSS6 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lack-of-response-to-oral-iron",
        "description": "Failure to improve anemia after prolonged oral iron supplementation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-inflammatory-markers",
        "description": "Absence of inflammation or chronic disease markers to explain anemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microcytic hypochromic anemia refractory to oral iron, low transferrin saturation with normal/elevated ferritin, and biallelic TMPRSS6 mutations",
    "notes": "Genetic testing is essential for definitive diagnosis; exclusion of other causes of iron deficiency anemia is required."
  },
