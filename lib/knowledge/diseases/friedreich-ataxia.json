  "demographics": {
    "typicalOnsetAge": {
      "min": 2,
      "max": 18,
      "peak": 14
    },
    "sexPredilection": "equal",
    "ethnicAssociations": [
      "Most common in populations of European descent",
      "Carrier frequency ~1 in 100 in Europeans",
      "Very rare in East Asian, Sub-Saharan African, and Native American populations"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Criteria",
    "criteria": [
      {
        "id": "fa-1",
        "description": "Progressive gait and limb ataxia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fa-2",
        "description": "Absent lower limb deep tendon reflexes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fa-3",
        "description": "Onset before age 25 (classic form)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "fa-4",
        "description": "Homozygous GAA trinucleotide repeat expansion in FXN gene (typically 66-1700 repeats; normal <33)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "fa-5",
        "description": "Axonal sensory neuropathy on nerve conduction studies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "fa-6",
        "description": "Dysarthria",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive ataxia with areflexia and confirmatory homozygous GAA expansion in FXN gene. ~96% are homozygous for GAA expansion; ~4% are compound heterozygous (GAA expansion + point mutation).",
    "notes": "Late-onset Friedreich ataxia (LOFA, onset >25 years) and very late-onset (VLOFA, onset >40 years) are recognized with slower progression. GAA repeat length inversely correlates with onset age. Frataxin protein deficiency causes mitochondrial iron accumulation."
  },
