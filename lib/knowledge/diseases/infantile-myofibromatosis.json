  "keyFindings": {
    "laboratory": [
      "Non-specific anemia in some cases",
      "Normal inflammatory markers unless secondary infection"
    ],
    "imaging": [
      "Ultrasound: well-defined hypoechoic nodules",
      "MRI: well-circumscribed soft tissue masses with variable enhancement",
      "CT scan for visceral involvement assessment"
    ],
    "genetic": [
      "NOTCH3 (causative)",
      "PDGFRB (causative)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology: spindle cell proliferation with myofibroblastic differentiation and hemangiopericytoma-like vascular pattern"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "infantile-hemangioma",
      "distinguishingFeatures": [
        "Rapid postnatal growth followed by involution",
        "Positive GLUT1 immunostaining",
        "Vascular tumor rather than myofibroblastic proliferation"
      ]
    },
    {
      "diseaseId": "congenital-fibrosarcoma",
      "distinguishingFeatures": [
        "Aggressive growth with infiltrative margins",
        "Histology showing malignant spindle cells",
        "Presence of ETV6-NTRK3 gene fusion"
      ]
    }
  ],
  "redFlags": [
    "Rapid enlargement of lesions suggesting malignant transformation",
    "Respiratory distress indicating visceral involvement",
    "Neurological deficits indicating central nervous system involvement"
  ],
