  "keyFindings": {
    "laboratory": [
      "Schistocytes on peripheral blood smear",
      "Elevated lactate dehydrogenase (LDH)",
      "Low haptoglobin",
      "Thrombocytopenia",
      "Elevated creatinine and blood urea nitrogen (BUN)",
      "Normal coagulation profile"
    ],
    "imaging": [
      "Renal ultrasound may show normal or enlarged kidneys",
      "Brain MRI may reveal ischemic lesions in severe neurological involvement"
    ],
    "genetic": [
      "Mutations in complement regulatory genes (e.g., CFH, CFI) in atypical hemolytic uremic syndrome (aHUS)"
    ],
    "other": [
      "ADAMTS13 activity assay to differentiate thrombotic thrombocytopenic purpura (TTP) from other TMAs"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "disseminated-intravascular-coagulation",
      "distinguishingFeatures": [
        "Abnormal coagulation tests (prolonged PT, aPTT)",
        "Widespread bleeding tendency",
        "Underlying sepsis or trauma"
      ]
    },
    {
      "diseaseId": "immune-thrombocytopenic-purpura",
      "distinguishingFeatures": [
        "Isolated thrombocytopenia without hemolytic anemia",
        "Absence of schistocytes",
        "Normal renal function"
      ]
    },
    {
      "diseaseId": "hemolytic-uremic-syndrome",
      "distinguishingFeatures": [
        "Often preceded by diarrheal illness (especially E. coli O157:H7)",
        "Predominantly affects children",
        "Less neurological involvement compared to TTP"
      ]
    }
  ],
