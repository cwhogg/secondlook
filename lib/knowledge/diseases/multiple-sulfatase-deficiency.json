  "diagnosticCriteria": {
    "formalCriteriaName": "Multiple Sulfatase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of multiple sulfatase enzyme activities in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of combined clinical features of mucopolysaccharidosis and metachromatic leukodystrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the SUMF1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-findings",
        "description": "Characteristic radiologic findings including dysostosis multiplex and leukodystrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of multiple sulfatase activities plus clinical features consistent with MSD and confirmation by SUMF1 mutation analysis",
    "notes": "Diagnosis requires integration of biochemical, clinical, and genetic data."
  },
