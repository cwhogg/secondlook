  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for 2q23.1 Microduplication Syndrome",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of a microduplication involving the 2q23.1 chromosomal region confirmed by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Neonatal or early childhood hypotonia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-features",
        "description": "Presence of autistic features or behavioral abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including broad nasal bridge and prominent forehead",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 2q23.1 microduplication plus at least one major clinical feature such as developmental delay or hypotonia",
    "notes": "Diagnosis relies heavily on genetic testing; clinical features are variable and may overlap with other neurodevelopmental disorders."
  },
