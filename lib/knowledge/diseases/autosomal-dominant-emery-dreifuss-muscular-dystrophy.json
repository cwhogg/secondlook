  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate elevation)"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle atrophy and fatty replacement",
      "Echocardiography demonstrating dilated cardiomyopathy or structural abnormalities"
    ],
    "genetic": [
      "LMNA (causative)",
      "SYNE1 (causative)",
      "TMEM43 (causative)",
      "SYNE2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
