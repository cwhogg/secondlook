  "differentialDiagnoses": [
    {
      "diseaseId": "central-core-disease",
      "distinguishingFeatures": [
        "Presence of central cores on muscle biopsy instead of nemaline rods",
        "Usually caused by RYR1 mutations",
        "Different muscle involvement pattern on MRI"
      ]
    },
    {
      "diseaseId": "myotubular-myopathy",
      "distinguishingFeatures": [
        "Muscle biopsy shows centrally placed nuclei rather than nemaline rods",
        "Often X-linked inheritance",
        "More severe neonatal hypotonia and respiratory failure"
      ]
    },
    {
      "diseaseId": "congenital muscular dystrophy",
      "distinguishingFeatures": [
        "Muscle biopsy shows dystrophic changes rather than nemaline rods",
        "Often associated with brain and eye abnormalities",
        "Different genetic mutations (e.g., LAMA2)"
      ]
    }
  ],
