  "diagnosticCriteria": {
    "formalCriteriaName": "Freeman-Sheldon Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic 'whistling face' with pursed lips and microstomia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multiple-joint-contractures",
        "description": "Congenital contractures involving multiple joints, especially distal limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-deformities",
        "description": "Camptodactyly, ulnar deviation of fingers, and talipes equinovarus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development despite physical deformities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history or confirmed pathogenic MYH3 mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic facial dysmorphism (whistling face) plus multiple congenital joint contractures",
    "notes": "Genetic testing for MYH3 mutations can confirm diagnosis"
  },
