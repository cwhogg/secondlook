  "keyFindings": {
    "laboratory": [
      "Peripheral blood smear showing increased large granular lymphocytes",
      "Flow cytometry demonstrating CD3+, CD8+, CD57+ T-cell population",
      "T-cell receptor gene rearrangement confirming clonality",
      "Neutropenia and anemia on complete blood count"
    ],
    "imaging": [
      "Splenomegaly on abdominal ultrasound or CT scan"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Bone marrow biopsy showing infiltration by large granular lymphocytes without dysplasia"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "chronic-lymphocytic-leukemia",
      "distinguishingFeatures": [
        "Presence of CD5+ B-cell clone rather than T-cell",
        "Different immunophenotype on flow cytometry",
        "Typically no large granular lymphocyte expansion"
      ]
    },
    {
      "diseaseId": "reactive-large-granular-lymphocytosis",
      "distinguishingFeatures": [
        "Polyclonal rather than clonal T-cell expansion",
        "Transient and associated with infections or autoimmune diseases",
        "Resolves with treatment of underlying cause"
      ]
    }
  ],
  "redFlags": [
    "Severe neutropenia with recurrent bacterial infections",
    "Rapid progression of cytopenias",
    "Development of autoimmune hemolytic anemia"
  ],
