  "diagnosticCriteria": {
    "formalCriteriaName": "Distal 7q36 Deletion Diagnostic Criteria",
    "criteria": [
      {
        "id": "chromosomal-deletion",
        "description": "Confirmed deletion of the distal 7q36 region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "holoprosencephaly",
        "description": "Presence of holoprosencephaly or midline brain defects detected by neuroimaging",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial anomalies including microcephaly, cleft lip/palate, and hypotelorism",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed distal 7q36 deletion plus at least one major clinical feature such as holoprosencephaly or characteristic craniofacial dysmorphism",
    "notes": "Genetic testing is essential for diagnosis; clinical features vary depending on deletion size."
  },
