  "diagnosticCriteria": {
    "formalCriteriaName": "Chapel Hill Consensus Conference Definition and ANCA-associated Vasculitis Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Renal biopsy showing necrotizing glomerulonephritis with little or no immune complex deposition (pauci-immune pattern)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ANCA-positivity",
        "description": "Presence of anti-neutrophil cytoplasmic antibodies (ANCA), typically MPO-ANCA or PR3-ANCA",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Rapidly progressive renal impairment with active urinary sediment (hematuria, red cell casts)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-immune-complex",
        "description": "Absence of significant immune complex deposits on immunofluorescence or electron microscopy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Renal biopsy demonstrating pauci-immune necrotizing glomerulonephritis plus positive ANCA serology and clinical evidence of rapidly progressive glomerulonephritis",
    "notes": "Diagnosis requires exclusion of other causes of glomerulonephritis such as lupus nephritis or anti-GBM disease."
  },
