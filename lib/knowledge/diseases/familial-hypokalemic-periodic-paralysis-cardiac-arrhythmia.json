  "keyFindings": {
    "laboratory": [
      "Serum hypokalemia during attacks",
      "Normal to low serum potassium between attacks",
      "Elevated creatine kinase in some cases"
    ],
    "imaging": [
      "Echocardiogram may show arrhythmia-related changes",
      "Cardiac MRI may reveal fibrosis in chronic cases"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "ECG abnormalities including prolonged QT interval and ventricular ectopy",
      "Electromyography showing reduced muscle excitability during attacks"
    ]
  },
