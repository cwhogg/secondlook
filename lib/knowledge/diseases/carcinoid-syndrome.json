  "keyFindings": {
    "laboratory": [
      "Elevated 24-hour urinary 5-HIAA (>95% specificity)",
      "Elevated serum chromogranin A (nonspecific but useful for monitoring)",
      "Elevated whole blood serotonin (5-HT)",
      "Elevated plasma 5-HIAA",
      "NT-proBNP elevation if carcinoid heart disease present"
    ],
    "imaging": [
      "CT abdomen/pelvis showing primary tumor (most commonly ileal) and hepatic metastases",
      "68Ga-DOTATATE PET/CT (highest sensitivity for somatostatin receptor-positive NETs)",
      "111In-octreotide scintigraphy (OctreoScan)",
      "Echocardiography for carcinoid heart disease screening (tricuspid and pulmonary valve thickening)",
      "MRI liver for hepatic metastases characterization"
    ],
    "genetic": [
      "SDHD (candidate)"
    ],
    "other": [
      "Tumor biopsy with chromogranin A, synaptophysin, Ki-67 staining",
      "WHO grading based on Ki-67 index and mitotic rate",
      "Provocative tests (pentagastrin stimulation) rarely used now"
    ]
  },
