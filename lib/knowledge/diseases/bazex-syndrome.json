  "diagnosticCriteria": {
    "formalCriteriaName": "Bazex Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "acral-psoriasiform-dermatitis",
        "description": "Symmetrical psoriasiform hyperkeratotic lesions on acral sites (hands, feet, ears, nose)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "associated-internal-malignancy",
        "description": "Presence of an underlying internal malignancy, commonly squamous cell carcinoma of upper aerodigestive tract",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "resolution-after-tumor-treatment",
        "description": "Improvement or resolution of skin lesions following treatment of the associated malignancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nail-dystrophy",
        "description": "Nail changes including dystrophy, onycholysis, and discoloration",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-family-history",
        "description": "No personal or family history of psoriasis or other primary dermatoses",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of symmetrical acral psoriasiform dermatitis with confirmed internal malignancy",
    "notes": "Diagnosis is clinical and supported by malignancy detection; skin biopsy is nonspecific."
  },
