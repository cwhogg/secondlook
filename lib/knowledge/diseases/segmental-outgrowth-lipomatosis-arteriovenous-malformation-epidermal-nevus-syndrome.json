  "diagnosticCriteria": {
    "formalCriteriaName": "SOLAMEN Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "segmental-overgrowth",
        "description": "Presence of segmental or localized soft tissue and skeletal overgrowth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lipomatous-lesions",
        "description": "Multiple lipomatous masses or lipomatosis in affected regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "arteriovenous-malformations",
        "description": "Presence of arteriovenous malformations or vascular anomalies in affected segments",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epidermal-nevus",
        "description": "Epidermal nevus or epidermal nevus syndrome features in the involved skin",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mosaic PTEN gene mutations in affected tissues",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of segmental overgrowth with lipomatosis and arteriovenous malformations in at least one body segment; epidermal nevus and genetic confirmation supportive but not mandatory.",
    "notes": "Diagnosis is clinical supported by imaging and genetic testing; mosaicism may complicate genetic confirmation."
  },
