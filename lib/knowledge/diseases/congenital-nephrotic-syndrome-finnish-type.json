  "diagnosticCriteria": {
    "formalCriteriaName": "Congenital Nephrotic Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "proteinuria",
        "description": "Massive proteinuria presenting within the first 3 months of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "edema",
        "description": "Generalized edema in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in NPHS1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypoalbuminemia",
        "description": "Serum hypoalbuminemia consistent with nephrotic syndrome",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-biopsy",
        "description": "Renal biopsy showing diffuse mesangial sclerosis or microcystic dilatation of proximal tubules",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of massive proteinuria and edema in infancy plus genetic confirmation of NPHS1 mutations",
    "notes": "Genetic testing is the gold standard for diagnosis; renal biopsy is less commonly required."
  },
