  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for CMT2Y",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of progressive distal muscle weakness and atrophy predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electrophysiological evidence of axonal sensorimotor neuropathy with reduced compound muscle action potentials",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in the MORC2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Nerve biopsy showing axonal degeneration without significant demyelination",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal sensorimotor neuropathy with supportive electrophysiological findings and identification of a pathogenic MORC2 mutation",
    "notes": "Genetic confirmation is essential due to phenotypic overlap with other CMT subtypes"
  },
