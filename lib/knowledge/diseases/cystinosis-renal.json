  "keyFindings": {
    "laboratory": [
      "Elevated leukocyte cystine concentration (>1 nmol half-cystine/mg protein)",
      "Metabolic acidosis with hypophosphatemia and aminoaciduria",
      "Elevated serum creatinine in advanced renal failure"
    ],
    "imaging": [
      "Radiographic evidence of rickets (metaphyseal changes)",
      "Renal ultrasound showing nephrocalcinosis or small kidneys in late disease"
    ],
    "genetic": [
      "Pathogenic mutations in CTNS gene on chromosome 17p13"
    ],
    "other": [
      "Slit-lamp examination revealing corneal cystine crystals"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "fanconi-syndrome-other-causes",
      "distinguishingFeatures": [
        "Absence of corneal cystine crystals",
        "No elevated leukocyte cystine levels",
        "Different genetic or acquired etiologies"
      ]
    },
    {
      "diseaseId": "other-lysosomal-storage-diseases",
      "distinguishingFeatures": [
        "Different organ involvement patterns",
        "Distinct genetic mutations",
        "Lack of cystine crystal deposition"
      ]
    }
  ],
  "redFlags": [
    "Early onset Fanconi syndrome with failure to thrive",
    "Presence of corneal cystine crystals on slit-lamp exam",
    "Rapid progression to end-stage renal disease without treatment"
  ],
