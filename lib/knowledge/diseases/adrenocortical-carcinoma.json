  "diagnosticCriteria": {
    "formalCriteriaName": "Weiss Criteria",
    "criteria": [
      {
        "id": "high-mitotic-rate",
        "description": "Mitotic rate greater than 5 per 50 high power fields",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "atypical-mitoses",
        "description": "Presence of atypical mitotic figures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "venous-invasion",
        "description": "Venous invasion by tumor cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "necrosis",
        "description": "Confluent tumor necrosis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "nuclear-grade",
        "description": "High nuclear grade (Fuhrman grade 3 or 4)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of 3 or more major Weiss criteria including high mitotic rate, atypical mitoses, or venous invasion",
    "notes": "Weiss criteria are histopathological features used to differentiate benign from malignant adrenocortical tumors."
  },
