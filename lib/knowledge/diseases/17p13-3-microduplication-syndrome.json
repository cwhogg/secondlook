        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial features including prominent forehead, hypertelorism, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-features",
        "description": "Hypotonia and/or seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-anomalies",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of genetic confirmation of 17p13.3 microduplication plus at least two major clinical features including developmental delay and craniofacial dysmorphism",
    "notes": "Diagnosis relies heavily on molecular genetic testing combined with clinical evaluation"
  },
