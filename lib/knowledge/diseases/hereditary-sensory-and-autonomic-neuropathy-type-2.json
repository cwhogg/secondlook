  "diagnosticCriteria": {
    "formalCriteriaName": "HSAN Diagnostic Criteria",
    "criteria": [
      {
        "id": "early-sensory-loss",
        "description": "Early-onset distal sensory loss predominantly affecting pain and temperature modalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autonomic-dysfunction",
        "description": "Presence of autonomic disturbances including anhidrosis and cardiovascular dysregulation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the WNK1/HSN2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-motor-involvement",
        "description": "Lack of significant motor neuropathy or weakness",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Nerve biopsy showing loss of small myelinated and unmyelinated fibers",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset sensory loss and autonomic dysfunction with genetic confirmation of WNK1/HSN2 mutation",
    "notes": "Diagnosis is supported by clinical features and confirmed by molecular genetic testing."
  },
