  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Léri-Weill Dyschondrosteosis",
    "criteria": [
      {
        "id": "mesomelic-shortening",
        "description": "Mesomelic shortening of the forearms and lower legs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "madelung-deformity",
        "description": "Presence of Madelung deformity of the wrist on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "shox-gene-mutation",
        "description": "Identification of SHOX gene haploinsufficiency or mutation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of mesomelic limb shortening and Madelung deformity with or without SHOX gene mutation",
    "notes": "Genetic testing for SHOX mutations supports diagnosis but is not mandatory if clinical and radiological features are definitive."
  },
