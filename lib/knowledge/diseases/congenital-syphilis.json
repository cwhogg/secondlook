  "diagnosticCriteria": {
    "formalCriteriaName": "Centers for Disease Control and Prevention (CDC) Diagnostic Criteria for Congenital Syphilis",
    "criteria": [
      {
        "id": "maternal-infection",
        "description": "Evidence of maternal syphilis infection during pregnancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical signs consistent with congenital syphilis (e.g., hepatosplenomegaly, rash, snuffles)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serologic-testing",
        "description": "Reactive non-treponemal and treponemal serologic tests in the infant",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-findings",
        "description": "Characteristic radiographic abnormalities of long bones",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuroinvolvement",
        "description": "Evidence of neurosyphilis by cerebrospinal fluid abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of maternal infection plus either clinical features in the infant or reactive serologic tests",
    "notes": "Diagnosis may be confirmed by direct detection of Treponema pallidum in lesions or body fluids."
  },
