  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Dyschromatosis Universalis Hereditaria",
    "criteria": [
      {
        "id": "mixed-hyperhypopigmented-macules",
        "description": "Presence of generalized mottled hyperpigmented and hypopigmented macules distributed over the trunk and extremities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset",
        "description": "Onset of skin pigmentation abnormalities in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant or recessive inheritance",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-systemic-involvement",
        "description": "Lack of systemic abnormalities or other organ involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized mottled hyper- and hypopigmented macules with onset in infancy or early childhood, with or without positive family history",
    "notes": "Genetic testing for mutations in ADAR or ABCB6 genes may support diagnosis but is not mandatory"
  },
