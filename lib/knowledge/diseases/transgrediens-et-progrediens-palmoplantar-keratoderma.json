  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Transgrediens et Progrediens Palmoplantar Keratoderma",
    "criteria": [
      {
        "id": "palmoplantar-keratoderma",
        "description": "Diffuse, thickened hyperkeratosis of the palms and soles extending beyond the palms and soles (transgrediens)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-extension",
        "description": "Progressive extension of keratoderma to dorsal surfaces of hands and feet and sometimes to wrists and ankles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pitting-and-fissuring",
        "description": "Presence of deep fissures and pitting within the hyperkeratotic plaques",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the SLURP1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of diffuse transgrediens palmoplantar keratoderma with progressive extension and characteristic fissuring, supported by family history or genetic confirmation",
    "notes": "Genetic testing for SLURP1 mutations can confirm diagnosis but is not mandatory if clinical features are typical."
  },
