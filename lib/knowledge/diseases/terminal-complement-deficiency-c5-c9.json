  "diagnosticCriteria": {
    "formalCriteriaName": "Terminal Complement Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "recurrent-neisseria-infections",
        "description": "History of recurrent or severe Neisseria infections (e.g., meningococcal or gonococcal infections)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-terminal-complement-activity",
        "description": "Reduced or absent hemolytic activity of the terminal complement components (CH50 assay)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in C5, C6, C7, C8, or C9 genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-early-complement-levels",
        "description": "Normal levels of early complement components (C3, C4) to exclude other complement deficiencies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent Neisseria infections plus reduced or absent terminal complement activity (CH50 assay). Genetic confirmation supports diagnosis.",
    "notes": "Diagnosis is often confirmed by functional complement assays and genetic testing."
  },
