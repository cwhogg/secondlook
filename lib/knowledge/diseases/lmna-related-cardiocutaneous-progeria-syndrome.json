        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic LMNA mutation plus presence of cardiomyopathy and cutaneous progeroid features",
    "notes": "Diagnosis relies heavily on genetic confirmation combined with clinical phenotype"
