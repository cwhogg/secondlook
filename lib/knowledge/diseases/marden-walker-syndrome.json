  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Genetic testing showing mutations in PIEZO2 or other associated genes"
    ],
    "imaging": [
      "X-rays showing joint contractures and skeletal abnormalities",
      "Brain MRI may show nonspecific findings related to developmental delay"
    ],
    "genetic": [
      "Mutations in PIEZO2 gene (most commonly)",
      "Other gene mutations reported in rare cases"
    ],
    "other": [
      "Electromyography may show decreased muscle activity",
      "Prenatal ultrasound may detect joint contractures"
    ]
  },
  "differentialDiagnoses": [
