  "diagnosticCriteria": {
    "formalCriteriaName": "LMNA-related Congenital Muscular Dystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early onset hypotonia and muscle weakness presenting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic LMNA gene mutation by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes with reduced lamin A/C protein expression",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-evaluation",
        "description": "Evidence of early cardiac conduction defects or cardiomyopathy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early onset hypotonia and muscle weakness plus pathogenic LMNA mutation",
    "notes": "Muscle biopsy and cardiac evaluation support diagnosis but are not mandatory if genetic testing is confirmatory."
  },
