  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for 5p Deletion Syndrome",
    "criteria": [
      {
        "id": "distinctive-cry",
        "description": "High-pitched, cat-like cry in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chromosome-5p-deletion",
        "description": "Confirmed deletion on the short arm of chromosome 5 by cytogenetic or molecular testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay and intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including microcephaly, hypertelorism, and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Prenatal and postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chromosome 5p deletion confirmed by genetic testing plus at least one major clinical feature (distinctive cry or developmental delay).",
    "notes": "Diagnosis is confirmed by genetic testing; clinical features support diagnosis."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "High-pitched cat-like cry",
        "frequency": 0.85,
        "bodySystem": "otolaryngological",
        "notes": "Typically present in infancy and diminishes with age"
      },
      {
        "symptomName": "Chromosome 5p deletion",
        "frequency": 1,
        "bodySystem": "constitutional",
        "notes": "Detected by cytogenetic or molecular genetic testing"
      },
      {
        "symptomName": "Global developmental delay",
        "frequency": 0.9,
        "bodySystem": "neurological",
        "notes": "Includes intellectual disability and delayed milestones"
      }
    ],
    "common": [
      {
        "symptomName": "Microcephaly",
        "frequency": 0.75,
        "bodySystem": "neurological",
        "notes": "Small head circumference relative to age"
      },
      {
        "symptomName": "Facial dysmorphism",
        "frequency": 0.7,
        "bodySystem": "constitutional",
        "notes": "Includes hypertelorism, micrognathia, epicanthal folds"
      },
      {
        "symptomName": "Hypotonia",
        "frequency": 0.65,
        "bodySystem": "musculoskeletal",
        "notes": "Reduced muscle tone commonly observed"
      },
      {
        "symptomName": "Prenatal and postnatal growth retardation",
        "frequency": 0.6,
        "bodySystem": "constitutional",
        "notes": "Failure to thrive and short stature"
      },
      {
