        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "MRI showing well-demarcated, non-enhancing or minimally enhancing intraventricular mass, typically in fourth or lateral ventricles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Symptoms related to obstructive hydrocephalus or mass effect such as headache and gait disturbance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
