  "diagnosticCriteria": {
    "formalCriteriaName": "LBSL Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of progressive neurological symptoms including ataxia, spasticity, and dorsal column dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mri-findings",
        "description": "Characteristic MRI findings showing leukoencephalopathy with involvement of brainstem and spinal cord white matter",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-lactate",
        "description": "Elevated lactate levels in cerebrospinal fluid or brain spectroscopy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "dars2-mutation",
        "description": "Identification of pathogenic mutations in the DARS2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of progressive neurological symptoms plus characteristic MRI findings and confirmation by DARS2 gene mutation analysis",
    "notes": "Elevated lactate is supportive but not mandatory for diagnosis."
  },
