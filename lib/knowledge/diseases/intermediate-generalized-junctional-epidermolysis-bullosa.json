  "diagnosticCriteria": {
    "formalCriteriaName": "Junctional Epidermolysis Bullosa Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-blistering",
        "description": "Presence of generalized skin blistering and erosions at or shortly after birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence-microscopy",
        "description": "Immunofluorescence mapping showing reduced or absent expression of laminin-332 or other basement membrane zone proteins",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in LAMA3, LAMB3, or LAMC2 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electron-microscopy",
        "description": "Electron microscopy demonstrating cleavage within the lamina lucida of the basement membrane zone",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized blistering at birth plus either immunofluorescence mapping abnormalities or pathogenic mutations in JEB-associated genes",
    "notes": "Diagnosis requires correlation of clinical, immunopathological, and genetic findings."
  },
