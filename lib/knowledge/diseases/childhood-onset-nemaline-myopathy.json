  "diagnosticCriteria": {
    "formalCriteriaName": "Nemaline Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early-onset muscle weakness predominantly affecting proximal muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Presence of nemaline rods on muscle biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with nemaline myopathy (e.g., NEB, ACTA1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Myopathic changes on electromyography",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "creatine-kinase-levels",
        "description": "Normal or mildly elevated serum creatine kinase levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset muscle weakness with nemaline rods on muscle biopsy and pathogenic genetic variant in a known nemaline myopathy gene",
    "notes": "Diagnosis requires integration of clinical, histopathological, and genetic findings."
  },
