  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of metabolic causes of ataxia"
    ],
    "imaging": [
      "MRI showing cerebellar cortical atrophy, especially vermis",
      "No significant brainstem involvement"
    ],
    "genetic": [
      "BEAN1 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electrophysiological studies may show mild peripheral neuropathy",
      "Family history consistent with autosomal dominant inheritance"
    ]
  },
  "differentialDiagnoses": [
