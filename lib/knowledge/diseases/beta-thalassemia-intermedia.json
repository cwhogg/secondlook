  "keyFindings": {
    "laboratory": [
      "Moderate anemia with microcytosis and hypochromia",
      "Elevated HbF and HbA2 on hemoglobin electrophoresis",
      "Elevated serum ferritin and transferrin saturation in some cases"
    ],
    "imaging": [
      "Bone marrow expansion visible on skull and long bone X-rays",
      "Splenomegaly and hepatomegaly on abdominal ultrasound",
      "Extramedullary hematopoietic masses on MRI or CT"
    ],
    "genetic": [
      "HBB (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Evidence of ineffective erythropoiesis",
      "Increased intestinal iron absorption leading to secondary iron overload"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "beta-thalassemia-major",
      "distinguishingFeatures": [
        "Severe anemia requiring regular transfusions",
        "Earlier onset in infancy",
        "More pronounced bone deformities and growth retardation"
      ]
    },
    {
      "diseaseId": "beta-thalassemia-minor",
      "distinguishingFeatures": [
        "Mild or asymptomatic anemia",
        "No bone deformities or splenomegaly",
        "Normal or slightly elevated HbA2 without significant clinical symptoms"
      ]
    },
    {
      "diseaseId": "iron-deficiency-anemia",
      "distinguishingFeatures": [
        "Low serum ferritin and iron levels",
        "Response to iron supplementation",
        "Absence of hemoglobinopathy on electrophoresis"
      ]
    }
  ],
  "redFlags": [
    "Rapidly worsening anemia requiring frequent transfusions",
    "Development of severe bone deformities or fractures",
    "Signs of cardiac failure or pulmonary hypertension"
  ],
