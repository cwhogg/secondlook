  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological and Immunohistochemical Diagnostic Criteria for Uterine Leiomyosarcoma",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of spindle-shaped malignant smooth muscle cells with marked cytologic atypia, high mitotic index (>10 mitoses/10 HPF), and tumor cell necrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Positive immunostaining for smooth muscle markers such as desmin, smooth muscle actin (SMA), and h-caldesmon",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-imaging",
        "description": "Imaging evidence of a large, heterogeneous uterine mass with areas of necrosis and hemorrhage on MRI or CT",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of malignant smooth muscle tumor with cytologic atypia and high mitotic activity, supported by immunohistochemical positivity for smooth muscle markers",
    "notes": "Diagnosis requires exclusion of benign leiomyoma and other uterine sarcomas."
  },
