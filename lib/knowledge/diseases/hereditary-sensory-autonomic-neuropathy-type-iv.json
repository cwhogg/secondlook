  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for HSAN Type IV",
    "criteria": [
      {
        "id": "congenital-insensitivity-pain",
        "description": "Congenital insensitivity to pain",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anhidrosis",
        "description": "Anhidrosis (inability to sweat)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-biopsy",
        "description": "Reduced or absent small myelinated and unmyelinated nerve fibers on nerve biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the NTRK1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autonomic-dysfunction",
        "description": "Evidence of autonomic dysfunction such as temperature regulation abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital insensitivity to pain and anhidrosis plus either confirmatory nerve biopsy findings or identification of pathogenic NTRK1 mutations",
    "notes": "Genetic testing is the gold standard for confirmation; clinical features and nerve biopsy support diagnosis."
  },
