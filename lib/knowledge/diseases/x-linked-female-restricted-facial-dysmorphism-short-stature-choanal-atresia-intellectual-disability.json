  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for X-linked Female Restricted Facial Dysmorphism-Short Stature-Choanal Atresia-Intellectual Disability Syndrome",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic female-restricted facial dysmorphic features including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "choanal-atresia",
        "description": "Presence of unilateral or bilateral choanal atresia confirmed by nasal endoscopy or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Postnatal short stature below the 3rd percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability confirmed by standardized cognitive testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "x-linked-inheritance",
        "description": "Evidence of X-linked inheritance pattern in family history or genetic testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all four major criteria: female-restricted facial dysmorphism, choanal atresia, short stature, and intellectual disability",
    "notes": "Genetic testing for causative gene mutations may support diagnosis but is not yet standardized."
  },
