  "keyFindings": {
    "laboratory": [
      "Normal serum calcium, phosphate, and alkaline phosphatase levels",
      "No metabolic bone disease markers"
    ],
    "imaging": [
      "Radiographs showing multiple wormian bones in cranial sutures",
      "Diaphyseal widening and cortical thickening of long bones",
      "Diffuse cranial bone sclerosis on skull X-ray or CT"
    ],
    "genetic": [
      "No specific gene identified; suspected autosomal recessive inheritance",
      "Genetic testing currently inconclusive"
    ],
    "other": [
