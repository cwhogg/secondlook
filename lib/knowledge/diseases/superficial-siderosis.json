  "diagnosticCriteria": {
    "formalCriteriaName": "No formal standardized criteria",
    "criteria": [
      {
        "id": "chronic-subarachnoid-hemosiderin",
        "description": "Presence of hemosiderin deposition on the superficial layers of the CNS demonstrated by MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-cerebellar-ataxia",
        "description": "Progressive cerebellar ataxia clinically evident",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss developing over time",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "history-of-chronic-subarachnoid-bleeding",
        "description": "History or evidence of chronic or recurrent subarachnoid hemorrhage or bleeding source",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "MRI evidence of superficial hemosiderin deposition plus at least two clinical features including progressive cerebellar ataxia and sensorineural hearing loss",
    "notes": "Diagnosis is primarily clinical supported by characteristic MRI findings; biopsy rarely required."
  },
