  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for DADA2",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the ADA2 (CECR1) gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of early-onset vasculitis or systemic inflammation including livedo racemosa and stroke",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Evidence of immunodeficiency such as hypogammaglobulinemia or recurrent infections",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "laboratory-findings",
        "description": "Elevated acute phase reactants (e.g., ESR, CRP) during active disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biallelic pathogenic ADA2 mutations plus at least one major clinical feature",
    "notes": "Genetic confirmation is essential; clinical presentation may vary widely."
  },
