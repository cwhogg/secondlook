  "diagnosticCriteria": {
    "formalCriteriaName": "Rahman Diagnostic Criteria for Leigh Syndrome",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive neurological disease with motor and cognitive regression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "Bilateral symmetric lesions in basal ganglia and/or brainstem on MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-evidence",
        "description": "Elevated lactate in blood and/or cerebrospinal fluid",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic mutations in mitochondrial or nuclear genes associated with mitochondrial function",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive neurological symptoms with characteristic neuroimaging findings and elevated lactate",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory"
  },
