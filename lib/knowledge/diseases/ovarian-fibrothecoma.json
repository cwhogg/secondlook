  "differentialDiagnoses": [
    {
      "diseaseId": "ovarian-thecoma",
      "distinguishingFeatures": [
        "Predominantly theca cells without significant fibroblastic component",
        "More frequent estrogenic symptoms"
      ]
    },
    {
      "diseaseId": "ovarian-fibroma",
      "distinguishingFeatures": [
        "Predominantly fibroblastic cells without theca cell differentiation",
        "Usually no hormonal manifestations"
      ]
    },
    {
      "diseaseId": "granulosa-cell-tumor",
      "distinguishingFeatures": [
        "Malignant potential",
        "Elevated inhibin and estradiol levels",
        "Histology shows Call-Exner bodies"
      ]
    }
  ],
