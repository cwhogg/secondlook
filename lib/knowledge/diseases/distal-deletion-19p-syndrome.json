  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Distal 19p Deletion Syndrome",
    "criteria": [
      {
        "id": "chromosomal-deletion",
        "description": "Confirmed deletion involving the distal portion of the short arm of chromosome 19 (19p13.3) by molecular cytogenetic techniques",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including microcephaly, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or skeletal abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of distal 19p deletion plus presence of developmental delay and characteristic craniofacial dysmorphism",
    "notes": "Diagnosis relies heavily on genetic testing; phenotypic variability is common."
  },
