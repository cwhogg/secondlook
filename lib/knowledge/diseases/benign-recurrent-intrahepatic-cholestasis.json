  "diagnosticCriteria": {
    "formalCriteriaName": "BRIC Diagnostic Criteria",
    "criteria": [
      {
        "id": "episodic-cholestasis",
        "description": "Recurrent episodes of intrahepatic cholestasis with pruritus and jaundice",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-biliary-obstruction",
        "description": "No evidence of extrahepatic biliary obstruction on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-liver-function-between-attacks",
        "description": "Normal or near-normal liver function tests between episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in ATP8B1 or ABCB11 genes supportive but not mandatory",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent cholestatic episodes with pruritus and jaundice, absence of biliary obstruction, and normal liver function tests between episodes",
    "notes": "Genetic testing can confirm diagnosis but is not required; liver biopsy may show canalicular cholestasis during attacks."
  },
