  "diagnosticCriteria": {
    "formalCriteriaName": "Phacoanaphylactic Uveitis Diagnostic Criteria",
    "criteria": [
      {
        "id": "history-of-lens-rupture",
        "description": "History of traumatic or surgical rupture of the lens capsule",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "granulomatous-anterior-uveitis",
        "description": "Presence of granulomatous anterior uveitis with mutton-fat keratic precipitates",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lens-material-inflammation",
        "description": "Inflammatory reaction directed against lens proteins evidenced clinically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-infectious-cause",
        "description": "Exclusion of infectious endophthalmitis or other causes of uveitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of history of lens capsule rupture plus granulomatous anterior uveitis with inflammatory reaction against lens proteins",
    "notes": "Diagnosis is clinical and supported by exclusion of infectious causes."
  },
