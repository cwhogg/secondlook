  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria established",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of heterozygous microdeletion at chromosome 17q12 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-anomalies",
        "description": "Presence of structural or functional renal abnormalities including cystic kidney disease or renal hypoplasia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "maturity-onset-diabetes",
        "description": "Diagnosis of maturity-onset diabetes of the young (MODY) or early-onset diabetes mellitus",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurodevelopmental-features",
        "description": "Neurodevelopmental disorders such as developmental delay, intellectual disability, or autism spectrum disorder",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 17q12 microdeletion plus at least one major clinical feature (renal anomaly or diabetes)",
    "notes": "Diagnosis relies heavily on genetic testing; clinical features are variable and may be incomplete."
  },
