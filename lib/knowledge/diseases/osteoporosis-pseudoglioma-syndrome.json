  "keyFindings": {
    "laboratory": [
      "Elevated serum calcium and alkaline phosphatase",
      "Normal or mildly elevated parathyroid hormone levels"
    ],
    "imaging": [
      "Radiographs showing severe osteoporosis with multiple fractures",
      "Ocular ultrasound or MRI demonstrating pseudoglioma",
      "Skeletal deformities including bowed long bones and vertebral compression fractures"
    ],
    "genetic": [
      "LRP5 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electroretinography may show absent or severely reduced retinal responses"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "osteogenesis-imperfecta",
      "distinguishingFeatures": [
        "Blue sclerae",
        "Normal ocular fundus without pseudoglioma",
        "Dominant inheritance pattern"
      ]
    },
    {
      "diseaseId": "familial-exudative-vitreo-retinopathy",
      "distinguishingFeatures": [
        "Retinal vascular abnormalities without severe osteoporosis",
        "Variable visual impairment",
        "Mutations in FZD4, NDP, or TSPAN12 genes"
      ]
    }
  ],
  "redFlags": [
    "Early onset blindness or severe visual impairment in infancy",
    "Multiple low-trauma fractures in early childhood",
    "Progressive skeletal deformities with growth delay"
  ],
