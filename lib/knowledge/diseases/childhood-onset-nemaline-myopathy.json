  "keyFindings": {
    "laboratory": [
      "Normal or mildly elevated serum creatine kinase",
      "Electromyography showing myopathic motor unit potentials"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle involvement and fatty infiltration",
      "Chest X-ray or CT showing restrictive lung disease features"
    ],
    "genetic": [
      "TPM2 (causative)",
      "MYPN (causative, loss-of-function)",
      "ACTA1 (causative)",
      "TPM3 (causative)",
      "NEB (causative)",
      "KBTBD13 (causative)",
      "KLHL41 (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Muscle biopsy demonstrating nemaline rods with Gomori trichrome stain"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "central-core-disease",
      "distinguishingFeatures": [
        "Presence of central cores on muscle biopsy instead of nemaline rods",
        "Usually associated with RYR1 mutations",
        "Different pattern of muscle weakness and histopathology"
      ]
    },
    {
      "diseaseId": "congenital-myotonic-dystrophy",
      "distinguishingFeatures": [
        "Myotonia and multisystem involvement",
        "CTG repeat expansion in DMPK gene",
        "Distinct facial features and cardiac conduction defects"
      ]
    },
    {
      "diseaseId": "congenital-myopathies-other",
      "distinguishingFeatures": [
        "Different histopathological findings (e.g., cores, fiber type disproportion)",
        "Genetic testing differentiates subtypes",
        "Variable clinical presentations"
      ]
    }
  ],
