  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests unless secondary complications present",
      "Possible hypothyroidism on thyroid function tests"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter abnormalities",
      "Echocardiogram to identify congenital heart defects",
      "Skeletal X-rays revealing clinodactyly or joint contractures"
    ],
    "genetic": [
      "Duplication of distal 18q region detected by chromosomal microarray or karyotyping",
      "FISH confirming duplication involving 18q23 region"
    ],
    "other": [
      "Developmental assessments confirming global developmental delay",
      "Audiological evaluation for sensorineural hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "trisomy-18-edwards-syndrome",
      "distinguishingFeatures": [
        "Full trisomy 18 with more severe congenital anomalies",
