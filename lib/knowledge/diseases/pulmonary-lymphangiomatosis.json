  "diagnosticCriteria": {
    "formalCriteriaName": "Pulmonary Lymphangiomatosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histological confirmation of diffuse proliferation of lymphatic vessels in lung tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Characteristic findings on high-resolution chest CT showing diffuse interstitial thickening and cystic changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive respiratory symptoms including dyspnea and chylous pleural effusions",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other",
        "description": "Exclusion of other lymphatic or interstitial lung diseases",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation plus characteristic imaging findings and compatible clinical presentation",
    "notes": "Diagnosis often requires multidisciplinary evaluation including pathology, radiology, and clinical correlation."
  },
