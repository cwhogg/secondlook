  "diagnosticCriteria": {
    "formalCriteriaName": "No formal standardized criteria",
    "criteria": [
      {
        "id": "imaging-confirmation",
        "description": "Visualization of abnormal communication between a coronary artery and a cardiac chamber or vessel on imaging (echocardiography, coronary angiography, CT, or MRI)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-signs",
        "description": "Presence of continuous cardiac murmur or bruit suggestive of abnormal shunting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemodynamic-evidence",
        "description": "Evidence of left-to-right shunting or volume overload on echocardiography or cardiac catheterization",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Imaging confirmation of fistula plus clinical signs such as continuous murmur",
    "notes": "Diagnosis primarily relies on imaging modalities; no universally accepted formal diagnostic criteria exist."
  },
