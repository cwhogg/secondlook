  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for alpha-dystroglycan-related LGMD",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness predominantly affecting limb-girdle muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing reduced or abnormal alpha-dystroglycan glycosylation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with alpha-dystroglycan glycosylation defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Electromyography demonstrating myopathic changes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "serum-creatine-kinase",
        "description": "Elevated serum creatine kinase levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal muscle weakness with confirmatory muscle biopsy and genetic testing showing pathogenic variants in alpha-dystroglycan-related genes",
    "notes": "Diagnosis requires integration of clinical, histopathological, and genetic findings"
  },
