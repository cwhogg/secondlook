      "Normal or mildly elevated plasma oxalate in early disease",
      "Normal liver enzyme function"
    ],
    "imaging": [
      "Ultrasound showing nephrocalcinosis",
      "CT scan demonstrating calcium oxalate kidney stones"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Exclusion of PH1 and PH2 mutations",
      "Absence of systemic oxalosis in early stages"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "primary-hyperoxaluria-type-1",
      "distinguishingFeatures": [
        "Mutations in AGXT gene",
        "More severe systemic oxalosis",
        "Earlier onset and higher plasma oxalate levels"
      ]
    },
    {
      "diseaseId": "primary-hyperoxaluria-type-2",
      "distinguishingFeatures": [
        "Mutations in GRHPR gene",
        "Intermediate severity",
        "Different biochemical profile with elevated glycolate"
      ]
    },
    {
      "diseaseId": "secondary-hyperoxaluria",
      "distinguishingFeatures": [
        "Due to increased dietary oxalate or intestinal absorption",
        "No genetic mutations",
        "Reversible with dietary modification"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive renal failure",
    "Recurrent nephrolithiasis in childhood or adolescence",
    "Family history of kidney stones or renal failure"
