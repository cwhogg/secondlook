  "keyFindings": {
    "laboratory": [
      "Pancytopenia with anemia, leukopenia, and thrombocytopenia",
      "Elevated serum alkaline phosphatase",
      "Hypocalcemia in some cases"
    ],
    "imaging": [
      "Diffuse osteosclerosis with 'bone within bone' and 'Erlenmeyer flask' deformity",
      "Narrowing of cranial nerve foramina on CT",
      "Bone marrow space obliteration"
    ],
    "genetic": [
      "CLCN7 (causative)",
      "TCIRG1 (causative, loss-of-function)",
      "TNFSF11 (causative)",
      "SNX10 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Bone biopsy showing defective osteoclast resorption",
      "Extramedullary hematopoiesis in liver and spleen"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autosomal-dominant-osteopetrosis",
      "distinguishingFeatures": [
        "Later onset and milder clinical course",
        "Less severe bone marrow failure",
        "Different genetic mutations (e.g., CLCN7 dominant variants)"
      ]
    },
    {
      "diseaseId": "pyknodysostosis",
      "distinguishingFeatures": [
        "Short stature with acro-osteolysis of distal phalanges",
        "Characteristic facial features",
        "Normal bone marrow function"
      ]
    }
  ],
