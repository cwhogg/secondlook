  "diagnosticCriteria": {
    "formalCriteriaName": "AApoAIV Amyloidosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "amyloid-deposition",
        "description": "Histological confirmation of amyloid deposits by Congo red staining with apple-green birefringence under polarized light",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "apoaiv-protein-identification",
        "description": "Identification of apolipoprotein A-IV as the amyloid fibril protein by immunohistochemistry or mass spectrometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "organ-involvement",
        "description": "Evidence of organ dysfunction consistent with amyloid deposition, particularly renal or cardiac involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-amyloidosis",
        "description": "Exclusion of other types of amyloidosis such as AL or AA amyloidosis by appropriate laboratory and genetic testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histological confirmation of amyloid deposits with apolipoprotein A-IV identification and evidence of organ involvement",
    "notes": "Mass spectrometry-based proteomic analysis is considered the gold standard for amyloid typing."
  },
