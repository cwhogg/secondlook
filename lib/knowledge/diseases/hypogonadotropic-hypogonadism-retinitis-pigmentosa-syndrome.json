  "keyFindings": {
    "laboratory": [
      "Low serum luteinizing hormone (LH) and follicle-stimulating hormone (FSH)",
      "Low sex steroid hormone levels (testosterone or estradiol)"
    ],
    "imaging": [
      "Retinal imaging showing bone-spicule pigmentation and retinal pigment epithelium atrophy",
      "Brain MRI may show cerebellar atrophy in some cases"
    ],
    "genetic": [
      "Pathogenic variants in PNPLA6 gene or other associated genes"
    ],
    "other": [
      "Electroretinography (ERG) demonstrating reduced or absent rod and cone responses"
    ]
