  "diagnosticCriteria": {
    "formalCriteriaName": "Chromosomal Microdeletion Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of heterozygous microdeletion involving chromosome 1p31p32 region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including broad nasal bridge and micrognathia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or skeletal abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 1p31p32 microdeletion plus at least one major clinical feature (developmental delay or craniofacial dysmorphism)",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support but are variable."
  },
