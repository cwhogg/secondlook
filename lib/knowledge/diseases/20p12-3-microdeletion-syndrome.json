  "diagnosticCriteria": {
    "formalCriteriaName": "20p12.3 Microdeletion Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of a microdeletion at chromosome 20p12.3 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Presence of characteristic facial features including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-heart-defect",
        "description": "Presence of congenital heart defects such as atrial or ventricular septal defects",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 20p12.3 microdeletion plus at least one major clinical feature such as characteristic facial dysmorphism or developmental delay",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support but are variable."
  },
