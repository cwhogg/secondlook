  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological Diagnostic Criteria for Adenoid Basal Carcinoma",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of small basaloid nests of uniform cells with peripheral palisading and minimal cytologic atypia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Positive staining for cytokeratin and p16 with negative or low Ki-67 proliferation index",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-invasion",
        "description": "Lack of stromal invasion or only minimal stromal invasion without desmoplastic response",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Lesion localized to the cervix without evidence of metastasis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of basaloid nests with characteristic immunohistochemical profile and absence of significant stromal invasion",
    "notes": "Diagnosis requires differentiation from adenoid cystic carcinoma and other basaloid lesions of the cervix."
  },
