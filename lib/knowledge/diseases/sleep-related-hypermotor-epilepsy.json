  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild elevation of serum prolactin postictally"
    ],
    "imaging": [
      "Usually normal brain MRI",
      "Occasionally focal frontal lobe abnormalities"
    ],
    "genetic": [
      "CHRNA4 (causative)",
      "CHRNA2 (causative)",
      "CHRNB2 (causative)",
      "KCNT1 (causative)",
      "DEPDC5 (causative, loss-of-function)",
      "CRH (causative)",
      "CABP4 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Video-polysomnography showing stereotyped hypermotor seizures during NREM sleep"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "nocturnal-frontal-lobe-epilepsy",
      "distinguishingFeatures": [
        "Overlap in clinical features; considered synonymous by some experts"
      ]
    },
    {
      "diseaseId": "parasomnia",
      "distinguishingFeatures": [
        "Lack of epileptiform EEG activity",
        "Non-stereotyped, variable motor behaviors",
        "No response to antiepileptic drugs"
      ]
    },
    {
      "diseaseId": "rapid-eye-movement-sleep-behavior-disorder",
      "distinguishingFeatures": [
        "Occurrence during REM sleep rather than NREM",
        "Dream enactment behaviors",
        "Absence of ictal EEG abnormalities"
      ]
    }
  ],
  "redFlags": [
    "Seizures occurring exclusively during wakefulness",
    "Progressive neurological deficits",
    "Poor response to multiple antiepileptic drugs"
  ],
