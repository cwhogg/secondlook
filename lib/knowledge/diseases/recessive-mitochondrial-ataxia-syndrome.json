  "keyFindings": {
    "laboratory": [
      "Elevated lactate and pyruvate levels in blood and CSF",
      "Deficient activity of mitochondrial respiratory chain complexes in muscle biopsy"
    ],
    "imaging": [
      "MRI showing cerebellar atrophy",
      "Basal ganglia signal abnormalities on T2-weighted MRI"
    ],
    "genetic": [
      "POLG (causative)",
      "Biallelic pathogenic variants in nuclear genes encoding mitochondrial proteins (e.g., POLG, TWNK)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy showing ragged-red fibers and cytochrome c oxidase (COX) deficiency"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "friedreich-ataxia",
      "distinguishingFeatures": [
        "Autosomal recessive inheritance with GAA trinucleotide repeat expansion in FXN gene",
        "Cardiomyopathy and diabetes more prominent",
        "Absence of mitochondrial respiratory chain deficiency"
      ]
    },
    {
      "diseaseId": "spinocerebellar-ataxia",
      "distinguishingFeatures": [
        "Usually autosomal dominant inheritance",
        "Lack of mitochondrial dysfunction",
        "Different genetic mutations (e.g., CAG repeat expansions)"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive cerebellar ataxia with multisystem involvement",
    "Early onset of peripheral neuropathy with mitochondrial dysfunction",
    "Presence of lactic acidosis or metabolic crises"
  ],
