      "Hyperphosphatemia",
      "Normal magnesium levels"
    ],
    "imaging": [
      "Skull radiographs showing microcephaly",
      "Nephrocalcinosis on renal ultrasound",
      "Brain MRI may show nonspecific findings related to developmental delay"
    ],
    "genetic": [
      "TBCE (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
