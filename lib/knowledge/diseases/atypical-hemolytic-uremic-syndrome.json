  "keyFindings": {
    "laboratory": [
      "Schistocytes on peripheral blood smear",
      "Elevated lactate dehydrogenase (LDH)",
      "Low haptoglobin",
      "Elevated serum creatinine",
      "Thrombocytopenia",
      "Normal ADAMTS13 activity (>10%)",
      "Negative Shiga toxin assay"
    ],
    "imaging": [
      "Renal ultrasound may show normal or enlarged kidneys",
      "Brain MRI in neurological involvement may show ischemic changes"
    ],
    "genetic": [
      "ATP7A (causative, loss-of-function)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Complement activation markers elevated (e.g. sC5b-9)",
      "Urinalysis showing proteinuria and hematuria"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "shiga-toxin-hemolytic-uremic-syndrome",
      "distinguishingFeatures": [
        "History of diarrheal illness with Shiga toxin-producing E. coli infection",
        "Positive stool Shiga toxin assay",
        "Usually affects children"
      ]
    },
    {
      "diseaseId": "thrombotic-thrombocytopenic-purpura",
      "distinguishingFeatures": [
        "Severe ADAMTS13 deficiency (<10%)",
        "Prominent neurological symptoms",
        "Less severe renal impairment"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive renal failure",
    "Neurological deterioration (seizures, altered consciousness)",
    "Severe thrombocytopenia with bleeding"
  ],
