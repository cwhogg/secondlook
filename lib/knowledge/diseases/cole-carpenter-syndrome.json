  "keyFindings": {
    "laboratory": [
      "Normal metabolic bone markers",
      "Possible elevated alkaline phosphatase during fracture healing"
    ],
    "imaging": [
      "Skull X-rays showing craniosynostosis and wormian bones",
      "Skeletal survey revealing multiple fractures and osteopenia",
      "Radiographs showing bone deformities typical of osteogenesis imperfecta"
    ],
    "genetic": [
      "P4HB (causative)",
      "SEC24D (causative)",
      "CRTAP (causative)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Clinical evaluation of facial dysmorphism",
      "Bone biopsy rarely performed but shows defective collagen matrix"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "osteogenesis-imperfecta",
      "distinguishingFeatures": [
        "Absence of craniosynostosis",
        "More variable facial features",
        "Different genetic mutations primarily in COL1A1 and COL1A2"
      ]
    },
    {
      "diseaseId": "pfeiffer-syndrome",
      "distinguishingFeatures": [
        "Craniosynostosis with broad thumbs and great toes",
        "No bone fragility or osteogenesis imperfecta features",
        "Mutations in FGFR1 or FGFR2 genes"
      ]
    }
  ],
  "redFlags": [
    "Multiple recurrent fractures in infancy",
    "Severe craniosynostosis causing increased intracranial pressure",
    "Respiratory distress due to chest wall deformities"
