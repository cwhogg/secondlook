  "keyFindings": {
    "laboratory": [
      "Elevated CSF protein",
      "Normal routine blood counts",
      "Defective DNA repair assays (reduced recovery of RNA synthesis after UV exposure)"
    ],
    "imaging": [
      "Brain MRI showing cerebral and cerebellar atrophy",
      "Calcifications in basal ganglia and white matter abnormalities"
    ],
    "genetic": [
      "Mutations in ERCC6 (CSB) or ERCC8 (CSA) genes"
    ],
    "other": [
      "Characteristic facial features including sunken eyes, thin nose, and micrognathia",
      "Delayed bone age on radiographs"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "xeroderma-pigmentosum",
      "distinguishingFeatures": [
        "Severe photosensitivity with skin cancer predisposition",
        "Lack of neurological degeneration in some subtypes",
        "Different DNA repair gene mutations"
      ]
    },
    {
      "diseaseId": "werner-syndrome",
      "distinguishingFeatures": [
        "Adult onset premature aging",
        "Absence of photosensitivity",
        "Different genetic cause (WRN gene)"
      ]
    }
  ],
  "redFlags": [
    "Severe photosensitivity with minimal sun exposure",
    "Progressive neurological decline in infancy or early childhood",
    "Failure to thrive with characteristic cachectic appearance"
  ],
