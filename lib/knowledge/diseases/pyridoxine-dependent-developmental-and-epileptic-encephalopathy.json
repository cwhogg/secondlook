  "diagnosticCriteria": {
    "formalCriteriaName": "Pyridoxine-dependent epilepsy diagnostic criteria",
    "criteria": [
      {
        "id": "clinical-response-pyridoxine",
        "description": "Seizure cessation or marked improvement following administration of pyridoxine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset-seizures",
        "description": "Onset of intractable seizures in the neonatal period or early infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in ALDH7A1 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "biochemical-markers",
        "description": "Elevated biomarkers such as α-aminoadipic semialdehyde (AASA) in urine or plasma",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Presence of developmental delay or intellectual disability despite seizure control",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical diagnosis requires early-onset intractable seizures with a positive clinical response to pyridoxine; genetic or biochemical confirmation supports diagnosis.",
    "notes": "Response to pyridoxine must be observed under controlled conditions to exclude placebo effect."
  },
