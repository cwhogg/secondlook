  "keyFindings": {
    "laboratory": [
      "Elevated free T3 and free T4 with non-suppressed or elevated TSH",
      "Elevated alpha-subunit of glycoprotein hormones",
      "Normal or elevated serum prolactin (possible stalk effect)",
      "Lack of TSH suppression on T3 suppression test"
    ],
    "imaging": [
      "Pituitary macroadenoma or microadenoma on MRI with contrast",
      "Possible optic chiasm compression"
    ],
    "genetic": [
      "CDH23 (susceptibility)"
    ],
    "other": [
      "TRH stimulation test shows blunted or absent TSH response",
      "Visual field testing may reveal bitemporal hemianopsia"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "thyroid-hormone-resistance-syndrome",
      "distinguishingFeatures": [
        "Elevated free thyroid hormones with non-suppressed TSH",
        "No pituitary adenoma on imaging",
        "Family history of thyroid hormone resistance",
        "Normal alpha-subunit levels"
      ]
    },
    {
      "diseaseId": "primary-hyperthyroidism",
      "distinguishingFeatures": [
        "Suppressed TSH with elevated free thyroid hormones",
        "No pituitary adenoma on imaging",
        "Positive thyroid autoantibodies or thyroid uptake scan abnormalities"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive visual field loss",
    "Severe headache with sudden onset (possible pituitary apoplexy)",
    "Signs of hypopituitarism or adrenal insufficiency"
  ],
