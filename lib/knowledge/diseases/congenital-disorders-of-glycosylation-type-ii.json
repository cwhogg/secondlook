  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for CDG Type II",
    "criteria": [
      {
        "id": "abnormal-transferrin-glycosylation",
        "description": "Abnormal serum transferrin glycosylation pattern detected by isoelectric focusing or mass spectrometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-multisystem-involvement",
        "description": "Presence of multisystem clinical features including neurological, hepatic, and gastrointestinal manifestations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes involved in N-glycan processing (e.g., MAN1B1, MGAT2)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-biochemical-markers",
        "description": "Additional biochemical abnormalities such as abnormal lipid-linked oligosaccharides or enzyme assays",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Abnormal transferrin glycosylation plus either genetic confirmation or consistent multisystem clinical features",
    "notes": "Diagnosis requires integration of biochemical, clinical, and genetic data due to phenotypic heterogeneity."
  },
