  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Trisomy 10p Syndrome",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Detection of partial or complete trisomy of the short arm of chromosome 10 by karyotyping or chromosomal microarray",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial features including microcephaly, hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-malformations",
        "description": "Presence of congenital malformations such as cardiac defects or musculoskeletal anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of trisomy 10p plus presence of at least two major clinical features",
    "notes": "Diagnosis relies heavily on genetic testing; clinical features support but are variable."
  },
