  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Spondyloperipheral Dysplasia-Short Ulna Syndrome",
    "criteria": [
      {
        "id": "short-ulna",
        "description": "Bilateral shortening of the ulna with radiographic confirmation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vertebral-malformations",
        "description": "Presence of platyspondyly and other vertebral anomalies on spinal imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peripheral-bone-abnormalities",
        "description": "Peripheral skeletal dysplasia including brachydactyly and metaphyseal irregularities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal short stature with disproportionate limb shortening",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the COL2A1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (short ulna, vertebral malformations, peripheral bone abnormalities) with or without genetic confirmation",
    "notes": "Genetic testing can support diagnosis but is not mandatory if clinical and radiological features are definitive."
  },
