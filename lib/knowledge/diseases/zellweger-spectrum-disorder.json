  "keyFindings": {
    "laboratory": [
      "Elevated plasma very long chain fatty acids (VLCFA)",
      "Increased phytanic and pristanic acid levels",
      "Elevated bile acid intermediates"
    ],
    "imaging": [
      "Brain MRI showing neuronal migration defects such as polymicrogyria and pachygyria",
      "Skeletal X-rays showing chondrodysplasia punctata"
    ],
    "genetic": [
      "Mutations in PEX genes (e.g., PEX1, PEX6) confirming peroxisomal biogenesis disorder"
    ],
    "other": [
      "Abnormal peroxisomal function on fibroblast studies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "adrenoleukodystrophy",
      "distinguishingFeatures": [
        "Later onset",
        "Predominantly white matter demyelination",
        "Absence of craniofacial dysmorphism"
      ]
    },
    {
      "diseaseId": "refsum-disease",
      "distinguishingFeatures": [
        "Adult onset",
        "Phytanic acid accumulation without peroxisomal biogenesis defect",
        "Retinitis pigmentosa and peripheral neuropathy"
      ]
    }
  ],
