  "keyFindings": {
    "laboratory": [
      "Reduced arylsulfatase A enzyme activity in leukocytes or fibroblasts",
      "Elevated sulfatide levels in urine or tissues"
    ],
    "imaging": [
      "MRI showing symmetrical confluent T2 hyperintensities in cerebral white matter",
      "Possible involvement of corpus callosum and periventricular regions"
    ],
    "genetic": [
      "Pathogenic mutations in the ARSA gene"
    ],
    "other": [
      "Presence of metachromatic granules on nerve biopsy or urine sediment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "schizophrenia",
      "distinguishingFeatures": [
        "Lack of demyelination on MRI",
        "Normal arylsulfatase A enzyme activity",
        "Earlier onset of psychiatric symptoms without neurological decline"
      ]
    },
    {
      "diseaseId": "adult-onset adrenoleukodystrophy",
      "distinguishingFeatures": [
        "Elevated very long chain fatty acids",
        "X-linked inheritance pattern",
        "Different MRI pattern with parieto-occipital involvement"
      ]
    },
    {
      "diseaseId": "multiple sclerosis",
      "distinguishingFeatures": [
        "Relapsing-remitting course",
        "MRI lesions with periventricular ovoid plaques",
        "Absence of arylsulfatase A deficiency"
      ]
    }
  ],
  "redFlags": [
