  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible mild hypothyroidism in rare cases"
    ],
    "imaging": [
      "Radiographs showing brachydactyly with shortened phalanges",
      "Brain MRI may be normal or show nonspecific delayed myelination"
    ],
    "genetic": [
      "PRMT7 (causative, loss-of-function)",
      "No specific gene identified; suspected autosomal recessive inheritance pattern"
    ],
    "other": [
      "Clinical diagnosis based on constellation of features"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "bardet-biedl-syndrome",
      "distinguishingFeatures": [
        "Retinal dystrophy leading to vision loss",
        "Polydactyly rather than brachydactyly",
        "Renal anomalies common"
      ]
    },
    {
      "diseaseId": "albright-hereditary-osteodystrophy",
      "distinguishingFeatures": [
        "Subcutaneous ossifications",
        "Resistance to parathyroid hormone",
        "Short stature with brachydactyly but no global developmental delay"
      ]
    }
  ],
  "redFlags": [
    "Severe global developmental delay",
    "Rapid weight gain leading to morbid obesity",
    "Presence of seizures or cardiac anomalies"
  ],
