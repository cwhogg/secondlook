  "keyFindings": {
    "laboratory": [
      "Markedly elevated urinary and fecal uroporphyrin I and coproporphyrin I isomers",
      "Reduced erythrocyte uroporphyrinogen III cosynthase enzyme activity",
      "Mild to moderate anemia with reticulocytosis"
    ],
    "imaging": [
      "Ultrasound may show hepatosplenomegaly"
    ],
    "genetic": [
      "UROD (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy demonstrating subepidermal blister with festooning and porphyrin deposits under fluorescence microscopy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "porphyria-cutanea-tarda",
      "distinguishingFeatures": [
        "Later onset typically in adulthood",
        "Normal or mildly reduced UROS enzyme activity",
        "Predominance of uroporphyrin III isomer accumulation"
      ]
    },
    {
      "diseaseId": "congenital-erythropoietic-porphyria",
      "distinguishingFeatures": [
        "Also caused by UROS deficiency but usually presents with more severe hemolytic anemia",
        "Severe erythrodontia and hemolysis from infancy",
        "Higher urinary excretion of uroporphyrin I isomer"
      ]
    }
  ],
  "redFlags": [
    "Severe blistering and scarring on sun-exposed skin in infancy or early childhood",
    "Erythrodontia (red-brown discoloration of teeth) in a young child",
    "Markedly elevated urinary porphyrins with photosensitivity"
  ],
