  "keyFindings": {
    "laboratory": [
      "Central hypothyroidism with low free T4 and inappropriately normal or low TSH",
      "Hyperprolactinemia",
      "Growth hormone deficiency",
      "Abnormal arterial blood gases showing hypercapnia during sleep"
    ],
    "imaging": [
      "Brain MRI typically normal or may show hypothalamic abnormalities",
      "Chest imaging may show atelectasis or hypoventilation-related changes",
      "Abdominal imaging to screen for neuroendocrine tumors"
    ],
    "genetic": [
      "No consistent causative mutations identified; genetic testing mainly to exclude other syndromes"
    ],
    "other": [
      "Polysomnography demonstrating central hypoventilation",
      "Autonomic testing showing impaired pupillary reflexes and abnormal heart rate variability"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-central-hypoventilation-syndrome",
      "distinguishingFeatures": [
        "Onset typically neonatal",
        "PHOX2B gene mutations present",
        "Lack of rapid-onset obesity"
      ]
    },
    {
      "diseaseId": "prader-willi-syndrome",
      "distinguishingFeatures": [
        "Characteristic facial features",
        "Hypotonia in infancy",
        "Genetic confirmation by 15q11-q13 deletion or imprinting defects"
      ]
    },
    {
      "diseaseId": "leptin-receptor-deficiency-obesity",
      "distinguishingFeatures": [
        "Early-onset obesity with hyperphagia",
        "No hypoventilation or autonomic dysfunction",
        "Genetic testing positive for LEPR mutations"
      ]
    }
  ],
  "redFlags": [
    "Rapid unexplained weight gain in early childhood",
    "Signs of hypoventilation such as cyanosis or apnea during sleep",
    "Autonomic instability including temperature dysregulation or abnormal pupillary responses"
  ],
