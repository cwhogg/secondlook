    "formalCriteriaName": "Clinical diagnostic criteria for Amelo-onycho-hypohidrotic syndrome",
    "criteria": [
      {
        "id": "hypohidrosis",
        "description": "Reduced or absent sweating (hypohidrosis or anhidrosis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "amelogenesis-imperfecta",
        "description": "Enamel hypoplasia or amelogenesis imperfecta leading to abnormal tooth development",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "onychodysplasia",
        "description": "Nail dystrophy or hypoplasia affecting fingernails and toenails",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sparse-hair",
        "description": "Sparse, thin, or brittle scalp hair",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-features",
        "description": "Characteristic facial features including frontal bossing and midface hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: hypohidrosis, enamel hypoplasia (amelogenesis imperfecta), and nail dystrophy",
    "notes": "Genetic testing for mutations in ectodermal development genes may support diagnosis"
  },
