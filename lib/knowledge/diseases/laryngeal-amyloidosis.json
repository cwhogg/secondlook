  },
  "diagnosticCriteria": {
    "formalCriteriaName": "No formal standardized criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Demonstration of amyloid deposits in laryngeal biopsy with Congo red staining showing apple-green birefringence under polarized light",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of persistent hoarseness or voice changes with or without airway obstruction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-systemic",
        "description": "Exclusion of systemic amyloidosis by appropriate systemic workup (e.g., serum and urine protein electrophoresis, fat pad biopsy)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Laryngoscopic visualization of submucosal masses or plaques in the larynx",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of amyloid deposits in the larynx combined with compatible clinical presentation and exclusion of systemic amyloidosis",
    "notes": "Diagnosis relies heavily on biopsy and exclusion of systemic involvement."
  },
