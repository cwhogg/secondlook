    "criteria": [
      {
        "id": "horizontal-gaze-palsy",
        "description": "Congenital absence or severe limitation of horizontal eye movements with preserved vertical gaze",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-scoliosis",
        "description": "Progressive scoliosis developing in early childhood or adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brainstem-mri-findings",
        "description": "Characteristic brainstem malformation on MRI including butterfly-shaped medulla and absence of facial colliculi",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "robo3-mutation",
        "description": "Identification of biallelic pathogenic variants in the ROBO3 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital horizontal gaze palsy and progressive scoliosis with supportive brainstem MRI findings",
    "notes": "Genetic testing for ROBO3 mutations can confirm diagnosis but is not mandatory if clinical and imaging criteria are met."
