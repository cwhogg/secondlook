  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for HSAN Type IV",
    "criteria": [
      {
        "id": "congenital-insensitivity-pain",
        "description": "Congenital insensitivity to pain and temperature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anhidrosis",
        "description": "Anhidrosis leading to recurrent hyperthermia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ntrk1-mutation",
        "description": "Identification of pathogenic mutations in the NTRK1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-sweat-response",
        "description": "Absent or severely reduced sweat response on quantitative sudomotor axon reflex testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Nerve biopsy showing loss of small myelinated and unmyelinated fibers",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital insensitivity to pain and anhidrosis with confirmed NTRK1 mutation",
    "notes": "Clinical diagnosis is supported by genetic testing and neurophysiological studies."
  },
