  "diagnosticCriteria": {
    "formalCriteriaName": "Baltimore Criteria",
    "criteria": [
      {
        "id": "bilirubin-elevation",
        "description": "Serum bilirubin ≥ 2 mg/dL within 21 days post-transplant",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepatomegaly",
        "description": "Tender hepatomegaly or right upper quadrant pain",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "weight-gain",
        "description": "Unexplained weight gain >5% due to fluid retention",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ascites",
        "description": "Presence of ascites confirmed clinically or radiologically",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "jaundice",
        "description": "Clinical jaundice",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (bilirubin elevation, hepatomegaly, and weight gain) within 21 days post bone marrow transplant",
    "notes": "Diagnosis is clinical; liver biopsy is rarely performed due to bleeding risk."
  },
