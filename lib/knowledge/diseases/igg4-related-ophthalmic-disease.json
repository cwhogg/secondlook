  "keyFindings": {
    "laboratory": [
      "Elevated serum IgG4 concentration (>135 mg/dL)",
      "Mildly elevated inflammatory markers (ESR, CRP) in some cases"
    ],
    "imaging": [
      "Orbital MRI or CT showing lacrimal gland enlargement, extraocular muscle enlargement, or orbital masses",
      "Characteristic homogeneous enhancement of involved tissues"
    ],
    "genetic": [
      "No specific genetic markers identified"
    ],
    "other": [
      "Histopathology showing dense lymphoplasmacytic infiltrate rich in IgG4-positive plasma cells, storiform fibrosis, and obliterative phlebitis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "orbital-inflammatory-pseudotumor",
      "distinguishingFeatures": [
        "More acute onset with pain",
        "Lack of elevated serum IgG4",
        "Histopathology without storiform fibrosis or IgG4 plasma cell predominance"
      ]
    },
    {
      "diseaseId": "orbital-lymphoma",
      "distinguishingFeatures": [
        "Monoclonal lymphoid proliferation on biopsy",
        "Absence of storiform fibrosis",
        "No elevated serum IgG4"
      ]
    },
    {
      "diseaseId": "thyroid-eye-disease",
      "distinguishingFeatures": [
        "Associated thyroid dysfunction",
        "Extraocular muscle belly enlargement sparing tendinous insertions",
        "No IgG4 elevation or characteristic histopathology"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive vision loss",
    "Severe orbital pain with systemic signs of infection",
    "Signs of optic nerve compression or ischemia"
  ],
  "specialistType": [
    "Ophthalmologist",
    "Rheumatologist",
    "Immunologist"
  ],
