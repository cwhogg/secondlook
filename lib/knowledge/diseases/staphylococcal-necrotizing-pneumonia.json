  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Necrotizing Pneumonia",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Acute onset of severe respiratory symptoms including high fever, productive cough with purulent or hemorrhagic sputum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Chest imaging showing cavitary lung lesions with areas of necrosis and consolidation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microbiological-confirmation",
        "description": "Isolation of Staphylococcus aureus from respiratory secretions or blood cultures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "laboratory-markers",
        "description": "Elevated inflammatory markers such as leukocytosis and elevated C-reactive protein",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-pathogens",
        "description": "Exclusion of other common causes of necrotizing pneumonia such as Klebsiella or anaerobic bacteria",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acute severe respiratory symptoms, characteristic imaging findings of necrotizing pneumonia, and microbiological confirmation of Staphylococcus aureus",
    "notes": "Early diagnosis is critical due to rapid progression and high mortality risk."
  },
