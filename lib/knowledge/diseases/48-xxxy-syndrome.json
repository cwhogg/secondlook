  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnosis of 48,XXXY Syndrome",
    "criteria": [
      {
        "id": "karyotype-confirmation",
        "description": "Presence of 48,XXXY karyotype confirmed by chromosomal analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogonadism",
        "description": "Clinical evidence of hypergonadotropic hypogonadism with small testes and low testosterone",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Characteristic facial dysmorphisms including hypertelorism and epicanthal folds",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Radiological evidence of skeletal anomalies such as clinodactyly or radioulnar synostosis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed 48,XXXY karyotype plus clinical features of hypogonadism and developmental delay",
    "notes": "Diagnosis relies primarily on cytogenetic confirmation; clinical features support but are variable."
  },
