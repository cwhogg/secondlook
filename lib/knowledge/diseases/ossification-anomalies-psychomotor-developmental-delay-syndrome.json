  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Ossification Anomalies-Psychomotor Developmental Delay Syndrome",
    "criteria": [
      {
        "id": "ossification-anomalies",
        "description": "Radiologically confirmed anomalies in bone ossification patterns",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "psychomotor-delay",
        "description": "Developmental delay in motor and cognitive milestones documented by standardized assessments",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial abnormalities such as frontal bossing or midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-signs",
        "description": "Neurological abnormalities including hypotonia or spasticity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (ossification anomalies and psychomotor developmental delay) with or without minor/supportive criteria",
    "notes": "Diagnosis is primarily clinical supported by radiological findings; genetic testing may assist but is not definitive."
  },
