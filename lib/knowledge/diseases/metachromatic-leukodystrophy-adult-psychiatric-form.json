  "diagnosticCriteria": {
    "formalCriteriaName": "Metachromatic Leukodystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-psychiatric-symptoms",
        "description": "Adult-onset psychiatric symptoms including psychosis, personality changes, and cognitive decline",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "arylsulfatase-a-deficiency",
        "description": "Reduced arylsulfatase A enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging-demyelination",
        "description": "MRI evidence of symmetrical demyelination in cerebral white matter",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the ARSA gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "metachromatic-granules",
        "description": "Presence of metachromatic granules in nerve or urine samples",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of adult-onset psychiatric symptoms plus either reduced arylsulfatase A enzyme activity or characteristic MRI findings",
    "notes": "Genetic confirmation is supportive but not mandatory if clinical and biochemical criteria are met."
  },
