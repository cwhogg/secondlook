  "diagnosticCriteria": {
    "formalCriteriaName": "Spinocerebellar Ataxia Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with gait disturbance and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the EEF2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-ataxias",
        "description": "Exclusion of other causes of ataxia including metabolic, autoimmune, and acquired etiologies",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive cerebellar ataxia with genetic confirmation of EEF2 mutation and exclusion of other ataxia causes",
    "notes": "Genetic testing is essential for definitive diagnosis due to phenotypic overlap with other SCAs."
  },
