        "description": "Clinical or laboratory evidence of jaundice",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-dysfunction",
        "description": "Elevated serum creatinine or acute kidney injury",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acute febrile illness plus positive Leptospira serology",
    "notes": "Diagnosis is supported by epidemiological exposure and clinical features; PCR may be used in early disease."
  },
