  "keyFindings": {
    "laboratory": [
      "Elevated serum creatinine and blood urea nitrogen indicating renal failure",
      "Urinalysis showing isosthenuria and mild proteinuria",
      "Anemia of chronic disease"
    ],
    "imaging": [
      "Renal ultrasound showing corticomedullary cysts and small echogenic kidneys",
      "Ophthalmologic imaging revealing retinal pigmentary changes and optic nerve pallor"
    ],
    "genetic": [
      "DYNC2LI1 (causative)",
      "GLI1 (causative, loss-of-function)",
      "EVC2 (causative)",
      "EVC (causative)",
      "PRKACA (causative)",
      "PRKACB (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Renal biopsy demonstrating tubulointerstitial fibrosis and tubular basement membrane disruption"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "nephronophthisis",
      "distinguishingFeatures": [
        "Absence of retinal degeneration",
        "Isolated renal involvement without ocular symptoms"
      ]
    },
    {
      "diseaseId": "bardet-biedl-syndrome",
      "distinguishingFeatures": [
        "Presence of polydactyly and obesity",
        "Cognitive impairment and hypogonadism",
        "Retinal dystrophy with renal involvement but additional systemic features"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive renal failure in a child or adolescent",
