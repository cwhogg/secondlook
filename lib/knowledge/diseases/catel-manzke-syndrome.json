        "requiredForDiagnosis": true
      },
      {
        "id": "hyperphalangy",
        "description": "Hyperphalangy of the index finger with radial deviation (Manzke dysplasia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cleft-palate",
        "description": "Cleft palate or submucous cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
