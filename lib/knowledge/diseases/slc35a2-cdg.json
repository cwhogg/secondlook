  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed diagnostic criteria for SLC35A2-CDG",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the SLC35A2 gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-glycosylation",
        "description": "Demonstration of abnormal N-linked glycosylation pattern on serum transferrin analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic neurological and developmental features including infantile-onset epilepsy and developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-lab",
        "description": "Additional supportive laboratory findings such as abnormal glycan profiles in fibroblasts",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic SLC35A2 variant plus abnormal transferrin glycosylation and compatible clinical phenotype",
    "notes": "Molecular confirmation is essential due to phenotypic overlap with other CDGs"
  },
