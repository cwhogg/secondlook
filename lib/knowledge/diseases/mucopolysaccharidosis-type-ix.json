  "diagnosticCriteria": {
    "formalCriteriaName": "No formal diagnostic criteria established",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of deficient hyaluronidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of joint abnormalities including joint swelling and limited range of motion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Identification of soft tissue masses composed of mucopolysaccharide accumulation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient hyaluronidase enzyme activity plus characteristic joint abnormalities",
    "notes": "Genetic testing for HYAL1 mutations can support diagnosis but is not always available"
  },
