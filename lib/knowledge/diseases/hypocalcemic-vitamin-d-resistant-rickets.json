  "keyFindings": {
    "laboratory": [
      "Hypophosphatemia with low tubular phosphate reabsorption",
      "Normal or low-normal serum calcium",
      "Elevated serum alkaline phosphatase",
      "Normal or low 1,25-dihydroxyvitamin D levels"
    ],
    "imaging": [
      "Metaphyseal cupping, fraying, and widening on X-rays",
      "Bowing of long bones",
      "Possible craniosynostosis on skull imaging"
    ],
    "genetic": [
      "VDR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Poor response to vitamin D supplementation",
      "Dental abnormalities including defective dentin and frequent abscesses"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "nutritional-rickets",
