  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Tumors of the Central Nervous System (2021)",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of rhabdoid cells with eosinophilic cytoplasm and eccentric nuclei on histopathological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Loss of INI1 (SMARCB1) protein expression by immunohistochemistry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Detection of SMARCB1 or SMARCA4 gene mutations or deletions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-features",
        "description": "Imaging showing aggressive, poorly circumscribed mass often in kidney, brain, or soft tissues",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological identification of rhabdoid cells plus loss of INI1 expression or SMARCB1/SMARCA4 mutation",
    "notes": "Diagnosis requires integration of histology, immunohistochemistry, and genetic testing due to overlap with other tumors."
  },
