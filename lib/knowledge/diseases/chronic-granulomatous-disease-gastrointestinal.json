  "keyFindings": {
    "laboratory": [
      "Abnormal dihydrorhodamine (DHR) or nitroblue tetrazolium (NBT) test indicating defective neutrophil oxidative burst",
      "Elevated inflammatory markers (ESR, CRP)",
      "Leukocytosis during infections"
    ],
    "imaging": [
      "Bowel wall thickening and strictures on abdominal CT or MRI",
      "Granulomatous lesions visible on endoscopy",
      "Hepatosplenomegaly on ultrasound"
    ],
    "genetic": [
      "Pathogenic mutations in CYBB (X-linked), CYBA, NCF1, NCF2, or NCF4 genes"
    ],
