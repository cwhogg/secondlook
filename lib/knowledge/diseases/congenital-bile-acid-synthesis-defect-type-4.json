  "keyFindings": {
    "laboratory": [
      "Elevated conjugated bilirubin",
      "Abnormal bile acid profile with atypical intermediates on mass spectrometry",
      "Prolonged prothrombin time due to vitamin K deficiency",
      "Elevated liver transaminases (ALT, AST)"
    ],
    "imaging": [
      "Hepatomegaly on abdominal ultrasound",
      "Signs of hepatic fibrosis or cirrhosis on elastography or MRI"
    ],
    "genetic": [
      "AMACR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology showing giant cell hepatitis and cholestasis on liver biopsy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "progressive familial intrahepatic-cholestasis",
      "distinguishingFeatures": [
        "Different genetic mutations (e.g., ATP8B1, ABCB11)",
        "Absence of atypical bile acid intermediates",
        "Earlier onset of severe pruritus"
      ]
    },
    {
      "diseaseId": "alpha-1-antitrypsin-deficiency",
