  "diagnosticCriteria": {
    "formalCriteriaName": "Paris Criteria for Overlap Syndromes",
    "criteria": [
      {
        "id": "cholestatic-liver-enzyme-elevation",
        "description": "Elevated alkaline phosphatase (ALP) and gamma-glutamyl transferase (GGT) indicating cholestasis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoimmune-hepatitis-serology",
        "description": "Presence of autoantibodies such as anti-smooth muscle antibody (ASMA) or anti-nuclear antibody (ANA) with elevated serum IgG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histological-evidence",
        "description": "Liver biopsy showing interface hepatitis with bile duct injury and periductal fibrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-evidence",
        "description": "Cholangiographic features consistent with primary sclerosing cholangitis such as multifocal bile duct strictures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of cholestatic liver enzyme elevation, autoimmune hepatitis serology, and histological evidence of interface hepatitis with bile duct injury",
    "notes": "Diagnosis requires integration of clinical, serological, histological, and imaging findings to confirm overlap of PBC, PSC, and AIH features."
  },
