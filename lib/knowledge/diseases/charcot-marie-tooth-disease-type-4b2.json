  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnostic criteria for CMT4B2",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Progressive distal muscle weakness and atrophy with sensory loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-conduction-velocity",
        "description": "Markedly reduced motor and sensory nerve conduction velocities consistent with demyelinating neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "myotubularin-2-mutation",
        "description": "Identification of pathogenic mutations in the MTMR2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-biopsy",
        "description": "Nerve biopsy showing myelin outfoldings and tomacula formation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical neuropathy with demyelinating nerve conduction studies plus identification of pathogenic MTMR2 mutation",
    "notes": "Nerve biopsy is supportive but not mandatory if genetic confirmation is obtained."
  },
