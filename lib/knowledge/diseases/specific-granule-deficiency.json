  "diagnosticCriteria": {
    "formalCriteriaName": "Specific Granule Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "absent-specific-granules",
        "description": "Absence or severe reduction of neutrophil specific granules on electron microscopy or cytochemical staining",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-bacterial-infections",
        "description": "History of recurrent severe bacterial infections, especially skin and respiratory tract infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-neutrophil-count",
        "description": "Normal or mildly reduced neutrophil count despite functional defects",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in the CEBPE gene or related genes affecting granule formation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of absent specific granules on neutrophil examination plus recurrent bacterial infections",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory"
  },
