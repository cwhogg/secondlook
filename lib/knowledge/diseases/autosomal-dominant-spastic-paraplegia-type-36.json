  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "CSF analysis typically unremarkable"
    ],
    "imaging": [
      "MRI brain and spinal cord may show mild corticospinal tract atrophy",
      "No significant white matter lesions"
    ],
    "genetic": [
      "SPG36 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography (EMG) may show mild chronic neurogenic changes",
      "Nerve conduction studies usually normal or mildly reduced sensory nerve action potentials"
    ]
  },
