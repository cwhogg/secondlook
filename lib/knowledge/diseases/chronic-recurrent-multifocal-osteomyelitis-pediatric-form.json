        "Response to antibiotics"
      ]
    },
    {
      "diseaseId": "juvenile-idiopathic-arthritis",
      "distinguishingFeatures": [
        "Primary joint involvement rather than bone lesions",
        "Presence of rheumatoid factor or ANA in some subtypes",
        "Different imaging findings without multifocal bone lesions"
      ]
    },
