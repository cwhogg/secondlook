  "diagnosticCriteria": {
    "formalCriteriaName": "Jansson Criteria for CRMO",
    "criteria": [
      {
        "id": "multifocal-lesions",
        "description": "Presence of multifocal bone lesions on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sterile-bone-inflammation",
        "description": "Histopathological evidence of sterile bone inflammation without bacterial infection",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-bone-pain",
        "description": "Recurrent episodes of localized bone pain and swelling",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-pathogenic-organisms",
        "description": "Negative microbiological cultures from bone biopsy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-immunologic-markers",
        "description": "Lack of systemic infection or immunodeficiency markers",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multifocal sterile bone inflammation with recurrent symptoms and exclusion of infectious causes",
    "notes": "Diagnosis is clinical and radiological, supported by biopsy and exclusion of infection and malignancy"
  },
