  "diagnosticCriteria": {
    "formalCriteriaName": "Chrousos Diagnostic Criteria for Glucocorticoid Resistance",
    "criteria": [
      {
        "id": "elevated-cortisol",
        "description": "Elevated serum cortisol levels with normal or increased ACTH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glucocorticoid-receptor-mutation",
        "description": "Identification of mutations in the glucocorticoid receptor gene (NR3C1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical signs consistent with glucocorticoid resistance such as hypertension and hypokalemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dexamethasone-suppression-test",
        "description": "Lack of suppression of cortisol secretion after dexamethasone administration",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "increased-androgen-levels",
        "description": "Elevated adrenal androgens or mineralocorticoid activity markers",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated cortisol with normal/increased ACTH, clinical features of glucocorticoid resistance, and confirmed glucocorticoid receptor mutation",
    "notes": "Diagnosis requires exclusion of other causes of hypercortisolism and mineralocorticoid excess."
  },
