  "diagnosticCriteria": {
    "formalCriteriaName": "MADD Diagnostic Criteria",
    "criteria": [
      {
        "id": "biochemical-profile",
        "description": "Elevated plasma acylcarnitines and urinary organic acids consistent with fatty acid oxidation defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in ETFA, ETFB, or ETFDH genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of metabolic crises with hypoglycemia, muscle weakness, or cardiomyopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-assay",
        "description": "Reduced activity of multiple acyl-CoA dehydrogenases in fibroblasts or muscle tissue",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of typical clinical presentation plus confirmatory biochemical profile and/or genetic testing",
    "notes": "Diagnosis may be supported by enzyme assay but is not mandatory."
  },
