  "diagnosticCriteria": {
    "formalCriteriaName": "Barakat Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypoparathyroidism",
        "description": "Biochemical evidence of hypoparathyroidism with hypocalcemia and low or inappropriately normal parathyroid hormone levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-deafness",
        "description": "Bilateral sensorineural hearing loss confirmed by audiometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-anomalies",
        "description": "Structural or functional renal abnormalities including renal dysplasia, hypoplasia, or renal tubular acidosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypoparathyroidism, sensorineural deafness, and renal disease",
    "notes": "Genetic testing for GATA3 mutations can confirm diagnosis"
  },
