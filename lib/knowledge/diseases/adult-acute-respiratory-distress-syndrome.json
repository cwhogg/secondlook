  "diagnosticCriteria": {
    "formalCriteriaName": "Berlin Definition",
    "criteria": [
      {
        "id": "timing",
        "description": "Onset within 1 week of a known clinical insult or new/worsening respiratory symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Bilateral opacities on chest imaging not fully explained by effusions, lobar/lung collapse, or nodules",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "origin-of-edema",
        "description": "Respiratory failure not fully explained by cardiac failure or fluid overload",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oxygenation",
        "description": "Impaired oxygenation defined by PaO2/FiO2 ratio ≤ 300 mmHg with PEEP or CPAP ≥ 5 cm H2O",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "All four major criteria must be met including timing, imaging, origin of edema, and oxygenation impairment",
    "notes": "Severity of ARDS is classified based on PaO2/FiO2 ratio into mild, moderate, and severe"
  },
