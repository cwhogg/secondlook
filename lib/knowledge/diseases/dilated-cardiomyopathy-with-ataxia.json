  "keyFindings": {
    "laboratory": [
      "Elevated serum lactate during metabolic stress",
      "Mild elevation of liver transaminases",
      "Normal to mildly elevated creatine kinase"
    ],
    "imaging": [
      "Echocardiogram showing dilated left ventricle with reduced ejection fraction",
      "Brain MRI demonstrating cerebellar atrophy"
    ],
    "genetic": [
      "DNAJC19 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Audiometric confirmation of sensorineural hearing loss",
      "Electromyography showing mild myopathic changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "friedreich-ataxia",
      "distinguishingFeatures": [
        "Presence of hypertrophic rather than dilated cardiomyopathy",
        "GAA trinucleotide repeat expansion in FXN gene",
        "Onset typically in adolescence"
      ]
    },
    {
      "diseaseId": "barth-syndrome",
      "distinguishingFeatures": [
        "X-linked inheritance pattern",
        "Neutropenia and skeletal myopathy",
        "Mutations in TAZ gene"
      ]
    },
    {
      "diseaseId": "mitochondrial-myopathy-with-cardiomyopathy",
      "distinguishingFeatures": [
        "Variable neurological involvement",
        "Multiple mitochondrial DNA mutations",
        "Lactic acidosis more prominent"
      ]
    }
  ],
  "redFlags": [
