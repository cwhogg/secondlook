  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of a microdeletion at chromosome 8q24.3 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Presence of characteristic craniofacial dysmorphic features such as micrognathia and hypertelorism",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 8q24.3 microdeletion plus presence of developmental delay",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support but are variable."
  },
