  "keyFindings": {
    "laboratory": [
      "Molecular genetic testing identifying somatic PIK3CA activating mutations in affected tissue"
    ],
    "imaging": [
      "MRI showing asymmetric soft tissue and bone overgrowth",
      "Doppler ultrasound demonstrating vascular malformations",
      "CT or MRI angiography for detailed vascular mapping"
    ],
    "genetic": [
      "HTT (causative, gain-of-function)",
      "SLC2A3 (modifier)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology of affected tissue showing vascular malformations and cellular overgrowth"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "proteus-syndrome",
      "distinguishingFeatures": [
        "AKT1 mutations instead of PIK3CA",
        "More widespread and progressive overgrowth",
        "Cerebriform connective tissue nevi"
      ]
    },
    {
      "diseaseId": "klippel-trenaunay-syndrome",
      "distinguishingFeatures": [
        "Triad of capillary malformation, venous malformation, and limb hypertrophy",
        "No confirmed PIK3CA mutation in all cases",
        "Usually involves entire limb rather than segmental overgrowth"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of overgrowth causing functional impairment",
    "Development of thromboembolic complications",
    "Signs of visceral organ involvement or neurological symptoms"
  ],
