  "diagnosticCriteria": {
    "formalCriteriaName": "XLAG Diagnostic Criteria",
    "criteria": [
      {
        "id": "early-onset-gigantism",
        "description": "Onset of gigantism symptoms before 5 years of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gpr101-duplication",
        "description": "Presence of GPR101 gene duplication or mutation confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pituitary-hyperplasia",
        "description": "Evidence of pituitary hyperplasia or adenoma on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-gh-igf1",
        "description": "Elevated growth hormone (GH) and insulin-like growth factor 1 (IGF-1) levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-causes",
        "description": "Exclusion of other causes of gigantism such as pituitary adenomas without GPR101 abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset gigantism plus confirmed GPR101 gene duplication or mutation and pituitary hyperplasia or adenoma on imaging",
    "notes": "Genetic testing for GPR101 duplication is critical for definitive diagnosis."
  },
