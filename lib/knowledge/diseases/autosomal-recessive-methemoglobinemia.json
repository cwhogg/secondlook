  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for Autosomal Recessive Methemoglobinemia",
    "criteria": [
      {
        "id": "methemoglobin-elevation",
        "description": "Persistent elevated methemoglobin levels >10% in blood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cytochrome-b5-reductase-deficiency",
        "description": "Demonstration of cytochrome b5 reductase enzyme deficiency in erythrocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in CYB5R3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-cyanosis",
        "description": "Central cyanosis unresponsive to oxygen therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-impairment",
        "description": "Neurological symptoms such as developmental delay or intellectual disability (type II)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent elevated methemoglobin >10%, cytochrome b5 reductase deficiency, and biallelic pathogenic variants in CYB5R3 gene",
    "notes": "Type I presents with cyanosis only; Type II includes severe neurological impairment."
  },
