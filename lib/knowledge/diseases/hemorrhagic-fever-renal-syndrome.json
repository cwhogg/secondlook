  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Laboratory Diagnostic Criteria for Hemorrhagic Fever with Renal Syndrome",
    "criteria": [
      {
        "id": "febrile-phase",
        "description": "Sudden onset of high fever lasting 3-7 days",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-involvement",
        "description": "Evidence of acute kidney injury with proteinuria and hematuria",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemorrhagic-symptoms",
        "description": "Presence of petechiae, conjunctival hemorrhage, or bleeding manifestations",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "serology",
        "description": "Positive hantavirus-specific IgM or IgG antibodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thrombocytopenia",
        "description": "Laboratory evidence of thrombocytopenia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of febrile phase, renal involvement, and positive hantavirus serology",
    "notes": "Diagnosis is supported by epidemiological exposure to rodent habitats and exclusion of other causes of acute renal failure and hemorrhagic fever."
  },
