  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Vernal Keratoconjunctivitis",
    "criteria": [
      {
        "id": "chronic-seasonal-conjunctivitis",
        "description": "Chronic bilateral conjunctival inflammation with seasonal exacerbations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "giant-papillae",
        "description": "Presence of giant papillae on the upper tarsal conjunctiva",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limbal-infiltrates",
        "description": "Limbal papillae or Horner-Trantas dots (eosinophilic infiltrates at limbus)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "itching",
        "description": "Severe ocular itching",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "photophobia",
        "description": "Photophobia and tearing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic bilateral conjunctivitis with giant papillae on the upper tarsal conjunctiva and seasonal exacerbations",
    "notes": "Diagnosis is clinical; exclusion of other allergic or infectious conjunctivitides is important"
  },
