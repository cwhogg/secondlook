  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Mitochondrial Hypertrophic Cardiomyopathy with Kidney Anomalies",
    "criteria": [
      {
        "id": "cardiac-hypertrophy",
        "description": "Echocardiographic evidence of unexplained left ventricular hypertrophy consistent with hypertrophic cardiomyopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-anomalies",
        "description": "Presence of structural or functional kidney anomalies confirmed by imaging or biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mtDNA-mutation",
        "description": "Identification of pathogenic mitochondrial DNA mutation associated with the phenotype",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of mitochondrial disease or cardiomyopathy with renal involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "lactic-acidosis",
        "description": "Elevated blood or CSF lactate levels indicating mitochondrial dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: hypertrophic cardiomyopathy, kidney anomalies, and confirmed pathogenic mitochondrial DNA mutation",
    "notes": "Diagnosis requires exclusion of other causes of hypertrophic cardiomyopathy and renal malformations."
  },
