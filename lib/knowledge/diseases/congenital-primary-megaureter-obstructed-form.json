        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-vesicoureteral-reflux",
        "description": "Exclusion of vesicoureteral reflux on voiding cystourethrogram",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presentation with antenatal hydronephrosis or recurrent urinary tract infections",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of ureteral dilation with functional obstruction at the distal ureter and exclusion of vesicoureteral reflux",
    "notes": "Diagnosis is primarily based on imaging studies combined with clinical presentation."
