  "diagnosticCriteria": {
    "formalCriteriaName": "Scimitar Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "anomalous-pulmonary-vein",
        "description": "Presence of an anomalous pulmonary venous drainage of the right lung into the inferior vena cava (scimitar vein)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "right-lung-hypoplasia",
        "description": "Hypoplasia or underdevelopment of the right lung",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiovascular-malformations",
        "description": "Associated cardiovascular anomalies such as atrial septal defect or pulmonary artery hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of anomalous pulmonary venous drainage into the inferior vena cava and right lung hypoplasia",
    "notes": "Diagnosis is confirmed by imaging demonstrating the characteristic scimitar vein and associated lung hypoplasia."
  },
