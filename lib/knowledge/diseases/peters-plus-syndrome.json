  "differentialDiagnoses": [
    {
      "diseaseId": "peters-anomaly-isolated",
      "distinguishingFeatures": [
        "Absence of systemic features such as short stature and brachydactyly",
        "No B3GALTL mutations"
      ]
    },
    {
      "diseaseId": "aniridia",
      "distinguishingFeatures": [
        "Absence or hypoplasia of the iris rather than corneal opacity",
        "Different genetic etiology (PAX6 mutations)"
      ]
    },
    {
      "diseaseId": "axenfeld-rieger-syndrome",
      "distinguishingFeatures": [
        "Anterior segment dysgenesis with dental and facial anomalies",
        "Mutations in PITX2 or FOXC1 genes"
      ]
    }
  ],
