  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for MODY",
    "criteria": [
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with diabetes in at least three consecutive generations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-onset",
        "description": "Onset of hyperglycemia typically before 25-35 years of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-autoantibodies",
        "description": "Lack of pancreatic autoantibodies (e.g., GAD, IA-2) to exclude type 1 diabetes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in one of the MODY-associated genes (e.g., HNF1A, GCK, HNF4A)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "insulin-independence",
        "description": "Preserved endogenous insulin secretion and absence of ketoacidosis at diagnosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset diabetes with autosomal dominant family history, absence of autoantibodies, and confirmation by genetic testing",
    "notes": "Genetic testing is essential for definitive diagnosis and subtype classification."
  },
