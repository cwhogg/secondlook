  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Dopa-Responsive Dystonia",
    "criteria": [
      {
        "id": "diurnal-fluctuation",
        "description": "Presence of diurnal fluctuation of dystonia symptoms with worsening in the evening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "levodopa-response",
        "description": "Marked and sustained improvement of dystonia symptoms with low-dose levodopa therapy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "childhood-onset",
        "description": "Onset of symptoms typically in childhood or adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-parkinsonism",
        "description": "Lack of significant parkinsonian features such as resting tremor or rigidity",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of dystonia or parkinsonism may support diagnosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of childhood-onset dystonia with diurnal fluctuation and marked improvement on levodopa",
    "notes": "Genetic testing for GCH1 mutations can confirm diagnosis but is not mandatory"
  },
