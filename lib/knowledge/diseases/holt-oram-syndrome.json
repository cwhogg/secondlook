  "diagnosticCriteria": {
    "formalCriteriaName": "Holt-Oram Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "upper-limb-malformations",
        "description": "Presence of congenital upper limb malformations including radial ray defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital heart defects, especially atrial septal defect or ventricular septal defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tbx5-mutation",
        "description": "Identification of pathogenic mutation in the TBX5 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history of Holt-Oram syndrome or related cardiac and limb anomalies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital upper limb malformations and congenital heart defects, with or without TBX5 mutation confirmation",
    "notes": "Genetic testing for TBX5 mutations supports diagnosis but is not mandatory if clinical features are definitive"
  },
