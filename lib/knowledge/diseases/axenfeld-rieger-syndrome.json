  "diagnosticCriteria": {
    "formalCriteriaName": "Axenfeld-Rieger Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "anterior-segment-dysgenesis",
        "description": "Presence of anterior segment dysgenesis including posterior embryotoxon and iris stromal hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glaucoma",
        "description": "Development of glaucoma or elevated intraocular pressure",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "systemic-features",
        "description": "Presence of systemic anomalies such as dental hypodontia, maxillary hypoplasia, or umbilical abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of anterior segment dysgenesis plus either systemic anomalies or glaucoma",
    "notes": "Genetic testing for PITX2 or FOXC1 mutations can support diagnosis"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Posterior embryotoxon",
        "frequency": 0.85,
        "bodySystem": "ophthalmological",
        "notes": "Prominent anteriorly displaced Schwalbe's line visible on slit-lamp exam"
      },
      {
        "symptomName": "Iris stromal hypoplasia with corectopia",
        "frequency": 0.75,
        "bodySystem": "ophthalmological",
        "notes": "Iris thinning and displacement of the pupil",
        "searchTerms": [
          "abnormal iris shape",
          "displaced pupil",
          "thin iris tissue with pupil off-center"
        ]
      }
    ],
    "common": [
      {
        "symptomName": "Glaucoma",
        "frequency": 0.65,
        "bodySystem": "ophthalmological",
        "notes": "Elevated intraocular pressure leading to optic nerve damage"
      },
      {
        "symptomName": "Dental hypodontia",
        "frequency": 0.6,
        "bodySystem": "constitutional",
        "notes": "Missing or malformed teeth"
      },
      {
        "symptomName": "Maxillary hypoplasia",
        "frequency": 0.55,
        "bodySystem": "musculoskeletal",
        "notes": "Underdevelopment of the upper jaw"
      },
      {
        "symptomName": "Umbilical anomalies",
        "frequency": 0.5,
        "bodySystem": "constitutional",
        "notes": "Redundant periumbilical skin or umbilical hernia"
      }
    ],
    "occasional": [
      {
        "symptomName": "Hypertelorism",
        "frequency": 0.4,
        "bodySystem": "musculoskeletal",
        "notes": "Increased distance between the eyes"
      },
      {
        "symptomName": "Cardiac malformations",
        "frequency": 0.25,
        "bodySystem": "cardiovascular",
        "notes": "Congenital heart defects such as septal defects"
      },
      {
        "symptomName": "Hearing loss",
        "frequency": 0.2,
        "bodySystem": "otolaryngological",
        "notes": "Sensorineural or conductive hearing impairment"
      },
      {
        "symptomName": "Skin hypopigmentation",
        "frequency": 0.15,
        "bodySystem": "dermatological",
        "notes": "Areas of decreased skin pigmentation"
      }
    ],
    "rare": [
      {
        "symptomName": "Psychiatric manifestations",
        "frequency": 0.05,
        "bodySystem": "psychiatric",
        "notes": "Rare reports of developmental delay or behavioral issues"
      },
      {
        "symptomName": "Renal anomalies",
        "frequency": 0.03,
        "bodySystem": "renal",
        "notes": "Rare congenital kidney malformations"
      },
      {
        "symptomName": "Cleft palate",
        "frequency": 0.02,
        "bodySystem": "musculoskeletal",
        "notes": "Rare orofacial clefting"
      }
    ]
  },
