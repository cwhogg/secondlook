  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological Diagnostic Criteria for Collagenous Colitis",
    "criteria": [
      {
        "id": "chronic_diarrhea",
        "description": "Presence of chronic watery, non-bloody diarrhea lasting more than 4 weeks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histology_collagen_layer",
        "description": "Biopsy showing thickened subepithelial collagen band >10 µm in colonic mucosa",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "inflammatory_infiltrate",
        "description": "Increased intraepithelial lymphocytes and lamina propria inflammatory infiltrate",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal_endoscopic_appearance",
        "description": "Normal or near-normal colonoscopy findings",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Chronic watery diarrhea plus histological evidence of thickened subepithelial collagen band on colonic biopsy",
    "notes": "Diagnosis requires exclusion of other causes of chronic diarrhea and microscopic colitis subtypes."
  },
