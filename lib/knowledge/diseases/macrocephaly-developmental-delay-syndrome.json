  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Macrocephaly-Developmental Delay Syndrome",
    "criteria": [
      {
        "id": "macrocephaly",
        "description": "Head circumference greater than 2 standard deviations above the mean for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay affecting motor and cognitive milestones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent forehead and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Generalized hypotonia observed during clinical examination",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variant in associated gene(s) if known",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of macrocephaly and developmental delay with at least one additional minor or supportive criterion",
    "notes": "Genetic testing may aid diagnosis but is not mandatory; clinical presentation is primary."
  },
