  "diagnosticCriteria": {
    "formalCriteriaName": "Blake Criteria",
    "criteria": [
      {
        "id": "coloboma",
        "description": "Presence of ocular coloboma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "choanal-atresia",
        "description": "Congenital choanal atresia or stenosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cranial-nerve-anomalies",
        "description": "Cranial nerve dysfunction including facial palsy or swallowing difficulties",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "heart-defects",
        "description": "Congenital heart defects",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genital-anomalies",
        "description": "Hypogonadism or genital hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth deficiency",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ear-anomalies",
        "description": "External ear anomalies or hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all 4 major criteria or 3 major plus 3 minor criteria",
    "notes": "Genetic testing for CHD7 mutations supports diagnosis but is not mandatory"
  },
