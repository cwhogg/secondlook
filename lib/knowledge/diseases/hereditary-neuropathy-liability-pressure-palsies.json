  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electrophysiological Diagnostic Criteria for HNPP",
    "criteria": [
      {
        "id": "recurrent-pressure-palsies",
        "description": "Recurrent, transient focal neuropathies precipitated by minor trauma or compression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiological-findings",
        "description": "Electrophysiological evidence of demyelinating neuropathy with conduction block at common entrapment sites",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of PMP22 gene deletion or mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of similar neuropathic episodes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent pressure palsies plus electrophysiological evidence and/or genetic confirmation",
    "notes": "Genetic testing is confirmatory; electrophysiological studies are essential for diagnosis."
  },
