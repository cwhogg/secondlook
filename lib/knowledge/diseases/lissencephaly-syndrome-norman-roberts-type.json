  "differentialDiagnoses": [
    {
      "diseaseId": "lissencephaly-syndrome-miller-dieker-type",
      "distinguishingFeatures": [
        "Presence of facial dysmorphism including prominent forehead and bitemporal hollowing",
        "Deletion of 17p13.3 involving LIS1 gene",
        "More severe cortical malformations with extensive agyria"
      ]
    },
    {
      "diseaseId": "cobblestone-lissencephaly",
      "distinguishingFeatures": [
        "Cobblestone appearance of cerebral cortex on imaging",
        "Associated with congenital muscular dystrophies",
        "Ocular abnormalities such as retinal dysplasia"
      ]
    }
  ],
