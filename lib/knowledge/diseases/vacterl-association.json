  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnosis of VACTERL Association",
    "criteria": [
      {
        "id": "vertebral-anomalies",
        "description": "Presence of vertebral anomalies such as hemivertebrae or fused vertebrae",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "anal-atresia",
        "description": "Imperforate anus or other anorectal malformations",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-defects",
        "description": "Congenital heart defects including ventricular septal defect or tetralogy of Fallot",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tracheoesophageal-fistula",
        "description": "Tracheoesophageal fistula or esophageal atresia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-anomalies",
        "description": "Renal structural anomalies such as renal agenesis or dysplasia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "limb-defects",
        "description": "Radial aplasia, hypoplastic thumbs, or other limb abnormalities",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least three of the characteristic congenital malformations involving vertebral, anal, cardiac, tracheoesophageal, renal, or limb anomalies",
    "notes": "Diagnosis is clinical; no single genetic cause identified. Exclusion of other syndromes is important."
  },
