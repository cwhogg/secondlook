  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate elevation)",
      "Normal or mildly elevated lactate"
    ],
    "imaging": [
      "Muscle MRI showing selective involvement of axial and proximal muscles",
      "Chest imaging may show scoliosis and restrictive lung disease"
    ],
    "genetic": [
      "SELENON (causative)",
      "TTN (causative, loss-of-function)",
      "MYH7 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy demonstrating multiple small cores with reduced oxidative enzyme staining",
      "Electromyography showing myopathic changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "central-core-disease",
      "distinguishingFeatures": [
        "Larger single cores on muscle biopsy",
        "Usually milder respiratory involvement",
        "Different genetic mutations (commonly RYR1)"
      ]
    },
    {
      "diseaseId": "nemaline-myopathy",
      "distinguishingFeatures": [
        "Presence of nemaline rods on muscle biopsy",
        "More prominent facial weakness",
        "Different genetic mutations (e.g., NEB, ACTA1)"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive respiratory failure",
