  "differentialDiagnoses": [
    {
      "diseaseId": "ewing-sarcoma",
      "distinguishingFeatures": [
        "Overlaps with pPNET but typically lacks neural differentiation",
        "Similar genetic translocations but different histologic features"
      ]
    },
    {
      "diseaseId": "rhabdomyosarcoma",
      "distinguishingFeatures": [
        "Presence of skeletal muscle differentiation markers (desmin, myogenin)",
        "Different genetic abnormalities"
      ]
    },
    {
      "diseaseId": "lymphoblastic-lymphoma",
      "distinguishingFeatures": [
        "Positive for lymphoid markers (CD45, TdT)",
        "Absence of EWSR1 rearrangement"
      ]
    }
  ],
