  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP",
      "Leukocytosis with neutrophilia",
      "Thrombocytosis in subacute phase",
      "Elevated liver enzymes",
      "Sterile pyuria"
    ],
    "imaging": [
      "Echocardiogram showing coronary artery dilatation or aneurysms",
      "Chest X-ray may show cardiomegaly"
    ],
    "genetic": [
      "No single causative gene identified; genetic susceptibility loci reported (e.g., ITPKC, FCGR2A)"
    ],
    "other": [
      "Response to intravenous immunoglobulin (IVIG) therapy is diagnostic and therapeutic"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "scarlet-fever",
      "distinguishingFeatures": [
        "Positive streptococcal throat culture",
        "Sandpaper rash",
        "Pastia lines",
        "No coronary artery involvement"
      ]
    },
    {
      "diseaseId": "toxic-shock-syndrome",
      "distinguishingFeatures": [
        "Rapid onset shock",
        "Multi-organ failure",
        "Positive bacterial cultures",
        "Diffuse erythroderma"
      ]
    },
    {
      "diseaseId": "juvenile-rheumatoid-arthritis",
      "distinguishingFeatures": [
        "Chronic arthritis",
        "Absence of mucocutaneous changes",
        "No coronary artery aneurysms"
      ]
    }
  ],
  "redFlags": [
