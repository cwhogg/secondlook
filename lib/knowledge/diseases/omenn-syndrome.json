      },
      {
        "id": "lymphadenopathy-hepatosplenomegaly",
        "description": "Lymphadenopathy and hepatosplenomegaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogammaglobulinemia",
        "description": "Hypogammaglobulinemia with elevated IgE",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of mutations in RAG1 or RAG2 genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized erythroderma, oligoclonal T-cell expansion, and lymphadenopathy/hepatosplenomegaly",
