  "diagnosticCriteria": {
    "formalCriteriaName": "Cornelia de Lange Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "distinctive-facial-features",
        "description": "Presence of characteristic facial features including synophrys, arched eyebrows, long eyelashes, and depressed nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-delay",
        "description": "Prenatal and postnatal growth retardation resulting in short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-abnormalities",
        "description": "Upper limb malformations such as micromelia, oligodactyly, or clinodactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "gastrointestinal-problems",
        "description": "Feeding difficulties, gastroesophageal reflux, or constipation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (distinctive facial features, growth delay, and limb abnormalities) with or without additional minor criteria",
    "notes": "Genetic testing can confirm diagnosis but clinical criteria remain primary for diagnosis."
  },
