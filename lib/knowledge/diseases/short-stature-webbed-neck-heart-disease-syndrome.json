  "keyFindings": {
    "laboratory": [
      "Coagulation studies may show mild bleeding diathesis",
      "Elevated serum natriuretic peptides in cardiac involvement"
    ],
    "imaging": [
      "Echocardiogram showing pulmonary valve stenosis or hypertrophic cardiomyopathy",
      "Chest X-ray revealing pectus deformities",
      "Renal ultrasound for structural anomalies"
    ],
    "genetic": [
      "Pathogenic variants in PTPN11 gene (~50% of cases)",
      "Mutations in SOS1, RAF1, KRAS, and other RAS-MAPK pathway genes"
    ],
    "other": [
      "Lymphoscintigraphy may demonstrate lymphatic abnormalities",
      "Developmental assessment for cognitive impairment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "turner-syndrome",
      "distinguishingFeatures": [
        "Monosomy X karyotype",
        "Primary amenorrhea and gonadal dysgenesis",
        "Absence of male cases"
      ]
    },
    {
      "diseaseId": "cardiofaciocutaneous-syndrome",
      "distinguishingFeatures": [
        "More severe intellectual disability",
        "Distinctive skin abnormalities (hyperkeratosis, ichthyosis)",
        "Different facial gestalt"
      ]
    }
  ],
