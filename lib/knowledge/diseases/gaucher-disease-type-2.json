  "keyFindings": {
    "laboratory": [
      "Markedly reduced glucocerebrosidase enzyme activity",
      "Anemia and thrombocytopenia secondary to bone marrow infiltration",
      "Elevated chitotriosidase levels"
    ],
    "imaging": [
      "MRI showing brainstem and basal ganglia abnormalities",
      "Hepatosplenomegaly on abdominal ultrasound",
      "Skeletal X-rays demonstrating Erlenmeyer flask deformity"
    ],
    "genetic": [
      "GBA1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Bone marrow biopsy showing Gaucher cells (lipid-laden macrophages)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "gaucher-disease-type-1",
      "distinguishingFeatures": [
