  "keyFindings": {
    "laboratory": [
      "Positive anti-Ro/SSA and/or anti-La/SSB antibodies",
      "Mild leukopenia or lymphopenia",
      "Elevated ESR or CRP in some cases"
    ],
    "imaging": [
      "Not routinely required; imaging may be used to exclude systemic lupus involvement"
    ],
    "genetic": [
      "Associations with HLA-DR3 and HLA-DR2 alleles"
    ],
    "other": [
      "Skin biopsy showing interface dermatitis with basal cell degeneration",
      "Direct immunofluorescence showing granular IgG and C3 deposits at dermoepidermal junction"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "discoid-lupus-erythematosus",
      "distinguishingFeatures": [
        "Scarring and atrophic plaques",
        "Less photosensitivity",
        "Negative or low frequency of anti-Ro/SSA antibodies"
      ]
    },
    {
      "diseaseId": "psoriasis",
      "distinguishingFeatures": [
        "Thick silvery scales",
        "Auspitz sign positive",
        "Lack of autoantibodies"
      ]
    },
    {
      "diseaseId": "dermatomyositis",
      "distinguishingFeatures": [
        "Gottron's papules and heliotrope rash",
        "Muscle weakness",
        "Elevated muscle enzymes"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of skin lesions with ulceration",
    "Development of systemic lupus erythematosus features (renal, CNS involvement)",
    "Severe photosensitivity with blistering"
  ],
