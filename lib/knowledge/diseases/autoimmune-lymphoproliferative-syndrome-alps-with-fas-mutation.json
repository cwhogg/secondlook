  "diagnosticCriteria": {
    "formalCriteriaName": "NIH Diagnostic Criteria for ALPS",
    "criteria": [
      {
        "id": "chronic-lymphadenopathy",
        "description": "Chronic (>6 months), nonmalignant lymphadenopathy and/or splenomegaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-dnt-cells",
        "description": "Elevated peripheral blood double-negative T cells (CD3+ TCRαβ+ CD4- CD8-)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "defective-lymphocyte-apoptosis",
        "description": "Defective lymphocyte apoptosis demonstrated in vitro",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoimmune-cytopenias",
        "description": "Presence of autoimmune cytopenias (e.g., autoimmune hemolytic anemia, thrombocytopenia)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "fas-mutation",
        "description": "Identification of pathogenic FAS gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria or two major criteria plus one minor or supportive criterion",
    "notes": "Genetic testing for FAS mutation supports diagnosis but is not mandatory if clinical and laboratory criteria are met."
  },
