        "description": "Developmental delay or regression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-onset",
        "description": "Onset typically between 3 and 12 months of age",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
