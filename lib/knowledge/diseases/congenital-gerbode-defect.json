  "diagnosticCriteria": {
    "formalCriteriaName": "Gerbode Defect Diagnostic Criteria",
    "criteria": [
      {
        "id": "echocardiographic-shunt",
        "description": "Identification of a left ventricular to right atrial shunt on echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "color-doppler-flow",
        "description": "Color Doppler demonstrating abnormal flow from left ventricle to right atrium",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-murmur",
        "description": "Presence of a systolic murmur best heard at the left lower sternal border",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-catheterization",
        "description": "Hemodynamic evidence of left ventricular to right atrial shunting on cardiac catheterization",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Echocardiographic identification of left ventricular to right atrial shunt with supporting color Doppler findings",
    "notes": "Diagnosis is primarily based on imaging; invasive studies reserved for unclear cases."
