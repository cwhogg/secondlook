  "keyFindings": {
    "laboratory": [
      "Nephrotic-range proteinuria (>40 mg/m2/hr)",
      "Hypoalbuminemia (<2.5 g/dL)",
      "Hyperlipidemia (elevated cholesterol and triglycerides)",
      "Elevated serum creatinine in advanced cases"
    ],
    "imaging": [
      "Renal ultrasound typically normal or mildly enlarged kidneys",
      "Chest X-ray may show pleural effusions or pulmonary edema"
    ],
    "genetic": [
      "No consistent monogenic mutations identified in idiopathic cases",
      "Genetic testing may be considered to exclude congenital nephrotic syndromes"
    ],
    "other": [
      "Renal biopsy showing minimal change disease or focal segmental glomerulosclerosis in secondary steroid resistance"
    ]
  },
