  "diagnosticCriteria": {
    "formalCriteriaName": "Carvajal Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "dilated-cardiomyopathy",
        "description": "Presence of dilated cardiomyopathy confirmed by echocardiography or cardiac MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "woolly-hair",
        "description": "Congenital or early-onset woolly hair",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "palmoplantar-keratoderma",
        "description": "Diffuse palmoplantar keratoderma typically developing in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the DSP gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: dilated cardiomyopathy, woolly hair, and palmoplantar keratoderma",
    "notes": "Genetic testing for DSP mutations supports diagnosis but is not mandatory if clinical criteria are met."
  },
