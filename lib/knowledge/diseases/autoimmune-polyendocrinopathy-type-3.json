  "keyFindings": {
    "laboratory": [
      "Positive thyroid autoantibodies (anti-thyroid peroxidase, anti-thyroglobulin)",
      "Islet cell antibodies and anti-GAD antibodies in type 1 diabetes",
      "Anti-intrinsic factor and anti-parietal cell antibodies in pernicious anemia",
      "Elevated blood glucose levels consistent with diabetes mellitus",
      "Anemia with macrocytosis in pernicious anemia"
    ],
    "imaging": [
      "Thyroid ultrasound showing hypoechogenicity consistent with autoimmune thyroiditis",
      "MRI brain in cases with neurological involvement (e.g., autoimmune encephalitis)"
    ],
    "genetic": [
      "HLA-DR3 and HLA-DR4 haplotypes associated with increased risk",
      "No single causative gene; polygenic autoimmune predisposition",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Histopathology of gastric mucosa showing lymphocytic infiltration in autoimmune gastritis",
      "Electromyography in myasthenia gravis cases"
    ]
  },
