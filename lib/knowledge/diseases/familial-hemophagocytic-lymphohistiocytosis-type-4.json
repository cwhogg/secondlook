  "keyFindings": {
    "laboratory": [
      "Elevated ferritin (>500 ng/mL, often >10,000 ng/mL)",
      "Cytopenias affecting ≥2 lineages",
      "Hypertriglyceridemia and/or hypofibrinogenemia",
      "Elevated liver transaminases",
      "Low or absent NK cell activity"
    ],
    "imaging": [
      "Hepatosplenomegaly on abdominal ultrasound or CT",
      "Lymphadenopathy on imaging",
      "Brain MRI showing demyelination or cerebral edema in advanced cases"
    ],
    "genetic": [
      "Biallelic pathogenic mutations in STX11 gene"
    ],
    "other": [
      "Hemophagocytosis observed in bone marrow, spleen, or lymph node biopsy"
    ]
