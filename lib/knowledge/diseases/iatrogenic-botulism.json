  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Iatrogenic Botulism",
    "criteria": [
      {
        "id": "recent-botulinum-toxin-exposure",
        "description": "History of recent therapeutic or cosmetic botulinum toxin administration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-bulbar-weakness",
        "description": "Progressive cranial nerve palsies including dysarthria, dysphagia, and ptosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiological-findings",
        "description": "Electrophysiological evidence of neuromuscular junction transmission defect (e.g., decremental response on repetitive nerve stimulation)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-infection",
        "description": "No evidence of infectious botulism or other mimicking conditions",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "botulinum-toxin-detection",
        "description": "Detection of botulinum toxin in serum or suspected product (if available)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recent botulinum toxin exposure plus progressive bulbar weakness and supportive electrophysiological findings",
    "notes": "Diagnosis is clinical and supported by electrophysiology and toxin detection when available."
  },
