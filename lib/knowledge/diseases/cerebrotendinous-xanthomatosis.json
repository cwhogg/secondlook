  "diagnosticCriteria": {
    "formalCriteriaName": "No standardized formal criteria; diagnosis based on clinical, biochemical, and genetic findings",
    "criteria": [
      {
        "id": "tendon-xanthomas",
        "description": "Presence of tendon xanthomas, especially in Achilles tendons",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-dysfunction",
        "description": "Progressive neurological symptoms including cerebellar ataxia, cognitive decline, and pyramidal signs",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-serum-cholestanol",
        "description": "Elevated serum cholestanol levels and abnormal bile alcohol profiles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the CYP27A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "juvenile-cataracts",
        "description": "Early-onset bilateral cataracts",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated serum cholestanol and pathogenic CYP27A1 mutations with supportive clinical features",
    "notes": "Diagnosis is confirmed by biochemical and genetic testing; clinical features support suspicion."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Tendon xanthomas",
        "frequency": 0.85,
        "bodySystem": "musculoskeletal",
        "notes": "Typically affecting Achilles tendons and extensor tendons of hands"
      },
      {
        "symptomName": "Elevated serum cholestanol",
        "frequency": 0.95,
        "bodySystem": "endocrine",
        "notes": "Biochemical hallmark of the disease",
        "searchTerms": [
          "high blood cholestanol levels",
          "increased cholestanol in blood",
          "elevated cholestanol test"
        ]
      },
      {
        "symptomName": "Juvenile bilateral cataracts",
        "frequency": 0.75,
        "bodySystem": "ophthalmological",
        "notes": "Often presenting in childhood or adolescence",
        "searchTerms": [
          "early onset cataracts in both eyes",
          "cloudy lenses in youth",
          "juvenile bilateral eye lens clouding"
        ]
      }
    ],
    "common": [
      {
        "symptomName": "Progressive cerebellar ataxia",
        "frequency": 0.75,
        "bodySystem": "neurological",
        "notes": "Gait disturbance and coordination problems",
        "searchTerms": [
          "progressive loss of coordination",
          "cerebellar ataxia worsening over time"
        ]
      },
      {
        "symptomName": "Cognitive impairment",
        "frequency": 0.7,
        "bodySystem": "neurological",
        "notes": "Ranges from mild learning difficulties to dementia"
      },
      {
        "symptomName": "Chronic diarrhea",
        "frequency": 0.65,
        "bodySystem": "gastrointestinal",
        "notes": "Often present in childhood"
      },
      {
        "symptomName": "Pyramidal tract signs",
        "frequency": 0.6,
        "bodySystem": "neurological",
        "notes": "Spasticity and hyperreflexia",
        "searchTerms": [
          "signs of upper motor neuron damage",
          "spasticity and increased reflexes",
          "muscle stiffness and weakness"
        ]
      },
      {
        "symptomName": "Peripheral neuropathy",
        "frequency": 0.55,
        "bodySystem": "neurological",
        "notes": "Sensory and motor involvement"
      }
    ],
    "occasional": [
