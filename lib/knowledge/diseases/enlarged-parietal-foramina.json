        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in ALX4 or MSX2 genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of associated cranial defects or mild developmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Bilateral enlarged parietal foramina on imaging plus either positive family history or pathogenic variant in ALX4/MSX2 genes",
    "notes": "Diagnosis is primarily radiological; genetic testing supports confirmation."
  },
