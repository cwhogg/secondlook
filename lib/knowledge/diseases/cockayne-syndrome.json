  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Cockayne Syndrome",
    "criteria": [
      {
        "id": "growth-failure",
        "description": "Postnatal growth failure with short stature and failure to thrive",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "photosensitivity",
        "description": "Marked photosensitivity with sunburn reaction and pigmentary changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-degeneration",
        "description": "Progressive neurological deterioration including developmental delay and sensorineural hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "premature-aging",
        "description": "Features of premature aging including cachectic appearance and loss of subcutaneous fat",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "dna-repair-defect",
        "description": "Defective nucleotide excision repair demonstrated by cellular assays",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (growth failure, photosensitivity, neurological degeneration) with supportive genetic or cellular evidence",
    "notes": "Genetic testing confirming mutations in ERCC6 or ERCC8 genes supports diagnosis"
  },
