  "keyFindings": {
    "laboratory": [
      "Elevated serum IgG4 concentration (>135 mg/dL)",
      "Elevated serum IgE in some cases",
      "Mild peripheral eosinophilia"
    ],
    "imaging": [
      "CT or MRI showing bilateral lacrimal and salivary gland enlargement with homogeneous enhancement",
      "Ultrasound demonstrating hypoechoic areas within affected glands"
    ],
    "genetic": [
      "No specific genetic mutations identified; possible HLA associations reported in some populations"
    ],
    "other": [
      "Histopathology showing dense lymphoplasmacytic infiltrate rich in IgG4-positive plasma cells, storiform fibrosis, and obliterative phlebitis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sjogrens-syndrome",
      "distinguishingFeatures": [
        "Presence of anti-Ro/SSA and anti-La/SSB antibodies",
        "More prominent sicca symptoms",
        "Lymphocytic infiltration without IgG4 plasma cell predominance"
      ]
    },
    {
      "diseaseId": "lymphoma",
      "distinguishingFeatures": [
        "Monoclonal lymphoid proliferation",
        "Rapidly progressive gland enlargement",
        "Absence of storiform fibrosis and IgG4-positive plasma cells"
      ]
    }
  ],
  "redFlags": [
    "Rapid unilateral gland enlargement",
    "Constitutional symptoms such as fever and weight loss",
    "Neurological deficits or cranial neuropathies"
  ],
