  "keyFindings": {
    "laboratory": [
      "Loss of INI1 protein expression on immunohistochemistry",
      "Detection of SMARCB1 or SMARCA4 gene mutations by molecular testing",
      "Anemia and elevated inflammatory markers in some cases"
    ],
    "imaging": [
      "MRI or CT showing large, poorly defined masses with heterogeneous enhancement",
      "CNS tumors often show diffusion restriction and necrosis",
      "Renal tumors may mimic Wilms tumor but with aggressive features"
    ],
    "genetic": [
      "Biallelic inactivation of SMARCB1 (INI1) gene",
      "Less commonly, mutations in SMARCA4 gene"
    ],
    "other": [
      "Histopathology revealing rhabdoid cells with eccentric nuclei and abundant eosinophilic cytoplasm",
      "Rapid tumor growth and early metastasis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "wilms-tumor",
      "distinguishingFeatures": [
        "Presence of triphasic histology (blastemal, stromal, epithelial) unlike rhabdoid morphology",
        "Retention of INI1 protein expression",
        "Typically presents in slightly older children"
      ]
    },
    {
      "diseaseId": "medulloblastoma",
      "distinguishingFeatures": [
        "Distinct histological and molecular subgroups",
        "No loss of INI1 expression",
        "More common in posterior fossa with different imaging characteristics"
      ]
    },
    {
      "diseaseId": "epithelioid sarcoma",
      "distinguishingFeatures": [
        "Usually affects older patients",
        "May show loss of INI1 but different clinical and histological features",
        "Typically arises in distal extremities"
      ]
    }
  ],
  "redFlags": [
    "Rapidly enlarging mass in infant or young child",
    "Neurological deterioration with CNS mass",
    "Loss of INI1 expression on tumor biopsy"
  ],
