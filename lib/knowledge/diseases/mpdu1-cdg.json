        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-transferrin-glycosylation",
        "description": "Abnormal serum transferrin isoform pattern indicating defective N-glycosylation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mpdu1-gene-mutation",
        "description": "Identification of pathogenic variants in the MPDU1 gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-transaminases",
        "description": "Mild to moderate elevation of liver transaminases",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital hypotonia, abnormal transferrin glycosylation pattern, and pathogenic MPDU1 gene variants",
    "notes": "Diagnosis is confirmed by molecular genetic testing and biochemical assays of glycosylation."
