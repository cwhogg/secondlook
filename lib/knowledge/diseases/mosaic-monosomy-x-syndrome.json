  "diagnosticCriteria": {
    "formalCriteriaName": "Turner Syndrome Diagnostic Criteria (adapted for mosaicism)",
    "criteria": [
      {
        "id": "chromosomal-mosaicism",
        "description": "Presence of 45,X cell line in mosaic with other cell lines confirmed by karyotype or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Height below the 5th percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gonadal-dysgenesis",
        "description": "Evidence of streak ovaries or gonadal dysgenesis on imaging or histology",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiovascular-anomalies",
        "description": "Presence of congenital heart defects such as bicuspid aortic valve or coarctation of the aorta",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "lymphedema",
        "description": "Neonatal or childhood lymphedema of hands and feet",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of mosaic 45,X karyotype plus at least one major clinical feature such as short stature or gonadal dysgenesis",
    "notes": "Diagnosis may require cytogenetic analysis of multiple tissues due to mosaicism variability"
  },
