  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Holoprosencephaly-craniosynostosis syndrome",
    "criteria": [
      {
        "id": "holoprosencephaly",
        "description": "Presence of holoprosencephaly confirmed by neuroimaging or postmortem examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of one or more cranial sutures confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic midline facial anomalies including hypotelorism, cleft lip/palate, or single central incisor",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "Epileptic seizures of variable severity",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of holoprosencephaly and craniosynostosis with at least one characteristic facial anomaly",
    "notes": "Diagnosis is primarily clinical supported by neuroimaging and genetic testing when available."
  },
