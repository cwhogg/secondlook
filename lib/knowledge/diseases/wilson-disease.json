  "keyFindings": {
    "laboratory": [
      "Low serum ceruloplasmin (<20 mg/dL)",
      "Elevated 24-hour urine copper (>40 µg/day)",
      "Elevated free (non-ceruloplasmin-bound) serum copper",
      "Elevated liver transaminases",
      "Coombs-negative hemolytic anemia with low alkaline phosphatase in acute presentation",
      "Low serum alkaline phosphatase-to-total bilirubin ratio in fulminant presentation"
    ],
    "imaging": [
      "Brain MRI showing T2 hyperintensity in basal ganglia (especially putamen)",
      "Face of the giant panda sign on midbrain MRI",
      "Hepatic MRI or CT may show cirrhotic changes",
      "Abdominal ultrasound showing hepatomegaly, cirrhosis, or splenomegaly"
    ],
    "genetic": [
      "ATP7B (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Slit-lamp examination for Kayser-Fleischer rings",
      "Liver biopsy with quantitative copper measurement (>250 µg/g dry weight)",
      "Penicillamine challenge test (elevated urine copper after loading dose)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hereditary-hemochromatosis",
      "distinguishingFeatures": [
        "Iron overload rather than copper overload",
        "Elevated transferrin saturation and ferritin",
        "HFE gene mutations",
        "No Kayser-Fleischer rings"
      ]
    },
    {
      "diseaseId": "autoimmune-hepatitis",
      "distinguishingFeatures": [
        "Positive autoantibodies (ANA, anti-smooth muscle)",
        "Elevated IgG levels",
        "Normal ceruloplasmin and copper studies",
        "Responds to immunosuppressive therapy"
      ]
    },
    {
      "diseaseId": "huntington-disease",
      "distinguishingFeatures": [
        "Chorea rather than dystonia predominates",
        "HTT gene CAG repeat expansion",
        "No hepatic involvement",
        "Autosomal dominant inheritance"
      ]
    },
    {
      "diseaseId": "early-onset-parkinson-disease",
      "distinguishingFeatures": [
        "Asymmetric onset with rest tremor",
        "No hepatic involvement",
        "Normal copper studies",
        "Responds well to levodopa"
      ]
    }
  ],
  "redFlags": [
    "Acute liver failure combined with Coombs-negative hemolytic anemia (Wilsonian crisis)",
    "Young patient with cirrhosis of unknown etiology",
    "Unexplained neuropsychiatric deterioration in a young person",
    "Low alkaline phosphatase in setting of acute liver failure",
    "Rapid neurological deterioration after initiation of chelation therapy"
  ],
