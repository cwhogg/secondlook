  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Primary Carnitine Deficiency",
    "criteria": [
      {
        "id": "low-serum-carnitine",
        "description": "Persistently low free carnitine levels in plasma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic variants in the SLC22A5 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical symptoms such as muscle weakness, cardiomyopathy, or hypoglycemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-carnitine-uptake",
        "description": "Reduced carnitine uptake in cultured fibroblasts",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of low serum carnitine, clinical features consistent with the disorder, and confirmation of pathogenic SLC22A5 variants",
    "notes": "Diagnosis can be supported by functional assays of carnitine transport in fibroblasts."
  },
