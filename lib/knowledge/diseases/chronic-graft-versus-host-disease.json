  "keyFindings": {
    "laboratory": [
      "Elevated liver enzymes (ALT, AST, ALP)",
      "Autoantibodies such as ANA and rheumatoid factor may be positive",
      "Cytopenias due to bone marrow involvement"
    ],
    "imaging": [
      "High-resolution CT showing air trapping and bronchiectasis in lungs",
      "MRI or ultrasound may show fibrosis in affected organs"
    ],
    "genetic": [
      "No specific genetic markers; risk influenced by donor-recipient HLA mismatch"
    ],
    "other": [
      "Histopathology showing lymphocytic infiltration and fibrosis in affected tissues",
      "Pulmonary function tests demonstrating obstructive defects"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "acute-graft-versus-host-disease",
      "distinguishingFeatures": [
        "Onset within 100 days post-transplant",
        "Predominantly affects skin, liver, and gastrointestinal tract with different histopathology",
        "More inflammatory and less fibrotic changes"
      ]
    },
    {
      "diseaseId": "systemic-sclerosis",
      "distinguishingFeatures": [
        "Autoimmune etiology without transplant history",
        "Presence of specific autoantibodies (e.g. anti-Scl-70)",
        "More widespread skin and internal organ fibrosis"
      ]
    },
    {
      "diseaseId": "sjogren-syndrome",
      "distinguishingFeatures": [
        "Primary autoimmune disease with sicca symptoms",
        "Lack of transplant history",
        "Different serologic markers (anti-Ro/SSA, anti-La/SSB)"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive bronchiolitis obliterans causing respiratory failure",
    "Severe liver dysfunction with jaundice and coagulopathy",
    "Extensive skin sclerosis leading to contractures and mobility loss"
  ],
  "specialistType": [
