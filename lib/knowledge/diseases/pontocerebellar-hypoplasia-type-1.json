  "diagnosticCriteria": {
    "formalCriteriaName": "Pontocerebellar Hypoplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-onset",
        "description": "Onset of severe neurodevelopmental delay and hypotonia in the neonatal period or early infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "MRI evidence of pontocerebellar hypoplasia characterized by cerebellar and pontine atrophy or hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with PCH1 (e.g., EXOSC3 mutations)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "motor-neuron-involvement",
        "description": "Electromyography or clinical evidence of anterior horn cell disease or spinal muscular atrophy-like features",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset neurodevelopmental delay with MRI-confirmed pontocerebellar hypoplasia and genetic confirmation of pathogenic variants in PCH1-associated genes",
    "notes": "Genetic testing is critical for definitive diagnosis; clinical and imaging findings guide initial suspicion."
  },
