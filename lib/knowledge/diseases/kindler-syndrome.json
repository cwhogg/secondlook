  "differentialDiagnoses": [
    {
      "diseaseId": "epidermolysis-bullosa-simplex",
      "distinguishingFeatures": [
        "Blistering without photosensitivity",
        "Mutations in keratin genes (KRT5, KRT14)",
        "No progressive poikiloderma"
      ]
    },
    {
      "diseaseId": "dyskeratosis-congenita",
      "distinguishingFeatures": [
        "Mucocutaneous triad (nail dystrophy, leukoplakia, reticulated pigmentation)",
        "Bone marrow failure",
        "Telomere shortening"
      ]
    },
    {
      "diseaseId": "xeroderma-pigmentosum",
      "distinguishingFeatures": [
        "Extreme photosensitivity with early skin cancers",
        "Defective nucleotide excision repair",
        "Neurological degeneration in some cases"
      ]
    }
  ],
  "redFlags": [
