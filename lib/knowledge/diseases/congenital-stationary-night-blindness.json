  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electroretinographic Criteria for CSNB",
    "criteria": [
      {
        "id": "nyctalopia",
        "description": "Congenital onset of impaired night vision (nyctalopia) without progression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroretinogram",
        "description": "Characteristic abnormal electroretinogram (ERG) showing absent or reduced rod responses with normal cone responses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal_fundus",
        "description": "Normal fundoscopic examination without retinal degeneration",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family_history",
        "description": "Positive family history consistent with autosomal recessive or X-linked inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital nyctalopia with characteristic ERG abnormalities",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory"
  },
