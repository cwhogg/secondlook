  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; metabolic screening usually unremarkable"
    ],
    "imaging": [
      "Brain MRI showing corpus callosum hypoplasia, simplified gyral pattern, and reduced frontal lobe volume"
    ],
    "genetic": [
      "Pathogenic variants in the FOXG1 gene (usually de novo mutations)"
    ],
    "other": [
      "Electroencephalogram (EEG) abnormalities consistent with epileptic encephalopathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "rett-syndrome",
      "distinguishingFeatures": [
        "MECP2 gene mutation instead of FOXG1",
        "Typical regression after normal early development",
        "Characteristic hand-wringing movements"
      ]
    },
    {
      "diseaseId": "angelman-syndrome",
      "distinguishingFeatures": [
        "UBE3A gene abnormalities",
        "Happy demeanor and frequent laughter",
        "Ataxia and seizures with different EEG pattern"
      ]
    }
  ],
