  "keyFindings": {
    "laboratory": [
      "Normal routine prenatal labs; no specific biochemical markers identified"
    ],
    "imaging": [
      "Prenatal ultrasound showing severe intrauterine growth restriction",
      "Brain MRI demonstrating cortical malformations such as pachygyria and polymicrogyria",
      "Skeletal survey revealing multiple joint contractures"
    ],
    "genetic": [
      "GPKOW (causative)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Prenatal lethality or perinatal death common",
      "Histopathology may show abnormal cortical layering"
    ]
  },
