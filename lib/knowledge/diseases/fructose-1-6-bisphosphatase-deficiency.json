  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for Fructose-1,6-Bisphosphatase Deficiency",
    "criteria": [
      {
        "id": "hypoglycemia-fasting",
        "description": "Recurrent hypoglycemia triggered by fasting or illness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-acidosis",
        "description": "Presence of metabolic acidosis with elevated lactate during episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-assay",
        "description": "Reduced or absent fructose-1,6-bisphosphatase enzyme activity in liver or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the FBP1 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "urinary-metabolites",
        "description": "Elevated urinary glycerol and glycerol-3-phosphate during metabolic crisis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent fasting hypoglycemia with metabolic acidosis plus either reduced enzyme activity or pathogenic FBP1 gene mutations",
    "notes": "Genetic testing is confirmatory but not always required if clinical and biochemical criteria are met."
  },
