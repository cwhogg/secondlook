  "diagnosticCriteria": {
    "formalCriteriaName": "Ichthyosis-prematurity syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "premature-birth",
        "description": "Preterm birth typically before 37 weeks gestation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-ichthyosis",
        "description": "Presence of congenital ichthyosiform erythroderma or thickened skin with scaling",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "respiratory-distress",
        "description": "Neonatal respiratory distress requiring intervention",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fatty-acid-oxidation-defect",
        "description": "Biochemical evidence of abnormal fatty acid metabolism or lipid abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the FATP4 (SLC27A4) gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of preterm birth, congenital ichthyosis, respiratory distress, and pathogenic FATP4 mutation",
    "notes": "Diagnosis is supported by clinical presentation and confirmed by genetic testing."
  },
