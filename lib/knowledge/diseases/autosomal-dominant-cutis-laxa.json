  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Autosomal Dominant Cutis Laxa",
    "criteria": [
      {
        "id": "skin-looseness",
        "description": "Generalized loose, sagging, and inelastic skin with reduced elasticity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elastin-gene-mutation",
        "description": "Identification of pathogenic mutation in the ELN gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiovascular-involvement",
        "description": "Presence of cardiovascular abnormalities such as aortic root dilatation or arterial tortuosity",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pulmonary-complications",
        "description": "Respiratory issues including emphysema or bronchiectasis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized skin laxity plus either a positive family history or a pathogenic ELN gene mutation",
    "notes": "Molecular genetic testing is confirmatory; clinical presentation may vary in severity."
  },
