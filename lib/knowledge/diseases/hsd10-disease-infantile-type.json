  "diagnosticCriteria": {
    "formalCriteriaName": "HSD10 Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of 17β-hydroxysteroid dehydrogenase type 10 enzyme activity confirmed by biochemical assay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic variants identified in the HSD17B10 gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Infantile onset of progressive neurodegeneration with developmental delay and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-profile",
        "description": "Abnormal urine organic acid profile showing elevated 2-methyl-3-hydroxybutyric acid and tiglylglycine",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "brain-imaging",
        "description": "MRI showing cerebral atrophy and delayed myelination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of enzyme deficiency or pathogenic HSD17B10 variants plus infantile neurodegenerative clinical presentation",
    "notes": "Diagnosis is confirmed by combining biochemical, genetic, and clinical findings."
  },
