  "diagnosticCriteria": {
    "formalCriteriaName": "Complement Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "low-c4-levels",
        "description": "Persistently low or undetectable serum complement C4 levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-infections",
        "description": "History of recurrent bacterial infections, especially with encapsulated organisms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoimmune-manifestations",
        "description": "Presence of autoimmune disease manifestations such as systemic lupus erythematosus",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations or deletions in the C4A or C4B genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistently low C4 levels plus either recurrent infections or autoimmune manifestations",
    "notes": "Diagnosis is supported by genetic testing and exclusion of other complement deficiencies."
  },
