  "diagnosticCriteria": {
    "formalCriteriaName": "Dalakas Diagnostic Criteria for Stiff-Person Syndrome",
    "criteria": [
      {
        "id": "muscle-rigidity",
        "description": "Progressive muscle rigidity predominantly involving axial and proximal limb muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-spasms",
        "description": "Stimulus-sensitive painful muscle spasms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anti-gad65-antibodies",
        "description": "Presence of anti-glutamic acid decarboxylase 65 (GAD65) antibodies in serum or CSF",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "psychiatric-symptoms",
        "description": "Associated anxiety, phobias, and other psychiatric manifestations",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electrophysiology",
        "description": "Continuous motor unit activity on electromyography (EMG)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive muscle rigidity and stimulus-sensitive spasms with supportive electrophysiological or serological evidence",
    "notes": "Psychiatric manifestations are common but not required for diagnosis"
  },
