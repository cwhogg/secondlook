  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Fetal Hydantoin Syndrome",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial anomalies including hypertelorism, broad nasal bridge, and cleft lip/palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Distal phalangeal hypoplasia or nail hypoplasia and other limb defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Intrauterine growth retardation or postnatal growth deficiency",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurodevelopmental-delay",
        "description": "Developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "maternal-phenytoin-exposure",
        "description": "Confirmed maternal use of phenytoin during pregnancy",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of maternal phenytoin exposure plus at least two major criteria including craniofacial dysmorphism and limb malformations",
    "notes": "Diagnosis is clinical; genetic testing is not diagnostic but may exclude other syndromes."
  },
