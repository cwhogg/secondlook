  "diagnosticCriteria": {
    "formalCriteriaName": "Hypocomplementemic MPGN Diagnostic Criteria",
    "criteria": [
      {
        "id": "low-complement-levels",
        "description": "Persistently low serum complement levels (C3 and/or C4)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glomerular-inflammation",
        "description": "Histopathological evidence of membranoproliferative glomerulonephritis on renal biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dense-deposits",
        "description": "Presence of dense intramembranous deposits on electron microscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-renal-impairment",
        "description": "Clinical evidence of renal impairment such as proteinuria or hematuria",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-secondary-causes",
        "description": "Exclusion of secondary causes such as infections, autoimmune diseases, or malignancies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of low complement levels plus histopathological confirmation of membranoproliferative glomerulonephritis with dense deposits",
    "notes": "Diagnosis requires renal biopsy with electron microscopy and complement testing."
  },
