        "description": "Elevated urinary excretion of aspartylglucosamine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the AGA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of progressive intellectual disability and connective tissue abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of aspartylglucosaminidase enzyme activity plus either elevated urinary aspartylglucosamine or pathogenic AGA gene variants",
    "notes": "Genetic testing is confirmatory; enzyme assay is diagnostic gold standard."
  },
