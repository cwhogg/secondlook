  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for congenital hyperinsulinism",
    "criteria": [
      {
        "id": "persistent-hypoglycemia",
        "description": "Persistent hypoglycemia with inappropriately elevated insulin levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ucp2-genetic-testing",
        "description": "Identification of pathogenic or likely pathogenic variants in the UCP2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other known causes of hyperinsulinism such as mutations in ABCC8 or KCNJ11",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-medical-therapy",
        "description": "Clinical response to diazoxide or other medical therapies targeting insulin secretion",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent hypoglycemia with elevated insulin and confirmed pathogenic UCP2 mutation after exclusion of other causes",
    "notes": "Genetic testing is essential for definitive diagnosis; biochemical testing supports clinical suspicion."
  },
