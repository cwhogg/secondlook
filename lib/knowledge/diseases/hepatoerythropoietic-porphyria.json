  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Hepatoerythropoietic Porphyria",
    "criteria": [
      {
        "id": "uroporphyrinogen-iii-cosynthase-deficiency",
        "description": "Demonstration of markedly reduced uroporphyrinogen III cosynthase enzyme activity in erythrocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-porphyrins",
        "description": "Elevated levels of uroporphyrin I and coproporphyrin I isomers in urine and feces",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-photosensitivity",
        "description": "Early onset cutaneous photosensitivity with blistering and scarring on sun-exposed skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the UROS gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing subepidermal blister with festooning of dermal papillae and deposition of porphyrins",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical photosensitivity with blistering plus biochemical evidence of elevated porphyrins and reduced UROS enzyme activity",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if biochemical and clinical criteria are met."
  },
