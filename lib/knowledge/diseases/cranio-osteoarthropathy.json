  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Primary Hypertrophic Osteoarthropathy",
    "criteria": [
      {
        "id": "digital-clubbing",
        "description": "Presence of digital clubbing with bulbous enlargement of distal phalanges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "periostosis",
        "description": "Radiographic evidence of periosteal new bone formation along long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pachydermia",
        "description": "Thickening of the skin, especially on the face and scalp (pachydermia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history supporting autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "arthralgia",
        "description": "Chronic joint pain and swelling without inflammatory markers",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: digital clubbing, periostosis on imaging, and pachydermia",
    "notes": "Diagnosis requires exclusion of secondary causes of hypertrophic osteoarthropathy."
  },
