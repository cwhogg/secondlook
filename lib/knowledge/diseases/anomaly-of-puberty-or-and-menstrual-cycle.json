  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Pubertal and Menstrual Anomalies",
    "criteria": [
      {
        "id": "delayed-puberty",
        "description": "Absence of breast development by age 13 or absence of menarche by age 15",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "primary-amenorrhea",
        "description": "Failure to initiate menstruation by age 15 in presence of normal secondary sexual characteristics",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "secondary-amenorrhea",
        "description": "Cessation of menstruation for 3 or more consecutive months after menarche",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "irregular-menstrual-cycles",
        "description": "Menstrual cycles varying by more than 7 days in length or cycles shorter than 21 days or longer than 35 days",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hormonal-abnormalities",
        "description": "Abnormal levels of gonadotropins, estrogen, or progesterone on laboratory testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least one major criterion (delayed puberty or primary amenorrhea) with supportive laboratory findings",
    "notes": "Diagnosis requires exclusion of structural, genetic, and systemic causes."
