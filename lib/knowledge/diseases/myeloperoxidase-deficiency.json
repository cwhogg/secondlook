  "keyFindings": {
    "laboratory": [
      "Absent or markedly reduced myeloperoxidase enzyme activity in neutrophils",
      "Normal neutrophil count with impaired oxidative burst",
      "Positive fungal cultures from mucosal sites"
    ],
    "imaging": [
      "Sinus CT showing chronic sinusitis",
      "Chest imaging may reveal fungal infiltrates in severe cases"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Flow cytometry demonstrating defective neutrophil function",
      "Histopathology showing fungal elements in infected tissues"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "chronic-granulomatous-disease",
      "distinguishingFeatures": [
        "Defect in NADPH oxidase complex rather than MPO enzyme",
        "More severe bacterial and fungal infections",
        "Abnormal dihydrorhodamine (DHR) test"
      ]
    },
    {
      "diseaseId": "leukocyte-adhesion-deficiency",
      "distinguishingFeatures": [
        "Defect in leukocyte adhesion molecules",
        "Delayed umbilical cord separation",
        "Marked leukocytosis with impaired neutrophil migration"
      ]
    }
  ],
  "redFlags": [
    "Recurrent or persistent mucocutaneous fungal infections",
    "Severe or unusual bacterial infections despite normal neutrophil counts",
    "Poor response to standard antimicrobial therapy"
  ],
