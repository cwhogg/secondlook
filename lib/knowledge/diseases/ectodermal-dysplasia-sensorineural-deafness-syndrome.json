  "keyFindings": {
    "laboratory": [
      "Reduced sweat chloride concentration in sweat test",
      "Normal routine blood counts"
    ],
    "imaging": [
      "Temporal bone CT showing cochlear hypoplasia or malformations",
      "Dental panoramic radiographs revealing hypodontia"
    ],
    "genetic": [
      "Pathogenic variants in genes such as PAX3, EYA1, or other ectodermal dysplasia-related genes",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Audiometric confirmation of bilateral sensorineural hearing loss",
      "Skin biopsy showing absence or hypoplasia of sweat glands"
    ]
  },
  "differentialDiagnoses": [
