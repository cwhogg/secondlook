  "keyFindings": {
    "laboratory": [
      "Low serum cortisol with elevated plasma ACTH",
      "Hyponatremia and hyperkalemia consistent with salt-wasting",
      "Low pregnenolone and downstream steroid hormones",
      "Elevated plasma renin activity"
    ],
    "imaging": [
      "Hypoplastic or dysgenetic adrenal glands on ultrasound or MRI",
      "Absent or rudimentary Müllerian structures on pelvic imaging"
    ],
    "genetic": [
      "CYP11A1 (causative, loss-of-function)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Karyotype confirming 46,XY genotype",
      "Histopathology of adrenal tissue showing impaired steroidogenesis (if biopsy performed)"
    ]
  },
