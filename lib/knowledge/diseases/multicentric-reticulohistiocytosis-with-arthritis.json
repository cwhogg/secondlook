  "diagnosticCriteria": {
    "formalCriteriaName": "Multicentric Reticulohistiocytosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "papulonodular-skin-lesions",
        "description": "Presence of characteristic papulonodular skin lesions with a coral bead appearance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "erosive-polyarthritis",
        "description": "Severe, symmetric, erosive polyarthritis predominantly affecting distal interphalangeal joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin or synovial biopsy showing multinucleated giant cells and histiocytes with ground-glass eosinophilic cytoplasm",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-erosions",
        "description": "Radiographic evidence of joint erosions and joint space narrowing",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-rheumatoid-factor",
        "description": "Negative rheumatoid factor and anti-CCP antibodies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of papulonodular skin lesions, erosive polyarthritis, and confirmatory histopathology",
    "notes": "Diagnosis requires exclusion of other histiocytic and rheumatologic disorders."
  },
