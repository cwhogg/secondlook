  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Craniofaciofrontodigital Syndrome",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial anomalies including frontal bossing, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digital-malformations",
        "description": "Syndactyly or brachydactyly affecting fingers and/or toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-features",
        "description": "Developmental delay or intellectual disability of variable severity",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiological-findings",
        "description": "Radiographic evidence of cranial suture abnormalities or digital bone anomalies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (craniofacial dysmorphism and digital malformations) with supportive clinical or radiological findings",
    "notes": "Genetic testing may assist but is not definitive due to limited known mutations."
  },
