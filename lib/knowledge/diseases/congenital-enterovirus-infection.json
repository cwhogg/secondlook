  "keyFindings": {
    "laboratory": [
      "Positive enterovirus RNA PCR in blood, CSF, or amniotic fluid",
      "Thrombocytopenia and elevated liver enzymes",
      "CSF pleocytosis with lymphocytic predominance"
    ],
    "imaging": [
      "MRI showing meningoencephalitis or white matter lesions",
      "Ultrasound evidence of hepatomegaly or hydrops fetalis"
    ],
    "genetic": [],
    "other": [
      "Maternal serology indicating recent enterovirus infection",
      "Isolation of enterovirus from neonatal stool or throat swabs"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-cytomegalovirus-infection",
      "distinguishingFeatures": [
        "Presence of characteristic periventricular calcifications on imaging",
        "Positive CMV PCR or culture",
        "Sensorineural hearing loss more common"
      ]
    },
    {
      "diseaseId": "congenital-toxoplasmosis",
      "distinguishingFeatures": [
        "Chorioretinitis and intracranial calcifications",
        "Positive Toxoplasma gondii serology",
        "Hydrocephalus more frequent"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression to neonatal sepsis or shock",
    "Development of seizures or altered consciousness",
    "Signs of multi-organ failure"
  ],
