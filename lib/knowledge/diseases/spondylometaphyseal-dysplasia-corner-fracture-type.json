  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Spondylometaphyseal Dysplasia, Corner Fracture Type",
    "criteria": [
      {
        "id": "corner-fracture-lesions",
