  "keyFindings": {
    "laboratory": [
      "Hyperchloremic metabolic acidosis with normal anion gap",
      "Urine pH persistently >5.5 despite systemic acidemia",
      "Hypokalemia",
      "Elevated urine calcium excretion"
    ],
    "imaging": [
      "Renal ultrasound showing nephrocalcinosis or nephrolithiasis",
      "Bone X-rays showing signs of osteomalacia or rickets in children"
    ],
    "genetic": [
      "Mutations in ATP6V1B1, ATP6V0A4, or SLC4A1 genes associated with inherited forms",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Positive ammonium chloride loading test confirming distal acidification defect"
    ]
  },
