  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for musculocontractural Ehlers-Danlos syndrome",
    "criteria": [
      {
        "id": "congenital-distal-contractures",
        "description": "Congenital multiple distal joint contractures including camptodactyly and talipes equinovarus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including hypertelorism, downslanting palpebral fissures, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-hyperextensibility",
        "description": "Soft, velvety, hyperextensible skin with easy bruising and atrophic scarring",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in CHST14 or DSE genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-hypotonia",
        "description": "Generalized muscle hypotonia present from birth",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical criteria plus genetic confirmation of biallelic pathogenic variants in CHST14 or DSE",
    "notes": "Diagnosis relies heavily on clinical features combined with molecular genetic testing."
  },
