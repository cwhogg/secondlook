  "diagnosticCriteria": {
    "formalCriteriaName": "CACP Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "camptodactyly",
        "description": "Presence of congenital or early-onset camptodactyly (permanent flexion deformity of fingers)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "non-inflammatory-arthropathy",
        "description": "Chronic non-inflammatory arthropathy with joint swelling predominantly affecting large joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "coxa-vara",
        "description": "Radiological evidence of coxa vara deformity of the hips",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pericarditis",
        "description": "Recurrent or chronic pericarditis without infectious or autoimmune cause",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the PRG4 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (camptodactyly, non-inflammatory arthropathy, and coxa vara) with or without pericarditis and/or genetic confirmation",
    "notes": "Genetic testing for PRG4 mutations strongly supports diagnosis but is not mandatory if clinical criteria are met."
  },
