  "diagnosticCriteria": {
    "formalCriteriaName": "Newborn Screening and Confirmatory Diagnostic Criteria for Congenital Hypothyroidism",
    "criteria": [
      {
        "id": "elevated-tsh",
        "description": "Elevated serum thyroid-stimulating hormone (TSH) levels on newborn screening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-thyroxine",
        "description": "Low serum free thyroxine (T4) concentration confirming hypothyroidism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-thyroid-agenesis",
        "description": "Absence of thyroid gland on thyroid ultrasound or radionuclide thyroid scan",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical features consistent with hypothyroidism (e.g., prolonged jaundice, feeding difficulties)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated TSH and low free T4 with imaging confirming absent thyroid gland",
    "notes": "Newborn screening programs are critical for early detection; imaging differentiates agenesis from other causes."
  },
