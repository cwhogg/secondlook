  "prevalence": {
    "estimate": "1 in 100,000 to 200,000",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 5,
      "peak": 1
    },
    "sexPredilection": "equal",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Nephropathic Cystinosis",
    "criteria": [
      {
        "id": "cystine-crystal-detection",
        "description": "Detection of cystine crystals in leukocytes or tissues",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "proximal-tubule-dysfunction",
        "description": "Evidence of proximal tubular dysfunction including aminoaciduria, glucosuria, phosphaturia, and bicarbonate wasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the CTNS gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-failure",
        "description": "Progressive renal failure with elevated serum creatinine and decreased GFR",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of proximal tubule dysfunction plus either cystine crystal detection or pathogenic CTNS mutation",
    "notes": "Diagnosis is confirmed by genetic testing and/or cystine quantification in leukocytes."
  },
  "symptoms": {
