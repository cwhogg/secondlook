  "keyFindings": {
    "laboratory": [
      "Marked elevation of serum transaminases (AST, ALT)",
      "Prolonged prothrombin time and elevated INR indicating coagulopathy",
      "Elevated serum bilirubin levels",
      "Normal or mildly elevated ammonia levels"
    ],
    "imaging": [
      "Brain MRI showing cerebellar atrophy or signal abnormalities",
      "Liver ultrasound demonstrating hepatomegaly or echotexture changes"
    ],
    "genetic": [
      "SCYL1 (causative)",
      "Identification of pathogenic variants in genes associated with mitochondrial or metabolic liver diseases (if known)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Nerve conduction studies confirming peripheral sensory motor neuropathy",
      "Liver biopsy showing hepatocellular necrosis and fibrosis"
    ]
  },
