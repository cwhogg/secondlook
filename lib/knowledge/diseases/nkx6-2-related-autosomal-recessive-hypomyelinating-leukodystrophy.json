  "diagnosticCriteria": {
    "formalCriteriaName": "NKX6-2-related hypomyelinating leukodystrophy diagnostic criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early onset hypotonia with progressive spasticity and ataxia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-mri",
        "description": "MRI showing diffuse hypomyelination with relative preservation of U-fibers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Biallelic pathogenic variants in the NKX6-2 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies showing peripheral neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-course",
        "description": "Progressive motor deterioration with developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early onset neurological symptoms consistent with hypomyelination, characteristic brain MRI findings, and confirmation of biallelic pathogenic NKX6-2 variants",
    "notes": "Diagnosis requires integration of clinical, radiological, and genetic data."
  },
