  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Langer-Giedion Syndrome",
    "criteria": [
      {
        "id": "multiple-exostoses",
        "description": "Presence of multiple osteochondromas (exostoses) confirmed clinically or radiologically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial features including bulbous nasal tip, sparse scalp hair, and prominent philtrum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Detection of contiguous gene deletion involving TRPS1 and EXT1 genes on chromosome 8q24",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Additional skeletal abnormalities such as short stature, cone-shaped epiphyses",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple exostoses, distinctive facial features, and intellectual disability; genetic confirmation supports diagnosis",
    "notes": "Genetic testing is recommended to confirm diagnosis but clinical diagnosis can be made based on phenotype."
  },
