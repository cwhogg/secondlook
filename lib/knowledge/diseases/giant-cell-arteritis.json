  "diagnosticCriteria": {
    "formalCriteriaName": "2022 ACR/EULAR Classification Criteria for Giant Cell Arteritis",
    "criteria": [
      {
        "id": "gca-1",
        "description": "Age at disease onset >= 50 years",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gca-2",
        "description": "New onset localized headache",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "gca-3",
        "description": "Temporal artery abnormality (tenderness, decreased pulsation)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "gca-4",
        "description": "ESR >= 50 mm/h",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "gca-5",
        "description": "Temporal artery biopsy showing vasculitis with mononuclear cell infiltration or granulomatous inflammation with multinucleated giant cells",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gca-6",
        "description": "Jaw or tongue claudication",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gca-7",
        "description": "Sudden visual loss or visual disturbance",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gca-8",
        "description": "Morning stiffness in shoulders and/or hips (polymyalgia rheumatica overlap)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "gca-9",
        "description": "Positive temporal artery halo sign on ultrasound",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gca-10",
        "description": "Large vessel involvement on imaging (aortitis, large artery stenosis)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Age >= 50 years plus total weighted score >= 6 from the classification criteria",
    "notes": "Temporal artery biopsy remains the gold standard. Ultrasound halo sign is increasingly used as first-line diagnostic test. Large-vessel GCA (aortitis) can occur without cranial symptoms."
  },
