  "diagnosticCriteria": {
    "formalCriteriaName": "NPC Suspicion Index and Diagnostic Criteria",
    "criteria": [
      {
        "id": "vertical-supranuclear-gaze-palsy",
        "description": "Presence of vertical supranuclear gaze palsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cholesterol-accumulation-assay",
        "description": "Filipin staining showing impaired cholesterol trafficking in cultured fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "npc1-npc2-genetic-testing",
        "description": "Identification of pathogenic variants in NPC1 or NPC2 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepatosplenomegaly",
        "description": "Presence of hepatosplenomegaly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ataxia",
        "description": "Clinical evidence of cerebellar ataxia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic NPC1 or NPC2 mutations or positive filipin staining plus clinical features such as vertical supranuclear gaze palsy and neurological deterioration",
    "notes": "Diagnosis often requires a combination of clinical, biochemical, and genetic testing."
  },
