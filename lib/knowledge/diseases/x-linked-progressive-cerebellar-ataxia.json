      "CSF analysis typically normal"
    ],
    "imaging": [
      "MRI showing cerebellar atrophy predominantly affecting the vermis and hemispheres"
    ],
    "genetic": [
      "GJB1 (causative)",
      "Pathogenic mutation in X-linked gene associated with cerebellar ataxia (e.g., SCA gene loci)",
      "X-linked recessive inheritance"
    ],
