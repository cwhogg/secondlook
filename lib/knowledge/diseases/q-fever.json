  "diagnosticCriteria": {
    "formalCriteriaName": "CDC Q Fever Diagnostic Criteria",
    "criteria": [
      {
        "id": "serology",
        "description": "Detection of phase II IgG antibodies to Coxiella burnetii by immunofluorescence assay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Acute febrile illness with compatible symptoms such as high fever, severe headache, and myalgia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "PCR-detection",
        "description": "Detection of Coxiella burnetii DNA by PCR in blood or tissue samples",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "epidemiological-link",
        "description": "Exposure to livestock or animal products known to harbor Coxiella burnetii",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acute febrile illness with compatible symptoms plus positive phase II IgG serology",
    "notes": "PCR can be used for early diagnosis before seroconversion; epidemiological exposure supports diagnosis but is not mandatory."
  },
