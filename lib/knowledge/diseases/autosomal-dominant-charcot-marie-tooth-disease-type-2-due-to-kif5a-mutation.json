        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic heterozygous mutation in the KIF5A gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Nerve biopsy showing axonal degeneration without significant demyelination (optional)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical neuropathy, electrophysiological evidence of axonal neuropathy, and pathogenic KIF5A mutation",
    "notes": "Genetic confirmation is essential for definitive diagnosis; nerve biopsy is rarely required."
