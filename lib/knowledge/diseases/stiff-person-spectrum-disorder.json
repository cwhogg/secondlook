  "diagnosticCriteria": {
    "formalCriteriaName": "Dalakas Diagnostic Criteria for Stiff Person Syndrome",
    "criteria": [
      {
        "id": "muscle-rigidity",
        "description": "Progressive muscle rigidity predominantly affecting axial and proximal limb muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-spasms",
        "description": "Episodic painful muscle spasms triggered by stimuli or emotional stress",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anti-gad-antibodies",
        "description": "Presence of elevated anti-glutamic acid decarboxylase (anti-GAD) antibodies in serum or CSF",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electrophysiology",
        "description": "Continuous motor unit activity on electromyography (EMG) at rest",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-diseases",
        "description": "Exclusion of other neurological or musculoskeletal disorders causing rigidity",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of progressive muscle rigidity and episodic spasms plus exclusion of other causes; supportive laboratory or electrophysiological findings strengthen diagnosis",
    "notes": "Anti-GAD antibodies are present in approximately 60-80% of cases but absence does not exclude diagnosis."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Axial and proximal limb muscle rigidity",
        "frequency": 0.85,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Stimulus-induced painful muscle spasms",
        "frequency": 0.75,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Anti-glutamic acid decarboxylase (anti-GAD) antibody positivity",
        "frequency": 0.7,
        "bodySystem": "immunological"
      }
    ],
    "common": [
      {
        "symptomName": "Hyperlordosis due to paraspinal muscle rigidity",
        "frequency": 0.65,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Anxiety and phobic behavior related to spasms",
        "frequency": 0.6,
        "bodySystem": "psychiatric"
      },
      {
        "symptomName": "Difficulty walking due to stiffness",
        "frequency": 0.6,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.55,
        "bodySystem": "constitutional"
      }
    ],
    "occasional": [
      {
        "symptomName": "Autonomic dysfunction (e.g., sweating, tachycardia)",
        "frequency": 0.4,
        "bodySystem": "cardiovascular"
      },
      {
        "symptomName": "Cranial nerve involvement (e.g., dysarthria, dysphagia)",
        "frequency": 0.3,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Sensory disturbances",
        "frequency": 0.25,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Sleep disturbances",
        "frequency": 0.15,
        "bodySystem": "psychiatric"
      }
    ],
    "rare": [
      {
        "symptomName": "Epileptic seizures",
        "frequency": 0.05,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Cerebellar ataxia",
        "frequency": 0.04,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Respiratory muscle involvement causing dyspnea",
