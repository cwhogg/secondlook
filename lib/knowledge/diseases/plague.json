  "keyFindings": {
    "laboratory": [
      "Isolation of Yersinia pestis in blood, bubo aspirate, sputum, or other sterile sites",
      "Gram-negative bipolar staining coccobacilli on microscopy",
      "Leukocytosis or leukopenia",
      "Elevated inflammatory markers (CRP, ESR)",
      "Thrombocytopenia and coagulopathy in septicemic cases"
    ],
    "imaging": [
      "Chest X-ray showing bilateral patchy infiltrates or lobar pneumonia in pneumonic plague",
      "Ultrasound or CT showing enlarged lymph nodes (buboes)"
    ],
    "genetic": [
      "No known inherited genetic predisposition"
    ],
    "other": [
      "Positive serology for Yersinia pestis antibodies (supportive)",
      "Rapid diagnostic tests (F1 antigen detection)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "tularemia",
      "distinguishingFeatures": [
        "Ulceroglandular lesions with less severe systemic symptoms",
        "Different epidemiology and exposure history",
        "Negative Yersinia pestis cultures"
      ]
    },
    {
      "diseaseId": "septicemic-anthrax",
      "distinguishingFeatures": [
        "Presence of characteristic black eschar",
        "Exposure to animal products or spores",
        "Positive Bacillus anthracis cultures"
      ]
    },
    {
      "diseaseId": "severe-streptococcal-lymphadenitis",
      "distinguishingFeatures": [
        "Absence of systemic septicemia",
        "Positive streptococcal cultures",
        "Different response to antibiotics"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression to septic shock",
    "Hemoptysis indicating pneumonic plague",
    "Presence of painful buboes with systemic toxicity"
  ],
