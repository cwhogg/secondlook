  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiographic Diagnostic Criteria for Kniest Dysplasia",
    "criteria": [
      {
        "id": "short-trunk-dwarfism",
        "description": "Presence of disproportionate short-trunk dwarfism with short limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-changes",
        "description": "Characteristic radiographic findings including widened metaphyses, flattened vertebral bodies, and delayed ossification",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-abnormalities",
        "description": "Presence of myopia and retinal detachment",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cartilage-abnormalities",
        "description": "Histological evidence of abnormal cartilage matrix with reduced type II collagen",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of disproportionate short-trunk dwarfism with characteristic radiographic changes plus either ocular abnormalities or histological confirmation",
    "notes": "Genetic testing for COL2A1 mutations can confirm diagnosis"
  },
