  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for Hypocalcemic Vitamin D-Resistant Rickets",
    "criteria": [
      {
        "id": "hypophosphatemia",
        "description": "Persistent hypophosphatemia with renal phosphate wasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-calcium",
        "description": "Normal or low-normal serum calcium levels despite rickets",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-alkaline-phosphatase",
        "description": "Elevated serum alkaline phosphatase indicating increased bone turnover",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-rickets",
        "description": "Radiographic evidence of rickets including metaphyseal cupping and fraying",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "resistance-to-vitamin-d",
        "description": "Lack of clinical and biochemical response to standard vitamin D therapy",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of hypophosphatemia with renal phosphate wasting, radiographic evidence of rickets, and resistance to vitamin D therapy",
    "notes": "Genetic testing for mutations in PHEX or related genes can support diagnosis."
  },
