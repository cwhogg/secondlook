  "keyFindings": {
    "laboratory": [
      "Routine blood tests typically normal",
      "Genetic testing may reveal mutations in genes such as SRPX2, PIK3R2, or TUBB2B"
    ],
    "imaging": [
      "MRI showing excessive small gyri and abnormal cortical lamination in bilateral perisylvian regions",
      "Possible associated ventriculomegaly or cortical dysplasia"
    ],
    "genetic": [
      "SRPX2 (candidate)",
      "ADGRG1 (causative)",
      "PI4KA (causative)",
      "Mutations in SRPX2 gene linked to X-linked forms",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electroencephalogram (EEG) often shows epileptiform discharges",
      "Neurodevelopmental assessments reveal motor and cognitive delays"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "unilateral-polymicrogyria",
      "distinguishingFeatures": [
        "Polymicrogyria localized to one hemisphere rather than bilateral perisylvian regions",
        "Less severe oromotor dysfunction"
      ]
    },
    {
      "diseaseId": "cortical-dysplasia-type-ii",
      "distinguishingFeatures": [
        "Focal cortical thickening with balloon cells on histology",
        "Typically presents with focal epilepsy without bilateral perisylvian involvement"
      ]
    },
    {
      "diseaseId": "congenital-bilateral-perisylvian-syndrome",
      "distinguishingFeatures": [
        "Overlap with BPP but may include additional brainstem abnormalities",
        "More prominent cranial nerve dysfunction"
      ]
    }
  ],
  "redFlags": [
    "Early onset refractory epilepsy",
    "Severe oromotor dysfunction causing feeding and respiratory compromise",
    "Rapid neurological deterioration or regression"
  ],
  "specialistType": [
