  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for IgM Monoclonal Gammopathy-Associated Polyneuropathy",
    "criteria": [
      {
        "id": "monoclonal-igm-detection",
        "description": "Presence of IgM monoclonal gammopathy confirmed by serum protein electrophoresis and immunofixation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-neuropathy",
        "description": "Symmetric distal sensory and motor neuropathy with predominant sensory ataxia and tremor",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiological-evidence",
        "description": "Nerve conduction studies showing demyelinating features consistent with polyneuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anti-magi-antibodies",
        "description": "Presence of anti-myelin-associated glycoprotein (MAG) antibodies in serum",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of polyneuropathy such as diabetes, vitamin deficiencies, or other paraproteinemias",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of IgM monoclonal gammopathy plus clinical and electrophysiological evidence of demyelinating polyneuropathy",
    "notes": "Anti-MAG antibody positivity supports diagnosis but is not mandatory."
  },
