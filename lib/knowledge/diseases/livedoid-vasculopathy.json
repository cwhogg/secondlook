  "keyFindings": {
    "laboratory": [
      "Thrombophilia workup: Factor V Leiden, prothrombin G20210A, protein C/S deficiency, antithrombin III",
      "Antiphospholipid antibodies (anticardiolipin, lupus anticoagulant, anti-beta2-glycoprotein I)",
      "Homocysteine levels",
      "CBC, coagulation studies typically normal"
    ],
    "imaging": [
      "Doppler ultrasound to exclude venous insufficiency",
      "No specific imaging diagnostic findings"
    ],
    "genetic": [
      "Factor V Leiden mutation may be present",
      "Prothrombin G20210A mutation may be present",
      "MTHFR polymorphisms (if hyperhomocysteinemia)",
      "PAI-1 polymorphisms"
    ],
    "other": [
      "Skin biopsy: fibrin thrombi in dermal vessels, hyalinization of vessel walls, minimal perivascular inflammation",
      "Direct immunofluorescence: fibrin deposition in vessel walls",
      "Wound culture to exclude superinfection"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "antiphospholipid-syndrome",
      "distinguishingFeatures": [
        "APS has positive antiphospholipid antibodies",
        "APS may have systemic thrombotic events (DVT, PE, stroke)"
      ]
    },
    {
      "diseaseId": "venous-stasis-ulcers",
      "distinguishingFeatures": [
        "Venous stasis ulcers are larger, less painful, medial malleolus",
        "Venous insufficiency on Doppler ultrasound"
      ]
    },
    {
      "diseaseId": "polyarteritis-nodosa-cutaneous",
      "distinguishingFeatures": [
        "Cutaneous PAN has livedo with subcutaneous nodules",
        "PAN biopsy shows necrotizing vasculitis of medium vessels"
      ]
    }
  ],
  "redFlags": [
    "Rapidly expanding ulcers suggesting secondary infection or alternative diagnosis",
    "Systemic thrombotic events suggesting antiphospholipid syndrome",
    "Ulcer non-healing despite appropriate anticoagulation therapy",
    "Development of peripheral neuropathy"
  ],
