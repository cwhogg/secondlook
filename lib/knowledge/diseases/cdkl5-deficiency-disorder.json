  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for CDKL5 Deficiency Disorder",
    "criteria": [
      {
        "id": "early-onset-epilepsy",
        "description": "Onset of seizures within the first 12 months of life, often within 3 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cdkl5-mutation",
        "description": "Pathogenic or likely pathogenic mutation in the CDKL5 gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "global-developmental-delay",
        "description": "Severe global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "motor-impairment",
        "description": "Severe motor impairment including hypotonia and impaired purposeful hand use",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "visual-impairment",
        "description": "Cortical visual impairment or abnormal eye movements",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset epilepsy, pathogenic CDKL5 mutation, and severe global developmental delay",
    "notes": "Diagnosis is confirmed primarily by genetic testing; clinical features support diagnosis."
  },
