        "requiredForDiagnosis": true
      },
      {
        "id": "ptosis",
        "description": "Bilateral congenital ptosis affecting eyelid elevation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "esotropia",
        "description": "Congenital esotropia (inward deviation of one or both eyes)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "syndactyly",
        "description": "Syndactyly involving fusion of fingers or toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short_stature",
        "description": "Postnatal short stature below the 3rd percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "telecanthus",
        "description": "Increased distance between the medial canthi of the eyes",
        "category": "minor",
        "requiredForDiagnosis": false
      }
