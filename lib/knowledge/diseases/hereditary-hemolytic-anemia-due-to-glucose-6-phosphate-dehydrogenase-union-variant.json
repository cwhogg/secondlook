  "diagnosticCriteria": {
    "formalCriteriaName": "G6PD Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced glucose-6-phosphate dehydrogenase enzyme activity in erythrocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of the G6PD Union variant mutation by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemolytic-episodes",
        "description": "Episodic hemolysis triggered by oxidative stressors such as infections, certain drugs, or fava bean ingestion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "blood-smear",
        "description": "Peripheral blood smear showing bite cells and Heinz bodies during hemolytic episodes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of hemolytic anemia or known G6PD deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced G6PD enzyme activity and identification of the Union variant mutation, along with clinical evidence of episodic hemolysis",
    "notes": "Diagnosis is confirmed by combining biochemical enzyme assay and molecular genetic testing."
  },
