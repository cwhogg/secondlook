  "diagnosticCriteria": {
    "formalCriteriaName": "Björnstad Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pili-torti-hair",
        "description": "Presence of pili torti (twisted hair shafts) on microscopic hair examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "biallelic-bcs1l-mutation",
        "description": "Identification of biallelic pathogenic variants in the BCS1L gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral sensorineural hearing loss and pili torti hair abnormalities, with or without genetic confirmation",
    "notes": "Genetic testing for BCS1L mutations can confirm diagnosis but is not mandatory if clinical criteria are met."
  },
