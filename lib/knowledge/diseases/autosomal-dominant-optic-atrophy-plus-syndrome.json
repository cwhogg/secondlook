  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Autosomal Dominant Optic Atrophy Plus Syndrome",
    "criteria": [
      {
        "id": "optic-atrophy",
        "description": "Bilateral, symmetric optic nerve atrophy confirmed by ophthalmological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "visual-acuity-loss",
        "description": "Progressive decrease in visual acuity starting in childhood or early adulthood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "extraocular-neurological-features",
        "description": "Presence of additional neurological symptoms such as sensorineural hearing loss, ataxia, or peripheral neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in OPA1 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral optic atrophy with progressive visual loss plus at least one extraocular neurological feature; genetic confirmation supports diagnosis",
    "notes": "Genetic testing for OPA1 mutations is recommended but not mandatory if clinical criteria are met."
  },
