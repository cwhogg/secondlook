  "keyFindings": {
    "laboratory": [
      "CSF pleocytosis with mild lymphocytic predominance",
      "Elevated CSF protein",
      "Presence of anti-GluR3 antibodies in some cases"
    ],
    "imaging": [
      "MRI showing progressive unilateral cortical atrophy",
      "T2/FLAIR hyperintensities in affected hemisphere",
      "PET scan showing hypometabolism in affected hemisphere"
    ],
    "genetic": [
      "No consistent genetic mutation identified",
      "Possible HLA associations reported"
    ],
    "other": [
      "Brain biopsy demonstrating T-cell predominant encephalitis and microglial nodules"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sturge-weber-syndrome",
      "distinguishingFeatures": [
        "Presence of facial port-wine stain",
        "Leptomeningeal angiomas on imaging",
        "Glaucoma and ocular abnormalities"
      ]
    },
    {
      "diseaseId": "hemimegalencephaly",
      "distinguishingFeatures": [
        "Enlargement rather than atrophy of one hemisphere",
        "Congenital onset",
        "Associated developmental delay from birth"
      ]
    },
    {
      "diseaseId": "brain-tumor",
      "distinguishingFeatures": [
        "Mass lesion on imaging",
        "No progressive hemispheric atrophy",
        "Different seizure semiology"
      ]
    }
  ],
