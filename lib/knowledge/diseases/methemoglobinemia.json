        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated methemoglobin level >1.5% plus clinical cyanosis with normal PaO2",
    "notes": "Diagnosis confirmed by co-oximetry and clinical correlation; genetic testing may support diagnosis."
