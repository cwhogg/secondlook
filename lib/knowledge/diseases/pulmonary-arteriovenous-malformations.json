  "diagnosticCriteria": {
    "formalCriteriaName": "Curaçao Criteria (for Hereditary Hemorrhagic Telangiectasia-related PAVMs)",
    "criteria": [
      {
        "id": "radiologic-evidence",
        "description": "Presence of one or more pulmonary arteriovenous malformations confirmed by contrast-enhanced chest CT or pulmonary angiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypoxemia",
        "description": "Evidence of hypoxemia or right-to-left shunting demonstrated by arterial blood gas analysis or contrast echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Associated clinical features such as dyspnea, cyanosis, or clubbing",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history of hereditary hemorrhagic telangiectasia or PAVMs",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Radiologic evidence of PAVMs plus either hypoxemia or clinical features consistent with right-to-left shunting",
    "notes": "Diagnosis is often supported by genetic testing if hereditary hemorrhagic telangiectasia is suspected."
  },
