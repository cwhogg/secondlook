    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Urethral Atresia",
    "criteria": [
      {
        "id": "absent-urethral-meatus",
        "description": "Absence of a patent urethral meatus on physical examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-outflow-obstruction",
        "description": "Evidence of urinary outflow obstruction with bladder distension on imaging",
