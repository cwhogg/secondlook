  "diagnosticCriteria": {
    "formalCriteriaName": "Cogan's Criteria for Autoimmune Inner Ear Disease",
    "criteria": [
      {
        "id": "progressive-hearing-loss",
        "description": "Progressive bilateral sensorineural hearing loss over weeks to months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-immunosuppressive-therapy",
        "description": "Improvement or stabilization of hearing loss with corticosteroids or immunosuppressive agents",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of sensorineural hearing loss by clinical and laboratory evaluation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vestibular-dysfunction",
        "description": "Presence of vestibular symptoms such as vertigo or imbalance",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "positive-autoantibodies",
        "description": "Detection of inner ear-specific or nonspecific autoantibodies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive bilateral sensorineural hearing loss, exclusion of other causes, and response to immunosuppressive therapy",
    "notes": "Diagnosis is clinical and supported by response to treatment; no definitive laboratory test exists."
  },
