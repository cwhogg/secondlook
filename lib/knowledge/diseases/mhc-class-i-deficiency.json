  "keyFindings": {
    "laboratory": [
      "Flow cytometry showing absent or markedly reduced MHC class I expression on lymphocytes",
      "Reduced CD8+ T-cell counts with normal CD4+ T-cell counts",
      "Normal immunoglobulin levels in most cases"
    ],
    "imaging": [
      "Chest radiographs showing recurrent or chronic pulmonary infections",
      "Sinus CT scans demonstrating chronic sinusitis"
    ],
    "genetic": [
      "KRT16 (causative)",
      "KRT17 (causative)",
      "KRT6A (causative)",
      "KRT6B (causative)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Normal MHC class II expression on antigen-presenting cells",
      "Negative HIV testing to exclude secondary CD8 lymphopenia"
    ]
  },
