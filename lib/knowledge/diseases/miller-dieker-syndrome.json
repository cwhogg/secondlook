  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Miller-Dieker Syndrome",
    "criteria": [
      {
        "id": "lissencephaly",
        "description": "Presence of classical lissencephaly characterized by smooth brain surface with absent or reduced gyri",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive craniofacial features including prominent forehead, bitemporal hollowing, short nose with upturned nares, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Detection of deletion or mutation involving the PAFAH1B1 (LIS1) gene on chromosome 17p13.3",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "Early onset seizures including infantile spasms or focal seizures",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Severe global developmental delay and intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of classical lissencephaly on neuroimaging plus characteristic facial dysmorphism and genetic confirmation of 17p13.3 deletion or LIS1 mutation",
    "notes": "Genetic testing is critical for definitive diagnosis; brain MRI is essential for identifying lissencephaly pattern."
  },
