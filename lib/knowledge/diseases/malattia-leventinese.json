        "id": "efemp1-mutation",
        "description": "Identification of pathogenic EFEMP1 gene mutation (commonly R345W)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "visual-acuity-loss",
        "description": "Progressive central vision loss documented by visual acuity testing",
        "category": "minor",
        "requiredForDiagnosis": false
      },
