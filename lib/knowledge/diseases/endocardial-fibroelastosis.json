  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Imaging Diagnostic Criteria for Endocardial Fibroelastosis",
    "criteria": [
      {
        "id": "echocardiographic-thickening",
        "description": "Diffuse thickening of the endocardium detected by echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "left-ventricular-dysfunction",
        "description": "Evidence of left ventricular systolic and/or diastolic dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathological-confirmation",
        "description": "Endocardial biopsy showing fibroelastic tissue proliferation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-heart-failure",
        "description": "Signs and symptoms consistent with congestive heart failure in infancy or early childhood",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of diffuse endocardial thickening on echocardiography with left ventricular dysfunction; histopathological confirmation if available",
    "notes": "Diagnosis is primarily clinical supported by imaging; biopsy is rarely performed."
  },
