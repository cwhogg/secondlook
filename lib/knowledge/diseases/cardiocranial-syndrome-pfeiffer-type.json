  "diagnosticCriteria": {
    "formalCriteriaName": "Pfeiffer Cardiocranial Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of cranial sutures leading to abnormal skull shape",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-cardiac-anomalies",
        "description": "Presence of congenital heart defects such as ventricular septal defect or atrial septal defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midface-hypoplasia",
        "description": "Underdevelopment of the midfacial region including maxillary hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "broad-thumb-and-toes",
        "description": "Broad and medially deviated thumbs and great toes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: craniosynostosis, congenital cardiac anomalies, and midface hypoplasia",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
