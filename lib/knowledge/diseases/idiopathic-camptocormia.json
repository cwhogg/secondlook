  "diagnosticCriteria": {
    "formalCriteriaName": "Idiopathic Camptocormia Diagnostic Criteria",
    "criteria": [
      {
        "id": "postural-flexion",
        "description": "Marked forward flexion of the thoracolumbar spine greater than 45 degrees when standing or walking",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "reversibility-supine",
        "description": "Improvement or resolution of spinal flexion when lying supine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-neurological-disorder",
        "description": "No evidence of underlying neurological or musculoskeletal disorder causing camptocormia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyographic evidence of myopathic changes in paraspinal muscles",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing nonspecific myopathic changes without inflammatory or neurogenic features",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria",
    "notes": "Diagnosis requires exclusion of secondary causes such as Parkinson's disease, dystonia, or myopathies."
  },
