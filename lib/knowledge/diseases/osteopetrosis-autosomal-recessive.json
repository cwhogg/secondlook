  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Autosomal Recessive Osteopetrosis",
    "criteria": [
      {
        "id": "increased-bone-density",
        "description": "Generalized increased bone density on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "marrow-failure",
        "description": "Evidence of bone marrow failure including anemia, thrombocytopenia, or leukopenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cranial-nerve-compression",
        "description": "Signs of cranial nerve compression such as vision or hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in genes associated with osteopetrosis (e.g., TCIRG1, CLCN7)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-patterns",
        "description": "Characteristic radiologic features including 'bone within bone' appearance and Erlenmeyer flask deformity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized increased bone density on imaging plus bone marrow failure and/or genetic confirmation of pathogenic mutations",
    "notes": "Diagnosis is supported by clinical, radiological, hematological, and genetic findings."
  },
