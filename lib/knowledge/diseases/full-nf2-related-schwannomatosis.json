  "diagnosticCriteria": {
    "formalCriteriaName": "Manchester Diagnostic Criteria for NF2",
    "criteria": [
      {
        "id": "bilateral-vestibular-schwannomas",
        "description": "Presence of bilateral vestibular schwannomas confirmed by MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history-nf2",
        "description": "First-degree relative with NF2 and unilateral vestibular schwannoma or any two of meningioma, glioma, schwannoma, or juvenile posterior subcapsular lenticular opacities",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "multiple-nervous-system-tumors",
        "description": "Multiple meningiomas (two or more) and unilateral vestibular schwannoma or any two of schwannoma, glioma, neurofibroma, or juvenile posterior subcapsular lenticular opacities",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Bilateral vestibular schwannomas on MRI or a first-degree relative with NF2 plus either unilateral vestibular schwannoma or two other NF2-associated tumors",
    "notes": "Diagnosis can be confirmed genetically by identification of pathogenic NF2 gene mutation."
  },
