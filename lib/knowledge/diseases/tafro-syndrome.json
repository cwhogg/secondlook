  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for TAFRO syndrome",
    "criteria": [
      {
        "id": "thrombocytopenia",
        "description": "Thrombocytopenia (platelet count <100,000/μL)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anasarca",
        "description": "Anasarca including pleural effusion, ascites, and generalized edema",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fever",
        "description": "Fever of unknown origin (>38°C)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "reticulin-fibrosis",
        "description": "Bone marrow reticulin fibrosis or increased megakaryocytes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "organomegaly",
        "description": "Mild hepatosplenomegaly or lymphadenopathy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-dysfunction",
        "description": "Renal dysfunction with elevated creatinine or proteinuria",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (thrombocytopenia, anasarca, fever) plus at least one minor criterion",
    "notes": "Exclusion of infectious, malignant, and autoimmune diseases is essential"
  },
