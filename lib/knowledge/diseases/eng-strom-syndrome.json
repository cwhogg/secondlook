  "diagnosticCriteria": {
    "formalCriteriaName": "Eng-Strom Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial dysmorphic features including hypertelorism and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Presence of multiple skeletal anomalies such as scoliosis and joint contractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "Ophthalmological abnormalities including strabismus and nystagmus",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-defects",
        "description": "Congenital heart defects such as septal defects",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: craniofacial dysmorphism, skeletal abnormalities, and developmental delay",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
