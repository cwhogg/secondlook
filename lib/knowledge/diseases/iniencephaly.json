  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Iniencephaly",
    "criteria": [
      {
        "id": "retroflexion",
        "description": "Severe retroflexion of the head with the face directed upward",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "occipital-spinal-fusion",
        "description": "Fusion of the occiput with the cervical and upper thoracic vertebrae",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cervical-spinal-malformations",
        "description": "Presence of cervical vertebral anomalies such as spina bifida or vertebral fusion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neural-tube-defect",
        "description": "Associated neural tube defects such as encephalocele or spina bifida",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe retroflexion of the head with occipital-spinal fusion and cervical vertebral malformations",
    "notes": "Diagnosis is primarily clinical and confirmed by imaging studies such as prenatal ultrasound or postnatal radiography."
  },
