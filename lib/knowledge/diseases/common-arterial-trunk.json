  "diagnosticCriteria": {
    "formalCriteriaName": "Echocardiographic and Anatomical Diagnostic Criteria for Common Arterial Trunk",
    "criteria": [
      {
        "id": "single-arterial-trunk",
        "description": "Presence of a single arterial trunk arising from the heart supplying systemic, pulmonary, and coronary circulations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ventricular-septal-defect",
        "description": "Presence of a large, non-restrictive ventricular septal defect beneath the truncal valve",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "truncal-valve-abnormalities",
        "description": "Abnormal morphology of the truncal valve, including stenosis, regurgitation, or abnormal number of cusps",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pulmonary-artery-origin",
        "description": "Pulmonary arteries arising from the common arterial trunk or its branches",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Identification of a single arterial trunk with associated ventricular septal defect and pulmonary artery origin from the trunk",
    "notes": "Diagnosis is primarily based on echocardiography and confirmed by cardiac MRI or cardiac catheterization if needed."
  },
