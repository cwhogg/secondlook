  "diagnosticCriteria": {
    "formalCriteriaName": "Canavan Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive neurodevelopmental delay with hypotonia and macrocephaly in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aspartoacylase-deficiency",
        "description": "Demonstration of deficient aspartoacylase enzyme activity in fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the ASPA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mri-findings",
        "description": "MRI showing diffuse symmetric white matter abnormalities with increased N-acetylaspartate (NAA) peak on spectroscopy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-nacetylaspartate",
        "description": "Elevated N-acetylaspartate levels in urine or cerebrospinal fluid",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive neurodevelopmental delay with hypotonia and macrocephaly plus either confirmed ASPA enzyme deficiency or biallelic pathogenic ASPA variants",
    "notes": "MRI and biochemical findings support diagnosis but are not solely diagnostic."
  },
