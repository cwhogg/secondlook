  "diagnosticCriteria": {
    "formalCriteriaName": "Ectodermal Dysplasia-Blindness Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "congenital-blindness",
        "description": "Congenital or early-onset blindness due to retinal or optic nerve abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ectodermal-dysplasia-features",
        "description": "Presence of ectodermal dysplasia signs including hypohidrosis, hypotrichosis, and dental anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features such as frontal bossing and midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in associated genes (e.g., TP63 mutations)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital blindness and at least two major ectodermal dysplasia features",
    "notes": "Genetic testing can support diagnosis but is not mandatory."
  },
