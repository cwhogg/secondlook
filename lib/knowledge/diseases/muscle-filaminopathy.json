  "diagnosticCriteria": {
    "formalCriteriaName": "Muscle Filaminopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the FLNC gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-weakness-pattern",
        "description": "Progressive distal and proximal muscle weakness predominantly affecting limb muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy-findings",
        "description": "Muscle biopsy showing characteristic myofibrillar disorganization and protein aggregates",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Electromyographic evidence of myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic FLNC variant plus either characteristic muscle weakness pattern or muscle biopsy findings",
    "notes": "Genetic testing is essential for definitive diagnosis; muscle biopsy supports diagnosis especially in unclear cases."
  },
