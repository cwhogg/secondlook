  "keyFindings": {
    "laboratory": [
      "Genetic testing revealing PAX6 gene mutation"
    ],
    "imaging": [
      "Optical coherence tomography (OCT) showing foveal hypoplasia",
      "Ultrasound or MRI for Wilms tumor screening in syndromic cases"
    ],
    "genetic": [
      "Heterozygous mutations in PAX6 gene on chromosome 11p13"
    ],
    "other": [
      "Slit-lamp examination demonstrating iris hypoplasia",
      "Intraocular pressure measurement for glaucoma detection"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "peters-anomaly",
      "distinguishingFeatures": [
        "Corneal opacity with central corneal leukoma",
        "Anterior segment dysgenesis without complete iris absence"
      ]
    },
    {
      "diseaseId": "coloboma",
      "distinguishingFeatures": [
        "Keyhole-shaped defect of the iris",
        "Usually localized defect rather than complete or near-complete iris absence"
      ]
    }
  ],
  "redFlags": [
    "Rapidly increasing intraocular pressure indicating glaucoma",
    "Presence of abdominal mass suggesting Wilms tumor",
    "Sudden vision loss or severe photophobia"
  ],
