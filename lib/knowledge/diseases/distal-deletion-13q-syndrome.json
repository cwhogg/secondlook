  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Distal 13q Deletion Syndrome",
    "criteria": [
      {
        "id": "chromosomal-deletion",
        "description": "Confirmed deletion involving the distal long arm of chromosome 13 (13q)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial anomalies including microcephaly, micrognathia, and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital malformations such as cardiac defects or limb anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed distal 13q chromosomal deletion plus at least two major clinical features including craniofacial dysmorphism and developmental delay",
    "notes": "Diagnosis requires cytogenetic or molecular confirmation of deletion; phenotypic variability depends on deletion size and location"
  },
