  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate elevation)",
      "Normal or mildly elevated lactate"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle involvement",
      "Chest X-ray may show restrictive lung disease secondary to muscle weakness"
    ],
    "genetic": [
      "STAC3 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy showing congenital myopathic changes with fiber size variability and type 1 fiber predominance",
      "Malignant hyperthermia susceptibility confirmed by in vitro contracture testing"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "centronuclear-myopathy",
      "distinguishingFeatures": [
        "Central nuclei on muscle biopsy",
        "Different genetic mutations (e.g., MTM1, DNM2)",
        "Absence of STAC3 mutation"
      ]
    },
    {
      "diseaseId": "multiminicore-disease",
      "distinguishingFeatures": [
        "Multiple cores on muscle biopsy",
        "RYR1 gene mutations",
        "Less prominent facial dysmorphism"
      ]
    }
  ],
  "redFlags": [
    "Sudden onset of hyperthermia during anesthesia",
