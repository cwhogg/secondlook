  "diagnosticCriteria": {
    "formalCriteriaName": "Mosaic Variegated Aneuploidy Diagnostic Criteria",
    "criteria": [
      {
        "id": "aneuploidy-mosaicism",
        "description": "Presence of mosaic aneuploidy in multiple cell lines confirmed by cytogenetic analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microcephaly",
        "description": "Congenital microcephaly with progressive postnatal growth failure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Severe global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Intrauterine and postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent nose, micrognathia, and low-set ears",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of mosaic aneuploidy plus at least two major clinical features including microcephaly and developmental delay",
    "notes": "Diagnosis is confirmed by cytogenetic studies demonstrating mosaic aneuploidy in multiple tissues."
  },
