  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "pH monitoring may show acid reflux episodes"
    ],
    "imaging": [
      "Upper GI series may show reflux or hiatal hernia",
      "Endoscopy may reveal esophagitis"
    ],
    "genetic": [
      "No known genetic mutations associated"
    ],
    "other": [
      "Video recording of dystonic episodes helpful for diagnosis",
      "Response to anti-reflux therapy is diagnostic"
    ]
  },
