  "diagnosticCriteria": {
    "formalCriteriaName": "2016 Revisions to the 2010/2011 ACR Fibromyalgia Diagnostic Criteria",
    "criteria": [
      {
        "id": "fm-c1",
        "description": "Widespread Pain Index (WPI) >= 7 AND Symptom Severity Scale (SSS) score >= 5, OR WPI 4-6 AND SSS >= 9",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fm-c2",
        "description": "Generalized pain defined as pain in at least 4 of 5 body regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fm-c3",
        "description": "Symptoms have been generally present for at least 3 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fm-c4",
        "description": "A diagnosis of fibromyalgia is valid irrespective of other diagnoses (no longer an exclusion diagnosis)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "fm-s1",
        "description": "Fatigue severity (0-3 scale on SSS)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "fm-s2",
        "description": "Waking unrefreshed (0-3 scale on SSS)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "fm-s3",
        "description": "Cognitive symptoms (0-3 scale on SSS)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "fm-s4",
        "description": "Headaches (SSS somatic symptom)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "fm-s5",
        "description": "Pain or cramps in lower abdomen (SSS somatic symptom)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "fm-s6",
        "description": "Depression (SSS somatic symptom)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "WPI >= 7 and SSS >= 5, OR WPI 4-6 and SSS >= 9; generalized pain in >= 4 of 5 regions; symptoms present >= 3 months.",
    "notes": "The 2016 criteria replaced the 1990 tender point examination. Fibromyalgia can coexist with other conditions."
  },
