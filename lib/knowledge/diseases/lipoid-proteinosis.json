  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Diagnostic Criteria for Lipoid Proteinosis",
    "criteria": [
      {
        "id": "hoarseness",
        "description": "Early onset hoarseness of voice due to vocal cord infiltration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-hyaline-deposits",
        "description": "Presence of hyaline material deposits in skin and mucosa confirmed by biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "beaded-eyelid-lesions",
        "description": "Characteristic beaded papules along the eyelid margins (moniliform blepharosis)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-findings",
        "description": "Calcifications in the medial temporal lobes (amygdala) on imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early hoarseness plus histopathological confirmation of hyaline deposits in skin or mucosa",
    "notes": "Genetic testing for ECM1 mutations can support diagnosis but is not mandatory"
  },
