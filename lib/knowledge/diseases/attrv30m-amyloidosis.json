  "keyFindings": {
    "laboratory": [
      "Elevated serum TTR levels may be normal or decreased",
      "Presence of monoclonal protein usually absent (helps differentiate from AL amyloidosis)",
      "Proteinuria on urinalysis"
    ],
    "imaging": [
      "Cardiac MRI showing late gadolinium enhancement with restrictive cardiomyopathy pattern",
      "Nerve conduction studies showing axonal sensorimotor polyneuropathy",
      "Echocardiogram demonstrating thickened ventricular walls with diastolic dysfunction"
    ],
    "genetic": [
      "TTR (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Positive Congo red staining with apple-green birefringence under polarized light in biopsy specimens",
      "Autonomic function testing demonstrating impaired sympathetic and parasympathetic responses"
    ]
  },
  "differentialDiagnoses": [
