  "diagnosticCriteria": {
    "formalCriteriaName": "Ear-Patella-Short Stature Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "ear-malformations",
        "description": "Characteristic malformations of the external ear including low-set, cup-shaped ears",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "patellar-hypoplasia",
        "description": "Hypoplasia or aplasia of the patellae confirmed by clinical and radiological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Postnatal short stature below the 3rd percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Additional skeletal anomalies such as brachydactyly or clinodactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: characteristic ear malformations, patellar hypoplasia/aplasia, and short stature",
    "notes": "Genetic testing for mutations in the KCNJ2 gene may support diagnosis but is not mandatory"
  },
