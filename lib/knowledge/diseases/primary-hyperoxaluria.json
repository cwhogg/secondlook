  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Primary Hyperoxaluria",
    "criteria": [
      {
        "id": "hyperoxaluria",
        "description": "Elevated urinary oxalate excretion above 0.5 mmol/1.73 m2/24h",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in AGXT, GRHPR, or HOGA1 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-stone-history",
        "description": "Recurrent nephrolithiasis or nephrocalcinosis detected by imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "plasma-oxalate",
        "description": "Elevated plasma oxalate concentration in advanced disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated urinary oxalate excretion plus identification of pathogenic mutations in relevant genes",
    "notes": "Genetic testing is essential for definitive diagnosis and subtype classification."
  },
