  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed diagnostic criteria for cardiac-valvular Ehlers-Danlos syndrome",
    "criteria": [
      {
        "id": "valvular-dysplasia",
        "description": "Severe progressive cardiac-valvular disease involving mitral, aortic, and/or tricuspid valves",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-hyperextensibility",
        "description": "Marked skin hyperextensibility with velvety texture",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-hypermobility",
        "description": "Generalized joint hypermobility with recurrent dislocations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Biallelic pathogenic variants in the COL1A2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (severe valvular disease, skin hyperextensibility, joint hypermobility) plus confirmation by genetic testing",
    "notes": "Genetic testing is essential to confirm diagnosis due to overlap with other EDS subtypes."
  },
