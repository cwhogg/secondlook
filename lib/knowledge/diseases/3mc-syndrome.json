  "diagnosticCriteria": {
    "formalCriteriaName": "3MC Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including hypertelorism, blepharophimosis, and ptosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cleft-lip-palate",
        "description": "Presence of cleft lip and/or cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural or conductive hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "umbilical-hernia",
        "description": "Umbilical or inguinal hernia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic variants in MASP1, COLEC11, or COLEC10 genes",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic facial dysmorphism, cleft lip/palate, and pathogenic variant in MASP1, COLEC11, or COLEC10 genes",
    "notes": "Diagnosis is clinical but confirmed by molecular genetic testing."
  },
