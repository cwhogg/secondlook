  "diagnosticCriteria": {
    "formalCriteriaName": "Hydroa Vacciniforme Diagnostic Criteria",
    "criteria": [
      {
        "id": "photodistributed-vesiculopapular-lesions",
        "description": "Recurrent vesiculopapular eruptions in sun-exposed areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vacciniforme-scarring",
        "description": "Vacciniforme varioliform scarring following lesion resolution",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ebv-association",
        "description": "Evidence of Epstein-Barr virus (EBV) infection or EBV-encoded RNA positivity in skin lesions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "phototesting",
        "description": "Positive phototesting reproducing lesions",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing necrotic keratinocytes with lymphocytic infiltration",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent photodistributed vesiculopapular lesions with vacciniforme scarring and evidence of EBV infection",
    "notes": "Diagnosis requires exclusion of other photodermatoses and lymphoproliferative disorders."
  },
