  "diagnosticCriteria": {
    "formalCriteriaName": "No formal diagnostic criteria established",
    "criteria": [
      {
        "id": "cutis-gyrata",
        "description": "Presence of cutis gyrata characterized by thickened, folded, and ridged scalp skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acanthosis-nigricans",
        "description": "Development of acanthosis nigricans with hyperpigmented, velvety plaques typically in flexural areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of one or more cranial sutures confirmed clinically and/or radiologically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia and hypertelorism",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: cutis gyrata, acanthosis nigricans, and craniosynostosis",
    "notes": "Diagnosis is clinical and supported by imaging and dermatological examination; genetic testing may assist but no specific gene identified"
  },
