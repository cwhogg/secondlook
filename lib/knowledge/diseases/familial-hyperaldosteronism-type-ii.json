  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Hyperaldosteronism Diagnostic Criteria",
    "criteria": [
      {
        "id": "family-history",
        "description": "Presence of first-degree relatives with primary aldosteronism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-evidence",
        "description": "Elevated plasma aldosterone concentration with suppressed plasma renin activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Absence of chimeric CYP11B1/CYP11B2 gene fusion (distinguishing from FH type I)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "adrenal-imaging",
        "description": "Adrenal adenoma or hyperplasia detected by CT or MRI",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of family history plus biochemical evidence of primary aldosteronism",
    "notes": "Genetic testing helps differentiate FH-II from FH-I; adrenal imaging supports diagnosis."
  },
