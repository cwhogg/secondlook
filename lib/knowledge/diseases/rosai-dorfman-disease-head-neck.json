    "formalCriteriaName": "Rosai-Dorfman Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "massive-cervical-lymphadenopathy",
        "description": "Painless, massive bilateral cervical lymphadenopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "emperipolesis",
        "description": "Histopathologic evidence of emperipolesis (lymphocytes within histiocytes)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry-profile",
        "description": "Histiocytes positive for S100 and CD68, negative for CD1a",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "extranodal-involvement",
        "description": "Presence of extranodal masses in head and neck regions",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of massive cervical lymphadenopathy plus histopathologic confirmation with emperipolesis and characteristic immunohistochemistry",
    "notes": "Diagnosis requires lymph node biopsy with histopathology and immunophenotyping"
  },
