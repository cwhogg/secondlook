    "laboratory": [
      "Negative rheumatoid factor on repeated testing",
      "Elevated erythrocyte sedimentation rate (ESR) and C-reactive protein (CRP)",
      "Mild normocytic anemia"
    ],
    "imaging": [
      "Joint space narrowing and erosions on X-ray in advanced disease",
      "Ultrasound showing synovial hypertrophy and increased vascularity"
    ],
    "genetic": [
