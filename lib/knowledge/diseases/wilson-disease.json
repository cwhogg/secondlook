  "diagnosticCriteria": {
    "formalCriteriaName": "Leipzig Scoring System for Wilson Disease (8th International Meeting on Wilson Disease, 2001)",
    "criteria": [
      {
        "id": "wd-c1",
        "description": "Kayser-Fleischer rings on slit-lamp examination",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "wd-c2",
        "description": "Low serum ceruloplasmin (<20 mg/dL)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "wd-c3",
        "description": "Elevated 24-hour urine copper (>40 µg/day; >100 µg/day highly suggestive)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "wd-c4",
        "description": "Elevated hepatic copper content (>250 µg/g dry weight)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "wd-c5",
        "description": "Pathogenic mutations in ATP7B gene (biallelic)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "wd-c6",
        "description": "Neuropsychiatric symptoms consistent with Wilson disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "wd-c7",
        "description": "Coombs-negative hemolytic anemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Leipzig score >= 4 based on combined clinical, biochemical, and genetic findings",
    "notes": "No single test is sufficient for diagnosis. A combination of clinical features, biochemistry, and genetics is typically required. Up to 50% of hepatic presentations lack Kayser-Fleischer rings."
  },
