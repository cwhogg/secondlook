  "keyFindings": {
    "laboratory": [
      "Inflammatory markers may be elevated if mycotic aneurysm present",
      "Blood cultures positive in infectious cases"
    ],
    "imaging": [
      "Ultrasound Doppler showing aneurysmal dilation and turbulent flow",
      "CT angiography demonstrating size, morphology, and extent of aneurysm",
      "MR angiography for detailed vessel wall and flow assessment"
    ],
    "genetic": [
      "No specific genetic markers identified; may be associated with connective tissue disorders in some cases"
    ],
    "other": [
      "Physical examination revealing pulsatile neck mass and carotid bruit",
      "Neurological examination for focal deficits or cranial nerve involvement"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "carotid-artery-dissection",
      "distinguishingFeatures": [
        "Sudden onset neck pain and neurological symptoms",
        "Imaging shows intimal flap or false lumen rather than aneurysmal dilation"
      ]
    },
    {
      "diseaseId": "carotid-body-tumor",
      "distinguishingFeatures": [
        "Non-pulsatile neck mass at carotid bifurcation",
        "Hypervascular tumor on imaging without aneurysmal dilation"
      ]
    },
    {
      "diseaseId": "vasculitis-of-carotid-artery",
      "distinguishingFeatures": [
        "Systemic inflammatory symptoms",
        "Imaging shows vessel wall thickening and stenosis rather than aneurysm"
      ]
    }
  ],
  "redFlags": [
    "Sudden onset neurological deficits indicating possible embolic stroke",
    "Rapidly enlarging pulsatile neck mass",
    "Signs of aneurysm rupture such as sudden neck pain and hemorrhagic shock"
  ],
