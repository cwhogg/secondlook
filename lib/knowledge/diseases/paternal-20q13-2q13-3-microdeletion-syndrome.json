    "formalCriteriaName": "Paternal 20q13.2q13.3 Microdeletion Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of a microdeletion at chromosome 20q13.2q13.3 of paternal origin by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability presenting in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Presence of characteristic craniofacial dysmorphic features including micrognathia and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia and feeding difficulties",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of paternal 20q13.2q13.3 microdeletion plus at least one major clinical criterion (developmental delay or characteristic dysmorphic features)",
    "notes": "Diagnosis relies heavily on genetic testing combined with clinical presentation; phenotypic variability exists."
  },
