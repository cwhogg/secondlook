  "diagnosticCriteria": {
    "formalCriteriaName": "Pfeiffer Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of cranial sutures (craniosynostosis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "broad-thumbs",
        "description": "Broad and medially deviated thumbs and great toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midface-hypoplasia",
        "description": "Midface hypoplasia with midfacial retrusion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "FGFR-mutation",
        "description": "Presence of pathogenic FGFR1 or FGFR2 gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Conductive or sensorineural hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis plus broad thumbs and/or great toes, with or without confirmed FGFR mutation",
    "notes": "Genetic testing for FGFR1 or FGFR2 mutations supports diagnosis but is not mandatory."
  },
