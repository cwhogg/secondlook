        "requiredForDiagnosis": true
      },
      {
        "id": "anterior-chamber-cells",
        "description": "Minimal or absent anterior chamber inflammation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-uveitis",
        "description": "Exclusion of infectious, neoplastic, or systemic autoimmune causes",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of vitreous inflammation with snowbanking or snowballs in the pars plana region and exclusion of other causes",
    "notes": "Diagnosis is clinical and supported by slit-lamp examination and imaging; infectious and systemic causes must be ruled out."
