  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Slit-lamp biomicroscopy showing small pupil and iris dilator muscle hypoplasia",
      "Anterior segment optical coherence tomography (OCT) demonstrating iris structural abnormalities"
    ],
    "genetic": [
      "Mutations or deletions in chromosome 13q31-q32 region associated with autosomal dominant inheritance"
    ],
    "other": [
      "Normal intraocular pressure in most cases",
      "Normal fundoscopic examination"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "aniridia",
      "distinguishingFeatures": [
        "Complete or partial absence of the iris",
        "Associated with foveal hypoplasia and nystagmus",
        "Often involves PAX6 gene mutations"
      ]
    },
    {
      "diseaseId": "argyll-robertson-pupil",
      "distinguishingFeatures": [
        "Small irregular pupils that constrict to accommodation but not to light",
        "Associated with neurosyphilis",
        "Usually acquired, not congenital"
      ]
    },
    {
      "diseaseId": "horner-syndrome",
      "distinguishingFeatures": [
        "Ptosis, miosis, and anhidrosis",
        "Pupil constriction due to sympathetic denervation",
        "Often unilateral and acquired"
      ]
    }
  ],
  "redFlags": [
