  "diagnosticCriteria": {
    "formalCriteriaName": "Netchine-Harbison Clinical Scoring System (NH-CSS)",
    "criteria": [
      {
        "id": "prenatal-growth-retardation",
        "description": "Prenatal growth retardation with birth weight and/or length ≤ -2 SD",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "postnatal-growth-retardation",
        "description": "Postnatal growth failure with height ≤ -2 SD at 24 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "relative-macrocephaly-at-birth",
        "description": "Relative macrocephaly at birth (head circumference ≥ 1.5 SD above birth weight/length SD score)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "body-hemihypoplasia",
        "description": "Body asymmetry or hemihypoplasia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "feeding-difficulties",
        "description": "Feeding difficulties and/or low BMI ≤ -2 SD at 24 months",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "protruding-forehead",
        "description": "Prominent forehead during early childhood",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "At least 4 of 6 criteria including prenatal and postnatal growth retardation",
    "notes": "Molecular confirmation by detection of maternal uniparental disomy of chromosome 7 supports diagnosis"
  },
