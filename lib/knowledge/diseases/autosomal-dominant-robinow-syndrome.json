  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Robinow Syndrome",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia, broad nasal bridge, hypertelorism, and prominent forehead",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mesomelic-limb-shortening",
        "description": "Mesomelic shortening of the limbs with short forearms and lower legs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the WNT5A gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "vertebral-anomalies",
        "description": "Presence of vertebral segmentation defects or hemivertebrae",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genital-anomalies",
        "description": "Hypoplastic genitalia in males or other genital abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic facial dysmorphism and mesomelic limb shortening with either genetic confirmation or supportive skeletal anomalies",
    "notes": "Genetic testing for WNT5A mutations is confirmatory but not always necessary if clinical features are classic."
  },
