  "diagnosticCriteria": {
    "formalCriteriaName": "Late-onset Retinal Degeneration Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive central vision loss with nyctalopia and metamorphopsia in middle-aged adults",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fundus-findings",
        "description": "Characteristic yellowish subretinal deposits and geographic atrophy in the macula observed on fundoscopic examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the C1QTNF5 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electroretinogram showing reduced rod and cone responses",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive central vision loss with characteristic fundus findings and identification of pathogenic C1QTNF5 mutation",
    "notes": "Diagnosis is confirmed by genetic testing; electrophysiology and family history support diagnosis."
  },
