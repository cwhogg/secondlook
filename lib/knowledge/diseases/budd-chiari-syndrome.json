      "Increased bilirubin levels",
      "Prolonged prothrombin time",
      "Thrombocytopenia"
    ],
    "imaging": [
      "Doppler ultrasound showing hepatic vein thrombosis or absent flow",
      "CT or MRI demonstrating hepatic vein or IVC obstruction",
      "Venography confirming venous outflow obstruction"
    ],
    "genetic": [
      "Mutations associated with thrombophilia (e.g., Factor V Leiden, prothrombin gene mutation)"
    ],
