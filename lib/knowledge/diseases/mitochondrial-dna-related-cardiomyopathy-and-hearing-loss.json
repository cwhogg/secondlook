  "keyFindings": {
    "laboratory": [
      "Elevated blood lactate and pyruvate levels",
      "Elevated creatine kinase (CK) in some cases"
    ],
    "imaging": [
      "Echocardiography showing dilated or hypertrophic cardiomyopathy",
      "Cardiac MRI demonstrating myocardial fibrosis or hypertrophy"
    ],
    "genetic": [
      "MT-TK (causative)",
      "Pathogenic mitochondrial DNA mutations (e.g., m.3243A>G, m.8344A>G)",
      "Mitochondrial inheritance inheritance"
    ],
    "other": [
      "Muscle biopsy with ragged-red fibers and cytochrome c oxidase deficiency",
      "Audiometry confirming sensorineural hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "leber-hereditary-optic-neuropathy",
