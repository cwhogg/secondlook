  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Distal Renal Tubular Acidosis",
    "criteria": [
      {
        "id": "non-anion-gap-metabolic-acidosis",
        "description": "Presence of hyperchloremic non-anion gap metabolic acidosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "inability-to-acidify-urine",
        "description": "Urine pH persistently >5.5 despite systemic acidemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypokalemia",
        "description": "Hypokalemia or low serum potassium levels",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "nephrocalcinosis",
        "description": "Evidence of nephrocalcinosis or nephrolithiasis on imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-glomerular-filtration-rate",
        "description": "Normal or near-normal glomerular filtration rate",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hyperchloremic non-anion gap metabolic acidosis with inability to acidify urine (urine pH >5.5) in the absence of other causes",
    "notes": "Exclusion of proximal RTA and other causes of metabolic acidosis is essential"
  },
