  "keyFindings": {
    "laboratory": [
      "Normal creatine kinase or mildly elevated",
      "Electromyography showing chronic denervation and reinnervation"
    ],
    "imaging": [
      "Muscle MRI showing selective proximal muscle atrophy and fatty replacement"
    ],
    "genetic": [
      "VAPB (causative)",
      "Pathogenic variant in gene associated with autosomal dominant proximal SMA (e.g., BICD2, DYNC1H1 mutations)"
    ],
    "other": [
      "Nerve conduction studies typically normal or mildly reduced motor amplitudes"
    ]
  },
