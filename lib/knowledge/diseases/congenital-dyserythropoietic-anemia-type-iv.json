  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Congenital Dyserythropoietic Anemia Type IV",
    "criteria": [
      {
        "id": "ineffective-erythropoiesis",
        "description": "Presence of ineffective erythropoiesis with anemia and reticulocytopenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "erythroblast-morphology",
        "description": "Distinct morphological abnormalities of erythroblasts including multinuclearity and chromatin bridging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in KLF1 gene associated with CDA type IV",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-examination",
        "description": "Bone marrow showing erythroid hyperplasia with dyserythropoietic features",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of anemia with ineffective erythropoiesis, characteristic erythroblast morphological abnormalities, and confirmatory genetic mutation in KLF1",
    "notes": "Diagnosis requires exclusion of other CDA types and related anemias."
  },
