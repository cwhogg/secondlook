  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Kir6.2-Related Hyperinsulinism",
    "criteria": [
      {
        "id": "persistent-hypoglycemia",
        "description": "Documented persistent hypoglycemia with inappropriately elevated insulin levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing-kir6-2",
        "description": "Identification of pathogenic or likely pathogenic heterozygous mutation in KCNJ11 gene encoding Kir6.2",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-diazooxide",
        "description": "Clinical response or partial response to diazoxide therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history consistent with autosomal dominant inheritance of hyperinsulinism",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent hypoglycemia with elevated insulin and identification of pathogenic KCNJ11 mutation",
    "notes": "Genetic confirmation is essential for definitive diagnosis; clinical features alone may overlap with other hyperinsulinism forms."
  },
