  "differentialDiagnoses": [
    {
      "diseaseId": "classic-21-hydroxylase-deficiency",
      "distinguishingFeatures": [
        "Absence of skeletal malformations",
        "Different steroid profile with predominant 17-hydroxyprogesterone elevation",
        "Genetic mutations in CYP21A2 gene"
      ]
    },
    {
      "diseaseId": "antley-bixler-syndrome",
      "distinguishingFeatures": [
        "Overlap in skeletal abnormalities but usually no adrenal insufficiency",
        "Caused by FGFR2 mutations",
        "Distinct craniofacial features"
      ]
    }
  ],
