  "diagnosticCriteria": {
    "formalCriteriaName": "Pyruvate Kinase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced pyruvate kinase enzyme activity in red blood cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemolytic-anemia",
        "description": "Chronic hemolytic anemia with reticulocytosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the PKLR gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-hemolytic",
        "description": "Exclusion of other causes of hemolytic anemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced pyruvate kinase enzyme activity and identification of pathogenic PKLR mutations, along with clinical evidence of chronic hemolytic anemia",
    "notes": "Diagnosis often requires combination of biochemical, genetic, and clinical findings"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Chronic hemolytic anemia",
        "frequency": 0.95,
        "bodySystem": "hematological",
        "notes": "Due to impaired glycolysis in erythrocytes",
        "searchTerms": [
          "long-term destruction of red blood cells",
          "chronic anemia from red cell breakdown",
          "ongoing hemolytic anemia"
        ]
      },
      {
        "symptomName": "Reduced pyruvate kinase enzyme activity",
        "frequency": 0.9,
        "bodySystem": "hematological",
        "notes": "Detected by enzyme assay in red blood cells",
        "searchTerms": [
          "low pyruvate kinase enzyme activity",
          "reduced enzyme for energy metabolism",
          "deficient pyruvate kinase function"
        ]
      }
    ],
    "common": [
      {
        "symptomName": "Jaundice",
        "frequency": 0.75,
        "bodySystem": "constitutional",
        "notes": "Resulting from increased bilirubin due to hemolysis"
      },
      {
        "symptomName": "Splenomegaly",
        "frequency": 0.7,
        "bodySystem": "hematological",
        "notes": "Due to extravascular hemolysis and sequestration"
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.65,
        "bodySystem": "constitutional",
        "notes": "Secondary to anemia"
      },
      {
        "symptomName": "Reticulocytosis",
        "frequency": 0.6,
        "bodySystem": "hematological",
        "notes": "Compensatory bone marrow response"
      },
      {
        "symptomName": "Gallstones (cholelithiasis)",
        "frequency": 0.55,
        "bodySystem": "gastrointestinal",
        "notes": "Due to chronic hemolysis and increased bilirubin"
      }
    ],
    "occasional": [
      {
