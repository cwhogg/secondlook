  "keyFindings": {
    "laboratory": [
      "Peripheral eosinophilia (present in ~80% of cases)",
      "Elevated serum IgE",
      "Hypoalbuminemia (if protein-losing enteropathy)",
      "Iron deficiency anemia (if mucosal involvement with bleeding)",
      "Stool studies negative for parasites"
    ],
    "imaging": [
      "CT abdomen: thickened gastric/bowel wall, ascites (serosal type), possible obstruction",
      "CT enterography: mucosal enhancement, fold thickening, luminal narrowing",
      "Small bowel follow-through: thickened folds, nodularity, narrowing"
    ],
    "genetic": [
      "No established single-gene cause",
      "Eotaxin (CCL11, CCL24, CCL26) polymorphisms implicated in susceptibility"
    ],
    "other": [
      "Upper endoscopy/colonoscopy with biopsies: mucosal erythema, nodularity, ulceration",
      "Multiple biopsies from affected areas needed (patchy distribution)",
      "Eosinophilic ascites: paracentesis shows > 500 eosinophils/microL (serosal type)",
      "Full-thickness biopsy may be needed for muscular/serosal subtypes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "eosinophilic-esophagitis",
      "distinguishingFeatures": [
        "EoE is limited to the esophagus",
        "EoE presents primarily with dysphagia and food impaction"
      ]
    },
    {
      "diseaseId": "hypereosinophilic-syndrome",
      "distinguishingFeatures": [
        "HES has persistent eosinophilia > 1500/microL for > 6 months",
        "HES involves multiple organs (cardiac, pulmonary, dermatologic) beyond GI"
      ]
    },
    {
      "diseaseId": "parasitic-infection",
      "distinguishingFeatures": [
        "Parasitic infections confirmed by stool ova/parasite or serology",
        "Travel history and epidemiologic exposure"
      ]
    }
  ],
  "redFlags": [
    "Signs of intestinal obstruction (muscular subtype)",
    "Massive ascites with respiratory compromise (serosal subtype)",
    "Persistent eosinophilia > 1500 with multi-organ involvement (rule out HES)",
    "GI perforation",
    "Severe malabsorption with protein-losing enteropathy"
  ],
