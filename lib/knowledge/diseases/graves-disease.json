  "keyFindings": {
    "laboratory": [
      "Suppressed TSH (<0.1 mIU/L)",
      "Elevated free T4 and/or free T3",
      "TSH receptor antibodies (TRAb) positive (>95%)",
      "Anti-TPO antibodies positive (60-80%)",
      "Anti-thyroglobulin antibodies positive (50%)",
      "Elevated SHBG",
      "Mild hypercalcemia",
      "Elevated alkaline phosphatase (bone turnover)"
    ],
    "imaging": [
      "Radioiodine uptake scan: diffuse, homogeneously increased uptake (20-60%, vs. normal 10-30%)",
      "Thyroid ultrasound: diffuse enlargement, increased vascularity (thyroid inferno), hypoechoic parenchyma",
      "CT/MRI orbits (ophthalmopathy): enlarged extraocular muscles (especially inferior and medial recti), orbital fat expansion, proptosis"
    ],
    "genetic": [
      "HLA-DR3 (DRB1*0301) association",
      "CTLA-4 gene variants",
      "PTPN22 gene variants",
      "TSHR gene polymorphisms"
    ],
    "other": [
      "Clinical assessment of ophthalmopathy using CAS (Clinical Activity Score) and NOSPECS classification",
      "Orbital imaging for suspected compressive optic neuropathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hashimoto-thyroiditis",
      "distinguishingFeatures": [
        "Hypothyroidism",
        "Elevated TSH",
        "No ophthalmopathy (usually)",
        "Hashitoxicosis phase may transiently mimic Graves"
      ]
    },
    {
      "diseaseId": "toxic-multinodular-goiter",
      "distinguishingFeatures": [
        "Nodular goiter",
        "Older patients",
        "Patchy uptake on scan",
        "TRAb negative"
      ]
    },
    {
      "diseaseId": "subacute-thyroiditis",
      "distinguishingFeatures": [
        "Painful tender thyroid",
        "Low radioiodine uptake",
        "Elevated ESR",
        "Self-limited"
      ]
    },
    {
      "diseaseId": "factitious-thyrotoxicosis",
      "distinguishingFeatures": [
        "Exogenous thyroid hormone intake",
        "Low thyroglobulin",
        "Near-zero radioiodine uptake",
        "No goiter"
      ]
    }
  ],
  "redFlags": [
    "Signs of thyroid storm (fever >40C, tachycardia >140, altered mental status, seizures)",
    "Compressive optic neuropathy (vision loss, color desaturation, afferent pupillary defect)",
    "New atrial fibrillation or heart failure in thyrotoxic patient",
    "Agranulocytosis from antithyroid drugs (fever, sore throat - urgent CBC needed)",
    "Rapidly worsening ophthalmopathy"
  ],
