  "diagnosticCriteria": {
    "formalCriteriaName": "Silicosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "exposure-history",
        "description": "History of significant occupational exposure to crystalline silica dust",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-findings",
        "description": "Chest imaging showing bilateral nodular opacities predominantly in upper lung zones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-function",
        "description": "Evidence of restrictive or mixed ventilatory defect on pulmonary function tests",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of pneumoconiosis and granulomatous lung disease",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of significant silica exposure history plus characteristic radiologic findings and exclusion of other causes",
    "notes": "Lung biopsy is rarely required but may be used in atypical cases."
  },
