  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for X-linked Cerebral Adrenoleukodystrophy",
    "criteria": [
      {
        "id": "clinical-neurological-deterioration",
        "description": "Progressive neurobehavioral symptoms including cognitive decline and behavioral changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-mri-demyelination",
        "description": "Characteristic bilateral symmetric demyelination in parieto-occipital white matter on brain MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-vlcfa",
        "description": "Elevated plasma very long chain fatty acids (VLCFA) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abcd1-gene-mutation",
        "description": "Pathogenic mutation in the ABCD1 gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "adrenal-insufficiency",
        "description": "Evidence of primary adrenal insufficiency (Addison disease)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive neurological symptoms plus characteristic MRI findings and elevated VLCFA levels",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if biochemical and clinical criteria are met."
  },
