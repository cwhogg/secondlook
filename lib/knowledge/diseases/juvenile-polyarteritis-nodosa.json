  "aliases": [
    "Childhood Polyarteritis Nodosa",
    "Juvenile PAN"
  ],
  "icd10Codes": [
    "M30.0"
  ],
  "orphanetId": "ORPHA395",
  "prevalence": {
    "estimate": "1 in 1,000,000",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 2,
      "max": 18,
      "peak": 9
    },
    "sexPredilection": "slight-male",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "EULAR/PRINTO/PRES Criteria for Childhood Polyarteritis Nodosa",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Necrotizing vasculitis of medium-sized arteries on biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "angiographic-evidence",
        "description": "Angiographic abnormalities (aneurysms or stenoses) of medium-sized arteries",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of at least one of the following: myalgia, hypertension, peripheral neuropathy, or skin manifestations",
        "category": "minor",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-vasculitis",
        "description": "Exclusion of other vasculitides such as Kawasaki disease or microscopic polyangiitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathologic or angiographic evidence plus at least one clinical feature",
    "notes": "Diagnosis requires exclusion of other vasculitides and infectious causes."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Necrotizing vasculitis of medium-sized arteries",
        "frequency": 0.85,
        "bodySystem": "cardiovascular",
        "notes": "Histopathologic hallmark"
      },
      {
        "symptomName": "Angiographic aneurysms or stenoses in medium-sized arteries",
        "frequency": 0.75,
        "bodySystem": "cardiovascular",
        "notes": "Diagnostic imaging finding"
      }
    ],
    "common": [
      {
        "symptomName": "Myalgia and muscle tenderness",
        "frequency": 0.75,
        "bodySystem": "musculoskeletal",
        "notes": "Often proximal muscles"
      },
      {
        "symptomName": "Hypertension",
        "frequency": 0.7,
        "bodySystem": "cardiovascular",
        "notes": "Due to renal artery involvement"
      },
      {
        "symptomName": "Livedo reticularis",
        "frequency": 0.65,
        "bodySystem": "dermatological",
        "notes": "Mottled skin discoloration"
      },
      {
        "symptomName": "Peripheral neuropathy (mononeuritis multiplex)",
        "frequency": 0.6,
        "bodySystem": "neurological",
        "notes": "Sensory and motor deficits"
      },
      {
        "symptomName": "Fever",
        "frequency": 0.55,
        "bodySystem": "constitutional",
        "notes": "Intermittent or persistent"
      }
    ],
    "occasional": [
      {
        "symptomName": "Abdominal pain",
        "frequency": 0.4,
        "bodySystem": "gastrointestinal",
        "notes": "Due to mesenteric ischemia"
      },
      {
        "symptomName": "Weight loss",
        "frequency": 0.35,
        "bodySystem": "constitutional",
        "notes": "Chronic illness effect"
      },
      {
        "symptomName": "Renal impairment",
        "frequency": 0.3,
        "bodySystem": "renal",
        "notes": "From ischemic injury"
      },
      {
        "symptomName": "Arthralgia",
        "frequency": 0.25,
        "bodySystem": "musculoskeletal",
        "notes": "Joint pain without arthritis"
      },
      {
        "symptomName": "Testicular pain or tenderness",
        "frequency": 0.15,
        "bodySystem": "reproductive",
        "notes": "Due to vasculitis of testicular arteries"
      }
    ],
    "rare": [
      {
        "symptomName": "Cardiac involvement (myocarditis or coronary arteritis)",
        "frequency": 0.08,
        "bodySystem": "cardiovascular",
        "notes": "May cause heart failure or arrhythmias"
      },
      {
        "symptomName": "Central nervous system involvement",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Stroke or seizures"
      },
      {
        "symptomName": "Pulmonary involvement",
        "frequency": 0.03,
        "bodySystem": "respiratory",
        "notes": "Rare in juvenile PAN"
      }
    ]
  },
  "systemsAffected": [
    "musculoskeletal",
    "cardiovascular",
    "dermatological",
    "neurological",
    "constitutional",
