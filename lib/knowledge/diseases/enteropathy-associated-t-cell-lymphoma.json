  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Tumors of Hematopoietic and Lymphoid Tissues",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of malignant T-cell infiltration in the intestinal epithelium with characteristic morphology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotyping",
        "description": "Expression of CD3+, CD7+, CD103+, and cytotoxic markers with loss of CD5 and CD8 in tumor cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinicalContext",
        "description": "Association with refractory celiac disease or history of celiac disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "molecularStudies",
        "description": "Clonal T-cell receptor gene rearrangement detected by PCR",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of malignant T-cell infiltration with supportive immunophenotyping findings",
    "notes": "Diagnosis requires exclusion of other intestinal lymphomas and correlation with clinical history of celiac disease."
  },
