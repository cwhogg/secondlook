  "keyFindings": {
    "laboratory": [
      "Microcytic hypochromic anemia with low MCV and MCH",
      "Presence of HbH and Hb Bart's on hemoglobin electrophoresis",
      "Elevated reticulocyte count",
      "Elevated serum bilirubin and lactate dehydrogenase (LDH)",
      "Iron studies may show secondary iron overload"
    ],
    "imaging": [
      "Bone marrow expansion visible on skull and facial X-rays",
      "Ultrasound showing hepatosplenomegaly",
      "MRI may detect extramedullary hematopoietic masses"
    ],
    "genetic": [
      "Deletion or mutation of one or more alpha-globin genes (HBA1, HBA2)",
      "Molecular genetic testing confirms genotype",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Positive family history",
      "Supravital staining showing HbH inclusions"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "beta-thalassemia",
      "distinguishingFeatures": [
        "Beta-globin gene mutations instead of alpha-globin",
        "Different hemoglobin electrophoresis pattern with elevated HbA2",
        "Usually later onset and different ethnic distribution"
      ]
    },
    {
      "diseaseId": "iron-deficiency-anemia",
      "distinguishingFeatures": [
        "Low serum ferritin and iron levels",
        "No hemoglobin H or Bart's on electrophoresis",
        "Responds to iron supplementation"
      ]
    },
    {
      "diseaseId": "hemoglobin-constant-spring",
      "distinguishingFeatures": [
        "Non-deletional alpha-thalassemia variant",
        "Presence of abnormal elongated alpha-globin chains",
        "Detected by specific molecular testing"
      ]
    }
  ],
