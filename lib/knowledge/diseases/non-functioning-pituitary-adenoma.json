  "keyFindings": {
    "laboratory": [
      "Normal or low pituitary hormone levels (e.g., TSH, ACTH, LH, FSH)",
      "Mildly elevated prolactin due to stalk effect",
      "Low target gland hormones secondary to hypopituitarism"
    ],
    "imaging": [
      "MRI showing sellar mass without invasion of surrounding structures",
      "No evidence of hormone-secreting tumor on imaging"
    ],
    "genetic": [
      "No consistent genetic mutations identified; sporadic occurrence"
    ],
    "other": [
      "Histopathology showing adenoma cells negative for pituitary hormones",
      "Immunohistochemistry negative for GH, PRL, ACTH, TSH, LH, FSH"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "prolactin-secreting-pituitary-adenoma",
      "distinguishingFeatures": [
        "Elevated serum prolactin levels",
        "Clinical signs of hyperprolactinemia such as galactorrhea and amenorrhea"
      ]
    },
    {
      "diseaseId": "growth-hormone-secreting-pituitary-adenoma",
      "distinguishingFeatures": [
        "Elevated IGF-1 and GH levels",
        "Clinical features of acromegaly"
      ]
    },
    {
      "diseaseId": "craniopharyngioma",
      "distinguishingFeatures": [
        "Calcifications on imaging",
        "More common in children and adolescents",
        "Different histopathological features"
      ]
    }
  ],
