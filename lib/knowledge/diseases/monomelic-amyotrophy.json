  "diagnosticCriteria": {
    "formalCriteriaName": "Hirayama Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "unilateral-distal-weakness",
        "description": "Unilateral or asymmetric distal upper limb muscle weakness and atrophy predominantly affecting C7, C8, and T1 myotomes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-upper-motor-neuron-signs",
        "description": "No clinical or electrophysiological evidence of upper motor neuron involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cervical-flexion-mri-findings",
        "description": "Dynamic cervical MRI showing forward displacement of the posterior dural sac on neck flexion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "slow-progressive-course",
        "description": "Slowly progressive course over several years followed by stabilization",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyography showing chronic denervation in affected muscles without sensory nerve involvement",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of unilateral distal upper limb weakness and atrophy without upper motor neuron signs, supported by characteristic cervical MRI findings and EMG evidence of chronic denervation",
    "notes": "Diagnosis requires exclusion of other motor neuron diseases and cervical myelopathies."
  },
