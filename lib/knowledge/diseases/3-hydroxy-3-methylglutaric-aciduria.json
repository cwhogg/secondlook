  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for HMG-CoA lyase deficiency",
    "criteria": [
      {
        "id": "urinary-organic-acids",
        "description": "Presence of elevated 3-hydroxy-3-methylglutaric acid and related metabolites in urine organic acid analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-activity",
        "description": "Deficient 3-hydroxy-3-methylglutaryl-CoA lyase enzyme activity in liver or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the HMGCL gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Episodes of hypoketotic hypoglycemia and metabolic acidosis in infancy or early childhood",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated urinary 3-hydroxy-3-methylglutaric acid plus either deficient enzyme activity or pathogenic HMGCL gene variants",
    "notes": "Early diagnosis is critical to prevent metabolic crises and neurological damage."
  },
