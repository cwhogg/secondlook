  "differentialDiagnoses": [
    {
      "diseaseId": "achondroplasia",
      "distinguishingFeatures": [
        "Absence of developmental delay",
        "Lack of acanthosis nigricans",
        "Different FGFR3 mutations (commonly p.Gly380Arg)"
      ]
    },
    {
      "diseaseId": "hypochondroplasia",
      "distinguishingFeatures": [
        "Milder short stature phenotype",
        "No acanthosis nigricans",
        "Later onset developmental delay if present"
      ]
    },
