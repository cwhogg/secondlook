  "diagnosticCriteria": {
    "formalCriteriaName": "IgA Nephropathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "mesangial-iga-deposition",
        "description": "Mesangial deposition of IgA confirmed by immunofluorescence microscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mesangial-proliferation",
        "description": "Mesangial hypercellularity and expansion on light microscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-secondary-causes",
        "description": "Exclusion of secondary causes of IgA deposition such as liver disease or Henoch-Schönlein purpura",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of recurrent episodes of gross hematuria often coinciding with upper respiratory tract infections",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Mesangial IgA deposition with mesangial proliferation on renal biopsy and exclusion of secondary causes",
    "notes": "Renal biopsy is essential for definitive diagnosis."
  },
