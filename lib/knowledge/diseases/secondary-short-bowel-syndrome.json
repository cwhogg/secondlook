  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnosis of Secondary Short Bowel Syndrome",
    "criteria": [
      {
        "id": "criterion-1",
        "description": "History of extensive small bowel resection or loss of functional small intestine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-2",
        "description": "Malabsorption symptoms including chronic diarrhea and nutrient deficiencies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-3",
        "description": "Radiological evidence of reduced small bowel length on imaging studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-4",
        "description": "Exclusion of primary congenital causes of short bowel syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of history of extensive small bowel resection, malabsorption symptoms, and radiological confirmation of reduced small bowel length",
    "notes": "Diagnosis is clinical supported by imaging and exclusion of other causes"
  },
