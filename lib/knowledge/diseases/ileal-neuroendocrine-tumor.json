  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Neuroendocrine Tumors",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histological confirmation of neuroendocrine tumor cells in ileal tissue with immunohistochemical staining positive for chromogranin A and synaptophysin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Detection of ileal mass or metastases on cross-sectional imaging (CT/MRI) or somatostatin receptor scintigraphy (Octreoscan or PET)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical",
        "description": "Elevated serum chromogranin A and/or 24-hour urinary 5-HIAA levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation plus imaging evidence of tumor or metastases",
    "notes": "Grading and staging per WHO classification guide prognosis and treatment."
  },
