  "keyFindings": {
    "laboratory": [
      "Markedly reduced lysosomal acid lipase enzyme activity",
      "Elevated serum transaminases",
      "Dyslipidemia with elevated cholesterol and triglycerides",
      "Anemia and pancytopenia in advanced cases"
    ],
    "imaging": [
      "Bilateral adrenal gland calcifications on abdominal X-ray or CT",
      "Hepatosplenomegaly on ultrasound or CT",
      "Possible cardiomegaly on chest X-ray"
    ],
    "genetic": [
      "Pathogenic mutations in the LIPA gene identified by molecular genetic testing"
    ],
    "other": [
      "Histopathology showing lipid-laden macrophages in liver and other tissues"
    ]
