  "keyFindings": {
    "laboratory": [
      "Elevated serum transaminases (ALT, AST)",
      "Reduced tear production on Schirmer test",
      "Mild thrombocytopenia or anemia in some cases"
    ],
    "imaging": [
      "MRI showing basal ganglia signal abnormalities",
      "Ultrasound demonstrating hepatomegaly and possible splenomegaly"
    ],
    "genetic": [
      "NGLY1 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Abnormal liver biopsy showing hepatocellular damage and fibrosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "allgrove-syndrome",
      "distinguishingFeatures": [
        "Presence of achalasia and adrenal insufficiency",
        "Triple A syndrome with alacrimia but different neurological and hepatic involvement"
      ]
    },
    {
      "diseaseId": "wilson-disease",
      "distinguishingFeatures": [
        "Kayser-Fleischer rings on ophthalmologic exam",
        "Copper metabolism abnormalities",
        "Predominant hepatic and neurological symptoms without alacrimia"
      ]
    }
  ],
  "redFlags": [
    "Early onset of severe alacrimia with neurological symptoms",
    "Progressive liver dysfunction with hepatomegaly",
    "Development of choreoathetosis in infancy or early childhood"
  ],
