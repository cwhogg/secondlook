  "diagnosticCriteria": {
    "formalCriteriaName": "Renal-Hepatic-Pancreatic Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "renal-cystic-dysplasia",
        "description": "Presence of bilateral renal cystic dysplasia confirmed by imaging or histology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepatic-fibrosis",
        "description": "Congenital hepatic fibrosis with portal hypertension or histological confirmation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pancreatic-dysplasia",
        "description": "Pancreatic cystic or ductal dysplasia identified by imaging or histopathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in associated genes (e.g., NPHP3, TMEM67)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: renal cystic dysplasia, hepatic fibrosis, and pancreatic dysplasia",
    "notes": "Diagnosis is primarily clinical supported by imaging and histopathology; genetic testing can aid confirmation."
  },
