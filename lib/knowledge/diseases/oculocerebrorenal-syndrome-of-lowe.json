  "keyFindings": {
    "laboratory": [
      "Elevated urinary amino acids, glucose, phosphate, and bicarbonate indicating proximal tubular dysfunction",
      "Metabolic acidosis with normal anion gap",
      "Hypophosphatemia and hypokalemia"
    ],
    "imaging": [
      "Brain MRI may show cerebral atrophy",
      "Renal ultrasound may show nephrocalcinosis",
      "Ophthalmologic exam reveals cataracts and glaucoma"
    ],
    "genetic": [
      "OCRL (causative, loss-of-function)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Reduced OCRL enzyme activity in cultured fibroblasts or leukocytes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "fanconi-syndrome",
