  "diagnosticCriteria": {
    "formalCriteriaName": "Hypocomplementemic Urticarial Vasculitis Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "persistent-urticarial-lesions",
        "description": "Urticarial skin lesions lasting more than 24 hours",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathologic-evidence",
        "description": "Skin biopsy showing leukocytoclastic vasculitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypocomplementemia",
        "description": "Low serum complement levels (C3, C4, or CH50)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "systemic-involvement",
        "description": "Presence of systemic symptoms such as arthralgia, ocular inflammation, or renal involvement",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "anti-c1q-antibodies",
        "description": "Detection of anti-C1q antibodies in serum",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent urticarial lesions lasting >24 hours plus histopathologic evidence of leukocytoclastic vasculitis; hypocomplementemia and systemic involvement support diagnosis",
    "notes": "Diagnosis is clinical and histological; hypocomplementemia is common but not mandatory"
  },
