  "differentialDiagnoses": [
    {
      "diseaseId": "marfan-syndrome",
      "distinguishingFeatures": [
        "Presence of cardiovascular complications such as aortic root dilation",
        "Ectopia lentis (lens dislocation) absent in SIDPLSGFLF syndrome",
        "Usually normal intellectual development"
      ]
    },
    {
      "diseaseId": "angelman-syndrome",
      "distinguishingFeatures": [
        "Characteristic happy demeanor with frequent laughter",
        "Ataxia and seizures more prominent",
        "Genetic testing positive for 15q11-q13 abnormalities"
      ]
    }
  ],
