  "keyFindings": {
    "laboratory": [
      "Mild anemia",
      "Elevated liver enzymes in some cases"
    ],
    "imaging": [
      "Chest X-ray or echocardiography showing pericardial thickening or constrictive pericarditis",
      "Skeletal radiographs showing slender long bones and delayed bone age",
      "Liver ultrasound showing hepatomegaly or fibrosis"
    ],
    "genetic": [
      "TRIM37 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Characteristic facial dysmorphism on clinical examination"
    ]
  },
