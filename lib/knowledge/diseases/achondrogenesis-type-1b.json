  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Achondrogenesis Type 1B",
    "criteria": [
      {
        "id": "prenatal-lethal",
        "description": "Prenatal or perinatal lethality due to respiratory insufficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-micromelia",
        "description": "Severe micromelia with extremely short limbs and small thorax",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-findings",
        "description": "Characteristic radiological features including absent or severely hypoplastic ossification of vertebral bodies and pelvis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the SLC26A2 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-features",
        "description": "Distinctive facial features including macrocephaly, prominent forehead, and flat nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe micromelia and characteristic radiological findings with prenatal lethality; genetic confirmation supports diagnosis",
    "notes": "Diagnosis is often made prenatally or at birth due to lethality and characteristic skeletal abnormalities."
  },
