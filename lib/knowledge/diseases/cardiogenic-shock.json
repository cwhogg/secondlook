  "keyFindings": {
    "laboratory": [
      "Elevated serum lactate indicating tissue hypoperfusion",
      "Elevated cardiac biomarkers (troponin) if myocardial infarction is underlying cause",
      "Metabolic acidosis on arterial blood gas"
    ],
    "imaging": [
      "Echocardiogram showing reduced left ventricular ejection fraction",
      "Chest X-ray demonstrating pulmonary congestion or edema",
      "Hemodynamic monitoring showing low cardiac output and elevated filling pressures"
    ],
    "genetic": [],
    "other": [
      "Electrocardiogram abnormalities consistent with ischemia or infarction",
      "Hemodynamic parameters from pulmonary artery catheterization"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "septic-shock",
      "distinguishingFeatures": [
        "Presence of infection and systemic inflammatory response",
        "Warm extremities and vasodilation rather than cold extremities",
        "Elevated or normal cardiac output rather than low"
      ]
    },
    {
      "diseaseId": "hypovolemic-shock",
      "distinguishingFeatures": [
        "History of hemorrhage or fluid loss",
        "Low central venous pressure and absence of elevated filling pressures",
        "Rapid improvement with fluid resuscitation"
      ]
    }
  ],
  "redFlags": [
    "Persistent hypotension despite fluid resuscitation",
    "Signs of multi-organ failure (renal, neurological deterioration)",
    "Rapid progression to cardiac arrest"
  ],
