  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for DDOD syndrome",
    "criteria": [
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss presenting in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "onychodystrophy",
        "description": "Congenital or early-onset dystrophic changes of the fingernails and toenails",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-systemic-features",
        "description": "Lack of additional systemic abnormalities differentiating from syndromic deafness",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral sensorineural hearing loss and onychodystrophy with a compatible autosomal dominant family history",
    "notes": "Genetic testing for mutations in the ATP6V1B2 gene can confirm diagnosis."
  },
