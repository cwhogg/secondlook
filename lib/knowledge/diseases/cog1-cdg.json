  "keyFindings": {
    "laboratory": [
      "Abnormal serum transferrin glycosylation pattern (type 2 pattern)",
      "Coagulation abnormalities including decreased antithrombin III and protein C",
      "Elevated liver transaminases"
    ],
    "imaging": [
      "Brain MRI may show cerebral and cerebellar atrophy or hypoplasia",
      "Echocardiography may reveal cardiomyopathy"
    ],
    "genetic": [
      "COG1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Abnormal glycosylation of multiple serum glycoproteins",
      "Reduced activity of the conserved oligomeric Golgi complex"
    ]
  },
