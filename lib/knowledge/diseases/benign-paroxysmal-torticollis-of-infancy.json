        "requiredForDiagnosis": true
      },
      {
        "id": "onset-in-infancy",
        "description": "Onset of symptoms within the first year of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-neurological-deficits",
        "description": "Normal neurological examination between episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "associated-autonomic-symptoms",
        "description": "Presence of associated autonomic symptoms such as vomiting or pallor during episodes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of similar paroxysmal events or migraine",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent torticollis episodes with onset in infancy and normal neurological status between episodes",
