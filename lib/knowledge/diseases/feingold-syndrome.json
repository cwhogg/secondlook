  "diagnosticCriteria": {
    "formalCriteriaName": "Feingold Syndrome Clinical Diagnostic Criteria",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Presence of microcephaly (head circumference below the 3rd percentile)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digital-anomalies",
        "description": "Syndactyly or clinodactyly of the 2nd and 3rd toes or fingers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "esophageal-atresia",
        "description": "Esophageal or duodenal atresia or stenosis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "short-stature",
        "description": "Postnatal short stature below the 5th percentile",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "learning-difficulties",
        "description": "Mild to moderate intellectual disability or learning difficulties",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microcephaly and digital anomalies (syndactyly or clinodactyly) with or without esophageal atresia or stenosis",
    "notes": "Genetic testing for MYCN mutations can confirm diagnosis"
  },
