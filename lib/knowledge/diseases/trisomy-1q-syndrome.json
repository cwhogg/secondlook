  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Trisomy 1q Syndrome",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Presence of partial or complete duplication of the long arm of chromosome 1 confirmed by karyotype or chromosomal microarray",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic craniofacial dysmorphisms including microcephaly, prominent forehead, hypertelorism, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or skeletal abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of 1q duplication plus presence of at least two major clinical features",
    "notes": "Diagnosis relies heavily on genetic testing combined with clinical presentation."
  },
