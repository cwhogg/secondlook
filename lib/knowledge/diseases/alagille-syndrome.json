  "prevalence": {
    "estimate": "1 in 30,000 to 1 in 50,000",
    "range": "0.002% - 0.003%",
    "classification": "rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 18,
      "peak": 1
    },
    "sexPredilection": "equal",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Alagille Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "bile-duct-paucity",
        "description": "Bile duct paucity on liver biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-defects",
        "description": "Congenital heart defects, especially peripheral pulmonary artery stenosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-features",
        "description": "Characteristic facial features including broad forehead, deep-set eyes, pointed chin",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal abnormalities such as butterfly vertebrae",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-anomalies",
        "description": "Ocular anomalies including posterior embryotoxon",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in JAG1 or NOTCH2 genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bile duct paucity plus at least three other major clinical features or identification of pathogenic JAG1/NOTCH2 mutation with compatible clinical features",
    "notes": "Diagnosis is clinical but supported by genetic testing; liver biopsy is often performed to confirm bile duct paucity."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Bile duct paucity",
        "frequency": 0.85,
        "bodySystem": "gastrointestinal",
        "notes": "Confirmed by liver biopsy"
      },
      {
        "symptomName": "Peripheral pulmonary artery stenosis",
        "frequency": 0.75,
        "bodySystem": "cardiovascular",
        "notes": "Most common cardiac defect"
      },
      {
        "symptomName": "Characteristic facial dysmorphism",
        "frequency": 0.7,
        "bodySystem": "constitutional",
        "notes": "Includes broad forehead, deep-set eyes, pointed chin"
      }
    ],
    "common": [
      {
        "symptomName": "Cholestasis",
        "frequency": 0.65,
        "bodySystem": "gastrointestinal",
        "notes": "Due to bile duct paucity"
      },
      {
        "symptomName": "Butterfly vertebrae",
        "frequency": 0.6,
        "bodySystem": "musculoskeletal",
        "notes": "Vertebral anomalies seen on imaging"
      },
      {
        "symptomName": "Posterior embryotoxon",
        "frequency": 0.55,
        "bodySystem": "ophthalmological",
        "notes": "Anterior segment eye anomaly"
      },
      {
        "symptomName": "Growth retardation",
        "frequency": 0.58,
        "bodySystem": "constitutional",
        "notes": "Failure to thrive common in infancy"
      },
      {
        "symptomName": "Pruritus",
        "frequency": 0.5,
        "bodySystem": "dermatological",
        "notes": "Due to cholestasis"
      }
    ],
    "occasional": [
      {
        "symptomName": "Renal anomalies",
        "frequency": 0.3,
        "bodySystem": "renal",
        "notes": "Including renal dysplasia or cystic changes"
      },
      {
        "symptomName": "Pancreatic insufficiency",
        "frequency": 0.25,
        "bodySystem": "gastrointestinal",
        "notes": "Exocrine pancreatic dysfunction"
      },
      {
        "symptomName": "Hepatomegaly",
        "frequency": 0.4,
        "bodySystem": "gastrointestinal",
        "notes": "Enlarged liver due to cholestasis"
      },
      {
        "symptomName": "Hypercholesterolemia",
        "frequency": 0.15,
        "bodySystem": "endocrine",
        "notes": "Secondary to cholestasis"
      },
      {
        "symptomName": "Neurodevelopmental delay",
        "frequency": 0.2,
        "bodySystem": "neurological",
        "notes": "Mild cognitive impairment reported in some cases"
      }
    ],
    "rare": [
      {
        "symptomName": "Intracranial bleeding",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Due to vascular anomalies"
      },
      {
        "symptomName": "Pancreatitis",
        "frequency": 0.03,
        "bodySystem": "gastrointestinal",
        "notes": "Rare complication"
      },
      {
        "symptomName": "Pulmonary hypertension",
        "frequency": 0.07,
        "bodySystem": "cardiovascular",
        "notes": "Secondary to pulmonary artery stenosis"
      }
    ]
  },
