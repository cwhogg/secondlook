  "keyFindings": {
    "laboratory": [
      "Elevated methemoglobin levels (>10%) on co-oximetry",
      "Reduced cytochrome b5 reductase enzyme activity in erythrocytes",
      "Normal arterial oxygen tension (PaO2) despite cyanosis"
    ],
    "imaging": [
      "Brain MRI may show cerebral atrophy or delayed myelination in Type II"
    ],
    "genetic": [
      "CYB5R3 (causative)",
      "CYB5A (candidate)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Unresponsiveness of cyanosis to supplemental oxygen therapy"
    ]
  },
