  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Tumor-Induced Osteomalacia",
    "criteria": [
      {
        "id": "hypophosphatemia",
        "description": "Persistent hypophosphatemia due to renal phosphate wasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-fgf23",
        "description": "Elevated or inappropriately normal serum fibroblast growth factor 23 (FGF23) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tumor-identification",
        "description": "Identification of a phosphaturic mesenchymal tumor by imaging or histopathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-mineralization-defects",
        "description": "Evidence of osteomalacia or bone demineralization on imaging or biopsy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-symptoms",
        "description": "Presence of bone pain, muscle weakness, or fractures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent hypophosphatemia with elevated FGF23 and identification of a causative tumor",
    "notes": "Diagnosis may be supported by improvement of biochemical abnormalities after tumor resection"
  },
