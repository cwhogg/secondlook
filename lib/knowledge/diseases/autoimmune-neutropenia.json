  "diagnosticCriteria": {
    "formalCriteriaName": "Autoimmune Neutropenia Diagnostic Criteria",
    "criteria": [
      {
        "id": "neutropenia",
        "description": "Absolute neutrophil count (ANC) below 1500 cells/µL on at least two occasions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anti-neutrophil-antibodies",
        "description": "Presence of anti-neutrophil antibodies detected by immunoassays",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-secondary-causes",
        "description": "Exclusion of other causes of neutropenia such as drug-induced, congenital, or infectious etiologies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-infections",
        "description": "History of recurrent bacterial infections consistent with neutropenia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "bone-marrow-examination",
        "description": "Bone marrow showing normal or increased myeloid precursors without maturation arrest",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent neutropenia with positive anti-neutrophil antibodies and exclusion of secondary causes",
    "notes": "Diagnosis is often clinical supported by laboratory confirmation; bone marrow biopsy is not always required."
  },
  "symptoms": {
