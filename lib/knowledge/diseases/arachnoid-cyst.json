  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "MRI showing well-circumscribed, CSF-intensity cyst within arachnoid space",
      "CT scan demonstrating hypodense cystic lesion without enhancement",
      "Absence of diffusion restriction differentiating from epidermoid cyst"
    ],
    "genetic": [
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Surgical findings of cyst containing clear cerebrospinal fluid",
      "Histopathology confirming arachnoid membrane lining"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "epidermoid-cyst",
      "distinguishingFeatures": [
        "Diffusion restriction on MRI",
        "Irregular cyst margins",
        "Presence of keratin debris"
      ]
    },
    {
      "diseaseId": "colloid-cyst",
      "distinguishingFeatures": [
        "Located typically in the third ventricle",
        "Hyperdense on CT",
        "May cause acute hydrocephalus"
      ]
    },
    {
      "diseaseId": "arachnoiditis",
      "distinguishingFeatures": [
        "Inflammatory symptoms",
        "Diffuse meningeal enhancement on imaging",
        "History of infection or trauma"
      ]
    }
  ],
  "redFlags": [
    "Rapid neurological deterioration",
    "Signs of increased intracranial pressure (papilledema, severe headache, vomiting)",
    "New onset seizures or focal deficits"
  ],
