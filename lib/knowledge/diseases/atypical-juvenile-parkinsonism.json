  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests excluding secondary causes",
      "CSF analysis typically unremarkable"
    ],
    "imaging": [
      "MRI brain may show nigrostriatal degeneration",
      "DAT-SPECT imaging demonstrating reduced dopamine transporter uptake"
    ],
    "genetic": [
      "PODXL (causative)",
      "DNAJC6 (causative)",
      "SYNJ1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Poor or atypical response to levodopa therapy",
      "Presence of atypical neurological signs such as dystonia or pyramidal signs"
    ]
  },
  "differentialDiagnoses": [
