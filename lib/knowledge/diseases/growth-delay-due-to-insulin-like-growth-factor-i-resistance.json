        "description": "Normal or elevated serum IGF-I levels despite growth failure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the IGF1R gene or evidence of IGF-I receptor resistance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of growth delay such as growth hormone deficiency or malnutrition",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe growth delay with normal/elevated IGF-I levels and confirmation of IGF1R mutation or receptor resistance",
