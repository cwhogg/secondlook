{
  "id": "granulomatosis-with-polyangiitis",
  "name": "Granulomatosis with Polyangiitis",
  "aliases": ["GPA", "Wegener's Granulomatosis", "Wegener Granulomatosis"],
  "icd10Codes": ["M31.30", "M31.31"],
  "omimId": "608710",
  "orphanetId": "900",
  "prevalence": {
    "estimate": "3-15 per 100,000",
    "range": "3-15 per 100,000",
    "classification": "rare"
  },
  "demographics": {
    "typicalOnsetAge": { "min": 40, "max": 65, "peak": 55 },
    "sexPredilection": "slight-male",
    "ethnicAssociations": ["Northern European descent", "Caucasian"]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "2022 ACR/EULAR Classification Criteria for GPA",
    "criteria": [
      { "id": "gpa-1", "description": "Nasal involvement: bloody discharge, crusting, nasal ulceration, or septal perforation/saddle nose deformity", "category": "major", "requiredForDiagnosis": false },
      { "id": "gpa-2", "description": "Cartilaginous involvement: nasal septal perforation/saddle nose, hearing loss (conductive or sensorineural), or laryngeal/tracheal stenosis", "category": "major", "requiredForDiagnosis": false },
      { "id": "gpa-3", "description": "PR3-ANCA (c-ANCA) positivity", "category": "major", "requiredForDiagnosis": false },
      { "id": "gpa-4", "description": "Pulmonary nodules, masses, or cavities on imaging", "category": "major", "requiredForDiagnosis": false },
      { "id": "gpa-5", "description": "Granulomatous inflammation on biopsy (extravascular)", "category": "major", "requiredForDiagnosis": false },
      { "id": "gpa-6", "description": "Pauci-immune glomerulonephritis (crescentic or necrotizing)", "category": "major", "requiredForDiagnosis": false },
      { "id": "gpa-7", "description": "Positive c-ANCA or PR3-ANCA by immunoassay", "category": "major", "requiredForDiagnosis": false },
      { "id": "gpa-8", "description": "Retro-orbital mass or inflammation", "category": "minor", "requiredForDiagnosis": false }
    ],
    "minimumForDiagnosis": "Diagnosis of small- or medium-vessel vasculitis plus total weighted score >= 5 on the classification criteria",
    "notes": "Must first establish a diagnosis of vasculitis. The 2022 criteria use a weighted scoring system. Biopsy showing necrotizing granulomatous inflammation is highly supportive."
  },
  "symptoms": {
    "pathognomonic": [
      { "symptomName": "Saddle nose deformity", "snomedCode": "249308005", "frequency": 0.15, "bodySystem": "ENT", "notes": "Due to nasal cartilage destruction from granulomatous inflammation" },
      { "symptomName": "Cavitating pulmonary nodules", "snomedCode": "713178000", "frequency": 0.35, "bodySystem": "Pulmonary", "notes": "Multiple bilateral nodules that may cavitate" },
      { "symptomName": "Necrotizing granulomatous vasculitis on biopsy", "frequency": 0.60, "bodySystem": "Histopathologic" }
    ],
    "common": [
      { "symptomName": "Chronic sinusitis with bloody nasal discharge", "snomedCode": "40055000", "frequency": 0.70, "bodySystem": "ENT" },
      { "symptomName": "Pulmonary infiltrates or nodules", "snomedCode": "713178000", "frequency": 0.60, "bodySystem": "Pulmonary" },
      { "symptomName": "Glomerulonephritis (rapidly progressive)", "snomedCode": "36171008", "frequency": 0.50, "bodySystem": "Renal" },
      { "symptomName": "Constitutional symptoms (fever, weight loss, fatigue)", "snomedCode": "386661006", "frequency": 0.70, "bodySystem": "Constitutional" },
      { "symptomName": "Arthralgia or arthritis", "snomedCode": "57676002", "frequency": 0.50, "bodySystem": "Musculoskeletal" }
    ],
    "occasional": [
      { "symptomName": "Subglottic stenosis", "snomedCode": "419977006", "frequency": 0.15, "bodySystem": "ENT", "notes": "Stridor, dyspnea; more common in younger patients" },
      { "symptomName": "Orbital pseudotumor/proptosis", "snomedCode": "18146001", "frequency": 0.15, "bodySystem": "Ocular" },
      { "symptomName": "Scleritis or episcleritis", "snomedCode": "78370002", "frequency": 0.15, "bodySystem": "Ocular" },
      { "symptomName": "Mononeuritis multiplex", "snomedCode": "128189008", "frequency": 0.15, "bodySystem": "Neurological" },
      { "symptomName": "Otitis media (serous or hemorrhagic)", "snomedCode": "65363002", "frequency": 0.25, "bodySystem": "ENT" }
    ],
    "rare": [
      { "symptomName": "Diffuse alveolar hemorrhage", "snomedCode": "233608003", "frequency": 0.08, "bodySystem": "Pulmonary", "notes": "Life-threatening; pulmonary-renal syndrome" },
      { "symptomName": "Pachymeningitis", "snomedCode": "45170000", "frequency": 0.05, "bodySystem": "Neurological" },
      { "symptomName": "Pericarditis", "snomedCode": "3238004", "frequency": 0.05, "bodySystem": "Cardiovascular" },
      { "symptomName": "Skin ulceration or palpable purpura", "snomedCode": "20143000", "frequency": 0.10, "bodySystem": "Dermatologic" }
    ]
  },
  "systemsAffected": ["ENT/Upper Respiratory", "Pulmonary", "Renal", "Ocular", "Musculoskeletal", "Neurological", "Dermatologic", "Cardiovascular"],
  "keyFindings": {
    "laboratory": [
      "PR3-ANCA (c-ANCA) positive (80-90% in generalized disease)",
      "Elevated ESR and CRP",
      "Elevated serum creatinine with active sediment (RBC casts, dysmorphic RBCs)",
      "Anemia of chronic disease",
      "Leukocytosis and thrombocytosis",
      "Proteinuria and hematuria"
    ],
    "imaging": [
      "Chest CT: pulmonary nodules (often cavitating), ground-glass opacities, consolidation",
      "Sinus CT: mucosal thickening, bony erosion, septal perforation",
      "MRI orbits: retro-orbital mass",
      "MRI brain: pachymeningeal enhancement"
    ],
    "genetic": [
      "HLA-DPB1*0401 association",
      "SERPINA1 (alpha-1 antitrypsin) gene variants associated with ANCA vasculitis"
    ],
    "other": [
      "Renal biopsy: pauci-immune crescentic and necrotizing glomerulonephritis",
      "Lung biopsy: necrotizing granulomatous inflammation with vasculitis",
      "Nasal biopsy: granulomatous inflammation (may be non-specific)"
    ]
  },
  "differentialDiagnoses": [
    { "diseaseId": "microscopic-polyangiitis", "distinguishingFeatures": ["No granulomatous inflammation", "MPO-ANCA (p-ANCA) predominant", "No ENT involvement"] },
    { "diseaseId": "eosinophilic-granulomatosis-with-polyangiitis", "distinguishingFeatures": ["Asthma and eosinophilia", "Eosinophilic infiltration on biopsy", "MPO-ANCA when positive"] },
    { "diseaseId": "anti-gbm-disease", "distinguishingFeatures": ["Anti-GBM antibodies", "Linear IgG on immunofluorescence", "No granulomas"] },
    { "diseaseId": "sarcoidosis", "distinguishingFeatures": ["Non-necrotizing granulomas", "Bilateral hilar lymphadenopathy", "Elevated ACE", "ANCA negative"] },
    { "diseaseId": "lymphomatoid-granulomatosis", "distinguishingFeatures": ["EBV-positive B cells", "Angiocentric and angiodestructive", "ANCA negative"] }
  ],
  "redFlags": [
    "Rapidly progressive glomerulonephritis with rising creatinine",
    "Hemoptysis suggesting diffuse alveolar hemorrhage",
    "New stridor indicating subglottic stenosis",
    "Acute vision loss from orbital involvement",
    "Pulmonary-renal syndrome (concurrent lung hemorrhage and renal failure)"
  ],
