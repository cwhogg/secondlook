  "diagnosticCriteria": {
    "formalCriteriaName": "CAP Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of one or more cranial sutures confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anal-anomalies",
        "description": "Presence of anal malformations such as imperforate anus or anal stenosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "porokeratosis",
        "description": "Cutaneous porokeratosis lesions confirmed by histopathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism and midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: craniosynostosis, anal anomalies, and porokeratosis",
    "notes": "Diagnosis is clinical and supported by imaging and histopathology; genetic testing may assist but is not definitive."
  },
