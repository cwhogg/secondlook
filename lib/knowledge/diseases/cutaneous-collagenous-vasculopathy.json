  "diagnosticCriteria": {
    "formalCriteriaName": "No formal diagnostic criteria established",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of asymptomatic, persistent telangiectatic macules and patches primarily on the lower extremities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing thickened collagen bundles surrounding dilated superficial dermal blood vessels without evidence of vasculitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-vasculopathies",
        "description": "Exclusion of other causes of cutaneous telangiectasia and vasculopathy such as hereditary hemorrhagic telangiectasia and livedoid vasculopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence",
        "description": "Negative direct immunofluorescence studies ruling out immune complex-mediated vasculitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical lesions with confirmatory histopathology and exclusion of other vasculopathies",
    "notes": "Diagnosis is primarily clinical and histopathological; no genetic markers identified to date."
  },
