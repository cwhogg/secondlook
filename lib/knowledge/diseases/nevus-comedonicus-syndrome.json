  "diagnosticCriteria": {
    "formalCriteriaName": "Nevus Comedonicus Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cutaneous-lesions",
        "description": "Presence of nevus comedonicus characterized by grouped dilated follicular openings filled with keratin plugs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-anomalies",
        "description": "Associated skeletal abnormalities such as scoliosis, vertebral defects, or limb asymmetry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-features",
        "description": "Neurological manifestations including seizures, intellectual disability, or developmental delay",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-anomalies",
        "description": "Ophthalmological abnormalities such as cataracts or strabismus",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of nevus comedonicus with at least one major extracutaneous anomaly (skeletal or neurological)",
    "notes": "Diagnosis is clinical; genetic testing may be supportive but is not definitive."
  },
