  "diagnosticCriteria": {
    "formalCriteriaName": "Alazami Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Severe intellectual disability with global developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Postnatal short stature below the 3rd percentile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent forehead, deep-set eyes, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic variants in LARP7 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Presence of skeletal anomalies such as clinodactyly or brachydactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-features",
        "description": "Behavioral abnormalities including autistic features or hyperactivity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe intellectual disability, characteristic facial dysmorphism, short stature, and confirmation of pathogenic LARP7 mutation",
    "notes": "Diagnosis is primarily clinical supported by genetic testing; absence of genetic confirmation requires careful differential diagnosis."
