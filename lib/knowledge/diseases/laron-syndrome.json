  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for Laron Syndrome",
    "criteria": [
      {
        "id": "gh-insensitivity",
        "description": "Severe growth hormone insensitivity demonstrated by elevated serum GH levels with low serum IGF-1",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the growth hormone receptor (GHR) gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Characteristic clinical features including severe postnatal growth failure, distinctive facial features, and obesity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-serum-igfbp3",
        "description": "Low serum insulin-like growth factor binding protein 3 (IGFBP-3) levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-gh-binding",
        "description": "Reduced or absent GH receptor binding activity in vitro",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe growth hormone insensitivity with low IGF-1 levels plus either genetic confirmation of GHR mutations or characteristic clinical features",
    "notes": "Diagnosis requires exclusion of other causes of growth failure and GH deficiency."
  },
