  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Hypohidrotic Ectodermal Dysplasia",
    "criteria": [
      {
        "id": "hypohidrosis",
        "description": "Reduced or absent sweat gland function leading to hypohidrosis or anhidrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypodontia",
        "description": "Congenital absence of multiple teeth or abnormal tooth morphology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotrichosis",
        "description": "Sparse, thin, or absent scalp and body hair",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consanguinity or affected siblings consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in EDA, EDAR, or EDARADD genes",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (hypohidrosis, hypodontia, hypotrichosis) or identification of biallelic pathogenic variants in relevant genes",
    "notes": "Genetic testing is confirmatory but clinical diagnosis can be made based on characteristic triad and family history."
  },
