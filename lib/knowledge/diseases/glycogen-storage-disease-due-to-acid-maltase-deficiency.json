  "keyFindings": {
    "laboratory": [
      "Reduced acid alpha-glucosidase enzyme activity in blood or tissue samples",
      "Elevated serum creatine kinase levels",
      "Elevated urinary glucose tetrasaccharide (Glc4) levels"
    ],
    "imaging": [
      "Echocardiogram showing hypertrophic cardiomyopathy (infantile-onset)",
      "Muscle MRI showing fatty infiltration and muscle atrophy",
      "Chest X-ray or CT showing diaphragmatic elevation or atelectasis"
    ],
    "genetic": [
      "Pathogenic variants in the GAA gene confirmed by molecular genetic testing",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy demonstrating glycogen accumulation with vacuolar myopathy",
      "Electromyography showing myopathic changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "other-glycogen-storage-diseases",
      "distinguishingFeatures": [
        "Different enzyme deficiencies (e.g., GSD type I, III)",
        "Lack of acid alpha-glucosidase deficiency",
        "Distinct clinical presentations such as hepatomegaly without cardiomyopathy"
      ]
    },
    {
      "diseaseId": "limb-girdle-muscular-dystrophy",
      "distinguishingFeatures": [
        "Absence of glycogen accumulation on muscle biopsy",
        "Normal acid alpha-glucosidase enzyme activity",
        "Later onset and slower progression"
      ]
    },
    {
      "diseaseId": "mitochondrial-myopathies",
      "distinguishingFeatures": [
        "Presence of mitochondrial DNA mutations",
        "Ragged red fibers on muscle biopsy",
        "Multisystem involvement including neurological symptoms"
      ]
    }
  ],
  "redFlags": [
