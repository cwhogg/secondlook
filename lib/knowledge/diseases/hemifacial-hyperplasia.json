  "differentialDiagnoses": [
    {
      "diseaseId": "fibrous-dysplasia",
      "distinguishingFeatures": [
        "Fibrous replacement of bone rather than uniform hypertrophy",
        "Radiologic ground-glass appearance",
        "Usually involves multiple bones, not strictly unilateral facial involvement"
      ]
    },
    {
      "diseaseId": "proteus-syndrome",
      "distinguishingFeatures": [
        "Asymmetric overgrowth involving multiple tissues and limbs",
        "Presence of cerebriform connective tissue nevi",
        "Progressive and mosaic distribution"
      ]
    },
    {
      "diseaseId": "vascular-malformation-syndromes",
      "distinguishingFeatures": [
        "Presence of vascular lesions such as hemangiomas or lymphangiomas",
        "Often associated with skin discoloration",
        "Different tissue involvement pattern"
      ]
    }
  ],
