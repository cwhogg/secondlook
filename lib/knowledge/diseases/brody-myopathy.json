  "diagnosticCriteria": {
    "formalCriteriaName": "Brody Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "impaired-muscle-relaxation",
        "description": "Impaired muscle relaxation during or immediately after exercise",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyography showing silent contractures without myotonic discharges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "atp2a1-mutation",
        "description": "Identification of pathogenic mutations in the ATP2A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-myotonia",
        "description": "Absence of clinical or electrical myotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy-findings",
        "description": "Muscle biopsy showing selective type II fiber atrophy and reduced SERCA1 expression",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of impaired muscle relaxation during exercise, characteristic electromyography findings, and identification of ATP2A1 mutation",
    "notes": "Diagnosis is supported by clinical presentation and exclusion of other myopathies with myotonia."
  },
