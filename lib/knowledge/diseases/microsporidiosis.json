  "keyFindings": {
    "laboratory": [
      "Microscopic identification of microsporidial spores using modified trichrome or calcofluor white staining",
      "Positive PCR for microsporidial DNA in stool, urine, or tissue samples",
      "Elevated inflammatory markers in disseminated disease"
    ],
    "imaging": [
      "CT or MRI may show hepatosplenomegaly or CNS lesions in disseminated infection",
      "Chest imaging may reveal interstitial infiltrates in pulmonary involvement"
    ],
    "genetic": [
      "No known human genetic mutations associated with susceptibility"
    ],
    "other": [
      "Electron microscopy can confirm microsporidial spore ultrastructure",
      "Histopathology showing intracellular spores within affected tissues"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cryptosporidiosis",
      "distinguishingFeatures": [
        "Cryptosporidium oocysts detected by acid-fast staining",
        "More common in pediatric populations",
        "Usually self-limited in immunocompetent hosts"
      ]
    },
    {
      "diseaseId": "cytomegalovirus-infection",
      "distinguishingFeatures": [
        "CMV inclusion bodies on histology",
        "Systemic symptoms with retinitis and colitis",
        "Serologic and PCR testing positive for CMV"
      ]
    }
  ],
  "redFlags": [
    "Persistent chronic diarrhea in immunocompromised patients",
    "Rapid weight loss and malnutrition",
    "Signs of disseminated infection such as multi-organ dysfunction"
  ],
