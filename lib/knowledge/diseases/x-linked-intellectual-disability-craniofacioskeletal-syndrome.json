        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial anomalies including prominent forehead, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal anomalies such as joint contractures, scoliosis, and short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "X-linked inheritance pattern with affected males and carrier females",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the causative gene (e.g., ZC4H2)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of intellectual disability, characteristic craniofacial dysmorphism, and skeletal abnormalities with supportive family history or genetic confirmation",
    "notes": "Diagnosis is primarily clinical supported by genetic testing when available."
