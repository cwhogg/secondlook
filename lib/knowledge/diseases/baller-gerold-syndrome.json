  "keyFindings": {
    "laboratory": [
      "Possible anemia or thrombocytopenia on CBC",
      "Elevated liver enzymes in some cases"
    ],
    "imaging": [
      "X-rays showing craniosynostosis and radial aplasia/hypoplasia",
      "Skeletal survey demonstrating delayed bone age",
      "Echocardiogram for cardiac malformations"
    ],
    "genetic": [
      "Pathogenic variants in RECQL4 gene confirmed by molecular genetic testing"
    ],
    "other": [
      "Clinical examination revealing characteristic craniofacial and limb abnormalities"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "rothmund-thomson-syndrome",
      "distinguishingFeatures": [
        "Poikiloderma and skin rash",
        "Higher risk of osteosarcoma",
        "Absent or less frequent craniosynostosis"
      ]
    },
    {
      "diseaseId": "rapadilino-syndrome",
      "distinguishingFeatures": [
        "Radial ray defects with patellar hypoplasia",
        "Distinct facial features without craniosynostosis",
        "RECQL4 mutations but different clinical presentation"
      ]
    }
  ],
