  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-dyserythropoietic-anemia-type-i",
      "distinguishingFeatures": [
        "Presence of chromatin bridges in erythroblasts",
        "Different genetic mutations (CDAN1 or C15orf41)",
        "Distinct bone marrow morphology"
      ]
    },
    {
      "diseaseId": "congenital-dyserythropoietic-anemia-type-ii",
      "distinguishingFeatures": [
        "Presence of binucleated erythroblasts",
        "Mutations in SEC23B gene",
        "Positive acidified serum test (Ham test)"
      ]
    }
  ],
  "redFlags": [
    "Severe anemia unresponsive to standard therapy",
    "Progressive splenomegaly with cytopenias",
    "Evidence of iron overload despite no transfusions"
  ],
