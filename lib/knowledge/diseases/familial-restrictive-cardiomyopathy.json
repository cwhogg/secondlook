  "diagnosticCriteria": {
    "formalCriteriaName": "Restrictive Cardiomyopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "diastolic-dysfunction",
        "description": "Evidence of severe diastolic dysfunction with restrictive filling pattern on echocardiography or cardiac catheterization",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of restrictive cardiomyopathy or sudden cardiac death",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-cardiac-disease",
        "description": "Exclusion of other causes of restrictive physiology such as amyloidosis, sarcoidosis, or radiation-induced heart disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic mutation in sarcomeric or cytoskeletal genes associated with familial restrictive cardiomyopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "biatrial-enlargement",
        "description": "Biatrial enlargement on imaging studies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of diastolic dysfunction with restrictive filling pattern plus either positive family history or exclusion of other causes",
    "notes": "Genetic testing can support diagnosis but is not mandatory"
  },
