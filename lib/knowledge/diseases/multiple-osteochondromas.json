  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Radiographs showing multiple sessile or pedunculated exostoses at metaphyses of long bones",
      "MRI demonstrating cartilage cap thickness and soft tissue involvement",
      "CT scans for complex anatomical areas or surgical planning"
    ],
    "genetic": [
      "EXT1 (causative)",
      "EXT2 (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology of excised lesions showing cartilage cap with underlying bone",
      "Family pedigree analysis consistent with autosomal dominant inheritance"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "metachondromatosis",
      "distinguishingFeatures": [
        "Presence of both osteochondromas and enchondromas",
        "Spontaneous regression of lesions",
        "Different genetic etiology (PTPN11 mutations)"
      ]
    },
    {
      "diseaseId": "osteochondromatosis",
      "distinguishingFeatures": [
        "Usually solitary osteochondroma rather than multiple",
        "Lack of family history",
        "No autosomal dominant inheritance pattern"
      ]
    }
  ],
  "redFlags": [
    "Rapid increase in size of osteochondroma after skeletal maturity",
    "New onset of severe localized pain",
    "Neurological deficits suggestive of nerve or spinal cord compression"
  ],
