  "diagnosticCriteria": {
    "formalCriteriaName": "ACY1 Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced or absent aminoacylase 1 enzyme activity in fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the ACY1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-metabolites",
        "description": "Elevated N-acetylated amino acids in urine organic acid analysis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic ACY1 variants or reduced enzyme activity plus supportive biochemical findings",
    "notes": "Diagnosis is confirmed by molecular genetic testing and enzyme assay; biochemical findings support but are not definitive alone."
  },
