  "diagnosticCriteria": {
    "formalCriteriaName": "Alpha-mannosidosis diagnostic criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficient alpha-mannosidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic MAN2B1 gene mutations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features including developmental delay and coarse facial features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-oligosaccharides",
        "description": "Elevated urinary excretion of mannose-rich oligosaccharides",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient alpha-mannosidase enzyme activity plus either pathogenic MAN2B1 mutations or characteristic clinical features",
    "notes": "Diagnosis is confirmed by enzyme assay and genetic testing; clinical features support diagnosis."
  },
