  "diagnosticCriteria": {
    "formalCriteriaName": "Echocardiographic and Clinical Diagnostic Criteria for Sinus Venosus ASD",
    "criteria": [
      {
        "id": "echocardiographic-defect",
        "description": "Identification of a defect in the superior or inferior vena cava region of the atrial septum on echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "right-heart-volume-overload",
        "description": "Evidence of right atrial and right ventricular enlargement consistent with left-to-right shunting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-hypertension",
        "description": "Presence of pulmonary arterial hypertension secondary to chronic left-to-right shunting",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-murmur",
        "description": "Systolic ejection murmur heard at the upper left sternal border",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Echocardiographic identification of sinus venosus atrial septal defect with evidence of right heart volume overload",
    "notes": "Cardiac MRI or CT may be used to further delineate anatomy and associated anomalous pulmonary venous return."
  },
