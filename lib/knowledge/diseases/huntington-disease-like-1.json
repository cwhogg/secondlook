  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Huntington Disease-Like 1",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive chorea and cognitive decline resembling Huntington disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Absence of HTT gene CAG expansion with presence of PRNP gene mutation (octapeptide repeat insertion)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive chorea and cognitive decline with negative HTT gene testing plus identification of PRNP gene mutation",
    "notes": "Genetic confirmation is essential to differentiate from Huntington disease and other phenocopies."
  },
