  "keyFindings": {
    "laboratory": [
      "Serum uric acid <2.0 mg/dL",
      "Elevated fractional excretion of uric acid (>10%)",
      "Transient elevation of serum creatinine during acute kidney injury"
    ],
    "imaging": [
      "Renal ultrasound may show nephrolithiasis",
      "No specific imaging abnormalities outside acute injury episodes"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "History of exercise-induced acute kidney injury",
      "Family history of hypouricemia or renal injury"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "gout",
      "distinguishingFeatures": [
        "Hyperuricemia rather than hypouricemia",
        "Presence of urate crystal arthritis",
        "No increased renal uric acid excretion"
      ]
    },
    {
      "diseaseId": "xanthinuria",
      "distinguishingFeatures": [
        "Low serum uric acid due to xanthine oxidase deficiency",
        "Presence of xanthine stones rather than uric acid stones",
        "Normal or low fractional excretion of uric acid"
      ]
    },
    {
      "diseaseId": "fanconi-syndrome",
      "distinguishingFeatures": [
        "Generalized proximal tubular dysfunction",
        "Multiple electrolyte abnormalities",
        "Glycosuria and aminoaciduria present"
      ]
    }
  ],
