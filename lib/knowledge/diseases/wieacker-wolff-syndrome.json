    "laboratory": [
      "Normal routine blood tests",
      "Elevated creatine kinase in some cases"
    ],
    "imaging": [
      "Muscle MRI showing atrophy and fatty infiltration",
      "Brain MRI may show nonspecific findings"
    ],
    "genetic": [
      "ZC4H2 (causative)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Electromyography showing motor neuronopathy",
      "Nerve conduction studies indicating axonal neuropathy"
    ]
  },
  "differentialDiagnoses": [
