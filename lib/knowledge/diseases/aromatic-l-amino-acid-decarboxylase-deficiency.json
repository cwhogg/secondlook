  "keyFindings": {
    "laboratory": [
      "Reduced AADC enzyme activity in plasma or CSF",
      "CSF neurotransmitter profile: low homovanillic acid (HVA) and 5-hydroxyindoleacetic acid (5-HIAA), elevated L-DOPA and 5-hydroxytryptophan"
    ],
    "imaging": [
      "Brain MRI typically normal or may show nonspecific mild cerebral atrophy"
    ],
    "genetic": [
      "DDC (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Abnormal autonomic function tests",
      "Response to dopamine agonists may be limited"
    ]
  },
  "differentialDiagnoses": [
