  "diagnosticCriteria": {
    "formalCriteriaName": "Cole-Carpenter Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of cranial sutures (craniosynostosis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "osteogenesis-imperfecta-features",
        "description": "Clinical and radiological features of osteogenesis imperfecta including bone fragility and multiple fractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-dysmorphism",
        "description": "Characteristic facial features including proptosis, midface hypoplasia, and depressed nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Severe postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "wormian-bones",
        "description": "Presence of wormian bones on skull radiographs",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis, osteogenesis imperfecta features, and distinctive facial dysmorphism",
    "notes": "Genetic testing may support diagnosis but is not always definitive due to heterogeneity"
  },
