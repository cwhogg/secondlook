  "diagnosticCriteria": {
    "formalCriteriaName": "PLAA-associated Neurodevelopmental Disorder Diagnostic Criteria",
    "criteria": [
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability presenting in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "Early-onset refractory epilepsy or infantile spasms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the PLAA gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Generalized hypotonia observed in infancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "movement-disorder",
        "description": "Presence of dystonia or choreoathetosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of global developmental delay, early-onset seizures, and confirmed biallelic pathogenic variants in PLAA gene",
    "notes": "Diagnosis requires exclusion of other neurodevelopmental disorders and confirmation by genetic testing."
  },
