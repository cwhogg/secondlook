  "diagnosticCriteria": {
    "formalCriteriaName": "Gaucher Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficient activity of glucocerebrosidase enzyme in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the GBA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-features",
        "description": "Presence of chronic neurological symptoms such as oculomotor apraxia or myoclonus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-biopsy",
        "description": "Bone marrow biopsy showing Gaucher cells (lipid-laden macrophages)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient glucocerebrosidase enzyme activity plus biallelic GBA pathogenic variants with neurological involvement",
    "notes": "Neurological symptoms distinguish type 3 from type 1 Gaucher disease."
  },
