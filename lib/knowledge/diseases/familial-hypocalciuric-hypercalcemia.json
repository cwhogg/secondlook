  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Hypocalciuric Hypercalcemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "persistent-mild-hypercalcemia",
        "description": "Lifelong mild hypercalcemia typically with serum calcium levels mildly elevated above normal",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-urinary-calcium-excretion",
        "description": "Hypocalciuria demonstrated by low 24-hour urinary calcium excretion or calcium-to-creatinine clearance ratio <0.01",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of hypercalcemia consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-or-mildly-elevated-pth",
        "description": "Normal or mildly elevated parathyroid hormone (PTH) levels despite hypercalcemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-symptoms",
        "description": "Typically asymptomatic or minimal symptoms without complications of hypercalcemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent mild hypercalcemia with low urinary calcium excretion and positive family history",
    "notes": "Genetic testing for CaSR mutations can confirm diagnosis but is not always required."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Persistent mild hypercalcemia",
        "frequency": 0.95,
        "bodySystem": "endocrine",
        "notes": "Lifelong and stable elevated serum calcium levels"
      },
      {
        "symptomName": "Hypocalciuria (low urinary calcium excretion)",
        "frequency": 0.9,
        "bodySystem": "renal",
        "notes": "Characteristic low calcium clearance despite hypercalcemia"
      }
    ],
    "common": [
      {
        "symptomName": "Normal or mildly elevated parathyroid hormone levels",
        "frequency": 0.75,
        "bodySystem": "endocrine",
        "notes": "PTH levels inappropriately normal or slightly raised"
      },
      {
        "symptomName": "Asymptomatic presentation",
        "frequency": 0.7,
        "bodySystem": "constitutional",
        "notes": "Most patients do not experience symptoms"
      },
      {
        "symptomName": "Mild fatigue",
        "frequency": 0.6,
        "bodySystem": "constitutional",
        "notes": "Non-specific symptom occasionally reported"
      },
      {
        "symptomName": "Mild musculoskeletal discomfort",
        "frequency": 0.55,
        "bodySystem": "musculoskeletal",
        "notes": "Occasional mild aches without significant pathology"
      }
    ],
    "occasional": [
      {
        "symptomName": "Mild nephrolithiasis",
        "frequency": 0.3,
        "bodySystem": "renal",
        "notes": "Rare kidney stones despite hypocalciuria"
      },
      {
        "symptomName": "Mild constipation",
        "frequency": 0.25,
        "bodySystem": "gastrointestinal",
        "notes": "Occasional mild GI symptoms"
      },
      {
        "symptomName": "Headache",
        "frequency": 0.2,
        "bodySystem": "neurological",
        "notes": "Non-specific symptom sometimes reported"
      },
      {
        "symptomName": "Mild depression or mood changes",
        "frequency": 0.15,
        "bodySystem": "psychiatric",
        "notes": "Occasional mild psychiatric symptoms"
      }
    ],
    "rare": [
      {
        "symptomName": "Pancreatitis",
        "frequency": 0.05,
        "bodySystem": "gastrointestinal",
        "notes": "Very rare complication"
      },
      {
        "symptomName": "Severe nephrolithiasis requiring intervention",
        "frequency": 0.04,
        "bodySystem": "renal",
        "notes": "Rarely severe kidney stones"
      },
      {
        "symptomName": "Osteitis fibrosa cystica",
        "frequency": 0.03,
        "bodySystem": "musculoskeletal",
        "notes": "Extremely rare bone disease usually absent in FHH"
      }
