        "requiredForDiagnosis": true
      },
      {
        "id": "hibch-gene-mutation",
        "description": "Identification of pathogenic mutations in the HIBCH gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of neurological symptoms including developmental delay and dystonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated urinary 3-hydroxyisobutyric acid plus either HIBCH enzyme deficiency or pathogenic HIBCH gene mutations",
    "notes": "Diagnosis is confirmed by biochemical and genetic testing; clinical features support but are not definitive alone."
