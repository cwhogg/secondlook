  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Cri du Chat Syndrome",
    "criteria": [
      {
        "id": "high-pitched-cry",
        "description": "Presence of a characteristic high-pitched, cat-like cry in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "5p-chromosomal-deletion",
        "description": "Confirmed deletion of the short arm of chromosome 5 (5p) by cytogenetic or molecular testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Distinctive craniofacial features including microcephaly, hypertelorism, epicanthal folds, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay and intellectual disability of variable severity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic high-pitched cry and confirmed 5p chromosomal deletion",
    "notes": "Diagnosis is confirmed by genetic testing; clinical features support diagnosis."
  },
