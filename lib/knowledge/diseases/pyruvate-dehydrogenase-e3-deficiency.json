        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of neurological symptoms including developmental delay and lactic acidosis",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Reduced E3 enzyme activity plus pathogenic DLD gene variant identification with compatible clinical features",
    "notes": "Diagnosis may be supported by biochemical and molecular testing; muscle biopsy and metabolic profiling are helpful."
