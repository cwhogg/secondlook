  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Distal Duplication 18q Syndrome",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Identification of duplication involving the distal long arm of chromosome 18 by karyotype, FISH, or microarray",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial features including microcephaly, prominent forehead, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or skeletal abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of distal 18q duplication plus at least one major clinical feature such as developmental delay or characteristic craniofacial dysmorphism",
    "notes": "Diagnosis relies heavily on genetic testing due to phenotypic variability."
  },
