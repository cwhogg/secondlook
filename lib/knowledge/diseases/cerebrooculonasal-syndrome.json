  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Cerebrooculonasal Syndrome",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial abnormalities including hypertelorism, broad nasal bridge, and midline nasal cleft",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "Congenital ocular malformations such as microphthalmia, coloboma, or cataracts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-impairment",
        "description": "Developmental delay or intellectual disability with associated brain malformations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nasal-structural-defects",
        "description": "Midline nasal defects including cleft or hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in relevant genes (e.g., WDR35)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: craniofacial dysmorphism, ocular anomalies, and neurological impairment",
    "notes": "Genetic testing can support diagnosis but is not mandatory if clinical criteria are met"
  },
