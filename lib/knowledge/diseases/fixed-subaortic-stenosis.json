  "diagnosticCriteria": {
    "formalCriteriaName": "Echocardiographic Diagnostic Criteria for Fixed Subaortic Stenosis",
    "criteria": [
      {
        "id": "echocardiographic-membrane",
        "description": "Presence of a discrete fibrous or fibromuscular membrane or ridge in the left ventricular outflow tract (LVOT) visualized by echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pressure-gradient",
        "description": "Elevated pressure gradient across the LVOT measured by Doppler echocardiography (typically >30 mmHg)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-valvular-aortic-stenosis",
        "description": "No significant aortic valve leaflet thickening or calcification to explain obstruction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-symptoms",
        "description": "Symptoms consistent with left ventricular outflow obstruction such as exertional dyspnea or syncope",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of a discrete subaortic membrane on echocardiography with elevated LVOT pressure gradient and exclusion of valvular aortic stenosis",
    "notes": "Diagnosis is primarily based on echocardiographic findings supported by clinical presentation."
  },
