  "diagnosticCriteria": {
    "formalCriteriaName": "Klippel-Feil Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cervical-fusion",
        "description": "Congenital fusion of two or more cervical vertebrae confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-neck",
        "description": "Clinically apparent short neck with limited cervical range of motion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-hairline",
        "description": "Low posterior hairline observed on physical examination",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-syndromic-features",
        "description": "Lack of associated systemic anomalies or syndromic features",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of congenital cervical vertebral fusion with short neck and low posterior hairline, without other syndromic anomalies",
    "notes": "Diagnosis is primarily clinical supported by radiographic evidence; genetic testing may be used to exclude syndromic forms."
  },
