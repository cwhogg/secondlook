  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Isolated Polycystic Liver Disease",
    "criteria": [
      {
        "id": "hepatic-cysts",
        "description": "Presence of multiple (>20) hepatic cysts detected by imaging without renal cysts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-renal-cysts",
        "description": "No evidence of polycystic kidney disease on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of isolated polycystic liver disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in PRKCSH or SEC63 genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple hepatic cysts without renal cysts on imaging; family history or genetic confirmation supportive but not mandatory",
    "notes": "Diagnosis requires exclusion of autosomal dominant polycystic kidney disease (ADPKD)"
  },
