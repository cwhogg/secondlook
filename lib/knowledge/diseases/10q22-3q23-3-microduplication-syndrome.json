    "formalCriteriaName": "Chromosomal Microduplication Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of microduplication at chromosome 10q22.3q23.3 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Presence of global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Characteristic craniofacial dysmorphic features such as hypertelorism and broad nasal bridge",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 10q22.3q23.3 microduplication plus at least one major clinical feature (developmental delay or intellectual disability)",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support but are variable."
  },
