  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic criteria for Familial Dysautonomia",
    "criteria": [
      {
        "id": "fd-1",
        "description": "Absence of fungiform papillae on the tongue",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "fd-2",
        "description": "Absence of overflow tears (alacrima)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "fd-3",
        "description": "Depressed or absent deep tendon reflexes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "fd-4",
        "description": "Absence of axon flare after intradermal histamine injection",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "fd-5",
        "description": "Miosis after conjunctival instillation of dilute methacholine (0.0625%)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "fd-6",
        "description": "Homozygous or compound heterozygous pathogenic variants in ELP1 (IKBKAP) gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation with biallelic pathogenic ELP1 variants; clinical features support diagnosis",
    "notes": "The major founder mutation (IVS20+6T>C) accounts for >99.5% of alleles in Ashkenazi Jewish patients."
  },
