  "diagnosticCriteria": {
    "formalCriteriaName": "Lambert-Eaton Myasthenic Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-weakness",
        "description": "Proximal muscle weakness, especially in lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Incremental response on repetitive nerve stimulation or post-exercise facilitation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoantibodies",
        "description": "Presence of voltage-gated calcium channel (VGCC) antibodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autonomic-symptoms",
        "description": "Autonomic dysfunction such as dry mouth or erectile dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "associated-malignancy",
        "description": "Detection of underlying malignancy, commonly small cell lung carcinoma",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of proximal muscle weakness plus electrophysiological evidence of incremental response and/or VGCC antibodies",
    "notes": "Diagnosis is supported by clinical features, electrophysiological testing, and antibody detection; malignancy screening is recommended."
  },
