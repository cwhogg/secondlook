  "diagnosticCriteria": {
    "formalCriteriaName": "Renal Tubular Dysgenesis Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histological evidence of absent or severely underdeveloped proximal renal tubules",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in genes involved in the renin-angiotensin system (e.g., ACE, AGT, REN, AGTR1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Severe oligohydramnios and anuria in the perinatal period with refractory hypotension",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Ultrasound showing hyperechogenic kidneys with poor corticomedullary differentiation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of histopathological findings plus genetic confirmation or clinical presentation consistent with RTD and genetic confirmation",
    "notes": "Diagnosis is often confirmed postmortem due to perinatal lethality."
  },
