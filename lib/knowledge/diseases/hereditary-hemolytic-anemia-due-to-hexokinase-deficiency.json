  "keyFindings": {
    "laboratory": [
      "Decreased hexokinase enzyme activity in red blood cells",
      "Elevated reticulocyte count",
      "Elevated indirect bilirubin",
      "Anemia with normocytic or slightly microcytic indices",
      "Elevated lactate dehydrogenase (LDH)"
    ],
    "imaging": [
      "Ultrasound evidence of splenomegaly",
      "Ultrasound detection of gallstones"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Peripheral blood smear showing anisopoikilocytosis and polychromasia"
    ]
  },
