      ]
    },
    {
      "diseaseId": "juvenile-onset-alzheimer-disease",
      "distinguishingFeatures": [
        "Gradual cognitive decline without seizures",
        "No measles virus involvement",
        "Normal EEG without periodic complexes"
      ]
    },
    {
      "diseaseId": "mitochondrial-encephalomyopathy",
      "distinguishingFeatures": [
        "Multisystem involvement including muscle and metabolic abnormalities",
        "Lactic acidosis on laboratory testing",
        "No measles antibody elevation or characteristic EEG"
      ]
    }
