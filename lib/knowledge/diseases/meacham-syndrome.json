  "diagnosticCriteria": {
    "formalCriteriaName": "Meacham Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "congenital-heart-defect",
        "description": "Presence of congenital heart defects, especially atrioventricular septal defects or ventricular septal defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genitourinary-anomalies",
        "description": "Genitourinary malformations including ambiguous genitalia, cryptorchidism, or hypospadias",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-hypoplasia",
        "description": "Pulmonary hypoplasia or respiratory insufficiency at birth",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features such as micrognathia, low-set ears, and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-anomalies",
        "description": "Renal malformations including renal hypoplasia or dysplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital heart defect and genitourinary anomalies with or without pulmonary hypoplasia",
    "notes": "Diagnosis is clinical and supported by imaging and genetic testing when available."
  },
