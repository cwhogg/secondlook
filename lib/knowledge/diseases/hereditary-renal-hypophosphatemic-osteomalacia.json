  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Hereditary Renal Hypophosphatemic Osteomalacia",
    "criteria": [
      {
        "id": "renal-phosphate-wasting",
        "description": "Evidence of renal phosphate wasting with hypophosphatemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-pain-fractures",
        "description": "Presence of bone pain, fractures, or osteomalacia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant or recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "low-1-25-vitamin-d",
        "description": "Inappropriately low or normal serum 1,25-dihydroxyvitamin D levels despite hypophosphatemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in genes such as PHEX, FGF23, or DMP1",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of renal phosphate wasting with hypophosphatemia plus clinical features of osteomalacia or bone pain, supported by low 1,25-dihydroxyvitamin D or genetic confirmation",
    "notes": "Genetic testing is confirmatory but not always necessary if clinical and biochemical criteria are met."
  },
