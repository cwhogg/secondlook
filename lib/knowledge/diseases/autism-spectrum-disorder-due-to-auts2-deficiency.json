        "requiredForDiagnosis": true
      },
      {
        "id": "restricted-repetitive-behaviors",
        "description": "Restricted, repetitive patterns of behavior, interests, or activities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "auts2-genetic-confirmation",
        "description": "Molecular genetic confirmation of AUTS2 deficiency or pathogenic variant",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Delayed developmental milestones, especially in language and motor skills",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "intellectual-disability",
        "description": "Presence of intellectual disability or cognitive impairment",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of social communication deficits and restricted repetitive behaviors plus molecular genetic confirmation of AUTS2 deficiency",
    "notes": "Diagnosis requires genetic testing to confirm AUTS2 deficiency in addition to clinical ASD criteria."
