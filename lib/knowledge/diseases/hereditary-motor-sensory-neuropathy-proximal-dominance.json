  "keyFindings": {
    "laboratory": [
      "Elevated creatine kinase (mild, nonspecific)",
      "Normal routine blood tests"
    ],
    "imaging": [
      "Muscle MRI showing proximal muscle atrophy and fatty infiltration"
    ],
    "genetic": [
      "Pathogenic mutations in genes such as HSPB1, MFN2, or other neuropathy-associated genes"
    ],
    "other": [
      "Nerve conduction studies showing reduced conduction velocities and/or axonal loss predominantly affecting proximal nerves"
    ]
  },
  "differentialDiagnoses": [
