  "diagnosticCriteria": {
    "formalCriteriaName": "No universally accepted formal criteria; diagnosis based on clinical, laboratory, and histopathological findings",
    "criteria": [
      {
        "id": "clinical-thickening",
        "description": "Symmetrical swelling, induration, and thickening of the skin and subcutaneous fascia, typically of the limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peripheral-eosinophilia",
        "description": "Peripheral blood eosinophilia (>500 cells/μL) during active disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fascia-biopsy",
        "description": "Full-thickness skin-to-muscle biopsy showing fascial thickening with inflammatory infiltrate rich in eosinophils",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-scleroderma-features",
        "description": "Lack of typical scleroderma features such as Raynaud phenomenon or internal organ involvement",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypergammaglobulinemia",
        "description": "Elevated serum immunoglobulins (IgG, IgM) during active disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of symmetrical skin and fascial thickening with peripheral eosinophilia and confirmatory fascia biopsy",
    "notes": "Diagnosis requires exclusion of systemic sclerosis and other scleroderma-like disorders"
  },
  "symptoms": {
