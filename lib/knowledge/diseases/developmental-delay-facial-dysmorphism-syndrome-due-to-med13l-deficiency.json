        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic or likely pathogenic variant in MED13L gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Neonatal or infantile hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "speech-delay",
        "description": "Delayed speech development or absent speech",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of global developmental delay and characteristic facial dysmorphism plus confirmed pathogenic MED13L variant",
    "notes": "Diagnosis relies heavily on molecular genetic confirmation due to phenotypic overlap with other syndromes"
