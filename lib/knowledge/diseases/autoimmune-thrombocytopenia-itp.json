        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of thrombocytopenia such as drug-induced, infections, or bone marrow disorders",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "presence-of-anti-platelet-antibodies",
        "description": "Detection of platelet-specific autoantibodies (supportive but not mandatory)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-bone-marrow-examination",
        "description": "Bone marrow examination showing normal or increased megakaryocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Isolated thrombocytopenia with platelet count <100 x 10^9/L and exclusion of other causes",
    "notes": "Diagnosis is primarily clinical and by exclusion; antibody testing is supportive but not definitive."
