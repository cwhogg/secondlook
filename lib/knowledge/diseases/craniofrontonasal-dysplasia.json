  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Craniofrontonasal Dysplasia",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Presence of coronal craniosynostosis or craniofacial anomalies including hypertelorism and frontonasal dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-defects",
        "description": "Limb anomalies such as longitudinally split or bifid nails, syndactyly, or clinodactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sex-severity-paradox",
        "description": "Paradoxical greater severity of craniofacial and limb anomalies in females compared to males",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of coronal craniosynostosis or frontonasal dysplasia plus limb anomalies",
    "notes": "Genetic testing for EFNB1 mutations supports diagnosis but is not mandatory"
  },
