  "diagnosticCriteria": {
    "formalCriteriaName": "Unstable Hemoglobinopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "unstable-hemoglobin-detection",
        "description": "Detection of unstable beta globin variants by hemoglobin electrophoresis or HPLC",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemolytic-anemia",
        "description": "Presence of chronic hemolytic anemia with reticulocytosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the HBB gene via molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peripheral-blood-smear",
        "description": "Peripheral blood smear showing Heinz bodies and bite cells",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history of hemolytic anemia or unstable hemoglobin variants",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic hemolytic anemia with detection of unstable beta globin variant and confirmation by genetic testing",
    "notes": "Diagnosis requires exclusion of other hemoglobinopathies and hemolytic anemias."
  },
