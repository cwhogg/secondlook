  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Hepatic Veno-Occlusive Disease-Immunodeficiency Syndrome",
    "criteria": [
      {
        "id": "hepatic-veno-occlusion",
        "description": "Histologically confirmed hepatic veno-occlusive disease with sinusoidal obstruction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Documented combined immunodeficiency with decreased T-cell and B-cell function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of hepatomegaly, ascites, and jaundice in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with endothelial dysfunction and immune dysregulation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of veno-occlusive disease and immunodeficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met: histological confirmation of hepatic veno-occlusive disease, documented combined immunodeficiency, and characteristic clinical presentation.",
    "notes": "Genetic testing and exclusion of other causes support diagnosis but are not mandatory."
  },
