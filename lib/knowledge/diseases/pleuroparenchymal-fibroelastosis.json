  "keyFindings": {
    "laboratory": [
      "Mildly elevated inflammatory markers (ESR, CRP) in some cases",
      "Normal or mildly reduced arterial blood gases in early disease"
    ],
    "imaging": [
      "High-resolution CT showing upper lobe pleural thickening and subpleural fibrosis",
      "Volume loss and architectural distortion predominantly in upper lobes",
      "Flattened chest wall (platythorax) on lateral chest radiographs"
    ],
    "genetic": [
      "No well-established genetic mutations identified; familial cases reported rarely"
    ],
    "other": [
      "Histopathology demonstrating dense elastotic fibrosis of pleura and subpleural lung parenchyma",
      "Restrictive pattern on pulmonary function tests with reduced lung volumes"
    ]
  },
