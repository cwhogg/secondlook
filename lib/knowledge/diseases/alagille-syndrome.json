  "differentialDiagnoses": [
    {
      "diseaseId": "biliary-atresia",
      "distinguishingFeatures": [
        "Absence of bile ducts rather than paucity",
        "No characteristic facial features",
        "No associated cardiac or skeletal anomalies"
      ]
    },
    {
      "diseaseId": "caroli-disease",
      "distinguishingFeatures": [
        "Dilatation of intrahepatic bile ducts",
        "No multisystem involvement",
        "No characteristic facial features"
      ]
    },
    {
      "diseaseId": "progressive familial intrahepatic cholestasis",
      "distinguishingFeatures": [
        "Early onset cholestasis without cardiac or skeletal defects",
        "No facial dysmorphism",
        "Different genetic mutations"
      ]
    }
  ],
