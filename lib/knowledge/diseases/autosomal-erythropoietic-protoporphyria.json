  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Erythropoietic Protoporphyria",
    "criteria": [
      {
        "id": "clinical-phototoxicity",
        "description": "Recurrent painful photosensitivity with burning, itching, and erythema on sun-exposed skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-protoporphyrin",
        "description": "Increased free protoporphyrin levels in erythrocytes and plasma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the FECH gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-function-assessment",
        "description": "Assessment of liver function to detect protoporphyrin-induced hepatopathy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skin-biopsy",
        "description": "Histopathological evidence of protoporphyrin deposition in skin",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical photosensitivity plus elevated erythrocyte protoporphyrin levels and confirmation by genetic testing",
    "notes": "Liver involvement should be monitored due to risk of protoporphyric hepatopathy."
  },
