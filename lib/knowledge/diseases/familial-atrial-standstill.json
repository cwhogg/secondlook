  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible elevated brain natriuretic peptide (BNP) in heart failure"
    ],
    "imaging": [
      "Echocardiography showing absence of atrial contraction",
      "ECG demonstrating absence of P waves and junctional or ventricular escape rhythm"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electrophysiological studies confirming atrial electrical inactivity",
      "Failure of atrial capture on pacing"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sick-sinus-syndrome",
      "distinguishingFeatures": [
        "Presence of sinus node dysfunction with preserved atrial activity",
        "P waves present but abnormal sinus rhythm"
      ]
    },
    {
      "diseaseId": "atrioventricular-block",
      "distinguishingFeatures": [
        "Presence of P waves with AV conduction delay or block",
        "Bradycardia due to AV node dysfunction rather than atrial standstill"
      ]
    },
    {
      "diseaseId": "atrial-fibrillation",
      "distinguishingFeatures": [
        "Irregularly irregular rhythm with fibrillatory waves instead of absent atrial activity",
        "Presence of chaotic atrial electrical activity"
      ]
    }
  ],
