  "keyFindings": {
    "laboratory": [
      "Elevated serum alpha-fetoprotein (AFP) after infancy",
      "Low immunoglobulin A (IgA) and IgG subclasses",
      "Lymphopenia with reduced T-cell counts"
    ],
    "imaging": [
      "Cerebellar atrophy on brain MRI",
      "Pulmonary fibrosis on chest CT in advanced cases"
    ],
    "genetic": [
