  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for limb-girdle muscular dystrophies",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness predominantly affecting pelvic and shoulder girdle muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes and reduced or absent gamma-sarcoglycan protein expression by immunohistochemistry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the SGCG gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Myopathic changes on electromyography supportive of muscular dystrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "serum-creatine-kinase",
        "description": "Elevated serum creatine kinase levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal muscle weakness with either muscle biopsy showing gamma-sarcoglycan deficiency or identification of pathogenic SGCG variants",
    "notes": "Diagnosis requires integration of clinical, histopathological, and genetic findings."
  },
