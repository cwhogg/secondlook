  "keyFindings": {
    "laboratory": [
      "Elevated autoantibodies against adrenal cortex, thyroid peroxidase, and pancreatic islet cells",
      "Low cortisol and aldosterone levels consistent with adrenal insufficiency",
      "Elevated TSH with low free T4 in autoimmune thyroiditis",
      "Hyperglycemia with positive anti-GAD antibodies"
    ],
    "imaging": [
      "Adrenal gland atrophy on abdominal CT or MRI",
      "Thyroid gland heterogeneity on ultrasound"
    ],
    "genetic": [
      "No mutations in AIRE gene (distinguishing from APS type 1)",
      "HLA associations may be present but not diagnostic",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Histopathology showing lymphocytic infiltration of affected endocrine glands"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autoimmune-polyendocrinopathy-type-1",
      "distinguishingFeatures": [
        "Early onset in childhood",
        "Presence of chronic mucocutaneous candidiasis",
        "Mutations in AIRE gene"
      ]
    },
    {
      "diseaseId": "autoimmune-polyendocrinopathy-type-2",
      "distinguishingFeatures": [
        "More common in females",
        "Combination of Addison disease with autoimmune thyroid disease and/or type 1 diabetes",
        "HLA-DR3 and DR4 associations"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset adrenal crisis symptoms (hypotension, hyponatremia, hyperkalemia)",
    "Severe hypoglycemia or diabetic ketoacidosis in type 1 diabetes",
    "Progressive multi-organ autoimmune failure"
  ],
