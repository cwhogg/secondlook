  "diagnosticCriteria": {
    "formalCriteriaName": "SOX5 Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic or likely pathogenic variants in the SOX5 gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay including significant speech delay evident in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Presence of mild craniofacial dysmorphic features such as broad nasal bridge and micrognathia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuroimaging-findings",
        "description": "Brain MRI showing nonspecific white matter abnormalities or corpus callosum hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic SOX5 variant identified plus clinical evidence of developmental and speech delay",
    "notes": "Diagnosis is primarily genetic; clinical features support but are variable."
  },
