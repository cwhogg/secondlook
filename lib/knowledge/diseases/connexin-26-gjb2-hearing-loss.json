  ],
  "keyFindings": {
    "laboratory": [
      "Audiometric testing confirming bilateral sensorineural hearing loss",
      "Normal middle ear function on tympanometry"
    ],
    "imaging": [
      "Typically normal temporal bone MRI and CT scans"
    ],
    "genetic": [
      "Biallelic pathogenic variants in the GJB2 gene encoding connexin 26"
    ],
    "other": [
      "Normal vestibular function tests in most cases"
    ]
  },
