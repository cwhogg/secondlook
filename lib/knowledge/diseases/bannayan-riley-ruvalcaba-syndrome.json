  "keyFindings": {
    "laboratory": [
      "PTEN gene mutation identified by molecular genetic testing",
      "Mild thrombocytopenia in some patients"
    ],
    "imaging": [
      "Abdominal ultrasound or CT showing intestinal polyps",
      "MRI brain may show nonspecific findings related to developmental delay"
    ],
    "genetic": [
      "PTEN (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology of polyps showing hamartomatous features",
      "Biopsy of lipomas confirming benign adipose tissue"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cowden-syndrome",
      "distinguishingFeatures": [
        "Higher risk of malignancies including breast and thyroid cancer",
        "Presence of trichilemmomas and papillomatous papules",
        "Later onset compared to BRRS"
      ]
    },
    {
      "diseaseId": "proteus-syndrome",
      "distinguishingFeatures": [
        "Asymmetric overgrowth of bones and skin",
        "Cerebriform connective tissue nevi",
        "Mosaic AKT1 mutations rather than PTEN"
      ]
    }
  ],
  "redFlags": [
    "Rapid increase in size or number of intestinal polyps",
    "Development of thyroid nodules or masses",
    "Neurological regression or worsening developmental delay"
  ],
  "specialistType": [
    "Geneticist",
