  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP (may be normal in chronic/burnt-out phase)",
      "Normocytic anemia",
      "Thrombocytosis",
      "Elevated IL-6",
      "Pentraxin-3 may be elevated in active disease",
      "ANCA negative"
    ],
    "imaging": [
      "CTA: concentric arterial wall thickening with stenosis or occlusion of aorta and branches",
      "MRA: vessel wall edema and enhancement (active inflammation), stenosis, occlusion",
      "PET-CT: FDG uptake in aortic wall and major branches (active disease)",
      "Conventional angiography: stenoses, occlusions, aneurysms in aorta and branches",
      "Doppler ultrasound: intima-media thickening (Macaroni sign) in carotid/subclavian arteries"
    ],
    "genetic": [
      "HLA-B (susceptibility)",
      "IL12B (susceptibility)",
      "MLX (susceptibility)"
    ],
    "other": [
      "Arterial biopsy (rarely performed): granulomatous panarteritis with giant cells, intimal hyperplasia, adventitial fibrosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "giant-cell-arteritis",
      "distinguishingFeatures": [
        "Age > 50",
        "Temporal headache",
        "Jaw claudication",
        "Northern European descent"
      ]
    },
    {
      "diseaseId": "atherosclerosis",
      "distinguishingFeatures": [
        "Older age",
        "Cardiovascular risk factors",
        "Focal stenoses rather than long-segment",
        "No wall thickening on imaging"
      ]
    },
    {
      "diseaseId": "fibromuscular-dysplasia",
      "distinguishingFeatures": [
        "String-of-beads angiographic appearance",
        "No systemic inflammation",
        "Renal and carotid predominance"
      ]
    },
    {
      "diseaseId": "igg4-related-disease",
      "distinguishingFeatures": [
        "Elevated serum IgG4",
        "Periaortitis pattern",
        "Other organ involvement (pancreas, salivary glands)"
      ]
    }
  ],
  "redFlags": [
    "Undetectable blood pressure in one or both arms",
    "Syncope or neurological deficits suggesting cerebrovascular compromise",
    "Rapidly progressive hypertension (renal artery stenosis)",
    "New aortic regurgitation murmur",
    "Chest or back pain suggesting aortic dissection or aneurysm expansion"
  ],
