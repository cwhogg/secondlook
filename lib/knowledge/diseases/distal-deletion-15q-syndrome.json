  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible growth hormone levels if endocrine evaluation performed"
    ],
    "imaging": [
      "Echocardiogram revealing congenital heart defects",
      "Renal ultrasound showing structural anomalies",
      "Brain MRI may show nonspecific findings related to developmental delay"
    ],
    "genetic": [
      "MCTP2 (phenotype modifier)"
    ],
    "other": [
      "Prenatal ultrasound may detect intrauterine growth restriction and some structural anomalies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "prader-willi-syndrome",
      "distinguishingFeatures": [
        "15q11-q13 deletion or imprinting defect",
        "Hyperphagia and obesity in childhood",
        "Hypotonia with distinct facial features different from distal 15q deletion"
      ]
    },
    {
      "diseaseId": "silver-russell-syndrome",
      "distinguishingFeatures": [
        "Growth retardation with asymmetry",
        "Hypomethylation of 11p15 or maternal uniparental disomy 7",
        "Distinct facial features including triangular face and prominent forehead"
      ]
    }
  ],
  "redFlags": [
    "Severe congenital heart defects requiring early intervention",
    "Marked global developmental delay or intellectual disability",
    "Failure to thrive with feeding difficulties in infancy"
  ],
