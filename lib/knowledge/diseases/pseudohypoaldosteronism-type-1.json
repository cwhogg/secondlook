  "keyFindings": {
    "laboratory": [
      "Elevated plasma aldosterone and renin levels",
      "Hyponatremia and hyperkalemia",
      "Metabolic acidosis",
      "Normal cortisol and adrenal steroidogenesis"
    ],
    "imaging": [
      "Usually normal renal ultrasound",
      "Possible nephrocalcinosis in chronic cases"
    ],
    "genetic": [
      "Mutations in NR3C2 gene (mineralocorticoid receptor) in autosomal dominant form",
      "Mutations in SCNN1A, SCNN1B, or SCNN1G genes (ENaC subunits) in autosomal recessive form"
    ],
    "other": [
      "Failure to respond to mineralocorticoid therapy",
      "Positive family history in some cases"
    ]
  },
