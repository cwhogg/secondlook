  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Lissencephaly Type 3",
    "criteria": [
      {
        "id": "lissencephaly",
        "description": "Presence of classical lissencephaly characterized by smooth cerebral cortex with agyria or pachygyria on brain MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metacarpal-dysplasia",
        "description": "Radiological evidence of metacarpal bone dysplasia including shortening and abnormal morphology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Severe global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "Early-onset refractory epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent forehead and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of classical lissencephaly on MRI plus metacarpal bone dysplasia on radiographs and severe developmental delay",
    "notes": "Genetic testing for causative mutations may support diagnosis but is not mandatory."
  },
