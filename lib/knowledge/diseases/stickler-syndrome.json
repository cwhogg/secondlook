  "keyFindings": {
    "laboratory": [
      "No specific laboratory markers"
    ],
    "imaging": [
      "Slit-lamp examination revealing characteristic vitreous anomaly",
      "Skeletal survey showing spondyloepiphyseal changes",
      "Joint radiographs may show early degenerative changes",
      "Fundoscopy showing retinal changes"
    ],
    "genetic": [
      "BMP4 (causative)",
      "Autosomal dominant (Types 1-3) or autosomal recessive (Types 4-6)"
    ],
    "other": [
      "Audiometry for hearing assessment",
      "Regular ophthalmologic surveillance including vitreous examination",
      "Orofacial assessment for cleft palate or submucous cleft"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "marfan-syndrome",
      "distinguishingFeatures": [
        "Marfan has tall stature; Stickler patients are normal or short stature",
        "Marfan has ectopia lentis; Stickler has vitreous anomaly and retinal detachment",
        "Marfan has aortic root dilation as cardinal feature"
      ]
    },
    {
      "diseaseId": "ehlers-danlos-hypermobile",
      "distinguishingFeatures": [
        "hEDS lacks vitreoretinal pathology",
        "hEDS lacks hearing loss and midface hypoplasia",
        "hEDS has primarily musculoskeletal and pain manifestations"
      ]
    }
  ],
  "redFlags": [
    "Flashes, floaters, or curtain-like visual field loss (retinal detachment - emergency)",
    "Neonatal airway compromise from Robin sequence",
