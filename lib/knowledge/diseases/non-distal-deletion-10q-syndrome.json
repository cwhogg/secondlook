  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible mild anemia",
      "Metabolic screening typically unremarkable"
    ],
    "imaging": [
      "Echocardiography revealing congenital heart defects",
      "Brain MRI may show nonspecific white matter abnormalities",
      "Skeletal X-rays showing clinodactyly or other anomalies"
    ],
    "genetic": [
      "Interstitial deletion of chromosome 10q11-q21 confirmed by chromosomal microarray or FISH",
      "Absence of distal 10q deletion"
    ],
    "other": [
      "Developmental and neuropsychological assessments confirming intellectual disability",
      "Audiological evaluation for hearing impairment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "distal-deletion-10q-syndrome",
      "distinguishingFeatures": [
        "Deletion involves distal 10q region rather than proximal",
        "More severe craniofacial anomalies and limb defects",
        "Higher frequency of cardiac malformations"
      ]
    },
    {
      "diseaseId": "cri-du-chat-syndrome",
      "distinguishingFeatures": [
        "Deletion on chromosome 5p rather than 10q",
        "Characteristic high-pitched cat-like cry in infancy",
        "Distinctive facial features including microcephaly"
      ]
    }
  ],
  "redFlags": [
    "Severe developmental delay with regression",
    "Congenital heart defects causing cyanosis or heart failure",
    "Recurrent severe infections indicating possible immunodeficiency"
  ],
