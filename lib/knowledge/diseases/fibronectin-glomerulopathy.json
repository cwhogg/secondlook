  "diagnosticCriteria": {
    "formalCriteriaName": "Fibronectin Glomerulopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of characteristic fibronectin deposits in glomeruli on renal biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "proteinuria",
        "description": "Persistent proteinuria, often nephrotic range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of proteinuria or renal failure consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in FN1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Renal biopsy demonstrating fibronectin deposits plus persistent proteinuria",
    "notes": "Genetic testing and family history support diagnosis but are not mandatory."
  },
