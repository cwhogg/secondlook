        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-anomalies",
        "description": "Ocular abnormalities such as coloboma or strabismus",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of epidermal nevus plus at least one extracutaneous manifestation (neurological, skeletal, or ocular abnormalities)",
    "notes": "Diagnosis is clinical; genetic testing may support but is not definitive."
