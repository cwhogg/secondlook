  "diagnosticCriteria": {
    "formalCriteriaName": "Holoprosencephaly Diagnostic Criteria",
    "criteria": [
      {
        "id": "midline-facial-anomalies",
        "description": "Presence of midline facial anomalies including hypotelorism or single central incisor",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-midline-structural-abnormalities",
        "description": "Neuroradiological evidence of incomplete separation of the preoptic region of the forebrain",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-septum-pellucidum",
        "description": "Absence or hypoplasia of the septum pellucidum on brain imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of neuroradiological evidence of preoptic forebrain non-separation plus at least one major midline facial anomaly",
    "notes": "Diagnosis relies heavily on neuroimaging and clinical facial features; genetic testing may support diagnosis."
  },
