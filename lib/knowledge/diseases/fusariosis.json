  "keyFindings": {
    "laboratory": [
      "Positive blood cultures for Fusarium species",
      "Histopathology showing septate hyaline hyphae with acute angle branching",
      "Elevated inflammatory markers (CRP, ESR)"
    ],
    "imaging": [
      "CT chest showing pulmonary nodules with halo or air-crescent sign",
      "Sinus CT showing mucosal thickening and bone erosion",
      "MRI brain showing abscesses in disseminated cases"
    ],
    "genetic": [],
    "other": [
      "Resistance to many antifungal agents, requiring susceptibility testing",
      "Rapid progression in neutropenic patients"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "aspergillosis",
      "distinguishingFeatures": [
        "Aspergillus rarely grows in blood cultures",
        "Different antifungal susceptibility profile",
        "Histopathology shows dichotomous branching hyphae"
      ]
    },
    {
      "diseaseId": "mucormycosis",
      "distinguishingFeatures": [
        "Broad, ribbon-like non-septate hyphae on histology",
        "More common in diabetic ketoacidosis",
        "Rapid angioinvasion with tissue necrosis"
      ]
    }
  ],
  "redFlags": [
