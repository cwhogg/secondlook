  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for SCA28",
    "criteria": [
      {
        "id": "progressive-cerebellar-ataxia",
        "description": "Progressive cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "adenylate-cyclase-5-gene-mutation",
        "description": "Identification of pathogenic mutation in the AFG3L2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-ataxia-causes",
        "description": "Exclusion of other causes of ataxia including metabolic, toxic, and other genetic ataxias",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-atrophy-on-imaging",
        "description": "MRI evidence of cerebellar atrophy predominantly affecting the vermis and hemispheres",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia plus identification of pathogenic AFG3L2 mutation with exclusion of other causes",
    "notes": "Genetic testing is essential for definitive diagnosis."
  },
