  "diagnosticCriteria": {
    "formalCriteriaName": "GRFoma Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of granulomatous fibro-osseous lesions in bone marrow biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "myelofibrosis",
        "description": "Evidence of myelofibrosis on bone marrow reticulin staining",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive anemia with splenomegaly and constitutional symptoms",
        "category": "minor",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-findings",
        "description": "Radiographic evidence of osteosclerosis and bone remodeling",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Both major criteria plus at least one minor criterion must be met",
    "notes": "Diagnosis requires exclusion of other myeloproliferative and granulomatous disorders"
  },
