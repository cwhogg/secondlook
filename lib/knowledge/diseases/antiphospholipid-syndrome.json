  "keyFindings": {
    "laboratory": [
      "Lupus anticoagulant positive (most predictive of thrombosis)",
      "Anticardiolipin antibodies IgG/IgM (moderate-high titer)",
      "Anti-beta2-glycoprotein I antibodies IgG/IgM",
      "Triple aPL positivity (highest thrombotic risk)",
      "Prolonged aPTT (due to lupus anticoagulant)",
      "Thrombocytopenia",
      "Direct Coombs test positive",
      "False positive VDRL/RPR"
    ],
    "imaging": [
      "Doppler ultrasound: venous thrombosis",
      "CT angiography: pulmonary embolism or arterial thrombosis",
      "MRI brain: cerebral infarcts in young patients",
      "Echocardiography: valve thickening, vegetations (Libman-Sacks)",
      "Renal biopsy: thrombotic microangiopathy"
    ],
    "genetic": [
      "No established monogenic cause",
      "HLA-DR7 association reported",
      "Possible associations with complement gene variants"
    ],
    "other": [
      "Skin biopsy: non-inflammatory thrombotic vasculopathy",
      "Placental pathology: infarction, decidual vasculopathy"
    ]
  },
