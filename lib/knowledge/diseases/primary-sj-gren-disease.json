  "diagnosticCriteria": {
    "formalCriteriaName": "2016 ACR/EULAR Classification Criteria for Primary Sjögren's Syndrome",
    "criteria": [
      {
        "id": "anti-ssa-positivity",
        "description": "Presence of anti-SSA/Ro antibodies",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "labial-salivary-gland-biopsy",
        "description": "Focal lymphocytic sialadenitis with focus score ≥1 focus/4 mm² in labial salivary gland biopsy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-dryness",
        "description": "Objective evidence of ocular dryness by Schirmer’s test ≤5 mm/5 min or ocular staining score ≥5",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "oral-dryness",
        "description": "Unstimulated whole saliva flow rate ≤0.1 mL/min",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Total score ≥4 points combining labial salivary gland biopsy, anti-SSA positivity, ocular staining, Schirmer’s test, and unstimulated salivary flow",
    "notes": "Diagnosis requires exclusion of other causes of sicca symptoms and secondary Sjögren syndrome."
  },
