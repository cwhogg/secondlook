  "diagnosticCriteria": {
    "formalCriteriaName": "Autoimmune Enteropathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-diarrhea",
        "description": "Intractable diarrhea lasting more than 6 weeks unresponsive to dietary modification",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "villous-atrophy",
        "description": "Small intestinal villous atrophy on histopathology without evidence of celiac disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoantibodies",
        "description": "Presence of circulating anti-enterocyte and/or anti-goblet cell antibodies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of infectious, allergic, metabolic, and other causes of enteropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immune-dysregulation",
        "description": "Evidence of immune dysregulation such as associated autoimmune disorders or immunodeficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic intractable diarrhea, villous atrophy on biopsy excluding celiac disease, and exclusion of other causes",
    "notes": "Autoantibody testing supports diagnosis but is not mandatory; diagnosis often requires multidisciplinary evaluation."
  },
