  "diagnosticCriteria": {
    "formalCriteriaName": "Acetazolamide-Responsive Myotonia Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-myotonia",
        "description": "Presence of clinical myotonia characterized by delayed muscle relaxation after voluntary contraction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acetazolamide-response",
        "description": "Marked improvement of myotonic symptoms upon acetazolamide treatment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography-myotonic-discharges",
        "description": "Electromyographic evidence of myotonic discharges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with acetazolamide-responsive myotonia (e.g., CLCN1 or SCN4A)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical myotonia with EMG confirmation and positive response to acetazolamide",
    "notes": "Genetic testing supports diagnosis but is not mandatory"
  },
