        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or skeletal abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed 13q14 deletion plus either developmental delay or characteristic facial dysmorphism",
    "notes": "Diagnosis relies primarily on genetic confirmation; clinical features support but are variable."
