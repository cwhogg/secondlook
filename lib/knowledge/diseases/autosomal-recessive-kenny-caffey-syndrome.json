  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Autosomal Recessive Kenny-Caffey Syndrome",
    "criteria": [
      {
        "id": "hypoparathyroidism",
        "description": "Congenital hypoparathyroidism leading to hypocalcemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-dysplasia",
        "description": "Characteristic cortical thickening and medullary stenosis of long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Severe postnatal growth retardation resulting in short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features including microcephaly, deep-set eyes, and beaked nose",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the TBCE gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of congenital hypoparathyroidism, characteristic skeletal abnormalities, short stature, and confirmation of TBCE gene mutation",
    "notes": "Genetic testing is essential to confirm diagnosis due to phenotypic overlap with other syndromes."
  },
