        "description": "Triphalangeal or hypoplastic thumbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial anomalies including cleft palate and facial dysmorphism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Additional skeletal abnormalities such as short stature or joint contractures",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital hypoplastic anemia plus at least two major criteria including triphalangeal or hypoplastic thumbs and craniofacial dysmorphism",
    "notes": "Genetic testing may support diagnosis but is not always definitive due to variable expressivity."
