    "laboratory": [
      "Normal routine blood tests",
      "Possible mild anemia secondary to feeding difficulties"
    ],
    "imaging": [
      "Radiographs showing radial hypoplasia or aplasia",
      "Craniofacial CT demonstrating malar hypoplasia and micrognathia",
      "Echocardiogram for cardiac defects"
    ],
    "genetic": [
      "SF3B4 (causative, loss-of-function)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Prenatal ultrasound may detect limb and craniofacial anomalies",
      "Audiological evaluation for hearing impairment"
    ]
  },
