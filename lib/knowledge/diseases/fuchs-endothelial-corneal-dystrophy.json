  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Slit-lamp biomicroscopy showing endothelial guttae and corneal edema",
      "Specular microscopy demonstrating decreased endothelial cell density and pleomorphism",
      "Anterior segment optical coherence tomography (AS-OCT) showing corneal thickening and edema"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "In vivo confocal microscopy revealing endothelial cell abnormalities",
      "Pachymetry showing increased central corneal thickness"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "posterior-polymorphous-corneal-dystrophy",
      "distinguishingFeatures": [
        "Younger age of onset",
        "Vesicular and band-like endothelial lesions",
        "Less frequent corneal edema"
      ]
    },
    {
      "diseaseId": "bullous-keratopathy",
      "distinguishingFeatures": [
        "Secondary to trauma or surgery",
        "History of intraocular surgery or inflammation",
        "More acute onset of corneal edema and bullae"
      ]
    }
  ],
  "redFlags": [
    "Rapidly worsening vision indicating possible secondary infection or acute decompensation",
    "Severe ocular pain suggesting epithelial bullae rupture or infection",
    "Signs of secondary glaucoma such as eye redness, headache, or elevated intraocular pressure"
  ],
