  "diagnosticCriteria": {
    "formalCriteriaName": "Merkel Cell Carcinoma Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histopathological identification of small round blue cells with neuroendocrine features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Positive immunohistochemical staining for cytokeratin 20 in a perinuclear dot pattern",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Rapidly growing, painless, firm, red to violaceous cutaneous nodule typically on sun-exposed skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Imaging to assess local invasion and metastasis (e.g., PET/CT)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic histopathology and positive CK20 immunostaining with compatible clinical presentation",
    "notes": "Diagnosis requires biopsy with immunohistochemical confirmation due to overlap with other small cell neoplasms."
  },
