  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Machado-Joseph Disease",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with gait disturbance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ophthalmoplegia",
        "description": "Ophthalmoplegia or diplopia due to cranial nerve involvement",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Presence of expanded CAG trinucleotide repeat in ATXN3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pyramidal-signs",
        "description": "Pyramidal tract signs such as spasticity and hyperreflexia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "peripheral-neuropathy",
        "description": "Electrophysiological evidence of peripheral neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive cerebellar ataxia plus genetic confirmation of ATXN3 CAG repeat expansion",
    "notes": "Diagnosis is confirmed by molecular genetic testing; clinical features support diagnosis and guide testing."
  },
