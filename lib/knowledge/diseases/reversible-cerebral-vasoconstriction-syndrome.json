  "diagnosticCriteria": {
    "formalCriteriaName": "International RCVS Diagnostic Criteria",
    "criteria": [
      {
        "id": "thunderclap-headache",
        "description": "Sudden onset severe thunderclap headache, often recurrent",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "segmental-vasoconstriction",
        "description": "Segmental cerebral arterial vasoconstriction demonstrated by angiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "reversibility",
        "description": "Reversibility of vasoconstriction within 12 weeks confirmed by follow-up imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-subarachnoid-hemorrhage",
        "description": "No evidence of aneurysmal subarachnoid hemorrhage",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-vasculopathies",
        "description": "Exclusion of other causes such as vasculitis, intracranial atherosclerosis, or dissection",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of thunderclap headache, segmental cerebral arterial vasoconstriction on angiography, and documented reversibility within 12 weeks",
    "notes": "Diagnosis requires exclusion of other causes of cerebral vasculopathy and hemorrhage."
  },
