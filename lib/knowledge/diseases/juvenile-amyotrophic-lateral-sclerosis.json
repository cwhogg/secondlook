  "keyFindings": {
    "laboratory": [
      "Electromyography showing denervation and reinnervation",
      "Nerve conduction studies typically normal or showing mild abnormalities"
    ],
    "imaging": [
      "MRI brain and spinal cord to exclude other causes",
      "Possible corticospinal tract hyperintensity on T2-weighted MRI"
    ],
    "genetic": [
      "ALS2 (causative)",
      "SPG11 (causative)",
      "SIGMAR1 (causative)",
      "FUS (causative)",
      "SPTLC1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy showing neurogenic atrophy",
      "Pulmonary function tests indicating respiratory muscle weakness"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "spinal-muscular-atrophy",
      "distinguishingFeatures": [
        "Predominantly lower motor neuron involvement without upper motor neuron signs",
        "Genetic testing positive for SMN1 mutations"
      ]
    },
    {
      "diseaseId": "hereditary-spastic-paraplegia",
      "distinguishingFeatures": [
        "Predominantly upper motor neuron signs with slow progression",
        "Lack of lower motor neuron signs and fasciculations"
      ]
    },
    {
      "diseaseId": "multisystem-atrophy",
      "distinguishingFeatures": [
        "Autonomic failure with parkinsonism or cerebellar signs",
        "MRI showing characteristic changes in basal ganglia or cerebellum"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of weakness over weeks",
    "Bulbar onset with early respiratory failure",
    "Family history of juvenile-onset motor neuron disease"
  ],
