  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Choroideremia",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive night blindness and peripheral vision loss starting in childhood or early adulthood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fundus-examination",
        "description": "Characteristic fundus findings of chorioretinal atrophy with visible sclera and attenuated retinal vessels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the CHM gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroretinography",
        "description": "Reduced or extinguished rod and cone responses on ERG",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of typical clinical features plus either characteristic fundus findings or confirmed CHM gene mutation",
    "notes": "Genetic testing is confirmatory and essential for definitive diagnosis."
  },
