  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Wolfram syndrome",
    "criteria": [
      {
        "id": "early-onset-diabetes",
        "description": "Insulin-dependent diabetes mellitus diagnosed before age 15",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "optic-atrophy",
        "description": "Bilateral progressive optic nerve atrophy confirmed by ophthalmological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "diabetes-insipidus",
        "description": "Central diabetes insipidus confirmed by water deprivation test or vasopressin response",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss documented by audiometry",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic WFS1 gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of insulin-dependent diabetes mellitus and bilateral optic atrophy",
    "notes": "Additional features such as diabetes insipidus and sensorineural hearing loss support diagnosis; genetic testing confirms diagnosis."
  },
