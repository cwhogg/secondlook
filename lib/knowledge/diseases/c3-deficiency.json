  "diagnosticCriteria": {
    "formalCriteriaName": "Complement Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "low-c3-levels",
        "description": "Markedly decreased or undetectable serum C3 levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-pyogenic-infections",
        "description": "History of recurrent pyogenic bacterial infections, especially with encapsulated organisms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immune-complex-disease",
        "description": "Evidence of immune complex-mediated disease such as glomerulonephritis or vasculitis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-c4-levels",
        "description": "Normal or near-normal serum C4 levels distinguishing from classical pathway deficiencies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of markedly decreased serum C3 levels plus recurrent pyogenic infections",
    "notes": "Genetic testing for C3 gene mutations can confirm diagnosis"
  },
