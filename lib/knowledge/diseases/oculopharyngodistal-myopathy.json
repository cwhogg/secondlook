  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed OPDM Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-ophthalmopharyngeal-weakness",
        "description": "Presence of progressive external ophthalmoplegia and pharyngeal muscle weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distal-limb-weakness",
        "description": "Distal limb muscle weakness and atrophy predominantly affecting hands and feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy-rimmed-vacuoles",
        "description": "Muscle biopsy showing rimmed vacuoles and myopathic changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing-repeat-expansion",
        "description": "Identification of GGC repeat expansions in LRP12 or related genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (ophthalmopharyngeal weakness, distal limb weakness, and characteristic muscle biopsy findings) with or without supportive genetic or family history evidence",
    "notes": "Genetic testing is increasingly used to confirm diagnosis but is not mandatory if clinical and pathological features are definitive."
  },
