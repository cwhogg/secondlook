  "diagnosticCriteria": {
    "formalCriteriaName": "Jenni Echocardiographic Criteria",
    "criteria": [
      {
        "id": "trabeculation-ratio",
        "description": "Ratio of noncompacted to compacted myocardium > 2:1 at end-systole on echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "deep-intertrabecular-recesses",
        "description": "Presence of deep intertrabecular recesses filled with blood from the ventricular cavity demonstrated by color Doppler",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-cardiomyopathies",
        "description": "No coexisting congenital heart disease or other cardiomyopathies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Symptoms such as heart failure, arrhythmias, or thromboembolic events supportive but not required",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (trabeculation ratio > 2:1, deep intertrabecular recesses with blood flow, and exclusion of other cardiomyopathies) must be met",
    "notes": "Cardiac MRI criteria (Petersen criteria) may also be used for diagnosis"
  },
