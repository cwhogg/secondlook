  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Birk-Barel Syndrome",
    "criteria": [
      {
        "id": "hypotonia",
        "description": "Congenital severe hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Severe global developmental delay and intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including long eyelashes, arched eyebrows, and cleft or high-arched palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "kcnk9-mutation",
        "description": "Heterozygous pathogenic variant in the maternally expressed KCNK9 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "feeding-difficulties",
        "description": "Feeding difficulties in infancy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sleep-disturbances",
        "description": "Sleep apnea or other sleep disturbances",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital hypotonia, severe developmental delay, characteristic facial dysmorphism, and confirmation of a pathogenic KCNK9 mutation",
    "notes": "Diagnosis is confirmed by molecular genetic testing identifying a pathogenic variant in the maternally inherited KCNK9 gene."
  },
