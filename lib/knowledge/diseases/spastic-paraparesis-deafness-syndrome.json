  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of metabolic causes of spasticity and hearing loss"
    ],
    "imaging": [
      "MRI brain and spinal cord may show mild corticospinal tract degeneration",
      "No significant structural abnormalities"
    ],
    "genetic": [
      "Mutations in genes associated with hereditary spastic paraplegia (e.g., SPG genes) combined with deafness-related gene mutations"
    ],
    "other": [
      "Audiometry confirming bilateral sensorineural hearing loss",
      "Electromyography (EMG) usually normal or showing mild abnormalities"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hereditary-spastic-paraplegia",
