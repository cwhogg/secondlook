        "description": "MRI showing cerebral and cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electron-microscopy",
        "description": "Detection of characteristic curvilinear storage material in skin or conjunctival biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive neurological symptoms with confirmed TPP1 enzyme deficiency or biallelic pathogenic TPP1 variants",
