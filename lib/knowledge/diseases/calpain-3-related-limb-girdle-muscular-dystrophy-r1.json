  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for limb-girdle muscular dystrophies",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness predominantly affecting pelvic and shoulder girdles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic biallelic mutations in the CAPN3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes with reduced or absent calpain-3 protein expression",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "serum-creatine-kinase",
        "description": "Elevated serum creatine kinase (CK) levels, typically 5-10 times upper limit of normal",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive proximal muscle weakness plus genetic confirmation of CAPN3 mutations",
    "notes": "Muscle biopsy and CK levels support diagnosis but are not mandatory if genetic testing is conclusive."
  },
