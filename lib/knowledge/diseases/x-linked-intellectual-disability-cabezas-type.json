    "laboratory": [
      "Normal routine blood tests",
      "Possible mild elevation of liver enzymes in some cases"
    ],
    "imaging": [
      "Brain MRI may show nonspecific cerebral atrophy",
      "Skeletal X-rays may reveal scoliosis or other musculoskeletal abnormalities"
    ],
    "genetic": [
      "CUL4B (causative)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Electroencephalogram (EEG) abnormalities in patients with seizures"
    ]
  },
