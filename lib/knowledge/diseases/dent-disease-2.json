  "diagnosticCriteria": {
    "formalCriteriaName": "Dent Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "low-molecular-weight-proteinuria",
        "description": "Presence of low-molecular-weight proteinuria confirmed by urine protein electrophoresis or immunoassay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypercalciuria",
        "description": "Elevated urinary calcium excretion above age-adjusted normal limits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "CLCN5-negative-genetic-testing",
        "description": "Absence of pathogenic variants in CLCN5 gene with identification of pathogenic variants in OCRL gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-renal-failure",
        "description": "Evidence of progressive decline in renal function leading to chronic kidney disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history consistent with X-linked inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of low-molecular-weight proteinuria and hypercalciuria plus identification of pathogenic OCRL gene mutation or exclusion of CLCN5 mutation",
    "notes": "Genetic testing is essential to distinguish Dent Disease 2 from Dent Disease 1."
  },
