        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-iris-diseases",
        "description": "Exclusion of other causes of iris depigmentation such as herpetic iridocyclitis or Fuchs heterochromic iridocyclitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met with exclusion of other iris depigmentation causes",
