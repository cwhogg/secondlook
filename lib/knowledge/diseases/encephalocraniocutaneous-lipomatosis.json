  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "MRI showing unilateral cerebral malformations including porencephalic cysts, cortical dysplasia, arachnoid cysts",
      "CT scan demonstrating cranial bone defects and lipomatous masses"
    ],
    "genetic": [
      "FGFR1 (somatic)",
      "KRAS (candidate)"
    ],
    "other": [
      "Histopathology of nevus psiloliparus showing lipomatous infiltration of the dermis",
      "Ophthalmological exam revealing epibulbar dermoids or choristomas"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sebaceous-nevus-syndrome",
      "distinguishingFeatures": [
        "Presence of sebaceous nevi rather than lipomatous scalp lesions",
        "More frequent systemic involvement including skeletal and neurological abnormalities"
      ]
    },
    {
      "diseaseId": "proteus-syndrome",
      "distinguishingFeatures": [
        "Progressive asymmetric overgrowth of multiple tissues",
        "Presence of cerebriform connective tissue nevi rather than nevus psiloliparus"
      ]
    }
  ],
  "redFlags": [
    "Early onset seizures refractory to treatment",
    "Rapid neurological deterioration or increasing hemiparesis",
    "Signs of increased intracranial pressure such as vomiting or bulging fontanelle"
  ],
