  "diagnosticCriteria": {
    "formalCriteriaName": "Phenobarbital Embryopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including broad nasal bridge, short nose, and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Presence of distal digital hypoplasia or hypoplastic nails",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Intrauterine growth retardation or postnatal growth deficiency",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "maternal-phenobarbital-exposure",
        "description": "Confirmed maternal phenobarbital use during pregnancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-anomalies",
        "description": "Presence of congenital heart defects such as ventricular septal defect",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of maternal phenobarbital exposure plus at least two major criteria including characteristic facial dysmorphism and limb malformations",
    "notes": "Diagnosis is clinical and supported by maternal drug history; genetic testing is not diagnostic."
  },
