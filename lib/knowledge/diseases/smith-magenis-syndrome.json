  "diagnosticCriteria": {
    "formalCriteriaName": "Smith-Magenis Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of deletion or mutation involving chromosome 17p11.2 confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sleep-disturbance",
        "description": "Characteristic sleep disturbances including inverted melatonin secretion and sleep-wake cycle abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-features",
        "description": "Distinctive behavioral phenotype including self-injurious behaviors, stereotypies, and attention deficits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive craniofacial features such as broad square-shaped face, midface hypoplasia, and prognathism",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular genetic confirmation of 17p11.2 deletion or mutation plus presence of characteristic sleep disturbance and behavioral phenotype",
    "notes": "Diagnosis is primarily confirmed by genetic testing; clinical features support diagnosis and guide management."
  },
