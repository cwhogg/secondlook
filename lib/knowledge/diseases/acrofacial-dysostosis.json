        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-loss",
        "description": "Conductive or sensorineural hearing loss documented by audiological evaluation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with acrofacial dysostosis (e.g., EFTUD2, SF3B4)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both craniofacial malformations and limb anomalies is required; genetic confirmation supports diagnosis but is not mandatory.",
