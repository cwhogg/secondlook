  "diagnosticCriteria": {
    "formalCriteriaName": "Bernard-Soulier Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "giant-platelets",
        "description": "Presence of abnormally large platelets on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thrombocytopenia",
        "description": "Moderate thrombocytopenia (platelet count typically 20,000-100,000/µL)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "deficient-gpib-ix-v",
        "description": "Deficiency or dysfunction of glycoprotein Ib-IX-V complex demonstrated by flow cytometry or immunoassay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bleeding-history",
        "description": "Clinical history of mucocutaneous bleeding including epistaxis, menorrhagia, or easy bruising",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ristocetin-induced-aggregation",
        "description": "Absent or severely reduced platelet agglutination with ristocetin in platelet function testing",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of thrombocytopenia with giant platelets and deficient glycoprotein Ib-IX-V complex confirmed by laboratory testing",
    "notes": "Genetic testing for mutations in GP1BA, GP1BB, or GP9 genes can confirm diagnosis"
  },
  "symptoms": {
    "pathognomonic": [
