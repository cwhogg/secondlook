  "diagnosticCriteria": {
    "formalCriteriaName": "Herrmann-Opitz Craniosynostosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of one or more cranial sutures confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism, midface hypoplasia, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-anomalies",
        "description": "Presence of limb abnormalities such as syndactyly or brachydactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis plus characteristic facial dysmorphism",
    "notes": "Genetic testing may support diagnosis but is not always definitive."
  },
