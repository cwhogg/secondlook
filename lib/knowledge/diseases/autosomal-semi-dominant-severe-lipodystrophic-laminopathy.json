        "requiredForDiagnosis": true
      },
      {
        "id": "generalized-lipodystrophy",
        "description": "Severe loss of subcutaneous adipose tissue affecting trunk and limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-complications",
        "description": "Presence of insulin resistance, diabetes mellitus, or dyslipidemia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscular-weakness",
        "description": "Progressive proximal muscle weakness and wasting",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-involvement",
        "description": "Cardiomyopathy or conduction defects documented by ECG or imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic LMNA mutation plus clinical evidence of severe generalized lipodystrophy",
    "notes": "Diagnosis is supported by metabolic and cardiac manifestations but primarily relies on genetic and phenotypic findings."
  },
