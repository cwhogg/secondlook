  "diagnosticCriteria": {
    "formalCriteriaName": "Netchine-Harbison Clinical Scoring System (NH-CSS)",
    "criteria": [
      {
        "id": "prenatal-growth-retardation",
        "description": "Prenatal growth retardation (birth weight and/or length ≤ -2 SDS for gestational age)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "postnatal-growth-retardation",
        "description": "Postnatal growth retardation (height ≤ -2 SDS by 24 months of age)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "relative-macrocephaly",
        "description": "Relative macrocephaly at birth (head circumference ≥ 1.5 SDS above birth weight and/or length SDS)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "body-hemihypoplasia",
        "description": "Body asymmetry or hemihypoplasia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "feeding-difficulties",
        "description": "Feeding difficulties and/or low BMI (≤ -2 SDS) at 24 months",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "protruding-forehead",
        "description": "Prominent forehead (especially in early childhood)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "At least 4 of 6 NH-CSS criteria including both prenatal and postnatal growth retardation",
    "notes": "Molecular confirmation supports diagnosis but is not mandatory; clinical scoring is primary diagnostic tool."
  },
