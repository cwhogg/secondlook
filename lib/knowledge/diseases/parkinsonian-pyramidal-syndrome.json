  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Parkinsonian-Pyramidal Syndrome",
    "criteria": [
      {
        "id": "parkinsonism",
        "description": "Presence of bradykinesia with rigidity and/or resting tremor",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pyramidal-signs",
        "description": "Presence of pyramidal tract signs such as spasticity, hyperreflexia, and extensor plantar responses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-course",
        "description": "Progressive neurological deterioration over months to years",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of secondary causes of parkinsonism and pyramidal signs by imaging and laboratory tests",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of similar neurological disorder (optional supportive)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both parkinsonism and pyramidal signs with a progressive course, after exclusion of other causes",
    "notes": "Diagnosis is clinical and supported by neuroimaging and genetic testing when available."
  },
