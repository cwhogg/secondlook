  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Ectopic ACTH Syndrome",
    "criteria": [
      {
        "id": "hypercorisolism",
        "description": "Biochemical evidence of hypercortisolism (elevated 24-hour urinary free cortisol or elevated late-night salivary cortisol)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-acth",
        "description": "Elevated plasma ACTH levels inconsistent with pituitary source",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-tumor",
        "description": "Identification of ectopic ACTH-secreting tumor by imaging (CT, MRI, PET)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "high-dose-dexamethasone-test",
        "description": "Lack of suppression of cortisol after high-dose dexamethasone test",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "inferior-petrosal-sinus-sampling",
        "description": "Inferior petrosal sinus sampling showing no central-to-peripheral ACTH gradient",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biochemical evidence of hypercortisolism plus elevated plasma ACTH levels with exclusion of pituitary source",
    "notes": "Diagnosis often requires combination of biochemical tests and imaging studies to localize ectopic source."
  },
