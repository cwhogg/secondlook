  "diagnosticCriteria": {
    "formalCriteriaName": "Phosphorylase Kinase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced phosphorylase kinase enzyme activity in liver biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Hepatomegaly with fasting hypoglycemia and elevated liver transaminases",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in PHKA2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glycogen-accumulation",
        "description": "Histological evidence of glycogen accumulation in liver tissue",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced liver phosphorylase kinase activity plus clinical features consistent with glycogen storage disease and confirmation by genetic testing",
    "notes": "Liver biopsy is often required for enzymatic confirmation; genetic testing is confirmatory."
  },
