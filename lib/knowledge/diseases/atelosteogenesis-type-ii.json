  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and radiological diagnostic criteria for Atelosteogenesis type II",
    "criteria": [
      {
        "id": "skeletal-dysplasia",
        "description": "Severe generalized skeletal dysplasia with absent or severely hypoplastic long bone ossification",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia, micrognathia, and cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the SLC26A2 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiological-findings",
        "description": "Radiographic evidence of platyspondyly, metaphyseal abnormalities, and absent ossification of distal limb bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "respiratory-distress",
        "description": "Respiratory insufficiency due to thoracic hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe skeletal dysplasia with characteristic radiological findings and facial dysmorphism; genetic confirmation supports diagnosis",
    "notes": "Diagnosis is primarily clinical and radiological; genetic testing confirms but is not always available."
  },
