  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for Xeroderma Pigmentosum Variant",
    "criteria": [
      {
        "id": "uv-sensitivity",
        "description": "Marked photosensitivity with severe sunburn after minimal UV exposure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "frequent-skin-cancers",
        "description": "Early onset of multiple cutaneous malignancies including basal cell carcinoma, squamous cell carcinoma, and melanoma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pol-eta-mutation",
        "description": "Identification of pathogenic mutations in the POLH gene encoding DNA polymerase eta",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-uv-dna-repair",
        "description": "Normal nucleotide excision repair but defective translesion synthesis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-sparing",
        "description": "Absence of progressive neurodegeneration typical of other XP complementation groups",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of photosensitivity and early skin cancers plus confirmed POLH gene mutation",
    "notes": "Molecular genetic testing is essential to differentiate XP variant from other XP complementation groups."
  },
