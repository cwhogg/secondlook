  "diagnosticCriteria": {
    "formalCriteriaName": "Mandibuloacral Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "mandibular-hypoplasia",
        "description": "Mandibular hypoplasia with micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acro-osteolysis",
        "description": "Acro-osteolysis of distal phalanges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-lipodystrophy",
        "description": "Progressive cutaneous lipodystrophy affecting extremities and face",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clavicular-hypoplasia",
        "description": "Hypoplasia or dysplasia of clavicles",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation and short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skin-pigmentation",
        "description": "Mottled or reticular skin pigmentation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: mandibular hypoplasia, acro-osteolysis, and cutaneous lipodystrophy",
    "notes": "Genetic testing for LMNA or ZMPSTE24 mutations supports diagnosis"
  },
