  "diagnosticCriteria": {
    "formalCriteriaName": "Hemoglobin C Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "homozygous-hb-c",
        "description": "Presence of homozygous hemoglobin C confirmed by hemoglobin electrophoresis or HPLC",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mild-hemolytic-anemia",
        "description": "Evidence of mild hemolytic anemia with reticulocytosis and mild anemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "splenomegaly",
        "description": "Clinical or imaging evidence of splenomegaly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-sickle-cells",
        "description": "Absence of sickle cells differentiating from sickle cell disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Homozygous hemoglobin C confirmed plus evidence of mild hemolytic anemia",
    "notes": "Diagnosis requires exclusion of other hemoglobinopathies such as sickle cell disease."
  },
