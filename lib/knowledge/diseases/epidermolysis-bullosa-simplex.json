  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Epidermolysis Bullosa Simplex",
    "criteria": [
      {
        "id": "clinical-blistering",
        "description": "Recurrent skin blistering localized to areas of mechanical trauma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Intraepidermal cleavage within basal keratinocytes on skin biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in KRT5 or KRT14 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical blistering plus either histopathological confirmation or pathogenic genetic variant",
    "notes": "Genetic testing is confirmatory and helps subtype classification."
  },
