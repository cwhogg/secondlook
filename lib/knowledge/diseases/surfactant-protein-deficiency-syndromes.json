  "diagnosticCriteria": {
    "formalCriteriaName": "Surfactant Protein Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in surfactant protein genes (e.g., SFTPB, SFTPC, ABCA3)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Neonatal respiratory distress or chronic interstitial lung disease symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Lung biopsy showing abnormal surfactant metabolism or alveolar proteinosis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-findings",
        "description": "High-resolution CT showing ground-glass opacities and interstitial changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of infectious, cardiac, or other causes of respiratory distress",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic surfactant protein gene mutation plus compatible clinical presentation",
    "notes": "Lung biopsy is not always required if genetic testing confirms diagnosis."
  },
