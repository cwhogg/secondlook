  "diagnosticCriteria": {
    "formalCriteriaName": "LGL Leukemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "lymphocytosis",
        "description": "Persistent peripheral blood lymphocytosis with increased large granular lymphocytes (>0.5 x10^9/L) for more than 6 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neutropenia",
        "description": "Absolute neutrophil count less than 1.5 x10^9/L",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clonalTcellRearrangement",
        "description": "Demonstration of clonal T-cell receptor gene rearrangement by PCR or flow cytometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "boneMarrowInfiltration",
        "description": "Bone marrow infiltration by large granular lymphocytes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "autoimmuneFeatures",
        "description": "Presence of autoimmune phenomena such as rheumatoid arthritis or autoimmune cytopenias",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent large granular lymphocytosis with neutropenia and confirmation of clonal T-cell receptor rearrangement",
    "notes": "Diagnosis requires exclusion of reactive causes of lymphocytosis and neutropenia"
  },
