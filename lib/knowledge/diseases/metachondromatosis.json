  "diagnosticCriteria": {
    "formalCriteriaName": "Metachondromatosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "multiple-exostoses",
        "description": "Presence of multiple exostoses predominantly in the metaphyseal regions of long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enchondromas",
        "description": "Presence of enchondromas primarily in the hands and feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "PTHR1-mutation",
        "description": "Identification of heterozygous loss-of-function mutations in the PTPN11 gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both multiple exostoses and enchondromas with or without family history or genetic confirmation",
    "notes": "Genetic testing for PTPN11 mutations can support diagnosis but is not mandatory."
  },
