  "diagnosticCriteria": {
    "formalCriteriaName": "Adult Krabbe Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Reduced galactocerebrosidase (GALC) enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic GALC gene mutations consistent with adult-onset phenotype",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of progressive spastic paraparesis, peripheral neuropathy, and cognitive decline",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-mri",
        "description": "MRI showing characteristic white matter abnormalities including corticospinal tract involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-conduction",
        "description": "Electrophysiological evidence of demyelinating peripheral neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced GALC enzyme activity and pathogenic GALC mutations plus compatible clinical features",
    "notes": "Diagnosis requires integration of biochemical, genetic, and clinical findings; brain MRI and electrophysiology support diagnosis"
  },
