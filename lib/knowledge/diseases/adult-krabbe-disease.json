  "differentialDiagnoses": [
    {
      "diseaseId": "adult-metachromatic-leukodystrophy",
      "distinguishingFeatures": [
        "Arylsulfatase A deficiency instead of GALC deficiency",
        "MRI shows periventricular white matter changes with tigroid pattern",
        "Later onset of peripheral neuropathy"
      ]
    },
    {
      "diseaseId": "hereditary-spastic-paraplegia",
      "distinguishingFeatures": [
        "Purely spastic paraparesis without significant peripheral neuropathy",
        "No GALC enzyme deficiency",
        "MRI typically normal or shows mild corticospinal tract involvement"
      ]
    }
  ],
