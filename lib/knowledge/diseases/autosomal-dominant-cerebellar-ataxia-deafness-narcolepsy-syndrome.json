  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "CSF analysis typically unremarkable"
    ],
    "imaging": [
      "MRI showing cerebellar atrophy, especially in the vermis",
      "No significant brainstem or cortical abnormalities"
    ],
    "genetic": [
      "DNMT1 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Polysomnography demonstrating narcolepsy features including sleep-onset REM periods",
      "Audiometry confirming bilateral sensorineural hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "spinocerebellar-ataxia-type-3",
      "distinguishingFeatures": [
        "Autosomal dominant ataxia without prominent narcolepsy",
        "Different genetic mutation (ATXN3 gene)",
        "Variable presence of ophthalmoplegia and dystonia"
      ]
    },
    {
      "diseaseId": "narcolepsy-type-1",
      "distinguishingFeatures": [
        "Narcolepsy with cataplexy but absence of cerebellar ataxia and deafness",
        "HLA-DQB1*06:02 association",
        "No progressive hearing loss"
      ]
    },
    {
      "diseaseId": "mitochondrial-encephalopathy-with-lactic-acidosis-and-stroke-like-episodes",
      "distinguishingFeatures": [
        "Multisystem involvement with stroke-like episodes",
        "Lactic acidosis on laboratory testing",
        "Maternal inheritance pattern"
      ]
    }
  ],
