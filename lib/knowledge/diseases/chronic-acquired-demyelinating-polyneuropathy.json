        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiological-evidence",
        "description": "Electrophysiological evidence of demyelination including slowed conduction velocity, conduction block, or prolonged distal latencies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "csf-protein-elevation",
        "description": "Elevated cerebrospinal fluid protein concentration with normal cell count (albuminocytologic dissociation)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Nerve biopsy showing demyelination and remyelination with onion bulb formations",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-immunotherapy",
        "description": "Clinical improvement following immunomodulatory treatment",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive or relapsing motor and sensory neuropathy >8 weeks plus electrophysiological evidence of demyelination",
    "notes": "Diagnosis requires exclusion of other causes of neuropathy and supportive laboratory findings."
  },
