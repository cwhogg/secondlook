  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Familial Focal Epilepsy with Variable Foci",
    "criteria": [
      {
        "id": "family-history",
        "description": "Presence of at least two affected family members with focal epilepsy involving different cortical regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "variable-foci",
        "description": "Documentation of focal seizures arising from variable epileptogenic foci in affected individuals",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-structural-lesions",
        "description": "Neuroimaging excluding structural brain lesions as cause of epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with familial focal epilepsy (e.g., DEPDC5, NPRL2, NPRL3)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of familial focal epilepsy with documented variable seizure foci in at least two family members and exclusion of structural brain lesions",
    "notes": "Genetic testing can support diagnosis but is not mandatory; diagnosis relies on clinical and electrophysiological evidence."
  },
