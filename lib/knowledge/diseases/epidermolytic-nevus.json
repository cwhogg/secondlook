  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Diagnostic Criteria for Epidermolytic Nevus",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of verrucous, hyperkeratotic linear or blaschkoid skin lesions present at birth or early infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological evidence of epidermolytic hyperkeratosis with vacuolar degeneration of keratinocytes and coarse keratohyalin granules",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of somatic mutations in keratin genes KRT1 or KRT10 in lesional skin",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical lesions plus confirmatory histopathology",
    "notes": "Genetic testing can support diagnosis but is not mandatory."
  },
