  "diagnosticCriteria": {
    "formalCriteriaName": "Jones Criteria (2015 revision)",
    "criteria": [
      {
        "id": "carditis",
        "description": "Evidence of carditis (clinical and/or echocardiographic)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "polyarthritis",
        "description": "Migratory polyarthritis involving large joints",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "chorea",
        "description": "Sydenham chorea (involuntary movements)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "erythema-marginatum",
        "description": "Erythema marginatum rash",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "subcutaneous-nodules",
        "description": "Subcutaneous nodules over bony prominences",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "arthralgia",
        "description": "Polyarthralgia (joint pain without swelling)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "fever",
        "description": "Fever ≥38.5°C",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-acute-phase-reactants",
        "description": "Elevated ESR or CRP",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "prolonged-pr-interval",
        "description": "Prolonged PR interval on ECG",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "evidence-of-recent-streptococcal-infection",
        "description": "Positive throat culture or elevated streptococcal antibody titers",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of two major criteria or one major and two minor criteria plus evidence of recent streptococcal infection",
    "notes": "Diagnosis requires exclusion of other causes and clinical correlation."
  },
