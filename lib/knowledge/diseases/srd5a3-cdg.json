  "diagnosticCriteria": {
    "formalCriteriaName": "SRD5A3-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the SRD5A3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of congenital eye anomalies including early-onset retinal dystrophy or optic nerve hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-testing",
        "description": "Abnormal transferrin isoelectric focusing pattern consistent with a type I congenital disorder of glycosylation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-findings",
        "description": "Developmental delay and cerebellar ataxia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "skin-abnormalities",
        "description": "Cutaneous ichthyosis or dry skin",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic SRD5A3 variants plus either characteristic clinical features (ocular anomalies) or abnormal transferrin glycosylation profile",
    "notes": "Genetic testing is definitive; biochemical and clinical features support diagnosis."
  },
