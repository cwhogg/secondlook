  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Leptomeningeal enhancement on MRI with contrast",
      "Cerebral calcifications on CT scan (tram-track pattern)",
      "Cerebral hemiatrophy on MRI"
    ],
    "genetic": [
