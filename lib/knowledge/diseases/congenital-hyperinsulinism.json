  "keyFindings": {
    "laboratory": [
      "Low plasma glucose (<50 mg/dL) during symptomatic episodes",
      "Elevated plasma insulin during hypoglycemia",
      "Low plasma ketone bodies and free fatty acids during hypoglycemia",
      "Positive glycemic response to glucagon injection"
    ],
    "imaging": [
      "18F-DOPA PET scan showing focal or diffuse pancreatic lesions",
      "Pancreatic ultrasound may show hypertrophy"
    ],
    "genetic": [
      "Mutations in ABCC8 gene",
      "Mutations in KCNJ11 gene",
      "Mutations in GLUD1, GCK, HADH, HNF4A, or UCP2 genes"
    ],
    "other": [
      "Histopathology showing focal or diffuse islet cell hyperplasia",
      "Response to diazoxide therapy varies by genetic subtype"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "neonatal-adrenal-insufficiency",
