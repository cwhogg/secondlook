  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Lysinuric Protein Intolerance",
    "criteria": [
      {
        "id": "aminoaciduria",
        "description": "Presence of dibasic aminoaciduria with increased urinary excretion of lysine, arginine, and ornithine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Symptoms of protein intolerance including vomiting, failure to thrive, and hepatosplenomegaly after protein-rich meals",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the SLC7A7 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyperammonemia",
        "description": "Episodes of hyperammonemia during metabolic decompensation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "low-plasma-aminoacids",
        "description": "Low plasma levels of lysine, arginine, and ornithine",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of dibasic aminoaciduria plus clinical symptoms consistent with protein intolerance and confirmation by genetic testing",
    "notes": "Diagnosis is confirmed by biochemical and molecular genetic testing; early diagnosis is critical to prevent metabolic crises."
  },
