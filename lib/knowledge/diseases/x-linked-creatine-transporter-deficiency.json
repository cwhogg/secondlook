  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for X-linked Creatine Transporter Deficiency",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of global developmental delay or intellectual disability, especially in males",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-testing",
        "description": "Reduced creatine peak on brain proton magnetic resonance spectroscopy (1H-MRS)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Pathogenic variant in the SLC6A8 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-creatine-excretion",
        "description": "Elevated urinary creatine/creatinine ratio",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history consistent with X-linked inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of global developmental delay or intellectual disability plus reduced brain creatine peak on 1H-MRS and confirmation of pathogenic SLC6A8 variant",
    "notes": "Diagnosis requires integration of clinical, biochemical, and genetic data."
  },
