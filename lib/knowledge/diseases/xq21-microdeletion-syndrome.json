  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for Xq21 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "microdeletion-confirmation",
        "description": "Detection of a microdeletion involving the Xq21 region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss documented by audiometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Presence of moderate to severe intellectual disability confirmed by neuropsychological testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "choroideremia",
        "description": "Progressive chorioretinal degeneration confirmed by ophthalmological examination",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including broad nasal bridge and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of confirmed Xq21 microdeletion plus at least two major clinical features including sensorineural hearing loss and intellectual disability",
    "notes": "Diagnosis requires molecular confirmation; clinical features may vary depending on deletion size."
  },
