  "diagnosticCriteria": {
    "formalCriteriaName": "Farber Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "acid-ceramidase-deficiency",
        "description": "Demonstration of acid ceramidase enzyme deficiency in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-triad",
        "description": "Presence of the clinical triad: painful progressive joint deformities, subcutaneous nodules, and hoarseness of voice",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology-lipogranulomas",
        "description": "Histopathological identification of lipogranulomas in affected tissues",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in ASAH1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acid ceramidase deficiency plus clinical triad or histopathological confirmation",
    "notes": "Genetic testing supports diagnosis but is not mandatory if enzyme assay and clinical features are definitive."
  },
