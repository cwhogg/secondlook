  "differentialDiagnoses": [
    {
      "diseaseId": "hutchinson-gilford-progeria-syndrome",
      "distinguishingFeatures": [
        "Typically caused by LMNA mutation c.1824C>T (p.G608G) leading to progerin accumulation",
        "More severe growth failure and earlier mortality",
        "Lack of prominent cardiomyopathy seen in LMNA-related cardiocutaneous progeria syndrome"
      ]
    },
    {
      "diseaseId": "mandibuloacral-dysplasia",
      "distinguishingFeatures": [
        "Presence of skeletal abnormalities including clavicular hypoplasia",
        "Lipodystrophy and metabolic complications",
        "Different LMNA mutations and less prominent cardiomyopathy"
      ]
    }
  ],
