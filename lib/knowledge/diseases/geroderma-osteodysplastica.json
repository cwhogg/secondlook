  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Geroderma Osteodysplastica",
    "criteria": [
      {
        "id": "cutis-laxa",
        "description": "Marked premature skin aging with lax, wrinkled skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "osteopenia-bone-fractures",
        "description": "Generalized osteopenia with frequent bone fractures and deformities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facies",
        "description": "Characteristic facial features including a triangular face and prominent eyes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiological-findings",
        "description": "Radiological evidence of metaphyseal abnormalities and wormian bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in the GORAB gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of major criteria including cutis laxa, osteopenia with fractures, and characteristic radiological findings",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical and radiological criteria are met."
  },
