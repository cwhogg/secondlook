  "diagnosticCriteria": {
    "formalCriteriaName": "PAPA Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "pyogenic-arthritis",
        "description": "Recurrent sterile pyogenic arthritis episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pyoderma-gangrenosum",
        "description": "Presence of pyoderma gangrenosum skin lesions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-acne",
        "description": "Severe cystic acne typically developing in adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pstpip1-mutation",
        "description": "Identification of pathogenic PSTPIP1 gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent sterile pyogenic arthritis plus either pyoderma gangrenosum or severe cystic acne, supported by genetic testing if available",
    "notes": "Genetic confirmation via PSTPIP1 mutation analysis strongly supports diagnosis but is not mandatory if clinical features are classic."
  },
