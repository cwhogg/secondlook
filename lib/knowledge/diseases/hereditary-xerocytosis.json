  "diagnosticCriteria": {
    "formalCriteriaName": "Hereditary Xerocytosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "dehydrated-erythrocytes",
        "description": "Presence of dehydrated erythrocytes with decreased osmotic fragility",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chronic-hemolytic-anemia",
        "description": "Chronic hemolytic anemia with reticulocytosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-rbc-membrane-permeability",
        "description": "Abnormal red blood cell membrane permeability to potassium and sodium ions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in PIEZO1 or KCNN4 genes",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of dehydrated erythrocytes with chronic hemolytic anemia plus either abnormal RBC membrane permeability or genetic confirmation",
    "notes": "Diagnosis is supported by family history and exclusion of other hemolytic anemias"
  },
