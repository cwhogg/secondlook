  "diagnosticCriteria": {
    "formalCriteriaName": "American College of Rheumatology 1990 Criteria for Polyarteritis Nodosa",
    "criteria": [
      {
        "id": "weight-loss",
        "description": "Unexplained weight loss greater than 4 kg",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "livedo-reticularis",
        "description": "Livedo reticularis or other skin manifestations",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "testicular-pain",
        "description": "Testicular pain or tenderness",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuropathy",
        "description": "Mononeuropathy or polyneuropathy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "angiographic-abnormalities",
        "description": "Arteriographic abnormalities not due to atherosclerosis or fibromuscular dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biopsy-vasculitis",
        "description": "Biopsy of small or medium artery containing polymorphonuclear cells",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "At least 3 of the criteria including either biopsy evidence or angiographic abnormalities",
    "notes": "Diagnosis often requires exclusion of other vasculitides and infectious causes."
  },
