    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "marfan-syndrome",
      "distinguishingFeatures": [
        "Normal homocysteine levels",
        "Aortic root dilatation more prominent",
        "No thromboembolic tendency"
      ]
    },
    {
      "diseaseId": "methylmalonic-acidemia",
      "distinguishingFeatures": [
        "Metabolic acidosis with elevated methylmalonic acid",
        "Different enzymatic defect",
        "No ectopia lentis"
      ]
    },
    {
      "diseaseId": "other-causes-of-hyperhomocysteinemia",
      "distinguishingFeatures": [
        "Vitamin B12 or folate deficiency",
        "No CBS gene mutations",
        "Reversible with vitamin supplementation"
      ]
    }
  ],
