      "Posterior embryotoxon on slit-lamp examination"
    ],
    "genetic": [
      "Pathogenic variants in JAG1 gene (~90% of cases)",
      "Pathogenic variants in NOTCH2 gene (~1-2% of cases)"
    ],
    "other": [
      "Liver biopsy showing bile duct paucity",
      "Characteristic facial features on clinical examination"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "biliary-atresia",
      "distinguishingFeatures": [
        "Absence of bile ducts rather than paucity",
        "No characteristic facial features",
        "No associated cardiac or skeletal anomalies"
      ]
    },
    {
      "diseaseId": "caroli-disease",
      "distinguishingFeatures": [
        "Dilatation of intrahepatic bile ducts",
        "No multisystem involvement",
        "No characteristic facial features"
      ]
    },
    {
      "diseaseId": "progressive familial intrahepatic cholestasis",
      "distinguishingFeatures": [
        "Early onset cholestasis without cardiac or skeletal defects",
        "No facial dysmorphism",
        "Different genetic mutations"
      ]
    }
  ],
  "redFlags": [
    "Severe cholestasis with pruritus and failure to thrive",
    "Congenital heart defects causing cyanosis or heart failure",
    "Progressive liver dysfunction leading to cirrhosis"
  ],
