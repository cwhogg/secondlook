  "keyFindings": {
    "laboratory": [
      "Elevated white blood cell count with left shift",
      "Elevated liver transaminases",
      "Elevated creatinine and blood urea nitrogen",
      "Thrombocytopenia",
      "Positive blood cultures for Staphylococcus aureus or Streptococcus pyogenes"
    ],
    "imaging": [
      "Chest X-ray may show pulmonary edema or ARDS",
      "Ultrasound or CT to identify source of infection"
    ],
    "genetic": [
      "No specific genetic markers; susceptibility may be influenced by host immune response genes"
    ],
    "other": [
      "Detection of bacterial superantigens (toxic shock syndrome toxin-1 or streptococcal pyrogenic exotoxins) in some cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "staphylococcal-scalded-skin-syndrome",
      "distinguishingFeatures": [
        "Absence of hypotension",
        "Skin peeling without systemic multi-organ involvement",
        "More common in neonates and young children"
      ]
    },
    {
      "diseaseId": "septic-shock",
      "distinguishingFeatures": [
        "Positive blood cultures with other pathogens",
        "Lack of characteristic diffuse erythroderma rash",
        "More gradual onset of symptoms"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset of hypotension and shock",
    "Multi-organ failure",
    "Diffuse erythroderma with desquamation"
  ],
