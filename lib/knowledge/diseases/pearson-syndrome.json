  "keyFindings": {
    "laboratory": [
      "Bone marrow biopsy showing ring sideroblasts",
      "Elevated blood lactate and pyruvate",
      "Pancytopenia with neutropenia and thrombocytopenia",
      "Elevated serum pancreatic enzymes or evidence of malabsorption"
    ],
    "imaging": [
      "Pancreatic atrophy or fibrosis on abdominal ultrasound or MRI",
      "Cardiac echocardiogram showing cardiomyopathy"
    ],
    "genetic": [
      "Single large-scale mitochondrial DNA deletion detected by Southern blot or PCR-based methods"
    ],
    "other": [
      "Evidence of exocrine pancreatic insufficiency via fecal elastase testing",
      "Renal tubular acidosis or Fanconi syndrome features"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "kearns-sayre-syndrome",
      "distinguishingFeatures": [
        "Onset after first decade of life",
        "Progressive external ophthalmoplegia",
        "Retinitis pigmentosa",
        "Less prominent sideroblastic anemia"
      ]
    },
    {
      "diseaseId": "congenital-sideroblastic-anemia",
      "distinguishingFeatures": [
        "No mitochondrial DNA deletion",
        "Usually inherited in X-linked or autosomal recessive pattern",
        "Lack of pancreatic dysfunction"
      ]
    },
    {
      "diseaseId": "mitochondrial-depletion-syndromes",
      "distinguishingFeatures": [
        "Multiple mtDNA copy number reductions rather than deletions",
        "Predominantly neurological and myopathic features",
        "Absence of sideroblastic anemia"
      ]
    }
  ],
