  "diagnosticCriteria": {
    "formalCriteriaName": "HIDS Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-igg-d",
        "description": "Elevated serum immunoglobulin D (IgD) levels above 100 IU/mL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-fever-attacks",
        "description": "Recurrent febrile episodes lasting 3-7 days with symptom-free intervals",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mevalonate-kinase-gene-mutation",
        "description": "Identification of pathogenic mutations in the MVK gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-inflammatory-markers",
        "description": "Elevated acute phase reactants (CRP, ESR) during febrile attacks",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of associated symptoms such as lymphadenopathy, abdominal pain, arthralgia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent febrile attacks plus elevated IgD or MVK gene mutation confirmation",
    "notes": "IgD levels may be normal in some patients; genetic testing is definitive."
  },
