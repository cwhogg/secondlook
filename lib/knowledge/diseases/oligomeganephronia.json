  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological and clinical diagnostic criteria for oligomeganephronia",
    "criteria": [
      {
        "id": "reduced-nephron-number",
        "description": "Markedly reduced number of nephrons on renal biopsy or autopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glomerular-hypertrophy",
        "description": "Enlarged glomeruli (glomerulomegaly) observed histologically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive renal insufficiency presenting in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Small kidneys with reduced cortical thickness on renal ultrasound or MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-renal-dysplasia",
        "description": "Exclusion of other causes of renal hypoplasia or dysplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced nephron number and glomerular hypertrophy on biopsy combined with clinical evidence of progressive renal insufficiency in infancy or early childhood",
    "notes": "Diagnosis is confirmed by histopathological examination; genetic testing may be helpful in some cases."
  },
