  "differentialDiagnoses": [
    {
      "diseaseId": "vacterl-association",
      "distinguishingFeatures": [
        "Presence of vertebral anomalies, cardiac defects, tracheoesophageal fistula, renal anomalies, and limb abnormalities without characteristic ear or thumb malformations",
        "No SALL1 mutations"
      ]
    },
    {
      "diseaseId": "goldenhar-syndrome",
      "distinguishingFeatures": [
        "Unilateral facial microsomia and ear anomalies without anal malformations or triphalangeal thumbs",
        "Different pattern of craniofacial anomalies"
      ]
    }
  ],
