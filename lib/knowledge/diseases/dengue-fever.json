  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Dengue Case Classification",
    "criteria": [
      {
        "id": "fever",
        "description": "Acute febrile illness lasting 2-7 days",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemorrhagicManifestations",
        "description": "Presence of hemorrhagic signs such as petechiae, mucosal bleeding, or positive tourniquet test",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "thrombocytopenia",
        "description": "Platelet count less than 100,000/mm³",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "leukopenia",
        "description": "White blood cell count below normal range",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "positiveSerology",
        "description": "Detection of dengue virus antigen or IgM antibodies",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Acute febrile illness plus positive serology or detection of dengue virus, with or without thrombocytopenia or hemorrhagic manifestations",
    "notes": "Diagnosis is supported by epidemiological context and exclusion of other febrile illnesses"
  },
