    "formalCriteriaName": "Clinical Diagnostic Criteria for Familial Paroxysmal Ataxia",
    "criteria": [
      {
        "id": "episodic-ataxia",
        "description": "Recurrent episodes of cerebellar ataxia with sudden onset and spontaneous resolution",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of episodic ataxia by clinical, laboratory, and imaging studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "interictal-neurological-normal",
        "description": "Normal neurological examination between episodes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-acetazolamide",
        "description": "Improvement of symptoms with acetazolamide treatment",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent episodic ataxia with positive family history and exclusion of other causes",
    "notes": "Genetic testing may support diagnosis but is not always definitive."
  },
