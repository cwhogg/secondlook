  "diagnosticCriteria": {
    "criteria": [
      {
        "id": "aa-maj1",
        "description": "Tissue biopsy positive for amyloid (Congo red staining with apple-green birefringence under polarized light)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aa-maj2",
        "description": "Amyloid typing confirming AA protein (immunohistochemistry, mass spectrometry, or immunoelectron microscopy)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aa-min1",
        "description": "Underlying chronic inflammatory condition (RA, IBD, chronic infections, FMF, etc.)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "aa-min2",
        "description": "Elevated serum amyloid A (SAA) levels",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "aa-sup1",
        "description": "Proteinuria/nephrotic syndrome as presenting feature",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Tissue biopsy showing Congo red positive amyloid deposits with AA protein confirmation by typing. Underlying inflammatory condition present in most but not all cases.",
    "notes": "Most common form of systemic amyloidosis worldwide, though AL amyloidosis is more common in Western countries. Kidney is the most commonly affected organ."
  },
