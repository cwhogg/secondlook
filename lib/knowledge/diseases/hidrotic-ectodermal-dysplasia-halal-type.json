  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Hidrotic Ectodermal Dysplasia",
    "criteria": [
      {
        "id": "nail-dystrophy",
        "description": "Presence of nail dystrophy including thickened, brittle, or absent nails",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "palmoplantar-keratoderma",
        "description": "Diffuse palmoplantar keratoderma with hyperkeratosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alopecia",
        "description": "Partial to total alopecia affecting scalp and eyebrows",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in GJB6 gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical features (nail dystrophy, palmoplantar keratoderma, and alopecia) or identification of pathogenic GJB6 mutation",
    "notes": "Genetic testing can confirm diagnosis but clinical features are primary for diagnosis."
  },
