  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for 8p23.1 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "molecular-confirmation",
        "description": "Detection of heterozygous microdeletion at chromosome 8p23.1 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defect",
        "description": "Presence of congenital heart defects, especially atrioventricular septal defects or ventricular septal defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including micrognathia, hypertelorism, and broad nasal bridge",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of 8p23.1 microdeletion plus presence of at least two major clinical features including congenital heart defect and developmental delay",
    "notes": "Diagnosis relies heavily on molecular genetic testing due to phenotypic variability."
  },
