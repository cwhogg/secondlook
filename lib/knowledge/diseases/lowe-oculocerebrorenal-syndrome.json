  "keyFindings": {
    "laboratory": [
      "Elevated urinary amino acids, glucose, phosphate, and bicarbonate indicating proximal renal tubular dysfunction",
      "Hypophosphatemia and metabolic acidosis"
    ],
    "imaging": [
      "Brain MRI may show cerebral atrophy or delayed myelination",
      "Renal ultrasound may show nephrocalcinosis"
    ],
    "genetic": [
      "Pathogenic variants in the OCRL gene on Xq25-q26"
    ],
    "other": [
      "Slit-lamp examination confirming congenital cataracts",
      "Electroretinogram abnormalities"
    ]
