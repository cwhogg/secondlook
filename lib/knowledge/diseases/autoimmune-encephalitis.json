  "diagnosticCriteria": {
    "formalCriteriaName": "Graus et al. 2016 Clinical Approach to Diagnosis of Autoimmune Encephalitis",
    "criteria": [
      {
        "id": "ae-1",
        "description": "Subacute onset (rapid progression over <3 months) of working memory deficits, altered mental status, or psychiatric symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ae-2",
        "description": "At least one of: new focal CNS findings, seizures, CSF pleocytosis, MRI features suggestive of encephalitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ae-3",
        "description": "Reasonable exclusion of alternative causes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ae-4",
        "description": "Specific neural antibody detected (NMDA-R, LGI1, CASPR2, AMPA-R, GABA-B-R, etc.)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ae-5",
        "description": "Response to immunotherapy trial",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Subacute onset of cognitive/psychiatric symptoms with at least one supportive feature (seizures, CSF pleocytosis, MRI changes, focal findings) and exclusion of alternative causes. Specific antibody detection provides definite diagnosis.",
    "notes": "Major subtypes: anti-NMDAR (most common, young women, ovarian teratoma), anti-LGI1 (older men, faciobrachial dystonic seizures, hyponatremia), anti-CASPR2 (Morvan syndrome, neuromyotonia), anti-GABA-B (seizures, limbic encephalitis). Seronegative AE exists."
  },
