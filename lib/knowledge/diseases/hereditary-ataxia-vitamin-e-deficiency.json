  "differentialDiagnoses": [
    {
      "diseaseId": "friedreich-ataxia",
      "distinguishingFeatures": [
        "Onset usually before age 25",
        "Cardiomyopathy more common",
        "GAA trinucleotide repeat expansion in FXN gene",
        "Vitamin E levels normal"
      ]
    },
    {
      "diseaseId": "abetalipoproteinemia",
      "distinguishingFeatures": [
        "Malabsorption and steatorrhea present",
        "Acanthocytosis on blood smear",
        "Mutations in MTTP gene",
        "Low cholesterol and triglycerides"
      ]
    }
  ],
