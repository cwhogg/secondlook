  "diagnosticCriteria": {
    "formalCriteriaName": "AVED Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with gait disturbance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-vitamin-e",
        "description": "Markedly reduced serum vitamin E levels in absence of fat malabsorption",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tTPA-gene-mutation",
        "description": "Biallelic pathogenic variants in the TTPA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electrophysiology",
        "description": "Peripheral neuropathy demonstrated by nerve conduction studies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia, low serum vitamin E without malabsorption, and biallelic TTPA mutations",
    "notes": "Early diagnosis is critical as vitamin E supplementation can halt progression"
  },
