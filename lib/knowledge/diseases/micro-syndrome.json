  "diagnosticCriteria": {
    "formalCriteriaName": "Micro syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Severe congenital microcephaly with simplified gyral pattern",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microphthalmia",
        "description": "Bilateral microphthalmia or small eyes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogenitalism",
        "description": "Hypoplastic genitalia in males or hypoplastic labia in females",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Severe intellectual disability and global developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "corpus-callosum-hypoplasia",
        "description": "Hypoplasia or agenesis of the corpus callosum on brain imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: severe congenital microcephaly, bilateral microphthalmia, and hypogenitalism, plus severe developmental delay",
    "notes": "Genetic confirmation of mutations in the RAB18 gene supports diagnosis"
  },
