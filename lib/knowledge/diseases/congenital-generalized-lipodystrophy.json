  ],
  "keyFindings": {
    "laboratory": [
      "Marked hypertriglyceridemia (>500 mg/dL)",
      "Elevated fasting insulin levels",
      "Hyperglycemia consistent with diabetes mellitus",
      "Elevated liver enzymes (ALT, AST)"
    ],
    "imaging": [
      "Ultrasound or MRI showing near absence of subcutaneous fat",
      "Hepatomegaly with fatty infiltration on abdominal ultrasound",
      "Echocardiogram showing cardiomyopathy in some cases"
    ],
    "genetic": [
      "Mutations in AGPAT2 gene (CGL type 1)",
      "Mutations in BSCL2 gene (CGL type 2)",
      "Other rare mutations in CAV1, PTRF genes"
    ],
    "other": [
      "Physical examination revealing muscular hypertrophy and acanthosis nigricans"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "partial-lipodystrophy",
      "distinguishingFeatures": [
        "Partial rather than generalized fat loss",
        "Later onset compared to congenital forms",
        "Less severe insulin resistance"
      ]
    },
    {
      "diseaseId": "mandibuloacral-dysplasia",
      "distinguishingFeatures": [
        "Presence of skeletal abnormalities (mandibular hypoplasia)",
        "Cutaneous atrophy with lipodystrophy",
        "Distinct facial features"
      ]
    }
  ],
  "redFlags": [
    "Severe insulin resistance presenting in infancy",
    "Marked hypertriglyceridemia with risk of pancreatitis",
    "Near-total absence of adipose tissue from birth"
  ],
