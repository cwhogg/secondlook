  "diagnosticCriteria": {
    "formalCriteriaName": "ALG8-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypotonia",
        "description": "Congenital hypotonia presenting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multisystemic-involvement",
        "description": "Multisystemic involvement including hepatic dysfunction and coagulopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-transferrin-glycosylation",
        "description": "Abnormal serum transferrin glycosylation pattern detected by isoelectric focusing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biallelic-alg8-mutations",
        "description": "Identification of biallelic pathogenic variants in the ALG8 gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of abnormal transferrin glycosylation plus biallelic pathogenic ALG8 variants with compatible clinical features",
    "notes": "Diagnosis is confirmed by molecular genetic testing and biochemical assays; clinical presentation may vary."
  },
