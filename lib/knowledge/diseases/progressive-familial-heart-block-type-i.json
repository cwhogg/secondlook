  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Progressive Familial Heart Block Type I",
    "criteria": [
      {
        "id": "av-block",
        "description": "Progressive atrioventricular conduction block documented on ECG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of conduction system disease or sudden cardiac death",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in TRPM4 gene or other associated genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of atrioventricular block such as ischemic heart disease or myocarditis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive atrioventricular block with positive family history; genetic confirmation supports diagnosis",
    "notes": "Genetic testing is helpful but not mandatory; diagnosis relies primarily on clinical and ECG findings with family history."
  },
