  "keyFindings": {
    "laboratory": [
      "Absent or severely reduced melanin content in skin biopsy",
      "Normal routine blood tests"
    ],
    "imaging": [
      "Optical coherence tomography (OCT) showing foveal hypoplasia",
      "Visual evoked potentials (VEP) abnormalities"
    ],
    "genetic": [
      "TWIST2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Slit-lamp examination revealing iris transillumination",
      "Electroretinography (ERG) may show abnormal retinal function"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ocular-albinism",
      "distinguishingFeatures": [
        "X-linked inheritance",
        "Normal skin and hair pigmentation",
        "Primarily ocular involvement"
      ]
    },
    {
      "diseaseId": "hereditary-hypomelanosis",
      "distinguishingFeatures": [
        "Patchy hypopigmentation rather than generalized",
        "No significant ocular abnormalities",
        "Different genetic etiology"
      ]
    },
    {
      "diseaseId": "Hermansky-Pudlak syndrome",
      "distinguishingFeatures": [
        "Albinism with bleeding diathesis",
        "Pulmonary fibrosis and granulomatous colitis",
        "Platelet storage pool deficiency"
      ]
    }
  ],
