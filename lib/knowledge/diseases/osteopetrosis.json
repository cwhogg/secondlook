        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in osteoclast-related genes (e.g., TCIRG1, CLCN7)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized increased bone density on imaging combined with clinical features consistent with osteopetrosis; genetic confirmation supports diagnosis",
    "notes": "Diagnosis is primarily clinical and radiological; genetic testing is confirmatory but not always available."
