  "diagnosticCriteria": {
    "formalCriteriaName": "HEC Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypotrichosis",
        "description": "Congenital or early-onset sparse scalp hair (hypotrichosis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epilepsy",
        "description": "Recurrent seizures consistent with epilepsy beginning in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cataracts",
        "description": "Bilateral cataracts developing in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Variable intellectual disability or developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or affected siblings suggestive of autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: hypotrichosis, epilepsy, and bilateral cataracts",
    "notes": "Diagnosis is clinical; genetic testing may support but is not always available."
  },
