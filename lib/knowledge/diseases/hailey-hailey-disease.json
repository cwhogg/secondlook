  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and histopathological diagnosis of Hailey-Hailey Disease",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Recurrent vesicles and erosions primarily in intertriginous areas (axillae, groin, neck folds)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Acantholysis with a 'dilapidated brick wall' appearance on skin biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of ATP2C1 gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical presentation plus confirmatory histopathology",
    "notes": "Genetic testing can support diagnosis but is not mandatory"
  },
