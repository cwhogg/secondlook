        "description": "Progressive cerebellar ataxia with gait disturbance and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the ABCB7 gene or other related genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of acquired causes of sideroblastic anemia and other hereditary ataxias",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of sideroblastic anemia, progressive ataxia, and pathogenic mutation in ABCB7 or related gene",
    "notes": "Diagnosis is clinical supported by genetic testing; bone marrow biopsy is essential for confirming sideroblastic anemia."
  },
