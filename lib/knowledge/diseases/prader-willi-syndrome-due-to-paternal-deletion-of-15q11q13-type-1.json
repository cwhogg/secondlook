  "diagnosticCriteria": {
    "formalCriteriaName": "Holm Criteria for Prader-Willi Syndrome",
    "criteria": [
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia with poor suck and feeding difficulties",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyperphagia",
        "description": "Onset of hyperphagia leading to obesity in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Molecular genetic confirmation of paternal deletion at 15q11q13 Type 1",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay and intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypogonadism",
        "description": "Hypogonadism with genital hypoplasia and delayed or incomplete puberty",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of neonatal hypotonia, hyperphagia with obesity onset, and molecular genetic confirmation of paternal 15q11q13 Type 1 deletion",
    "notes": "Genetic testing is essential to confirm diagnosis and differentiate from other causes of Prader-Willi syndrome"
  },
