  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Jacobsen Syndrome",
    "criteria": [
      {
        "id": "chromosome-11q-terminal-deletion",
        "description": "Confirmed deletion of the terminal portion of chromosome 11q by cytogenetic or molecular analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bleeding-disorder",
        "description": "Presence of thrombocytopenia or platelet dysfunction leading to bleeding diathesis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital heart anomalies such as ventricular septal defect or tetralogy of Fallot",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism, ptosis, and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed 11q terminal deletion plus at least two major clinical features including bleeding disorder and intellectual disability",
    "notes": "Diagnosis requires genetic confirmation; clinical features vary widely among patients."
  },
