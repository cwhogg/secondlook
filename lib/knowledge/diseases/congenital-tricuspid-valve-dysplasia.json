  "diagnosticCriteria": {
    "formalCriteriaName": "Congenital Tricuspid Valve Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "valve-morphology",
        "description": "Echocardiographic evidence of thickened, dysplastic tricuspid valve leaflets with restricted mobility",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tricuspid-regurgitation",
        "description": "Presence of moderate to severe tricuspid regurgitation on Doppler echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "right-atrial-enlargement",
        "description": "Right atrial enlargement detected by imaging or clinical examination",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-cardiac-anomalies",
        "description": "Exclusion of other congenital heart defects such as Ebstein anomaly or tricuspid atresia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of echocardiographic evidence of dysplastic tricuspid valve morphology with moderate to severe tricuspid regurgitation",
    "notes": "Diagnosis relies primarily on detailed echocardiographic assessment; cardiac MRI may be supportive."
  },
