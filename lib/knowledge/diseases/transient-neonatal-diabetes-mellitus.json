  "keyFindings": {
    "laboratory": [
      "Persistent hyperglycemia in neonatal period",
      "Low or absent insulin levels during hyperglycemia",
      "Negative pancreatic autoantibodies"
    ],
    "imaging": [
      "Occasional pancreatic hypoplasia on abdominal ultrasound"
    ],
    "genetic": [
      "ABCC8 (causative)",
      "KCNJ11 (causative)",
      "HYMAI (causative)",
      "PLAGL1 (causative)",
      "ZFP57 (causative)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
