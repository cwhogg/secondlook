  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Occasional mild elevation of liver enzymes"
    ],
    "imaging": [
      "Brain MRI may show ventriculomegaly or delayed myelination",
      "Skeletal X-rays reveal advanced bone age and scoliosis"
    ],
    "genetic": [
      "TWIST2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Growth charts showing accelerated growth velocity",
      "Neurodevelopmental assessments confirming delay"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "beckwith-wiedemann-syndrome",
      "distinguishingFeatures": [
        "Presence of abdominal wall defects",
        "Hypoglycemia in neonatal period",
        "Distinct tumor predisposition profile"
      ]
    },
    {
      "diseaseId": "weaver-syndrome",
      "distinguishingFeatures": [
        "Facial features differ with broad forehead and large ears",
        "Presence of camptodactyly",
        "EZH2 gene mutations instead of NSD1"
      ]
    }
  ],
  "redFlags": [
    "Rapid head growth with neurological deterioration",
    "Seizures refractory to treatment",
    "Signs of tumor development (e.g., abdominal mass)"
  ],
