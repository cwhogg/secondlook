  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Distal Duplication 5q Syndrome",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of duplication involving distal 5q region by chromosomal microarray or karyotyping",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic facial features including broad nasal bridge, micrognathia, and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital heart defects or skeletal anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of distal 5q duplication plus at least two major clinical features",
    "notes": "Diagnosis relies heavily on molecular cytogenetic confirmation due to phenotypic variability."
  },
