  "diagnosticCriteria": {
    "formalCriteriaName": "Roifman Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "skeletal-dysplasia",
        "description": "Presence of spondyloepiphyseal dysplasia with characteristic skeletal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Combined immunodeficiency with hypogammaglobulinemia and reduced B-cell numbers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "retinal-dystrophy",
        "description": "Early-onset retinal dystrophy leading to visual impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation with short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including micrognathia and epicanthal folds",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: spondyloepiphyseal dysplasia, combined immunodeficiency, and retinal dystrophy",
    "notes": "Genetic confirmation of biallelic pathogenic variants in RNU4ATAC supports diagnosis"
  },
