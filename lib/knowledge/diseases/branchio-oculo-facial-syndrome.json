  "diagnosticCriteria": {
    "formalCriteriaName": "Branchio-oculo-facial syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "branchial-cleft-anomalies",
        "description": "Presence of branchial cleft cysts, fistulas, or sinuses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "Ocular malformations including microphthalmia, coloboma, or lacrimal duct anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features such as cleft lip and/or palate, broad nasal bridge, and malformed ears",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural or conductive hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-anomalies",
        "description": "Renal malformations or dysfunction",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: branchial cleft anomalies, ocular anomalies, and characteristic facial dysmorphism",
    "notes": "Genetic testing for TFAP2A mutations can confirm diagnosis"
  },
