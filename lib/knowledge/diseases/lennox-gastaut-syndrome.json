  "diagnosticCriteria": {
    "formalCriteriaName": "Lennox-Gastaut Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "multiple-seizure-types",
        "description": "Presence of multiple generalized seizure types including tonic, atonic, and atypical absence seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "slow-spike-wave-eeg",
        "description": "Characteristic EEG pattern showing slow spike-and-wave complexes at 1.5-2.5 Hz",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cognitive-impairment",
        "description": "Developmental delay or cognitive impairment evident during early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-onset",
        "description": "Onset of seizures typically between 1 and 8 years of age",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "resistance-to-treatment",
        "description": "Seizures often refractory to conventional antiepileptic drugs",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple generalized seizure types, characteristic slow spike-and-wave EEG pattern, and cognitive impairment with onset in early childhood",
    "notes": "Diagnosis is clinical supported by EEG findings; genetic testing may identify underlying etiology but is not required"
  },
