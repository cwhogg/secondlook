  "keyFindings": {
    "laboratory": [
      "CSF cytology usually negative but may show tumor cells in disseminated disease"
    ],
    "imaging": [
      "MRI showing well-demarcated intraventricular or spinal cord mass with heterogeneous enhancement",
      "T1 hypointense and T2 hyperintense lesion with possible calcifications"
    ],
    "genetic": [
      "ZFTA (fusion gene)"
    ],
    "other": [
      "Histopathology demonstrating ependymal rosettes and perivascular pseudorosettes",
      "Immunohistochemistry positive for GFAP and EMA"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "astrocytoma",
      "distinguishingFeatures": [
        "Lack of perivascular pseudorosettes",
        "Different immunohistochemical profile (usually GFAP positive but EMA negative)",
        "More infiltrative growth pattern"
      ]
    },
    {
      "diseaseId": "medulloblastoma",
      "distinguishingFeatures": [
        "Typically midline cerebellar tumor in children",
        "Histology shows small round blue cells without ependymal rosettes",
        "Different molecular markers"
      ]
    }
