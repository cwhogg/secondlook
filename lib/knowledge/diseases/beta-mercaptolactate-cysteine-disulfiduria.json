  "diagnosticCriteria": {
    "formalCriteriaName": "Beta-mercaptolactate cysteine disulfiduria diagnostic criteria",
    "criteria": [
      {
        "id": "urinary-excretion",
        "description": "Presence of beta-mercaptolactate cysteine disulfide in urine confirmed by chromatographic analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Recurrent episodes of metabolic acidosis and failure to thrive in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of 3-mercaptolactate-cysteine disulfide oxidase deficiency in fibroblast or liver tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consanguinity or affected siblings supportive of autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (urinary excretion, clinical features, enzyme deficiency) must be met for diagnosis",
    "notes": "Genetic testing may support diagnosis but is not routinely available"
  },
