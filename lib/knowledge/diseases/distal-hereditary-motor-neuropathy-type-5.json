  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electrophysiological Diagnostic Criteria for Distal Hereditary Motor Neuropathy",
    "criteria": [
      {
        "id": "clinical-motor-weakness",
        "description": "Progressive distal limb muscle weakness and atrophy predominantly affecting the hands and feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology-motor-neuropathy",
        "description": "Electrophysiological evidence of motor axonal neuropathy with normal sensory nerve conduction studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected family members",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the GARS gene or other associated genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-sensory-symptoms",
        "description": "Lack of significant sensory symptoms or signs",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal motor weakness and atrophy with electrophysiological confirmation of motor neuropathy and compatible family history",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical and electrophysiological criteria are met."
  },
