        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Pre- and postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital cardiac anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of tetrasomy 5p plus presence of at least two major clinical features",
    "notes": "Diagnosis relies heavily on cytogenetic analysis; clinical features support but are not solely diagnostic."
