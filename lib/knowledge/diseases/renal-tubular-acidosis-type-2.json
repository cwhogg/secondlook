  "diagnosticCriteria": {
    "formalCriteriaName": "Proximal Renal Tubular Acidosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "impaired-bicarbonate-reabsorption",
        "description": "Demonstration of impaired bicarbonate reabsorption in proximal tubules with increased urinary bicarbonate loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-anion-gap-metabolic-acidosis",
        "description": "Presence of normal anion gap (hyperchloremic) metabolic acidosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urine-ph-during-acidosis",
        "description": "Urine pH <5.5 after systemic acidemia is corrected",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypokalemia",
        "description": "Presence of hypokalemia due to renal potassium wasting",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-distal-rta-features",
        "description": "Exclusion of distal (Type 1) renal tubular acidosis features",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of impaired bicarbonate reabsorption with normal anion gap metabolic acidosis and urine pH <5.5 after correction of acidosis",
    "notes": "Diagnosis often requires exclusion of other causes of metabolic acidosis and may involve bicarbonate loading tests."
  },
