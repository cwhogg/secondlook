        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-color-vision",
        "description": "Near normal or mildly impaired color vision despite reduced cone function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
