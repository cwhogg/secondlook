  "keyFindings": {
    "laboratory": [
      "Elevated alpha-fetoprotein (mild or absent compared to classical AT)",
      "Cellular radiosensitivity assays showing defective DNA double-strand break repair",
      "Normal or mildly reduced immunoglobulin levels"
    ],
    "imaging": [
      "Cerebellar atrophy on brain MRI",
      "Normal chest imaging or mild interstitial changes"
    ],
    "genetic": [
      "MRE11 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Absence of oculocutaneous telangiectasia",
      "Normal or mildly delayed growth parameters"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ataxia-telangiectasia",
      "distinguishingFeatures": [
        "Presence of oculocutaneous telangiectasia",
        "ATM gene mutations",
        "Higher alpha-fetoprotein levels",
        "More severe immunodeficiency"
      ]
    },
    {
      "diseaseId": "ataxia-with-oculomotor-apraxia-type-1",
      "distinguishingFeatures": [
        "Absence of cellular radiosensitivity",
        "Different genetic mutations (e.g., APTX gene)",
        "Earlier onset of peripheral neuropathy"
      ]
    }
  ],
  "redFlags": [
    "Progressive cerebellar ataxia in early childhood without telangiectasia",
    "Cellular radiosensitivity on DNA repair assays",
    "Biallelic MRE11 mutations confirmed by genetic testing"
  ],
