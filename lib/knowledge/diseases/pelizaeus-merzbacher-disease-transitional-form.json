  "diagnosticCriteria": {
    "formalCriteriaName": "Pelizaeus-Merzbacher Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of nystagmus, hypotonia, and developmental delay in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing hypomyelination with diffuse white matter abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of PLP1 gene mutation or duplication",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Abnormal evoked potentials indicating central myelin dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical features, neuroimaging, and genetic testing) must be met for diagnosis.",
    "notes": "Diagnosis may be supported by electrophysiological studies and exclusion of other leukodystrophies."
  },
