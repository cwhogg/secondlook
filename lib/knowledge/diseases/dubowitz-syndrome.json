  "keyFindings": {
    "laboratory": [
      "Variable immunoglobulin deficiencies",
      "Normal routine blood counts in most cases"
    ],
    "imaging": [
      "Brain MRI may show microcephaly and mild structural abnormalities",
      "Skeletal X-rays show delayed bone age and short stature"
    ],
    "genetic": [
      "LIG4 (causative)",
      "NSUN2 (causative)",
      "No definitive gene identified; suspected autosomal recessive inheritance"
    ],
    "other": [
      "Characteristic facial features on clinical examination",
      "Developmental and neuropsychological assessments confirming intellectual disability"
    ]
  },
  "differentialDiagnoses": [
