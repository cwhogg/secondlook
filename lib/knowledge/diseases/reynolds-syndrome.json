  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria; diagnosis based on clinical and serological overlap",
    "criteria": [
      {
        "id": "pbc-evidence",
        "description": "Presence of primary biliary cholangitis confirmed by elevated alkaline phosphatase and antimitochondrial antibodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "scleroderma-features",
        "description": "Clinical and/or histopathological evidence of systemic sclerosis including skin thickening or Raynaud phenomenon",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoantibodies",
        "description": "Presence of specific autoantibodies such as anti-centromere or anti-Scl-70 antibodies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both primary biliary cholangitis and systemic sclerosis features with supportive serology",
    "notes": "Diagnosis relies on clinical overlap and exclusion of other causes"
  },
