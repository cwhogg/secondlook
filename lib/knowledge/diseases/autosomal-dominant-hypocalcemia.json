  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for Autosomal Dominant Hypocalcemia",
    "criteria": [
      {
        "id": "hypocalcemia",
        "description": "Persistent hypocalcemia with low or normal serum parathyroid hormone (PTH) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypercalciuria",
        "description": "Elevated urinary calcium excretion despite hypocalcemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "caSR-mutation",
        "description": "Identification of pathogenic activating mutation in the calcium-sensing receptor (CaSR) gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history consistent with autosomal dominant inheritance of hypocalcemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-causes",
        "description": "Exclusion of other causes of hypoparathyroidism or hypocalcemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent hypocalcemia with low/normal PTH and hypercalciuria plus identification of CaSR gene mutation or consistent family history",
    "notes": "Genetic testing is critical for confirmation; biochemical profile is essential for initial suspicion."
  },
