  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Progressive Myoclonic Epilepsy Type 3",
    "criteria": [
      {
        "id": "clinical-myoclonus",
        "description": "Presence of stimulus-sensitive, action-induced myoclonic jerks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "generalized-tonic-clonic-seizures",
        "description": "Recurrent generalized tonic-clonic seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cognitive-decline",
        "description": "Progressive cognitive impairment or dementia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in CSTB gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroencephalogram-findings",
        "description": "EEG showing generalized spike-wave and polyspike-wave discharges",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of stimulus-sensitive myoclonus and generalized tonic-clonic seizures plus pathogenic CSTB mutation",
    "notes": "Diagnosis is supported by EEG findings and progressive cognitive decline but these are not mandatory."
  },
