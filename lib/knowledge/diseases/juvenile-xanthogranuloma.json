  "diagnosticCriteria": {
    "formalCriteriaName": "Juvenile Xanthogranuloma Diagnostic Criteria",
    "criteria": [
      {
        "id": "cutaneous-lesions",
        "description": "Presence of solitary or multiple yellowish to reddish-brown papules or nodules on the skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing dermal infiltration by histiocytes with Touton giant cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-of-onset",
        "description": "Onset typically in infancy or early childhood",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-malignancy",
        "description": "No evidence of malignant histiocytosis or Langerhans cell histiocytosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic cutaneous lesions plus confirmatory histopathology",
    "notes": "Systemic involvement is rare but should be evaluated if present"
  },
