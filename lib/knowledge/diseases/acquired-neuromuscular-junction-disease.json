        "requiredForDiagnosis": true
      },
      {
        "id": "autoantibody-detection",
        "description": "Detection of pathogenic autoantibodies against acetylcholine receptor (AChR) or muscle-specific kinase (MuSK)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiological-evidence",
        "description": "Electrophysiological demonstration of neuromuscular transmission defect via repetitive nerve stimulation or single-fiber electromyography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-anticholinesterase",
        "description": "Clinical improvement with anticholinesterase medication",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of fluctuating fatigable muscle weakness plus either positive autoantibody testing or electrophysiological evidence of neuromuscular transmission defect",
    "notes": "Diagnosis may be supported by response to anticholinesterase therapy and exclusion of other causes."
  },
