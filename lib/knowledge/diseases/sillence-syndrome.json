  "keyFindings": {
    "laboratory": [
      "Normal serum calcium and phosphate",
      "Elevated alkaline phosphatase during fracture healing",
      "Urinary collagen crosslinks may be elevated"
    ],
    "imaging": [
      "Multiple fractures with callus formation",
      "Bone deformities and osteopenia on X-ray",
      "Skull base abnormalities on CT/MRI"
    ],
    "genetic": [
      "Mutations in COL1A1 or COL1A2 genes",
      "Autosomal dominant inheritance pattern"
    ],
    "other": [
      "Blue sclerae observed on physical exam",
      "Dentinogenesis imperfecta confirmed by dental evaluation"
    ]
  },
