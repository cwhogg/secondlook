  "diagnosticCriteria": {
    "formalCriteriaName": "Senior-Loken Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "nephronophthisis",
        "description": "Presence of nephronophthisis characterized by corticomedullary cystic kidney disease and progressive renal failure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "retinal-degeneration",
        "description": "Retinal dystrophy including retinitis pigmentosa or Leber congenital amaurosis leading to visual impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in known Senior-Loken syndrome-associated genes (e.g., NPHP1, NPHP5/IQCB1)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both nephronophthisis and retinal degeneration clinical features; genetic confirmation supportive but not mandatory",
    "notes": "Diagnosis is clinical and supported by genetic testing; renal biopsy may aid in diagnosis"
  },
