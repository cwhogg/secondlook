  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of acquired causes of ataxia (e.g., vitamin deficiencies, toxins)"
    ],
    "imaging": [
      "MRI showing cerebellar atrophy predominantly affecting the vermis and hemispheres"
    ],
    "genetic": [
      "KCNC3 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography may show mild peripheral neuropathy",
      "Neuropsychological testing may reveal mild cognitive deficits"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "spinocerebellar-ataxia-type-1",
      "distinguishingFeatures": [
        "Mutation in ATXN1 gene",
        "Earlier onset with more prominent pyramidal signs",
        "More severe cognitive decline"
      ]
    },
    {
      "diseaseId": "friedreich-ataxia",
      "distinguishingFeatures": [
        "GAA trinucleotide repeat expansion in FXN gene",
        "Presence of cardiomyopathy and diabetes mellitus",
        "Loss of deep tendon reflexes"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive ataxia over weeks",
    "Onset before 1 year of age with severe developmental delay",
    "Presence of systemic symptoms such as fever or weight loss"
  ],
