  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of acquired ataxia causes (e.g., vitamin E deficiency, thyroid dysfunction)"
    ],
    "imaging": [
      "MRI showing cerebellar atrophy predominantly affecting the vermis and hemispheres"
    ],
    "genetic": [
      "CACNA1G (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography may show mild sensory neuropathy",
      "Neurophysiology may reveal slowed central motor conduction"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "spinocerebellar-ataxia-type-3",
      "distinguishingFeatures": [
        "Earlier onset in some cases",
        "Presence of pyramidal signs and extrapyramidal symptoms",
        "Different genetic mutation (ATXN3 gene)"
      ]
    },
    {
      "diseaseId": "friedreich-ataxia",
      "distinguishingFeatures": [
        "Onset typically before age 25",
        "Associated cardiomyopathy and diabetes mellitus",
        "GAA trinucleotide repeat expansion in FXN gene"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of ataxia over weeks to months",
