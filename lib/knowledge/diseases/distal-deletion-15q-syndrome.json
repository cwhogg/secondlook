  "differentialDiagnoses": [
    {
      "diseaseId": "prader-willi-syndrome",
      "distinguishingFeatures": [
        "15q11-q13 deletion or imprinting defect",
        "Hyperphagia and obesity in childhood",
        "Hypotonia with distinct facial features different from distal 15q deletion"
      ]
    },
    {
      "diseaseId": "silver-russell-syndrome",
      "distinguishingFeatures": [
        "Growth retardation with asymmetry",
        "Hypomethylation of 11p15 or maternal uniparental disomy 7",
        "Distinct facial features including triangular face and prominent forehead"
      ]
    }
  ],
