  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Congenital Muscular Dystrophy with Intellectual Disability",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early onset hypotonia and muscle weakness presenting at birth or within the first 6 months of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Documented intellectual disability confirmed by neuropsychological assessment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with congenital muscular dystrophy (e.g., LAMA2, POMT1, or related genes)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes and abnormal expression of muscle proteins",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "brain-imaging",
        "description": "Brain MRI demonstrating structural abnormalities such as white matter changes or cortical malformations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early onset hypotonia and muscle weakness, documented intellectual disability, and pathogenic genetic variant in a CMD-associated gene",
    "notes": "Muscle biopsy and brain imaging findings support diagnosis but are not mandatory if genetic confirmation is obtained."
  },
