  "keyFindings": {
    "laboratory": [
      "Hypocalcemia with elevated serum phosphate",
      "Elevated serum PTH levels indicating hormone resistance",
      "Elevated TSH with normal or low thyroid hormone levels"
    ],
    "imaging": [
      "Shortened fourth and fifth metacarpals on hand X-ray",
      "Subcutaneous and ectopic ossifications visible on soft tissue imaging"
    ],
    "genetic": [
      "GNAS (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Blunted cyclic AMP response to PTH stimulation test"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hypoparathyroidism",
      "distinguishingFeatures": [
        "Low PTH levels rather than elevated",
        "Absence of AHO phenotype",
        "No GNAS mutations"
      ]
    },
    {
      "diseaseId": "pseudopseudohypoparathyroidism",
      "distinguishingFeatures": [
        "Presence of AHO phenotype without hormone resistance",
        "Normal calcium and phosphate levels",
        "GNAS mutations with imprinting differences"
      ]
    }
  ],
  "redFlags": [
    "Severe hypocalcemia causing tetany or seizures",
    "Progressive cognitive impairment",
    "Rapid development of ectopic ossifications impairing mobility"
  ],
