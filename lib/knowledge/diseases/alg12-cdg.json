  "keyFindings": {
    "laboratory": [
      "Abnormal serum transferrin isoelectric focusing pattern indicating type I CDG",
      "Coagulation abnormalities including prolonged PT and aPTT",
      "Elevated liver transaminases"
    ],
    "imaging": [
      "Brain MRI may show cerebral atrophy or delayed myelination",
      "Echocardiography may reveal cardiomyopathy"
    ],
    "genetic": [
      "ALG12 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electroencephalogram abnormalities in patients with seizures",
      "Muscle biopsy may show nonspecific myopathic changes"
    ]
  },
