  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Robinow Syndrome",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including midface hypoplasia, broad nasal bridge, hypertelorism, and prominent forehead",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mesomelic-limb-shortening",
        "description": "Mesomelic shortening of the limbs with short forearms and lower legs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genital-hypoplasia",
        "description": "Hypoplastic external genitalia, especially micropenis in males",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vertebral-anomalies",
        "description": "Vertebral segmentation defects including hemivertebrae and scoliosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "dental-abnormalities",
        "description": "Abnormal dentition such as gingival hyperplasia and malocclusion",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (craniofacial dysmorphism, mesomelic limb shortening, and genital hypoplasia) with supportive findings",
    "notes": "Genetic testing confirming biallelic pathogenic variants in ROR2 gene supports diagnosis"
  },
