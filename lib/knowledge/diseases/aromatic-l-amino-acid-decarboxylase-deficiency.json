  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus diagnostic criteria for AADC deficiency",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced aromatic L-amino acid decarboxylase enzyme activity in plasma or cerebrospinal fluid",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Biallelic pathogenic variants in the DDC gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-profile",
        "description": "Characteristic neurotransmitter metabolite profile in cerebrospinal fluid (low homovanillic acid and 5-hydroxyindoleacetic acid, elevated L-DOPA and 5-hydroxytryptophan)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of early-onset hypotonia, oculogyric crises, and developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic DDC variants or reduced enzyme activity plus characteristic CSF neurotransmitter profile",
    "notes": "Diagnosis is confirmed by a combination of biochemical, genetic, and clinical findings."
  },
