  "diagnosticCriteria": {
    "formalCriteriaName": "Factor XI Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "prolonged-aptt",
        "description": "Prolonged activated partial thromboplastin time (aPTT) not corrected by mixing studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "factor-xi-activity",
        "description": "Reduced Factor XI activity level below 15-20% of normal",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bleeding-history",
        "description": "Personal or family history of mild to moderate bleeding, especially post-trauma or surgery",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the F11 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Prolonged aPTT plus reduced Factor XI activity with bleeding history",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Postoperative bleeding disproportionate to surgical trauma",
        "frequency": 0.85,
        "bodySystem": "hematological",
        "notes": "Especially after dental or urological procedures"
      },
      {
        "symptomName": "Mucocutaneous bleeding",
        "frequency": 0.75,
        "bodySystem": "hematological",
        "notes": "Includes easy bruising and epistaxis"
      }
    ],
    "common": [
      {
        "symptomName": "Menorrhagia",
        "frequency": 0.65,
        "bodySystem": "reproductive",
        "notes": "Heavy menstrual bleeding in affected females"
      },
      {
        "symptomName": "Prolonged bleeding after trauma",
        "frequency": 0.6,
        "bodySystem": "hematological",
        "notes": "Bleeding tendency after minor injuries"
      },
      {
        "symptomName": "Hemarthrosis",
        "frequency": 0.55,
        "bodySystem": "musculoskeletal",
        "notes": "Less common than in other hemophilias but can occur"
      },
      {
        "symptomName": "Gastrointestinal bleeding",
        "frequency": 0.5,
        "bodySystem": "gastrointestinal",
        "notes": "Rarely severe but reported"
      }
    ],
    "occasional": [
      {
        "symptomName": "Postpartum hemorrhage",
        "frequency": 0.4,
        "bodySystem": "reproductive",
        "notes": "Bleeding complications after childbirth"
      },
      {
        "symptomName": "Hematuria",
        "frequency": 0.3,
        "bodySystem": "renal",
        "notes": "Blood in urine due to bleeding tendency"
      },
      {
        "symptomName": "Intramuscular hematomas",
        "frequency": 0.25,
        "bodySystem": "musculoskeletal",
        "notes": "Localized bleeding into muscles"
      },
      {
        "symptomName": "Nosebleeds (epistaxis)",
        "frequency": 0.15,
        "bodySystem": "hematological",
        "notes": "Mild to moderate frequency"
      }
    ],
    "rare": [
      {
        "symptomName": "Central nervous system hemorrhage",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Very rare but life-threatening"
      },
      {
        "symptomName": "Severe spontaneous bleeding",
        "frequency": 0.03,
        "bodySystem": "hematological",
        "notes": "Uncommon in Factor XI deficiency compared to other hemophilias"
