  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Adrenomyeloneuropathy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive spastic paraparesis with peripheral neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-evidence",
        "description": "Elevated very long chain fatty acids (VLCFA) in plasma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic mutation in the ABCD1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "adrenal-insufficiency",
        "description": "Evidence of primary adrenal insufficiency (Addison disease)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "brain-mri",
        "description": "MRI showing spinal cord atrophy or cerebral white matter changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive spastic paraparesis plus elevated VLCFA and ABCD1 gene mutation confirmation",
    "notes": "Diagnosis is confirmed by biochemical and genetic testing; clinical presentation may vary."
  },
