  "diagnosticCriteria": {
    "formalCriteriaName": "Maternal Uniparental Disomy of Chromosome 6 Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of maternal uniparental disomy of chromosome 6 by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intrauterine-growth-retardation",
        "description": "Evidence of intrauterine growth retardation (IUGR) documented by prenatal ultrasound or birth records",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neonatal-hypoglycemia",
        "description": "Neonatal hypoglycemia requiring medical intervention",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mild-facial-dysmorphism",
        "description": "Presence of mild facial dysmorphic features such as micrognathia or prominent forehead",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "transient-neonatal-diabetes",
        "description": "Transient neonatal diabetes mellitus occurring in the neonatal period",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of maternal uniparental disomy of chromosome 6 plus at least two major clinical features including intrauterine growth retardation and neonatal hypoglycemia",
    "notes": "Diagnosis relies heavily on molecular genetic testing; clinical features may overlap with other imprinting disorders."
  },
