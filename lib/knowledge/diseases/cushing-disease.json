  "keyFindings": {
    "laboratory": [
      "Elevated 24-hour urinary free cortisol",
      "Elevated late-night salivary cortisol",
      "Failure to suppress cortisol on low-dose dexamethasone test",
      "Elevated or inappropriately normal plasma ACTH",
      "Hypokalemia in some cases"
    ],
    "imaging": [
      "Pituitary MRI showing microadenoma or macroadenoma",
      "Inferior petrosal sinus sampling demonstrating central ACTH gradient"
    ],
    "genetic": [
      "CDH23 (susceptibility)",
      "USP48 (somatic)",
      "BRAF (somatic)",
      "USP8 (somatic)",
      "NR3C1 (somatic)",
      "TP53 (somatic)",
      "ATRX (somatic)"
    ],
    "other": [
      "Histopathology confirming ACTH-secreting pituitary adenoma after surgery"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ectopic-acth-syndrome",
      "distinguishingFeatures": [
        "High ACTH with no pituitary adenoma on MRI",
        "No central to peripheral ACTH gradient on inferior petrosal sinus sampling",
        "Presence of ectopic ACTH-secreting tumor"
      ]
    },
    {
      "diseaseId": "adrenal-cushing-syndrome",
      "distinguishingFeatures": [
        "Low ACTH levels",
        "Adrenal mass on imaging",
        "Cortisol secretion independent of ACTH"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset of severe hypercortisolism symptoms",
    "Visual field defects indicating pituitary macroadenoma",
    "Severe hypokalemia refractory to treatment"
  ],
