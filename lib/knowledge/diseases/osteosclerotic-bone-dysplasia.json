  "diagnosticCriteria": {
    "formalCriteriaName": "Osteosclerotic Bone Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "radiologic-osteosclerosis",
        "description": "Diffuse increased bone density visible on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-bone-fractures",
        "description": "Recurrent pathological fractures despite increased bone density",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathologic-bone-biopsy",
        "description": "Bone biopsy showing abnormal osteosclerosis with disorganized bone remodeling",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-metabolic-cause",
        "description": "Exclusion of metabolic or secondary causes of osteosclerosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of diffuse osteosclerosis on imaging plus at least one major clinical or histopathologic criterion",
    "notes": "Diagnosis requires exclusion of other causes of osteosclerosis such as osteopetrosis or metastatic disease."
  },
