  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Coxopodopatellar Syndrome",
    "criteria": [
      {
        "id": "patellar-hypoplasia",
        "description": "Hypoplasia or aplasia of the patellae confirmed by radiographic imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pelvic-dysplasia",
        "description": "Pelvic abnormalities including coxa vara or coxa valga deformities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-limbs",
        "description": "Shortening of the lower limbs with disproportionate limb-to-trunk ratio",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Mild facial dysmorphic features such as micrognathia or midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the TBX4 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (patellar hypoplasia/aplasia, pelvic dysplasia, and short limbs) with or without genetic confirmation",
    "notes": "Genetic testing for TBX4 mutations can support diagnosis but is not mandatory."
  },
