    "formalCriteriaName": "Cutaneous Pseudolymphoma Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of solitary or multiple erythematous to violaceous papules, plaques, or nodules on the skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Dense, polyclonal lymphoid infiltrate in the dermis with preservation of normal skin architecture",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotyping",
        "description": "Polyclonal B- and/or T-cell populations without evidence of monoclonality",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-lymphoma",
        "description": "Exclusion of cutaneous lymphoma by clinical, histological, and molecular studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-treatment",
        "description": "Clinical improvement or resolution with removal of causative agent or conservative therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical lesions plus histopathological evidence of polyclonal lymphoid infiltrate and exclusion of cutaneous lymphoma",
    "notes": "Molecular studies to exclude monoclonality are essential to differentiate from cutaneous lymphoma."
  },
