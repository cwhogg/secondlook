  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Mosaic Trisomy 2",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Detection of mosaic trisomy 2 in peripheral blood or fibroblast karyotyping",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial anomalies including micrognathia and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Intrauterine growth retardation or postnatal growth deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-malformations",
        "description": "Presence of congenital malformations such as cardiac defects or limb anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of mosaic trisomy 2 plus at least two major clinical features",
    "notes": "Diagnosis relies heavily on cytogenetic analysis due to phenotypic variability."
  },
