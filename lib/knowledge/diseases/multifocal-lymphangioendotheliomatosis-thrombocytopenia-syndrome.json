  "keyFindings": {
    "laboratory": [
      "Marked thrombocytopenia with normal coagulation profile",
      "Anemia consistent with chronic blood loss",
      "Normal or mildly elevated inflammatory markers"
    ],
    "imaging": [
      "MRI or ultrasound showing multifocal vascular lesions in skin and internal organs",
      "Radiologic evidence of lymphatic malformations"
    ],
    "genetic": [
      "No specific genetic mutation identified; etiology currently unknown"
    ],
    "other": [
      "Histopathology demonstrating proliferation of lymphatic endothelial cells with platelet trapping"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "kaposiform-hemangioendothelioma",
      "distinguishingFeatures": [
        "Typically presents with a single large vascular tumor",
        "Associated with Kasabach-Merritt phenomenon",
        "Histology shows kaposiform endothelial proliferation"
      ]
    },
    {
      "diseaseId": "kasabach-merritt-syndrome",
      "distinguishingFeatures": [
        "Severe thrombocytopenia with consumptive coagulopathy",
        "Usually associated with kaposiform hemangioendothelioma or tufted angioma",
        "Rapidly enlarging vascular tumor"
      ]
    },
    {
      "diseaseId": "generalized-lymphatic-omaly",
      "distinguishingFeatures": [
        "Diffuse lymphatic malformations without thrombocytopenia",
        "Less prominent vascular tumor formation",
        "Often presents with cystic lymphatic lesions"
      ]
    }
  ],
  "redFlags": [
    "Severe thrombocytopenia with bleeding diathesis",
    "Rapid progression of multifocal vascular lesions",
    "Signs of consumptive coagulopathy or organ dysfunction"
  ],
