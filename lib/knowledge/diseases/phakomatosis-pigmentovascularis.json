  "keyFindings": {
    "laboratory": [
      "No specific laboratory abnormalities; routine labs typically normal"
    ],
    "imaging": [
      "MRI brain may show leptomeningeal angiomatosis in cases with neurological involvement",
      "Doppler ultrasound for vascular malformations",
      "Ophthalmologic imaging for glaucoma and ocular melanosis"
    ],
    "genetic": [
      "No consistent genetic mutation identified; considered sporadic mosaicism"
    ],
    "other": [
      "Histopathology of skin lesions shows capillary malformations and dermal melanocytosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sturge-weber-syndrome",
      "distinguishingFeatures": [
        "Leptomeningeal angiomatosis without pigmentary nevi",
        "Unilateral port-wine stain typically involving trigeminal nerve distribution"
      ]
    },
    {
      "diseaseId": "nevus-of-ota",
      "distinguishingFeatures": [
        "Isolated ocular and facial melanosis without vascular malformations",
        "No associated port-wine stains"
      ]
    },
    {
      "diseaseId": "klippel-trenaunay-syndrome",
      "distinguishingFeatures": [
        "Capillary malformations with limb hypertrophy and venous malformations but no pigmentary nevi"
      ]
    }
  ],
  "redFlags": [
    "Progressive neurological deficits or seizures",
    "Development of glaucoma with visual impairment",
    "Rapidly enlarging vascular malformations or soft tissue hypertrophy"
  ],
