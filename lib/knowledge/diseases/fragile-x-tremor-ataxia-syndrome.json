    "ethnicAssociations": [
      "Caucasian",
      "Asian",
      "Hispanic"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Jacquemont FXTAS Diagnostic Criteria",
    "criteria": [
      {
        "id": "intention-tremor",
        "description": "Presence of intention tremor",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gait-ataxia",
        "description": "Gait ataxia or imbalance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fmr1-premutation",
        "description": "FMR1 gene premutation (55-200 CGG repeats)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mri-middle-cerebellar-peduncle-hyperintensity",
        "description": "MRI evidence of middle cerebellar peduncle (MCP) hyperintensity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cognitive-decline",
        "description": "Progressive cognitive decline or dementia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "parkinsonism",
        "description": "Parkinsonism features such as bradykinesia or rigidity",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of FMR1 premutation plus either two major criteria or one major and two minor criteria",
    "notes": "MRI findings are supportive but not mandatory for diagnosis."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Intention tremor",
        "frequency": 0.85,
        "bodySystem": "neurological",
        "notes": "Typically action tremor affecting upper limbs"
      },
      {
        "symptomName": "Gait ataxia",
        "frequency": 0.8,
        "bodySystem": "neurological",
        "notes": "Progressive imbalance and unsteady walking"
      },
      {
        "symptomName": "FMR1 premutation (55-200 CGG repeats)",
        "frequency": 1,
        "bodySystem": "constitutional",
        "notes": "Genetic hallmark of FXTAS"
      }
    ],
    "common": [
      {
        "symptomName": "Cognitive decline",
        "frequency": 0.65,
        "bodySystem": "neurological",
        "notes": "Memory impairment and executive dysfunction"
      },
      {
        "symptomName": "Parkinsonism",
        "frequency": 0.6,
        "bodySystem": "neurological",
        "notes": "Bradykinesia, rigidity, and postural instability"
      },
      {
        "symptomName": "Peripheral neuropathy",
        "frequency": 0.55,
        "bodySystem": "neurological",
        "notes": "Sensory deficits and paresthesias"
      },
      {
        "symptomName": "Autonomic dysfunction",
        "frequency": 0.5,
        "bodySystem": "neurological",
        "notes": "Orthostatic hypotension and bladder dysfunction"
      }
    ],
