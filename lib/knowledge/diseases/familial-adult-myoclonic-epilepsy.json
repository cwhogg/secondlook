  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Familial Adult Myoclonic Epilepsy",
    "criteria": [
      {
        "id": "adult-onset-myoclonus",
        "description": "Presence of adult-onset cortical myoclonus predominantly affecting distal limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "generalized-seizures",
        "description": "Occurrence of generalized tonic-clonic seizures or other seizure types",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiological-findings",
        "description": "Electroencephalogram (EEG) showing cortical reflex myoclonus and epileptiform discharges",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic repeat expansions in genes such as SAMD12, STARD7, or MARCH6",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of adult-onset cortical myoclonus, generalized seizures, and a positive family history consistent with autosomal dominant inheritance",
    "notes": "Genetic testing and electrophysiological studies support diagnosis but are not mandatory."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Adult-onset cortical myoclonus",
        "frequency": 0.9,
        "bodySystem": "neurological",
        "notes": "Predominantly affects distal upper limbs"
      },
      {
        "symptomName": "Generalized tonic-clonic seizures",
        "frequency": 0.85,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Cortical reflex myoclonus triggered by action or sensory stimuli",
        "frequency": 0.75,
        "bodySystem": "neurological"
      }
    ],
    "common": [
      {
        "symptomName": "Mild cognitive impairment",
        "frequency": 0.6,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Tremor resembling essential tremor",
        "frequency": 0.65,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Photophobia or photosensitivity",
        "frequency": 0.55,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Sleep disturbances",
        "frequency": 0.5,
        "bodySystem": "neurological"
      }
    ],
    "occasional": [
      {
        "symptomName": "Ataxia or gait instability",
        "frequency": 0.3,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Anxiety or depressive symptoms",
        "frequency": 0.25,
        "bodySystem": "psychiatric"
      },
      {
