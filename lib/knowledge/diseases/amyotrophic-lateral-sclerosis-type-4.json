  "diagnosticCriteria": {
    "formalCriteriaName": "Revised El Escorial Criteria adapted for familial ALS",
    "criteria": [
      {
        "id": "upper-motor-neuron-signs",
        "description": "Presence of upper motor neuron signs in at least one region",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lower-motor-neuron-signs",
        "description": "Evidence of lower motor neuron degeneration by clinical, electrophysiological, or neuropathologic examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-spread",
        "description": "Progressive spread of symptoms or signs within a region or to other regions",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in the ALS4-associated gene (e.g., senataxin gene SETX)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both upper and lower motor neuron signs with progressive spread and exclusion of other causes",
    "notes": "Genetic testing can support diagnosis but is not mandatory."
  },
