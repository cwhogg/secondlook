  "diagnosticCriteria": {
    "formalCriteriaName": "Prolidase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced or absent prolidase enzyme activity in fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imidodipeptiduria",
        "description": "Presence of imidodipeptides in urine detected by amino acid analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biallelic-variants",
        "description": "Identification of biallelic pathogenic variants in the PEPD gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Characteristic clinical features including chronic skin ulcers and recurrent infections",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced prolidase enzyme activity or biallelic pathogenic PEPD variants plus clinical features consistent with prolidase deficiency",
    "notes": "Molecular genetic testing is confirmatory; enzyme assay is diagnostic gold standard."
  },
