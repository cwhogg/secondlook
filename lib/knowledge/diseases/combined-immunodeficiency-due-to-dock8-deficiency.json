  "diagnosticCriteria": {
    "formalCriteriaName": "DOCK8 Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the DOCK8 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotyping",
        "description": "Profound lymphopenia with markedly reduced CD4+ and CD8+ T cells and impaired antibody responses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Recurrent viral, bacterial, and fungal infections with severe atopy and eczema",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eosinophilia",
        "description": "Peripheral blood eosinophilia and elevated serum IgE levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or affected siblings with similar immunodeficiency phenotype",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic DOCK8 variants plus clinical immunodeficiency features and immunophenotyping abnormalities",
    "notes": "Diagnosis requires integration of genetic, immunologic, and clinical data; exclusion of other combined immunodeficiencies is essential"
  },
