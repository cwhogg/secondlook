  "keyFindings": {
    "laboratory": [
      "Elevated serum creatinine and blood urea nitrogen indicating renal impairment",
      "Liver function abnormalities in hepatic fibrosis"
    ],
    "imaging": [
      "Ultrasound or MRI showing bilateral renal cysts",
      "Hepatic fibrosis and cysts on abdominal imaging",
      "Retinal imaging showing pigmentary changes"
    ],
