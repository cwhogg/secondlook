  "keyFindings": {
    "laboratory": [
      "Elevated urinary heparan sulfate glycosaminoglycans",
      "Deficient lysosomal enzyme activity specific to MPS III subtype"
    ],
    "imaging": [
      "Brain MRI showing cerebral atrophy and white matter changes",
      "Skeletal X-rays demonstrating dysostosis multiplex"
    ],
    "genetic": [
      "Pathogenic variants in SGSH, NAGLU, HGSNAT, or GNS genes",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Neurophysiological studies may show delayed evoked potentials"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "mucopolysaccharidosis-type-1",
      "distinguishingFeatures": [
        "Earlier onset with more prominent somatic involvement",
        "Corneal clouding more frequent and severe",
        "Different enzyme deficiency (alpha-L-iduronidase)"
      ]
    },
    {
      "diseaseId": "hunter-syndrome",
      "distinguishingFeatures": [
        "X-linked inheritance (male predominance)",
        "Absence of corneal clouding",
        "Deficiency of iduronate-2-sulfatase enzyme"
      ]
    }
  ],
  "redFlags": [
    "Progressive developmental regression in early childhood",
    "Severe behavioral disturbances refractory to standard treatments",
    "Elevated urinary glycosaminoglycans with normal enzyme activity for other MPS types"
  ],
  "specialistType": [
