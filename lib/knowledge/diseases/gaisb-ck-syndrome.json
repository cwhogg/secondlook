  "diagnosticCriteria": {
    "formalCriteriaName": "Gaisböck Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "erythrocytosis",
        "description": "Persistent elevated hematocrit or hemoglobin levels without secondary causes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypertension",
        "description": "Presence of sustained arterial hypertension",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-plasma-volume",
        "description": "Evidence of reduced plasma volume contributing to relative erythrocytosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-secondary-erythrocytosis",
        "description": "Exclusion of secondary causes such as hypoxia, erythropoietin-secreting tumors, or polycythemia vera",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of persistent erythrocytosis and sustained hypertension with exclusion of secondary causes",
    "notes": "Diagnosis is clinical and by exclusion; plasma volume measurement supports diagnosis"
  },
