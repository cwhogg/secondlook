  "keyFindings": {
    "laboratory": [
      "Elevated serum bilirubin",
      "Mild to moderate elevation of liver transaminases (AST, ALT)",
      "Prolonged prothrombin time",
      "Thrombocytopenia"
    ],
    "imaging": [
      "Ultrasound showing hepatomegaly and ascites",
      "Doppler ultrasound demonstrating reduced or reversed hepatic venous flow",
      "CT or MRI may show patchy liver enhancement and ascites"
    ],
    "genetic": [],
    "other": [
      "Histopathology (rarely performed) shows occlusion of small hepatic veins and sinusoidal congestion"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "acute-hepatitis",
      "distinguishingFeatures": [
        "Elevated transaminases often >1000 U/L",
        "Absence of weight gain and ascites typical of VOD",
        "No history of bone marrow transplant"
      ]
    },
    {
      "diseaseId": "hepatic-cirrhosis",
      "distinguishingFeatures": [
        "Chronic progressive course",
        "Presence of portal hypertension signs like varices",
        "Imaging shows nodular liver surface"
      ]
    },
    {
      "diseaseId": "congestive-hepatopathy",
      "distinguishingFeatures": [
        "History of right heart failure",
        "Hepatic congestion secondary to cardiac causes",
        "Improvement with cardiac function optimization"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive liver failure",
    "Severe coagulopathy with bleeding",
    "Development of hepatic encephalopathy"
  ],
