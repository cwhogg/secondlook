  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological Diagnostic Criteria for Warty Dyskeratoma",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Solitary, umbilicated, keratotic papule or nodule usually on head or neck",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Characteristic suprabasal acantholysis with dyskeratosis and corps ronds on biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-multiple-lesions",
        "description": "Lesion is solitary and not part of generalized Darier disease",
        "category": "minor",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of solitary keratotic papule with characteristic histopathology and absence of multiple lesions",
    "notes": "Diagnosis is primarily histopathological; clinical correlation is essential to exclude Darier disease"
  },
