  "keyFindings": {
    "laboratory": [
      "Platelet count persistently >= 450,000/µL (often >600,000/µL)",
      "JAK2 V617F mutation (~55% of cases)",
      "CALR mutation (~25% of cases)",
      "MPL mutation (~3% of cases)",
      "Normal hemoglobin and hematocrit (distinguishes from PV)",
      "Elevated LDH may be present",
      "Acquired von Willebrand factor deficiency at very high platelet counts (ristocetin cofactor activity reduced)"
    ],
    "imaging": [
      "Abdominal ultrasound may show mild splenomegaly",
      "Imaging as needed for thrombotic complications"
    ],
    "genetic": [
      "TET2 (biomarker)",
      "JAK2 (somatic)",
      "MPL (somatic)",
      "CALR (somatic)",
      "SH2B3 (somatic)",
      "TP53 (biomarker)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Bone marrow biopsy showing characteristic large megakaryocytes with hyperlobulated 'staghorn' nuclei",
      "Minimal or no reticulin fibrosis",
      "Philadelphia chromosome / BCR-ABL1 negative (mandatory exclusion)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "reactive-thrombocytosis",
      "distinguishingFeatures": [
        "Identifiable cause (infection, inflammation, iron deficiency, post-surgery)",
        "No driver mutations (JAK2, CALR, MPL)",
        "Elevated inflammatory markers (CRP, ESR)",
        "Platelets usually <1,000,000/µL"
      ]
    },
    {
      "diseaseId": "polycythemia-vera",
      "distinguishingFeatures": [
        "PV has elevated hemoglobin/hematocrit as primary feature",
        "Low EPO in PV",
        "Different bone marrow morphology (panmyelosis)"
      ]
    },
    {
      "diseaseId": "myelofibrosis",
      "distinguishingFeatures": [
        "Significant reticulin/collagen fibrosis on bone marrow biopsy",
        "Leukoerythroblastic blood smear with teardrop cells",
        "Massive splenomegaly",
        "Constitutional symptoms more prominent"
      ]
    },
    {
      "diseaseId": "chronic-myeloid-leukemia",
      "distinguishingFeatures": [
        "BCR-ABL1 fusion gene / Philadelphia chromosome positive",
        "Marked leukocytosis with left shift",
        "Basophilia often present"
      ]
    }
  ],
  "redFlags": [
    "Major thrombotic event (stroke, MI, DVT/PE, splanchnic vein thrombosis)",
    "Extreme thrombocytosis (>1,500,000/µL) with paradoxical bleeding",
    "Transformation to myelofibrosis (progressive splenomegaly, cytopenias)",
    "Transformation to acute leukemia",
    "First trimester pregnancy loss (recurrent)"
  ],
