  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnostic criteria for Milroy disease",
    "criteria": [
      {
        "id": "congenital-lymphedema",
        "description": "Bilateral lower limb lymphedema present at birth or within first 2 years of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of primary lymphedema consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "FLT4-mutation",
        "description": "Identification of pathogenic mutation in the FLT4 (VEGFR3) gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "lymphoscintigraphy",
        "description": "Imaging evidence of lymphatic hypoplasia or aplasia on lymphoscintigraphy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-secondary-causes",
        "description": "Exclusion of secondary causes of lymphedema such as infection, malignancy, or trauma",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of congenital bilateral lower limb lymphedema plus either a positive family history or identification of FLT4 mutation, with exclusion of secondary causes",
    "notes": "Genetic testing is confirmatory but not mandatory if clinical criteria are met"
  },
