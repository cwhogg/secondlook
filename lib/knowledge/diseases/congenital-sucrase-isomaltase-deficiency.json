  "diagnosticCriteria": {
    "formalCriteriaName": "CSID Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-assay",
        "description": "Demonstration of deficient sucrase and isomaltase enzyme activity in small intestinal biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the sucrase-isomaltase (SI) gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Chronic osmotic diarrhea and malabsorption symptoms triggered by sucrose and maltose ingestion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "disaccharide-hydrogen-breath-test",
        "description": "Positive hydrogen breath test after sucrose or maltose challenge",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-enzyme-replacement",
        "description": "Clinical improvement with sacrosidase enzyme replacement therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of deficient sucrase-isomaltase enzyme activity or pathogenic SI gene mutations plus compatible clinical symptoms",
    "notes": "Genetic testing and enzyme assay are gold standards; breath tests and therapeutic response support diagnosis."
  },
