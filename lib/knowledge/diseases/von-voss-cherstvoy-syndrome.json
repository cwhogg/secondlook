  "diagnosticCriteria": {
    "formalCriteriaName": "Von Voss-Cherstvoy syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "radial-ray-defects",
        "description": "Presence of bilateral radial ray defects including hypoplasia or aplasia of the radius and thumbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "encephalocele",
        "description": "Midline occipital encephalocele or other cranial neural tube defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "polydactyly",
        "description": "Postaxial polydactyly of the hands or feet",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-anomalies",
        "description": "Congenital heart defects such as ventricular septal defect or atrial septal defect",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Intrauterine growth retardation or postnatal growth deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral radial ray defects and midline occipital encephalocele with or without additional minor criteria",
    "notes": "Diagnosis is primarily clinical supported by imaging and genetic testing when available."
  },
