  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and laboratory diagnosis of relapsing fever",
    "criteria": [
      {
        "id": "febrile-episodes",
        "description": "Recurrent febrile episodes separated by afebrile intervals",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "spirochetemia",
        "description": "Detection of Borrelia spirochetes in peripheral blood smear during febrile episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serologic-testing",
        "description": "Positive serologic or molecular tests for Borrelia species",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent febrile episodes with documented spirochetemia",
    "notes": "Diagnosis is primarily clinical supported by microscopic identification of spirochetes in blood."
  },
