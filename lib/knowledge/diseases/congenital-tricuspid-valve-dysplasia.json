  "keyFindings": {
    "laboratory": [
      "Elevated liver enzymes in cases with hepatic congestion",
      "BNP elevation indicating right heart strain"
    ],
    "imaging": [
      "Echocardiography showing thickened, dysplastic tricuspid valve leaflets with regurgitation",
      "Cardiac MRI confirming valve morphology and right atrial enlargement",
      "Chest X-ray showing cardiomegaly and right atrial enlargement"
    ],
    "genetic": [
      "No specific gene identified; sporadic cases predominate",
      "Possible association with mutations affecting valvulogenesis pathways"
    ],
    "other": [
      "Electrocardiogram may show right atrial enlargement and arrhythmias"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ebstein-anomaly",
      "distinguishingFeatures": [
        "Apical displacement of septal tricuspid leaflet",
