  "diagnosticCriteria": {
    "formalCriteriaName": "Ichthyosis Vulgaris Diagnostic Criteria",
    "criteria": [
      {
        "id": "dry-scaly-skin",
        "description": "Presence of widespread dry, scaly skin especially on extensor surfaces",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "filaggrin-mutation",
        "description": "Identification of filaggrin gene mutation by genetic testing",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of ichthyosis vulgaris or similar skin findings",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "palmar-hyperlinearity",
        "description": "Presence of increased skin markings on the palms (palmar hyperlinearity)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "keratosis-pilaris",
        "description": "Keratosis pilaris on extensor surfaces",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Widespread dry, scaly skin plus either positive family history or genetic confirmation of filaggrin mutation",
    "notes": "Diagnosis is primarily clinical; genetic testing supports but is not mandatory."
  },
