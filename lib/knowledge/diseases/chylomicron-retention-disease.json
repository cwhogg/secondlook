  "diagnosticCriteria": {
    "formalCriteriaName": "CRD Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypocholesterolemia",
        "description": "Persistent hypocholesterolemia with low plasma LDL and HDL cholesterol levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intestinal-biopsy",
        "description": "Intestinal biopsy showing enterocytes with retained lipid droplets and absence of chylomicrons",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sar1b-mutation",
        "description": "Identification of pathogenic mutations in the SAR1B gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Clinical features including chronic diarrhea, failure to thrive, and steatorrhea",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypocholesterolemia, intestinal biopsy findings consistent with chylomicron retention, and pathogenic SAR1B mutation",
    "notes": "Genetic testing is confirmatory; intestinal biopsy is invasive but diagnostic."
  },
