    "formalCriteriaName": "Proposed Diagnostic Criteria for Familial Alzheimer-like Prion Disease",
    "criteria": [
      {
        "id": "family-history",
        "description": "Positive family history of early-onset dementia with autosomal dominant inheritance pattern",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive cognitive decline resembling Alzheimer's disease with early memory impairment and executive dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "prion-protein-gene-mutation",
        "description": "Identification of pathogenic PRNP gene mutation associated with familial prion disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-neuroimaging",
        "description": "MRI showing cortical atrophy predominantly in temporal and parietal lobes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "csf-biomarkers",
        "description": "CSF analysis showing elevated 14-3-3 protein or RT-QuIC positivity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive dementia with positive family history and confirmed pathogenic PRNP mutation",
    "notes": "Diagnosis requires genetic confirmation due to overlap with other dementias"
  },
