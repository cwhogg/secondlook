  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Tumors of Hematopoietic and Lymphoid Tissues",
    "criteria": [
      {
        "id": "morphology",
        "description": "Monomorphic medium-sized B-cells with basophilic cytoplasm and high mitotic index",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotype",
        "description": "Expression of CD10, CD20, BCL6 with high Ki-67 proliferation index (~100%)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-translocation",
        "description": "Presence of MYC gene translocation involving chromosome 8 (t(8;14), t(2;8), or t(8;22))",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Rapidly growing tumor mass often involving jaw or abdomen",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of characteristic morphology plus immunophenotype and demonstration of MYC translocation",
    "notes": "Diagnosis requires integration of morphology, immunophenotyping, and cytogenetics or molecular studies."
  },
