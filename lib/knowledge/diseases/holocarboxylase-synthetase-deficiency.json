  "keyFindings": {
    "laboratory": [
      "Elevated urinary organic acids including 3-hydroxyisovaleric acid and 3-methylcrotonylglycine",
      "Metabolic ketoacidosis with elevated anion gap",
      "Elevated plasma lactate and ammonia during decompensation"
    ],
    "imaging": [
      "Brain MRI may show cerebral atrophy or delayed myelination",
      "Occasional basal ganglia abnormalities"
    ],
    "genetic": [
      "HLCS (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Marked clinical and biochemical improvement with high-dose biotin supplementation"
    ]
  },
