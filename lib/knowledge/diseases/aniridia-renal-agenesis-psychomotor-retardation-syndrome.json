      "diseaseId": "renal-coloboma-syndrome",
      "distinguishingFeatures": [
        "Optic nerve coloboma instead of aniridia",
        "Renal hypodysplasia rather than agenesis",
        "Mutations in PAX2 gene"
      ]
    }
  ],
