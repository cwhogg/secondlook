  "keyFindings": {
    "laboratory": [
      "Elevated eosinophil count in colonic biopsy (>20 eosinophils/HPF)",
      "Peripheral blood eosinophilia (variable)",
      "Elevated serum IgE in some cases"
    ],
    "imaging": [
      "Colonic wall thickening on abdominal CT or MRI",
      "Mucosal edema on colonoscopy"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology showing eosinophilic infiltration without evidence of infection or malignancy",
      "Exclusion of parasitic infections and drug-induced eosinophilia"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "inflammatory-bowel-disease",
      "distinguishingFeatures": [
        "Presence of granulomas or crypt abscesses on biopsy",
        "More common bloody diarrhea",
        "Chronic relapsing course with systemic symptoms"
      ]
    },
    {
      "diseaseId": "parasitic-colitis",
      "distinguishingFeatures": [
        "Identification of parasites or ova in stool",
        "Response to antiparasitic treatment",
        "Often associated with travel history or exposure"
      ]
    },
    {
      "diseaseId": "drug-induced-colitis",
      "distinguishingFeatures": [
        "Temporal relationship with medication use",
        "Resolution upon drug withdrawal",
        "Histology may show mixed inflammatory infiltrate"
      ]
    }
  ],
  "redFlags": [
    "Severe persistent abdominal pain",
    "Signs of colonic perforation or obstruction",
    "Unexplained significant weight loss"
  ],
