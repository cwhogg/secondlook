  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Tumors of the Central Nervous System (2021)",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of papillary architecture with epithelial-like tumor cells on histopathological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Positive immunostaining for cytokeratin and epithelial membrane antigen (EMA), with variable GFAP expression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-location",
        "description": "Tumor localized to the pineal region on MRI or CT imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-tumors",
        "description": "Exclusion of other pineal region tumors such as pineocytoma, pineoblastoma, or germ cell tumors",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of papillary architecture with immunohistochemical profile consistent with PTPR and tumor localization in the pineal region",
    "notes": "Molecular studies may assist in diagnosis but are not mandatory."
  },
