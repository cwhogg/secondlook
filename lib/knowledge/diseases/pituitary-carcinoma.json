  "keyFindings": {
    "laboratory": [
      "Elevated pituitary hormone levels depending on tumor subtype (e.g., prolactin, ACTH, TSH)",
      "Increased serum cortisol in ACTH-secreting tumors",
      "Hypopituitarism hormone profile with low target gland hormones"
    ],
    "imaging": [
      "MRI showing invasive sellar mass with suprasellar extension",
      "Evidence of craniospinal or systemic metastases on MRI or CT",
      "Bone scans or PET imaging demonstrating metastatic lesions"
    ],
    "genetic": [
      "No consistent germline mutations identified; some cases show TP53 mutations or other tumor suppressor gene alterations"
    ],
    "other": [
      "Histopathology demonstrating increased mitotic figures, nuclear atypia, and elevated Ki-67 proliferation index (>10%)",
      "Immunohistochemistry positive for pituitary hormones and markers of malignancy"
    ]
  },
