  "keyFindings": {
    "laboratory": [
      "Hormonal assays showing hypopituitarism or hypogonadism",
      "Metabolic screening typically normal"
    ],
    "imaging": [
      "Brain MRI demonstrating holoprosencephaly spectrum malformations",
      "X-rays showing postaxial polydactyly",
      "Echocardiogram for congenital heart defects"
    ],
    "genetic": [
      "Pathogenic variants in SHH, ZIC2, SIX3, or other holoprosencephaly-associated genes",
      "Chromosomal microarray may be normal or show copy number variants",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Clinical examination revealing characteristic craniofacial dysmorphisms",
      "Developmental assessment confirming intellectual disability"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pallister-hall-syndrome",
