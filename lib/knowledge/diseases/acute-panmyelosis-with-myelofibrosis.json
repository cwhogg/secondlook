  "keyFindings": {
    "laboratory": [
      "Peripheral blood cytopenias affecting multiple lineages",
      "Presence of circulating blasts (20-30%)",
      "Absence of BCR-ABL1 fusion gene",
      "Elevated serum lactate dehydrogenase (LDH)"
    ],
    "imaging": [
      "Splenomegaly on abdominal ultrasound or CT scan",
      "Hepatomegaly on imaging studies"
    ],
    "genetic": [
      "Negative for BCR-ABL1 fusion gene",
      "No JAK2 V617F mutation typically detected",
      "Complex karyotype abnormalities may be present"
    ],
    "other": [
      "Bone marrow biopsy showing panmyeloid proliferation with marked reticulin and collagen fibrosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "primary-myelofibrosis",
      "distinguishingFeatures": [
        "Lower blast percentage (<20%)",
        "Presence of JAK2, CALR, or MPL mutations",
        "More indolent clinical course"
      ]
    },
    {
      "diseaseId": "acute-myeloid-leukemia-with-fibrosis",
      "distinguishingFeatures": [
        "Blast count >30%",
        "Different genetic abnormalities",
        "Less prominent panmyeloid proliferation"
      ]
    },
    {
      "diseaseId": "chronic-myeloid-leukemia",
      "distinguishingFeatures": [
        "Presence of BCR-ABL1 fusion gene",
        "Different clinical and laboratory features",
        "Usually no marked fibrosis at diagnosis"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of cytopenias",
    "Marked bone marrow fibrosis with increasing blasts",
    "Failure to respond to conventional myeloproliferative neoplasm therapies"
  ],
