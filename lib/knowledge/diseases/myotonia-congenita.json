  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electromyographic Diagnostic Criteria for Myotonia Congenita",
    "criteria": [
      {
        "id": "clinical-myotonia",
        "description": "Presence of delayed muscle relaxation after voluntary contraction (clinical myotonia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyographic-myotonia",
        "description": "Electromyography demonstrating myotonic discharges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the CLCN1 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant or recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical myotonia and electromyographic myotonic discharges; genetic confirmation supports diagnosis",
    "notes": "Genetic testing is confirmatory but not always necessary if clinical and EMG findings are definitive."
  },
