  "diagnosticCriteria": {
    "formalCriteriaName": "Krabbe Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Reduced galactocerebrosidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic GALC gene mutations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Progressive neurological deterioration including spasticity and developmental regression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing characteristic demyelination patterns in the white matter",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced galactocerebrosidase enzyme activity and/or pathogenic GALC mutations combined with progressive neurological symptoms",
    "notes": "Diagnosis is confirmed by biochemical and genetic testing; neuroimaging supports clinical suspicion."
  },
