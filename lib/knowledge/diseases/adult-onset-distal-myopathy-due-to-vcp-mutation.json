  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed diagnostic criteria for VCP-related distal myopathy",
    "criteria": [
      {
        "id": "clinical-distal-weakness",
        "description": "Progressive distal muscle weakness and atrophy predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-vcp-mutation",
        "description": "Identification of pathogenic mutation in the VCP gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy-inclusion-bodies",
        "description": "Muscle biopsy showing rimmed vacuoles and inclusion bodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of similar myopathy or multisystem proteinopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography-myopathic-pattern",
        "description": "Electromyography demonstrating myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal muscle weakness with identification of pathogenic VCP mutation and supportive muscle biopsy findings",
    "notes": "Diagnosis may be supported by family history and EMG findings; multisystem involvement may be present."
  },
