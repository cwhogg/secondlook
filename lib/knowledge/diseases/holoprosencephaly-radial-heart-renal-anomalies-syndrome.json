        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-malformations",
        "description": "Congenital heart defects such as ventricular septal defect or atrial septal defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-anomalies",
        "description": "Structural renal anomalies including renal hypoplasia or agenesis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features such as hypotelorism or cleft lip/palate",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of holoprosencephaly plus radial ray defects and at least one major anomaly (cardiac or renal)",
    "notes": "Diagnosis is primarily clinical supported by imaging and genetic testing"
