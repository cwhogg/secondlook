  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Morphological Criteria for Large/Giant CMN",
    "criteria": [
      {
        "id": "size",
        "description": "Presence of a congenital melanocytic nevus measuring ≥20 cm in projected adult diameter",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-onset",
        "description": "Nevus present at birth or within the first few weeks of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nevus-characteristics",
        "description": "Pigmented, often irregularly shaped, with hypertrichosis and nodularity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "satellite-lesions",
        "description": "Presence of multiple smaller congenital nevi (satellite nevi) surrounding the main lesion",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-assessment",
        "description": "Evaluation for neurocutaneous melanosis or CNS involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of a congenital melanocytic nevus ≥20 cm in projected adult size with congenital onset and characteristic pigmentation",
    "notes": "Diagnosis is primarily clinical; imaging and neurological evaluation recommended to assess for associated neurocutaneous melanosis."
  },
