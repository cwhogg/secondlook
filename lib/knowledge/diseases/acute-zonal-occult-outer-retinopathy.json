        "Rapid spontaneous resolution"
      ]
    },
    {
      "diseaseId": "acute-retinal-necrosis",
      "distinguishingFeatures": [
        "Marked intraocular inflammation",
        "Progressive necrotizing retinitis",
        "Positive viral PCR testing"
      ]
    },
