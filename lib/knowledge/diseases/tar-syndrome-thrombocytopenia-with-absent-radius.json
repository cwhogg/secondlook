  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for TAR Syndrome",
    "criteria": [
      {
        "id": "bilateral-absent-radius",
        "description": "Bilateral absence of the radius bone confirmed by radiographic imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thrombocytopenia",
        "description": "Persistent thrombocytopenia with platelet counts typically below 50,000/µL in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "presence-of-thumb",
        "description": "Presence of both thumbs despite absent radius",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of compound heterozygous mutations or deletions involving RBM8A gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral absent radius with thrombocytopenia and presence of thumbs",
    "notes": "Genetic testing can support diagnosis but is not mandatory; absence of radius with thrombocytopenia and thumbs differentiates TAR from other radial aplasia syndromes."
  },
