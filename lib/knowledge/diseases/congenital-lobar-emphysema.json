  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Congenital Lobar Emphysema",
    "criteria": [
      {
        "id": "radiologic-overinflation",
        "description": "Radiologic evidence of hyperinflation of one or more pulmonary lobes with compression of adjacent lung tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-respiratory-distress",
        "description": "Clinical presentation with respiratory distress or recurrent respiratory symptoms in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of lobar overinflation such as bronchial obstruction or cystic lung disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bronchoscopy-findings",
        "description": "Bronchoscopic findings showing bronchial cartilage deficiency or bronchomalacia (supportive)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of radiologic lobar hyperinflation with clinical respiratory symptoms and exclusion of other causes",
    "notes": "Diagnosis is primarily clinical and radiological; histopathology may be confirmatory post-surgery."
  },
