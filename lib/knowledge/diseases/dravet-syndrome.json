      "Possible elevated lactate during status epilepticus"
    ],
    "imaging": [
      "Normal brain MRI early in disease",
      "Possible cerebral atrophy or hippocampal sclerosis in later stages"
    ],
    "genetic": [
      "Pathogenic variants in SCN1A gene in approximately 80% of cases"
    ],
    "other": [
      "Electroencephalogram (EEG) showing generalized spike-and-wave and polyspike discharges",
      "Prolonged seizures triggered by fever or hyperthermia"
    ]
