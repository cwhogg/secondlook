  "keyFindings": {
    "laboratory": [
      "Plasma free metanephrines and catecholamines (screening for pheochromocytoma)",
      "24-hour urine catecholamines and metanephrines",
      "Complete blood count (secondary polycythemia from hemangioblastoma)",
      "Serum creatinine and renal function",
      "Chromogranin A if pancreatic NET suspected"
    ],
    "imaging": [
      "MRI brain and spine with contrast (hemangioblastomas - enhancing with cysts)",
      "CT or MRI abdomen (renal cysts and tumors, pancreatic cysts and NETs, adrenal pheochromocytoma)",
      "CT temporal bone if endolymphatic sac tumor suspected",
      "Ophthalmoscopy / fluorescein angiography for retinal hemangioblastomas"
    ],
    "genetic": [
      "VHL gene mutations on chromosome 3p25-26",
      "Tumor suppressor gene (loss of function)",
      "Autosomal dominant inheritance with ~97% penetrance by age 65",
      "~80% inherited; ~20% de novo",
      "Type 1 (deletions/truncating) vs Type 2 (missense) genotype-phenotype correlation"
    ],
    "other": [
      "Annual dilated ophthalmoscopy starting at age 1-5",
      "Audiometry if endolymphatic sac tumor suspected",
      "Surveillance protocol recommended from childhood/adolescence"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sporadic-hemangioblastoma",
      "distinguishingFeatures": [
        "Sporadic cases are solitary, not multiple",
        "No family history",
        "No visceral tumors",
        "Older age at presentation",
        "No VHL germline mutation"
      ]
    },
    {
      "diseaseId": "hereditary-paraganglioma-pheochromocytoma-syndrome",
      "distinguishingFeatures": [
        "SDHx gene mutations (SDHB, SDHD, SDHC)",
        "Paragangliomas at extra-adrenal sites more common",
        "No hemangioblastomas",
        "No renal cell carcinoma (except SDHB)"
      ]
    },
    {
      "diseaseId": "tuberous-sclerosis-complex",
      "distinguishingFeatures": [
        "TSC has cortical tubers, not hemangioblastomas",
        "Angiomyolipomas (not clear cell RCC) in kidneys",
        "Skin findings: angiofibromas, ash-leaf spots",
        "TSC1/TSC2 mutations"
      ]
    },
    {
      "diseaseId": "hereditary-papillary-renal-cell-carcinoma",
      "distinguishingFeatures": [
        "MET gene mutations",
        "Papillary (not clear cell) histology",
        "No CNS hemangioblastomas",
        "No pheochromocytoma"
      ]
    }
  ],
  "redFlags": [
    "Posterior fossa mass with obstructive hydrocephalus (neurosurgical emergency)",
    "Pheochromocytoma crisis (hypertensive emergency)",
    "Renal cell carcinoma growing beyond 3 cm (surgical threshold in VHL)",
    "Retinal detachment from untreated retinal hemangioblastoma",
    "Sudden hearing loss from endolymphatic sac tumor hemorrhage"
  ],
