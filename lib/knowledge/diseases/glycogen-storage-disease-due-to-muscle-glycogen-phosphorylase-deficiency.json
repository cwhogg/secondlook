  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for McArdle Disease",
    "criteria": [
      {
        "id": "clinical-exercise-intolerance",
        "description": "Exercise intolerance with premature fatigue and muscle cramps during strenuous activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ischemic-exercise-test",
        "description": "Flat or decreased lactate response with normal ammonia increase during forearm ischemic exercise test",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing absent or markedly reduced muscle glycogen phosphorylase activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the PYGM gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "serum-creatine-kinase",
        "description": "Elevated resting serum creatine kinase levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical exercise intolerance plus either confirmatory muscle biopsy or genetic testing",
    "notes": "Genetic testing is increasingly used to confirm diagnosis; ischemic exercise test is less commonly performed now."
  },
