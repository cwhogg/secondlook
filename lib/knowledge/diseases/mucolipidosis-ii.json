  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for Mucolipidosis II",
    "criteria": [
      {
        "id": "lysosomal-enzyme-deficiency",
        "description": "Markedly elevated lysosomal enzymes in plasma due to defective mannose-6-phosphate tagging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Characteristic clinical features including coarse facial features, skeletal abnormalities, and developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the GNPTAB gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-findings",
        "description": "Radiographic evidence of dysostosis multiplex",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical features plus elevated plasma lysosomal enzymes and/or pathogenic GNPTAB variants",
    "notes": "Definitive diagnosis requires biochemical and/or genetic confirmation."
  },
