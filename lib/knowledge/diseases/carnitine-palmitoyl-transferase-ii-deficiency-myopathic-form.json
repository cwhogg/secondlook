  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for CPT II deficiency, myopathic form",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Recurrent episodes of exercise-induced myalgia, muscle stiffness, and rhabdomyolysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-assay",
        "description": "Reduced CPT II enzyme activity in muscle biopsy or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the CPT2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "creatine-kinase-elevation",
        "description": "Elevated serum creatine kinase (CK) levels during episodes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus either reduced enzyme activity or pathogenic CPT2 gene variants",
    "notes": "Muscle biopsy and genetic testing are essential for confirmation; enzyme assay may not always be available."
  },
