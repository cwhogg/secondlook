  "prevalence": {
    "estimate": "1 in 3,700 Ashkenazi Jewish births",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 5,
      "peak": 1
    },
