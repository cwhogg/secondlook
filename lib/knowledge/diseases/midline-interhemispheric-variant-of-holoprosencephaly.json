      "CDON (causative)",
      "NODAL (causative)",
      "DLL1 (causative)",
      "GAS1 (causative)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Prenatal ultrasound may show midline brain abnormalities",
      "Neurodevelopmental assessment critical for management"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "classic-holoprosencephaly",
      "distinguishingFeatures": [
        "Severe facial midline anomalies",
        "Complete or near-complete failure of forebrain cleavage",
        "More profound neurological impairment"
      ]
    },
    {
      "diseaseId": "agenesis-of-corpus-callosum",
      "distinguishingFeatures": [
        "Absence of midline fusion of cerebral hemispheres",
        "No partial fusion of posterior frontal and parietal lobes",
        "Different neuroimaging pattern"
      ]
    }
  ],
  "redFlags": [
    "Severe developmental delay or regression",
    "Refractory seizures",
    "Signs of increased intracranial pressure"
  ],
