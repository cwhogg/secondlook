  "keyFindings": {
    "laboratory": [
      "Peripheral blood smear showing marked poikilocytosis, microspherocytes, and elliptocytes",
      "Elevated reticulocyte count",
      "Elevated indirect bilirubin",
      "Reduced haptoglobin",
      "Increased lactate dehydrogenase (LDH)"
    ],
    "imaging": [
      "Ultrasound showing splenomegaly",
      "Ultrasound evidence of gallstones"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Thermal sensitivity test positive with increased red cell fragmentation at 45°C"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hereditary-spherocytosis",
      "distinguishingFeatures": [
        "Predominance of spherocytes without extreme poikilocytosis",
        "Less thermal sensitivity",
        "Usually less severe hemolysis"
      ]
    },
    {
      "diseaseId": "hereditary-elliptocytosis",
      "distinguishingFeatures": [
        "Predominance of elliptocytes without marked thermal sensitivity",
        "Usually milder anemia",
        "Less red cell fragmentation"
      ]
    },
    {
      "diseaseId": "autoimmune-hemolytic-anemia",
      "distinguishingFeatures": [
        "Positive direct antiglobulin (Coombs) test",
        "Presence of autoantibodies",
        "No characteristic thermal sensitivity or membrane protein mutations"
      ]
    }
  ],
  "redFlags": [
    "Severe anemia requiring frequent transfusions",
    "Splenomegaly with risk of splenic rupture",
    "Aplastic crisis triggered by infections"
  ],
