  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible transient neonatal hypoglycemia"
    ],
    "imaging": [
      "Delayed bone age on hand/wrist X-ray",
      "Echocardiogram may reveal septal defects",
      "Renal ultrasound may show unilateral hypoplasia"
    ],
    "genetic": [
      "Microduplication of chromosome 7p11.2p13 detected by chromosomal microarray or array CGH",
      "Exclusion of 11p15 imprinting defects and maternal uniparental disomy 7",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Clinical assessment of growth parameters and body asymmetry",
      "Feeding evaluation in infancy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "classic-silver-russell-syndrome",
      "distinguishingFeatures": [
        "11p15 imprinting defects or maternal uniparental disomy 7",
        "Absence of 7p11.2p13 microduplication",
        "Similar growth retardation but different genetic etiology"
      ]
    },
    {
      "diseaseId": "beckwith-wiedemann-syndrome",
      "distinguishingFeatures": [
        "Overgrowth rather than growth retardation",
        "Macrosomia and macroglossia",
        "11p15 abnormalities but opposite clinical phenotype"
      ]
    }
  ],
  "redFlags": [
