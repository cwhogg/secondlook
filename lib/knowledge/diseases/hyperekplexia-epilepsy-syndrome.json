  "diagnosticCriteria": {
    "formalCriteriaName": "Hyperekplexia-Epilepsy Diagnostic Criteria",
    "criteria": [
      {
        "id": "startle-reflex",
        "description": "Exaggerated startle reflex to unexpected stimuli",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epileptic-seizures",
        "description": "Presence of epileptic seizures confirmed by EEG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glycine-receptor-mutation",
        "description": "Identification of pathogenic mutation in GLRA1 or related genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-neuromuscular-disease",
        "description": "Exclusion of other neuromuscular disorders causing startle",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of hyperekplexia or epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of exaggerated startle reflex and epileptic seizures confirmed by EEG",
    "notes": "Genetic testing supports diagnosis but is not mandatory"
  },
