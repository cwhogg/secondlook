  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Elevated creatine kinase (mildly elevated in some cases)"
    ],
    "imaging": [
      "Muscle MRI may show fatty infiltration in distal muscles",
      "Nerve ultrasound may reveal nerve enlargement"
    ],
    "genetic": [
      "HINT1 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography (EMG) demonstrating neuromyotonic discharges and spontaneous muscle fiber activity",
      "Nerve conduction studies showing reduced amplitude with preserved conduction velocity"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "acquired-neuromyotonia",
      "distinguishingFeatures": [
        "Usually adult onset",
        "Often associated with autoimmune or paraneoplastic causes",
        "No genetic inheritance pattern"
      ]
    },
    {
      "diseaseId": "charcot-marie-tooth-disease-type-2",
      "distinguishingFeatures": [
        "Variable inheritance patterns (dominant, recessive, or X-linked)",
        "Lacks neuromyotonia",
        "Different genetic mutations"
      ]
    },
    {
      "diseaseId": "hereditary-motor-neuronopathy",
      "distinguishingFeatures": [
        "Predominantly motor involvement without sensory loss",
        "Absence of neuromyotonia",
        "Different electrophysiological findings"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of muscle weakness and atrophy",
    "Respiratory insufficiency or difficulty breathing",
    "Sudden onset of severe muscle stiffness or cramps"
  ],
