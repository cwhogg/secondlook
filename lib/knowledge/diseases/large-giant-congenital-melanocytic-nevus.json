  "differentialDiagnoses": [
    {
      "diseaseId": "nevus-spilus",
      "distinguishingFeatures": [
        "Speckled lentiginous nevus with smaller pigmented macules on a tan background",
        "Usually smaller and less hairy than giant CMN"
      ]
    },
    {
      "diseaseId": "nevus-of-oto",
      "distinguishingFeatures": [
        "Blue-gray patch typically involving the face and periauricular area",
        "Not congenital and lacks hypertrichosis"
      ]
    },
    {
      "diseaseId": "spitz-nevus",
      "distinguishingFeatures": [
        "Usually smaller, dome-shaped, pink to red papules or nodules",
        "Rapid growth but benign histology"
      ]
    }
  ],
