  "diagnosticCriteria": {
    "formalCriteriaName": "2013 ACR/EULAR Classification Criteria for Systemic Sclerosis",
    "criteria": [
      {
        "id": "ssc-c1",
        "description": "Skin thickening of the fingers of both hands extending proximal to the MCPs (sufficient criterion, score 9)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ssc-c2",
        "description": "Skin thickening of the fingers: puffy fingers (score 2) or sclerodactyly distal to MCPs (score 4)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ssc-c3",
        "description": "Fingertip lesions: digital tip ulcers (score 2) or fingertip pitting scars (score 3)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ssc-c4",
        "description": "Telangiectasia (score 2)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ssc-c5",
        "description": "Abnormal nailfold capillaries (score 2)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ssc-c6",
        "description": "Pulmonary arterial hypertension and/or interstitial lung disease (score 2)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ssc-c7",
        "description": "Raynaud's phenomenon (score 3)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ssc-c8",
        "description": "SSc-related autoantibodies: anti-centromere, anti-Scl-70 (anti-topoisomerase I), or anti-RNA polymerase III (score 3)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Total score >= 9 classifies as SSc. Skin thickening proximal to MCPs is a sufficient criterion alone (9 points). Otherwise, sum individual item scores (higher of sub-items counts).",
    "notes": "Two major subsets: limited cutaneous SSc (lcSSc, skin involvement distal to elbows/knees, face) and diffuse cutaneous SSc (dcSSc, proximal skin involvement). CREST = Calcinosis, Raynaud's, Esophageal dysmotility, Sclerodactyly, Telangiectasia."
  },
