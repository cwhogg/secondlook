  "diagnosticCriteria": {
    "formalCriteriaName": "Udd Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Adult-onset distal muscle weakness predominantly affecting the anterior tibial muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the TTN gene, especially in the last exon (exon 364)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing myopathic changes with rimmed vacuoles and absence of significant inflammation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "EMG demonstrating myopathic changes with occasional fibrillation potentials",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of adult-onset distal tibial muscle weakness plus either pathogenic TTN mutation or characteristic muscle biopsy findings",
    "notes": "Genetic confirmation is considered gold standard; muscle biopsy and clinical features support diagnosis."
  },
