    "criteria": [
      {
        "id": "dihydrorhodamine-test",
        "description": "Abnormal dihydrorhodamine (DHR) flow cytometry test showing defective neutrophil oxidative burst",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in NADPH oxidase complex genes (e.g., CYBB, CYBA, NCF1, NCF2, NCF4)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "granulomatous-inflammation",
        "description": "Histopathological evidence of noncaseating granulomas in gastrointestinal tissue biopsies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-history",
        "description": "Recurrent bacterial and fungal infections with gastrointestinal symptoms such as obstruction or inflammation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of abnormal DHR test or genetic confirmation plus granulomatous inflammation in GI tissue",
    "notes": "Diagnosis requires integration of clinical, laboratory, and genetic findings."
  },
