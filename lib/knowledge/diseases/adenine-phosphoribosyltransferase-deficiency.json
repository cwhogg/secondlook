  "diagnosticCriteria": {
    "formalCriteriaName": "APRT Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "crystal-identification",
        "description": "Identification of 2,8-dihydroxyadenine crystals in urine or renal calculi",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-assay",
        "description": "Demonstration of deficient APRT enzyme activity in erythrocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Detection of pathogenic variants in the APRT gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "History of recurrent nephrolithiasis or unexplained renal failure",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least two major criteria including enzyme assay or genetic testing plus crystal identification",
    "notes": "Genetic testing is confirmatory; enzyme assay may be unavailable in some centers."
  },
