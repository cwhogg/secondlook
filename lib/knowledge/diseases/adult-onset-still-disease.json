{
  "id": "adult-onset-still-disease",
  "name": "Adult-Onset Still Disease",
  "aliases": [
    "AOSD",
    "Still Disease (Adult)",
    "Wissler-Fanconi Syndrome"
  ],
  "icd10Codes": [
    "M06.1"
  ],
  "omimId": "604302",
  "orphanetId": "829",
  "prevalence": {
    "estimate": "1 to 34 per 1,000,000",
    "range": "0.0001%-0.003%",
    "classification": "rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 16,
      "max": 45,
      "peak": 30
    },
    "sexPredilection": "slight-female",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Yamaguchi Criteria (Most Sensitive)",
    "criteria": [
      {
        "id": "aosd-maj1",
        "description": "Fever >= 39°C lasting >= 1 week",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aosd-maj2",
        "description": "Arthralgias or arthritis lasting >= 2 weeks",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aosd-maj3",
        "description": "Typical evanescent salmon-pink macular rash",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aosd-maj4",
        "description": "Leukocytosis >= 10,000/microL with >= 80% granulocytes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aosd-min1",
        "description": "Sore throat",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "aosd-min2",
        "description": "Lymphadenopathy and/or splenomegaly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "aosd-min3",
        "description": "Liver dysfunction (elevated transaminases)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "aosd-min4",
        "description": "Negative ANA and RF",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Yamaguchi: >= 5 criteria (at least 2 major) after exclusion of infections, malignancies, and other autoimmune diseases. Diagnosis is one of exclusion.",
    "notes": "Markedly elevated ferritin (often > 1000 ng/mL) with glycosylated ferritin fraction < 20% is highly suggestive. Three patterns: monocyclic (self-limited), polycyclic (relapsing), chronic articular."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Quotidian (daily) spiking fever >= 39°C with return to baseline",
        "frequency": 0.95,
        "bodySystem": "constitutional",
        "notes": "Typically spikes in evening with morning defervescence; double quotidian pattern"
      },
      {
        "symptomName": "Evanescent salmon-pink macular rash",
        "frequency": 0.85,
        "bodySystem": "dermatological",
        "notes": "Non-pruritic, appears with fever spikes, trunk and proximal extremities; may be Koebner-positive"
      }
    ],
    "common": [
      {
        "symptomName": "Arthralgias and/or arthritis",
        "snomedCode": "57676002",
        "frequency": 0.9,
        "bodySystem": "musculoskeletal",
        "notes": "Initially oligoarticular; may progress to destructive polyarthritis (wrists, knees)"
      },
      {
        "symptomName": "Sore throat (pharyngitis)",
        "snomedCode": "162397003",
        "frequency": 0.7,
        "bodySystem": "constitutional",
        "notes": "Often the earliest symptom; culture-negative"
      },
      {
        "symptomName": "Myalgias",
        "snomedCode": "68962001",
        "frequency": 0.55,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Lymphadenopathy",
        "snomedCode": "30746006",
        "frequency": 0.5,
        "bodySystem": "immunological"
      }
    ],
    "occasional": [
      {
        "symptomName": "Hepatomegaly/splenomegaly",
        "snomedCode": "80515008",
        "frequency": 0.4,
        "bodySystem": "gastrointestinal"
      },
      {
        "symptomName": "Pleuritis/pericarditis (serositis)",
        "frequency": 0.3,
        "bodySystem": "respiratory"
      },
      {
        "symptomName": "Abdominal pain",
        "snomedCode": "21522001",
        "frequency": 0.25,
        "bodySystem": "gastrointestinal"
      },
      {
        "symptomName": "Weight loss",
        "snomedCode": "89362005",
        "frequency": 0.35,
        "bodySystem": "constitutional"
      }
    ],
    "rare": [
      {
        "symptomName": "Macrophage activation syndrome (MAS)/reactive HLH",
        "frequency": 0.12,
        "bodySystem": "hematological",
        "notes": "Life-threatening complication; characterized by pancytopenia, liver failure, DIC, hyperferritinemia > 10,000"
      },
      {
        "symptomName": "Disseminated intravascular coagulation (DIC)",
        "frequency": 0.05,
        "bodySystem": "hematological"
      },
      {
        "symptomName": "Myocarditis",
        "frequency": 0.03,
        "bodySystem": "cardiovascular"
      },
      {
        "symptomName": "Pulmonary arterial hypertension",
        "frequency": 0.02,
        "bodySystem": "respiratory"
      }
    ]
  },
  "systemsAffected": [
    "musculoskeletal",
    "dermatological",
    "immunological",
    "gastrointestinal",
    "respiratory",
    "cardiovascular",
    "hematological"
  ],
  "keyFindings": {
    "laboratory": [
      "Markedly elevated ferritin (often > 1,000 ng/mL; can exceed 10,000)",
      "Glycosylated ferritin fraction < 20% (highly specific for AOSD)",
      "Leukocytosis with neutrophilia (WBC > 10,000, often > 15,000)",
      "Elevated ESR and CRP",
      "Elevated liver enzymes (AST, ALT, LDH)",
      "Negative ANA and RF",
      "Elevated IL-18 (research/specialized test)"
    ],
    "imaging": [
      "Joint X-rays: non-erosive initially; carpometacarpal fusion may develop in chronic articular form",
      "CT chest: pleural/pericardial effusions, lymphadenopathy",
      "PET-CT: diffuse FDG uptake in lymph nodes, spleen, bone marrow"
    ],
    "genetic": [
      "HLA-B17, HLA-B18, HLA-B35, HLA-DR2 associations",
      "IL-18 gene polymorphisms",
      "No single causative gene"
    ],
    "other": [
      "Blood cultures and extensive infectious workup (mandatory to exclude infection)",
      "Lymph node biopsy to exclude lymphoma (reactive pattern in AOSD)",
      "Bone marrow biopsy if MAS/HLH suspected (hemophagocytosis)",
      "Skin biopsy: perivascular neutrophilic infiltrate (non-specific)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "SLE has positive ANA, anti-dsDNA, specific rash patterns",
        "SLE more commonly has nephritis, photosensitivity"
      ]
    },
    {
      "diseaseId": "lymphoma",
      "distinguishingFeatures": [
        "Lymphoma diagnosed by lymph node biopsy showing atypical cells",
        "Lymphoma has more persistent rather than quotidian fever pattern"
      ]
    },
    {
      "diseaseId": "familial-mediterranean-fever",
      "distinguishingFeatures": [
        "FMF has shorter febrile episodes (1-3 days)",
        "FMF confirmed by MEFV gene mutations",
        "FMF more common in Mediterranean populations"
      ]
    }
  ],
  "redFlags": [
    "Markedly elevated ferritin > 10,000 with pancytopenia (MAS/HLH)",
    "DIC (falling fibrinogen, rising D-dimer, thrombocytopenia)",
    "Liver failure",
    "Rapidly progressive destructive arthritis",
    "Persistent high fever unresponsive to NSAIDs or steroids"
  ],
  "specialistType": [
    "Rheumatologist",
    "Hematologist",
    "Internal Medicine",
    "Infectious Disease"
  ],
