  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Isolated 17,20-Lyase Deficiency",
    "criteria": [
      {
        "id": "biochemical-profile",
        "description": "Elevated 17-hydroxypregnenolone and 17-hydroxyprogesterone with low or absent sex steroids (androstenedione, testosterone) indicating isolated 17,20-lyase deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "46,XY individuals presenting with ambiguous genitalia or undervirilization at birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in CYP17A1 gene affecting 17,20-lyase activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-mineralocorticoid-function",
        "description": "Normal cortisol and mineralocorticoid levels distinguishing isolated 17,20-lyase deficiency from combined 17α-hydroxylase/17,20-lyase deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biochemical profile consistent with isolated 17,20-lyase deficiency plus clinical presentation of 46,XY undervirilization, confirmed by genetic testing of CYP17A1",
    "notes": "Exclusion of combined 17α-hydroxylase/17,20-lyase deficiency is essential for diagnosis."
  },
