  "diagnosticCriteria": {
    "formalCriteriaName": "ILAR Classification Criteria for Juvenile Idiopathic Arthritis",
    "criteria": [
      {
        "id": "arthritis-duration",
        "description": "Arthritis in one to four joints during the first six months of disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-of-onset",
        "description": "Onset before 16 years of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-conditions",
        "description": "Exclusion of other causes of arthritis such as infectious, neoplastic, or other rheumatic diseases",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-rheumatoid-factor",
        "description": "Negative rheumatoid factor on at least two occasions at least three months apart",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "uveitis-screening",
        "description": "Screening for asymptomatic chronic anterior uveitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Arthritis affecting 1-4 joints during the first 6 months of disease onset before age 16, with exclusion of other causes",
    "notes": "Rheumatoid factor positivity excludes oligoarticular subtype and suggests polyarticular JIA."
  },
