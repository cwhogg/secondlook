  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Dystrophic Epidermolysis Bullosa Pruriginosa",
    "criteria": [
      {
        "id": "clinical-prurigo-like-lesions",
        "description": "Presence of prurigo-like nodular and lichenified skin lesions predominantly on extensor surfaces",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "subepidermal-blistering",
        "description": "Histopathological evidence of subepidermal blister formation with dermal fibrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "col7a1-mutation",
        "description": "Identification of pathogenic mutations in the COL7A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of dystrophic epidermolysis bullosa or similar blistering disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Immunofluorescence mapping showing reduced or absent type VII collagen at the dermoepidermal junction",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of prurigo-like nodular lesions with histopathological subepidermal blistering and confirmed COL7A1 mutation or immunofluorescence evidence of type VII collagen deficiency",
    "notes": "Diagnosis is confirmed by genetic testing and immunofluorescence; clinical presentation may overlap with other pruritic dermatoses."
  },
