  "keyFindings": {
    "laboratory": [
      "Mosaic trisomy 7 detected by karyotyping or fluorescence in situ hybridization (FISH) in fibroblasts or other tissues",
      "Normal karyotype in peripheral blood lymphocytes in some cases"
    ],
    "imaging": [
      "Echocardiography revealing congenital heart defects",
      "Renal ultrasound showing structural anomalies",
      "Brain MRI may be normal or show nonspecific findings"
    ],
    "genetic": [
      "Presence of an extra copy of chromosome 7 in a subset of cells (mosaicism)",
      "Variable tissue distribution of trisomic cells"
    ],
    "other": [
      "Skin biopsy may reveal pigmentary mosaicism correlating with chromosomal mosaicism"
    ]
  },
