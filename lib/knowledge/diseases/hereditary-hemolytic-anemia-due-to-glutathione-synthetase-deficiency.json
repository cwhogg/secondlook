        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of neurological symptoms such as developmental delay or seizures",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced glutathione synthetase enzyme activity plus chronic hemolytic anemia and metabolic acidosis",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if enzyme assay and clinical features are definitive."
