  "keyFindings": {
    "laboratory": [
      "Positive anti-SSA (Ro) and/or anti-SSB (La) antibodies",
      "Elevated ESR and hypergammaglobulinemia",
      "Positive rheumatoid factor in some cases",
      "Mild anemia and leukopenia"
    ],
    "imaging": [
      "Salivary gland ultrasonography showing hypoechoic areas and glandular inhomogeneity",
      "Chest CT showing interstitial lung disease patterns"
    ],
    "genetic": [
      "Associations with HLA-DR and HLA-DQ alleles"
    ],
    "other": [
      "Positive Schirmer’s test",
      "Abnormal ocular staining with fluorescein or lissamine green",
      "Focus score ≥1 on labial salivary gland biopsy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "secondary-sj-gren-syndrome",
      "distinguishingFeatures": [
        "Presence of underlying autoimmune disease such as rheumatoid arthritis or lupus",
        "Additional systemic manifestations related to primary autoimmune disorder"
      ]
    },
    {
      "diseaseId": "sicca-syndrome-secondary-to-medications",
      "distinguishingFeatures": [
        "History of medication use causing dryness (e.g., anticholinergics)",
        "Absence of autoantibodies and histopathologic findings"
      ]
    },
    {
      "diseaseId": "sarcoidosis",
      "distinguishingFeatures": [
        "Noncaseating granulomas on biopsy",
        "Multisystem involvement including lungs and lymph nodes",
        "Elevated serum ACE levels"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive parotid gland swelling",
    "Unexplained weight loss and night sweats",
    "Development of persistent lymphadenopathy or splenomegaly"
  ],
  "specialistType": [
    "Rheumatologist",
    "Ophthalmologist",
    "Otolaryngologist"
  ],
