  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnostic criteria for Stüve-Wiedemann syndrome",
    "criteria": [
      {
        "id": "congenital-bone-dysplasia",
        "description": "Presence of congenital bowing and dysplasia of long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autonomic-dysfunction",
        "description": "Severe autonomic dysfunction including temperature instability and respiratory distress",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lifa1-mutation",
        "description": "Identification of pathogenic mutations in the LIFR gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "feeding-difficulties",
        "description": "Neonatal feeding difficulties and failure to thrive",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital bone dysplasia, autonomic dysfunction, and pathogenic LIFR mutation",
    "notes": "Genetic testing is essential for confirmation; clinical features may overlap with other skeletal dysplasias."
  },
