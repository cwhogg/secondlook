  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Echocardiographic Diagnostic Criteria for Tetralogy of Fallot",
    "criteria": [
      {
        "id": "ventricular-septal-defect",
        "description": "Presence of a large, malaligned ventricular septal defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-stenosis",
        "description": "Obstruction of right ventricular outflow tract or pulmonary valve stenosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "overriding-aorta",
        "description": "Aortic root overriding the ventricular septal defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "right-ventricular-hypertrophy",
        "description": "Right ventricular hypertrophy evident on imaging or ECG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cyanosis",
        "description": "Central cyanosis especially during episodes of hypoxia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all four major anatomical features: ventricular septal defect, pulmonary stenosis, overriding aorta, and right ventricular hypertrophy",
    "notes": "Diagnosis is confirmed by echocardiography and clinical presentation; cardiac MRI and cardiac catheterization may be used for further assessment."
  },
