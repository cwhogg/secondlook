  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Lowe Syndrome",
    "criteria": [
      {
        "id": "congenital-cataracts",
        "description": "Presence of bilateral congenital cataracts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-tubular-dysfunction",
        "description": "Evidence of renal tubular dysfunction (e.g., Fanconi syndrome)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "OCRL-gene-mutation",
        "description": "Identification of pathogenic variants in the OCRL gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Generalized hypotonia in infancy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: bilateral congenital cataracts, intellectual disability, and renal tubular dysfunction",
    "notes": "Genetic testing for OCRL mutations can confirm diagnosis but is not mandatory if clinical criteria are met."
  },
