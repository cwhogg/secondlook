  "keyFindings": {
    "laboratory": [
      "Elevated LDL cholesterol and triglycerides",
      "Mild anemia",
      "Normal inflammatory markers"
    ],
    "imaging": [
      "Clavicular hypoplasia",
      "Acroosteolysis of distal phalanges",
      "Delayed bone age",
      "Vascular calcifications on CT angiography"
    ],
    "genetic": [
      "Heterozygous de novo mutation in LMNA gene (commonly c.1824C>T, p.G608G)"
    ],
    "other": [
      "Skin biopsy showing dermal fibrosis and loss of subcutaneous fat"
    ]
  },
