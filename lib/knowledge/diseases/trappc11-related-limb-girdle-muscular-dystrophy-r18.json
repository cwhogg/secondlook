  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed diagnostic criteria for TRAPPC11-related LGMD R18",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness predominantly affecting limb-girdle muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes with variable fiber size, fibrosis, and fatty replacement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic biallelic variants in the TRAPPC11 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-ck",
        "description": "Elevated serum creatine kinase (CK) levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "Electromyography showing myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal limb-girdle muscle weakness plus muscle biopsy findings consistent with dystrophy and confirmation of biallelic pathogenic TRAPPC11 variants",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical and histopathological features overlap with other LGMD subtypes."
  },
