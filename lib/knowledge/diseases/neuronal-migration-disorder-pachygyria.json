  "diagnosticCriteria": {
    "formalCriteriaName": "Neuronal Migration Disorder Diagnostic Criteria",
    "criteria": [
      {
        "id": "imaging-pachygyria",
        "description": "MRI evidence of pachygyria characterized by broad, thickened gyri and abnormal cortical layering",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-seizures",
        "description": "Presence of early-onset seizures or epilepsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with neuronal migration (e.g., LIS1, DCX)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "MRI evidence of pachygyria plus presence of seizures and developmental delay",
    "notes": "Genetic testing supports diagnosis but is not mandatory"
  },
