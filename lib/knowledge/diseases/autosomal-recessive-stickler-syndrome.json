  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Stickler Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "ocular-manifestations",
        "description": "Presence of high myopia, vitreoretinal degeneration, or retinal detachment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-features",
        "description": "Midfacial hypoplasia, cleft palate, or micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "arthropathy",
        "description": "Early-onset arthropathy with joint hypermobility and osteoarthritis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in COL9A1, COL9A2, or COL9A3 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural or conductive hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical features (ocular manifestations, craniofacial features, arthropathy) plus genetic confirmation of biallelic pathogenic variants",
    "notes": "Genetic testing is essential to confirm autosomal recessive inheritance and differentiate from dominant forms."
  },
