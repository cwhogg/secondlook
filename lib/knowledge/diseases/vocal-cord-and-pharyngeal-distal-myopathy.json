  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Vocal Cord and Pharyngeal Distal Myopathy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive distal muscle weakness with prominent vocal cord and pharyngeal muscle involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing myopathic changes with rimmed vacuoles and fiber size variability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in genes associated with distal myopathies (e.g., GNE, MYH7)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "EMG demonstrating myopathic motor unit potentials with fibrillation potentials",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-neuropathy",
        "description": "Exclusion of neuropathic causes by nerve conduction studies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal muscle weakness with vocal cord and pharyngeal involvement plus confirmatory muscle biopsy and/or genetic testing",
    "notes": "Diagnosis requires exclusion of other neuromuscular disorders with similar presentations."
  },
