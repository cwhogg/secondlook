  "diagnosticCriteria": {
    "formalCriteriaName": "Pemphigus erythematosus diagnostic criteria",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of erythematous scaly plaques with superficial blistering predominantly on the seborrheic areas of the face and upper trunk",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological evidence of suprabasal acantholysis with epidermal clefting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence",
        "description": "Direct immunofluorescence showing intercellular IgG and C3 deposits in the epidermis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serology",
        "description": "Presence of circulating anti-desmoglein 1 autoantibodies detected by ELISA",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical features, histopathology, and immunofluorescence) must be met for diagnosis",
    "notes": "Overlap features with lupus erythematosus may be present; serological testing for ANA may be supportive"
  },
