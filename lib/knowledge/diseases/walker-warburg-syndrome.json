  "diagnosticCriteria": {
    "formalCriteriaName": "Walker-Warburg Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cobblestone-lissencephaly",
        "description": "Presence of cobblestone lissencephaly on brain imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscular-dystrophy",
        "description": "Congenital muscular dystrophy with elevated serum creatine kinase",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-malformations",
        "description": "Severe ocular malformations including retinal dysplasia or microphthalmia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic variants in genes such as POMT1, POMT2, or FKRP",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: cobblestone lissencephaly, congenital muscular dystrophy, and severe ocular malformations",
    "notes": "Genetic testing supports diagnosis but is not mandatory if clinical and imaging criteria are met."
  },
