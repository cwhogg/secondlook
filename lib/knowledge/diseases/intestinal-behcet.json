  "diagnosticCriteria": {
    "formalCriteriaName": "International Study Group Criteria for Behcet Disease with GI Involvement",
    "criteria": [
      {
        "id": "ib-maj1",
        "description": "Recurrent oral aphthous ulcers (>= 3 episodes in 12 months)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ib-maj2",
        "description": "Typical intestinal ulcerations (deep, oval/round, discrete ulcers, often in ileocecal region)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ib-min1",
        "description": "Genital ulcers (recurrent)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ib-min2",
        "description": "Eye lesions (anterior/posterior uveitis, retinal vasculitis)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ib-min3",
        "description": "Skin lesions (erythema nodosum, papulopustular lesions, pseudofolliculitis)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ib-min4",
        "description": "Positive pathergy test",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Recurrent oral ulceration plus characteristic intestinal ulcerations on endoscopy, in the context of other Behcet manifestations. Must exclude Crohn's disease and other causes of intestinal ulceration.",
    "notes": "Intestinal involvement occurs in 3-25% of Behcet patients (higher in East Asia). Ileocecal region is most commonly affected. Deep ulcers carry perforation risk."
  },
