  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for DSD-Intellectual Disability Syndrome",
    "criteria": [
      {
        "id": "genital-anomalies",
        "description": "Presence of ambiguous or atypical external genitalia consistent with difference of sex development",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Confirmed intellectual disability ranging from mild to severe",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with DSD and intellectual disability",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hormonal-assessment",
        "description": "Abnormal sex steroid hormone profiles consistent with gonadal dysgenesis or dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "dysmorphic-features",
        "description": "Presence of additional dysmorphic facial or skeletal features",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of ambiguous genitalia and confirmed intellectual disability with or without genetic confirmation",
    "notes": "Genetic testing is recommended to support diagnosis and guide management."
  },
