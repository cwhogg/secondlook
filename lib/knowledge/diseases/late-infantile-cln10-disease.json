    "formalCriteriaName": "Diagnostic criteria for Late Infantile Neuronal Ceroid Lipofuscinosis",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive psychomotor regression with onset in late infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of deficient cathepsin D enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic biallelic variants in the CTSD gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electron-microscopy",
        "description": "Presence of characteristic granular osmiophilic deposits in skin or conjunctival biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive psychomotor regression plus either enzyme deficiency or pathogenic CTSD gene variants",
    "notes": "Genetic confirmation is considered definitive; enzyme assay supports diagnosis."
  },
