  "differentialDiagnoses": [
    {
      "diseaseId": "polymorphic-light-eruption",
      "distinguishingFeatures": [
        "Delayed onset of lesions (hours to days after sun exposure)",
        "Lesions are papular or vesicular rather than urticarial wheals",
        "Negative immediate phototesting"
      ]
    },
    {
      "diseaseId": "chronic-actinic-dermatitis",
      "distinguishingFeatures": [
        "Chronic eczematous lesions rather than urticaria",
        "Often affects older males",
        "Positive photopatch testing"
      ]
    },
    {
      "diseaseId": "lupus-erythematosus",
      "distinguishingFeatures": [
        "Presence of systemic symptoms and autoantibodies",
        "Photosensitive rash with different morphology",
        "Histopathology showing interface dermatitis"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression to systemic anaphylaxis after sun exposure",
    "Persistent angioedema involving airway or face",
    "Failure to respond to standard antihistamine therapy"
