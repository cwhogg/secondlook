  "diagnosticCriteria": {
    "formalCriteriaName": "Post-Traumatic Hypopituitarism Diagnostic Criteria",
    "criteria": [
      {
        "id": "history-of-head-trauma",
        "description": "Documented history of moderate to severe traumatic brain injury",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pituitary-hormone-deficiency",
        "description": "Biochemical evidence of deficiency in one or more anterior pituitary hormones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-pituitary-abnormalities",
        "description": "MRI evidence of pituitary stalk injury, hemorrhage, or atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features-consistent",
        "description": "Presence of clinical features consistent with hypopituitarism such as secondary adrenal insufficiency or hypothyroidism",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "History of traumatic brain injury plus biochemical evidence of pituitary hormone deficiency with or without supportive imaging findings",
    "notes": "Diagnosis requires exclusion of other causes of hypopituitarism."
  },
