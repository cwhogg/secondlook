  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electroretinographic Diagnostic Criteria for Cone-Rod Dystrophy",
    "criteria": [
      {
        "id": "cone-dysfunction",
        "description": "Evidence of predominant cone photoreceptor dysfunction on electroretinography (ERG)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rod-dysfunction",
        "description": "Subsequent rod photoreceptor dysfunction demonstrated by ERG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fundus-changes",
        "description": "Characteristic fundus changes including macular atrophy and pigmentary alterations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in known CRD-associated genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "visual-field-defects",
        "description": "Central visual field loss progressing to peripheral field constriction",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of cone photoreceptor dysfunction and rod photoreceptor dysfunction on ERG along with characteristic fundus changes",
    "notes": "Genetic testing is supportive but not mandatory for diagnosis."
  },
