  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Geleophysic Dysplasia",
    "criteria": [
      {
        "id": "short-stature",
        "description": "Severe short stature with disproportionate short limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facies",
        "description": "Distinctive facial features including round face, full cheeks, and upturned nose",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-valve-disease",
        "description": "Progressive cardiac valvular thickening leading to stenosis or insufficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-findings",
        "description": "Radiographic evidence of cone-shaped epiphyses and delayed bone age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tracheal-bronchial-stenosis",
        "description": "Presence of tracheal or bronchial stenosis causing respiratory symptoms",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in ADAMTSL2 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical criteria (short stature with disproportionate limbs, characteristic facial features, and cardiac valvular disease) plus supportive radiological findings",
    "notes": "Genetic testing for ADAMTSL2 mutations can confirm diagnosis but is not mandatory if clinical and radiological criteria are met."
  },
