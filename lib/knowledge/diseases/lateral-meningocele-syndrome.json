  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Lateral Meningocele Syndrome",
    "criteria": [
      {
        "id": "lateral-meningoceles",
        "description": "Presence of multiple lateral meningoceles confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including hypertelorism, downslanting palpebral fissures, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "connective-tissue-features",
        "description": "Connective tissue abnormalities such as joint hypermobility and hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-anomalies",
        "description": "Skeletal abnormalities including scoliosis and vertebral anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in NOTCH3 gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple lateral meningoceles plus at least two major clinical features (craniofacial dysmorphism and skeletal anomalies) or confirmed NOTCH3 pathogenic variant",
    "notes": "Genetic testing supports diagnosis but is not mandatory if clinical and radiological features are definitive."
  },
