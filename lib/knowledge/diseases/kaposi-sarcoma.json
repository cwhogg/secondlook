  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and histopathological diagnosis of Kaposi sarcoma",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of spindle cell proliferation with slit-like vascular spaces on biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hhv8-detection",
        "description": "Detection of Human Herpesvirus 8 (HHV-8) DNA or latent nuclear antigen in lesion tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-lesions",
        "description": "Characteristic violaceous, red, or brown macules, plaques, or nodules on skin or mucosa",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-support",
        "description": "Imaging evidence of visceral involvement (e.g., chest CT showing pulmonary nodules)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation with HHV-8 detection and compatible clinical lesions",
    "notes": "Diagnosis requires biopsy confirmation; clinical presentation alone is insufficient."
  },
