  "diagnosticCriteria": {
    "formalCriteriaName": "Brauer Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "facial-dermal-lesions",
        "description": "Presence of bilateral, symmetrical, well-demarcated facial dermal hypoplasia or aplasia mainly affecting the temporal and zygomatic regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-malformations",
        "description": "Associated craniofacial anomalies such as cleft lip and/or palate, micrognathia, or ear malformations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Histopathological confirmation of dermal hypoplasia in affected facial skin",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Bilateral symmetrical facial dermal hypoplasia plus at least one craniofacial malformation",
    "notes": "Genetic testing may support diagnosis but is not definitive due to limited known mutations."
  },
