  "diagnosticCriteria": {
    "formalCriteriaName": "Acrocapitofemoral Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "short-limbs",
        "description": "Shortening of the limbs with disproportionate shortening of the femoral neck and distal phalanges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pelvic-abnormalities",
        "description": "Characteristic radiographic abnormalities of the pelvis including hypoplastic femoral heads and irregular acetabula",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development and intelligence",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-extra-skeletal-features",
        "description": "Lack of significant extraskeletal abnormalities such as organ malformations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (short limbs with femoral neck involvement and pelvic radiographic abnormalities) with supportive clinical features",
    "notes": "Diagnosis is primarily clinical supported by characteristic radiographic findings; genetic testing may assist but specific gene not well defined."
  },
