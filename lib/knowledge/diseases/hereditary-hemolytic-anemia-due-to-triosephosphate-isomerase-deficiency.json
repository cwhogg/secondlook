  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Markedly reduced triosephosphate isomerase enzyme activity in erythrocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the TPI1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of chronic hemolytic anemia with neurological symptoms such as developmental delay or hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemolysis-lab",
        "description": "Laboratory evidence of hemolysis including elevated reticulocyte count and indirect hyperbilirubinemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Reduced TPI enzyme activity or pathogenic TPI1 mutations plus clinical evidence of chronic hemolytic anemia with neurological involvement",
    "notes": "Diagnosis relies heavily on enzymatic and genetic testing due to overlap with other hemolytic anemias"
  },
