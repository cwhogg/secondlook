  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible thyroid function abnormalities if hypothyroidism present"
    ],
    "imaging": [
      "Echocardiography revealing congenital heart defects",
      "Skeletal X-rays showing clinodactyly or other anomalies",
      "Brain MRI may show nonspecific findings related to developmental delay"
    ],
    "genetic": [
      "Karyotype or chromosomal microarray showing partial trisomy of chromosome 12p",
      "Fluorescence in situ hybridization (FISH) confirming duplication of 12p"
    ],
    "other": [
      "Developmental and neuropsychological assessments confirming intellectual disability"
    ]
  },
