  "diagnosticCriteria": {
    "formalCriteriaName": "No formal standardized criteria",
    "criteria": [
      {
        "id": "imaging-confirmation",
        "description": "Identification of an outpouching of the ventricular wall with contractile myocardium on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histological-confirmation",
        "description": "Histological evidence of all three cardiac layers (endocardium, myocardium, epicardium) in the diverticulum wall",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-aneurysm",
        "description": "Exclusion of ventricular aneurysm by absence of fibrotic or scar tissue and preserved contractility",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of symptoms such as arrhythmia, heart failure, or embolic events supportive but not mandatory",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Imaging confirmation of a contractile ventricular outpouching with exclusion of aneurysm",
    "notes": "Diagnosis is primarily based on imaging and histological features; clinical presentation varies."
  },
