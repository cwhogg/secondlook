  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "No specific biochemical markers identified"
    ],
    "imaging": [
      "Skeletal X-rays showing clinodactyly or brachydactyly",
      "Brain MRI may be normal or show nonspecific findings"
    ],
    "genetic": [
      "LEMD3 (phenotype modifier)",
      "HMGA2 (phenotype modifier)"
    ],
    "other": [
      "Growth charts showing postnatal growth failure",
      "Developmental assessments indicating delay"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "silver-russell-syndrome",
      "distinguishingFeatures": [
        "More severe intrauterine growth retardation",
        "Characteristic triangular face and body asymmetry",
        "Different genetic etiology (11p15 or maternal UPD7)"
      ]
    },
    {
      "diseaseId": "mucopolysaccharidosis-type-iv",
      "distinguishingFeatures": [
        "Progressive skeletal dysplasia with corneal clouding",
        "Elevated urinary glycosaminoglycans",
        "Distinct enzymatic deficiency"
      ]
    }
  ],
