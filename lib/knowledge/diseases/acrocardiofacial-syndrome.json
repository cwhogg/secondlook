  "diagnosticCriteria": {
    "formalCriteriaName": "Acrocardiofacial Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "acrocephaly",
        "description": "Presence of acrocephaly (tower-shaped skull)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-malformations",
        "description": "Congenital cardiac malformations including atrial and ventricular septal defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including hypertelorism and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-anomalies",
        "description": "Postaxial polydactyly or syndactyly of hands and feet",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Pre- and postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (acrocephaly, congenital cardiac malformations, and characteristic facial dysmorphism) with or without minor criteria",
    "notes": "Diagnosis is clinical and supported by genetic testing for mutations in the TP63 gene."
  },
