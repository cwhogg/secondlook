  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Ophthalmological Diagnostic Criteria for Congenital Microcoria",
    "criteria": [
      {
        "id": "small-pupil-diameter",
        "description": "Pupil diameter less than 2 mm under normal lighting conditions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "iris-dilator-muscle-hypoplasia",
        "description": "Hypoplasia or absence of iris dilator muscle confirmed by slit-lamp examination or histopathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-pupil-reactivity",
        "description": "Preserved pupillary light reflex despite small pupil size",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of small pupil diameter (<2 mm) and iris dilator muscle hypoplasia",
    "notes": "Diagnosis is primarily clinical supported by ophthalmological examination; genetic testing may assist but is not mandatory."
  },
