  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Septo-Optic Dysplasia",
    "criteria": [
      {
        "id": "optic-nerve-hypoplasia",
        "description": "Presence of optic nerve hypoplasia confirmed by ophthalmologic examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midline-brain-abnormalities",
        "description": "Midline brain abnormalities such as absence or hypoplasia of the septum pellucidum or corpus callosum abnormalities on neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pituitary-dysfunction",
        "description": "Hypopituitarism or other pituitary hormone deficiencies confirmed by endocrine evaluation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "Presence of seizures or epilepsy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Diagnosis requires at least two major criteria, one of which must be optic nerve hypoplasia.",
    "notes": "Pituitary dysfunction is common but not mandatory for diagnosis; clinical presentation can be variable."
  },
