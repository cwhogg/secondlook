        "requiredForDiagnosis": true
      },
      {
        "id": "immune-dysregulation",
        "description": "Evidence of immune dysregulation including eczema, elevated IgE, and autoimmune cytopenias",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "FOXP3-mutation",
        "description": "Identification of pathogenic FOXP3 gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history consistent with X-linked inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset severe enteropathy, polyendocrinopathy, immune dysregulation, and confirmation of FOXP3 mutation",
    "notes": "Diagnosis is confirmed by genetic testing for FOXP3 mutations; clinical presentation may vary."
  },
