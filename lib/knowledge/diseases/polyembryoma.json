  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological and immunohistochemical diagnostic criteria for polyembryoma",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of multiple embryoid bodies resembling early embryos within the tumor",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Positive staining for markers such as OCT3/4, SALL4, and AFP indicating germ cell origin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presentation as a rapidly enlarging testicular or ovarian mass",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological identification of embryoid bodies plus positive immunohistochemical markers",
    "notes": "Diagnosis requires expert pathological evaluation due to rarity and histological overlap with other germ cell tumors."
  },
