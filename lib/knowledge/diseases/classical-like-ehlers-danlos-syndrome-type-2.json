  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed clinical diagnostic criteria for classical-like EDS type 2",
    "criteria": [
      {
        "id": "skin-hyperextensibility",
        "description": "Marked skin hyperextensibility with soft, velvety skin texture",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "widened-scars",
        "description": "Atrophic, widened, and papyraceous scars especially on knees, elbows, and forehead",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-hypermobility",
        "description": "Generalized joint hypermobility with recurrent joint dislocations or subluxations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal recessive inheritance pattern or confirmed biallelic pathogenic variants in TNXB",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-hypotonia",
        "description": "Congenital or early-onset muscle hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (skin hyperextensibility, widened scars, and joint hypermobility) plus either supportive genetic confirmation or family history",
    "notes": "Genetic testing for biallelic TNXB mutations is confirmatory; absence does not exclude diagnosis if clinical criteria are met."
  },
