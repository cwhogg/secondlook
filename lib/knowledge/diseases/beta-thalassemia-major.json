  "keyFindings": {
    "laboratory": [
      "Severe microcytic hypochromic anemia with low hemoglobin",
      "Elevated serum ferritin and transferrin saturation indicating iron overload",
      "Peripheral blood smear showing target cells and nucleated red blood cells"
    ],
    "imaging": [
      "Skull and facial bone X-rays showing 'hair-on-end' appearance",
      "Hepatosplenomegaly on abdominal ultrasound",
      "Cardiomegaly on chest X-ray"
    ],
    "genetic": [
      "HBB (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Requirement for lifelong regular blood transfusions",
      "Evidence of extramedullary hematopoiesis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "iron-deficiency-anemia",
      "distinguishingFeatures": [
        "Iron deficiency anemia shows low serum ferritin unlike iron overload in beta-thalassemia major",
        "No hemoglobin electrophoresis abnormalities typical of beta-thalassemia",
        "Usually responds to iron supplementation"
      ]
    },
    {
      "diseaseId": "sickle-cell-disease",
      "distinguishingFeatures": [
        "Presence of sickled red blood cells on peripheral smear",
        "Hemoglobin electrophoresis shows HbS instead of absent HbA",
        "Different clinical complications such as vaso-occlusive crises"
      ]
    }
  ],
