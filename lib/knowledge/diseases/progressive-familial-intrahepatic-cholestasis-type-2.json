  "diagnosticCriteria": {
    "formalCriteriaName": "PFIC Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the ABCB11 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-cholestasis",
        "description": "Chronic intrahepatic cholestasis presenting in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serum-bile-acid-elevation",
        "description": "Elevated serum bile acids with normal or mildly elevated gamma-glutamyl transferase (GGT)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-biopsy-findings",
        "description": "Liver biopsy showing canalicular cholestasis with absence or marked reduction of BSEP protein expression",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical cholestasis with elevated serum bile acids and genetic confirmation of ABCB11 mutations",
    "notes": "Liver biopsy and immunohistochemistry may support diagnosis but are not mandatory if genetic testing is conclusive."
  },
