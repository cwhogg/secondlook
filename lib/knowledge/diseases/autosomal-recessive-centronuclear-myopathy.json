  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate elevation)",
      "Normal or mildly elevated lactate dehydrogenase"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle involvement and fatty infiltration",
      "Chest imaging may show restrictive lung disease"
    ],
    "genetic": [
      "TTN (causative)",
      "SPEG (causative)",
      "RYR1 (causative)",
      "BIN1 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy demonstrating central nuclei in >50% of fibers",
      "Electromyography consistent with myopathic pattern"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "x-linked-centronuclear-myopathy",
      "distinguishingFeatures": [
        "X-linked inheritance pattern",
        "Mutations in MTM1 gene",
        "More severe neonatal onset"
      ]
    },
    {
      "diseaseId": "myotubular-myopathy",
      "distinguishingFeatures": [
        "Severe hypotonia and respiratory failure at birth",
        "X-linked inheritance",
        "Markedly delayed motor milestones"
      ]
    },
    {
      "diseaseId": "nemaline-myopathy",
      "distinguishingFeatures": [
        "Presence of nemaline rods on muscle biopsy",
        "Different genetic mutations (e.g., NEB, ACTA1)",
        "Distinct clinical features including facial weakness and respiratory involvement"
      ]
    }
  ],
  "redFlags": [
