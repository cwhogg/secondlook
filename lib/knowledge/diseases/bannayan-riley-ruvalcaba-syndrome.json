  "diagnosticCriteria": {
    "formalCriteriaName": "BRRS Clinical Diagnostic Criteria",
    "criteria": [
      {
        "id": "macrocephaly",
        "description": "Macrocephaly defined as head circumference >97th percentile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hamartomatous-polyps",
        "description": "Presence of multiple intestinal hamartomatous polyps",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-lipomas",
        "description": "Multiple subcutaneous lipomas",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "vascular-malformations",
        "description": "Vascular malformations such as hemangiomas",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of BRRS or PTEN hamartoma tumor syndromes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of macrocephaly and either multiple intestinal hamartomatous polyps or multiple subcutaneous lipomas",
    "notes": "Genetic testing for PTEN mutations supports diagnosis but is not mandatory"
  },
