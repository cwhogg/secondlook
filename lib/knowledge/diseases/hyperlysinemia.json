  "diagnosticCriteria": {
    "formalCriteriaName": "Biochemical and Genetic Diagnostic Criteria for Hyperlysinemia",
    "criteria": [
      {
        "id": "elevated-lysine",
        "description": "Persistent elevated plasma lysine concentration above normal reference range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-deficiency",
        "description": "Reduced activity of saccharopine dehydrogenase enzyme in fibroblasts or liver tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the AASS gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of neurological symptoms such as developmental delay or hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated plasma lysine plus either enzyme deficiency or pathogenic AASS gene variants",
    "notes": "Diagnosis is confirmed by biochemical testing and genetic analysis; clinical symptoms may be variable."
  },
