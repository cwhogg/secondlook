  "diagnosticCriteria": {
    "formalCriteriaName": "Wrinkly Skin Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "skin-wrinkling",
        "description": "Generalized loose, wrinkled, and redundant skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Severe postnatal growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-hypermobility",
        "description": "Generalized joint hypermobility and contractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including a triangular face and prominent forehead",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-anomalies",
        "description": "Radiological evidence of skeletal abnormalities such as metaphyseal dysplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the ATP6V0A2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of generalized wrinkled skin, growth retardation, joint hypermobility, and confirmation by genetic testing or characteristic skeletal anomalies",
    "notes": "Diagnosis is supported by clinical features and confirmed by molecular genetic testing of ATP6V0A2."
  },
