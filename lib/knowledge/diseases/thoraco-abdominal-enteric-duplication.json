  "diagnosticCriteria": {
    "formalCriteriaName": "Thoraco-abdominal Enteric Duplication Diagnostic Criteria",
    "criteria": [
      {
        "id": "anatomic-continuity",
        "description": "Presence of a cystic or tubular duplication extending from thoracic to abdominal cavity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histological-confirmation",
        "description": "Histological evidence of gastrointestinal mucosa lining the duplication cyst",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-evidence",
        "description": "Radiological identification of a cystic mass with characteristic features on ultrasound, CT, or MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Symptoms consistent with mass effect or complications such as respiratory distress or gastrointestinal obstruction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (anatomic continuity, histological confirmation, and imaging evidence) must be met for definitive diagnosis.",
    "notes": "Diagnosis often requires surgical exploration and histopathological confirmation."
  },
