  "diagnosticCriteria": {
    "formalCriteriaName": "Eurofever/PRINTO Classification Criteria for TRAPS",
    "criteria": [
      {
        "id": "recurrent-fever",
        "description": "Recurrent episodes of fever lasting more than 5 days",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "periorbital-edema",
        "description": "Periorbital edema during attacks",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "fasciitis-myalgia",
        "description": "Migratory myalgia or fasciitis during attacks",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "rash",
        "description": "Erythematous migratory rash",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history of TRAPS or similar autoinflammatory syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "tnfrsf1a-mutation",
        "description": "Presence of pathogenic TNFRSF1A gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Recurrent fever episodes plus either a pathogenic TNFRSF1A mutation or at least one major clinical criterion",
    "notes": "Genetic testing is essential for confirmation; clinical presentation can be variable."
  },
