  "keyFindings": {
    "laboratory": [
      "Elevated serum chromogranin A",
      "Increased 24-hour urinary 5-HIAA",
      "Anemia on complete blood count"
    ],
    "imaging": [
      "Contrast-enhanced CT or MRI showing colonic mass",
      "Somatostatin receptor scintigraphy (Octreoscan) or PET imaging for tumor localization"
    ],
    "genetic": [
      "No specific germline mutations commonly associated; sporadic mutations in MEN1 gene may be present in some cases"
    ],
    "other": [
      "Histopathology showing neuroendocrine differentiation with mitotic count and Ki-67 proliferation index for grading"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "adenocarcinoma-of-the-colon",
      "distinguishingFeatures": [
        "Histology showing glandular differentiation rather than neuroendocrine markers",
        "Lack of hormone-related symptoms such as carcinoid syndrome"
      ]
    },
    {
      "diseaseId": "gastrointestinal-stromal-tumor",
      "distinguishingFeatures": [
        "Positive immunohistochemistry for c-KIT (CD117) and DOG1",
        "Mesenchymal origin rather than neuroendocrine"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset of carcinoid syndrome symptoms",
    "Unexplained gastrointestinal bleeding with anemia",
    "Signs of carcinoid heart disease such as right-sided heart failure"
  ],
