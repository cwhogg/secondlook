  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests unless secondary complications present",
      "Possible hypothyroidism on thyroid function tests"
    ],
    "imaging": [
      "Echocardiography showing congenital heart defects",
      "Skeletal X-rays revealing clinodactyly or other anomalies",
      "Brain MRI may show nonspecific findings related to developmental delay"
    ],
    "genetic": [
      "Karyotype or chromosomal microarray demonstrating duplication of chromosome 20p",
      "Fluorescence in situ hybridization (FISH) confirming trisomy 20p region"
    ],
    "other": [
      "Developmental assessments confirming global delay",
      "Audiological evaluations for hearing impairment"
    ]
  },
