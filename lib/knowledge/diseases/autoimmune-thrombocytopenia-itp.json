  "diagnosticCriteria": {
    "formalCriteriaName": "American Society of Hematology ITP Diagnostic Criteria",
    "criteria": [
      {
        "id": "isolated-thrombocytopenia",
        "description": "Isolated thrombocytopenia with platelet count <100 x 10^9/L",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of thrombocytopenia such as drug-induced, infections, or bone marrow disorders",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "presence-of-anti-platelet-antibodies",
        "description": "Detection of platelet-specific autoantibodies (supportive but not mandatory)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-bone-marrow-examination",
        "description": "Bone marrow examination showing normal or increased megakaryocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Isolated thrombocytopenia with platelet count <100 x 10^9/L and exclusion of other causes",
    "notes": "Diagnosis is primarily clinical and by exclusion; antibody testing is supportive but not definitive."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Petechiae",
        "frequency": 0.85,
        "bodySystem": "dermatological",
        "notes": "Small pinpoint non-blanching hemorrhages"
      },
      {
        "symptomName": "Mucosal bleeding",
        "frequency": 0.75,
        "bodySystem": "hematological",
        "notes": "Includes gingival bleeding and epistaxis"
      }
    ],
    "common": [
      {
        "symptomName": "Easy bruising",
        "frequency": 0.65,
        "bodySystem": "dermatological",
        "notes": "Spontaneous ecchymoses on skin"
      },
      {
        "symptomName": "Prolonged bleeding from cuts",
        "frequency": 0.6,
        "bodySystem": "hematological",
        "notes": "Delayed hemostasis"
      },
      {
        "symptomName": "Menorrhagia",
        "frequency": 0.55,
        "bodySystem": "reproductive",
        "notes": "Heavy menstrual bleeding in females"
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.5,
        "bodySystem": "constitutional",
        "notes": "May be related to chronic bleeding"
      }
    ],
    "occasional": [
      {
        "symptomName": "Epistaxis",
        "frequency": 0.4,
        "bodySystem": "hematological",
        "notes": "Nosebleeds of variable severity"
      },
      {
        "symptomName": "Gingival bleeding",
        "frequency": 0.35,
        "bodySystem": "hematological",
        "notes": "Bleeding gums"
      },
      {
        "symptomName": "Hematuria",
        "frequency": 0.3,
        "bodySystem": "renal",
        "notes": "Blood in urine due to bleeding"
      },
      {
        "symptomName": "Epigastric pain",
        "frequency": 0.2,
        "bodySystem": "gastrointestinal",
        "notes": "May indicate gastrointestinal bleeding"
      }
    ],
    "rare": [
      {
        "symptomName": "Intracranial hemorrhage",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Life-threatening bleeding complication"
      },
      {
        "symptomName": "Hemarthrosis",
        "frequency": 0.03,
        "bodySystem": "musculoskeletal",
        "notes": "Bleeding into joints, uncommon in ITP"
      },
      {
        "symptomName": "Retinal hemorrhage",
        "frequency": 0.02,
        "bodySystem": "ophthalmological",
        "notes": "Rare bleeding in the eye"
      }
    ]
  },
