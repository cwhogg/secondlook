        "requiredForDiagnosis": true
      },
      {
        "id": "normal-cognitive-assessment",
        "description": "Neuropsychological testing confirming normal intellectual function",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early onset muscle weakness and hypotonia plus muscle biopsy consistent with dystrophy and absence of intellectual disability",
    "notes": "Exclusion of syndromic forms with intellectual disability is essential"
