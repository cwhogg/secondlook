  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Meige Disease",
    "criteria": [
      {
        "id": "cranial-dystonia",
        "description": "Presence of segmental dystonia involving the orbicularis oculi and lower facial muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "blepharospasm",
        "description": "Involuntary, sustained or intermittent spasms of the eyelid muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oromandibular-dystonia",
        "description": "Involuntary contractions of the jaw, tongue, and lower facial muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-neurodegeneration",
        "description": "No evidence of neurodegenerative disease or secondary causes of dystonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of blepharospasm and oromandibular dystonia with exclusion of secondary causes",
    "notes": "Diagnosis is clinical; neuroimaging is used to exclude other causes."
  },
