  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Cockayne Syndrome",
    "criteria": [
      {
        "id": "growth-retardation",
        "description": "Severe postnatal growth failure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "photosensitivity",
        "description": "Marked photosensitivity with sunburn reaction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-deterioration",
        "description": "Progressive neurodegeneration including developmental delay and microcephaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facies",
        "description": "Distinctive facial features including deep-set eyes, thin nose, and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cataracts",
        "description": "Early onset cataracts",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "dna-repair-defect",
        "description": "Defective nucleotide excision repair demonstrated by cellular assays",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (growth retardation, photosensitivity, and progressive neurodegeneration) with supportive genetic or laboratory findings",
    "notes": "Genetic testing confirming ERCC6 or ERCC8 mutations supports diagnosis"
  },
