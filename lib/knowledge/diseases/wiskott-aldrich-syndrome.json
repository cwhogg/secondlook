  "keyFindings": {
    "laboratory": [
      "Low platelet count with small platelets on peripheral smear",
      "Reduced WAS protein expression in lymphocytes",
      "Immunoglobulin abnormalities (low IgM, elevated IgA and IgE)",
      "Lymphopenia with decreased T-cell function"
    ],
    "imaging": [
      "Chest X-ray showing recurrent pneumonia or bronchiectasis",
      "Ultrasound or CT showing hepatosplenomegaly"
    ],
    "genetic": [
      "Pathogenic mutation in the WAS gene on X chromosome"
    ],
    "other": [
      "Family history consistent with X-linked inheritance",
      "Flow cytometry for WAS protein expression"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "severe-combined-immunodeficiency",
      "distinguishingFeatures": [
        "More profound T and B cell deficiency",
        "Absence of thrombocytopenia and eczema",
        "Different genetic mutations"
      ]
    },
    {
      "diseaseId": "eczema-thrombocytopenia-syndrome",
      "distinguishingFeatures": [
        "Non-X-linked inheritance",
        "Different immunological profile",
        "Absence of WAS gene mutation"
      ]
    },
    {
      "diseaseId": "immune-thrombocytopenic-purpura",
      "distinguishingFeatures": [
        "Isolated thrombocytopenia without immunodeficiency or eczema",
        "No WAS gene mutation",
        "Usually acquired rather than inherited"
      ]
    }
  ],
  "redFlags": [
    "Severe bleeding episodes in infancy",
    "Recurrent, severe infections despite treatment",
    "Early onset eczema with thrombocytopenia"
  ],
