    "laboratory": [
      "Normal routine laboratory tests",
      "No specific biochemical markers identified"
    ],
    "imaging": [
      "Brain MRI may show nonspecific cerebral atrophy or delayed myelination",
      "Skeletal X-rays reveal broad distal phalanges of thumbs and halluces"
    ],
    "genetic": [
      "KCNH1 (causative, gain-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electroencephalogram (EEG) abnormalities consistent with epilepsy",
      "Clinical observation of characteristic nail and toe abnormalities"
    ]
  },
