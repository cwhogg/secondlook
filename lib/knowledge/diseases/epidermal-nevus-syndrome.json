  "keyFindings": {
    "laboratory": [
      "Histopathology of epidermal nevus showing hyperkeratosis and acanthosis"
    ],
    "imaging": [
      "Brain MRI showing hemimegalencephaly or cortical dysplasia",
      "Skeletal X-rays demonstrating limb asymmetry or scoliosis"
    ],
    "genetic": [
      "Somatic mosaic mutations in genes such as FGFR3, PIK3CA, or HRAS"
    ],
    "other": [
      "Clinical observation of nevus distribution along Blaschko's lines"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "nevus-comedonicus-syndrome",
      "distinguishingFeatures": [
        "Presence of comedone-like lesions rather than verrucous epidermal nevi",
        "Less frequent neurological involvement"
      ]
    },
    {
      "diseaseId": "proteus-syndrome",
      "distinguishingFeatures": [
        "Progressive asymmetric overgrowth with connective tissue nevi",
        "Different genetic mutations (AKT1 gene)"
      ]
    }
  ],
