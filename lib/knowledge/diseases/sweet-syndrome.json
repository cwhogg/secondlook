  "diagnosticCriteria": {
    "formalCriteriaName": "Modified Su and Liu Criteria",
    "criteria": [
      {
        "id": "major-1",
        "description": "Abrupt onset of painful erythematous plaques or nodules",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "major-2",
        "description": "Histopathologic evidence of dense neutrophilic infiltration without evidence of leukocytoclastic vasculitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "minor-1",
        "description": "Fever >38°C",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "minor-2",
        "description": "Association with underlying malignancy, infection, inflammatory disease, or pregnancy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "minor-3",
        "description": "Response to systemic corticosteroids or potassium iodide",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "minor-4",
        "description": "Elevated inflammatory markers (e.g., ESR, CRP, leukocytosis)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Both major criteria plus at least two minor criteria",
    "notes": "Diagnosis requires exclusion of infections and other neutrophilic dermatoses."
  },
