  "keyFindings": {
    "laboratory": [
      "Elevated hemoglobin and hematocrit",
      "JAK2 V617F mutation positive (~95%) or JAK2 exon 12 mutation",
      "Low serum erythropoietin (EPO)",
      "Leukocytosis and thrombocytosis may be present",
      "Elevated LDH",
      "Hyperuricemia",
      "Elevated vitamin B12 level"
    ],
    "imaging": [
      "Abdominal ultrasound showing splenomegaly",
      "Doppler ultrasound if thrombosis suspected",
      "CT/MRI for hepatic vein thrombosis (Budd-Chiari)"
    ],
    "genetic": [
      "JAK2 (somatic)"
    ],
    "other": [
      "Bone marrow biopsy showing panmyelosis with pleomorphic megakaryocytes",
      "Reduced iron stores on marrow biopsy (from increased erythropoiesis)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "secondary-polycythemia",
      "distinguishingFeatures": [
        "Elevated EPO level (vs. low in PV)",
        "JAK2 mutation negative",
        "Identifiable cause (chronic hypoxia, EPO-producing tumor, smoking)"
      ]
    },
    {
      "diseaseId": "essential-thrombocythemia",
      "distinguishingFeatures": [
        "ET primarily shows isolated thrombocytosis",
        "Hemoglobin typically normal",
        "Different bone marrow morphology (large mature megakaryocytes)"
      ]
    },
    {
      "diseaseId": "myelofibrosis",
      "distinguishingFeatures": [
        "Myelofibrosis shows reticulin/collagen fibrosis on bone marrow biopsy",
        "Leukoerythroblastic blood smear with teardrop cells",
        "Massive splenomegaly more common"
      ]
    },
    {
      "diseaseId": "relative-polycythemia",
      "distinguishingFeatures": [
        "Due to dehydration or plasma volume contraction",
        "Normal red cell mass measurement",
        "JAK2 negative",
        "Normal EPO"
      ]
    }
  ],
  "redFlags": [
    "Major thrombotic event (stroke, MI, DVT/PE, Budd-Chiari)",
    "Transformation to myelofibrosis with worsening cytopenias and massive splenomegaly",
    "Transformation to acute myeloid leukemia",
    "Severe uncontrolled pruritus significantly impacting quality of life",
    "Paradoxical bleeding with extreme thrombocytosis (acquired von Willebrand)"
  ],
