  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Opitz GBBB syndrome",
    "criteria": [
      {
        "id": "hypertelorism",
        "description": "Hypertelorism (widely spaced eyes)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "laryngotracheoesophageal-clefts",
        "description": "Laryngotracheoesophageal clefts or abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genitourinary-anomalies",
        "description": "Genitourinary anomalies including hypospadias or cryptorchidism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midline-facial-defects",
        "description": "Midline facial defects such as cleft lip and/or palate",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypertelorism plus at least two other major criteria (laryngotracheoesophageal clefts and/or genitourinary anomalies) or one major plus two minor/supportive criteria",
    "notes": "Genetic testing for MID1 gene mutations can support diagnosis"
  },
