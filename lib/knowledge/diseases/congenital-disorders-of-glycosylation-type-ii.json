      "Coagulation factor deficiencies (e.g., factor XI, antithrombin III)",
      "Elevated liver transaminases"
    ],
    "imaging": [
      "Brain MRI showing cerebral and cerebellar atrophy",
      "Skeletal X-rays demonstrating dysostosis multiplex"
    ],
    "genetic": [
      "Pathogenic variants in genes such as MAN1B1, MGAT2, and others involved in N-glycan processing"
    ],
