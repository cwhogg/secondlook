  "keyFindings": {
    "laboratory": [
      "Elevated serum chromogranin A",
      "Increased 24-hour urinary 5-HIAA (5-hydroxyindoleacetic acid)",
      "Mild leukocytosis in appendicitis-like presentation"
    ],
    "imaging": [
      "CT scan showing appendiceal mass or thickening",
      "MRI for local staging and liver metastases detection",
      "Somatostatin receptor scintigraphy (Octreoscan) for metastatic disease"
    ],
    "genetic": [
      "No specific germline mutations identified; sporadic occurrence typical"
    ],
    "other": [
      "Histopathology demonstrating uniform small round cells with salt-and-pepper chromatin",
      "Immunohistochemistry positive for synaptophysin and chromogranin A"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "acute-appendicitis",
      "distinguishingFeatures": [
        "Lack of neuroendocrine tumor cells on histology",
        "Absence of neuroendocrine marker positivity",
        "Typically no carcinoid syndrome symptoms"
      ]
    },
    {
      "diseaseId": "appendiceal-adenocarcinoma",
      "distinguishingFeatures": [
        "Gland-forming malignant cells on histology",
        "Negative for neuroendocrine markers",
        "More aggressive clinical course"
      ]
    },
    {
      "diseaseId": "gastrointestinal-stromal-tumor-of-appendix",
      "distinguishingFeatures": [
        "Spindle cell morphology on histology",
        "Positive for CD117 (c-KIT) immunostaining",
        "Different clinical and therapeutic implications"
      ]
    }
  ],
  "redFlags": [
