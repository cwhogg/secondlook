  "diagnosticCriteria": {
    "formalCriteriaName": "2017 International Classification of the Ehlers-Danlos Syndromes",
    "criteria": [
      {
        "id": "heds-c1",
        "description": "Generalized joint hypermobility (Beighton score >= 5 for adults, >= 6 for children)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "heds-c2a",
        "description": "Feature A: Systemic manifestations of a more generalized connective tissue disorder (>= 5 of 12 features)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "heds-c2b",
        "description": "Feature B: Positive family history with one or more first-degree relatives meeting criteria",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "heds-c2c",
        "description": "Feature C: Musculoskeletal complications (>= 1 of 3: chronic pain, chronic instability, both)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "heds-c3",
        "description": "Absence of unusual skin fragility; other EDS subtypes, alternative heritable or acquired CTDs excluded",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "heds-m1",
        "description": "Unusually soft or velvety skin",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "heds-m2",
        "description": "Mild skin hyperextensibility",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "heds-m3",
        "description": "Unexplained striae distensae",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "heds-m4",
        "description": "Bilateral piezogenic papules of the heel",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "heds-m5",
        "description": "Recurrent or multiple abdominal hernias",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "heds-m6",
        "description": "Atrophic scarring (not papyraceous or hemosideric)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "heds-m7",
        "description": "Pelvic floor, rectal, or uterine prolapse without predisposing factors",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "heds-m8",
        "description": "Dental crowding and high or narrow palate",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "heds-m9",
        "description": "Arachnodactyly (positive Steinberg or Walker signs)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "heds-m10",
        "description": "Arm span-to-height ratio >= 1.05",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "heds-m11",
        "description": "Mitral valve prolapse",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "heds-m12",
        "description": "Aortic root dilation with z-score > +2",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three criteria must be met: (1) Generalized joint hypermobility, (2) Two or more of Features A, B, C, (3) Exclusion of other diagnoses",
    "notes": "hEDS is currently the only EDS subtype without a known genetic marker. Diagnosis is purely clinical."
  },
