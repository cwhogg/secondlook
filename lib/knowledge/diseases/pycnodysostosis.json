  "differentialDiagnoses": [
    {
      "diseaseId": "osteopetrosis",
      "distinguishingFeatures": [
        "More severe bone marrow failure",
        "No acro-osteolysis",
        "Different genetic mutations (e.g., CLCN7)"
      ]
    },
    {
      "diseaseId": "cleidocranial-dysplasia",
      "distinguishingFeatures": [
        "Clavicular hypoplasia/aplasia without osteosclerosis",
        "Delayed closure of fontanelles but normal bone density",
        "RUNX2 gene mutations"
      ]
    }
  ],
