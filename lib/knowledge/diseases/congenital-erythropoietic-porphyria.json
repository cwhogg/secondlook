    ],
    "imaging": [
      "Radiographic evidence of osteolysis and bone resorption of distal phalanges"
    ],
    "genetic": [
      "UROS (causative, loss-of-function)",
      "GATA1 (causative)",
      "Mutations in the UROS gene confirming autosomal recessive inheritance"
    ],
