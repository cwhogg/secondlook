  "diagnosticCriteria": {
    "formalCriteriaName": "Classic Galactosemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "galt-activity",
        "description": "Markedly reduced or absent erythrocyte galactose-1-phosphate uridylyltransferase (GALT) enzyme activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "galactose-1-phosphate",
        "description": "Elevated galactose-1-phosphate levels in erythrocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the GALT gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Symptoms consistent with galactosemia such as feeding difficulties, jaundice, and hepatomegaly in neonates",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of markedly reduced or absent GALT enzyme activity plus elevated galactose-1-phosphate levels or pathogenic GALT gene variants",
    "notes": "Newborn screening programs often identify affected infants before symptom onset."
  },
