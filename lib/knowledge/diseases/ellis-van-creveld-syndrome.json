  "diagnosticCriteria": {
    "formalCriteriaName": "Ellis-van Creveld Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "short-limbs",
        "description": "Short limbs with mesomelic shortening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "postaxial-polydactyly",
        "description": "Postaxial polydactyly of hands and/or feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defect",
        "description": "Presence of congenital heart defects, especially atrial septal defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-anomalies",
        "description": "Dental abnormalities including natal teeth and hypodontia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "nail-dystrophy",
        "description": "Nail dysplasia or dystrophic nails",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: short limbs, postaxial polydactyly, and congenital heart defect",
    "notes": "Genetic testing for EVC or EVC2 mutations supports diagnosis"
  },
