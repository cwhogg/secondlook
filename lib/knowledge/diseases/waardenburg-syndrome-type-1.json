  "diagnosticCriteria": {
    "formalCriteriaName": "Farrer et al. 1992 Diagnostic Criteria",
    "criteria": [
      {
        "id": "dystopia-canthorum",
        "description": "Presence of dystopia canthorum (lateral displacement of inner canthi)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Congenital sensorineural hearing loss",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pigmentary-abnormalities-eyes",
        "description": "Pigmentary abnormalities of the iris (heterochromia iridis, brilliant blue eyes)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "white-forelock",
        "description": "White forelock or early graying of scalp hair",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "skin-hypopigmentation",
        "description": "Congenital leukoderma or hypopigmented skin patches",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "broad-nasal-root",
        "description": "Broad nasal root",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of dystopia canthorum plus at least two other major criteria or one major and two minor criteria",
    "notes": "Dystopia canthorum is a distinguishing feature for Type 1 compared to other Waardenburg types."
  },
