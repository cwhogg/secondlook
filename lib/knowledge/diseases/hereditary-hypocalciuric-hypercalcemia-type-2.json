  "keyFindings": {
    "laboratory": [
      "Elevated serum calcium (mild to moderate)",
      "Low urinary calcium excretion (calcium clearance <0.01)",
      "Normal or mildly elevated serum magnesium",
      "Normal or mildly elevated parathyroid hormone (PTH) levels"
    ],
    "imaging": [
      "Typically normal bone density",
      "No parathyroid adenoma on neck imaging"
    ],
    "genetic": [
      "Inactivating mutation in AP2S1 gene (Type 2 HHC)"
    ],
    "other": [
      "Family history of hypercalcemia with hypocalciuria",
      "Absence of complications typical of primary hyperparathyroidism"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "primary-hyperparathyroidism",
      "distinguishingFeatures": [
        "Elevated serum calcium with elevated or inappropriately normal PTH",
        "Increased urinary calcium excretion",
        "Parathyroid adenoma or hyperplasia on imaging"
      ]
    },
    {
      "diseaseId": "familial-hypocalciuric-hypercalcemia-type-1",
      "distinguishingFeatures": [
        "Mutation in calcium-sensing receptor (CaSR) gene",
        "Similar biochemical profile but different genetic cause"
      ]
    },
    {
      "diseaseId": "malignancy-associated-hypercalcemia",
      "distinguishingFeatures": [
        "Rapidly progressive hypercalcemia",
        "Elevated PTH-related peptide (PTHrP)",
        "Presence of malignancy"
      ]
    }
  ],
  "redFlags": [
    "Severe hypercalcemia (>3.0 mmol/L)",
    "Symptoms of hypercalcemic crisis (confusion, dehydration, arrhythmias)",
    "Evidence of nephrolithiasis or pancreatitis"
  ],
