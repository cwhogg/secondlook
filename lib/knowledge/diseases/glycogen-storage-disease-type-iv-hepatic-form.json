  "keyFindings": {
    "laboratory": [
      "Elevated liver transaminases (AST, ALT)",
      "Hypoglycemia with normal ketones",
      "Coagulation abnormalities",
      "Elevated serum bilirubin"
    ],
    "imaging": [
      "Ultrasound showing hepatosplenomegaly and liver nodularity",
      "CT/MRI demonstrating cirrhotic changes"
    ],
    "genetic": [
      "Pathogenic mutations in GBE1 gene"
    ],
    "other": [
      "Liver biopsy showing amylopectin-like glycogen deposits with reduced branching enzyme activity"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "glycogen-storage-disease-type-iii",
      "distinguishingFeatures": [
        "Presence of debranching enzyme deficiency",
        "Less severe liver fibrosis early on",
        "Different genetic mutations (AGL gene)"
      ]
    },
    {
      "diseaseId": "glycogen-storage-disease-type-vi",
      "distinguishingFeatures": [
        "Phosphorylase deficiency",
        "Milder liver involvement",
        "Later onset and better prognosis"
      ]
    },
    {
      "diseaseId": "progressive familial intrahepatic cholestasis",
      "distinguishingFeatures": [
        "Cholestasis predominant",
        "Different histopathology",
        "No glycogen accumulation"
      ]
    }
  ],
