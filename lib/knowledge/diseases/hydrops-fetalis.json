  "diagnosticCriteria": {
    "formalCriteriaName": "Ultrasound Diagnostic Criteria for Hydrops Fetalis",
    "criteria": [
      {
        "id": "fluid-accumulation",
        "description": "Presence of abnormal fluid accumulation in at least two fetal compartments (e.g., ascites, pleural effusion, pericardial effusion, skin edema)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-edema",
        "description": "Generalized skin edema exceeding 5 mm thickness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "polyhydramnios",
        "description": "Excess amniotic fluid volume detected by ultrasound",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "placental-thickening",
        "description": "Placental thickness greater than 4 cm",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Abnormal fluid accumulation in at least two fetal compartments including generalized skin edema",
    "notes": "Diagnosis is primarily based on prenatal ultrasound findings; etiology requires further investigation."
  },
