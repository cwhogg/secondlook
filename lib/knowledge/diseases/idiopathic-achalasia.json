        "requiredForDiagnosis": false
      },
      {
        "id": "symptoms-of-dysphagia",
        "description": "Progressive dysphagia for solids and liquids",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of impaired LES relaxation and aperistalsis on manometry combined with clinical symptoms of dysphagia",
