  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Hereditary Hypophosphatemic Rickets with Hypercalciuria",
    "criteria": [
      {
        "id": "renal-phosphate-wasting",
        "description": "Evidence of renal phosphate wasting with hypophosphatemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypercalciuria",
        "description": "Increased urinary calcium excretion (hypercalciuria)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rickets-clinical-radiologic",
        "description": "Clinical and radiologic signs of rickets including bone deformities and growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-25ohd-vitamin-d",
        "description": "Normal serum 25-hydroxyvitamin D levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the SLC34A3 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of renal phosphate wasting with hypophosphatemia, hypercalciuria, and clinical/radiologic evidence of rickets",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory"
  },
