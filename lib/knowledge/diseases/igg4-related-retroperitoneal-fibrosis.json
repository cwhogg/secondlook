  "keyFindings": {
    "laboratory": [
      "Elevated serum IgG4 concentration",
      "Mildly elevated inflammatory markers (ESR, CRP)",
      "Mild eosinophilia in some cases"
    ],
    "imaging": [
      "CT or MRI showing retroperitoneal soft tissue mass encasing ureters and vessels",
      "Hydronephrosis on ultrasound or CT",
      "PET-CT showing increased uptake in affected areas"
    ],
    "genetic": [
      "No specific genetic mutations identified; possible HLA associations in some populations"
    ],
    "other": [
      "Histopathology demonstrating storiform fibrosis, obliterative phlebitis, and IgG4-positive plasma cell infiltration"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "idiopathic-retroperitoneal-fibrosis",
      "distinguishingFeatures": [
        "Absence of elevated serum IgG4",
        "Lack of IgG4-positive plasma cell infiltration on biopsy",
        "No systemic IgG4-related disease manifestations"
      ]
    },
    {
      "diseaseId": "malignant-retroperitoneal-mass",
      "distinguishingFeatures": [
        "Presence of malignant cells on biopsy",
        "Rapid progression and systemic symptoms",
        "Lack of storiform fibrosis and IgG4 plasma cells"
      ]
    },
    {
      "diseaseId": "infectious-retroperitoneal-fibrosis",
      "distinguishingFeatures": [
        "Positive microbiological cultures",
        "Response to antimicrobial therapy",
        "Histopathology showing granulomatous inflammation"
      ]
    }
  ],
  "redFlags": [
