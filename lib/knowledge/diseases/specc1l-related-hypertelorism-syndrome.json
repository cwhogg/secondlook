  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for SPECC1L-related Hypertelorism Syndrome",
    "criteria": [
      {
        "id": "hypertelorism",
        "description": "Presence of hypertelorism (increased distance between the eyes)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cleft-lip-palate",
        "description": "Cleft lip and/or cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including broad nasal bridge and prominent forehead",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the SPECC1L gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "additional-features",
        "description": "Presence of other craniofacial anomalies such as blepharoptosis or ear anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypertelorism, cleft lip and/or palate, characteristic facial dysmorphism, and pathogenic SPECC1L variant",
    "notes": "Genetic testing is essential for confirmation; clinical features may overlap with other craniofacial syndromes."
  },
