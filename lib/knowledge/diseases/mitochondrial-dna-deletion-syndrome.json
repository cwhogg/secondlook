  "keyFindings": {
    "laboratory": [
      "Elevated lactate levels in blood and CSF",
      "Muscle biopsy showing ragged-red fibers and cytochrome c oxidase-negative fibers"
    ],
    "imaging": [
      "Brain MRI may show cerebellar atrophy in some cases",
      "Cardiac MRI for assessment of cardiomyopathy"
    ],
    "genetic": [
      "Detection of single large-scale mitochondrial DNA deletions in muscle or blood",
      "Heteroplasmy levels correlate with severity"
    ],
    "other": [
      "Electrocardiogram showing conduction defects",
      "Electromyography demonstrating myopathic changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "myasthenia-gravis",
      "distinguishingFeatures": [
        "Autoimmune etiology",
        "Fluctuating muscle weakness with fatigability",
        "Positive acetylcholine receptor antibodies"
      ]
    },
    {
      "diseaseId": "ocular-myasthenia",
      "distinguishingFeatures": [
        "Isolated ocular muscle weakness",
        "Improvement with acetylcholinesterase inhibitors",
        "Absence of mitochondrial DNA deletions"
      ]
    },
    {
      "diseaseId": "mitochondrial-myopathy-other",
      "distinguishingFeatures": [
        "Different mtDNA mutations or nuclear gene mutations",
        "Variable clinical presentations",
        "May lack large-scale mtDNA deletions"
      ]
    }
  ],
