  "diagnosticCriteria": {
    "formalCriteriaName": "TMA Diagnostic Criteria",
    "criteria": [
      {
        "id": "microangiopathic-hemolytic-anemia",
        "description": "Presence of microangiopathic hemolytic anemia evidenced by schistocytes on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thrombocytopenia",
        "description": "Thrombocytopenia with platelet count <150,000/µL without other apparent cause",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "organ-ischemia",
        "description": "Evidence of organ ischemia or injury, particularly renal impairment or neurological symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-coagulation-tests",
        "description": "Normal coagulation studies to exclude disseminated intravascular coagulation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-lactate-dehydrogenase",
        "description": "Elevated serum lactate dehydrogenase (LDH) indicating hemolysis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microangiopathic hemolytic anemia, thrombocytopenia, and evidence of organ ischemia",
    "notes": "Diagnosis requires exclusion of other causes of hemolytic anemia and thrombocytopenia."
  },
