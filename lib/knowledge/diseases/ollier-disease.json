  "differentialDiagnoses": [
    {
      "diseaseId": "maffucci-syndrome",
      "distinguishingFeatures": [
        "Presence of multiple enchondromas plus soft tissue hemangiomas",
        "Higher risk of malignancy",
        "Cutaneous vascular lesions absent in Ollier disease"
      ]
    },
    {
      "diseaseId": "hereditary-multiple-exostoses",
      "distinguishingFeatures": [
        "Presence of multiple osteochondromas (bone outgrowths) rather than enchondromas",
        "Autosomal dominant inheritance",
        "Lesions typically arise from bone surface"
      ]
    }
  ],
  "redFlags": [
