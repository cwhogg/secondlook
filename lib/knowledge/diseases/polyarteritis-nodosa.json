  "diagnosticCriteria": {
    "formalCriteriaName": "1990 ACR Classification Criteria for Polyarteritis Nodosa (with 2012 Chapel Hill revisions)",
    "criteria": [
      {
        "id": "pan-1",
        "description": "Weight loss >= 4 kg (not due to dieting)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pan-2",
        "description": "Livedo reticularis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pan-3",
        "description": "Testicular pain or tenderness",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pan-4",
        "description": "Myalgias, weakness, or leg tenderness",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pan-5",
        "description": "Mononeuropathy or polyneuropathy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pan-6",
        "description": "Diastolic blood pressure > 90 mmHg (new onset)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pan-7",
        "description": "Elevated BUN (>40 mg/dL) or creatinine (>1.5 mg/dL)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pan-8",
        "description": "Hepatitis B surface antigen or antibody positivity",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pan-9",
        "description": "Arteriographic abnormalities (aneurysms or occlusions of visceral arteries)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pan-10",
        "description": "Biopsy of small/medium artery showing PMNs in arterial wall",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "3 or more of 10 criteria (sensitivity 82%, specificity 87%)",
    "notes": "Must exclude ANCA-associated vasculitis. The 2012 Chapel Hill Consensus Conference reaffirmed PAN as a medium-vessel vasculitis without glomerulonephritis or vasculitis in arterioles, capillaries, or venules. ANCA should be negative."
  },
