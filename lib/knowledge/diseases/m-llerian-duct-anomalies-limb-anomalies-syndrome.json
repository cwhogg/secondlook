  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Hormonal assays may show altered sex steroid levels"
    ],
    "imaging": [
      "Pelvic ultrasound or MRI demonstrating Müllerian duct anomalies",
      "X-rays showing limb malformations",
      "Renal ultrasound for associated renal anomalies",
      "Echocardiography for cardiac defects"
    ],
    "genetic": [
      "No consistent causative gene identified",
      "Genetic testing to exclude overlapping syndromes"
    ],
