  "diagnosticCriteria": {
    "formalCriteriaName": "Hoyeraal-Hreidarsson Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cerebellar-hypoplasia",
        "description": "Presence of cerebellar hypoplasia confirmed by neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Evidence of combined immunodeficiency with lymphopenia and recurrent infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mucocutaneous-features",
        "description": "Mucocutaneous features consistent with dyskeratosis congenita (nail dystrophy, skin pigmentation abnormalities, oral leukoplakia)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "telomere-length",
        "description": "Significantly shortened telomere length in peripheral blood leukocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of cerebellar hypoplasia, immunodeficiency, and developmental delay",
    "notes": "Genetic testing for mutations in telomere maintenance genes supports diagnosis"
  },
