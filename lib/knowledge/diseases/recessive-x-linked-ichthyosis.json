  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and biochemical diagnostic criteria for X-linked ichthyosis",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of generalized scaling with dark, adherent scales predominantly on the neck, trunk, and extensor surfaces",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "steroid-sulfatase-deficiency",
        "description": "Demonstration of steroid sulfatase enzyme deficiency in leukocytes or skin fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations or deletions in the STS gene on the X chromosome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing hyperkeratosis with absence of granular layer",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus either steroid sulfatase deficiency or pathogenic STS gene mutation",
    "notes": "Diagnosis is confirmed by biochemical or genetic testing; family history supports diagnosis but is not mandatory."
  },
