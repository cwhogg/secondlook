  "diagnosticCriteria": {
    "formalCriteriaName": "Comprehensive Diagnostic Criteria for IgG4-Related Disease (2019)",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Characteristic histopathological features including dense lymphoplasmacytic infiltration rich in IgG4-positive plasma cells, storiform fibrosis, and obliterative phlebitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serum-igg4-elevation",
        "description": "Elevated serum IgG4 concentration (>135 mg/dL)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thyroid-enlargement",
        "description": "Diffuse or localized thyroid enlargement with firm consistency on physical examination or imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-findings",
        "description": "Ultrasound or CT showing hypoechoic areas and diffuse thyroid involvement consistent with IgG4-related thyroiditis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation with IgG4-positive plasma cell infiltration plus elevated serum IgG4 levels; supportive clinical and imaging findings strengthen diagnosis",
    "notes": "Diagnosis requires exclusion of other thyroid diseases such as classic Hashimoto's thyroiditis and thyroid malignancies."
  },
