  "keyFindings": {
    "laboratory": [
      "Bronchoalveolar lavage fluid with milky appearance and PAS-positive lipoproteinaceous material",
      "Hypoxemia on arterial blood gas analysis",
      "Normal or elevated lactate dehydrogenase (LDH)"
    ],
    "imaging": [
      "High-resolution CT showing diffuse ground-glass opacities with interlobular septal thickening (crazy paving pattern)",
      "Chest X-ray with bilateral alveolar infiltrates"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Lung biopsy demonstrating alveolar filling with periodic acid–Schiff positive material",
      "Reduced surfactant protein levels in lung tissue"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pulmonary-alveolar-proteinosis-autoimmune-form",
      "distinguishingFeatures": [
        "Typically adult onset",
        "Presence of anti-GM-CSF antibodies",
        "Absence of genetic mutations in surfactant metabolism genes"
      ]
    },
    {
      "diseaseId": "neonatal-respiratory-distress-syndrome",
      "distinguishingFeatures": [
        "Prematurity as a major risk factor",
        "Surfactant deficiency rather than accumulation",
        "Improvement with exogenous surfactant therapy"
      ]
    }
  ],
  "redFlags": [
    "Severe hypoxemia unresponsive to oxygen supplementation",
    "Rapid progression to respiratory failure in neonate",
    "Failure to thrive despite supportive care"
  ],
