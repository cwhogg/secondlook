  "diagnosticCriteria": {
    "formalCriteriaName": "2015 ESC/ERS Pulmonary Hypertension Guidelines",
    "criteria": [
      {
        "id": "mPAP",
        "description": "Mean pulmonary arterial pressure (mPAP) ≥ 25 mmHg at rest measured by right heart catheterization",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "PAWP",
        "description": "Pulmonary artery wedge pressure (PAWP) ≤ 15 mmHg to exclude left heart disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "PVR",
        "description": "Pulmonary vascular resistance (PVR) > 3 Wood units",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion",
        "description": "Exclusion of other causes of pulmonary hypertension such as lung diseases, chronic thromboembolism, or left heart disease",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "All major criteria (mPAP ≥ 25 mmHg, PAWP ≤ 15 mmHg, PVR > 3 Wood units) plus exclusion of other causes",
    "notes": "Right heart catheterization is the gold standard for diagnosis"
  },
