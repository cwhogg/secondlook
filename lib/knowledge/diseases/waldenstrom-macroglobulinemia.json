    "sexPredilection": "slight-male",
    "ethnicAssociations": [
      "Caucasian predominance",
      "Rare in African and Asian populations"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "2nd International Workshop on Waldenstrom's Macroglobulinemia Consensus Criteria",
    "criteria": [
      {
        "id": "wm-c1",
        "description": "IgM monoclonal gammopathy of any concentration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "wm-c2",
        "description": "Bone marrow infiltration by small lymphocytes showing plasmacytoid or plasma cell differentiation (lymphoplasmacytic lymphoma)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "wm-c3",
        "description": "MYD88 L265P mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "wm-c4",
        "description": "CXCR4 mutations",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "wm-c5",
        "description": "Intertrabecular pattern of marrow infiltration",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "IgM monoclonal protein plus bone marrow involvement by lymphoplasmacytic lymphoma",
    "notes": "MYD88 L265P mutation found in >90% of WM cases and helps distinguish from other IgM-secreting lymphomas. Not all patients with IgM MGUS progress to WM."
  },
