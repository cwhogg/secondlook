  "diagnosticCriteria": {
    "formalCriteriaName": "ZAP70 Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-immunodeficiency",
        "description": "Severe recurrent infections indicative of combined immunodeficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-cd8-t-cells",
        "description": "Profound reduction or absence of CD8+ T cells in peripheral blood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "zap70-genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the ZAP70 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-t-cell-proliferation",
        "description": "Defective T-cell receptor signaling and impaired T-cell proliferation assays",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-cd4-t-cell-count",
        "description": "Normal or near-normal CD4+ T-cell counts despite immunodeficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe recurrent infections, absent CD8+ T cells, and biallelic pathogenic ZAP70 variants",
    "notes": "Diagnosis is confirmed by genetic testing combined with immunophenotyping and clinical presentation."
  },
