  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Cerebral Aneurysm Diagnostic Criteria",
    "criteria": [
      {
        "id": "family-history",
        "description": "Presence of two or more first-degree relatives with documented cerebral saccular aneurysms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aneurysm-detection",
        "description": "Identification of saccular aneurysm(s) on cerebral angiography or advanced neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-syndromic-causes",
        "description": "Exclusion of other genetic syndromes associated with aneurysms such as Ehlers-Danlos or polycystic kidney disease",
        "category": "minor",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with familial aneurysm predisposition (if available)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "At least two first-degree relatives with confirmed cerebral saccular aneurysms and imaging confirmation of aneurysm in the patient, with exclusion of other syndromic causes",
    "notes": "Genetic testing may support diagnosis but is not mandatory; imaging modalities include CTA, MRA, or DSA."
  },
