  "keyFindings": {
    "laboratory": [
      "Low-molecular-weight proteinuria (e.g., elevated beta-2 microglobulin or retinol-binding protein)",
      "Hypercalciuria",
      "Hypophosphatemia",
      "Elevated serum creatinine in progressive stages"
    ],
    "imaging": [
      "Renal ultrasound showing nephrocalcinosis or nephrolithiasis",
      "Bone X-rays indicating rickets or osteomalacia"
    ],
    "genetic": [
      "Pathogenic variants in OCRL gene",
      "Absence of pathogenic variants in CLCN5 gene"
    ],
    "other": [
      "Family history consistent with X-linked inheritance",
      "Progressive decline in renal function"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dent-disease-1",
      "distinguishingFeatures": [
        "Presence of pathogenic variants in CLCN5 gene",
        "Similar clinical presentation but genetically distinct"
      ]
    },
    {
      "diseaseId": "fanconi-syndrome",
      "distinguishingFeatures": [
        "Generalized proximal tubular dysfunction with multiple solute losses",
        "Often associated with systemic diseases or drug toxicity"
      ]
    },
    {
      "diseaseId": "low-molecular-weight-proteinuria-secondary-causes",
      "distinguishingFeatures": [
        "Proteinuria due to other renal tubular disorders or systemic diseases",
        "Lack of hypercalciuria or genetic confirmation"
      ]
    }
  ],
