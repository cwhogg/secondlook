  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Diagnostic Criteria for Leprosy",
    "criteria": [
      {
        "id": "hypopigmented-patch",
        "description": "Hypopigmented or erythematous skin patch with definite loss of sensation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-thickening",
        "description": "Thickened peripheral nerves with loss of sensation or muscle weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acid-fast-bacilli",
        "description": "Detection of acid-fast bacilli in skin smear or biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-lesions",
        "description": "Presence of characteristic skin lesions such as plaques or nodules",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-pain",
        "description": "Nerve pain or tenderness in affected areas",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "At least one major criterion (hypopigmented skin patch with sensory loss, nerve thickening, or acid-fast bacilli detection) is required for diagnosis.",
    "notes": "Diagnosis is clinical supported by laboratory confirmation when available."
  },
