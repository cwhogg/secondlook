  "keyFindings": {
    "laboratory": [
      "CSF analysis typically normal or nonspecific; 14-3-3 protein usually negative",
      "Elevated tau protein may be present"
    ],
    "imaging": [
      "MRI showing cerebellar atrophy and occasionally cortical atrophy",
      "Spongiform changes may be visible postmortem"
    ],
    "genetic": [
      "ATP7A (causative, loss-of-function)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Neuropathology reveals amyloid plaques and spongiform degeneration",
      "EEG may show nonspecific slowing"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "creutzfeldt-jakob-disease",
      "distinguishingFeatures": [
        "More rapid progression",
        "Characteristic periodic sharp wave complexes on EEG",
        "Usually sporadic rather than familial"
      ]
    },
    {
      "diseaseId": "spinocerebellar-ataxia",
      "distinguishingFeatures": [
        "Lack of prion protein gene mutation",
        "Different genetic mutations",
        "Absence of amyloid plaques"
      ]
    }
  ],
