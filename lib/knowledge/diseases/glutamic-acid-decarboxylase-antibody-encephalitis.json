{
  "id": "glutamic-acid-decarboxylase-antibody-encephalitis",
  "name": "Glutamic Acid Decarboxylase (GAD) Antibody Encephalitis",
  "aliases": [
    "Anti-GAD Encephalitis",
    "GAD Antibody-Associated Encephalitis",
    "Autoimmune GAD Encephalitis"
  ],
  "icd10Codes": [
    "G04.89"
  ],
  "prevalence": {
    "estimate": "1 in 1,000,000",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 10,
      "max": 70,
      "peak": 40
    },
    "sexPredilection": "slight-female",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Criteria for Autoimmune Encephalitis",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Subacute onset of psychiatric symptoms, seizures, or stiff-person syndrome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anti-gad-antibodies",
        "description": "Presence of elevated anti-GAD antibodies in serum or cerebrospinal fluid",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of infectious, neoplastic, metabolic, or other autoimmune causes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-mri",
        "description": "MRI findings suggestive of limbic encephalitis such as medial temporal lobe hyperintensity",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "csf-inflammatory-markers",
        "description": "CSF pleocytosis or elevated protein",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Subacute onset of compatible clinical syndrome plus positive anti-GAD antibodies and exclusion of alternative diagnoses",
    "notes": "Diagnosis is clinical and supported by antibody testing; MRI and CSF findings are supportive but not mandatory."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Stiff-person syndrome",
        "frequency": 0.75,
        "bodySystem": "musculoskeletal",
        "notes": "Characteristic muscle rigidity and spasms"
      },
      {
        "symptomName": "Anti-GAD antibody positivity",
        "frequency": 0.95,
        "bodySystem": "immunological",
        "notes": "Serum or CSF detection of anti-GAD antibodies"
      }
    ],
    "common": [
      {
        "symptomName": "Seizures",
        "frequency": 0.7,
        "bodySystem": "neurological",
        "notes": "Focal or generalized seizures"
      },
      {
        "symptomName": "Psychiatric symptoms",
        "frequency": 0.65,
        "bodySystem": "psychiatric",
        "notes": "Anxiety, depression, psychosis"
      },
      {
        "symptomName": "Cognitive dysfunction",
        "frequency": 0.6,
        "bodySystem": "neurological",
        "notes": "Memory impairment and executive dysfunction"
      },
      {
        "symptomName": "Ataxia",
        "frequency": 0.55,
        "bodySystem": "neurological",
        "notes": "Gait and coordination difficulties"
      }
    ],
    "occasional": [
      {
        "symptomName": "Autonomic dysfunction",
        "frequency": 0.4,
        "bodySystem": "neurological",
        "notes": "Orthostatic hypotension, sweating abnormalities"
      },
      {
        "symptomName": "Dysarthria",
        "frequency": 0.3,
        "bodySystem": "neurological",
        "notes": "Slurred speech"
      },
      {
        "symptomName": "Sleep disturbances",
        "frequency": 0.25,
        "bodySystem": "psychiatric",
        "notes": "Insomnia or hypersomnia"
      },
      {
        "symptomName": "Muscle cramps",
        "frequency": 0.15,
        "bodySystem": "musculoskeletal",
        "notes": "Painful involuntary contractions"
      }
    ],
    "rare": [
      {
        "symptomName": "Oculomotor abnormalities",
        "frequency": 0.08,
        "bodySystem": "neurological",
        "notes": "Nystagmus or diplopia"
      },
      {
        "symptomName": "Peripheral neuropathy",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Sensory or motor deficits"
      },
      {
        "symptomName": "Respiratory failure",
        "frequency": 0.03,
        "bodySystem": "respiratory",
        "notes": "Due to severe muscle rigidity or spasms"
      }
    ]
  },
  "systemsAffected": [
    "neurological",
