  "keyFindings": {
    "laboratory": [
      "Hypoalbuminemia",
      "Lymphopenia",
      "Hypogammaglobulinemia",
      "Hypocalcemia",
      "Elevated fecal alpha-1 antitrypsin"
    ],
    "imaging": [
      "Lymphangiography showing dilated intestinal lymphatics",
      "MRI or CT demonstrating intestinal wall thickening and lymphatic dilation",
      "Ultrasound showing ascites or pleural effusion"
    ],
    "genetic": [
      "No specific genetic mutation identified; primarily sporadic or congenital malformation"
    ],
    "other": [
      "Endoscopic findings of white, dilated mucosal lymphatics",
      "Histopathology confirming dilated lymphatic vessels in intestinal mucosa"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "secondary-intestinal-lymphangiectasia",
      "distinguishingFeatures": [
        "Secondary to conditions like constrictive pericarditis, lymphoma, or infections",
        "Presence of underlying systemic disease",
        "Reversible with treatment of primary cause"
      ]
    },
    {
      "diseaseId": "protein-losing-enteropathy",
      "distinguishingFeatures": [
        "Multiple etiologies including inflammatory bowel disease, celiac disease",
        "No primary lymphatic dilation on biopsy",
        "May have different endoscopic and histologic findings"
      ]
    },
    {
      "diseaseId": "congenital-chylous-ascites",
      "distinguishingFeatures": [
        "Predominantly chylous ascites without significant intestinal lymphangiectasia",
        "Presentation in neonates or infants",
        "Different imaging and clinical features"
      ]
    }
  ],
  "redFlags": [
    "Severe hypoalbuminemia with refractory edema",
    "Recurrent severe infections due to immunoglobulin loss",
    "Development of chylous effusions (pleural or ascitic)"
  ],
