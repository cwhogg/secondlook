        "requiredForDiagnosis": true
      },
      {
        "id": "absence-neural-tissue",
        "description": "No herniation of neural tissue into the meningeal sac confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "spinal-defect-imaging",
        "description": "Identification of a bony defect in the posterior vertebral elements on MRI or CT",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-intact",
        "description": "Absence of neurological deficits on clinical examination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of a cystic posterior spinal sac with no neural tissue herniation confirmed by imaging and identification of vertebral defect",
    "notes": "Diagnosis is primarily clinical and radiological; genetic testing is not typically indicated."
  },
