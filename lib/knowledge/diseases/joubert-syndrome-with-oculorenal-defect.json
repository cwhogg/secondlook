  "keyFindings": {
    "laboratory": [
      "Elevated serum creatinine and urea indicating renal impairment",
      "Urinalysis showing tubular dysfunction consistent with nephronophthisis"
    ],
    "imaging": [
      "Brain MRI demonstrating molar tooth sign (cerebellar vermis hypoplasia and thickened superior cerebellar peduncles)",
      "Renal ultrasound showing corticomedullary cysts and increased echogenicity"
    ],
    "genetic": [
      "CEP290 (causative)",
      "CC2D2A (causative)",
      "TMEM216 (causative)",
      "TMEM237 (causative)",
      "TMEM138 (causative, loss-of-function)",
      "ZNF423 (causative)",
      "TMEM231 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electroretinogram abnormalities consistent with retinal dystrophy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "meckel-gruber-syndrome",
      "distinguishingFeatures": [
        "More severe encephalocele and polydactyly",
        "Lethal in perinatal period",
        "Marked renal cystic dysplasia"
      ]
    },
    {
      "diseaseId": "nephronophthisis-without-joubert-syndrome",
      "distinguishingFeatures": [
        "Renal involvement without neurological abnormalities or molar tooth sign",
        "Later onset of kidney failure",
        "Absence of oculomotor apraxia"
      ]
    },
    {
      "diseaseId": "bardet-biedl-syndrome",
      "distinguishingFeatures": [
        "Obesity and polydactyly",
        "Retinal dystrophy but no molar tooth sign",
        "Cognitive impairment less severe"
      ]
    }
  ],
