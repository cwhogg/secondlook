  "diagnosticCriteria": {
    "formalCriteriaName": "Sotos Syndrome Clinical Diagnostic Criteria",
    "criteria": [
      {
        "id": "macrocephaly",
        "description": "Macrocephaly defined as head circumference >2 standard deviations above mean",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facial-features",
        "description": "Distinctive facial gestalt including frontal bossing, high anterior hairline, down-slanting palpebral fissures, and pointed chin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "overgrowth",
        "description": "Height and/or weight >2 standard deviations above mean for age",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nsd1-mutation",
        "description": "Pathogenic variant in NSD1 gene identified by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of macrocephaly, characteristic facial features, and developmental delay; molecular confirmation supports diagnosis",
    "notes": "Molecular testing for NSD1 mutations is confirmatory but not always necessary if clinical criteria are met"
  },
