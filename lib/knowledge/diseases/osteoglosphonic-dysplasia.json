  "keyFindings": {
    "laboratory": [
      "Mild anemia and pancytopenia on complete blood count",
      "Normal to elevated serum calcium and alkaline phosphatase"
    ],
    "imaging": [
      "Diffuse osteosclerosis with 'bone within bone' appearance on X-rays",
      "Narrowing of cranial foramina on CT scan",
      "Skull radiographs showing thickened calvarium and sclerosis"
    ],
    "genetic": [
      "FGFR1 (causative, gain-of-function)",
      "Autosomal dominant or recessive inheritance patterns reported"
    ],
    "other": [
      "Bone marrow biopsy showing reduced hematopoietic space",
      "Airway evaluation confirming glossoptosis and obstruction"
    ]
  },
