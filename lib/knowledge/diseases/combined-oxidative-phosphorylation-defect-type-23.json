  "keyFindings": {
    "laboratory": [
      "Elevated blood and CSF lactate and pyruvate levels",
      "Combined deficiency of mitochondrial respiratory chain complexes I, III, and IV in muscle biopsy",
      "Elevated serum creatine kinase in some cases"
    ],
    "imaging": [
      "Brain MRI showing basal ganglia lesions, cerebral atrophy, and brainstem abnormalities",
      "Cardiac echocardiogram demonstrating hypertrophic or dilated cardiomyopathy"
    ],
    "genetic": [
      "GTPBP3 (causative)",
      "Pathogenic variants in nuclear genes encoding mitochondrial oxidative phosphorylation components or assembly factors",
      "Mitochondrial DNA depletion or multiple deletions may be present",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy showing ragged-red fibers and abnormal mitochondrial morphology on electron microscopy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "mitochondrial-complex-i-deficiency",
      "distinguishingFeatures": [
        "Isolated complex I deficiency rather than combined complex deficiencies",
        "More variable age of onset and clinical presentation"
      ]
    },
    {
      "diseaseId": "leigh-syndrome",
      "distinguishingFeatures": [
        "Characteristic symmetrical lesions in basal ganglia and brainstem on MRI",
        "Often associated with specific mitochondrial or nuclear gene mutations distinct from COXPD23"
      ]
    }
  ],
