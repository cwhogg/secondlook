  "diagnosticCriteria": {
    "formalCriteriaName": "IFAP Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "ichthyosis-follicularis",
        "description": "Presence of follicular ichthyosis characterized by follicular hyperkeratosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alopecia-totalis",
        "description": "Congenital alopecia involving scalp, eyebrows, and eyelashes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "photophobia",
        "description": "Marked photophobia due to corneal epithelial defects and keratitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "additional-ocular-features",
        "description": "Additional ocular abnormalities such as corneal vascularization and scarring",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "other-cutaneous-features",
        "description": "Additional skin findings including hyperkeratotic plaques and palmoplantar keratoderma",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (follicular ichthyosis, congenital alopecia, and photophobia) must be present for diagnosis.",
    "notes": "Genetic testing for MBTPS2 mutations can support diagnosis but is not mandatory."
  },
