  "keyFindings": {
    "laboratory": [
      "Elevated methylmalonic acid in plasma and urine",
      "Metabolic acidosis with increased anion gap",
      "Hyperammonemia during metabolic crises",
      "Elevated propionylcarnitine (C3) on acylcarnitine profile"
    ],
    "imaging": [
      "Brain MRI showing basal ganglia abnormalities and cerebral atrophy",
      "Renal ultrasound may show nephrocalcinosis or chronic changes"
    ],
    "genetic": [
      "Pathogenic variants in MUT gene causing methylmalonyl-CoA mutase deficiency",
      "Negative response to vitamin B12 supplementation distinguishes from B12-responsive forms",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Abnormal organic acid profile on urine organic acid chromatography",
      "Poor or absent clinical response to hydroxocobalamin therapy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "vitamin-b12-responsive-methylmalonic-acidemia",
      "distinguishingFeatures": [
        "Improvement with vitamin B12 supplementation",
        "Different genetic mutations (e.g., MMAA, MMAB genes)",
        "Less severe metabolic crises"
      ]
    },
    {
      "diseaseId": "propionic-acidemia",
      "distinguishingFeatures": [
        "Elevated propionic acid rather than methylmalonic acid",
        "Different enzymatic defect (propionyl-CoA carboxylase deficiency)",
        "Similar metabolic acidosis but distinct organic acid profile"
      ]
    }
  ],
  "redFlags": [
    "Recurrent severe metabolic ketoacidosis episodes",
    "Rapid neurological deterioration in infancy",
    "Lack of response to vitamin B12 supplementation"
  ],
