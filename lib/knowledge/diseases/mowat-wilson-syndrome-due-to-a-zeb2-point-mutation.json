  "diagnosticCriteria": {
    "formalCriteriaName": "Mowat-Wilson Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "zygote-mutation",
        "description": "Presence of a pathogenic point mutation in the ZEB2 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facial-features",
        "description": "Distinctive facial gestalt including hypertelorism, broad nasal bridge, uplifted earlobes, and prominent chin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-hirschsprung-disease",
        "description": "Diagnosis of Hirschsprung disease or chronic constipation with intestinal dysmotility",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "intellectual-disability",
        "description": "Moderate to severe intellectual disability with delayed developmental milestones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "History of epilepsy or seizure disorder",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic ZEB2 mutation plus characteristic facial features and intellectual disability",
    "notes": "Hirschsprung disease is common but not mandatory for diagnosis; molecular confirmation is essential."
  },
