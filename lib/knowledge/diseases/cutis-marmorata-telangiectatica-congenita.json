  "diagnosticCriteria": {
    "formalCriteriaName": "CMTC Diagnostic Criteria",
    "criteria": [
      {
        "id": "persistent-cutis-marmorata",
        "description": "Persistent reticulated marbled erythema present at birth or shortly after",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "telangiectasia",
        "description": "Presence of telangiectatic vessels within the affected skin areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-atrophy",
        "description": "Localized skin atrophy or ulceration in affected regions",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "limb-asymmetry",
        "description": "Unilateral limb size discrepancy or asymmetry",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-systemic-involvement",
        "description": "No evidence of systemic vascular malformations or syndromic associations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent cutis marmorata and telangiectasia with or without minor criteria",
    "notes": "Diagnosis is primarily clinical; biopsy and imaging may support but are not mandatory."
  },
