  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Dopa-Responsive Dystonia",
    "criteria": [
      {
        "id": "early-onset-dystonia",
        "description": "Onset of dystonia in childhood or adolescence, typically before age 15",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "diurnal-fluctuation",
        "description": "Presence of diurnal fluctuation of symptoms with worsening in the evening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "levodopa-responsiveness",
        "description": "Marked and sustained improvement of dystonia symptoms with low-dose levodopa treatment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-neurodegeneration",
        "description": "No evidence of neurodegeneration on imaging or clinical progression",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset dystonia with diurnal fluctuation and marked levodopa responsiveness",
    "notes": "Genetic testing for GCH1 mutations supports diagnosis but is not mandatory."
  },
