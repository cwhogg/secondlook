  "diagnosticCriteria": {
    "formalCriteriaName": "Pyruvate Carboxylase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of lactic acidosis with neurological impairment and failure to thrive",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-evidence",
        "description": "Elevated blood lactate and pyruvate levels with increased lactate-to-pyruvate ratio",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-activity",
        "description": "Reduced pyruvate carboxylase enzyme activity in fibroblasts or liver tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the PC gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "brain-imaging",
        "description": "Neuroimaging showing cerebral atrophy or hypomyelination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus biochemical evidence and reduced enzyme activity",
    "notes": "Genetic testing supports diagnosis but is not mandatory if enzyme assay is conclusive."
  },
