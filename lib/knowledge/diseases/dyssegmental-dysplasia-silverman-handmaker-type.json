        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the COL2A1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe rhizomelic limb shortening, vertebral segmentation defects, and characteristic radiographic metaphyseal irregularities",
    "notes": "Diagnosis is primarily clinical and radiological; genetic testing can support but is not always available."
