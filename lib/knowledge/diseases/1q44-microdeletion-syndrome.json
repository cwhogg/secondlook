  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for 1q44 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "molecular-confirmation",
        "description": "Detection of a heterozygous microdeletion involving the 1q44 chromosomal region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "corpus-callosum-abnormality",
        "description": "Presence of agenesis or hypoplasia of the corpus callosum on brain MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Characteristic facial dysmorphisms such as microcephaly, flat nasal bridge, and hypertelorism",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "History of seizures or epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of 1q44 microdeletion plus at least two major clinical features including corpus callosum abnormality and developmental delay",
    "notes": "Diagnosis relies heavily on molecular genetic testing combined with neuroimaging and clinical assessment."
  },
