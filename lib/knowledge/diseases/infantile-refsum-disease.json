  "diagnosticCriteria": {
    "formalCriteriaName": "Infantile Refsum Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "phytanic-acid-elevation",
        "description": "Elevated plasma phytanic acid levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peroxisomal-biogenesis-defect",
        "description": "Evidence of peroxisomal biogenesis disorder on biochemical testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features including retinitis pigmentosa, sensorineural hearing loss, and developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in PEX genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated phytanic acid plus clinical features consistent with Infantile Refsum disease and biochemical evidence of peroxisomal dysfunction",
    "notes": "Genetic confirmation is supportive but not mandatory if biochemical and clinical criteria are met."
  },
