  "diagnosticCriteria": {
    "formalCriteriaName": "Progressive Non-Infectious Anterior Vertebral Fusion Diagnostic Criteria",
    "criteria": [
      {
        "id": "anterior-vertebral-fusion",
        "description": "Radiological evidence of progressive anterior vertebral body fusion without signs of infection",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-infectious-markers",
        "description": "Lack of clinical, laboratory, or microbiological evidence of vertebral infection",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-spinal-stiffness",
        "description": "Clinical progression of spinal stiffness and reduced mobility over time",
        "category": "minor",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-etiologies",
        "description": "Exclusion of other causes of vertebral fusion such as trauma, neoplasm, or inflammatory spondyloarthropathies",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of radiological anterior vertebral fusion and absence of infectious markers with progressive spinal stiffness, excluding other etiologies",
    "notes": "Diagnosis relies heavily on imaging and exclusion of infectious or inflammatory causes."
  },
