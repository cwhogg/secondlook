  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible mild hypothyroidism",
      "Immunological panels may show mild deficiencies"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter changes",
      "Echocardiogram revealing congenital heart defects",
      "Skeletal X-rays showing clinodactyly or scoliosis"
    ],
    "genetic": [
      "Deletion involving distal 12q24 region confirmed by chromosomal microarray or FISH",
      "Variable size deletions affecting multiple genes"
    ],
    "other": [
      "Developmental assessments confirming intellectual disability",
      "Audiological testing for hearing impairment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "wolf-hirschhorn-syndrome",
      "distinguishingFeatures": [
        "Deletion on chromosome 4p instead of 12q",
        "Distinctive 'Greek warrior helmet' facial appearance",
        "More severe growth retardation and seizures"
      ]
    },
    {
      "diseaseId": "cri-du-chat-syndrome",
      "distinguishingFeatures": [
        "Deletion on chromosome 5p",
        "Characteristic high-pitched cat-like cry in infancy",
        "Microcephaly and severe intellectual disability"
      ]
    }
  ],
  "redFlags": [
    "Severe congenital heart defects requiring early intervention",
    "Profound developmental delay with regression",
    "Recurrent unexplained infections suggesting immunodeficiency"
  ],
