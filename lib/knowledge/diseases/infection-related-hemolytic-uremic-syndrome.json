  "keyFindings": {
    "laboratory": [
      "Schistocytes on peripheral blood smear",
      "Elevated lactate dehydrogenase (LDH)",
      "Low haptoglobin",
      "Thrombocytopenia",
      "Elevated serum creatinine and blood urea nitrogen (BUN)",
      "Positive stool culture or PCR for Shiga toxin-producing E. coli"
    ],
    "imaging": [
      "Renal ultrasound may show normal or enlarged kidneys",
      "Brain MRI or CT if neurological symptoms present"
    ],
    "genetic": [
      "No primary genetic mutations typically associated; distinguishes from atypical HUS"
    ],
    "other": [
      "Evidence of preceding diarrheal illness",
      "Hypertension on clinical examination"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "atypical-hemolytic-uremic-syndrome",
      "distinguishingFeatures": [
        "Lack of preceding diarrheal illness",
        "Complement pathway mutations",
        "Poor response to supportive care alone"
      ]
    },
    {
      "diseaseId": "thrombotic-thrombocytopenic-purpura",
      "distinguishingFeatures": [
        "Severe ADAMTS13 deficiency",
        "Prominent neurological symptoms",
        "Less severe renal impairment"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive renal failure",
    "Neurological deterioration including seizures or coma",
    "Severe thrombocytopenia with bleeding"
  ],
