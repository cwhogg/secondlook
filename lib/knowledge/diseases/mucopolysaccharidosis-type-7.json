  "keyFindings": {
    "laboratory": [
      "Reduced beta-glucuronidase enzyme activity in leukocytes or fibroblasts",
      "Elevated urinary glycosaminoglycans (dermatan sulfate, chondroitin sulfate)"
    ],
    "imaging": [
      "Radiographic evidence of dysostosis multiplex including thickened ribs, oar-shaped ribs, and vertebral anomalies",
      "Brain MRI may show hydrocephalus or white matter changes"
    ],
    "genetic": [
      "GUSB (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electrocardiogram and echocardiogram abnormalities consistent with valvular heart disease",
      "Audiometry confirming hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "mucopolysaccharidosis-type-1",
      "distinguishingFeatures": [
        "Alpha-L-iduronidase deficiency",
