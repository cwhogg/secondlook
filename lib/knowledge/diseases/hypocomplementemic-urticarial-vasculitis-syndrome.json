  "keyFindings": {
    "laboratory": [
      "Low serum complement levels (C1q, C3, C4)",
      "Presence of anti-C1q autoantibodies",
      "Elevated inflammatory markers (ESR, CRP)"
    ],
    "imaging": [
      "Chest X-ray or CT showing pulmonary infiltrates or hemorrhage",
      "Renal ultrasound may show abnormalities in glomerulonephritis"
    ],
    "genetic": [
      "No specific genetic mutation identified; autoimmune etiology"
    ],
    "other": [
      "Skin biopsy showing leukocytoclastic vasculitis",
      "Urinalysis showing proteinuria or hematuria"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "Positive ANA and anti-dsDNA antibodies",
        "More widespread systemic involvement",
        "Variable complement levels, often low"
      ]
    },
    {
      "diseaseId": "cryoglobulinemic-vasculitis",
      "distinguishingFeatures": [
        "Presence of cryoglobulins in serum",
        "Often associated with hepatitis C infection",
        "Palpable purpura rather than urticarial lesions"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive glomerulonephritis",
    "Pulmonary hemorrhage or respiratory distress",
    "Central nervous system vasculitis symptoms (e.g., seizures, focal deficits)"
  ],
