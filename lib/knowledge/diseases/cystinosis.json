  "keyFindings": {
    "laboratory": [
      "Elevated cystine levels in peripheral blood leukocytes",
      "Metabolic acidosis with electrolyte abnormalities (hypophosphatemia, hypokalemia)",
      "Proteinuria and aminoaciduria consistent with Fanconi syndrome"
    ],
    "imaging": [
      "Slit-lamp examination showing corneal cystine crystals",
      "Skeletal X-rays showing rickets and bone deformities"
    ],
    "genetic": [
      "Pathogenic mutations in CTNS gene on chromosome 17p13",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Renal biopsy showing cystine crystal accumulation in proximal tubular cells"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "fanconi-syndrome",
      "distinguishingFeatures": [
        "Absence of corneal cystine crystals",
