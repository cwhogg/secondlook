  "keyFindings": {
    "laboratory": [
      "Metabolic acidosis on blood gas analysis",
      "Elevated lactate levels due to tissue hypoperfusion"
    ],
    "imaging": [
      "Echocardiography showing interruption of the aortic arch",
      "Cardiac MRI or CT angiography confirming aortic arch discontinuity",
      "Chest X-ray showing cardiomegaly and pulmonary congestion"
    ],
    "genetic": [
      "Association with 22q11.2 deletion syndrome (DiGeorge syndrome) in some cases"
    ],
    "other": [
      "Pulse oximetry showing differential oxygen saturation between upper and lower extremities",
      "Absence of femoral pulses on physical examination"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "coarctation-of-the-aorta",
      "distinguishingFeatures": [
        "Narrowing rather than complete interruption of the aortic arch",
        "Less severe neonatal heart failure",
        "Presence of continuous aortic arch on imaging"
      ]
    },
    {
      "diseaseId": "hypoplastic-aortic-arch",
      "distinguishingFeatures": [
        "Uniformly small but continuous aortic arch",
        "Different surgical management",
        "Less abrupt clinical presentation"
      ]
    }
  ],
  "redFlags": [
    "Severe heart failure within first days of life",
    "Absent or weak femoral pulses",
    "Differential cyanosis with lower body hypoxia"
  ],
