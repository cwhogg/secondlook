  "keyFindings": {
    "laboratory": [
      "Urinalysis showing hematuria or infection",
      "Elevated serum creatinine in advanced cases",
      "Urine culture positive in urinary tract infections"
    ],
    "imaging": [
      "Ultrasound showing fused lower poles and isthmus",
      "CT or MRI confirming horseshoe shape and associated complications",
      "Intravenous pyelogram demonstrating abnormal renal drainage"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Physical exam may reveal palpable abdominal mass",
      "Increased risk of obstruction and nephrolithiasis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "renal-ectopia",
