  "diagnosticCriteria": {
    "formalCriteriaName": "Klippel-Trenaunay Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "capillary-malformation",
        "description": "Presence of a port-wine stain (capillary malformation)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "venous-anomalies",
        "description": "Venous malformations or varicosities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-hypertrophy",
        "description": "Soft tissue and/or bony hypertrophy of an extremity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphatic-malformation",
        "description": "Presence of lymphatic anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pain-swelling",
        "description": "Chronic limb pain or swelling",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: capillary malformation, venous anomalies, and limb hypertrophy",
    "notes": "Diagnosis is clinical; imaging supports confirmation of vascular anomalies."
  },
