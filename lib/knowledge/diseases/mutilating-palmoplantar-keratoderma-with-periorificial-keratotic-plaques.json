  "diagnosticCriteria": {
    "formalCriteriaName": "Olmsted Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "palmoplantar-keratoderma",
        "description": "Diffuse mutilating palmoplantar keratoderma with fissuring and painful erosions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "periorificial-keratotic-plaques",
        "description": "Presence of hyperkeratotic plaques around periorificial areas including mouth, nose, and eyes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digital-autoamputation",
        "description": "Progressive constriction leading to spontaneous autoamputation of digits",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pruritus",
        "description": "Severe pruritus associated with keratoderma lesions",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "alopecia",
        "description": "Scarring alopecia or hair abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (mutilating palmoplantar keratoderma and periorificial keratotic plaques) with supportive clinical features",
    "notes": "Genetic testing for TRPV3 mutations can support diagnosis"
  },
