  "diagnosticCriteria": {
    "formalCriteriaName": "Neonatal Compartment Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "limb-swelling",
        "description": "Marked swelling and tense compartments of an extremity at or shortly after birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-necrosis",
        "description": "Skin changes including bullae, necrosis, or ischemic discoloration over affected compartment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurovascular-compromise",
        "description": "Evidence of neurovascular compromise such as absent distal pulses or decreased limb movement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-support",
        "description": "Imaging findings consistent with increased compartment pressure or muscle edema",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "history-risk-factors",
        "description": "Perinatal risk factors such as difficult delivery, limb trauma, or vascular occlusion",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (limb swelling with tense compartments, skin necrosis, and neurovascular compromise) is required for diagnosis.",
    "notes": "Early recognition is critical to prevent permanent limb damage."
  },
