  "diagnosticCriteria": {
    "formalCriteriaName": "ESID Diagnostic Criteria for SCID",
    "criteria": [
      {
        "id": "lymphopenia",
        "description": "Profound T-cell lymphopenia with absent or severely reduced T-cell function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogammaglobulinemia",
        "description": "Low or absent serum immunoglobulins (IgG, IgA, IgM)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dclre1c-mutation",
        "description": "Identification of biallelic pathogenic variants in the DCLRE1C gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-thymic-shadow",
        "description": "Radiologic evidence of absent or hypoplastic thymus on chest imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "failure-to-thrive",
        "description": "Clinical evidence of failure to thrive in infancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of profound T-cell lymphopenia, hypogammaglobulinemia, and biallelic pathogenic variants in DCLRE1C",
    "notes": "Diagnosis is confirmed by genetic testing; early diagnosis critical for treatment."
  },
