  "diagnosticCriteria": {
    "formalCriteriaName": "Renal Hypoplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "kidney-size",
        "description": "Kidney length and volume significantly below age-matched norms on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Reduced nephron number confirmed by renal biopsy or autopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chronic-kidney-disease",
        "description": "Evidence of chronic kidney disease with no other identifiable cause",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-malformations",
        "description": "No evidence of renal dysplasia or cystic kidney disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of underdeveloped kidney size on imaging plus histopathological confirmation of reduced nephron number",
    "notes": "Diagnosis often requires exclusion of other congenital renal anomalies."
  },
