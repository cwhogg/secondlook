  "diagnosticCriteria": {
    "formalCriteriaName": "Nascimento syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Severe to profound intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia with poor muscle tone",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent supraorbital ridges, broad nasal bridge, and large ears",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "Early-onset seizures or epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Pathogenic mutation in UBE2A gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of severe intellectual disability, neonatal hypotonia, characteristic facial dysmorphism, and confirmed pathogenic UBE2A mutation",
    "notes": "Diagnosis is confirmed by molecular genetic testing identifying UBE2A mutations; clinical features support diagnosis."
  },
