        "No fusion of fingers and toes"
      ]
    },
    {
      "diseaseId": "pfeiffer-syndrome",
      "distinguishingFeatures": [
        "Broad thumbs and big toes rather than syndactyly",
        "Variable craniosynostosis",
        "FGFR1 or FGFR2 mutations"
      ]
    }
  ],
