  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for Lesch-Nyhan Syndrome",
    "criteria": [
      {
        "id": "hyperuricemia",
        "description": "Elevated serum and urine uric acid levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-dysfunction",
        "description": "Presence of dystonia, choreoathetosis, and spasticity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "self-mutilation",
        "description": "Characteristic compulsive self-injurious behaviors such as lip and finger biting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hprt-deficiency",
        "description": "Deficiency of hypoxanthine-guanine phosphoribosyltransferase enzyme activity",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the HPRT1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hyperuricemia, neurological dysfunction, and self-mutilation behaviors",
    "notes": "Diagnosis is confirmed by biochemical enzyme assay and/or genetic testing."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Compulsive self-injurious behavior",
        "frequency": 0.95,
        "bodySystem": "psychiatric",
        "notes": "Includes lip and finger biting leading to tissue damage",
        "searchTerms": [
          "repetitive self-harm behavior",
          "compulsive self-injury",
          "repeated self-inflicted wounds"
        ]
      },
      {
        "symptomName": "Hyperuricemia",
        "frequency": 0.9,
        "bodySystem": "renal",
        "notes": "Elevated uric acid levels in blood and urine"
      },
      {
        "symptomName": "Dystonia and choreoathetosis",
        "frequency": 0.85,
        "bodySystem": "neurological",
        "notes": "Involuntary muscle contractions and abnormal movements",
        "searchTerms": [
          "involuntary twisting and jerking movements",
          "muscle contractions causing abnormal posture",
          "dystonic and choreiform movements"
        ]
      }
    ],
    "common": [
