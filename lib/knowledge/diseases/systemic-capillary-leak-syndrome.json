  "keyFindings": {
    "laboratory": [
      "Elevated hematocrit during acute episodes",
      "Hypoalbuminemia without proteinuria",
      "Presence of monoclonal gammopathy (IgG kappa) in serum"
    ],
    "imaging": [
      "Edema visible on soft tissue imaging",
      "Possible pulmonary edema on chest X-ray during attacks"
    ],
    "genetic": [
      "No consistent genetic mutations identified; idiopathic etiology"
    ],
