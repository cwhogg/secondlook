  "keyFindings": {
    "laboratory": [
      "Elevated plasma somatostatin concentration",
      "Hyperglycemia with impaired insulin secretion",
      "Mild anemia due to malabsorption"
    ],
    "imaging": [
      "CT or MRI showing pancreatic mass, often in the head or tail",
      "Somatostatin receptor scintigraphy demonstrating tumor localization",
      "Ultrasound evidence of cholelithiasis"
    ],
    "genetic": [
      "No well-established genetic mutations; sporadic occurrence typical"
    ],
    "other": [
      "Histopathology with neuroendocrine tumor markers positive for somatostatin",
      "Immunohistochemical staining positive for somatostatin and neuroendocrine markers (chromogranin A, synaptophysin)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "insulinoma",
      "distinguishingFeatures": [
        "Hypoglycemia due to insulin hypersecretion rather than hyperglycemia",
        "Elevated insulin and C-peptide levels",
        "Absence of steatorrhea and cholelithiasis"
      ]
    },
    {
      "diseaseId": "glucagonoma",
      "distinguishingFeatures": [
        "Elevated glucagon levels",
        "Necrolytic migratory erythema skin rash",
        "Weight loss and diabetes but without steatorrhea or cholelithiasis"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset of diabetes mellitus with unexplained steatorrhea",
    "Presence of pancreatic mass with elevated somatostatin levels",
    "Development of cholelithiasis without typical risk factors"
  ],
