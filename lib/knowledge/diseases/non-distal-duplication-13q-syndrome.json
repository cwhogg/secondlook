  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and cytogenetic diagnosis of non-distal duplication 13q syndrome",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Identification of duplication involving the proximal or interstitial region of chromosome 13q by karyotyping or chromosomal microarray",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial anomalies including microcephaly, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital malformations such as cardiac defects or limb anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of 13q duplication involving non-distal regions plus presence of at least two major clinical features",
    "notes": "Diagnosis relies heavily on genetic testing combined with clinical phenotype."
  },
