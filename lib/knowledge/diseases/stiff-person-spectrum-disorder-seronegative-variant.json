  "diagnosticCriteria": {
    "formalCriteriaName": "Provisional Diagnostic Criteria for Seronegative Stiff-Person Spectrum Disorder",
    "criteria": [
      {
        "id": "muscle-rigidity",
        "description": "Progressive axial and limb muscle rigidity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-spasms",
        "description": "Recurrent, stimulus-sensitive painful muscle spasms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seronegative-antibodies",
        "description": "Absence of detectable anti-GAD65, anti-amphiphysin, and other known antibodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electromyographic evidence of continuous motor unit activity",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-immunotherapy",
        "description": "Clinical improvement with immunomodulatory treatment",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive muscle rigidity and spasms with seronegative antibody status; supportive electrophysiology or immunotherapy response strengthens diagnosis",
    "notes": "Diagnosis requires exclusion of other causes of rigidity and spasms; seronegative status differentiates from classic stiff-person syndrome"
  },
