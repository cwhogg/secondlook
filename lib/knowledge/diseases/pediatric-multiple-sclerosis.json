        "requiredForDiagnosis": true
      },
      {
        "id": "dissemination-in-time",
        "description": "MRI evidence of new lesions over time or presence of both enhancing and non-enhancing lesions on the same scan",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-attacks",
        "description": "Two or more clinical attacks consistent with CNS demyelination separated by at least 30 days",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-alternatives",
        "description": "Exclusion of alternative diagnoses such as neuromyelitis optica spectrum disorder or acute disseminated encephalomyelitis",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Two or more clinical attacks with MRI evidence of dissemination in space and time, and exclusion of alternative diagnoses",
    "notes": "Diagnostic criteria are adapted from adult MS criteria with consideration of pediatric-specific presentations and differential diagnoses."
