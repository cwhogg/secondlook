  "diagnosticCriteria": {
    "formalCriteriaName": "Congenital Ichthyosis-Microcephalus-Tetraplegia Diagnostic Criteria",
    "criteria": [
      {
        "id": "ichthyosis",
        "description": "Presence of congenital ichthyosis characterized by generalized scaling and thickened skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microcephalus",
        "description": "Microcephaly defined as head circumference below the 3rd percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tetraplegia",
        "description": "Tetraplegia with severe motor impairment affecting all four limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Severe global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "Recurrent seizures or epilepsy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: congenital ichthyosis, microcephalus, and tetraplegia",
    "notes": "Diagnosis is clinical; genetic testing may assist but no specific gene identified"
  },
