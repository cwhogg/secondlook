  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for SCA7",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "retinopathy",
        "description": "Cone-rod dystrophy leading to progressive visual loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Pathogenic CAG trinucleotide repeat expansion in ATXN7 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected family members",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia and cone-rod dystrophy with confirmation of pathogenic CAG repeat expansion in ATXN7 gene",
    "notes": "Genetic testing is definitive; clinical features guide initial suspicion."
  },
