  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Tumoral Calcinosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "calcified-masses",
        "description": "Presence of large, painless periarticular calcified masses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyperphosphatemia",
        "description": "Elevated serum phosphate levels with normal serum calcium",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic mutations in FGF23, GALNT3, or KL genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-renal-function",
        "description": "Normal renal function excluding secondary causes of calcinosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of periarticular calcified masses plus hyperphosphatemia and identification of pathogenic mutation or compatible family history",
    "notes": "Diagnosis requires exclusion of secondary causes of tumoral calcinosis such as chronic kidney disease."
  },
