  "keyFindings": {
    "laboratory": [
      "Normal cardiac biomarkers or mild elevation of natriuretic peptides",
      "Exclusion of infiltrative diseases by serum and urine protein electrophoresis"
    ],
    "imaging": [
      "Echocardiography showing restrictive filling pattern and biatrial enlargement",
      "Cardiac MRI demonstrating normal or mildly increased ventricular volumes with impaired relaxation",
      "Absence of late gadolinium enhancement typical of infiltrative cardiomyopathies"
    ],
    "genetic": [
      "FLNC (causative)",
      "KIF20A (causative, loss-of-function)",
      "TNNI3 (causative)",
      "TNNT2 (causative)",
      "MYPN (causative)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Hemodynamic catheterization showing elevated ventricular filling pressures with normal systolic function"
    ]
  },
  "differentialDiagnoses": [
