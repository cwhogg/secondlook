  "diagnosticCriteria": {
    "formalCriteriaName": "MPI-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "protein-losing-enteropathy",
        "description": "Presence of protein-losing enteropathy confirmed by clinical and laboratory findings",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypoglycemia",
        "description": "Recurrent or persistent hypoglycemia episodes without other identifiable causes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mannose-therapy-response",
        "description": "Clinical and biochemical improvement upon mannose supplementation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-disease",
        "description": "Evidence of liver dysfunction or hepatomegaly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "abnormal-transferrin-glycosylation",
        "description": "Abnormal serum transferrin isoelectric focusing pattern consistent with CDG",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of protein-losing enteropathy, hypoglycemia, and positive response to mannose therapy",
    "notes": "Genetic confirmation of MPI gene mutations supports diagnosis"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Protein-losing enteropathy",
        "frequency": 0.85,
        "bodySystem": "gastrointestinal",
        "notes": "Leads to hypoalbuminemia and edema"
      },
      {
        "symptomName": "Hypoglycemia",
        "frequency": 0.8,
        "bodySystem": "endocrine",
        "notes": "Often fasting or postprandial"
      },
      {
        "symptomName": "Liver disease with hepatomegaly",
        "frequency": 0.75,
        "bodySystem": "gastrointestinal",
        "notes": "Variable severity including elevated liver enzymes"
      }
    ],
    "common": [
      {
        "symptomName": "Failure to thrive",
        "frequency": 0.7,
        "bodySystem": "constitutional",
        "notes": "Due to malabsorption and metabolic disturbances"
      },
      {
        "symptomName": "Diarrhea",
        "frequency": 0.65,
        "bodySystem": "gastrointestinal",
        "notes": "Chronic and protein-rich"
      },
      {
        "symptomName": "Coagulopathy",
        "frequency": 0.6,
        "bodySystem": "hematological",
        "notes": "Due to liver dysfunction"
      },
      {
        "symptomName": "Hypoalbuminemia",
        "frequency": 0.6,
        "bodySystem": "hematological",
        "notes": "Secondary to protein loss"
      },
      {
        "symptomName": "Elevated serum transaminases",
        "frequency": 0.55,
        "bodySystem": "gastrointestinal",
        "notes": "Indicative of liver injury"
      }
    ],
    "occasional": [
      {
        "symptomName": "Abdominal distension",
        "frequency": 0.4,
        "bodySystem": "gastrointestinal",
        "notes": "Due to ascites or hepatomegaly"
      },
      {
        "symptomName": "Edema",
        "frequency": 0.35,
        "bodySystem": "constitutional",
        "notes": "Peripheral edema related to hypoalbuminemia"
      },
      {
        "symptomName": "Hypoglycemia-induced seizures",
        "frequency": 0.3,
        "bodySystem": "neurological",
        "notes": "Secondary to severe hypoglycemia"
      },
      {
        "symptomName": "Failure of normal glycosylation on transferrin testing",
        "frequency": 0.25,
        "bodySystem": "hematological",
        "notes": "Detected by isoelectric focusing"
      },
      {
        "symptomName": "Mild developmental delay",
        "frequency": 0.15,
        "bodySystem": "neurological",
        "notes": "Less common than in other CDG types"
      }
    ],
    "rare": [
      {
        "symptomName": "Thrombocytopenia",
        "frequency": 0.08,
        "bodySystem": "hematological",
        "notes": "Due to liver dysfunction or splenic sequestration"
      },
      {
        "symptomName": "Hypogammaglobulinemia",
        "frequency": 0.06,
        "bodySystem": "immunological",
        "notes": "Secondary to protein loss"
      },
      {
        "symptomName": "Portal hypertension",
        "frequency": 0.05,
        "bodySystem": "gastrointestinal",
        "notes": "Complication of chronic liver disease"
      },
      {
        "symptomName": "Mild hepatosplenomegaly",
        "frequency": 0.04,
        "bodySystem": "gastrointestinal",
        "notes": "Less frequent finding"
      }
    ]
  },
