  "diagnosticCriteria": {
    "formalCriteriaName": "Transient Neonatal Diabetes Diagnostic Criteria",
    "criteria": [
      {
        "id": "onset-age",
        "description": "Onset of hyperglycemia within the first 6 months of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "transient-hyperglycemia",
        "description": "Resolution of diabetes typically within 12 to 18 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of abnormalities in chromosome 6q24 imprinting or mutations in KCNJ11 or ABCC8 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-autoantibodies",
        "description": "Negative pancreatic autoantibodies ruling out type 1 diabetes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Hyperglycemia onset before 6 months of age with genetic confirmation of 6q24 abnormalities or KCNJ11/ABCC8 mutations and transient course of diabetes resolving within 18 months",
    "notes": "Genetic testing is critical to differentiate from permanent neonatal diabetes and other forms of diabetes mellitus."
  },
