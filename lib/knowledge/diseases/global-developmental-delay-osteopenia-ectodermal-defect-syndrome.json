        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "osteopenia",
        "description": "Radiologically confirmed decreased bone mineral density",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ectodermal-defects",
        "description": "Presence of ectodermal abnormalities such as abnormal hair, teeth, or nails",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including coarse facies and midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of global developmental delay, osteopenia confirmed by imaging, and at least one ectodermal defect",
    "notes": "Diagnosis is clinical and supported by radiological and genetic findings; no standardized diagnostic criteria exist."
  },
