  "diagnosticCriteria": {
    "formalCriteriaName": "Braun-Tinschert Metaphyseal Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "metaphyseal-irregularities",
        "description": "Radiographic evidence of irregular, sclerotic metaphyseal abnormalities predominantly affecting long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-limbed-dwarfism",
        "description": "Presence of mild to moderate short-limbed dwarfism with disproportionate shortening of the limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development and intelligence",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-extra-skeletal-features",
        "description": "Lack of extraskeletal abnormalities such as craniofacial dysmorphism or organ involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic metaphyseal radiographic abnormalities plus clinical evidence of short-limbed dwarfism",
    "notes": "Diagnosis is primarily radiological supported by clinical phenotype; genetic testing may assist but causative gene not definitively identified."
  },
