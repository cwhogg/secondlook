  "keyFindings": {
    "laboratory": [
      "Elevated urinary imidodipeptides (imidodipeptiduria)",
      "Reduced or absent prolidase enzyme activity in cultured fibroblasts or leukocytes",
      "Hypergammaglobulinemia",
      "Anemia"
    ],
    "imaging": [
      "Chest imaging may show interstitial lung changes in pulmonary fibrosis",
      "Ultrasound may reveal hepatosplenomegaly"
    ],
    "genetic": [
      "PEPD (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy showing nonspecific chronic ulceration with fibrosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Joint hypermobility and skin hyperextensibility without imidodipeptiduria",
        "Normal prolidase enzyme activity"
      ]
    },
    {
      "diseaseId": "chronic-granulomatous-disease",
      "distinguishingFeatures": [
        "Recurrent infections but normal prolidase activity and no imidodipeptiduria",
        "Defects in NADPH oxidase complex"
      ]
    }
  ],
  "redFlags": [
    "Persistent, non-healing skin ulcers resistant to standard wound care",
    "Early onset recurrent infections with immunological abnormalities",
    "Presence of imidodipeptiduria on urine amino acid analysis"
