  "keyFindings": {
    "laboratory": [
      "Profound CD8+ T-cell lymphopenia with normal or elevated CD4+ T cells",
      "Absent or reduced T-cell receptor signaling on functional assays",
      "Hypogammaglobulinemia or normal immunoglobulin levels"
    ],
    "imaging": [
      "Chest X-ray or CT showing recurrent pneumonia or bronchiectasis",
      "Abdominal ultrasound may show hepatosplenomegaly"
    ],
    "genetic": [
      "Biallelic pathogenic variants in the ZAP70 gene confirmed by sequencing"
    ],
    "other": [
      "Poor response to T-cell dependent vaccines",
      "Negative delayed-type hypersensitivity skin tests"
    ]
  },
