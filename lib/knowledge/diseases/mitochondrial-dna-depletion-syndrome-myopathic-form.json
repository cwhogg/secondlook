  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Mitochondrial DNA Depletion Syndrome",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early-onset progressive muscle weakness and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing decreased mitochondrial DNA content",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in genes associated with mtDNA depletion (e.g., TK2 gene)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-serum-creatine-kinase",
        "description": "Elevated serum creatine kinase levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "lactic-acidosis",
        "description": "Presence of lactic acidosis in blood or cerebrospinal fluid",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset progressive myopathy with muscle biopsy confirming mtDNA depletion and identification of pathogenic mutations in relevant genes",
    "notes": "Diagnosis requires integration of clinical, histological, and genetic findings."
  },
