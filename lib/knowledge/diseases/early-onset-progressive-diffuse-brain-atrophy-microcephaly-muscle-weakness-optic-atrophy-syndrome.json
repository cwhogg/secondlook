        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-atrophy",
        "description": "Progressive diffuse cerebral atrophy demonstrated by neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "optic-atrophy",
        "description": "Bilateral optic nerve atrophy confirmed by ophthalmological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-weakness",
        "description": "Early-onset generalized muscle weakness with hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electromyography showing myopathic or neurogenic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of causative gene mutation if available",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microcephaly, progressive diffuse brain atrophy, optic atrophy, and muscle weakness",
    "notes": "Diagnosis is clinical supported by neuroimaging and ophthalmological findings; genetic confirmation may be possible but not always available."
