  "diagnosticCriteria": {
    "formalCriteriaName": "Pompe Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficient acid alpha-glucosidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the GAA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of hypotonia and hypertrophic cardiomyopathy in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing glycogen accumulation in lysosomes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient acid alpha-glucosidase enzyme activity plus either genetic confirmation or characteristic clinical features",
    "notes": "Early diagnosis is critical for treatment initiation and improved prognosis."
  },
