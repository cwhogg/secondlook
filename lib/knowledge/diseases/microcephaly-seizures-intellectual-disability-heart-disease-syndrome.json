  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; metabolic screening typically unremarkable"
    ],
    "imaging": [
      "Brain MRI showing microcephaly with simplified gyral pattern or cortical dysplasia",
      "Echocardiography revealing congenital heart defects such as ventricular septal defect or atrial septal defect"
    ],
    "genetic": [
      "Likely autosomal recessive inheritance pattern; candidate gene mutations under investigation"
    ],
    "other": [
      "Electroencephalogram (EEG) demonstrating epileptiform activity"
    ]
  },
