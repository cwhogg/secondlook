  "keyFindings": {
    "laboratory": [
      "Low morning cortisol (<3 mcg/dL diagnostic; 3-15 mcg/dL indeterminate)",
      "Elevated ACTH (often >100 pg/mL)",
      "Subnormal ACTH stimulation test (peak cortisol <18 mcg/dL)",
      "Hyponatremia (cortisol and aldosterone deficiency)",
      "Hyperkalemia (aldosterone deficiency)",
      "Low aldosterone with elevated plasma renin activity",
      "21-hydroxylase antibodies positive (~90% of autoimmune AI)",
      "Mild hypercalcemia",
      "Eosinophilia",
      "Low DHEA-S",
      "Normocytic anemia"
    ],
    "imaging": [
      "CT adrenal glands: small atrophic adrenals (autoimmune); enlarged/calcified (TB, hemorrhage, infiltrative)",
      "Chest X-ray: to exclude TB"
    ],
    "genetic": [
      "HLA-DR3 and HLA-DR4 associations",
      "CTLA-4 gene variants",
      "AIRE gene mutations (in autoimmune polyglandular syndrome type 1)",
      "CIITA gene variants"
    ],
    "other": [
      "Associated autoimmune conditions screen: thyroid function, vitamin B12, glucose/HbA1c, celiac antibodies, gonadal function"
    ]
  },
  "differentialDiagnoses": [
