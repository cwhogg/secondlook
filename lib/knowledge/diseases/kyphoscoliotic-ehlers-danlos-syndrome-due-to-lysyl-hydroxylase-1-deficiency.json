  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Kyphoscoliotic Ehlers-Danlos syndrome (EDS type VI)",
    "criteria": [
      {
        "id": "kyphoscoliosis",
        "description": "Congenital or early-onset progressive kyphoscoliosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-hypotonia",
        "description": "Generalized muscle hypotonia at birth or early infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lysyl-hydroxylase-deficiency",
        "description": "Deficiency of lysyl hydroxylase 1 enzyme confirmed by biochemical assay or genetic testing of PLOD1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-hyperextensibility",
        "description": "Marked skin hyperextensibility and fragility",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-complications",
        "description": "Scleral fragility leading to ocular globe rupture or blue sclerae",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "joint-hypermobility",
        "description": "Generalized joint hypermobility with recurrent dislocations",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital or early-onset kyphoscoliosis, generalized muscle hypotonia, and confirmed lysyl hydroxylase 1 deficiency by biochemical or genetic testing",
    "notes": "Molecular confirmation via PLOD1 gene mutation analysis is considered definitive."
  },
