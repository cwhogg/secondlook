  "diagnosticCriteria": {
    "formalCriteriaName": "Bullous Pemphigoid Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of tense subepidermal blisters on erythematous or normal skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing subepidermal blister with eosinophilic infiltrate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "direct-immunofluorescence",
        "description": "Linear deposition of IgG and/or C3 along the basement membrane zone",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serologic-testing",
        "description": "Detection of circulating anti-BP180 and/or anti-BP230 antibodies by ELISA",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical presentation, histopathology, and direct immunofluorescence) must be met",
    "notes": "Serologic testing supports diagnosis but is not mandatory"
  },
  "symptoms": {
    "pathognomonic": [
