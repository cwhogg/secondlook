  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Microbiological Diagnostic Criteria for Mycetoma",
    "criteria": [
      {
        "id": "chronic-swelling",
        "description": "Chronic localized swelling with painless subcutaneous mass",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sinus-tract-formation",
        "description": "Presence of multiple draining sinus tracts discharging grains",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "grain-identification",
        "description": "Identification of characteristic grains in discharge or biopsy specimen",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Radiological evidence of bone involvement (osteomyelitis) on X-ray or MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "culture-or-PCR",
        "description": "Microbiological culture or molecular identification of causative organism",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic swelling with draining sinuses and identification of grains either clinically or microbiologically",
    "notes": "Diagnosis is primarily clinical supported by microbiological and imaging studies."
  },
