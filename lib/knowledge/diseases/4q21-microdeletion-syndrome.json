  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and molecular diagnosis of 4q21 microdeletion syndrome",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of a heterozygous microdeletion involving the 4q21 chromosomal region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-intellectual-disability",
        "description": "Presence of severe global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-speech",
        "description": "Absent or severely impaired expressive speech",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial dysmorphisms including broad forehead, hypertelorism, and prominent nasal bridge",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Generalized hypotonia in infancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of 4q21 microdeletion plus presence of severe intellectual disability and absent or severely impaired speech",
    "notes": "Diagnosis relies heavily on genetic testing due to phenotypic overlap with other neurodevelopmental disorders."
  },
