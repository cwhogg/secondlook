        "description": "Episodes of elevated blood ammonia levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "homocitrullinuria",
        "description": "Presence of homocitrulline in urine organic acid analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "SLC25A15-mutation",
        "description": "Identification of pathogenic mutations in the SLC25A15 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-symptoms",
        "description": "Clinical features such as spasticity, ataxia, or cognitive impairment",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hyperornithinemia, hyperammonemia, and homocitrullinuria confirmed biochemically",
    "notes": "Genetic testing for SLC25A15 mutations supports diagnosis but is not mandatory if biochemical criteria are met."
