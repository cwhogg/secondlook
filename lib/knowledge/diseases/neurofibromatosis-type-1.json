    {
      "vsCondition": "constitutional-mismatch-repair-deficiency",
      "feature": "CMMRD often presents with early-onset malignancies and café-au-lait spots, but lacks neurofibromas and Lisch nodules typical of NF1."
    }
  ],
  "ruleOutCriteria": [
    "Absence of both neurofibromas and Lisch nodules in an adult with multiple café-au-lait macules.",
