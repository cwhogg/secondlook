  "diagnosticCriteria": {
    "formalCriteriaName": "2017 EULAR/ACR Classification Criteria for Idiopathic Inflammatory Myopathies (Lundberg criteria)",
    "criteria": [
      {
        "id": "dm-c1",
        "description": "Heliotrope rash (violaceous erythema of eyelids)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "dm-c2",
        "description": "Gottron's papules (raised erythematous or violaceous papules over extensor surfaces of joints)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "dm-c3",
        "description": "Gottron's sign (erythema over extensor surfaces without papules)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "dm-c4",
        "description": "Symmetric proximal muscle weakness (upper and/or lower limbs, progressive)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "dm-c5",
        "description": "Elevated serum CK or LDH or AST or aldolase",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "dm-c6",
        "description": "Myopathic changes on EMG",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "dm-c7",
        "description": "Muscle biopsy showing perifascicular atrophy, perivascular inflammation, and/or MAC deposition on capillaries",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "dm-c8",
        "description": "MRI showing muscle edema on STIR sequences",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "dm-c9",
        "description": "Myositis-specific antibodies (anti-Mi-2, anti-MDA5, anti-TIF1-gamma, anti-NXP2, anti-SAE)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "EULAR/ACR probability-based scoring system. Presence of skin rash (heliotrope, Gottron's) with or without classic muscle disease. Score >= 55% without biopsy or >= 90% with biopsy classifies as probable/definite IIM. Subclassification to DM requires characteristic skin findings.",
    "notes": "Clinically amyopathic dermatomyositis (CADM) has characteristic skin findings but no significant muscle disease. Anti-MDA5 CADM is associated with rapidly progressive ILD."
  },
