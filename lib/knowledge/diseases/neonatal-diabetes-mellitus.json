  "keyFindings": {
    "laboratory": [
      "Elevated blood glucose levels",
      "Low or absent C-peptide",
      "Negative pancreatic autoantibodies",
      "Metabolic acidosis in ketoacidosis"
    ],
    "imaging": [
      "Pancreatic hypoplasia or agenesis on abdominal ultrasound or MRI"
    ],
    "genetic": [
      "Mutations in KCNJ11, ABCC8, INS, or other monogenic diabetes genes"
    ],
    "other": [
      "Response to sulfonylurea therapy in some genetic subtypes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "type-1-diabetes-mellitus",
      "distinguishingFeatures": [
        "Onset usually after 6 months of age",
        "Presence of pancreatic autoantibodies",
        "No causative monogenic mutations"
      ]
    },
    {
      "diseaseId": "transient-neonatal-hyperglycemia",
      "distinguishingFeatures": [
        "Hyperglycemia resolves within weeks to months",
        "No persistent insulin deficiency",
        "No genetic mutations identified"
      ]
    },
    {
      "diseaseId": "congenital-pancreatic-hypoplasia",
      "distinguishingFeatures": [
        "Structural pancreatic abnormalities on imaging",
        "May present with exocrine insufficiency",
        "May or may not have diabetes"
      ]
    }
  ],
  "redFlags": [
    "Hyperglycemia presenting before 6 months of age",
    "Failure to thrive despite adequate feeding",
    "Severe dehydration or ketoacidosis in neonate"
  ],
