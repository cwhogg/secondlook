  "diagnosticCriteria": {
    "formalCriteriaName": "No formalized criteria established",
    "criteria": [
      {
        "id": "skeletal-dysplasia",
        "description": "Presence of chondrodysplasia characterized by disproportionate short stature and skeletal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "disorders-of-sex-development",
        "description": "Ambiguous genitalia or atypical development of external genitalia consistent with difference of sex development",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-features",
        "description": "Radiographic evidence of abnormal cartilage and bone formation including metaphyseal irregularities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with cartilage development and sex differentiation pathways",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "endocrine-evaluation",
        "description": "Hormonal profile showing atypical sex steroid levels or gonadal dysgenesis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chondrodysplasia and difference of sex development features confirmed by clinical and radiological findings",
    "notes": "Genetic testing and endocrine evaluation support diagnosis but are not mandatory"
  },
