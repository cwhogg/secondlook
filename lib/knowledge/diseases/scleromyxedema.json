  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria; commonly used clinical and histopathological criteria",
    "criteria": [
      {
        "id": "clinical-skin-thickening",
        "description": "Generalized papular and sclerodermoid eruption with waxy, firm papules and skin induration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Dermal mucin deposition with fibroblast proliferation and fibrosis on skin biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "monoclonal-gammopathy",
        "description": "Presence of monoclonal gammopathy, typically IgG lambda paraprotein",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-thyroid-disease",
        "description": "Exclusion of thyroid dysfunction to differentiate from thyroid myxedema",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical skin findings, histopathology, and monoclonal gammopathy) must be present with exclusion of thyroid disease.",
    "notes": "Diagnosis is clinical supported by skin biopsy and serum protein electrophoresis."
  },
