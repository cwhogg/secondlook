  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Kallmann Syndrome",
    "criteria": [
      {
        "id": "anosmia",
        "description": "Congenital anosmia or severe hyposmia confirmed by olfactory testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogonadotropic-hypogonadism",
        "description": "Clinical and biochemical evidence of hypogonadotropic hypogonadism (low gonadotropins and sex steroids)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked, autosomal dominant, or autosomal recessive inheritance",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic mutation in known Kallmann syndrome-associated genes (e.g., KAL1, FGFR1)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "associated-anomalies",
        "description": "Presence of associated anomalies such as unilateral renal agenesis, cleft lip/palate, or mirror movements",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital anosmia or severe hyposmia plus clinical and biochemical evidence of hypogonadotropic hypogonadism",
    "notes": "Genetic testing and family history support diagnosis but are not mandatory."
  },
