  "diagnosticCriteria": {
    "formalCriteriaName": "McDuffie Criteria",
    "criteria": [
      {
        "id": "chronic-urticarial-lesions",
        "description": "Presence of chronic urticarial skin lesions lasting more than 6 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypocomplementemia",
        "description": "Low serum complement levels, especially C1q, C3, and C4",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vasculitis-evidence",
        "description": "Histopathologic evidence of leukocytoclastic vasculitis on skin biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anti-c1q-antibodies",
        "description": "Presence of anti-C1q autoantibodies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "systemic-involvement",
        "description": "Systemic manifestations such as arthritis, glomerulonephritis, or ocular inflammation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met for diagnosis",
    "notes": "Anti-C1q antibodies support diagnosis but are not mandatory"
  },
