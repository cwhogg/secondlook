  "keyFindings": {
    "laboratory": [
      "Normal or mildly elevated natriuretic peptides (BNP, NT-proBNP)",
      "Normal cardiac enzymes unless ischemia present"
    ],
    "imaging": [
      "Echocardiography showing restrictive filling pattern and biatrial enlargement",
      "Cardiac MRI demonstrating normal or mildly reduced ventricular volumes with preserved systolic function",
      "Absence of late gadolinium enhancement typical for infiltrative diseases"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Hemodynamic studies confirming elevated ventricular filling pressures with normal systolic function",
      "Endomyocardial biopsy may show nonspecific fibrosis without infiltrative disease"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cardiac-amyloidosis",
      "distinguishingFeatures": [
        "Presence of amyloid deposits on biopsy",
        "Characteristic late gadolinium enhancement on cardiac MRI",
        "Elevated serum or urine light chains in AL amyloidosis"
      ]
    },
    {
      "diseaseId": "sarcoidosis-cardiac-involvement",
      "distinguishingFeatures": [
        "Noncaseating granulomas on biopsy",
        "Multisystem involvement with pulmonary or lymph node disease",
        "Patchy late gadolinium enhancement on cardiac MRI"
      ]
    },
    {
      "diseaseId": "constrictive-pericarditis",
      "distinguishingFeatures": [
        "Pericardial thickening or calcification on imaging",
        "Respiratory variation in ventricular filling pressures",
        "Improvement after pericardiectomy"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of heart failure symptoms despite therapy",
    "Syncope or sudden cardiac arrest",
    "Family history of sudden cardiac death or cardiomyopathy"
  ],
  "specialistType": [
    "Cardiologist",
