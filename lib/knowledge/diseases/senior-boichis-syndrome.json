  "diagnosticCriteria": {
    "formalCriteriaName": "Senior-Boichis Diagnostic Criteria",
    "criteria": [
      {
        "id": "hepatic-fibrosis",
        "description": "Presence of congenital hepatic fibrosis confirmed by biopsy or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-cystic-disease",
        "description": "Evidence of renal cystic disease or nephronophthisis on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "portal-hypertension",
        "description": "Clinical or imaging signs of portal hypertension such as splenomegaly or varices",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital hepatic fibrosis and renal cystic disease with or without portal hypertension",
    "notes": "Diagnosis is supported by genetic testing when available."
  },
