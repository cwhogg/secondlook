        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peripheral-eosinophilia",
        "description": "Peripheral blood eosinophilia may be absent early but can develop later",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All major criteria must be met including acute onset, pulmonary eosinophilia, radiographic infiltrates, and exclusion of other causes",
    "notes": "Peripheral eosinophilia is often absent at presentation and should not exclude diagnosis"
