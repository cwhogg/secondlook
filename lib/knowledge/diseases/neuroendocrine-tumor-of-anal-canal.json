  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Neuroendocrine Neoplasms",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histological confirmation of neuroendocrine tumor cells with immunohistochemical staining positive for neuroendocrine markers (chromogranin A, synaptophysin)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tumor-location",
        "description": "Tumor localized to the anal canal confirmed by imaging and endoscopic evaluation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mitotic-index",
        "description": "Assessment of mitotic count and Ki-67 proliferation index to grade tumor aggressiveness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of symptoms such as rectal bleeding, anal pain, or mass sensation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation with neuroendocrine marker positivity and tumor localization to anal canal",
    "notes": "Grading based on mitotic index and Ki-67 is essential for prognosis and treatment planning."
  },
