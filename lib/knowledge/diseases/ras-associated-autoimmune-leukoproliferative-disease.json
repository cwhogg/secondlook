  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed RALD Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-lymphoproliferation",
        "description": "Chronic non-malignant lymphadenopathy and/or splenomegaly lasting more than 6 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoimmune-cytopenias",
        "description": "Presence of autoimmune cytopenias such as autoimmune hemolytic anemia or thrombocytopenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ras-pathway-mutation",
        "description": "Detection of somatic activating mutations in RAS genes (NRAS or KRAS) in hematopoietic cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-double-negative-t-cells",
        "description": "Increased circulating double-negative (CD4-/CD8-) T cells",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypergammaglobulinemia",
        "description": "Elevated serum immunoglobulin levels, particularly IgG",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: chronic lymphoproliferation, autoimmune cytopenias, and confirmed somatic RAS mutation",
    "notes": "Diagnosis requires exclusion of malignant hematologic diseases and classical ALPS with germline FAS mutations."
  },
