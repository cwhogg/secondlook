  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Genetic testing revealing pathogenic variants in TGFBR1, TGFBR2, ACTA2, or related genes"
    ],
    "imaging": [
      "Echocardiography showing thoracic aortic dilation",
      "CT angiography or MRI confirming aneurysm size and extent",
      "Aortic root enlargement without systemic features of syndromic aortopathies"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Family history of thoracic aortic aneurysm or dissection",
      "Absence of systemic connective tissue disorder features"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "marfan-syndrome",
      "distinguishingFeatures": [
        "Systemic connective tissue features (e.g., lens dislocation, skeletal abnormalities)",
        "FBN1 gene mutation",
        "Characteristic facial and skeletal phenotype"
      ]
    },
    {
      "diseaseId": "loeys-dietz-syndrome",
      "distinguishingFeatures": [
        "Arterial tortuosity and aneurysms throughout vascular tree",
        "Distinctive craniofacial features",
        "Mutations in TGFBR1 or TGFBR2 with systemic involvement"
      ]
    },
    {
      "diseaseId": "atherosclerotic-thoracic-aortic-aneurysm",
      "distinguishingFeatures": [
        "Older age of onset",
        "Presence of atherosclerotic risk factors",
        "Lack of family history"
      ]
    }
  ],
  "redFlags": [
    "Sudden severe chest or back pain suggestive of aortic dissection",
