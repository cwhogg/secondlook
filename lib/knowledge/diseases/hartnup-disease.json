  "keyFindings": {
    "laboratory": [
      "Increased urinary excretion of neutral amino acids (e.g., tryptophan, alanine, serine)",
      "Normal serum amino acid levels",
      "Possible niacin deficiency markers"
    ],
    "imaging": [
      "MRI may show cerebellar atrophy in advanced neurological involvement"
    ],
    "genetic": [
      "Biallelic pathogenic variants in SLC6A19 gene"
    ],
    "other": [
      "Positive response to niacin or nicotinamide supplementation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pellagra",
      "distinguishingFeatures": [
        "Niacin deficiency due to dietary lack or malabsorption",
        "No neutral aminoaciduria",
        "Usually adult onset"
      ]
    },
    {
      "diseaseId": "cystinuria",
      "distinguishingFeatures": [
        "Increased urinary excretion of dibasic amino acids and cystine, not neutral amino acids",
        "No pellagra-like rash",
        "Risk of kidney stones"
      ]
    }
  ],
  "redFlags": [
