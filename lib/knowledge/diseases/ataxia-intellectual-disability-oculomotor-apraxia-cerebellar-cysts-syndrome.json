  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for AIOC Syndrome",
    "criteria": [
      {
        "id": "ataxia",
        "description": "Progressive cerebellar ataxia manifesting in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability ranging from mild to severe",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oculomotor-apraxia",
        "description": "Impaired voluntary horizontal eye movements with compensatory head thrusts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-cysts",
        "description": "Presence of cerebellar cysts detected by brain MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Generalized muscle hypotonia in infancy or early childhood",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "dysmorphic-features",
        "description": "Mild facial dysmorphism including broad forehead and hypertelorism",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all four major criteria: progressive ataxia, intellectual disability, oculomotor apraxia, and cerebellar cysts on imaging",
    "notes": "Genetic testing may support diagnosis but is not yet fully characterized."
  },
