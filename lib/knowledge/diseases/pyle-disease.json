  "differentialDiagnoses": [
    {
      "diseaseId": "craniometaphyseal-dysplasia",
      "distinguishingFeatures": [
        "Cranial hyperostosis with facial nerve compression",
        "More prominent craniofacial involvement"
      ]
    },
    {
      "diseaseId": "osteopetrosis",
      "distinguishingFeatures": [
        "Increased bone density rather than cortical thinning",
        "Bone marrow failure and anemia common"
      ]
    },
    {
      "diseaseId": "gaucher-disease",
      "distinguishingFeatures": [
        "Hepatosplenomegaly and hematological abnormalities",
        "Presence of Gaucher cells on bone marrow biopsy"
      ]
    }
  ],
