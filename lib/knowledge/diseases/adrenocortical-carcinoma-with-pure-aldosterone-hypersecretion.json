  "keyFindings": {
    "laboratory": [
      "Elevated plasma aldosterone concentration with suppressed plasma renin activity",
      "Hypokalemia on serum electrolyte panel",
      "Metabolic alkalosis on arterial blood gas",
      "Elevated 24-hour urinary aldosterone excretion"
    ],
    "imaging": [
      "Adrenal mass >4 cm with irregular borders on CT scan",
      "Heterogeneous enhancement on MRI suggestive of malignancy",
      "Possible local invasion or metastasis on imaging"
    ],
    "genetic": [
      "Somatic mutations in TP53, CTNNB1, or other oncogenes associated with adrenocortical carcinoma",
      "Rare mutations in KCNJ5 or CACNA1D may be absent in pure aldosterone-secreting carcinoma"
    ],
    "other": [
      "Histopathological Weiss criteria score ≥3 confirming malignancy",
      "Immunohistochemistry positive for aldosterone synthase (CYP11B2)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "aldosterone-producing-adrenal-adenoma",
