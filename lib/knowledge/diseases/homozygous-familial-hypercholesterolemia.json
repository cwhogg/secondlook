  "differentialDiagnoses": [
    {
      "diseaseId": "heterozygous-familial-hypercholesterolemia",
      "distinguishingFeatures": [
        "Lower LDL cholesterol levels (usually < 400 mg/dL)",
        "Later onset of symptoms",
        "Usually only one mutated allele"
      ]
    },
    {
      "diseaseId": "sitosterolemia",
      "distinguishingFeatures": [
        "Elevated plant sterols in plasma",
        "Presence of xanthomas but with normal LDL receptor function",
        "Responds to ezetimibe treatment"
      ]
    }
  ],
