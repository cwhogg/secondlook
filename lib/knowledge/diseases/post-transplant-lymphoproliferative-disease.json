        "requiredForDiagnosis": true
      },
      {
        "id": "ebv-association",
        "description": "Detection of Epstein-Barr virus (EBV) in affected tissue or blood",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of lymphadenopathy, extranodal masses, or organ dysfunction consistent with lymphoproliferation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunosuppression-history",
        "description": "History of immunosuppressive therapy post-transplant",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of lymphoproliferation in a post-transplant patient with compatible clinical presentation",
    "notes": "EBV association supports diagnosis but is not mandatory; diagnosis requires integration of clinical, pathological, and transplant history."
  },
