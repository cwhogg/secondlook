  "diagnosticCriteria": {
    "formalCriteriaName": "No formal diagnostic criteria established",
    "criteria": [
      {
        "id": "cardiomyopathy",
        "description": "Presence of hypertrophic or dilated cardiomyopathy confirmed by echocardiography or cardiac MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Generalized muscle hypotonia observed clinically in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lactic-acidosis",
        "description": "Elevated blood lactate levels indicative of lactic acidosis confirmed by laboratory testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in mitochondrial or nuclear genes associated with mitochondrial dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing mitochondrial abnormalities such as ragged red fibers or cytochrome c oxidase deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: cardiomyopathy, hypotonia, and lactic acidosis",
    "notes": "Genetic confirmation and muscle biopsy findings support diagnosis but are not mandatory."
  },
