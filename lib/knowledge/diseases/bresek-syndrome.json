  "diagnosticCriteria": {
    "formalCriteriaName": "BRESEK Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including micrognathia and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Multiple skeletal anomalies including brachydactyly, clinodactyly, and joint contractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-impairment",
        "description": "Developmental delay or intellectual disability with hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-malformations",
        "description": "Congenital renal anomalies such as renal hypoplasia or dysplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiovascular-anomalies",
        "description": "Presence of congenital heart defects including septal defects",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (craniofacial dysmorphism, skeletal abnormalities, and neurological impairment)",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
