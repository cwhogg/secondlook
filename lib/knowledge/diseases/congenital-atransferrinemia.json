  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Congenital Atransferrinemia",
    "criteria": [
      {
        "id": "absent-transferrin",
        "description": "Serum transferrin levels undetectable or severely decreased",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-microcytic-anemia",
        "description": "Presence of severe hypochromic microcytic anemia refractory to iron therapy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "iron-overload",
        "description": "Evidence of systemic iron overload despite anemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the transferrin (TF) gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of anemia and iron overload",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of absent or severely decreased serum transferrin, severe microcytic anemia refractory to iron therapy, and evidence of iron overload",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if clinical and laboratory criteria are met"
  },
