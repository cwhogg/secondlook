  "diagnosticCriteria": {
    "formalCriteriaName": "DYRK1A Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of moderate to severe intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microcephaly",
        "description": "Congenital or early-onset microcephaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including deep-set eyes, thin upper lip, and prominent nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "speech-delay",
        "description": "Severe speech delay or absence of speech",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "feeding-difficulties",
        "description": "Early feeding difficulties and failure to thrive",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "History of seizures or epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (intellectual disability, microcephaly, and characteristic facial dysmorphism) plus confirmation of DYRK1A point mutation by genetic testing",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical features guide suspicion."
  },
