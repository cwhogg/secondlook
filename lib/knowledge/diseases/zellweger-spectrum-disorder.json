  "diagnosticCriteria": {
    "formalCriteriaName": "Zellweger Spectrum Diagnostic Criteria",
    "criteria": [
      {
        "id": "peroxisomal-biogenesis-defect",
        "description": "Confirmed defect in peroxisomal biogenesis by biochemical or genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial abnormalities including high forehead, broad nasal bridge, and epicanthal folds",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-impairment",
        "description": "Profound hypotonia and developmental delay with neuronal migration defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-plasma-vlcfa",
        "description": "Elevated very long chain fatty acids (VLCFA) in plasma",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hepatic-dysfunction",
        "description": "Evidence of liver dysfunction or hepatomegaly",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria including peroxisomal biogenesis defect, craniofacial dysmorphism, and neurological impairment",
    "notes": "Genetic confirmation is strongly recommended for definitive diagnosis"
  },
