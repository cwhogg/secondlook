  "diagnosticCriteria": {
    "formalCriteriaName": "GALM Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced or absent galactose mutarotase enzyme activity in erythrocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the GALM gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of neonatal or infantile symptoms consistent with galactose metabolism disorder (e.g., feeding intolerance, jaundice)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "galactosemia",
        "description": "Elevated galactose or galactose-1-phosphate levels in blood or urine",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of reduced GALM enzyme activity and identification of pathogenic GALM gene variants",
    "notes": "Diagnosis may be supported by biochemical abnormalities and clinical presentation but requires genetic confirmation."
  },
