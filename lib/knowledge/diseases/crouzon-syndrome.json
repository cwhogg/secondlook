  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Crouzon Syndrome",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of cranial sutures leading to abnormal skull shape",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midface-hypoplasia",
        "description": "Midfacial retrusion and hypoplasia causing characteristic facial appearance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-proptosis",
        "description": "Exophthalmos or shallow orbits resulting in prominent eyes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-limb-structure",
        "description": "Absence of limb abnormalities differentiating from other craniosynostosis syndromes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "FGFR2-mutation",
        "description": "Identification of pathogenic FGFR2 gene mutation",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis plus midface hypoplasia and ocular proptosis, with or without FGFR2 mutation confirmation",
    "notes": "Genetic testing for FGFR2 mutations supports diagnosis but is not mandatory."
  },
