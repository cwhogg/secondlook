        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic SDHx gene mutation plus presence of paraganglioma or pheochromocytoma tumor",
    "notes": "Genetic testing is essential for confirmation; family history supports diagnosis but is not mandatory."
