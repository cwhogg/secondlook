  "diagnosticCriteria": {
    "formalCriteriaName": "Mucopolysaccharidosis Type I Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of alpha-L-iduronidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-gags",
        "description": "Elevated urinary glycosaminoglycans (dermatan sulfate and heparan sulfate)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features including coarse facial features, joint stiffness, and mild cognitive impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the IDUA gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of alpha-L-iduronidase enzyme activity plus elevated urinary glycosaminoglycans and compatible clinical features",
    "notes": "Genetic testing supports diagnosis and aids in family counseling"
  },
