  "keyFindings": {
    "laboratory": [
      "Reduced arylsulfatase A enzyme activity in leukocytes or fibroblasts",
      "Presence of metachromatic granules in nerve biopsy or urine sediment"
    ],
    "imaging": [
      "Symmetric periventricular white matter demyelination on brain MRI",
      "T2 hyperintensities in cerebral white matter"
    ],
    "genetic": [
      "Pathogenic mutations in the ARSA gene"
    ],
    "other": [
      "Nerve conduction studies showing demyelinating peripheral neuropathy"
    ]
  },
