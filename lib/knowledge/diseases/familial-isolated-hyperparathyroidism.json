  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Isolated Hyperparathyroidism Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypercalcemia",
        "description": "Persistent hypercalcemia with elevated or inappropriately normal parathyroid hormone (PTH) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Presence of hyperparathyroidism in at least two first-degree relatives without other syndromic features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-syndromes",
        "description": "Exclusion of multiple endocrine neoplasia types 1 and 2 and hyperparathyroidism-jaw tumor syndrome by clinical and genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "parathyroid-imaging",
        "description": "Localization of parathyroid adenoma or hyperplasia by imaging studies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent hypercalcemia with elevated PTH in at least two affected family members and exclusion of other syndromic causes",
    "notes": "Genetic testing for CDC73, MEN1, and RET mutations is important to exclude related syndromes."
  },
