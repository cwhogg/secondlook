  "diagnosticCriteria": {
    "formalCriteriaName": "Genetic Hyperpigmentation Diagnostic Criteria",
    "criteria": [
      {
        "id": "diffuse-hyperpigmentation",
        "description": "Presence of diffuse or patchy hyperpigmented macules or patches on the skin without preceding inflammation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of similar hyperpigmentation consistent with autosomal dominant or recessive inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-acquired-causes",
        "description": "Exclusion of acquired causes of hyperpigmentation such as drug-induced, post-inflammatory, or endocrine disorders",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing increased melanin deposition in basal keratinocytes without melanocytic proliferation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with melanin synthesis or regulation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of diffuse or patchy hyperpigmentation with positive family history and exclusion of acquired causes",
    "notes": "Genetic testing and histopathology support diagnosis but are not mandatory"
  },
