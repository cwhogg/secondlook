  "diagnosticCriteria": {
    "formalCriteriaName": "BOD Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "brachymorphism",
        "description": "Presence of generalized brachymorphism characterized by short stature and shortening of the limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "onychodysplasia",
        "description": "Nail abnormalities including hypoplastic, dystrophic, or absent nails",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysphalangism",
        "description": "Radiographic evidence of dysplastic or absent phalanges in fingers and toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-features",
        "description": "Mild facial dysmorphism such as midface hypoplasia and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: brachymorphism, onychodysplasia, and dysphalangism",
    "notes": "Diagnosis is primarily clinical supported by radiographic findings; genetic testing may assist but no specific gene identified."
  },
