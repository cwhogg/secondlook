  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Lenz microphthalmia syndrome",
    "criteria": [
      {
        "id": "microphthalmia",
        "description": "Presence of unilateral or bilateral microphthalmia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal malformations including digital anomalies such as syndactyly or clinodactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-cataracts",
        "description": "Congenital cataracts or other ocular anterior segment anomalies",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in BCOR gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microphthalmia plus at least one additional major criterion (skeletal abnormalities or congenital cataracts) or genetic confirmation",
    "notes": "Diagnosis is primarily clinical but can be confirmed by molecular genetic testing of BCOR."
  },
