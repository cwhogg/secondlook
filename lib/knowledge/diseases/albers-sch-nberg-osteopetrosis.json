  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for ADO II",
    "criteria": [
      {
        "id": "radiologic-sclerosis",
        "description": "Diffuse increased bone density with characteristic 'bone within bone' appearance on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-fractures",
        "description": "History of recurrent low-impact fractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the CLCN7 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "bone-marrow-function",
        "description": "Normal or mildly impaired bone marrow function without severe anemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic radiologic findings plus clinical history of fractures; genetic confirmation supports diagnosis",
    "notes": "Genetic testing for CLCN7 mutations is helpful but not mandatory for diagnosis"
  },
