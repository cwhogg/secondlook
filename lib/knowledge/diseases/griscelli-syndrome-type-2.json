  "diagnosticCriteria": {
    "formalCriteriaName": "Griscelli Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypopigmentation",
        "description": "Presence of silvery-gray hair and hypopigmentation of skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Recurrent infections due to impaired cellular immunity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemophagocytic-lymphohistiocytosis",
        "description": "Development of hemophagocytic lymphohistiocytosis (HLH)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic mutations in RAB27A gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hair-microscopy",
        "description": "Abnormal clumping of melanin granules in hair shafts on microscopic examination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypopigmentation, immunodeficiency, HLH, and confirmation by genetic testing for RAB27A mutations",
    "notes": "Diagnosis is confirmed by genetic testing; HLH is a life-threatening complication requiring urgent management."
  },
