  "diagnosticCriteria": {
    "formalCriteriaName": "MLASA Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-myopathy",
        "description": "Presence of proximal muscle weakness with exercise intolerance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sideroblastic-anemia",
        "description": "Confirmed sideroblastic anemia by bone marrow biopsy showing ring sideroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lactic-acidosis",
        "description": "Elevated blood lactate levels at rest or after exercise",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in mitochondrial or nuclear genes associated with MLASA (e.g., YARS2, PUS1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing mitochondrial abnormalities such as ragged red fibers",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical myopathy and sideroblastic anemia confirmed by bone marrow biopsy, plus either genetic confirmation or elevated lactate levels",
    "notes": "Diagnosis requires integration of clinical, hematological, biochemical, and genetic findings."
  },
