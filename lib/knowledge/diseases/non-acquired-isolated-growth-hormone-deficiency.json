  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Isolated Growth Hormone Deficiency",
    "criteria": [
      {
        "id": "short-stature",
        "description": "Height more than 2 standard deviations below the mean for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-serum-gh",
        "description": "Subnormal peak growth hormone levels on at least two stimulation tests",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-other-pituitary-hormones",
        "description": "Normal secretion of other anterior pituitary hormones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-brain-imaging",
        "description": "Absence of structural abnormalities on hypothalamic-pituitary MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-acquired-causes",
        "description": "No history or evidence of acquired causes such as trauma, tumors, or irradiation",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of short stature, subnormal peak GH levels on two stimulation tests, normal other pituitary hormones, and exclusion of acquired causes",
    "notes": "Diagnosis requires careful exclusion of multiple pituitary hormone deficiencies and acquired etiologies."
  },
