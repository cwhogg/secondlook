  "diagnosticCriteria": {
    "formalCriteriaName": "Jervell and Lange-Nielsen Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "congenital-sensorineural-deafness",
        "description": "Bilateral congenital profound sensorineural hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "prolonged-qt-interval",
        "description": "Prolonged corrected QT interval (QTc > 480 ms) on electrocardiogram",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pathogenic-kcnq1-or-kscnh2-mutation",
        "description": "Identification of biallelic pathogenic variants in KCNQ1 or KCNE1 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "history-of-syncope-or-cardiac-arrest",
        "description": "History of syncope, torsades de pointes, or sudden cardiac arrest",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital sensorineural deafness plus prolonged QTc interval and/or pathogenic biallelic mutations in KCNQ1 or KCNE1",
    "notes": "Genetic testing is confirmatory; clinical diagnosis can be made based on ECG and audiological findings."
  },
