  "diagnosticCriteria": {
    "formalCriteriaName": "Comprehensive Diagnostic Criteria for IgG4-Related Kidney Disease",
    "criteria": [
      {
        "id": "elevated-serum-igg4",
        "description": "Elevated serum IgG4 concentration (>135 mg/dL)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-lesions",
        "description": "Characteristic renal imaging findings such as multiple low-density lesions on CT or diffuse renal swelling",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Renal biopsy showing dense lymphoplasmacytic infiltration rich in IgG4-positive plasma cells with storiform fibrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "other-organ-involvement",
        "description": "Presence of IgG4-related disease in other organs (e.g., pancreas, salivary glands)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-steroids",
        "description": "Improvement of renal function and imaging abnormalities after corticosteroid therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (elevated serum IgG4, characteristic renal imaging, and histopathology) must be met for diagnosis.",
    "notes": "Diagnosis requires exclusion of malignancy and other causes of tubulointerstitial nephritis."
  },
