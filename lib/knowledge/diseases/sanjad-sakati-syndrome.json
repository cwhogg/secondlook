  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Sanjad-Sakati syndrome",
    "criteria": [
      {
        "id": "hypoparathyroidism",
        "description": "Congenital hypoparathyroidism with resultant hypocalcemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic dysmorphic facial features including microcephaly, deep-set eyes, beaked nose, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Severe intrauterine and postnatal growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay and intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the TBCE gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital hypoparathyroidism, characteristic facial dysmorphism, and growth retardation",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if clinical features are definitive."
  },
