  "diagnosticCriteria": {
    "formalCriteriaName": "B4GALT1-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early onset multisystem involvement including developmental delay and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "transferrin-glycosylation",
        "description": "Abnormal serum transferrin isoelectric focusing pattern consistent with type I CDG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "b4galt1-mutation",
        "description": "Identification of pathogenic biallelic variants in the B4GALT1 gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "additional-laboratory",
        "description": "Reduced beta-1,4-galactosyltransferase 1 enzyme activity in fibroblasts or leukocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus abnormal transferrin glycosylation and identification of biallelic pathogenic B4GALT1 variants",
    "notes": "Diagnosis is confirmed by molecular genetic testing; enzyme assay supports diagnosis."
  },
