  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Intellectual Disability-Macrocephaly-Hypotonia-Behavioral Abnormalities Syndrome",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of global developmental delay or intellectual disability confirmed by standardized testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "macrocephaly",
        "description": "Head circumference greater than 2 standard deviations above the mean for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Generalized decreased muscle tone observed clinically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-abnormalities",
        "description": "Presence of behavioral abnormalities including autistic features, hyperactivity, or aggression",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuroimaging-findings",
        "description": "Supportive neuroimaging abnormalities such as mild ventriculomegaly or delayed myelination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (intellectual disability, macrocephaly, hypotonia) with or without supportive behavioral abnormalities",
    "notes": "Diagnosis is clinical; genetic testing may assist but no specific gene identified yet."
  },
