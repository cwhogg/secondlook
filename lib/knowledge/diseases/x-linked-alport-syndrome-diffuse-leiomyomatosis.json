  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for X-linked Alport Syndrome with Diffuse Leiomyomatosis",
    "criteria": [
      {
        "id": "renal-manifestations",
        "description": "Persistent hematuria and progressive proteinuria leading to chronic kidney disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "diffuse-leiomyomatosis",
        "description": "Presence of diffuse leiomyomatosis involving esophagus, tracheobronchial tree, or female genital tract",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic deletion involving COL4A5 and COL4A6 genes on X chromosome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss typically developing in childhood or adolescence",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-abnormalities",
        "description": "Anterior lenticonus or dot-and-fleck retinopathy on ophthalmologic examination",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of renal manifestations plus diffuse leiomyomatosis and genetic confirmation of COL4A5/COL4A6 deletion",
    "notes": "Diagnosis is supported by family history and typical audiological and ophthalmological findings."
  },
