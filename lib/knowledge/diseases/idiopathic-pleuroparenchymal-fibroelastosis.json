  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Idiopathic Pleuroparenchymal Fibroelastosis",
    "criteria": [
      {
        "id": "upper-lobe-fibrosis",
        "description": "Presence of predominant upper lobe pleural fibrosis and subpleural fibroelastosis on histopathology or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-pattern",
        "description": "Characteristic high-resolution CT findings showing pleural thickening and subpleural fibrosis predominantly in upper lobes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-etiologies",
        "description": "Exclusion of other known causes of interstitial lung disease including connective tissue disease and environmental exposures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Progressive dyspnea and dry cough consistent with fibrosing lung disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met for diagnosis",
    "notes": "Histopathological confirmation is preferred but diagnosis can be made based on characteristic imaging and clinical exclusion."
  },
