{
  "id": "artemis-deficiency",
  "name": "Artemis Deficiency",
  "aliases": [
    "DCLRE1C Deficiency",
    "Radiosensitive Severe Combined Immunodeficiency (RS-SCID)"
  ],
  "icd10Codes": [
    "D81.1"
  ],
  "omimId": "602450",
  "orphanetId": "791",
  "prevalence": {
    "estimate": "1 in 250,000",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 2,
      "peak": 0.5
    },
    "sexPredilection": "equal",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Radiosensitive SCID Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the DCLRE1C gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotyping",
        "description": "Severe T-cell lymphopenia with absent or markedly reduced T-cell receptor excision circles (TRECs)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiosensitivity-assay",
        "description": "Increased cellular radiosensitivity demonstrated by fibroblast or lymphocyte assays",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-presentation",
        "description": "Early onset of recurrent severe infections, failure to thrive, and chronic diarrhea",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic DCLRE1C variants plus severe T-cell lymphopenia",
    "notes": "Radiosensitivity testing supports diagnosis but is not mandatory."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Severe T-cell lymphopenia",
        "frequency": 0.95,
        "bodySystem": "immunological",
        "notes": "Marked reduction or absence of functional T cells",
        "searchTerms": [
          "very low T-cell counts",
          "severe deficiency of T lymphocytes",
          "marked T-cell lymphopenia"
        ]
      },
      {
        "symptomName": "Increased cellular radiosensitivity",
        "frequency": 0.85,
        "bodySystem": "hematological",
        "notes": "Demonstrated by in vitro assays",
        "searchTerms": [
          "cells sensitive to radiation",
          "increased damage from radiation exposure",
          "high radiosensitivity of cells"
        ]
      }
    ],
    "common": [
      {
        "symptomName": "Recurrent severe bacterial and viral infections",
        "frequency": 0.85,
        "bodySystem": "immunological",
        "notes": "Including pneumonia, sepsis, and chronic viral infections",
        "searchTerms": [
          "frequent serious infections",
          "repeated bacterial and viral illnesses",
          "chronic severe infections"
        ]
      },
      {
        "symptomName": "Failure to thrive",
        "frequency": 0.75,
        "bodySystem": "constitutional",
        "notes": "Poor weight gain and growth delay",
        "searchTerms": [
          "poor weight gain",
          "not growing well",
          "failure to gain weight"
        ]
      },
      {
        "symptomName": "Chronic diarrhea",
        "frequency": 0.65,
        "bodySystem": "gastrointestinal",
        "notes": "Persistent or recurrent"
      },
      {
        "symptomName": "Hypogammaglobulinemia",
        "frequency": 0.6,
        "bodySystem": "immunological",
        "notes": "Low immunoglobulin levels due to impaired B-cell function"
      }
    ],
    "occasional": [
      {
        "symptomName": "Eczematous dermatitis",
        "frequency": 0.4,
        "bodySystem": "dermatological",
        "notes": "Atopic-like skin manifestations"
      },
      {
        "symptomName": "Lymphadenopathy",
        "frequency": 0.3,
        "bodySystem": "immunological",
        "notes": "Enlarged lymph nodes due to infections"
      },
      {
        "symptomName": "Oral candidiasis",
        "frequency": 0.25,
        "bodySystem": "otolaryngological",
        "notes": "Fungal infection of the oral mucosa"
      },
      {
        "symptomName": "Hepatosplenomegaly",
        "frequency": 0.15,
        "bodySystem": "hematological",
        "notes": "Enlargement of liver and spleen"
      }
    ],
    "rare": [
      {
        "symptomName": "Neurological developmental delay",
        "frequency": 0.08,
        "bodySystem": "neurological",
        "notes": "Secondary to infections or treatment complications",
        "searchTerms": [
          "delayed brain development",
          "slow neurological progress",
          "developmental delay in nervous system"
        ]
      },
      {
        "symptomName": "Autoimmune cytopenias",
        "frequency": 0.05,
        "bodySystem": "hematological",
        "notes": "Autoimmune destruction of blood cells"
      },
      {
        "symptomName": "Interstitial lung disease",
        "frequency": 0.03,
        "bodySystem": "respiratory",
        "notes": "Chronic lung inflammation",
        "searchTerms": [
          "lung tissue scarring",
          "interstitial lung inflammation",
          "thickened lung tissue"
        ]
      }
    ]
  },
  "systemsAffected": [
    "immunological",
