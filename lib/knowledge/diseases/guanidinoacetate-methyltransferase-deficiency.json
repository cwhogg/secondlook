  "diagnosticCriteria": {
    "formalCriteriaName": "GAMT Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-guanidinoacetate",
        "description": "Elevated guanidinoacetate levels in plasma or urine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "reduced-creatine-in-brain",
        "description": "Reduced creatine peak on brain magnetic resonance spectroscopy (MRS)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biallelic-gamt-mutations",
        "description": "Identification of pathogenic biallelic mutations in the GAMT gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of developmental delay, seizures, or movement disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated guanidinoacetate plus either reduced brain creatine on MRS or biallelic pathogenic GAMT mutations",
    "notes": "Early diagnosis is critical for treatment efficacy"
  },
