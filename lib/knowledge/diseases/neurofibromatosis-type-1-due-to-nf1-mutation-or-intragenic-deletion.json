  "keyFindings": {
    "laboratory": [
      "Genetic testing identifying pathogenic NF1 mutation or intragenic deletion",
      "Elevated catecholamines in pheochromocytoma"
    ],
    "imaging": [
      "MRI showing optic pathway glioma",
      "MRI or CT demonstrating plexiform neurofibromas",
      "Skeletal X-rays showing bone dysplasia or pseudarthrosis"
    ],
    "genetic": [
      "NF1 (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Slit-lamp examination revealing Lisch nodules",
      "Clinical dermatological examination showing café-au-lait spots and freckling"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "legius-syndrome",
      "distinguishingFeatures": [
        "Presence of café-au-lait spots without neurofibromas",
        "SPRED1 gene mutation instead of NF1",
        "Absence of Lisch nodules and optic gliomas"
      ]
    },
    {
      "diseaseId": "neurofibromatosis-type-2",
      "distinguishingFeatures": [
        "Bilateral vestibular schwannomas",
        "Later onset compared to NF1",
        "Lack of café-au-lait macules and cutaneous neurofibromas"
      ]
    }
  ],
  "redFlags": [
    "Rapid growth or pain in neurofibromas suggesting malignant transformation",
    "Visual loss or proptosis indicating optic pathway glioma",
    "New onset seizures or focal neurological deficits"
  ],
