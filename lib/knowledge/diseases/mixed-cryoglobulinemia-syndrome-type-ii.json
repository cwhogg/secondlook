{
  "id": "mixed-cryoglobulinemia-syndrome-type-ii",
  "name": "Mixed Cryoglobulinemia Syndrome Type II",
  "aliases": [
    "Type II Mixed Cryoglobulinemia",
    "Mixed Essential Cryoglobulinemia Type II"
  ],
  "icd10Codes": [
    "M31.2"
  ],
  "omimId": "605088",
  "orphanetId": "238",
  "prevalence": {
    "estimate": "1 in 100,000",
    "range": "0.001%-0.01%",
    "classification": "rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 20,
      "max": 70,
      "peak": 50
    },
    "sexPredilection": "slight-female",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Meltzer's Criteria for Cryoglobulinemia",
    "criteria": [
      {
        "id": "cryoglobulin-detection",
        "description": "Presence of circulating mixed cryoglobulins (type II: monoclonal IgM with rheumatoid factor activity and polyclonal IgG)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-triad",
        "description": "Clinical triad of palpable purpura, arthralgia, and weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "complement-levels",
        "description": "Low serum complement levels, especially decreased C4",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hep-c-association",
        "description": "Evidence of hepatitis C virus infection",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Vasculitis on biopsy showing leukocytoclastic vasculitis with immune complex deposition",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of circulating type II mixed cryoglobulins plus clinical features of vasculitis (palpable purpura, arthralgia, weakness) and/or histopathologic confirmation",
    "notes": "Hepatitis C infection is strongly associated but not mandatory for diagnosis."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Palpable purpura",
        "frequency": 0.85,
        "bodySystem": "dermatological",
        "notes": "Typically on lower extremities"
      },
      {
        "symptomName": "Monoclonal IgM with rheumatoid factor activity",
        "frequency": 0.75,
        "bodySystem": "hematological",
        "notes": "Detected in serum cryoglobulins"
      }
    ],
    "common": [
      {
        "symptomName": "Arthralgia",
        "frequency": 0.75,
        "bodySystem": "musculoskeletal",
        "notes": "Symmetrical joint pain without erosions"
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.7,
        "bodySystem": "constitutional",
        "notes": "Chronic and debilitating"
      },
      {
        "symptomName": "Peripheral neuropathy",
        "frequency": 0.65,
        "bodySystem": "neurological",
        "notes": "Sensory symptoms common"
      },
      {
        "symptomName": "Raynaud phenomenon",
        "frequency": 0.6,
        "bodySystem": "cardiovascular",
        "notes": "Vasospasm of digital arteries"
      }
    ],
    "occasional": [
      {
        "symptomName": "Renal involvement (membranoproliferative glomerulonephritis)",
        "frequency": 0.4,
        "bodySystem": "renal",
        "notes": "Proteinuria and hematuria"
      },
      {
        "symptomName": "Livedo reticularis",
        "frequency": 0.3,
        "bodySystem": "dermatological",
        "notes": "Mottled skin discoloration"
      },
      {
        "symptomName": "Dry eyes and mouth (sicca symptoms)",
        "frequency": 0.25,
        "bodySystem": "ophthalmological",
        "notes": "May mimic Sjögren syndrome"
      },
      {
        "symptomName": "Low-grade fever",
        "frequency": 0.2,
        "bodySystem": "constitutional",
        "notes": "Intermittent"
      },
      {
        "symptomName": "Hepatosplenomegaly",
        "frequency": 0.15,
        "bodySystem": "gastrointestinal",
        "notes": "Mild enlargement"
      }
    ],
    "rare": [
      {
        "symptomName": "Cutaneous ulcers",
        "frequency": 0.08,
        "bodySystem": "dermatological",
        "notes": "Due to severe vasculitis"
      },
      {
        "symptomName": "Central nervous system vasculitis",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Stroke or encephalopathy"
      },
      {
        "symptomName": "Cardiac involvement (myocarditis or pericarditis)",
        "frequency": 0.03,
        "bodySystem": "cardiovascular",
        "notes": "Rare but serious"
      }
    ]
  },
  "systemsAffected": [
    "dermatological",
