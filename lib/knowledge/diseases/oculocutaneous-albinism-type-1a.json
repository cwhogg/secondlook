        "description": "Absent or severely reduced tyrosinase enzyme activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biallelic-tyr-mutations",
        "description": "Identification of biallelic pathogenic mutations in the TYR gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-findings",
        "description": "Presence of nystagmus, foveal hypoplasia, and reduced visual acuity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of complete melanin absence with biallelic TYR mutations and absent tyrosinase activity",
    "notes": "Genetic testing is confirmatory; clinical features may overlap with other OCA types."
