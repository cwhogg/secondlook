  "diagnosticCriteria": {
    "formalCriteriaName": "Alarcon-Segovia Criteria (most commonly used); also Kasukawa and Sharp criteria",
    "criteria": [
      {
        "id": "mctd-c1",
        "description": "High titer anti-U1 RNP antibodies (>= 1:1600 by hemagglutination)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mctd-c2",
        "description": "Hand edema (puffy or swollen hands)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "mctd-c3",
        "description": "Synovitis (inflammatory arthritis)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "mctd-c4",
        "description": "Myositis (clinical or laboratory evidence)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "mctd-c5",
        "description": "Raynaud's phenomenon",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "mctd-c6",
        "description": "Acrosclerosis (scleroderma limited to digits)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Alarcon-Segovia criteria: Positive anti-U1 RNP (>= 1:1600) PLUS >= 3 of 5 clinical features (hand edema, synovitis, myositis, Raynaud's, acrosclerosis). At least one of synovitis or myositis must be present.",
    "notes": "MCTD is sometimes considered an overlap between SLE, systemic sclerosis, and polymyositis. Some experts debate whether it is a distinct entity. Over time, patients may evolve to a more defined CTD."
  },
