  "diagnosticCriteria": {
    "formalCriteriaName": "Nemaline Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "nemaline-rods",
        "description": "Presence of nemaline rods in muscle biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-weakness",
        "description": "Congenital or early-onset muscle weakness predominantly affecting proximal muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic variants in known nemaline myopathy-associated genes (e.g., ACTA1, NEB)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "Electromyographic findings consistent with myopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant or recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of nemaline rods on muscle biopsy plus clinical evidence of muscle weakness",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if biopsy findings are definitive."
  },
