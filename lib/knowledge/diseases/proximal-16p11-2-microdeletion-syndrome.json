  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific biochemical markers"
    ],
    "imaging": [
      "Brain MRI may show nonspecific findings such as mild white matter abnormalities",
      "Echocardiogram may detect congenital heart defects in rare cases"
    ],
    "genetic": [
      "SH2B1 (phenotype modifier)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Neuropsychological testing reveals cognitive and language impairments",
      "Behavioral assessments consistent with autism spectrum disorder or ADHD"
    ]
  },
