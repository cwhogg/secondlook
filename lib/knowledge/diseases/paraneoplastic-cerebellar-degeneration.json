  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Paraneoplastic Neurological Syndromes (PNS) 2004",
    "criteria": [
      {
        "id": "subacute-cerebellar-ataxia",
        "description": "Subacute onset of cerebellar ataxia progressing over weeks to months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "underlying-malignancy",
        "description": "Presence of an underlying malignancy known to be associated with PCD (e.g., small cell lung cancer, breast cancer, ovarian cancer)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "onconeural-antibodies",
        "description": "Detection of well-characterized paraneoplastic antibodies (e.g., anti-Yo, anti-Hu, anti-Tr)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of cerebellar degeneration such as toxic, metabolic, infectious, or hereditary etiologies",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Subacute cerebellar ataxia with confirmed underlying malignancy and exclusion of other causes; presence of onconeural antibodies supports diagnosis",
    "notes": "Early diagnosis is critical for management; antibody testing and cancer screening are essential."
  },
