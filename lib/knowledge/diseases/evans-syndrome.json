  "diagnosticCriteria": {
    "formalCriteriaName": "Evans Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "autoimmune-hemolytic-anemia",
        "description": "Presence of autoimmune hemolytic anemia confirmed by positive direct antiglobulin (Coombs) test",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immune-thrombocytopenia",
        "description": "Immune thrombocytopenia with platelet count <100,000/µL and exclusion of other causes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-secondary-causes",
        "description": "Exclusion of secondary causes such as systemic lupus erythematosus, lymphoproliferative disorders, or infections",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "sequential-or-simultaneous-cytopenias",
        "description": "Simultaneous or sequential occurrence of autoimmune hemolytic anemia and immune thrombocytopenia",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-examination",
        "description": "Bone marrow examination showing normal or increased megakaryocytes without evidence of malignancy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of autoimmune hemolytic anemia and immune thrombocytopenia with exclusion of secondary causes",
    "notes": "Diagnosis is clinical and supported by laboratory findings; other autoimmune cytopenias may be present."
  },
