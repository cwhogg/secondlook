  "diagnosticCriteria": {
    "formalCriteriaName": "DSM-IV Childhood Disintegrative Disorder Criteria",
    "criteria": [
      {
        "id": "normal-development",
        "description": "Normal development for at least the first 2 years after birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "loss-multiple-skills",
        "description": "Significant loss of previously acquired skills in at least two areas (language, social skills, bowel or bladder control, play, motor skills)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "onset-age",
        "description": "Onset of symptoms after at least 2 years of apparently normal development and before age 10",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormalities",
        "description": "Abnormalities in social interaction, communication, and restricted, repetitive behaviors",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-conditions",
        "description": "Exclusion of other neurological or medical conditions that could explain regression",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "All major criteria must be met including normal early development, significant loss of multiple skills after age 2, and abnormal social and communication behaviors",
    "notes": "Diagnosis requires careful exclusion of other causes of developmental regression"
  },
