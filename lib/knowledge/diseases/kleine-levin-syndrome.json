  "keyFindings": {
    "laboratory": [
      "Routine blood tests typically normal",
      "CSF analysis normal or nonspecific"
    ],
    "imaging": [
      "Brain MRI usually normal; occasional nonspecific white matter changes"
    ],
    "genetic": [
      "TRANK1 (susceptibility)"
    ],
    "other": [
      "Polysomnography during episodes shows hypersomnia with normal sleep architecture"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "narcolepsy",
      "distinguishingFeatures": [
        "Narcolepsy has daytime sleepiness without recurrent prolonged hypersomnia episodes",
        "Cataplexy and sleep paralysis common in narcolepsy but absent in KLS"
      ]
    },
    {
      "diseaseId": "bipolar-disorder",
      "distinguishingFeatures": [
        "Mood episodes in bipolar disorder are longer and not characterized by hypersomnia lasting days to weeks",
        "No recurrent hypersomnia with normal interepisode cognition"
      ]
    },
    {
      "diseaseId": "encephalitis",
      "distinguishingFeatures": [
        "Encephalitis presents with fever, neurological deficits, and abnormal CSF",
        "KLS lacks infectious signs and has normal interepisode neurological exam"
      ]
    }
  ],
  "redFlags": [
    "Persistent neurological deficits between episodes",
    "Fever or signs of infection during episodes",
    "Progressive cognitive decline"
  ],
