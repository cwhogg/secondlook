  "diagnosticCriteria": {
    "formalCriteriaName": "Congenital Factor V Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "prolonged-pt-apt",
        "description": "Prolonged prothrombin time (PT) and activated partial thromboplastin time (aPTT) not corrected by vitamin K",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "factor-v-activity",
        "description": "Markedly reduced factor V activity levels (<10%) in plasma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the F5 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "bleeding-history",
        "description": "Personal or family history of bleeding diathesis consistent with factor V deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of markedly reduced factor V activity with prolonged PT and aPTT plus bleeding history",
    "notes": "Genetic testing supports diagnosis but is not mandatory."
  },
