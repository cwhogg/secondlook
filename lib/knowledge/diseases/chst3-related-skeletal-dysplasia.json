  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for CHST3-related Skeletal Dysplasia",
    "criteria": [
      {
        "id": "joint-dislocations",
        "description": "Congenital large joint dislocations, especially of hips, knees, and elbows",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-trunk-dwarfism",
        "description": "Short-trunk dwarfism with disproportionate short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "molecular-confirmation",
        "description": "Identification of biallelic pathogenic variants in the CHST3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "spinal-anomalies",
        "description": "Radiographic evidence of platyspondyly and vertebral anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-features",
        "description": "Mild facial dysmorphism including midface hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital joint dislocations and disproportionate short-trunk dwarfism combined with molecular confirmation of CHST3 pathogenic variants",
    "notes": "Diagnosis is confirmed by genetic testing; clinical features may overlap with other skeletal dysplasias."
  },
