  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Pfeiffer-Palm-Teller syndrome",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of cranial sutures leading to abnormal skull shape",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midface-hypoplasia",
        "description": "Midfacial hypoplasia causing characteristic facial appearance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "broad-thumb-hallux",
        "description": "Broad and medially deviated thumbs and great toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-loss",
        "description": "Conductive or sensorineural hearing impairment",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis, midface hypoplasia, and broad thumbs or halluces",
    "notes": "Diagnosis is primarily clinical supported by genetic testing for FGFR mutations"
  },
