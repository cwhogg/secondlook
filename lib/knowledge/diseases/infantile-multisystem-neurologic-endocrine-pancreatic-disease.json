  "keyFindings": {
    "laboratory": [
      "Low serum cortisol and aldosterone levels",
      "Elevated fecal fat indicating pancreatic exocrine insufficiency",
      "Hypoglycemia on fasting glucose testing",
      "Mild anemia on complete blood count"
    ],
    "imaging": [
      "Brain MRI showing cerebral atrophy and delayed myelination",
      "Abdominal ultrasound may show pancreatic hypoplasia or atrophy"
    ],
    "genetic": [
      "PTRH2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Abnormal sweat chloride test to exclude cystic fibrosis",
      "Electroencephalogram (EEG) may show nonspecific slowing"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-pancreatic-exocrine-insufficiency",
      "distinguishingFeatures": [
        "Lack of neurologic and endocrine involvement",
        "Isolated pancreatic insufficiency"
      ]
    },
    {
      "diseaseId": "wolcott-rallison-syndrome",
      "distinguishingFeatures": [
        "Early-onset diabetes mellitus",
        "Skeletal dysplasia",
        "Liver dysfunction more prominent"
      ]
    },
    {
      "diseaseId": "mitochondrial-multisystem-disease",
      "distinguishingFeatures": [
        "Variable neurologic and systemic involvement",
        "Mitochondrial DNA mutations",
        "Lactic acidosis common"
      ]
    }
  ],
  "redFlags": [
    "Severe hypoglycemia unresponsive to standard treatment",
