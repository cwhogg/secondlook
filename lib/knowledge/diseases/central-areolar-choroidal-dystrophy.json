  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Imaging Diagnostic Criteria for Central Areolar Choroidal Dystrophy",
    "criteria": [
      {
        "id": "fundus-atrophy",
        "description": "Presence of well-demarcated central atrophy of the retinal pigment epithelium and choriocapillaris in the macular area",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "visual-acuity-reduction",
        "description": "Progressive central visual acuity loss with relative preservation of peripheral vision",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the PRPH2 gene associated with CACD",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-angiography",
        "description": "Fluorescein angiography showing central window defects and choriocapillaris atrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electroretinogram (ERG) showing normal or mildly reduced generalized retinal function",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of central macular atrophy on fundus examination and compatible imaging findings (fluorescein angiography or OCT) with progressive central visual acuity loss",
    "notes": "Genetic testing is supportive but not mandatory for diagnosis."
  },
