  "keyFindings": {
    "laboratory": [
      "Low serum luteinizing hormone (LH) and follicle-stimulating hormone (FSH)",
      "Low sex steroid levels (testosterone in males, estradiol in females)",
      "Normal pituitary imaging excluding other causes"
    ],
    "imaging": [
      "MRI showing hypoplastic or absent olfactory bulbs and tracts",
      "Renal ultrasound demonstrating unilateral renal agenesis or anomalies"
    ],
    "genetic": [
      "CCDC141 (causative)",
