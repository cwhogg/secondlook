  "diagnosticCriteria": {
    "formalCriteriaName": "Uhl Anomaly Diagnostic Criteria",
    "criteria": [
      {
        "id": "rv-myocardial-absence",
        "description": "Congenital partial or complete absence of right ventricular myocardium",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "right-ventricular-dilation",
        "description": "Marked dilation of the right ventricle with thin, parchment-like wall",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "arrhythmias",
        "description": "Presence of ventricular arrhythmias or conduction abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "right-heart-failure",
        "description": "Clinical signs of right ventricular failure",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital absence of right ventricular myocardium with right ventricular dilation",
    "notes": "Diagnosis is primarily based on imaging and histopathological findings; genetic testing is not routinely diagnostic."
  },
