  "diagnosticCriteria": {
    "formalCriteriaName": "Acute Liver Failure Diagnostic Criteria",
    "criteria": [
      {
        "id": "coagulopathy",
        "description": "Prothrombin time (INR) ≥ 1.5 without pre-existing liver disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "encephalopathy",
        "description": "Development of hepatic encephalopathy within 26 weeks of onset of liver disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-chronic-liver-disease",
        "description": "No evidence of pre-existing chronic liver disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "jaundice",
        "description": "Recent onset of jaundice",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of coagulopathy (INR ≥ 1.5) and hepatic encephalopathy within 26 weeks of onset of symptoms in a patient without pre-existing liver disease",
    "notes": "Diagnosis requires exclusion of chronic liver disease and other causes of liver dysfunction."
  },
