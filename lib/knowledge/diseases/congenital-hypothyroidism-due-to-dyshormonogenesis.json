  "keyFindings": {
    "laboratory": [
      "Elevated serum TSH",
      "Low serum free T4 and T3",
      "Elevated thyroglobulin in some cases",
      "Normal or elevated radioactive iodine uptake"
    ],
    "imaging": [
      "Normal or enlarged thyroid gland on ultrasound",
      "Normal or increased uptake on thyroid scintigraphy",
      "Delayed bone age on radiographs"
    ],
    "genetic": [
      "Pathogenic variants in TPO, TG, DUOX2, SLC5A5, or other thyroid hormone synthesis genes"
    ],
    "other": [
      "Newborn screening programs detect elevated TSH",
      "Response to levothyroxine therapy confirms diagnosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-hypothyroidism-due-to-thyroid-dysgenesis",
      "distinguishingFeatures": [
        "Absent or ectopic thyroid gland on imaging",
        "Low or absent radioactive iodine uptake",
        "Usually sporadic rather than inherited"
      ]
    },
    {
      "diseaseId": "transient-neonatal-hypothyroidism",
      "distinguishingFeatures": [
        "Temporary hypothyroidism resolving within weeks to months",
        "Often related to maternal antibodies or iodine exposure",
        "Normal thyroid anatomy and function eventually"
      ]
    }
  ],
  "redFlags": [
    "Severe developmental delay if untreated",
    "Persistent elevated TSH despite therapy",
    "Signs of thyroid hormone resistance or other endocrine abnormalities"
  ],
