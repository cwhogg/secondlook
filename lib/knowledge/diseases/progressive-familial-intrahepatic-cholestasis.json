  "diagnosticCriteria": {
    "formalCriteriaName": "PFIC Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Chronic cholestasis presenting in infancy or early childhood with pruritus and jaundice",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-profile",
        "description": "Elevated serum bile acids with normal or low gamma-glutamyl transferase (GGT) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in PFIC-associated genes (e.g., ATP8B1, ABCB11, ABCB4)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-biopsy",
        "description": "Histopathological evidence of canalicular cholestasis with absence of bile duct paucity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic cholestasis with low/normal GGT and identification of pathogenic mutations in PFIC-associated genes",
    "notes": "Diagnosis may be supported by liver biopsy and exclusion of other causes of cholestasis."
  },
