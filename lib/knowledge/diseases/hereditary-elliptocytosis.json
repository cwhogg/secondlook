  "diagnosticCriteria": {
    "formalCriteriaName": "Hereditary Elliptocytosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "elliptocytes-on-blood-smear",
        "description": "Presence of >25% elliptical or oval-shaped erythrocytes on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of elliptocytosis or hemolytic anemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemolytic-anemia",
        "description": "Evidence of mild to moderate hemolytic anemia (elevated reticulocytes, indirect hyperbilirubinemia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "membrane-protein-defect",
        "description": "Demonstration of spectrin or protein 4.1 deficiency by specialized testing",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "osmotic-fragility-test",
        "description": "Normal or slightly increased osmotic fragility test",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of >25% elliptocytes on blood smear plus either positive family history or evidence of hemolytic anemia",
    "notes": "Genetic testing can confirm mutations in spectrin or protein 4.1 genes but is not required for diagnosis."
  },
