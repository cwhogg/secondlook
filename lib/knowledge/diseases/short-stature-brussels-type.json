  "diagnosticCriteria": {
    "formalCriteriaName": "Brussels Type Short Stature Diagnostic Criteria",
    "criteria": [
      {
        "id": "criterion-1",
        "description": "Height below the 3rd percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-2",
        "description": "Normal growth hormone secretion and normal IGF-1 levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-3",
        "description": "Family history of short stature consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-4",
        "description": "Absence of systemic, endocrine, or nutritional causes of short stature",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of height below 3rd percentile with normal GH axis and positive family history consistent with autosomal dominant inheritance",
    "notes": "Diagnosis is clinical and supported by exclusion of other causes of short stature."
  },
