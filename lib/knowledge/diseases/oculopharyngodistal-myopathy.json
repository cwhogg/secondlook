    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "oculopharyngeal-muscular-dystrophy",
      "distinguishingFeatures": [
        "Proximal rather than distal muscle weakness predominates",
        "PABPN1 gene mutations",
        "Later onset typically after 50 years"
      ]
    },
    {
      "diseaseId": "inclusion-body-myopathy",
      "distinguishingFeatures": [
        "More prominent proximal muscle involvement",
        "Presence of inclusion bodies on muscle biopsy",
        "Associated with mutations in GNE or other genes"
      ]
    }
  ],
