  "diagnosticCriteria": {
    "formalCriteriaName": "Patterson Diagnostic Criteria for Pseudoleprechaunism Syndrome",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic coarse facial features including thick lips, flared nostrils, and large ears",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-insulin-resistance",
        "description": "Marked insulin resistance with hyperinsulinemia and impaired glucose tolerance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Severe intrauterine and postnatal growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-abnormalities",
        "description": "Skin changes including acanthosis nigricans and hypertrichosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of mutations in the insulin receptor gene (INSR)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (facial dysmorphism, severe insulin resistance, and growth retardation) with or without genetic confirmation",
    "notes": "Genetic testing is recommended to confirm diagnosis but is not mandatory if clinical criteria are met."
  },
