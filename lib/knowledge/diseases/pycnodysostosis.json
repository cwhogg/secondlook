  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "No specific biochemical markers"
    ],
    "imaging": [
      "Generalized osteosclerosis on X-ray",
      "Acro-osteolysis of distal phalanges",
      "Open cranial sutures and fontanelles on skull radiographs",
      "Hypoplastic clavicles and abnormal bone morphology"
    ],
    "genetic": [
      "CTSK (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Characteristic facial dysmorphism",
      "Short stature with skeletal disproportion"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "osteopetrosis",
      "distinguishingFeatures": [
        "More severe bone marrow failure",
        "No acro-osteolysis",
        "Different genetic mutations (e.g., CLCN7)"
      ]
    },
    {
      "diseaseId": "cleidocranial-dysplasia",
      "distinguishingFeatures": [
        "Clavicular hypoplasia/aplasia without osteosclerosis",
        "Delayed closure of fontanelles but normal bone density",
        "RUNX2 gene mutations"
      ]
    }
  ],
  "redFlags": [
    "Recurrent low-impact fractures",
    "Delayed closure of cranial sutures beyond infancy",
    "Severe bone pain or signs of osteomyelitis"
  ],
