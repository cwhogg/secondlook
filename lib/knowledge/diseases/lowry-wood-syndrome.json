  "diagnosticCriteria": {
    "formalCriteriaName": "Lowry-Wood Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "skeletal-dysplasia",
        "description": "Presence of distinctive skeletal dysplasia including metaphyseal abnormalities and short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-features",
        "description": "Characteristic craniofacial dysmorphism including frontal bossing and midface hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiological-findings",
        "description": "Radiographic evidence of metaphyseal irregularities and delayed bone age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in RNU4ATAC gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all major criteria including skeletal dysplasia, craniofacial features, and radiological findings",
    "notes": "Genetic testing can support diagnosis but is not mandatory"
  },
