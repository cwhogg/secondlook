  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible signs of infection if aspiration pneumonia present"
    ],
    "imaging": [
      "Chest and abdominal X-ray showing coiled nasogastric tube in upper esophageal pouch",
      "Contrast esophagogram to delineate anatomy and fistula presence",
      "Prenatal ultrasound showing polyhydramnios and absent stomach bubble"
    ],
    "genetic": [
      "Mutations in genes such as SOX2, CHD7 may be associated in syndromic cases",
      "Association with VACTERL sequence anomalies"
    ],
    "other": [
      "Endoscopic evaluation may be used preoperatively",
      "Bronchoscopy to assess for tracheoesophageal fistula"
    ]
  },
