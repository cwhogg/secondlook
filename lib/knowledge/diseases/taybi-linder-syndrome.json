    "formalCriteriaName": "Taybi-Linder Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Severe congenital microcephaly with simplified gyral pattern",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-anomalies",
        "description": "Severe skeletal dysplasia including metaphyseal abnormalities and short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-impairment",
        "description": "Profound neurological impairment with developmental delay and seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ciliopathy-features",
        "description": "Evidence of ciliopathy such as abnormal ciliary ultrastructure on biopsy or genetic confirmation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiological-findings",
        "description": "Characteristic brain imaging findings including hypoplastic corpus callosum and cerebellar hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: severe congenital microcephaly, skeletal dysplasia, and profound neurological impairment",
    "notes": "Genetic testing for mutations in RNU4ATAC gene can confirm diagnosis"
  },
