  "diagnosticCriteria": {
    "formalCriteriaName": "Non-HFE Hemochromatosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "iron-overload",
        "description": "Evidence of systemic iron overload by elevated serum ferritin and transferrin saturation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Absence of HFE gene mutations with identification of pathogenic variants in non-HFE genes (e.g., TFR2, HJV, HAMP, SLC40A1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-biopsy",
        "description": "Histological confirmation of hepatic iron deposition with or without fibrosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-secondary-causes",
        "description": "Exclusion of secondary causes of iron overload such as transfusions or chronic liver disease",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of systemic iron overload plus pathogenic non-HFE gene mutation and exclusion of secondary causes",
    "notes": "Genetic testing is essential to differentiate from classic HFE-related hemochromatosis."
  },
