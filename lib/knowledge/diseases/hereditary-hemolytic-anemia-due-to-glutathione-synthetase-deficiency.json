  "keyFindings": {
    "laboratory": [
      "Decreased glutathione synthetase enzyme activity in erythrocytes",
      "Elevated urinary 5-oxoproline (pyroglutamic acid)",
      "Chronic hemolytic anemia with reticulocytosis",
      "Metabolic acidosis with low serum bicarbonate"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter changes in severe cases"
    ],
    "genetic": [
      "HBB (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Elevated erythrocyte osmotic fragility",
      "Increased oxidative stress markers in red blood cells"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "glucose-6-phosphate-dehydrogenase-deficiency",
      "distinguishingFeatures": [
        "Normal glutathione synthetase activity",
        "Triggered hemolysis by oxidative stress or drugs",
        "Absence of metabolic acidosis and elevated 5-oxoproline"
      ]
    },
    {
      "diseaseId": "pyruvate-kinase-deficiency",
      "distinguishingFeatures": [
        "Enzyme deficiency in glycolytic pathway, not glutathione metabolism",
        "No metabolic acidosis or elevated 5-oxoproline",
        "Different genetic mutations and enzyme assays"
      ]
    }
  ],
  "redFlags": [
    "Severe metabolic acidosis refractory to standard treatment",
