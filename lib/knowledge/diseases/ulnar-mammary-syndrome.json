  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Ulnar-mammary syndrome",
    "criteria": [
      {
        "id": "limb-malformations",
        "description": "Presence of ulnar ray defects including hypoplasia or aplasia of the ulna, postaxial polydactyly, or camptodactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mammary-gland-hypoplasia",
        "description": "Hypoplasia or aplasia of mammary glands and nipples",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genital-anomalies",
        "description": "Hypogonadism or genital hypoplasia including micropenis or cryptorchidism in males and hypoplastic labia in females",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tooth-anomalies",
        "description": "Dental anomalies such as hypodontia or delayed eruption",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pituitary-dysfunction",
        "description": "Endocrine abnormalities including growth hormone deficiency or delayed puberty",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of limb malformations and mammary gland hypoplasia",
    "notes": "Genetic testing for TBX3 mutations can confirm diagnosis"
  },
