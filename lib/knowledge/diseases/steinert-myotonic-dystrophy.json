  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate)",
      "Abnormal glucose tolerance tests",
      "Hormonal assays showing hypogonadism"
    ],
    "imaging": [
      "Muscle MRI showing fatty infiltration and atrophy",
      "Echocardiogram may show conduction abnormalities or cardiomyopathy"
    ],
    "genetic": [
      "Expanded CTG trinucleotide repeat in DMPK gene detected by PCR or Southern blot",
      "Repeat length correlates with disease severity and anticipation",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography demonstrating myotonic discharges",
      "ECG showing conduction defects such as AV block"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "myotonic-dystrophy-type-2",
      "distinguishingFeatures": [
        "Proximal muscle weakness predominates",
        "CCTG repeat expansion in CNBP gene",
        "Later onset and milder phenotype"
      ]
    },
    {
      "diseaseId": "congenital-myotonia",
      "distinguishingFeatures": [
        "Absence of CTG repeat expansion",
        "Non-progressive myotonia",
        "Normal cardiac and systemic involvement"
      ]
    }
  ],
  "redFlags": [
    "Progressive cardiac conduction block with syncope",
    "Respiratory failure due to diaphragmatic weakness",
    "Severe dysphagia with risk of aspiration pneumonia"
  ],
