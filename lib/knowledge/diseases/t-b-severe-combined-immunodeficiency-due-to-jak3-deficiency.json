  "keyFindings": {
    "laboratory": [
      "Severe T-cell lymphopenia with normal or elevated B-cell counts",
      "Absent T-cell proliferative response to mitogens",
      "Hypogammaglobulinemia despite normal B-cell numbers",
      "Elevated serum IgM in some cases"
    ],
    "imaging": [
      "Chest X-ray showing pneumonia or interstitial lung disease",
      "CT scan may reveal lymphoid tissue hypoplasia"
    ],
    "genetic": [
      "JAK3 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Flow cytometry immunophenotyping confirming T-B+ NK- phenotype",
      "Newborn screening may detect low T-cell receptor excision circles (TRECs)"
    ]
  },
