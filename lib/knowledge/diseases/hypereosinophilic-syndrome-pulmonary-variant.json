  "keyFindings": {
    "laboratory": [
      "Elevated absolute eosinophil count >1.5 x 10^9/L",
      "Increased serum IgE levels",
      "Elevated inflammatory markers (ESR, CRP)"
    ],
    "imaging": [
      "Chest X-ray showing bilateral pulmonary infiltrates",
      "High-resolution CT scan demonstrating ground-glass opacities and interstitial infiltrates"
    ],
    "genetic": [
      "Absence of FIP1L1-PDGFRA fusion gene (to exclude myeloproliferative variant)"
    ],
    "other": [
      "Bone marrow biopsy with eosinophilic hyperplasia without malignancy",
      "Pulmonary function tests showing restrictive pattern"
    ]
