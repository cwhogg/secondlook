  "keyFindings": {
    "laboratory": [
      "Elevated plasma medium-chain acylcarnitines (notably C8) on tandem mass spectrometry",
      "Hypoketotic hypoglycemia during metabolic crises",
      "Elevated liver transaminases during acute episodes"
    ],
    "imaging": [
      "Possible hepatomegaly on abdominal ultrasound",
      "Echocardiogram may reveal cardiomyopathy in some cases"
    ],
    "genetic": [
      "ACADM (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Reduced MCAD enzyme activity in fibroblasts or lymphocytes (enzyme assay)"
    ]
