        "Additional endocrine abnormalities"
      ]
    },
    {
      "diseaseId": "greig-cephalopolysyndactyly-syndrome",
      "distinguishingFeatures": [
        "Preaxial polydactyly predominates",
        "Macrocephaly instead of microcephaly",
        "Less severe brain malformations"
      ]
    }
  ],
