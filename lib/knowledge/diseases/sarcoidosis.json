  "keyFindings": {
    "laboratory": [
      "Elevated serum ACE (angiotensin-converting enzyme) in ~60% (not specific)",
      "Elevated serum calcium (hypercalcemia in ~10%, hypercalciuria in ~30%)",
      "Elevated 1,25-dihydroxyvitamin D",
      "Elevated ESR/CRP",
      "Elevated serum IL-2 receptor (soluble IL-2R/sIL-2R)",
      "Elevated alkaline phosphatase if hepatic involvement"
    ],
    "imaging": [
      "Chest X-ray: bilateral hilar lymphadenopathy (Scadding stages I-IV)",
      "CT chest: mediastinal/hilar lymphadenopathy, perilymphatic nodules, fibrosis",
      "PET-CT: FDG-avid lymph nodes and organ involvement; useful for cardiac sarcoidosis",
      "Cardiac MRI: late gadolinium enhancement for cardiac involvement"
    ],
    "genetic": [
      "BTNL2 (susceptibility)",
      "HLA-DRB1 (susceptibility)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Bronchoscopy with BAL: CD4/CD8 ratio > 3.5 supportive",
      "Transbronchial biopsy or EBUS-TBNA for tissue diagnosis",
      "Pulmonary function tests: restrictive pattern, decreased DLCO",
      "Kveim test (historical; no longer used)",
      "ECG and Holter monitor for cardiac screening"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "tuberculosis",
      "distinguishingFeatures": [
        "TB granulomas are caseating",
        "TB has positive AFB stain/culture/PCR",
        "Positive tuberculin skin test or Quantiferon in TB"
      ]
    },
    {
      "diseaseId": "lymphoma",
      "distinguishingFeatures": [
        "Lymphoma has atypical lymphoid cells on biopsy",
        "Lymphoma typically has asymmetric lymphadenopathy",
        "B-symptoms more prominent in lymphoma"
      ]
    },
    {
      "diseaseId": "hypersensitivity-pneumonitis",
      "distinguishingFeatures": [
        "HP has identifiable antigen exposure history",
        "HP shows upper/mid-lung predominance on CT",
        "BAL shows lymphocytosis with low CD4/CD8 ratio"
      ]
    }
  ],
  "redFlags": [
    "Cardiac symptoms (syncope, palpitations, new heart block) - cardiac sarcoidosis can cause sudden death",
    "Neurological deficits suggesting neurosarcoidosis",
    "Rapidly progressive dyspnea or stage IV pulmonary fibrosis",
    "Severe hypercalcemia with renal impairment",
    "Lupus pernio (marker of chronic, multisystem disease)"
  ],
  "specialistType": [
