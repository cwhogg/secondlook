  "keyFindings": {
    "laboratory": [
      "Persistent neutropenia on serial complete blood counts",
      "Elevated urinary 3-methylglutaconic acid levels",
      "Elevated creatine kinase in some patients"
    ],
    "imaging": [
      "Echocardiogram showing dilated or hypertrophic cardiomyopathy",
      "Cardiac MRI may show left ventricular noncompaction"
    ],
    "genetic": [
      "Pathogenic variants in the TAZ (tafazzin) gene on X chromosome"
    ],
    "other": [
      "Muscle biopsy may show mitochondrial abnormalities",
      "Electromyography indicating skeletal myopathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dilated-cardiomyopathy",
      "distinguishingFeatures": [
        "Lack of neutropenia",
        "No TAZ gene mutation",
        "Absence of 3-methylglutaconic aciduria"
      ]
    },
    {
      "diseaseId": "severe-congenital-neutropenia",
      "distinguishingFeatures": [
        "Neutropenia without cardiomyopathy",
        "Different genetic mutations (e.g. ELANE gene)",
        "No skeletal myopathy or growth delay"
      ]
    },
    {
      "diseaseId": "mitochondrial-myopathy",
      "distinguishingFeatures": [
        "Variable cardiomyopathy types",
        "No neutropenia",
        "Different genetic causes"
      ]
    }
  ],
  "redFlags": [
    "Early onset cardiomyopathy with heart failure symptoms",
