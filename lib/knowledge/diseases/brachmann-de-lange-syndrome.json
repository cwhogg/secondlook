  "diagnosticCriteria": {
    "formalCriteriaName": "Cornelia de Lange Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial features including synophrys, long eyelashes, and thin downturned lips",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Upper limb anomalies such as micromelia, oligodactyly, or absent digits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Pre- and postnatal growth retardation with short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hirsutism",
        "description": "Excessive body hair",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (distinctive facial features, limb malformations, and growth retardation) or two major plus two minor criteria",
    "notes": "Genetic testing for mutations in NIPBL, SMC1A, or SMC3 genes can support diagnosis"
  },
