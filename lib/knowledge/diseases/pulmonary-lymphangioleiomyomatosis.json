  "diagnosticCriteria": {
    "formalCriteriaName": "European Respiratory Society (ERS) LAM Diagnostic Criteria",
    "criteria": [
      {
        "id": "lung-cysts",
        "description": "Characteristic thin-walled cystic changes on high-resolution chest CT",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chylous-effusion",
        "description": "Presence of chylous pleural effusion",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "angiomyolipoma",
        "description": "Renal angiomyolipoma detected by imaging",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "lymphatic-involvement",
        "description": "Lymphatic abnormalities such as lymphangioleiomyomas or lymphadenopathy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-vegf-d",
        "description": "Elevated serum vascular endothelial growth factor-D (VEGF-D) levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic lung cysts on HRCT plus either renal angiomyolipoma, chylous effusion, lymphatic involvement, or elevated VEGF-D",
    "notes": "Definitive diagnosis may require lung biopsy if clinical and radiologic criteria are inconclusive."
  },
