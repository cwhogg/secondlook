  "diagnosticCriteria": {
    "formalCriteriaName": "Norrie Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "congenital-blindness",
        "description": "Congenital or early-onset blindness due to retinal maldevelopment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-hearing-loss",
        "description": "Progressive sensorineural hearing loss developing in childhood or adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "norrin-gene-mutation",
        "description": "Pathogenic mutation in the NDP gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-fibrovascular-masses",
        "description": "Presence of fibrovascular masses or pseudoglioma in the retina",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital blindness with retinal maldevelopment plus either progressive hearing loss or a confirmed NDP gene mutation",
    "notes": "Genetic testing is critical for confirmation; clinical presentation may vary."
  },
