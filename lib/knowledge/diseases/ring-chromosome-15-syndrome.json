        "Characteristic behavioral phenotype"
      ]
    },
    {
      "diseaseId": "cri-du-chat-syndrome",
      "distinguishingFeatures": [
        "Deletion of 5p chromosome",
        "High-pitched cat-like cry in infancy",
        "Distinctive facial features different from ring chromosome 15"
      ]
    }
  ],
