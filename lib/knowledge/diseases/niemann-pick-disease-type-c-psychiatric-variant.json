  "diagnosticCriteria": {
    "formalCriteriaName": "NPC Suspicion Index and Diagnostic Criteria",
    "criteria": [
      {
        "id": "psychiatric-symptoms",
        "description": "Adult-onset psychiatric symptoms including psychosis, cognitive decline, or mood disorders preceding neurological signs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-signs",
        "description": "Presence of neurological manifestations such as vertical supranuclear gaze palsy or ataxia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-testing",
        "description": "Abnormal filipin staining or elevated oxysterols in plasma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in NPC1 or NPC2 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-history",
        "description": "Family history of NPC or unexplained neuropsychiatric symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of adult-onset psychiatric symptoms plus neurological signs and confirmation by biochemical or genetic testing",
    "notes": "Diagnosis often requires multidisciplinary evaluation including psychiatric, neurological, and genetic assessments."
  },
