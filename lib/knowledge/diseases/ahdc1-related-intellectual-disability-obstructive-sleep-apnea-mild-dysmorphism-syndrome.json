  "commonPitfalls": [
    "Often misattributed to non-specific global developmental delay without recognition of the syndromic features.",
    "Obstructive sleep apnea may be overlooked or attributed to common pediatric causes such as adenotonsillar hypertrophy.",
    "Mild dysmorphic features can be subtle and missed without careful dysmorphology assessment.",
    "Speech and motor delays may be assumed to be idiopathic or due to environmental factors."
  ],
  "extendedDiscriminators": [
    {
      "vsCondition": "mowat-wilson-syndrome",
      "feature": "Absence of Hirschsprung disease and characteristic Mowat-Wilson facial gestalt in AHDC1 syndrome."
    },
    {
      "vsCondition": "smith-lemli-opitz-syndrome",
      "feature": "Normal cholesterol levels in AHDC1 syndrome, whereas Smith-Lemli-Opitz syndrome typically shows low serum cholesterol."
    },
    {
      "vsCondition": "autism spectrum disorder",
      "feature": "Presence of obstructive sleep apnea and specific craniofacial dysmorphism in AHDC1 syndrome, which are not core features of autism spectrum disorder."
    }
  ],
  "ruleOutCriteria": [
    "Normal neurodevelopmental milestones and absence of intellectual disability.",
    "No evidence of sleep-disordered breathing or obstructive sleep apnea on clinical evaluation or sleep study."
