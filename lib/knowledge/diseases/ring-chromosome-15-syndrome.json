  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Ring Chromosome 15 Syndrome",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Identification of ring chromosome 15 by karyotype or chromosomal microarray",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Pre- and postnatal growth retardation with short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic craniofacial features including microcephaly, triangular face, and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "limb-anomalies",
        "description": "Presence of limb anomalies such as clinodactyly or syndactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of ring chromosome 15 confirmed by cytogenetic analysis plus at least two major clinical features",
    "notes": "Diagnosis relies heavily on cytogenetic confirmation due to phenotypic variability."
  },
