  "keyFindings": {
    "laboratory": [
      "Profound CD8+ T-cell lymphopenia with normal or near-normal CD4+ T-cell counts",
      "Impaired T-cell proliferation in response to mitogens and antigens",
      "Hypogammaglobulinemia or normal immunoglobulin levels"
    ],
    "imaging": [
      "Chest radiographs showing recurrent pneumonia or bronchiectasis",
      "Abdominal ultrasound revealing hepatosplenomegaly"
    ],
    "genetic": [
      "ZAP70 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Absent or severely reduced ZAP70 protein expression by flow cytometry or Western blot",
      "Defective T-cell receptor signaling assays"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "severe-combined-immunodeficiency-scid",
      "distinguishingFeatures": [
        "Profound T-cell lymphopenia affecting both CD4+ and CD8+ subsets",
        "More severe B-cell defects and earlier onset",
        "Different genetic mutations (e.g., IL2RG, ADA)"
      ]
    },
    {
      "diseaseId": "mendelian-susceptibility-to-mycobacterial-disease-msmd",
      "distinguishingFeatures": [
        "Predominantly susceptibility to mycobacterial infections",
        "Normal or mildly reduced T-cell numbers",
        "Mutations in IFNGR1, IL12RB1 rather than ZAP70"
      ]
    }
  ],
  "redFlags": [
    "Severe recurrent viral and opportunistic infections in infancy",
    "Profound absence of CD8+ T cells despite normal CD4+ counts",
