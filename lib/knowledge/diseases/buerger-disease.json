  "diagnosticCriteria": {
    "formalCriteriaName": "Shionoya Criteria",
    "criteria": [
      {
        "id": "age-onset",
        "description": "Onset before age 45 years",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tobacco-use",
        "description": "Current or recent history of tobacco use",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distal-extremity-involvement",
        "description": "Infrapopliteal arterial occlusive disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-atherosclerosis",
        "description": "Exclusion of autoimmune diseases, hypercoagulable states, and diabetes mellitus",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "superficial-thrombophlebitis",
        "description": "Migratory superficial thrombophlebitis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All major criteria must be met including age of onset, tobacco use, distal extremity involvement, and exclusion of other diseases",
    "notes": "Diagnosis is clinical and supported by angiographic findings; biopsy is rarely performed."
  },
