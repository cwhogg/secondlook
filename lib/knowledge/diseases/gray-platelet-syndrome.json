  "diagnosticCriteria": {
    "formalCriteriaName": "Gray Platelet Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "alpha-granule-deficiency",
        "description": "Demonstration of deficiency or absence of platelet alpha granules by electron microscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "macrothrombocytopenia",
        "description": "Presence of thrombocytopenia with large platelets on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bleeding-tendency",
        "description": "Clinical history of mild to moderate mucocutaneous bleeding",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-fibrosis",
        "description": "Bone marrow fibrosis or myelofibrosis on biopsy (supportive)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in NBEAL2 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of alpha granule deficiency, macrothrombocytopenia, and bleeding tendency",
    "notes": "Genetic testing for NBEAL2 mutations supports diagnosis but is not mandatory."
  },
