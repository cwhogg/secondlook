        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-transferrin-glycosylation",
        "description": "Abnormal serum transferrin glycosylation pattern detected by isoelectric focusing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ALG1-gene-mutation",
        "description": "Identification of biallelic pathogenic variants in the ALG1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multisystem-involvement",
        "description": "Presence of multisystem clinical features including neurological and gastrointestinal manifestations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic ALG1 variants plus abnormal transferrin glycosylation pattern and compatible clinical features including hypotonia and developmental delay",
    "notes": "Molecular genetic testing is essential for confirmation; biochemical screening by transferrin isoelectric focusing is a key initial test."
  },
