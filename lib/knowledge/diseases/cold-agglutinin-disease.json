  "keyFindings": {
    "laboratory": [
      "Positive direct antiglobulin test (DAT) for complement (C3d) only",
      "Elevated cold agglutinin titers (≥1:64 at 4°C)",
      "Evidence of hemolytic anemia: elevated LDH, low haptoglobin, increased reticulocytes",
      "Peripheral blood smear showing red blood cell agglutination"
    ],
    "imaging": [
      "Splenomegaly on abdominal ultrasound (occasionally)"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Cold exposure triggers symptom exacerbation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "warm-autoimmune-hemolytic-anemia",
      "distinguishingFeatures": [
        "Warm-reactive autoantibodies active at 37°C",
        "Positive DAT for IgG rather than complement",
        "Lack of cold-induced symptoms"
      ]
    },
    {
      "diseaseId": "paroxysmal-cold-hemoglobinuria",
      "distinguishingFeatures": [
        "Presence of Donath-Landsteiner antibodies",
        "Biphasic hemolysin causing intravascular hemolysis",
        "Usually acute and self-limited"
      ]
    }
  ],
  "redFlags": [
    "Severe hemolytic anemia causing hemodynamic instability",
    "Rapid onset of jaundice and dark urine",
    "Signs of thrombosis or ischemic complications"
  ],
