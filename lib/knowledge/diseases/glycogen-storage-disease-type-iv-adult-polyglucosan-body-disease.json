  "diagnosticCriteria": {
    "formalCriteriaName": "Adult Polyglucosan Body Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Adult-onset progressive motor neuron disease with upper and lower motor neuron signs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "polyglucosan-bodies",
        "description": "Detection of polyglucosan bodies in nerve biopsy or autopsy tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gba-ncst-mutation",
        "description": "Identification of pathogenic mutations in the GBE1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cognitive-impairment",
        "description": "Presence of dementia or cognitive decline",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "electrophysiology",
        "description": "Electromyography showing neurogenic changes consistent with motor neuron disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of adult-onset motor neuron disease symptoms plus either polyglucosan bodies on biopsy or pathogenic GBE1 mutation",
    "notes": "Diagnosis requires integration of clinical, pathological, and genetic findings."
  },
