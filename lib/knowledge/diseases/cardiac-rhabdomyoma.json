  "diagnosticCriteria": {
    "formalCriteriaName": "No formal standardized criteria; diagnosis based on imaging and histopathology",
    "criteria": [
      {
        "id": "imaging-detection",
        "description": "Identification of one or more well-circumscribed, hyperechoic cardiac masses on echocardiography or cardiac MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological confirmation showing large polygonal myocytes with abundant glycogen and spider cells",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tuberous-sclerosis-association",
        "description": "Presence of tuberous sclerosis complex or related genetic mutation (TSC1 or TSC2)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Detection of characteristic cardiac mass on imaging with or without histopathological confirmation",
    "notes": "Diagnosis is often made prenatally or in infancy by echocardiography; genetic testing for TSC is recommended."
  },
