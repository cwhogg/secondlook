  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Autosomal Recessive Spinocerebellar Ataxia-Blindness-Deafness Syndrome",
    "criteria": [
      {
        "id": "ataxia",
        "description": "Progressive cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-blindness",
        "description": "Bilateral sensorineural visual loss progressing to blindness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-deafness",
        "description": "Bilateral sensorineural hearing loss leading to deafness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the causative gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-neurodegenerative-causes",
        "description": "Exclusion of other causes of ataxia, blindness, and deafness",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia, bilateral sensorineural blindness, bilateral sensorineural deafness, and confirmation of biallelic pathogenic variants in the causative gene",
    "notes": "Diagnosis relies heavily on clinical triad and genetic testing; neuroimaging and electrophysiological studies support diagnosis."
  },
