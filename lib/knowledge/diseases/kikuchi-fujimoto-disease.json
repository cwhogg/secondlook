  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological Diagnostic Criteria for Kikuchi-Fujimoto Disease",
    "criteria": [
      {
        "id": "lymphadenopathy",
        "description": "Presence of tender cervical lymphadenopathy, typically unilateral",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Lymph node biopsy showing necrotizing histiocytic lymphadenitis with absence of neutrophils",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-infections",
        "description": "Exclusion of infectious causes such as tuberculosis, toxoplasmosis, and viral lymphadenitis",
        "category": "minor",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-lupus",
        "description": "Exclusion of systemic lupus erythematosus by clinical and serological evaluation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "constitutional-symptoms",
        "description": "Presence of mild fever and night sweats",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of necrotizing histiocytic lymphadenitis with compatible clinical presentation and exclusion of infectious and autoimmune causes",
    "notes": "Diagnosis is primarily histopathological; clinical features support but are not definitive alone."
  },
