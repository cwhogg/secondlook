  "diagnosticCriteria": {
    "formalCriteriaName": "2022 ACR/EULAR Classification Criteria for EGPA",
    "criteria": [
      {
        "id": "egpa-1",
        "description": "Obstructive airway disease (asthma or nasal polyposis)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "egpa-2",
        "description": "Peripheral blood eosinophilia > 1.0 x 10^9/L (> 10%)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "egpa-3",
        "description": "Maximum eosinophil count >= 1.0 x 10^9/L",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "egpa-4",
        "description": "Extravascular eosinophilic-predominant inflammation on biopsy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "egpa-5",
        "description": "MPO-ANCA (p-ANCA) positivity",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "egpa-6",
        "description": "Myocardial involvement attributable to EGPA",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "egpa-7",
        "description": "Nasal polyps",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Diagnosis of vasculitis or eosinophilia plus total weighted score >= 6",
    "notes": "EGPA has two phenotypes: ANCA-positive (more vasculitic, with GN, neuropathy, purpura) and ANCA-negative (more eosinophilic, with cardiac and pulmonary involvement)."
  },
