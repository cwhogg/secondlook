  "diagnosticCriteria": {
    "formalCriteriaName": "Hypophosphatasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "low-alkaline-phosphatase",
        "description": "Persistently low serum alkaline phosphatase activity below age-adjusted reference range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-substrates",
        "description": "Elevated serum and urine levels of substrates such as pyridoxal-5'-phosphate (PLP) and phosphoethanolamine (PEA)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-bone-deformities",
        "description": "Presence of rickets-like bone deformities including bowed long bones and metaphyseal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the ALPL gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiographic-findings",
        "description": "Radiographic evidence of defective bone mineralization and metaphyseal changes",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of low serum alkaline phosphatase, clinical bone deformities consistent with rickets, and supportive radiographic findings; genetic confirmation is supportive but not mandatory.",
    "notes": "Diagnosis requires exclusion of other causes of rickets and bone deformities."
  },
