  "diagnosticCriteria": {
    "formalCriteriaName": "Sturge-Weber syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "facial-port-wine-stain",
        "description": "Presence of a facial port-wine stain (nevus flammeus) typically involving the ophthalmic branch of the trigeminal nerve",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "leptomeningeal-angiomatosis",
        "description": "Leptomeningeal vascular malformations demonstrated by neuroimaging or histopathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glaucoma",
        "description": "Glaucoma or other ocular vascular abnormalities ipsilateral to the facial nevus",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-manifestations",
        "description": "Neurological symptoms such as seizures, hemiparesis, or developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of facial port-wine stain plus leptomeningeal angioma on neuroimaging or histopathology",
    "notes": "Diagnosis is clinical supported by imaging; genetic testing for GNAQ mutation may assist but is not required"
  },
