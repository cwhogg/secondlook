  "diagnosticCriteria": {
    "formalCriteriaName": "BSSR Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "brachydactyly",
        "description": "Presence of brachydactyly characterized by shortened distal and middle phalanges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Postnatal short stature below the 3rd percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "retinitis-pigmentosa",
        "description": "Clinical and electrophysiological evidence of retinitis pigmentosa with progressive peripheral vision loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiographic-findings",
        "description": "Radiographic evidence of brachydactyly and delayed bone age",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: brachydactyly, short stature, and retinitis pigmentosa",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
