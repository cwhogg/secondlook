  "keyFindings": {
    "laboratory": [
      "Complete blood count may show transient myeloproliferative disorder in neonates",
      "Thyroid function tests indicating hypothyroidism"
    ],
    "imaging": [
      "Echocardiogram revealing atrioventricular septal defects or other congenital heart defects",
      "Cervical spine radiographs to assess atlantoaxial instability"
    ],
    "genetic": [
      "Karyotype showing trisomy 21 (47,XX,+21 or 47,XY,+21)",
      "Fluorescence in situ hybridization (FISH) or chromosomal microarray confirming extra chromosome 21 material"
    ],
    "other": [
      "Developmental assessments demonstrating intellectual disability",
      "Physical examination revealing characteristic dysmorphic features"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "fragile-x-syndrome",
      "distinguishingFeatures": [
        "Macroorchidism in males",
        "Behavioral phenotype with autism spectrum features",
        "Normal karyotype without trisomy 21"
      ]
    },
    {
      "diseaseId": "prader-willi-syndrome",
      "distinguishingFeatures": [
        "Hypotonia with poor feeding in infancy followed by hyperphagia and obesity",
        "Distinct facial features different from Down syndrome",
        "Genetic abnormalities on chromosome 15"
      ]
    }
  ],
  "redFlags": [
    "Severe congenital heart defect causing cyanosis or heart failure",
    "Signs of atlantoaxial instability such as neck pain or neurological deficits",
    "Rapid onset of leukemia symptoms in infancy or childhood"
  ],
