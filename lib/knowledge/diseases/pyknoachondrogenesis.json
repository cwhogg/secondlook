  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Pyknoachondrogenesis",
    "criteria": [
      {
        "id": "skeletal-dysplasia",
        "description": "Severe generalized skeletal dysplasia with marked platyspondyly and shortened long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-pyknotic-chondrocytes",
        "description": "Presence of pyknotic chondrocytes in growth plate biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "prenatal-lethal",
        "description": "Prenatal or perinatal lethality with characteristic radiographic features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features including macrocephaly and midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-distress",
        "description": "Severe respiratory insufficiency due to thoracic hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: severe skeletal dysplasia, pyknotic chondrocytes on biopsy, and prenatal or perinatal lethality with characteristic radiographic features",
    "notes": "Diagnosis is primarily based on clinical, radiological, and histopathological findings; genetic testing may support but is not definitive."
  },
