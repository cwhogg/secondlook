  "diagnosticCriteria": {
    "formalCriteriaName": "International Classification of Sleep Disorders (ICSD-3) Criteria",
    "criteria": [
      {
        "id": "recurrent-hypersomnia",
        "description": "Recurrent episodes of hypersomnia lasting days to weeks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cognitive-disturbances",
        "description": "Cognitive dysfunction during episodes including confusion and derealization",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-abnormalities",
        "description": "Behavioral disturbances such as hyperphagia, hypersexuality, or irritability during episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-interepisode-function",
        "description": "Normal cognitive and behavioral function between episodes",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other neurological, psychiatric, or medical causes",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent hypersomnia episodes with cognitive and behavioral disturbances, normal interepisode function, and exclusion of other causes",
    "notes": "Diagnosis is clinical and requires careful exclusion of other causes of hypersomnia and behavioral changes."
  },
