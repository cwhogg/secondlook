  "diagnosticCriteria": {
    "formalCriteriaName": "PMM2-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "abnormal-transferrin-glycosylation",
        "description": "Type 1 pattern on serum transferrin isoelectric focusing indicating abnormal N-glycosylation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pathogenic-pmm2-mutations",
        "description": "Identification of biallelic pathogenic variants in the PMM2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-multisystem-involvement",
        "description": "Presence of multisystemic clinical features including developmental delay, hypotonia, and coagulopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-laboratory-findings",
        "description": "Abnormal coagulation profile and liver function tests",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Abnormal transferrin glycosylation pattern plus biallelic pathogenic PMM2 variants with compatible clinical features",
    "notes": "Genetic confirmation is essential for definitive diagnosis; biochemical screening is first-line."
  },
