    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced transaldolase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the TALDO1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features including hepatosplenomegaly and coagulopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-polyols",
        "description": "Elevated urinary polyols and sugar alcohols (arabitol, ribitol)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biallelic pathogenic variants in TALDO1 gene plus reduced enzyme activity and compatible clinical features",
    "notes": "Diagnosis is confirmed by genetic testing and enzyme assay; biochemical markers support diagnosis."
  },
