  "diagnosticCriteria": {
    "formalCriteriaName": "Somatostatinoma Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-somatostatin",
        "description": "Elevated plasma somatostatin levels above normal reference range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology-confirmation",
        "description": "Histopathological confirmation of neuroendocrine tumor with immunohistochemical staining positive for somatostatin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-localization",
        "description": "Localization of tumor by imaging modalities such as CT, MRI, or somatostatin receptor scintigraphy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-triad",
        "description": "Presence of the classic triad: diabetes mellitus, cholelithiasis, and steatorrhea",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation with elevated plasma somatostatin levels; imaging and clinical features support diagnosis",
    "notes": "Diagnosis requires integration of biochemical, histological, and imaging findings."
  },
