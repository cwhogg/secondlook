        "id": "vwd-antigen-level",
        "description": "Reduced von Willebrand factor antigen levels (<30 IU/dL)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ristocetin-cofactor-activity",
        "description": "Reduced ristocetin cofactor activity (<30 IU/dL) indicating functional defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "factor-viii-activity",
        "description": "Reduced factor VIII clotting activity (may be normal or decreased depending on subtype)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "multimer-analysis",
        "description": "Abnormal von Willebrand factor multimer pattern on electrophoresis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bleeding symptoms plus reduced VWF antigen and ristocetin cofactor activity levels",
    "notes": "Diagnosis requires correlation of clinical bleeding phenotype with laboratory assays; subtype classification depends on multimer analysis and factor VIII levels."
