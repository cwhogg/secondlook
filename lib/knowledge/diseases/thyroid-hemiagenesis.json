  "keyFindings": {
    "laboratory": [
      "Normal or mildly altered thyroid function tests (TSH, free T4)",
      "Possible mild elevation of TSH in subclinical hypothyroidism"
    ],
    "imaging": [
      "Ultrasound showing absence of one thyroid lobe",
      "Radionuclide thyroid scintigraphy demonstrating absent uptake on affected side",
      "Compensatory hypertrophy of contralateral lobe"
    ],
    "genetic": [
      "No specific genetic mutations consistently identified",
      "Possible familial cases reported but genetic basis unclear"
    ],
    "other": [
      "Physical exam may reveal neck asymmetry or palpable unilateral thyroid enlargement"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "thyroid-agenesis",
      "distinguishingFeatures": [
        "Complete absence of thyroid gland rather than unilateral lobe absence",
        "Typically presents with congenital hypothyroidism"
      ]
    },
    {
      "diseaseId": "thyroid-lobectomy-post-surgical",
      "distinguishingFeatures": [
        "History of thyroid surgery",
        "Surgical scar and clinical history differentiate from congenital absence"
      ]
    },
    {
      "diseaseId": "thyroid-lobe-atrophy",
      "distinguishingFeatures": [
        "Presence of residual thyroid tissue on imaging",
        "Atrophy secondary to autoimmune thyroiditis or other causes"
      ]
    }
  ],
  "redFlags": [
    "Overt hypothyroidism symptoms (fatigue, weight gain, cold intolerance)",
    "Rapidly enlarging neck mass",
    "Signs of thyroid malignancy (hoarseness, cervical lymphadenopathy)"
  ],
