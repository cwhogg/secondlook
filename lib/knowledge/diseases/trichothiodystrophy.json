  "diagnosticCriteria": {
    "formalCriteriaName": "Trichothiodystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "sulfur-deficient-hair",
        "description": "Presence of sulfur-deficient brittle hair with characteristic 'tiger tail' banding under polarized light microscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "photosensitivity",
        "description": "Clinical photosensitivity with or without DNA repair defects",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-abnormalities",
        "description": "Neurological abnormalities including developmental delay, intellectual disability, or microcephaly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ichthyosis",
        "description": "Presence of ichthyosis or other skin abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with TTD (e.g., ERCC2, ERCC3, GTF2H5)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of sulfur-deficient brittle hair with characteristic tiger tail banding plus at least one major or two minor clinical features or genetic confirmation",
    "notes": "Diagnosis is supported by hair microscopy and genetic testing; photosensitivity is variable among patients."
  },
