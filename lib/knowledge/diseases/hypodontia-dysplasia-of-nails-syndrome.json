  "diagnosticCriteria": {
    "formalCriteriaName": "Hypodontia-Dysplasia of Nails Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypodontia",
        "description": "Congenital absence of one or more permanent teeth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nail-dysplasia",
        "description": "Dystrophic, thin, or brittle fingernails and toenails",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Mild facial dysmorphic features including midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both hypodontia and nail dysplasia is required; supportive features such as facial dysmorphism or family history strengthen diagnosis.",
    "notes": "Genetic testing may assist but is not mandatory for diagnosis."
  },
