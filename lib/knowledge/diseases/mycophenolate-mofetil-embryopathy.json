  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed diagnostic criteria for mycophenolate mofetil embryopathy",
    "criteria": [
      {
        "id": "prenatal-exposure",
        "description": "Confirmed in utero exposure to mycophenolate mofetil during the first trimester",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facial-features",
        "description": "Presence of characteristic facial dysmorphisms including hypertelorism, microtia, and cleft lip/palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-malformations",
        "description": "Presence of congenital malformations such as congenital heart defects, esophageal atresia, or digital anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of alternative genetic or environmental causes for the observed anomalies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed prenatal exposure plus presence of at least two major criteria including characteristic facial features and congenital malformations",
    "notes": "Diagnosis is clinical and based on history of exposure combined with characteristic phenotype; genetic testing may be used to exclude other syndromes."
  },
