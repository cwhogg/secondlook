  "keyFindings": {
    "laboratory": [
      "Elevated neuron-specific enolase (NSE) in some cases"
    ],
    "imaging": [
      "MRI showing mass in superior nasal cavity/olfactory cleft with possible intracranial extension",
      "CT scan revealing bone erosion of cribriform plate"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology showing small round blue cells with neurofibrillary background",
      "Immunohistochemistry positive for synaptophysin, chromogranin, and NSE"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "nasopharyngeal-carcinoma",
