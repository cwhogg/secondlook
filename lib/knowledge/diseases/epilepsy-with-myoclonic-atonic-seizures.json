      "Video-EEG monitoring useful for seizure characterization"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "juvenile-myoclonic-epilepsy",
      "distinguishingFeatures": [
        "Onset in adolescence rather than early childhood",
        "Predominantly myoclonic seizures without atonic component",
        "Different EEG pattern with 4-6 Hz polyspike-and-wave"
      ]
    },
    {
      "diseaseId": "dravet-syndrome",
      "distinguishingFeatures": [
        "Severe developmental delay from infancy",
        "Febrile seizures evolving to multiple seizure types",
        "SCN1A gene mutations common"
      ]
    }
  ],
  "redFlags": [
    "Seizure onset before 1 year of age",
    "Progressive neurological deterioration",
    "Failure to respond to standard antiepileptic therapies"
  ],
