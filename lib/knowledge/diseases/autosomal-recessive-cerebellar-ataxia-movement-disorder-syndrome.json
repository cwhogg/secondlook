  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of acquired causes of ataxia (e.g., vitamin E deficiency, Wilson disease)"
    ],
    "imaging": [
      "MRI showing cerebellar atrophy predominantly affecting the vermis and hemispheres",
      "No significant supratentorial abnormalities"
    ],
    "genetic": [
      "VPS41 (causative)",
      "VPS13D (causative)",
      "Biallelic pathogenic variants in genes associated with autosomal recessive cerebellar ataxia and movement disorders (e.g., SYNE1, SACS)"
    ],
    "other": [
      "Electromyography may show evidence of peripheral neuropathy",
      "Neurophysiological studies may reveal cerebellar dysfunction"
    ]
  },
