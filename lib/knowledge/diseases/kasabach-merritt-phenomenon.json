  "diagnosticCriteria": {
    "formalCriteriaName": "Kasabach-Merritt Phenomenon Diagnostic Criteria",
    "criteria": [
      {
        "id": "vascular-tumor",
        "description": "Presence of a rapidly enlarging vascular tumor (typically kaposiform hemangioendothelioma or tufted angioma)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thrombocytopenia",
        "description": "Severe thrombocytopenia due to platelet trapping within the vascular tumor",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "consumptive-coagulopathy",
        "description": "Evidence of consumptive coagulopathy including hypofibrinogenemia and elevated D-dimers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-edema",
        "description": "Associated localized edema or swelling over the tumor site",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-confirmation",
        "description": "Imaging evidence of vascular tumor with characteristic features",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of a vascular tumor with thrombocytopenia and consumptive coagulopathy",
    "notes": "Diagnosis requires exclusion of other causes of thrombocytopenia and coagulopathy."
  },
