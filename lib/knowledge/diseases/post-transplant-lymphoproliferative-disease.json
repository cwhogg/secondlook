  "differentialDiagnoses": [
    {
      "diseaseId": "post-transplant-lymphoma",
      "distinguishingFeatures": [
        "More aggressive clinical course",
        "Often monoclonal lymphoid proliferation",
        "May lack EBV association"
      ]
    },
    {
      "diseaseId": "infectious-mononucleosis",
      "distinguishingFeatures": [
        "Self-limited course",
        "Positive heterophile antibody test",
        "No tissue lymphoproliferation"
      ]
    },
    {
      "diseaseId": "reactive-lymphadenopathy",
      "distinguishingFeatures": [
        "Polyclonal lymphoid proliferation",
        "No mass lesions or organ dysfunction",
        "Resolution without immunosuppression modification"
      ]
    }
  ],
