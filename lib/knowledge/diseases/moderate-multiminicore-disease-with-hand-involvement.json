  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate elevation)",
      "Normal or mildly elevated lactate dehydrogenase"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle involvement with fatty replacement",
      "Chest X-ray or CT showing restrictive lung changes"
    ],
    "genetic": [
      "RYR1 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography demonstrating myopathic motor unit potentials",
      "Muscle biopsy showing multiple small cores with loss of oxidative enzyme activity"
    ]
