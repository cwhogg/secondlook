  "diagnosticCriteria": {
    "formalCriteriaName": "Mitochondrial Respiratory Chain Complex IV Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Multisystemic symptoms including muscle weakness and neurological impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-assay",
        "description": "Reduced cytochrome c oxidase (Complex IV) activity in muscle biopsy or cultured fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Pathogenic variants identified in nuclear or mitochondrial genes encoding Complex IV subunits or assembly factors",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Brain MRI showing basal ganglia or brainstem abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "lactate-elevation",
        "description": "Elevated blood or CSF lactate levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multisystemic clinical features plus documented reduced Complex IV enzyme activity and/or pathogenic genetic variants",
    "notes": "Diagnosis requires integration of clinical, biochemical, and genetic data."
  },
