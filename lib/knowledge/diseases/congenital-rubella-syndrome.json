  "diagnosticCriteria": {
    "formalCriteriaName": "Centers for Disease Control and Prevention (CDC) CRS Diagnostic Criteria",
    "criteria": [
      {
        "id": "cardiac-defect",
        "description": "Presence of congenital heart defects such as patent ductus arteriosus or pulmonary artery stenosis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Sensorineural deafness confirmed by audiologic testing",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-anomalies",
        "description": "Ocular abnormalities including cataracts, glaucoma, or retinopathy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "microcephaly",
        "description": "Microcephaly detected at birth or shortly thereafter",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "purpura",
        "description": "Congenital thrombocytopenic purpura (blueberry muffin rash)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "laboratory-confirmation",
        "description": "Detection of rubella-specific IgM antibodies or viral RNA in infant serum or tissues",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Laboratory confirmation of rubella infection plus one major clinical criterion or two minor criteria",
    "notes": "Diagnosis relies on combination of clinical features and laboratory confirmation; some features may present later in infancy."
  },
