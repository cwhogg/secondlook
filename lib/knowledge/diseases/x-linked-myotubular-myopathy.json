  "orphanetId": "791",
  "prevalence": {
    "estimate": "1 in 50,000 to 1 in 100,000 male births",
    "range": "0.001% - 0.002%",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 12,
      "peak": 0
    },
    "sexPredilection": "male",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for X-linked Myotubular Myopathy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Severe generalized muscle weakness and hypotonia presenting in male neonates or infants",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing centrally placed nuclei in muscle fibers (centronuclear myopathy pattern)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in the MTM1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "respiratory-failure",
        "description": "Early respiratory insufficiency requiring ventilatory support",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus either muscle biopsy findings or genetic confirmation of MTM1 mutation",
    "notes": "Genetic testing is considered the gold standard for definitive diagnosis."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Severe neonatal hypotonia",
        "frequency": 0.95,
        "bodySystem": "musculoskeletal",
        "notes": "Profound muscle weakness apparent at birth",
        "searchTerms": [
          "very low muscle tone at birth",
          "severe floppy baby syndrome",
          "marked muscle weakness in newborn"
        ]
      },
      {
        "symptomName": "Centrally located nuclei in muscle fibers",
        "frequency": 0.9,
        "bodySystem": "musculoskeletal",
        "notes": "Observed on muscle biopsy, hallmark histopathological feature",
        "searchTerms": [
          "muscle cells with nuclei in center",
          "abnormal central muscle fiber nuclei",
          "muscle fibers showing central nuclei"
        ]
      },
      {
        "symptomName": "Respiratory failure requiring ventilatory support",
        "frequency": 0.85,
        "bodySystem": "respiratory",
        "notes": "Often necessitates mechanical ventilation in infancy",
        "searchTerms": [
          "breathing failure needing ventilator",
          "respiratory support required",
          "difficulty breathing requiring machines"
        ]
      }
    ],
    "common": [
      {
        "symptomName": "Facial weakness including poor suck and weak cry",
        "frequency": 0.8,
        "bodySystem": "musculoskeletal",
        "notes": "Contributes to feeding difficulties",
        "searchTerms": [
          "weak facial muscles",
          "poor sucking in baby",
          "weak cry in infant"
        ]
      },
      {
        "symptomName": "Hypoventilation",
        "frequency": 0.75,
        "bodySystem": "respiratory",
        "notes": "Due to respiratory muscle weakness"
      },
      {
        "symptomName": "Delayed motor milestones",
        "frequency": 0.7,
        "bodySystem": "musculoskeletal",
        "notes": "Severe motor impairment in infancy",
        "searchTerms": [
          "late crawling or walking",
          "delayed movement skills",
          "slow motor development"
        ]
      },
      {
        "symptomName": "Joint contractures",
        "frequency": 0.6,
        "bodySystem": "musculoskeletal",
        "notes": "Resulting from muscle weakness and immobility"
      },
      {
        "symptomName": "Hyporeflexia or absent deep tendon reflexes",
        "frequency": 0.55,
        "bodySystem": "neurological",
        "notes": "Reflects muscle weakness",
        "searchTerms": [
          "reduced or missing reflexes",
