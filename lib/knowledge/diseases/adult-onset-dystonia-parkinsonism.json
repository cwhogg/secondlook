  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for adult-onset dystonia-parkinsonism",
    "criteria": [
      {
        "id": "motor-symptoms",
        "description": "Presence of both dystonia and parkinsonism motor features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-onset",
        "description": "Onset of symptoms in adulthood (typically after age 20)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-secondary-causes",
        "description": "Exclusion of secondary causes such as drug-induced or structural brain lesions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-genetics",
        "description": "Identification of pathogenic mutations in known dystonia-parkinsonism genes (e.g., ATP1A3, PRKRA)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-levodopa",
        "description": "Variable or poor response to levodopa therapy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of adult-onset combined dystonia and parkinsonism motor features with exclusion of secondary causes",
    "notes": "Genetic testing and neuroimaging may support diagnosis but are not mandatory."
  },
