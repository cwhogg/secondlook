  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Intellectual Disability-Obesity-Prognathism-Eye and Skin Anomalies Syndrome",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of global developmental delay or intellectual disability confirmed by standardized cognitive testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "obesity",
        "description": "Early-onset obesity developing in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "prognathism",
        "description": "Mandibular prognathism evident on clinical examination or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "Presence of characteristic eye anomalies such as strabismus, nystagmus, or coloboma",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cutaneous-anomalies",
        "description": "Skin anomalies including hypopigmentation, café-au-lait spots, or other dyschromias",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (intellectual disability, obesity, and prognathism) plus at least one minor criterion (ocular or skin anomalies)",
    "notes": "Diagnosis is clinical; genetic testing may aid but no specific gene identified to date."
  },
