  "keyFindings": {
    "laboratory": [
      "Elevated serum lactate and pyruvate levels",
      "Muscle biopsy showing ragged-red fibers and COX-negative fibers"
    ],
    "imaging": [
      "MRI brain usually normal or nonspecific",
      "Muscle MRI may show selective muscle involvement"
    ],
    "genetic": [
      "POLG (causative)",
      "POLG2 (causative)",
      "SLC25A4 (causative)",
      "TWNK (causative)",
      "RRM2B (causative)",
      "Multiple mitochondrial DNA deletions detected by Southern blot or long-range PCR",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography showing myopathic changes",
      "Cardiac conduction studies revealing arrhythmias or heart block"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "myasthenia-gravis",
      "distinguishingFeatures": [
        "Fluctuating muscle weakness with fatigability",
        "Presence of acetylcholine receptor antibodies",
        "Improvement with acetylcholinesterase inhibitors"
      ]
    },
    {
      "diseaseId": "mitochondrial-myopathy-pearson-syndrome",
      "distinguishingFeatures": [
        "Onset in infancy or early childhood",
        "Presence of sideroblastic anemia",
        "More systemic involvement including pancreatic dysfunction"
      ]
    },
    {
      "diseaseId": "kearns-sayre-syndrome",
      "distinguishingFeatures": [
        "Onset before age 20",
        "Pigmentary retinopathy",
        "Cardiac conduction defects and cerebellar ataxia"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of ophthalmoplegia with respiratory failure",
    "Cardiac conduction abnormalities causing syncope",
    "Onset of symptoms in infancy or early childhood"
  ],
