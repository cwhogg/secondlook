  "keyFindings": {
    "laboratory": [
      "Elevated erythrocyte sedimentation rate (ESR)",
      "Elevated C-reactive protein (CRP)",
      "Normal or mildly elevated white blood cell count"
    ],
    "imaging": [
      "Hyperostosis and osteitis on X-ray or CT scan",
      "Bone scintigraphy showing increased uptake in affected sites",
      "MRI demonstrating bone marrow edema and osteitis"
    ],
    "genetic": [
      "No definitive genetic marker identified; possible association with HLA-B27 in some cases",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Negative bone cultures to exclude infection",
      "Skin biopsy consistent with pustulosis or acneiform lesions"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "chronic-recurrent-multifocal-osteomyelitis",
      "distinguishingFeatures": [
        "Absence of characteristic skin lesions seen in SAPHO",
        "Primarily pediatric onset",
        "More common involvement of long bones"
      ]
    },
    {
      "diseaseId": "psoriatic-arthritis",
      "distinguishingFeatures": [
        "Presence of typical psoriatic skin plaques",
        "Dactylitis and nail changes common",
        "Less frequent hyperostosis and osteitis"
      ]
    },
    {
      "diseaseId": "infectious-osteomyelitis",
      "distinguishingFeatures": [
        "Positive microbial cultures",
        "Systemic signs of infection",
        "Response to antibiotics"
      ]
    }
  ],
  "redFlags": [
