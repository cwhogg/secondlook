  "diagnosticCriteria": {
    "formalCriteriaName": "Fajgenbaum Diagnostic Criteria for iMCD (2017)",
    "criteria": [
      {
        "id": "cd-maj1",
        "description": "Histopathological lymph node features consistent with Castleman disease (hyaline-vascular, plasmacytic, or mixed type)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cd-maj2",
        "description": "Multicentric lymphadenopathy (>= 2 nodal stations for MCD)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cd-min1",
        "description": "Elevated CRP (>10 mg/L) or ESR (>15 mm/hr)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cd-min2",
        "description": "Anemia (Hb < 12.5 g/dL in men, < 11.5 in women)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cd-min3",
        "description": "Thrombocytopenia or thrombocytosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cd-min4",
        "description": "Hypoalbuminemia (< 3.5 g/dL)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cd-min5",
        "description": "Renal dysfunction (eGFR < 60) or proteinuria",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cd-min6",
        "description": "Polyclonal hypergammaglobulinemia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "For iMCD: Both major criteria (histopathology + multicentricity) plus >= 2 of 11 minor criteria (6 laboratory + 5 clinical) from the full Fajgenbaum criteria. HHV-8 and other mimicking disorders must be excluded.",
    "notes": "Three main forms: UCD (localized, usually curable by resection), HHV-8-associated MCD (HIV+ patients), and iMCD (IL-6 driven). TAFRO syndrome is a subtype of iMCD."
  },
