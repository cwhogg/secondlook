  "keyFindings": {
    "laboratory": [
      "Mild anemia with normocytic normochromic red cells",
      "Normal serum calcium and phosphate levels",
      "Normal alkaline phosphatase or mildly elevated"
    ],
    "imaging": [
      "Diffuse osteosclerosis on X-ray and CT scans",
      "Thickened cortical bone with narrowed medullary canals",
      "Absence of lytic lesions or periosteal reaction"
    ],
    "genetic": [
      "FAM20C (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Bone biopsy showing increased bone density with abnormal remodeling",
      "Exclusion of secondary causes such as metastatic cancer or metabolic bone disease"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "osteopetrosis",
      "distinguishingFeatures": [
        "More severe bone marrow failure",
        "Characteristic 'bone within bone' appearance on imaging",
        "Known genetic mutations in osteoclast function genes"
      ]
    },
    {
      "diseaseId": "metastatic-bone-disease",
      "distinguishingFeatures": [
        "Presence of primary malignancy",
        "Mixed lytic and sclerotic lesions",
        "Rapid progression and systemic symptoms"
      ]
    }
  ],
  "redFlags": [
    "Progressive neurological deficits due to cranial nerve compression",
    "Severe pathological fractures with minimal trauma",
    "Signs of bone marrow failure such as pancytopenia"
  ],
