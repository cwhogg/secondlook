  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Non-distal Duplication 10q Syndrome",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Identification of interstitial duplication involving the proximal or middle segment of chromosome 10q by chromosomal microarray or karyotyping",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facial-dysmorphisms",
        "description": "Presence of distinctive craniofacial features including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital malformations such as cardiac defects or musculoskeletal abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of 10q interstitial duplication plus presence of at least two major clinical features",
    "notes": "Diagnosis relies heavily on genetic testing combined with clinical phenotype."
  },
