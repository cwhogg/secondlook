  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and molecular criteria for Menke-Hennekam syndrome",
    "criteria": [
      {
        "id": "crebbp-mutation",
        "description": "Presence of pathogenic variants in the CREBBP gene distinct from Rubinstein-Taybi syndrome mutations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Moderate to severe intellectual disability with developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including microcephaly, short nose with anteverted nares, and thin upper lip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "feeding-difficulties",
        "description": "Early feeding difficulties including poor suck and swallowing dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Presence of skeletal anomalies such as scoliosis or joint contractures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic CREBBP variant plus presence of intellectual disability and characteristic facial dysmorphism",
    "notes": "Molecular genetic testing is essential to differentiate from Rubinstein-Taybi syndrome."
  },
