  "diagnosticCriteria": {
    "formalCriteriaName": "Morquio Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of N-acetylgalactosamine-6-sulfatase or beta-galactosidase enzyme activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic skeletal dysplasia including short-trunk dwarfism and odontoid hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-glycosaminoglycans",
        "description": "Elevated keratan sulfate levels in urine",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of relevant enzyme activity plus characteristic clinical skeletal features",
    "notes": "Genetic testing can confirm mutations in GALNS or GLB1 genes."
  },
