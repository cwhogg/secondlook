  "keyFindings": {
    "laboratory": [
      "Skin biopsy showing fragmented or decreased elastic fibers with special stains (e.g., Verhoeff-Van Gieson)",
      "Genetic testing identifying mutations in ELN, FBLN5, ATP6V0A2, or other related genes"
    ],
    "imaging": [
      "Chest X-ray or CT showing pulmonary emphysema",
      "Echocardiogram demonstrating arterial tortuosity, aneurysms, or valvular abnormalities",
      "Abdominal ultrasound for hernias"
    ],
    "genetic": [
      "Mutations in ELN (elastin gene)",
      "Mutations in FBLN5 (fibulin-5 gene)",
      "Mutations in ATP6V0A2 (vacuolar ATPase gene)"
    ],
    "other": [
      "Clinical observation of characteristic skin laxity",
      "Family history consistent with inheritance pattern"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Hyperextensible skin with normal elasticity",
        "Joint hypermobility more prominent",
        "Absence of fragmented elastic fibers on biopsy"
      ]
    },
    {
      "diseaseId": "marfan-syndrome",
      "distinguishingFeatures": [
        "Tall stature with arachnodactyly",
        "Lens dislocation and aortic root dilation",
        "No loose, inelastic skin"
      ]
    },
    {
      "diseaseId": "pseudoxanthoma-elasticum",
      "distinguishingFeatures": [
        "Yellowish papules and plaques with calcified elastic fibers",
        "Ophthalmological angioid streaks",
        "Different genetic mutations (ABCC6 gene)"
      ]
    }
  ],
  "redFlags": [
    "Progressive respiratory distress due to emphysema",
    "Aortic aneurysm or arterial rupture",
    "Severe hernias causing obstruction or incarceration"
  ],
