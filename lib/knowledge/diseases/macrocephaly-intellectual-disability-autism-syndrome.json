  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild metabolic abnormalities in some cases"
    ],
    "imaging": [
      "Brain MRI may show mild ventriculomegaly or white matter abnormalities",
      "No consistent structural brain malformations"
    ],
    "genetic": [
      "PTEN (causative)",
      "HEPACAM (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Standardized neuropsychological testing confirming intellectual disability and autism spectrum disorder"
    ]
  },
