  "diagnosticCriteria": {
    "formalCriteriaName": "Dislocation of the Hip-Dysmorphism Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "congenital-hip-dislocation",
        "description": "Presence of congenital dislocation or subluxation of the hip joint confirmed by clinical and imaging studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-dysmorphism",
        "description": "Characteristic skeletal dysmorphic features including abnormal pelvic morphology and femoral head deformities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-abnormalities",
        "description": "Radiographic evidence of hip joint dysplasia and associated bone malformations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of hip dysplasia or related skeletal anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild motor developmental delay related to musculoskeletal abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital hip dislocation plus characteristic skeletal dysmorphism and radiographic abnormalities",
    "notes": "Diagnosis is primarily clinical supported by imaging; genetic testing may assist but is not definitive."
  },
