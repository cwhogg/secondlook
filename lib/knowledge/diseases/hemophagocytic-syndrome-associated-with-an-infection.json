  "diagnosticCriteria": {
    "formalCriteriaName": "HLH-2004 Diagnostic Criteria",
    "criteria": [
      {
        "id": "fever",
        "description": "Fever ≥38.5°C lasting ≥7 days",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cytopenia",
        "description": "Cytopenia affecting ≥2 of 3 lineages in peripheral blood (hemoglobin <9 g/dL, platelets <100,000/mm³, neutrophils <1,000/mm³)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemophagocytosis",
        "description": "Hemophagocytosis in bone marrow, spleen, or lymph nodes without evidence of malignancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyperferritinemia",
        "description": "Elevated serum ferritin >500 ng/mL",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypertriglyceridemia",
        "description": "Fasting triglycerides ≥265 mg/dL or hypofibrinogenemia ≤150 mg/dL",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "lowNKactivity",
        "description": "Decreased or absent natural killer (NK) cell activity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "At least 5 of 8 HLH-2004 criteria including fever, cytopenia, and hemophagocytosis",
    "notes": "Diagnosis requires exclusion of malignancy and other causes of systemic inflammation"
  },
