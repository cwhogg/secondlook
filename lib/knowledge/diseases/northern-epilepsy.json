  "diagnosticCriteria": {
    "formalCriteriaName": "Northern Epilepsy Diagnostic Criteria",
    "criteria": [
      {
        "id": "febrile-seizures",
        "description": "History of recurrent febrile seizures beginning in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "generalized-tonic-clonic",
        "description": "Presence of generalized tonic-clonic seizures without focal onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of epilepsy consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-neuroimaging",
        "description": "Normal brain MRI findings excluding structural causes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent febrile seizures and generalized tonic-clonic seizures with or without positive family history",
    "notes": "Diagnosis is clinical and supported by exclusion of other epilepsy syndromes"
