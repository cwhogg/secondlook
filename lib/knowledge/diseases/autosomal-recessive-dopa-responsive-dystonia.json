  "keyFindings": {
    "laboratory": [
      "Low cerebrospinal fluid homovanillic acid (HVA) and 5-hydroxyindoleacetic acid (5-HIAA) levels",
      "Normal routine blood tests"
    ],
    "imaging": [
      "Normal brain MRI or nonspecific mild cerebral atrophy"
    ],
    "genetic": [
      "TH (causative)",
      "TSPOAP1 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Dramatic clinical improvement with low-dose levodopa challenge"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autosomal-dominant-dopa-responsive-dystonia",
      "distinguishingFeatures": [
        "Autosomal dominant inheritance pattern",
        "Later onset in some cases",
        "Typically heterozygous GCH1 mutations"
      ]
    },
    {
      "diseaseId": "juvenile-parkinsonism",
      "distinguishingFeatures": [
        "Presence of resting tremor",
        "Poor or variable response to levodopa",
        "Additional parkinsonian features such as rigidity and bradykinesia"
      ]
    },
    {
      "diseaseId": "segawa-disease",
      "distinguishingFeatures": [
        "Usually autosomal dominant inheritance",
        "Similar levodopa responsiveness",
        "Different genetic mutations (GCH1 heterozygous)"
      ]
    }
  ],
  "redFlags": [
    "Lack of response to levodopa therapy",
    "Rapid progression of dystonia with additional neurological deficits",
    "Presence of seizures or significant cognitive decline"
  ],
