  "diagnosticCriteria": {
    "formalCriteriaName": "Menkes Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Characteristic neurodegeneration with developmental delay and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hair-abnormalities",
        "description": "Kinky, brittle, depigmented hair with pili torti on microscopic examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-copper-deficiency",
        "description": "Low serum copper and ceruloplasmin levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic ATP7A gene mutation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-findings",
        "description": "Brain MRI showing cerebral and cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical presentation plus low serum copper and ceruloplasmin or identification of ATP7A mutation",
    "notes": "Genetic testing is confirmatory; early diagnosis critical for treatment initiation"
  },
