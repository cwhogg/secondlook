  "diagnosticCriteria": {
    "formalCriteriaName": "LBSL Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Progressive spasticity, ataxia, and peripheral neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Characteristic MRI findings showing leukoencephalopathy with involvement of brainstem and spinal cord tracts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lactate-elevation",
        "description": "Elevated lactate levels in brain MR spectroscopy or cerebrospinal fluid",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Pathogenic mutations in the DARS2 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of clinical features plus characteristic MRI findings and confirmation by genetic testing",
    "notes": "Lactate elevation supports diagnosis but is not mandatory."
  },
