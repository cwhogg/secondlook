  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and radiological diagnostic criteria for Progressive pseudorheumatoid dysplasia",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Onset of progressive joint stiffness and enlargement without systemic inflammation in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-findings",
        "description": "Radiographic evidence of platyspondyly, epiphyseal and metaphyseal abnormalities, and absence of erosions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the WISP3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-inflammatory-markers",
        "description": "Normal inflammatory markers (ESR, CRP) despite joint symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus radiological findings and confirmation by genetic testing or exclusion of inflammatory arthritis",
    "notes": "Diagnosis is often delayed due to similarity with juvenile idiopathic arthritis but absence of inflammation and genetic testing aid differentiation."
  },
