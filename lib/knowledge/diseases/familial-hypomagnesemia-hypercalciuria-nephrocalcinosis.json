  "diagnosticCriteria": {
    "formalCriteriaName": "FHHNC Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypomagnesemia",
        "description": "Persistent hypomagnesemia with renal magnesium wasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypercalciuria",
        "description": "Elevated urinary calcium excretion (hypercalciuria)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nephrocalcinosis",
        "description": "Bilateral nephrocalcinosis detected by renal ultrasound or CT",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in CLDN16 or CLDN19 genes",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent hypomagnesemia, hypercalciuria, and nephrocalcinosis",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical criteria are met."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Persistent hypomagnesemia",
        "frequency": 0.95,
        "bodySystem": "endocrine",
        "notes": "Due to renal magnesium wasting"
      },
      {
        "symptomName": "Hypercalciuria",
        "frequency": 0.9,
        "bodySystem": "renal",
        "notes": "Elevated urinary calcium excretion"
      },
      {
        "symptomName": "Nephrocalcinosis",
        "frequency": 0.85,
        "bodySystem": "renal",
        "notes": "Calcium deposition in renal parenchyma"
      }
    ],
    "common": [
      {
        "symptomName": "Recurrent nephrolithiasis (kidney stones)",
        "frequency": 0.75,
        "bodySystem": "renal",
        "notes": "Often calcium-based stones",
        "searchTerms": [
          "repeated kidney stones",
          "frequent urinary stones",
          "kidney stone recurrences"
        ]
      },
      {
        "symptomName": "Polyuria",
        "frequency": 0.7,
        "bodySystem": "renal",
        "notes": "Due to impaired renal concentrating ability"
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.65,
        "bodySystem": "constitutional",
        "notes": "Secondary to electrolyte imbalance"
      },
      {
        "symptomName": "Muscle cramps",
        "frequency": 0.6,
        "bodySystem": "musculoskeletal",
        "notes": "Related to hypomagnesemia"
      },
      {
        "symptomName": "Growth retardation",
        "frequency": 0.55,
        "bodySystem": "constitutional",
        "notes": "In pediatric patients"
      }
    ],
    "occasional": [
      {
        "symptomName": "Nephrogenic diabetes insipidus",
        "frequency": 0.4,
        "bodySystem": "renal",
        "notes": "Impaired renal response to ADH",
        "searchTerms": [
          "kidney-related diabetes insipidus",
          "excessive urination due to kidney issue",
          "nephrogenic water imbalance"
        ]
      },
      {
        "symptomName": "Mild hypokalemia",
        "frequency": 0.35,
        "bodySystem": "endocrine",
        "notes": "Due to renal electrolyte loss"
      },
      {
        "symptomName": "Mild metabolic alkalosis",
        "frequency": 0.3,
        "bodySystem": "endocrine",
        "notes": "Secondary to tubular dysfunction",
        "searchTerms": [
          "mildly increased blood alkalinity",
          "slight metabolic alkalosis",
          "mild acid-base imbalance"
        ]
      },
      {
        "symptomName": "Polyhydramnios (in neonates)",
        "frequency": 0.2,
        "bodySystem": "renal",
        "notes": "Reported in some cases",
        "searchTerms": [
          "excess amniotic fluid in newborns",
          "too much fluid around baby",
          "polyhydramnios in infants"
        ]
      },
      {
        "symptomName": "Ocular abnormalities",
        "frequency": 0.15,
        "bodySystem": "ophthalmological",
        "notes": "More common in CLDN19 mutations",
        "searchTerms": [
          "eye problems",
          "vision abnormalities",
