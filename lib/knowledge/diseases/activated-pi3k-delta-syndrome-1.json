  "keyFindings": {
    "laboratory": [
      "Hypogammaglobulinemia with low IgG and IgA",
      "Elevated serum IgM",
      "Lymphopenia with decreased CD4+ and CD8+ T cells",
      "Autoimmune cytopenias on blood smear"
    ],
    "imaging": [
      "Chest CT showing bronchiectasis",
      "Lymph node enlargement on ultrasound or CT",
      "Splenomegaly on abdominal ultrasound"
    ],
    "genetic": [
      "PIK3CD (causative, gain-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Flow cytometry showing abnormal B and T cell subsets",
      "Elevated serum IgE in some cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "common-variable-immunodeficiency",
      "distinguishingFeatures": [
        "Lack of PIK3CD mutation",
        "Later onset of symptoms",
        "More variable immunoglobulin abnormalities"
      ]
    },
    {
      "diseaseId": "activated-pi3k-delta-syndrome-2",
      "distinguishingFeatures": [
        "Mutation in PIK3R1 gene instead of PIK3CD",
        "Similar clinical features but distinct genetic cause"
      ]
    },
    {
      "diseaseId": "hyper-igm-syndrome",
      "distinguishingFeatures": [
        "Different genetic mutations (e.g., CD40L deficiency)",
        "Predominant elevated IgM with absent IgG and IgA",
        "Distinct inheritance patterns"
      ]
    }
  ],
