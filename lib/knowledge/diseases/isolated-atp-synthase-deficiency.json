  "diagnosticCriteria": {
    "formalCriteriaName": "Mitochondrial Disease Diagnostic Criteria (MDC)",
    "criteria": [
      {
        "id": "biochemical-deficiency",
        "description": "Demonstration of isolated deficiency of ATP synthase enzyme activity in muscle or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in nuclear or mitochondrial genes encoding ATP synthase subunits or assembly factors",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical features consistent with mitochondrial energy deficiency including neurodevelopmental delay and lactic acidosis",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of isolated ATP synthase enzyme deficiency plus pathogenic genetic variant and compatible clinical phenotype",
    "notes": "Muscle biopsy and enzymatic assays are critical for diagnosis; genetic testing confirms etiology."
  },
