  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for CMT2J",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Progressive distal muscle weakness and atrophy predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies showing axonal neuropathy with normal or mildly reduced conduction velocities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the MPZ gene associated with CMT2J",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-sensory-loss",
        "description": "Distal sensory loss and diminished proprioception",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal muscle weakness with electrophysiological evidence of axonal neuropathy and identification of pathogenic MPZ mutation",
    "notes": "Genetic confirmation is essential for definitive diagnosis; clinical presentation can overlap with other CMT subtypes."
  },
