  "diagnosticCriteria": {
    "formalCriteriaName": "Char Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "pda",
        "description": "Presence of patent ductus arteriosus confirmed by echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including flat midface, short nose with broad tip, and prominent philtrum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hand-anomalies",
        "description": "Shortened middle phalanges of the fifth fingers (brachydactyly)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern or positive family history",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of patent ductus arteriosus plus characteristic facial dysmorphism and hand anomalies",
    "notes": "Genetic testing for TFAP2B mutations can support diagnosis but is not mandatory."
  },
