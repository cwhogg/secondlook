  "diagnosticCriteria": {
    "formalCriteriaName": "ESID Diagnostic Criteria for SCID",
    "criteria": [
      {
        "id": "lymphopenia",
        "description": "Profound T-cell lymphopenia with normal or elevated B-cell counts (T-B+ phenotype)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "il7r-mutation",
        "description": "Identification of pathogenic mutations in the IL7R gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-t-cell-function",
        "description": "Absent or severely reduced T-cell proliferative response to mitogens",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Early onset of severe, recurrent infections including opportunistic infections",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of T-cell lymphopenia with normal B-cell numbers, confirmed pathogenic IL7R mutation, and impaired T-cell function",
    "notes": "Genetic confirmation is critical for definitive diagnosis; newborn screening may detect T-cell lymphopenia early."
  },
