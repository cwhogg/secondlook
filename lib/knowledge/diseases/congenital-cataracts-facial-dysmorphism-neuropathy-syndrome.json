  "diagnosticCriteria": {
    "formalCriteriaName": "Congenital Cataracts-Facial Dysmorphism-Neuropathy Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "congenital-cataracts",
        "description": "Presence of bilateral congenital cataracts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including micrognathia, prominent nasal bridge, and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peripheral-neuropathy",
        "description": "Progressive distal sensorimotor neuropathy with muscle weakness and atrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypogonadism",
        "description": "Hypogonadism or delayed puberty",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: congenital cataracts, facial dysmorphism, and peripheral neuropathy",
    "notes": "Diagnosis is clinical and supported by genetic testing for CTDP1 gene mutations"
  },
