  "keyFindings": {
    "laboratory": [
      "Coagulation studies may show Factor XI deficiency or partial thromboplastin time prolongation",
      "Platelet function studies may be abnormal",
      "Growth hormone levels usually normal (GH insensitivity in some)",
      "IGF-1 may be low despite normal GH"
    ],
    "imaging": [
      "Echocardiography showing pulmonary valve stenosis or hypertrophic cardiomyopathy",
      "Renal ultrasound for structural anomalies",
      "Skeletal radiographs may show pectus deformity, scoliosis"
    ],
    "genetic": [
      "RRAS (candidate)",
      "MRAS (causative)",
      "SPRED2 (causative)",
      "RRAS2 (causative)",
      "PTPN11 (causative)",
      "CBL (causative)",
      "SOS1 (causative, gain-of-function)",
      "KRAS (causative)",
      "RAF1 (causative, gain-of-function)",
      "NRAS (causative)",
      "RIT1 (causative, gain-of-function)",
      "LZTR1 (causative)",
      "RASA2 (causative, loss-of-function)",
      "SOS2 (causative)",
      "BRAF (causative)",
      "Autosomal dominant inheritance; ~50-70% de novo",
      "Autosomal recessive inheritance"
    ],
    "other": [
