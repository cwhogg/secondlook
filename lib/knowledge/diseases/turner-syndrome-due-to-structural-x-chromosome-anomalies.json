  "diagnosticCriteria": {
    "formalCriteriaName": "Turner Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "chromosomal-abnormality",
        "description": "Presence of structural abnormalities of the X chromosome confirmed by karyotype or molecular cytogenetics",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Height below the 5th percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gonadal-dysgenesis",
        "description": "Hypergonadotropic hypogonadism with streak ovaries or ovarian failure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiovascular-anomalies",
        "description": "Presence of congenital heart defects such as bicuspid aortic valve or coarctation of the aorta",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "lymphedema",
        "description": "Neonatal or persistent lymphedema of hands and feet",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed structural X chromosome abnormality plus at least two major clinical features including short stature and gonadal dysgenesis",
    "notes": "Diagnosis is primarily confirmed by cytogenetic analysis; clinical features support diagnosis and management."
  },
