      ]
    },
    {
      "diseaseId": "familial-exudative-vitreo-retinopathy",
      "distinguishingFeatures": [
        "Variable inheritance pattern",
        "Retinal vascular abnormalities without congenital blindness",
        "No progressive hearing loss"
      ]
    },
    {
