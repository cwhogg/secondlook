  "keyFindings": {
    "laboratory": [
      "Elevated serum triglycerides may be normal or mildly elevated",
      "Normal or mildly elevated cardiac biomarkers (troponin, BNP)"
    ],
    "imaging": [
      "Cardiac MRI showing diffuse myocardial fatty infiltration and fibrosis",
      "Echocardiography demonstrating diastolic dysfunction with preserved ejection fraction",
      "CT scan revealing myocardial fat deposits"
    ],
    "genetic": [
      "PNPLA2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathological confirmation of triglyceride accumulation in myocardial biopsy",
      "Electrocardiogram abnormalities including ventricular arrhythmias"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "fabry-disease",
      "distinguishingFeatures": [
        "Alpha-galactosidase A deficiency",
        "Presence of angiokeratomas and corneal verticillata",
        "Multisystem involvement including renal and neurological"
      ]
    },
    {
      "diseaseId": "arrhythmogenic-right-ventricular-cardiomyopathy",
      "distinguishingFeatures": [
        "Fibrofatty replacement predominantly in right ventricle",
        "Characteristic epsilon waves on ECG",
        "Familial inheritance with desmosomal gene mutations"
      ]
    }
  ],
