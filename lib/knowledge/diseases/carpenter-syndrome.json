  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild elevation of liver enzymes in obesity"
    ],
    "imaging": [
      "Skull X-ray or CT showing premature craniosynostosis",
      "Echocardiogram revealing congenital heart defects",
      "MRI brain may show hydrocephalus or other anomalies"
    ],
    "genetic": [
      "MEGF8 (causative)",
      "RAB23 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Physical examination revealing polysyndactyly and craniofacial abnormalities"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "acrocephalopolysyndactyly-type-i",
      "distinguishingFeatures": [
        "Different pattern of craniosynostosis",
        "Distinct genetic cause (FGFR2 mutations)",
        "More severe intellectual disability"
      ]
    },
    {
      "diseaseId": "pfeiffer-syndrome",
      "distinguishingFeatures": [
        "Cloverleaf skull deformity",
        "Broad thumbs and big toes without polysyndactyly",
        "FGFR1 or FGFR2 mutations"
      ]
    }
  ],
  "redFlags": [
    "Severe craniosynostosis causing increased intracranial pressure",
