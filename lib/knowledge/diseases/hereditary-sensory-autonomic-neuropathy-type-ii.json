  "keyFindings": {
    "laboratory": [
      "Reduced or absent sweat response on quantitative sudomotor axon reflex test (QSART)",
      "Normal routine blood tests"
    ],
    "imaging": [
      "MRI may show secondary joint destruction in advanced neuropathic arthropathy"
    ],
    "genetic": [
      "Pathogenic mutations in WNK1/HSN2 gene",
      "Other implicated genes include FAM134B"
    ],
    "other": [
      "Nerve biopsy showing loss of small myelinated and unmyelinated fibers",
      "Electrophysiological studies showing absent or reduced sensory nerve action potentials"
    ]
  },
