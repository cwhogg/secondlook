  "diagnosticCriteria": {
    "formalCriteriaName": "DRPLA Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of expanded CAG trinucleotide repeat in the ATN1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Progressive cerebellar ataxia, choreoathetosis, and dementia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of ATN1 CAG repeat expansion plus presence of progressive neurological symptoms including cerebellar ataxia and choreoathetosis",
    "notes": "Diagnosis is confirmed by molecular genetic testing; clinical features vary with age of onset."
  },
