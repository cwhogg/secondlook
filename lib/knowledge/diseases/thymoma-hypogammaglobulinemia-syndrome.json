  "keyFindings": {
    "laboratory": [
      "Low serum immunoglobulin levels (IgG, IgA, IgM)",
      "Reduced or absent peripheral B cells",
      "Lymphopenia with impaired T cell function",
      "Positive acetylcholine receptor antibodies if myasthenia gravis present"
    ],
    "imaging": [
      "Chest CT showing anterior mediastinal mass consistent with thymoma"
    ],
    "genetic": [
      "No specific genetic mutation identified; considered acquired immunodeficiency"
    ],
    "other": [
      "Histopathological confirmation of thymoma",
      "Immunophenotyping showing combined B and T cell immunodeficiency"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "common-variable-immunodeficiency",
      "distinguishingFeatures": [
        "Absence of thymoma",
        "Variable age of onset",
        "Predominantly B cell defects without thymic tumor"
      ]
    },
    {
      "diseaseId": "myasthenia-gravis",
      "distinguishingFeatures": [
        "Presence of muscle weakness without hypogammaglobulinemia",
        "May have thymoma but no immunodeficiency",
        "Normal immunoglobulin levels"
      ]
    },
    {
      "diseaseId": "secondary-immunodeficiency",
      "distinguishingFeatures": [
        "History of immunosuppressive therapy or HIV infection",
        "No thymoma",
        "Reversible immunodeficiency upon treatment"
      ]
    }
  ],
  "redFlags": [
