  "diagnosticCriteria": {
    "formalCriteriaName": "Potocki-Shaffer syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "multiple-exostoses",
        "description": "Presence of multiple osteochondromas (exostoses) primarily affecting long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biparietal-foramina",
        "description": "Bilateral biparietal foramina identified on skull imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including hypertelorism and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Deletion involving 11p11.2-p12 region detected by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of multiple exostoses, biparietal foramina on imaging, developmental delay, and confirmation of 11p11.2-p12 deletion",
    "notes": "Diagnosis is confirmed by genetic testing identifying deletion in the EXT2 and ALX4 gene region."
  },
