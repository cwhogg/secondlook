  "diagnosticCriteria": {
    "formalCriteriaName": "Legg-Calvé-Perthes Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "radiographic-evidence",
        "description": "Radiographic evidence of idiopathic avascular necrosis of the femoral head",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Insidious onset of limp with limited hip range of motion, especially abduction and internal rotation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of hip pathology such as infection, trauma, or neoplasm",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-of-onset",
        "description": "Typical onset between ages 2 and 12 years",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-systemic-symptoms",
        "description": "Lack of systemic symptoms such as fever or elevated inflammatory markers",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of radiographic evidence of femoral head avascular necrosis plus clinical presentation of limp and limited hip motion, with exclusion of other causes",
    "notes": "Diagnosis is primarily clinical and radiological; MRI may be used for early detection."
  },
