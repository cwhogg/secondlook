  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Mulibrey Nanism",
    "criteria": [
      {
        "id": "growth-retardation",
        "description": "Severe pre- and postnatal growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facies",
        "description": "Typical craniofacial features including triangular face, broad forehead, and high nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pericardial-constriction",
        "description": "Constrictive pericarditis or pericardial fibrosis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "musculoskeletal-abnormalities",
        "description": "Muscle hypoplasia and slender long bones",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-abnormalities",
        "description": "Retinal abnormalities including retinal pigment epithelium changes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hepatic-involvement",
        "description": "Hepatomegaly or liver fibrosis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe growth retardation and characteristic craniofacial features plus at least one major or two minor criteria",
    "notes": "Genetic testing for TRIM37 mutations can confirm diagnosis"
  },
