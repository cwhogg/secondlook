  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiographic Diagnostic Criteria for Fibular Hemimelia",
    "criteria": [
      {
        "id": "fibular-absence",
        "description": "Partial or complete absence of the fibula confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tibial-fibular-length-discrepancy",
        "description": "Tibial shortening or bowing associated with fibular deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "foot-malformations",
        "description": "Presence of foot deformities such as absence of lateral rays or tarsal coalition",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-femur",
        "description": "Normal femoral development without associated femoral deficiencies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of partial or complete fibular absence with tibial deformity confirmed by imaging",
    "notes": "Diagnosis is primarily clinical and radiographic; genetic testing is not routinely required."
  },
