  "diagnosticCriteria": {
    "formalCriteriaName": "Factor XIII Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-bleeding",
        "description": "Presence of spontaneous or prolonged bleeding episodes including umbilical stump bleeding",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clot-solubility-test",
        "description": "Positive clot solubility test indicating unstable fibrin clot",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "factor-xiii-activity-assay",
        "description": "Reduced or absent Factor XIII activity on quantitative assay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in F13A1 or F13B genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical bleeding plus either positive clot solubility test or reduced Factor XIII activity assay",
    "notes": "Genetic testing supports diagnosis but is not mandatory"
  },
