  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for NORSE",
    "criteria": [
      {
        "id": "status-epilepticus-duration",
        "description": "Continuous or recurrent seizures lasting more than 30 minutes despite initial treatment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "new-onset-seizures",
        "description": "No prior history of epilepsy or seizures before current episode",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "refractory-to-treatment",
        "description": "Failure to respond to first- and second-line antiepileptic drugs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of acute structural, toxic, metabolic, or infectious causes explaining status epilepticus",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-acute-lesions",
        "description": "No acute lesions on neuroimaging that explain seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of new-onset status epilepticus refractory to treatment lasting >30 minutes with no prior epilepsy history and exclusion of other causes",
    "notes": "Diagnosis requires multidisciplinary evaluation including neurologic, infectious, and autoimmune workup."
  },
