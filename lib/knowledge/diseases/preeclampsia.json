  "diagnosticCriteria": {
    "formalCriteriaName": "American College of Obstetricians and Gynecologists (ACOG) 2019 Criteria",
    "criteria": [
      {
        "id": "hypertension",
        "description": "Systolic blood pressure ≥140 mmHg or diastolic blood pressure ≥90 mmHg on two occasions at least 4 hours apart after 20 weeks of gestation in a previously normotensive woman",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "proteinuria",
        "description": "Proteinuria ≥300 mg per 24-hour urine collection or protein/creatinine ratio ≥0.3, or dipstick reading of 1+ if other methods not available",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe_features",
        "description": "Presence of severe features such as thrombocytopenia (<100,000/µL), impaired liver function, renal insufficiency, pulmonary edema, or new-onset cerebral or visual disturbances",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Hypertension after 20 weeks gestation plus either proteinuria or presence of severe features",
    "notes": "Diagnosis requires exclusion of other hypertensive disorders of pregnancy"
  },
