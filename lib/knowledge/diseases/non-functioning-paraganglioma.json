  "keyFindings": {
    "laboratory": [
      "Normal plasma and urinary catecholamines and metanephrines",
      "Normal chromogranin A levels"
    ],
    "imaging": [
      "Well-circumscribed mass on MRI with characteristic 'salt and pepper' appearance on T2-weighted images",
      "CT scan showing hypervascular mass in typical paraganglionic locations"
    ],
    "genetic": [
      "Possible germline mutations in SDHB, SDHC, SDHD genes"
    ],
    "other": [
      "Histopathology showing Zellballen pattern with sustentacular cells",
      "Immunohistochemistry positive for chromogranin, synaptophysin, and S100 in sustentacular cells"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "functioning-paraganglioma",
      "distinguishingFeatures": [
        "Elevated catecholamines and metanephrines",
        "Symptoms of catecholamine excess such as episodic hypertension, palpitations, sweating"
      ]
    },
    {
      "diseaseId": "carotid-body-tumor",
      "distinguishingFeatures": [
        "Typically located at carotid bifurcation",
        "May be functioning or non-functioning; biochemical testing required",
        "Characteristic splaying of carotid arteries on imaging"
      ]
    },
    {
      "diseaseId": "schwannoma",
      "distinguishingFeatures": [
        "Histology shows Antoni A and B areas",
        "Negative for chromogranin and synaptophysin",
        "Usually lacks hypervascularity on imaging"
      ]
    }
  ],
  "redFlags": [
    "Rapidly enlarging neck or abdominal mass",
    "New onset cranial nerve deficits",
    "Unexplained severe hypertension suggesting functional tumor"
  ],
