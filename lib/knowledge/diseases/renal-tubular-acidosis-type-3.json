  "keyFindings": {
    "laboratory": [
      "Hyperchloremic metabolic acidosis with normal anion gap",
      "Hypokalemia with renal potassium wasting",
      "Elevated urine bicarbonate excretion",
      "Inability to acidify urine (urine pH >5.5) despite systemic acidosis",
      "Normal or near-normal glomerular filtration rate"
    ],
    "imaging": [
      "Renal ultrasound showing nephrocalcinosis or nephrolithiasis",
      "Bone X-rays showing signs of osteomalacia or rickets in children"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Growth delay in pediatric patients",
      "Electrolyte disturbances including hypophosphatemia"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "renal-tubular-acidosis-type-1",
      "distinguishingFeatures": [
        "Isolated distal acidification defect without proximal bicarbonate wasting",
        "Urine pH persistently >5.5",
        "Usually normal bicarbonate reabsorption"
      ]
    },
    {
      "diseaseId": "renal-tubular-acidosis-type-2",
      "distinguishingFeatures": [
        "Isolated proximal bicarbonate wasting",
        "Urine acidification intact in distal tubule",
        "Urine pH can be <5.5 after acid load"
      ]
    },
    {
      "diseaseId": "fanconi-syndrome",
      "distinguishingFeatures": [
        "Generalized proximal tubular dysfunction with glucosuria, aminoaciduria, and phosphaturia",
        "More extensive tubular defects beyond acid-base handling"
      ]
    }
  ],
  "redFlags": [
    "Severe hypokalemia causing muscle paralysis or arrhythmias",
    "Failure to thrive or severe growth retardation in children",
    "Refractory metabolic acidosis despite treatment"
  ],
  "specialistType": [
    "Nephrologist",
