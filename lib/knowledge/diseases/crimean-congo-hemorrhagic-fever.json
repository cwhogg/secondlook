  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Case Definition for Crimean-Congo Hemorrhagic Fever",
    "criteria": [
      {
        "id": "fever",
        "description": "Sudden onset of high fever (>38.5°C)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemorrhagic-signs",
        "description": "Presence of hemorrhagic manifestations such as petechiae, ecchymoses, or bleeding from mucous membranes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epidemiological-exposure",
        "description": "History of tick bite or contact with livestock in endemic areas",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "laboratory-confirmation",
        "description": "Detection of CCHF virus RNA by RT-PCR or specific IgM antibodies",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Sudden high fever plus hemorrhagic signs and laboratory confirmation of CCHF virus",
    "notes": "Epidemiological exposure supports diagnosis but is not mandatory if laboratory confirmation is present."
  },
