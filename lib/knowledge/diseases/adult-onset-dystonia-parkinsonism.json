  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; exclusion of metabolic causes",
      "CSF analysis typically unremarkable"
    ],
    "imaging": [
      "MRI brain may show basal ganglia abnormalities or be normal",
      "DAT-SPECT imaging may show reduced dopamine transporter uptake"
    ],
    "genetic": [
      "PLA2G6 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Poor or variable response to levodopa therapy",
      "Electromyography may show dystonic muscle activity"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "idiopathic-parkinson-disease",
      "distinguishingFeatures": [
        "Typically lacks prominent dystonia early in disease",
        "Usually good levodopa response",
        "Older age at onset"
      ]
    },
    {
      "diseaseId": "drug-induced-parkinsonism",
      "distinguishingFeatures": [
        "History of dopamine antagonist exposure",
        "Symptoms often improve after drug withdrawal",
        "Absence of genetic mutations"
      ]
    },
    {
      "diseaseId": "dopa-responsive-dystonia",
      "distinguishingFeatures": [
        "Onset often in childhood or adolescence",
        "Marked improvement with low-dose levodopa",
        "Predominantly dystonia without parkinsonism"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression over weeks to months",
    "Early severe autonomic failure",
    "Poor or no response to dopaminergic therapy with atypical features"
