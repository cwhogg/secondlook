  "diagnosticCriteria": {
    "formalCriteriaName": "Hemoglobinopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "hbd-hemoglobin-electrophoresis",
        "description": "Detection of Hemoglobin D variant by hemoglobin electrophoresis or HPLC",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-hemolytic-anemia",
        "description": "Presence of mild to moderate hemolytic anemia symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of the Glu121Gln mutation in the beta-globin gene (HBB gene)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of hemoglobinopathy or Hb D trait",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of Hemoglobin D variant confirmed by electrophoresis or HPLC plus clinical evidence of hemolytic anemia and/or genetic confirmation of HBB mutation",
    "notes": "Diagnosis may be complicated by co-inheritance with other hemoglobinopathies such as Hb S or beta-thalassemia."
  },
