  "keyFindings": {
    "laboratory": [
      "Abnormal dihydrorhodamine (DHR) flow cytometry test",
      "Abnormal nitroblue tetrazolium (NBT) test",
      "Elevated inflammatory markers during infections"
    ],
    "imaging": [
      "Chest X-ray showing pneumonia or abscesses",
      "CT scan revealing granulomas in lungs or liver",
      "Bone imaging showing osteomyelitis"
    ],
    "genetic": [
      "Pathogenic mutations in CYBB (X-linked), NCF1, NCF2, or NCF4 genes"
    ],
    "other": [
      "Granuloma formation on histopathology",
      "Recurrent infections with catalase-positive organisms (e.g., Staphylococcus aureus, Serratia marcescens)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "severe-combined-immunodeficiency",
      "distinguishingFeatures": [
        "Profound T and B cell deficiency",
