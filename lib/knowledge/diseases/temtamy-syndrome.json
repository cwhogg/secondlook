  "diagnosticCriteria": {
    "formalCriteriaName": "Temtamy Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Congenital microcephaly with developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial anomalies including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-anomalies",
        "description": "Postaxial polydactyly and camptodactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Moderate to severe intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural hearing loss",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: congenital microcephaly with developmental delay, characteristic craniofacial dysmorphism, and limb anomalies including postaxial polydactyly",
    "notes": "Genetic testing for mutations in the TMEM216 gene can confirm diagnosis."
  },
