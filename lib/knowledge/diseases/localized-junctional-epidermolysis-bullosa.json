  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers during secondary infection",
      "Mild anemia in chronic cases"
    ],
    "imaging": [
      "Not routinely required; may show soft tissue swelling in severe blistering"
    ],
    "genetic": [
      "COL17A1 (causative)",
      "ITGB4 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Immunofluorescence mapping demonstrating reduced laminin-332 at the dermoepidermal junction",
      "Histopathology showing cleavage within lamina lucida"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "epidermolysis-bullosa-simplex",
      "distinguishingFeatures": [
        "Blistering occurs intraepidermally rather than at lamina lucida",
        "Usually more generalized distribution",
        "Mutations in keratin genes (KRT5, KRT14)"
      ]
    },
    {
      "diseaseId": "dystrophic-epidermolysis-bullosa",
      "distinguishingFeatures": [
        "Blistering occurs below the basement membrane (sublamina densa)",
        "More extensive scarring and milia formation",
        "Mutations in COL7A1 gene"
      ]
    }
  ],
  "redFlags": [
    "Rapidly expanding blistering beyond localized areas",
