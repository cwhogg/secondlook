  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Echocardiographic Diagnostic Criteria for Subaortic Stenosis-Short Stature Syndrome",
    "criteria": [
      {
        "id": "subaortic-stenosis",
        "description": "Presence of fixed subaortic stenosis confirmed by echocardiography or cardiac catheterization",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Height below the 3rd percentile for age and sex without identifiable endocrine cause",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-delay",
        "description": "Delayed bone age and growth retardation documented by radiographic studies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of fixed subaortic stenosis and short stature below the 3rd percentile, with or without characteristic facial dysmorphism",
    "notes": "Diagnosis is primarily clinical supported by echocardiographic findings; genetic testing may be inconclusive."
  },
