  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological and Immunohistochemical Diagnostic Criteria for Solitary Fibrous Tumor",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of spindle cell proliferation with patternless architecture and collagenous stroma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Positive staining for STAT6 nuclear expression and CD34",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "molecular",
        "description": "Detection of NAB2-STAT6 gene fusion by molecular testing",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-presentation",
        "description": "Solitary, slow-growing, painless mass often in pleura or soft tissues",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological features plus positive STAT6 immunohistochemistry",
    "notes": "Molecular confirmation via NAB2-STAT6 fusion is supportive but not mandatory."
  },
