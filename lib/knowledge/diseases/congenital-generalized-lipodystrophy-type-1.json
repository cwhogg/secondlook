  "diagnosticCriteria": {
    "formalCriteriaName": "Berardinelli-Seip Diagnostic Criteria",
    "criteria": [
      {
        "id": "adipose-tissue-loss",
        "description": "Near total absence of subcutaneous adipose tissue from birth or early infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "insulin-resistance",
        "description": "Severe insulin resistance with hyperinsulinemia and early-onset diabetes mellitus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypertriglyceridemia",
        "description": "Marked hypertriglyceridemia often leading to pancreatitis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hepatomegaly",
        "description": "Hepatomegaly due to fatty infiltration",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "acanthosis-nigricans",
        "description": "Presence of acanthosis nigricans indicating insulin resistance",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria: near total absence of adipose tissue and severe insulin resistance",
    "notes": "Genetic testing confirming AGPAT2 mutations supports diagnosis"
  },
