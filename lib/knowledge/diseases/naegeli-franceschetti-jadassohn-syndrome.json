  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Naegeli-Franceschetti-Jadassohn Syndrome",
    "criteria": [
      {
        "id": "reticulate-hyperpigmentation",
        "description": "Presence of reticulate (net-like) hyperpigmentation primarily on the trunk and neck",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-dermatoglyphics",
        "description": "Congenital absence or marked reduction of dermatoglyphics (fingerprints and palm prints)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-anomalies",
        "description": "Dental abnormalities including hypodontia, enamel hypoplasia, and early tooth loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sweat-gland-dysfunction",
        "description": "Hypohidrosis or anhidrosis leading to heat intolerance",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "nail-dystrophy",
        "description": "Nail abnormalities such as dystrophic or hypoplastic nails",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: reticulate hyperpigmentation, absent dermatoglyphics, and dental anomalies",
    "notes": "Genetic testing for mutations in the KRT14 gene can support diagnosis but is not mandatory."
  },
