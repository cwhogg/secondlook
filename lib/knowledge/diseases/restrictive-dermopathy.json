  "diagnosticCriteria": {
    "formalCriteriaName": "Restrictive Dermopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "tense-skin",
        "description": "Taut, rigid, and translucent skin with reduced elasticity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including micrognathia, small mouth, and pinched nose",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-contractures",
        "description": "Severe joint contractures limiting movement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing thin dermis with dense collagen bundles and absence of elastic fibers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in ZMPSTE24 or LMNA genes",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of taut, rigid skin with characteristic facial dysmorphism and joint contractures supported by histopathological findings",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical and histopathological criteria are met."
  },
