  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate elevation)",
      "Normal to mildly elevated lactate dehydrogenase"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle involvement and fatty replacement",
      "Chest imaging may show diaphragmatic weakness"
    ],
    "genetic": [
      "Mutations in NEB (nebulin gene)",
      "Mutations in ACTA1 (skeletal muscle alpha-actin gene)",
      "Other rare associated gene mutations"
    ],
    "other": [
      "Muscle biopsy demonstrating nemaline rods with Gomori trichrome stain",
      "Electromyography showing myopathic motor unit potentials"
    ]
  },
