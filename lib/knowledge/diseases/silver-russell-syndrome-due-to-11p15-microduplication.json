  "diagnosticCriteria": {
    "formalCriteriaName": "Netchine-Harbison Clinical Scoring System (NH-CSS) adapted for 11p15 microduplication",
    "criteria": [
      {
        "id": "prenatal-growth-retardation",
        "description": "Intrauterine growth retardation with birth weight and/or length ≤ -2 SD",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "postnatal-growth-failure",
        "description": "Postnatal growth failure with height ≤ -2 SD by 2 years of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "11p15-microduplication-confirmation",
        "description": "Molecular confirmation of 11p15 microduplication affecting imprinting control regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "relative-macrocephaly-at-birth",
        "description": "Head circumference at birth ≥ 1.5 SD above birth weight and/or length",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "triangular-facial-appearance",
        "description": "Characteristic triangular face with prominent forehead",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "body-hemihypoplasia",
        "description": "Asymmetry of limbs or body segments",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of prenatal and postnatal growth retardation plus molecular confirmation of 11p15 microduplication",
    "notes": "Diagnostic criteria adapted from classical Silver-Russell syndrome criteria with emphasis on molecular findings specific to 11p15 microduplication."
  },
