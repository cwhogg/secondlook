  "diagnosticCriteria": {
    "formalCriteriaName": "Methotrexate Embryopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "prenatal-exposure",
        "description": "Confirmed prenatal exposure to aminopterin or methotrexate during the first trimester",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-malformations",
        "description": "Presence of characteristic craniofacial anomalies such as micrognathia, hypoplastic nasal bridge, and cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-defects",
        "description": "Evidence of limb abnormalities including limb hypoplasia, syndactyly, or oligodactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Intrauterine growth retardation or postnatal growth deficiency",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-anomalies",
        "description": "Congenital heart defects such as ventricular septal defect or atrial septal defect",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed prenatal exposure plus presence of at least two major criteria including craniofacial malformations and limb defects",
    "notes": "Diagnosis is clinical and supported by history of maternal drug exposure; genetic testing is not diagnostic."
  },
