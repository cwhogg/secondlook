  "keyFindings": {
    "laboratory": [
      "Elevated thyroid stimulating hormone (TSH) with low free T4",
      "Low serum cortisol and aldosterone levels",
      "Positive anti-thyroid peroxidase (anti-TPO) and anti-adrenal antibodies",
      "Elevated blood glucose or evidence of insulin deficiency"
    ],
    "imaging": [
      "MRI of brain and spinal cord typically normal or nonspecific",
      "Nerve conduction studies showing demyelinating or axonal polyneuropathy"
    ],
    "genetic": [
      "DMXL2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Nerve biopsy showing inflammatory infiltrates and demyelination",
      "Autonomic function tests demonstrating impaired autonomic responses"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "chronic-inflammatory-demyelinating-polyneuropathy",
      "distinguishingFeatures": [
        "Usually lacks multiple endocrine gland involvement",
        "More prominent motor weakness with relapsing-remitting course",
        "Responds well to immunomodulatory therapy"
      ]
    },
    {
      "diseaseId": "autoimmune-polyendocrine-syndrome-type-2",
      "distinguishingFeatures": [
        "Endocrine involvement without prominent polyneuropathy",
        "Presence of Addison disease, type 1 diabetes, and thyroiditis",
        "Genetic predisposition with HLA associations"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive symmetrical sensorimotor neuropathy",
    "Signs of adrenal crisis (hypotension, hyponatremia)",
    "Multiple endocrine gland failure with neurological deficits"
  ],
