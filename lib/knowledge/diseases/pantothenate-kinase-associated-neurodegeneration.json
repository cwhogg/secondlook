    "formalCriteriaName": "Diagnostic criteria for PKAN",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive dystonia and parkinsonism with onset in childhood or early adulthood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-iron",
        "description": "MRI showing 'eye of the tiger' sign with bilateral globus pallidus iron accumulation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the PANK2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of neurodegeneration with brain iron accumulation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive dystonia/parkinsonism plus MRI 'eye of the tiger' sign and/or pathogenic PANK2 mutation",
    "notes": "Genetic confirmation is definitive; MRI findings are highly characteristic."
  },
