  "diagnosticCriteria": {
    "formalCriteriaName": "Isovaleric Acidemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-isovaleric-acid",
        "description": "Elevated isovaleric acid levels in plasma or urine organic acid analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "isovaleryl-coa-dehydrogenase-deficiency",
        "description": "Demonstration of isovaleryl-CoA dehydrogenase enzyme deficiency in fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the IVD gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of metabolic acidosis with characteristic sweaty feet odor",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated isovaleric acid and either enzyme deficiency or pathogenic IVD gene variants",
    "notes": "Newborn screening may detect elevated C5 acylcarnitine suggestive of IVA"
  },
