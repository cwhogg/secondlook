  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Hereditary Peripheral Neuropathy",
    "criteria": [
      {
        "id": "family-history",
        "description": "Presence of a family history consistent with autosomal dominant, autosomal recessive, or X-linked inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Symmetric distal muscle weakness and atrophy with sensory loss predominantly in a length-dependent pattern",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies showing demyelinating or axonal neuropathy consistent with hereditary neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in known causative genes (e.g., PMP22, MPZ, GJB1)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Supportive evidence from nerve biopsy showing characteristic pathological features",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of typical clinical features plus supportive electrophysiological findings and family history; genetic confirmation if available",
    "notes": "Genetic testing is increasingly important for definitive diagnosis and subclassification."
  },
