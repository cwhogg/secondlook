  "keyFindings": {
    "laboratory": [
      "Defective leukocyte and platelet integrin activation assays",
      "Normal or elevated leukocyte counts without marked leukocytosis",
      "Prolonged bleeding time with normal platelet count"
    ],
    "imaging": [
      "Radiographic evidence of osteomyelitis or bone infections",
      "Chest X-ray showing pneumonia or pulmonary infiltrates"
    ],
    "genetic": [
      "IL2RG (causative)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Flow cytometry showing impaired activation of β2 integrins on leukocytes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "leukocyte-adhesion-deficiency-type-i",
      "distinguishingFeatures": [
        "Marked leukocytosis with impaired leukocyte adhesion",
        "Mutations in ITGB2 gene",
        "Absence of platelet dysfunction"
      ]
    },
    {
      "diseaseId": "glanzmann-thrombasthenia",
      "distinguishingFeatures": [
        "Isolated platelet aggregation defect without immunodeficiency",
        "Mutations in ITGA2B or ITGB3 genes",
        "Normal leukocyte function"
      ]
    }
  ],
