  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Genetic testing revealing mutations or deletions in the HCCS gene on Xp22"
    ],
    "imaging": [
      "Ocular ultrasound or MRI showing microphthalmia or anophthalmia",
      "Brain MRI may show structural abnormalities or delayed myelination",
      "Echocardiogram for cardiac anomalies"
    ],
    "genetic": [
      "HCCS (causative)",
      "COX7B (causative)",
      "NDUFB11 (causative, loss-of-function)",
      "X-linked dominant inheritance pattern with male lethality"
    ],
    "other": [
      "Skin biopsy showing epidermal atrophy along linear defects",
      "Ophthalmological examination confirming ocular anomalies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "oculo-cutaneous-albinism",
