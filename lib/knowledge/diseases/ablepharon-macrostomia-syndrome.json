  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Ablepharon Macrostomia Syndrome",
    "criteria": [
      {
        "id": "ablepharon",
        "description": "Congenital absence or severe hypoplasia of eyelids (ablepharon)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "macrostomia",
        "description": "Macrostomia characterized by a wide mouth with lateral clefts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-abnormalities",
        "description": "Thin, tight, and wrinkled skin with sparse or absent hair",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ear-malformations",
        "description": "Abnormalities of the external ears including low-set or malformed pinnae",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genital-anomalies",
        "description": "Genital abnormalities such as cryptorchidism or hypoplastic genitalia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: ablepharon, macrostomia, and characteristic skin abnormalities",
    "notes": "Genetic testing for mutations in the TWIST2 gene can support diagnosis but is not mandatory."
  },
