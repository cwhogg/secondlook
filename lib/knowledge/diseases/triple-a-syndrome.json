    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "achalasia",
      "distinguishingFeatures": [
        "Absence of alacrima and adrenal insufficiency",
        "No AAAS gene mutations"
      ]
    },
    {
      "diseaseId": "autoimmune-adrenalitis",
      "distinguishingFeatures": [
        "Presence of adrenal insufficiency without achalasia or alacrima",
        "Autoantibodies positive"
      ]
    },
    {
      "diseaseId": "familial-alacrima",
      "distinguishingFeatures": [
        "Isolated alacrima without adrenal or esophageal involvement",
        "No neurological symptoms"
      ]
    }
