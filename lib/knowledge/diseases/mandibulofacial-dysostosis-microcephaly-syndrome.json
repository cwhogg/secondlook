        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mandibulofacial-dysostosis",
        "description": "Characteristic mandibulofacial dysostosis including malar hypoplasia and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-anomalies",
        "description": "Cleft palate or choanal atresia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural or conductive hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital microcephaly and mandibulofacial dysostosis with at least one additional craniofacial anomaly or developmental delay",
    "notes": "Genetic testing confirming EFTUD2 mutation supports diagnosis"
  },
