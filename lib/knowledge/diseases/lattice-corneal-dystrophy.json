  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Diagnostic Criteria for Lattice Corneal Dystrophy",
    "criteria": [
      {
        "id": "clinical-amyloid-deposits",
        "description": "Presence of characteristic branching lattice-like amyloid deposits in the corneal stroma on slit-lamp examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the TGFBI gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Histological confirmation of amyloid deposits in corneal biopsy specimens",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic lattice amyloid deposits on slit-lamp examination plus positive family history or genetic confirmation",
    "notes": "Genetic testing is increasingly used to confirm diagnosis but is not mandatory if clinical and family history are definitive."
  },
