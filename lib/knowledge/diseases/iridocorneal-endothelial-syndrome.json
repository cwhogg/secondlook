  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for ICE Syndrome",
    "criteria": [
      {
        "id": "corneal-endothelial-abnormalities",
        "description": "Presence of abnormal corneal endothelial cell proliferation with characteristic 'hammered silver' or 'beaten metal' appearance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "iris-changes",
        "description": "Iris abnormalities including corectopia, iris atrophy, and nodules",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "secondary-glaucoma",
        "description": "Development of secondary angle-closure or open-angle glaucoma due to endothelial membrane proliferation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "unilateral-involvement",
        "description": "Typically unilateral presentation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-inflammatory-signs",
        "description": "No evidence of intraocular inflammation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of corneal endothelial abnormalities, iris changes, and secondary glaucoma",
    "notes": "Diagnosis is clinical and supported by slit-lamp examination and gonioscopy."
  },
