        "requiredForDiagnosis": false
      },
      {
        "id": "absence-inflammation-markers",
        "description": "Lack of systemic inflammatory markers despite joint symptoms",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive arthropathy and cardiac valvular disease with or without family history",
    "notes": "Diagnosis is clinical; genetic testing is not established."
