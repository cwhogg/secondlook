  "keyFindings": {
    "laboratory": [
      "Low serum levels of peptidic growth factors (e.g., IGF-1, leptin)",
      "Elevated fasting insulin and glucose levels indicating insulin resistance",
      "Hypertriglyceridemia and elevated liver enzymes"
    ],
    "imaging": [
      "Ultrasound or MRI showing hepatic steatosis",
      "MRI demonstrating loss of subcutaneous fat tissue"
    ],
    "genetic": [
      "Mutations or deletions in genes encoding peptidic growth factors or their receptors (e.g., IGF1, LEP, LEPR)"
    ],
    "other": [
      "Histopathology of adipose tissue showing absence or severe reduction of adipocytes without inflammation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-generalized-lipodystrophy",
      "distinguishingFeatures": [
        "Genetic mutations in BSCL2 or AGPAT2 genes",
        "Earlier onset with more severe fat loss",
        "Absence of documented peptidic growth factor deficiency"
      ]
    },
    {
      "diseaseId": "acquired-generalized-lipodystrophy",
      "distinguishingFeatures": [
        "Autoimmune etiology with inflammatory markers",
        "Rapid progression of fat loss",
        "Presence of autoantibodies"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of fat loss with metabolic decompensation",
    "Severe insulin resistance unresponsive to standard therapies",
    "Development of pancreatitis or cardiomyopathy secondary to metabolic complications"
  ],
