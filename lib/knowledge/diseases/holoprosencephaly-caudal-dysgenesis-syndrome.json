        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with midline developmental defects",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Diagnosis requires presence of holoprosencephaly, caudal dysgenesis, and characteristic craniofacial anomalies",
    "notes": "Diagnosis is primarily clinical supported by neuroimaging and genetic testing when available"
