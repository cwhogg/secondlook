        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Mild midface hypoplasia and cleft palate",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "early-onset-osteoarthritis",
        "description": "Development of early-onset osteoarthritis in large joints",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of disproportionate short-trunk dwarfism, characteristic radiological abnormalities, and pathogenic COL2A1 mutation",
    "notes": "Diagnosis is primarily clinical and radiological, confirmed by genetic testing."
