  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate elevation)",
      "Normal to mildly elevated inflammatory markers"
    ],
    "imaging": [
      "Muscle MRI showing fatty infiltration and muscle atrophy",
      "Chest X-ray or CT showing restrictive lung disease and atelectasis",
      "Spinal X-rays demonstrating scoliosis"
    ],
    "genetic": [
      "TRIP4 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography showing myopathic changes",
      "Pulmonary function tests indicating restrictive ventilatory defect"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "collagen-vi-related-muscular-dystrophy",
