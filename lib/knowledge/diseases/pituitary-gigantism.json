  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Pituitary Gigantism",
    "criteria": [
      {
        "id": "elevated-gh",
        "description": "Elevated serum growth hormone (GH) levels not suppressed by oral glucose tolerance test",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-igf1",
        "description": "Elevated serum insulin-like growth factor 1 (IGF-1) levels above age-adjusted normal range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pituitary-adenoma",
        "description": "Radiological evidence of pituitary adenoma on MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Clinical features of excessive linear growth and characteristic somatic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated GH and IGF-1 levels with pituitary adenoma on imaging",
    "notes": "Diagnosis requires exclusion of other causes of gigantism such as genetic syndromes or ectopic GH secretion."
  },
