  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Epidermolysis Bullosa Simplex",
    "criteria": [
      {
        "id": "clinical-blistering",
        "description": "Generalized blistering of the skin predominantly on palms and soles triggered by minor mechanical trauma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Intraepidermal cleavage with basal keratinocyte cytolysis on skin biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic heterozygous mutations in KRT5 or KRT14 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Immunofluorescence showing cleavage within basal keratinocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized blistering clinically plus histopathological evidence of intraepidermal cleavage and confirmation by genetic testing identifying pathogenic KRT5 or KRT14 mutation",
    "notes": "Diagnosis is confirmed by combining clinical, histological, and genetic findings."
  },
