  "diagnosticCriteria": {
    "formalCriteriaName": "Proximal SMA Adult-Onset Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness with adult onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyography showing chronic denervation and reinnervation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variant in causative gene with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other neuromuscular disorders such as ALS or distal SMA",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal muscle weakness with adult onset plus EMG evidence of chronic denervation and genetic confirmation of pathogenic variant in causative gene",
    "notes": "Diagnosis requires exclusion of other motor neuron diseases and distal SMA forms."
  },
