  "diagnosticCriteria": {
    "formalCriteriaName": "2017 International Classification of the Ehlers-Danlos Syndromes",
    "criteria": [
      {
        "id": "ceds-maj1",
        "description": "Skin hyperextensibility and atrophic scarring",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ceds-maj2",
        "description": "Generalized joint hypermobility (Beighton score)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ceds-min1",
        "description": "Easy bruising",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ceds-min2",
        "description": "Soft, doughy skin",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ceds-min3",
        "description": "Skin fragility (spontaneous or at pressure points)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ceds-min4",
        "description": "Molluscoid pseudotumors",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ceds-min5",
        "description": "Subcutaneous spheroids",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ceds-min6",
        "description": "Hernia (or history thereof)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ceds-min7",
        "description": "Epicanthal folds",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ceds-min8",
        "description": "Complications of joint hypermobility (sprains, dislocations, pes planus)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ceds-min9",
        "description": "Family history consistent with autosomal dominant transmission",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Both major criteria (skin hyperextensibility + atrophic scarring AND generalized joint hypermobility) plus at least 3 minor criteria. Confirmed by molecular testing of COL5A1 or COL5A2.",
    "notes": "Molecular confirmation is strongly recommended. Approximately 90% of patients have COL5A1/COL5A2 mutations."
  },
