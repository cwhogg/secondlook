  "diagnosticCriteria": {
    "formalCriteriaName": "Radiation Myelitis Diagnostic Criteria",
    "criteria": [
      {
        "id": "history-radiation",
        "description": "History of spinal cord radiation exposure within the preceding 6 months to 2 years",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-deficits",
        "description": "Progressive neurological deficits consistent with spinal cord dysfunction (e.g., motor weakness, sensory loss, sphincter disturbances)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "MRI evidence of spinal cord T2 hyperintensity or contrast enhancement without tumor recurrence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes such as tumor recurrence, infection, or demyelinating disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-csf",
        "description": "CSF analysis showing mild protein elevation without pleocytosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "History of spinal radiation exposure plus progressive neurological deficits and supportive MRI findings with exclusion of other causes",
    "notes": "Latency period between radiation and symptom onset can vary from months to years."
  },
