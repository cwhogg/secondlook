  "keyFindings": {
    "laboratory": [
      "Elevated serum IgG4 levels (>135 mg/dL)",
      "Mildly elevated inflammatory markers (ESR, CRP)",
      "CSF analysis typically shows mild lymphocytic pleocytosis and elevated protein"
    ],
    "imaging": [
      "MRI with contrast showing diffuse or localized dural thickening and enhancement",
      "Possible associated brain edema or mass effect"
    ],
    "genetic": [
      "No known genetic mutations identified"
    ],
    "other": [
      "Histopathology showing dense lymphoplasmacytic infiltrate rich in IgG4-positive plasma cells with storiform fibrosis and obliterative phlebitis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "idiopathic-hypertrophic-pachymeningitis",
      "distinguishingFeatures": [
        "Absence of elevated serum IgG4",
        "Lack of IgG4-positive plasma cells on biopsy",
        "No systemic IgG4-related disease involvement"
      ]
    },
    {
      "diseaseId": "infectious-pachymeningitis",
      "distinguishingFeatures": [
        "Positive microbiological cultures or PCR",
        "Systemic signs of infection",
        "Response to antimicrobial therapy"
      ]
    },
    {
      "diseaseId": "meningeal-malignancy",
      "distinguishingFeatures": [
        "Presence of malignant cells in CSF or biopsy",
        "Rapid progression",
        "Systemic malignancy evidence"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive neurological deficits",
    "Signs of increased intracranial pressure (e.g., papilledema, vomiting)",
    "Failure to respond to corticosteroid therapy"
  ],
