      "Elevated soluble CD25",
      "Low or absent NK cell activity"
    ],
    "imaging": [
      "Splenomegaly and hepatomegaly on ultrasound or CT",
      "MRI brain abnormalities in neurological involvement"
    ],
    "genetic": [
      "Pathogenic mutations in PRF1, UNC13D, STX11, STXBP2, and other HLH-associated genes"
    ],
    "other": [
