  "keyFindings": {
    "laboratory": [
      "Marked lymphopenia with reduced CD4+ and CD8+ T cells",
      "Variable immunoglobulin levels, often normal or mildly decreased",
      "Elevated viral load during infections"
    ],
    "imaging": [
      "Chest radiographs showing recurrent pneumonia or bronchiectasis",
      "Abdominal ultrasound may reveal hepatosplenomegaly"
    ],
    "genetic": [
      "Biallelic pathogenic variants in the STK4 gene confirmed by sequencing"
    ],
    "other": [
      "Impaired T-cell survival demonstrated by in vitro apoptosis assays",
      "Reduced T-cell proliferation responses to mitogens"
    ]
  },
