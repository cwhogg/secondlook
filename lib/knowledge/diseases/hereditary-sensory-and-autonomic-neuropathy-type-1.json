  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for HSAN Type 1",
    "criteria": [
      {
        "id": "sensory-loss",
        "description": "Progressive distal sensory loss predominantly affecting pain and temperature modalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autonomic-dysfunction",
        "description": "Signs of autonomic dysfunction including anhidrosis and orthostatic hypotension",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ulcerations",
        "description": "Recurrent painless distal ulcerations and infections leading to osteomyelitis and amputations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the SPTLC1 or SPTLC2 genes",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal sensory loss, autonomic dysfunction, and ulcerations plus identification of pathogenic mutation in SPTLC1 or SPTLC2 genes",
    "notes": "Genetic testing is essential for confirmation; clinical features overlap with other HSAN types"
  },
