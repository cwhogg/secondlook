  "diagnosticCriteria": {
    "formalCriteriaName": "Medullary Cystic Kidney Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "family-history",
        "description": "Presence of autosomal dominant family history of progressive renal disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-medullary-cysts",
        "description": "Identification of cysts localized to the renal medulla on imaging studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-renal-failure",
        "description": "Evidence of progressive chronic kidney disease leading to end-stage renal failure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-enlarged-kidneys",
        "description": "Kidneys are typically normal sized or small, distinguishing from polycystic kidney disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "tubulointerstitial-nephritis",
        "description": "Histological evidence of tubulointerstitial fibrosis and tubular atrophy on biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of autosomal dominant family history, medullary cysts on imaging, and progressive renal failure",
    "notes": "Genetic testing for mutations in MUC1 or UMOD genes can support diagnosis"
  },
