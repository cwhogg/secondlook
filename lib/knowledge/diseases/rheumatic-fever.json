  "keyFindings": {
    "laboratory": [
      "Elevated erythrocyte sedimentation rate (ESR) and C-reactive protein (CRP)",
      "Elevated antistreptolysin O (ASO) titers or anti-DNase B antibodies",
      "Leukocytosis with neutrophilia"
    ],
    "imaging": [
      "Echocardiography showing valvulitis, mitral or aortic regurgitation",
      "Chest X-ray may show cardiomegaly in severe carditis"
    ],
    "genetic": [],
    "other": [
      "Electrocardiogram showing prolonged PR interval",
      "Throat culture positive for Group A Streptococcus (GAS) or recent GAS infection evidence"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "juvenile-rheumatoid-arthritis",
      "distinguishingFeatures": [
        "Chronic arthritis without preceding streptococcal infection",
        "Absence of carditis and chorea",
        "Different pattern of joint involvement"
      ]
    },
    {
      "diseaseId": "infective-endocarditis",
      "distinguishingFeatures": [
        "Positive blood cultures for bacteria",
        "Presence of vegetations on heart valves on echocardiography",
        "Fever with septic emboli rather than migratory arthritis"
      ]
    }
  ],
  "redFlags": [
    "New onset heart murmur with signs of heart failure",
    "Development of Sydenham chorea",
    "Rapid progression of carditis symptoms"
  ],
