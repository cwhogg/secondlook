  "keyFindings": {
    "laboratory": [
      "Hyperglycemia (fasting >=126, random >=200 mg/dL)",
      "HbA1c >=6.5% (often >9% at diagnosis)",
      "Low or absent C-peptide (<0.6 ng/mL; reflects insulin deficiency)",
      "Anti-GAD65 antibodies positive (~70-80%)",
      "Anti-IA2 antibodies positive (~60%)",
      "Anti-ZnT8 antibodies positive (~60-70%)",
      "Anti-insulin antibodies (IAA) positive (more common in young children)",
      "ICA (islet cell antibodies) positive",
      "Ketonuria/ketonemia in DKA",
      "Metabolic acidosis (low bicarbonate, low pH) in DKA"
    ],
    "imaging": [
      "Generally no specific imaging findings for T1D diagnosis",
      "Retinal screening: annual dilated fundoscopy for diabetic retinopathy (starting 5 years after diagnosis)",
      "Abdominal CT if DKA with atypical features (exclude pancreatitis, pancreatic pathology)"
    ],
    "genetic": [
      "CHN1 (causative)",
      "MAFB (causative, loss-of-function)",
      "SALL4 (causative)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Screening for associated autoimmune conditions: thyroid (anti-TPO, TSH), celiac (tTG-IgA), adrenal (21-OH antibodies)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "type-2-diabetes",
      "distinguishingFeatures": [
        "Obesity/metabolic syndrome",
        "Family history",
        "Insulin resistance rather than deficiency",
        "Negative autoantibodies",
        "C-peptide often elevated"
      ]
    },
    {
      "diseaseId": "maturity-onset-diabetes-of-the-young",
      "distinguishingFeatures": [
        "Autosomal dominant inheritance",
        "Negative autoantibodies",
        "Specific gene mutations (GCK, HNF1A)",
        "Mild fasting hyperglycemia (GCK-MODY)"
      ]
    },
    {
      "diseaseId": "latent-autoimmune-diabetes-in-adults",
      "distinguishingFeatures": [
        "Adult onset (>30 years)",
        "Slower progression to insulin dependence",
        "Positive autoantibodies (especially GAD65)",
        "Initially may not require insulin"
      ]
    },
    {
      "diseaseId": "secondary-diabetes",
      "distinguishingFeatures": [
        "Identifiable cause (pancreatitis, Cushing's, medications)",
        "No islet autoantibodies",
        "Clinical context"
      ]
    }
  ],
  "redFlags": [
    "DKA at presentation (pH <7.3, bicarbonate <18, ketones elevated)",
    "Cerebral edema during DKA treatment (headache, altered consciousness, bradycardia)",
    "Recurrent DKA (consider non-adherence, insulin pump malfunction, eating disorder)",
    "Severe hypoglycemia with loss of consciousness",
    "Signs of associated autoimmune conditions (thyroid disease, celiac, Addison's)"
  ],
