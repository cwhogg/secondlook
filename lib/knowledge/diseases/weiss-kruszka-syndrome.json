  "diagnosticCriteria": {
    "formalCriteriaName": "Weiss-Kruszka Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including micrognathia, broad nasal bridge, and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ZNF462-pathogenic-variant",
        "description": "Presence of pathogenic or likely pathogenic variant in the ZNF462 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Neonatal or infantile hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital heart defects such as atrial or ventricular septal defects",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic craniofacial features, developmental delay, and a pathogenic variant in ZNF462 gene",
    "notes": "Diagnosis is confirmed by molecular genetic testing identifying ZNF462 mutations; clinical features may vary in severity."
  },
