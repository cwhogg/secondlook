  "keyFindings": {
    "laboratory": [
      "Reduced acid ceramidase enzyme activity in leukocytes or fibroblasts",
      "Elevated ceramide levels in tissues and plasma"
    ],
    "imaging": [
      "X-ray showing joint deformities and osteolytic lesions",
      "MRI may show soft tissue nodules and joint involvement"
    ],
    "genetic": [
      "Pathogenic mutations in ASAH1 gene confirmed by molecular genetic testing"
    ],
    "other": [
      "Histopathology revealing characteristic lipogranulomas with foamy macrophages"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "juvenile-rheumatoid-arthritis",
      "distinguishingFeatures": [
        "Absence of acid ceramidase deficiency",
        "Lack of subcutaneous lipogranulomas",
        "Different genetic and immunological markers"
      ]
    },
    {
      "diseaseId": "gaucher-disease",
      "distinguishingFeatures": [
        "Glucocerebrosidase deficiency instead of acid ceramidase",
        "Presence of Gaucher cells on histology",
        "Different pattern of organomegaly and bone involvement"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive joint deformities in infancy",
    "Presence of subcutaneous nodules with pain",
    "Hoarseness or respiratory distress due to laryngeal involvement"
  ],
