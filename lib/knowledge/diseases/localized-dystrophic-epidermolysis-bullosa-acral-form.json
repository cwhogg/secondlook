  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Dystrophic Epidermolysis Bullosa",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of blistering and erosions localized primarily to acral sites (hands and feet) with scarring",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing sublamina densa cleavage with scarring consistent with dystrophic epidermolysis bullosa",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the COL7A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Reduced or absent type VII collagen staining at the dermal-epidermal junction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acral blistering with scarring plus either histopathological confirmation or genetic confirmation of COL7A1 mutation",
    "notes": "Diagnosis requires correlation of clinical, histological, and genetic findings."
  },
