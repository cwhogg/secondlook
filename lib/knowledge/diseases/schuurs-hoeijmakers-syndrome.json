  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for Schuurs-Hoeijmakers Syndrome",
    "criteria": [
      {
        "id": "pathogenic-pacs1-variant",
        "description": "Presence of the recurrent pathogenic PACS1 gene variant c.607C>T (p.Arg203Trp)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic craniofacial dysmorphisms including hypertelorism, downslanting palpebral fissures, broad nasal bridge, and thin upper lip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurodevelopmental-delay",
        "description": "Global developmental delay or intellectual disability with speech impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "History of seizures or epilepsy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-issues",
        "description": "Behavioral abnormalities including autism spectrum disorder features or anxiety",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of the pathogenic PACS1 variant plus characteristic facial features and neurodevelopmental delay",
    "notes": "Molecular genetic testing is essential for confirmation; clinical features guide suspicion."
  },
