  "keyFindings": {
    "laboratory": [
      "Low plasma glucose during symptomatic episodes (<55 mg/dL)",
      "Inappropriately elevated insulin and C-peptide levels during hypoglycemia",
      "Negative sulfonylurea screen"
    ],
    "imaging": [
      "Negative pancreatic imaging for insulinoma (CT, MRI, endoscopic ultrasound)",
      "Selective arterial calcium stimulation test showing diffuse insulin secretion"
    ],
    "genetic": [
      "No consistent genetic mutations identified; sporadic cases predominate",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology showing islet cell hypertrophy and nesidioblastosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "insulinoma",
      "distinguishingFeatures": [
        "Localized pancreatic tumor visible on imaging",
        "Positive histopathology for insulinoma",
        "Usually fasting hypoglycemia without diffuse beta-cell hyperplasia"
      ]
    },
    {
      "diseaseId": "factitious-hypoglycemia",
      "distinguishingFeatures": [
        "Low C-peptide levels during hypoglycemia",
        "History of exogenous insulin or sulfonylurea use",
        "Positive sulfonylurea screen"
      ]
    },
    {
      "diseaseId": "post-bariatric-surgery-hypoglycemia",
      "distinguishingFeatures": [
        "History of gastric bypass surgery",
        "Postprandial hypoglycemia with rapid glucose absorption",
        "Improvement with dietary modification"
      ]
    }
  ],
