  "keyFindings": {
    "laboratory": [
      "Positive 14-3-3 protein in cerebrospinal fluid",
      "Elevated tau protein in CSF"
    ],
    "imaging": [
      "Hyperintensity in caudate nucleus and putamen on diffusion-weighted MRI",
      "Cortical ribboning on MRI"
    ],
    "genetic": [
      "No known causative mutations in sporadic form; PRNP gene mutations seen in familial forms"
    ],
    "other": [
      "Periodic sharp wave complexes on EEG",
      "Definitive diagnosis by brain biopsy or autopsy showing spongiform changes"
    ]
  },
