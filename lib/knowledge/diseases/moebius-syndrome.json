  "diagnosticCriteria": {
    "formalCriteriaName": "Moebius Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "facial-paralysis",
        "description": "Congenital, non-progressive facial paralysis involving the seventh cranial nerve",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abducens-palsy",
        "description": "Congenital abducens nerve (sixth cranial nerve) palsy causing impaired lateral eye movement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-onset",
        "description": "Onset present at birth with no progressive neurological deterioration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Presence of limb abnormalities such as clubfoot or syndactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cranial-nerve-involvement",
        "description": "Involvement of additional cranial nerves (e.g., hypoglossal, trigeminal)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital facial paralysis and abducens nerve palsy with onset at birth",
    "notes": "Diagnosis is clinical; genetic testing may support but is not definitive."
  },
