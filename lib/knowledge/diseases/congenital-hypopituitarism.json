{
  "id": "congenital-hypopituitarism",
  "name": "Congenital Hypopituitarism",
  "aliases": [
    "Congenital Pituitary Hormone Deficiency",
    "Primary Hypopituitarism of Infancy"
  ],
  "icd10Codes": [
    "E23.0"
  ],
  "omimId": "262600",
  "orphanetId": "791",
  "prevalence": {
    "estimate": "1 in 4,000 to 1 in 10,000",
    "classification": "rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 2,
      "peak": 0
    },
    "sexPredilection": "equal",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Congenital Hypopituitarism",
    "criteria": [
      {
        "id": "hormone-deficiency",
        "description": "Documented deficiency of one or more anterior pituitary hormones confirmed by biochemical testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-pituitary",
        "description": "MRI evidence of pituitary hypoplasia, ectopic posterior pituitary, or stalk abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical features such as neonatal hypoglycemia, prolonged jaundice, micropenis, or growth failure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with pituitary development (e.g., PROP1, HESX1)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biochemical evidence of pituitary hormone deficiency plus MRI abnormalities or characteristic clinical features",
    "notes": "Early diagnosis is critical to prevent morbidity from hormone deficiencies."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Neonatal hypoglycemia",
        "frequency": 0.85,
        "bodySystem": "endocrine",
        "notes": "Due to cortisol and growth hormone deficiency"
      },
      {
        "symptomName": "Micropenis in male infants",
        "frequency": 0.75,
        "bodySystem": "reproductive",
        "notes": "Indicative of gonadotropin deficiency"
      },
      {
        "symptomName": "Prolonged neonatal jaundice",
        "frequency": 0.7,
        "bodySystem": "gastrointestinal",
        "notes": "Secondary to hypothyroidism and cortisol deficiency"
      }
    ],
    "common": [
      {
        "symptomName": "Growth failure or short stature",
        "frequency": 0.85,
        "bodySystem": "musculoskeletal",
        "notes": "Due to growth hormone deficiency"
      },
      {
        "symptomName": "Hypothyroidism symptoms (lethargy, constipation)",
        "frequency": 0.7,
        "bodySystem": "endocrine",
        "notes": "Secondary to TSH deficiency"
      },
      {
        "symptomName": "Fatigue and poor feeding in infancy",
        "frequency": 0.65,
        "bodySystem": "constitutional",
        "notes": "Non-specific but common"
      },
      {
        "symptomName": "Delayed bone age",
        "frequency": 0.6,
        "bodySystem": "musculoskeletal",
        "notes": "Reflects impaired growth hormone action"
      },
      {
        "symptomName": "Hypotension",
        "frequency": 0.55,
        "bodySystem": "cardiovascular",
        "notes": "Due to cortisol deficiency"
      }
    ],
    "occasional": [
      {
        "symptomName": "Hypoglycemic seizures",
        "frequency": 0.4,
        "bodySystem": "neurological",
        "notes": "Resulting from severe hypoglycemia"
      },
      {
        "symptomName": "Delayed puberty",
        "frequency": 0.3,
        "bodySystem": "reproductive",
        "notes": "Due to gonadotropin deficiency"
      },
      {
        "symptomName": "Cold intolerance",
        "frequency": 0.25,
        "bodySystem": "endocrine",
        "notes": "Related to hypothyroidism"
      },
      {
        "symptomName": "Hypoglycemia-induced developmental delay",
        "frequency": 0.15,
        "bodySystem": "neurological",
        "notes": "Secondary to recurrent hypoglycemia"
      },
      {
        "symptomName": "Headache",
        "frequency": 0.1,
        "bodySystem": "neurological",
        "notes": "May indicate mass effect or pituitary abnormalities"
      }
    ],
    "rare": [
      {
        "symptomName": "Visual field defects",
        "frequency": 0.08,
        "bodySystem": "ophthalmological",
        "notes": "Due to optic chiasm compression"
      },
      {
        "symptomName": "Craniofacial abnormalities",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Associated with midline defects"
      },
      {
        "symptomName": "Seizures unrelated to hypoglycemia",
        "frequency": 0.03,
        "bodySystem": "neurological",
        "notes": "Rarely observed"
      }
    ]
  },
  "systemsAffected": [
    "endocrine",
    "musculoskeletal",
    "neurological",
    "reproductive",
    "cardiovascular",
    "ophthalmological",
    "constitutional"
  ],
  "keyFindings": {
    "laboratory": [
      "Low serum levels of pituitary hormones (GH, TSH, ACTH, LH, FSH, prolactin)",
      "Low target gland hormones (cortisol, free T4, sex steroids)",
      "Hypoglycemia on blood glucose testing"
    ],
    "imaging": [
      "MRI showing pituitary hypoplasia or aplasia",
      "Ectopic posterior pituitary bright spot",
      "Pituitary stalk interruption or absence"
    ],
    "genetic": [
      "Mutations in PROP1, HESX1, LHX3, LHX4, SOX3 genes"
    ],
    "other": [
      "Delayed bone age on radiographs",
      "Abnormal stimulation tests for pituitary hormones"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "growth-hormone-deficiency",
      "distinguishingFeatures": [
        "Isolated growth hormone deficiency without other pituitary hormone deficits",
        "Normal pituitary imaging"
      ]
    },
    {
      "diseaseId": "septo-optic-dysplasia",
      "distinguishingFeatures": [
        "Optic nerve hypoplasia",
        "Midline brain abnormalities",
        "Variable pituitary hormone deficiencies"
      ]
    }
  ],
  "redFlags": [
    "Persistent neonatal hypoglycemia",
    "Prolonged jaundice in newborn",
    "Failure to thrive with multiple hormone deficiencies"
  ],
  "specialistType": [
    "Pediatric Endocrinologist",
    "Geneticist",
    "Pediatric Neurologist"
  ],
