  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Haim-Munk Syndrome",
    "criteria": [
      {
        "id": "palmoplantar-keratoderma",
        "description": "Diffuse palmoplantar keratoderma with yellowish thickening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset-periodontitis",
        "description": "Severe early-onset periodontitis leading to premature loss of teeth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "arachnodactyly",
        "description": "Arachnodactyly characterized by abnormally long and slender fingers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nail-dystrophy",
        "description": "Nail abnormalities including onychogryphosis and transverse ridging",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pes-planus",
        "description": "Flat feet (pes planus)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: diffuse palmoplantar keratoderma, early-onset periodontitis, and arachnodactyly",
    "notes": "Genetic testing for CTSC mutations can support diagnosis"
  },
