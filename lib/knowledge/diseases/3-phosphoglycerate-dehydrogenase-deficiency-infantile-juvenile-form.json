  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Onset of developmental delay and microcephaly in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-deficiency",
        "description": "Reduced 3-phosphoglycerate dehydrogenase enzyme activity in fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the PHGDH gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-serum-serine",
        "description": "Low plasma and cerebrospinal fluid serine concentrations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical features consistent with the disorder plus biochemical enzyme deficiency or genetic confirmation",
    "notes": "Diagnosis is supported by low serine levels and exclusion of other causes of serine deficiency"
  },
