  "keyFindings": {
    "laboratory": [
      "Audiometry confirming sensorineural hearing loss"
    ],
    "imaging": [
      "CT or MRI may be used to evaluate inner ear structures"
    ],
    "genetic": [
      "Mutations in PAX3, MITF, SOX10, EDNRB, EDN3 genes",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Clinical examination revealing dystopia canthorum and pigmentary abnormalities"
    ]
  },
