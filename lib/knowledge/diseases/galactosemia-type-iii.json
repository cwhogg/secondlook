  "differentialDiagnoses": [
    {
      "diseaseId": "galactosemia-type-i",
      "distinguishingFeatures": [
        "Classic galactosemia caused by GALT deficiency",
        "More severe neonatal presentation",
        "Markedly elevated galactose-1-phosphate levels"
      ]
    },
    {
      "diseaseId": "galactosemia-type-ii",
      "distinguishingFeatures": [
        "Galactokinase deficiency",
        "Primarily presents with cataracts without severe liver disease",
        "Normal or mildly elevated galactose-1-phosphate"
      ]
    }
  ],
