  "diagnosticCriteria": {
    "formalCriteriaName": "Brauer Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "congenital-facial-atrophy",
        "description": "Congenital focal areas of dermal hypoplasia or atrophy on the face, especially preauricular and temporal regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-or-malformation-of-ears",
        "description": "Unilateral or bilateral ear malformations including microtia or anotia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-intellectual-development",
        "description": "Normal cognitive development without neurological impairment",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital focal facial dermal hypoplasia/atrophy plus ear malformations",
    "notes": "Diagnosis is clinical; genetic testing may support but is not definitive."
  },
