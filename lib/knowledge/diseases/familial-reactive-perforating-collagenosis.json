  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Diagnostic Criteria for Familial Reactive Perforating Collagenosis",
    "criteria": [
      {
        "id": "clinical-lesions",
        "description": "Presence of multiple umbilicated papules and nodules with central keratotic plugs primarily on extensor surfaces",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological evidence of transepidermal elimination of altered collagen fibers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-secondary-causes",
        "description": "Exclusion of acquired reactive perforating collagenosis and other perforating dermatoses",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical lesions, histopathology, and positive family history) must be met for diagnosis",
    "notes": "Diagnosis is primarily clinical supported by histopathology and family history; genetic testing is not routinely available."
  },
