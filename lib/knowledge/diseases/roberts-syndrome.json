  "diagnosticCriteria": {
    "formalCriteriaName": "Roberts Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "limb-malformations",
        "description": "Symmetrical limb reduction defects including phocomelia or hypomelia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial anomalies such as cleft lip and/or palate, hypertelorism, micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cytogenetic-abnormalities",
        "description": "Premature centromere separation and heterochromatin repulsion on metaphase chromosome analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Severe prenatal and postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-anomalies",
        "description": "Presence of congenital heart defects such as ventricular septal defect",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of symmetrical limb reduction defects and characteristic craniofacial anomalies with cytogenetic confirmation of premature centromere separation",
    "notes": "Diagnosis is supported by molecular genetic testing identifying biallelic mutations in ESCO2 gene."
  },
