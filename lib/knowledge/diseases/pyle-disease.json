  "diagnosticCriteria": {
    "formalCriteriaName": "Pyle Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "metaphyseal-widening",
        "description": "Marked metaphyseal widening and flaring of long bones on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cortical-thinning",
        "description": "Thinning of the cortical bone with increased bone fragility",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-bowing",
        "description": "Clinical presence of genu valgum (knock-knees) or other bone deformities",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic metaphyseal widening and cortical thinning on imaging plus clinical features consistent with bone deformities",
    "notes": "Genetic testing for SFRP4 mutations can support diagnosis but is not mandatory."
  },
