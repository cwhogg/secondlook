  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP during flares",
      "Anemia of chronic disease",
      "Anti-type II collagen antibodies (present in ~30-50%; not routinely available)",
      "Anti-matrilin-1 antibodies (research)",
      "CBC to screen for MDS/VEXAS"
    ],
    "imaging": [
      "CT airway: tracheal/bronchial wall thickening, narrowing, calcification",
      "Dynamic CT or MRI: tracheobronchomalacia on expiratory imaging",
      "PET-CT: FDG uptake in inflamed cartilage",
      "Echocardiography: aortic root dilation, valve regurgitation"
    ],
    "genetic": [
      "HLA-DR4 association",
      "UBA1 gene mutation testing to exclude VEXAS syndrome (somatic mutation in males)"
    ],
    "other": [
      "Pulmonary function tests: fixed upper airway obstruction pattern, flow-volume loop flattening",
      "Audiometry: sensorineural hearing loss",
      "Cartilage biopsy: loss of basophilic staining, perichondrial inflammation, chondrocyte depletion",
      "Bronchoscopy: airway inflammation, collapse, stenosis (but carries airway compromise risk)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "granulomatosis-with-polyangiitis",
      "distinguishingFeatures": [
        "GPA has saddle nose but also sinus/lung/kidney involvement",
        "GPA has positive PR3-ANCA",
        "GPA biopsy shows granulomatous vasculitis"
      ]
    },
    {
      "diseaseId": "rheumatoid-arthritis",
      "distinguishingFeatures": [
        "RA has erosive arthritis, positive RF/anti-CCP",
        "RA does not affect cartilage of ear/nose"
      ]
    },
    {
      "diseaseId": "iga-vasculitis",
      "distinguishingFeatures": [
        "IgA vasculitis (HSP) has palpable purpura, nephritis, GI symptoms",
        "IgA vasculitis biopsy shows IgA deposits"
      ]
    }
  ],
  "redFlags": [
    "Stridor or progressive dyspnea (life-threatening airway compromise)",
    "Sudden hearing loss (requires urgent treatment)",
    "New cardiac murmur (aortic regurgitation from aortitis)",
    "Tracheal collapse risk during anesthesia/intubation",
    "Features of VEXAS syndrome (MDS, thrombosis, macrocytosis in males)"
  ],
