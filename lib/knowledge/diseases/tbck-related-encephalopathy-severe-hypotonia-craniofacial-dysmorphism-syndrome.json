  "diagnosticCriteria": {
    "formalCriteriaName": "TBCK-related encephalopathy diagnostic criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the TBCK gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-hypotonia",
        "description": "Severe global hypotonia presenting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including prominent forehead, hypertelorism, and downslanting palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-neurodegeneration",
        "description": "Progressive neurodevelopmental regression or encephalopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "brain-imaging-abnormalities",
        "description": "Brain MRI showing cerebral atrophy and delayed myelination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic TBCK variants plus severe hypotonia and characteristic craniofacial dysmorphism",
    "notes": "Diagnosis is confirmed by genetic testing; clinical features support diagnosis and guide testing."
  },
