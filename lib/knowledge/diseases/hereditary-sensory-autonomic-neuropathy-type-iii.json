  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Dysautonomia Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the IKBKAP gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autonomic-dysfunction",
        "description": "Presence of autonomic nervous system abnormalities including blood pressure instability and impaired lacrimation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensory-neuropathy",
        "description": "Reduced pain and temperature sensation with preserved touch sensation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Recurrent pneumonia, gastrointestinal dysmotility, and poor growth",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic IKBKAP mutations plus clinical evidence of autonomic dysfunction and sensory neuropathy",
    "notes": "Genetic testing is confirmatory; clinical features guide initial suspicion"
  },
