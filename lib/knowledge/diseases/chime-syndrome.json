  "diagnosticCriteria": {
    "formalCriteriaName": "CHIME Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "coloboma",
        "description": "Presence of ocular coloboma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "heart-defect",
        "description": "Congenital heart defects such as atrial or ventricular septal defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ichthyosiform-dermatitis",
        "description": "Ichthyosiform skin changes or congenital ichthyosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mental-retardation",
        "description": "Developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ear-anomalies",
        "description": "Characteristic ear anomalies including low-set or malformed ears",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "epilepsy",
        "description": "Seizure disorders or epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (ocular coloboma, congenital heart defect, and ichthyosiform dermatitis) with supportive clinical features",
    "notes": "Genetic testing may support diagnosis but is not definitive; diagnosis is primarily clinical."
  },
