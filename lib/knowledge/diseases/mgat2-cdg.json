  "diagnosticCriteria": {
    "formalCriteriaName": "MGAT2-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "abnormal-n-glycosylation",
        "description": "Demonstration of abnormal N-glycosylation pattern on serum transferrin analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biallelic-mgat2-mutations",
        "description": "Identification of biallelic pathogenic variants in the MGAT2 gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features including severe psychomotor delay and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-laboratory",
        "description": "Supportive laboratory findings such as abnormal glycan profiles in fibroblasts or leukocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of abnormal N-glycosylation pattern, biallelic MGAT2 pathogenic variants, and characteristic clinical features",
    "notes": "Diagnosis is confirmed by molecular genetic testing combined with biochemical evidence of glycosylation defects."
  },
