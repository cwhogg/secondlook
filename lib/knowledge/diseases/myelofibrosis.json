  "diagnosticCriteria": {
    "formalCriteriaName": "WHO 2022 Diagnostic Criteria for Primary Myelofibrosis",
    "criteria": [
      {
        "id": "mf-c1",
        "description": "Megakaryocyte proliferation and atypia, accompanied by reticulin and/or collagen fibrosis grade >= 2 (overt PMF) or grade 0-1 (pre-fibrotic PMF)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mf-c2",
        "description": "Not meeting WHO criteria for ET, PV, BCR-ABL1+ CML, MDS, or other myeloid neoplasm",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mf-c3",
        "description": "Presence of JAK2, CALR, or MPL mutation, or other clonal marker",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "mf-c4",
        "description": "Anemia not attributable to comorbid condition",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "mf-c5",
        "description": "Leukocytosis >= 11,000/µL",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "mf-c6",
        "description": "Palpable splenomegaly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "mf-c7",
        "description": "Elevated LDH above institutional normal",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "mf-c8",
        "description": "Leukoerythroblastosis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All 3 major criteria plus at least 1 minor criterion (for overt PMF); all 3 major criteria plus at least 1 minor criterion (for pre-fibrotic PMF)",
    "notes": "Pre-fibrotic PMF has a better prognosis than overt PMF. DIPSS and MIPSS70 scores used for risk stratification."
  },
