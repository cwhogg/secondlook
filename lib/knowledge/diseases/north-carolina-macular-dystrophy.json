  "diagnosticCriteria": {
    "formalCriteriaName": "North Carolina Macular Dystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "family-history",
        "description": "Presence of autosomal dominant inheritance pattern with affected family members",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fundus-appearance",
        "description": "Characteristic congenital macular lesions including drusen-like deposits and macular scarring",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "visual-acuity-defect",
        "description": "Variable central vision defects ranging from mild to severe visual impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the MCDR1 locus on chromosome 6q16",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electrophysiology",
        "description": "Normal full-field electroretinogram (ERG) with possible abnormal multifocal ERG",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic macular lesions with compatible family history and central vision defects",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory; clinical diagnosis relies heavily on fundus findings and family history."
  },
