    "criteria": [
      {
        "id": "ecg-block",
        "description": "Evidence of atrioventricular block on fetal or neonatal electrocardiogram",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "maternal-autoantibodies",
        "description": "Presence of maternal anti-Ro/SSA or anti-La/SSB autoantibodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-structural-heart-disease",
        "description": "No evidence of structural congenital heart defects on echocardiography",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of atrioventricular block on ECG in the fetus or neonate plus maternal anti-Ro/SSA or anti-La/SSB antibodies",
    "notes": "Diagnosis is primarily clinical supported by serologic and electrocardiographic findings."
