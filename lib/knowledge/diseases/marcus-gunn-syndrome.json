    "formalCriteriaName": "Clinical diagnostic criteria for Marcus-Gunn jaw-winking syndrome",
    "criteria": [
      {
        "id": "jaw-winking-ptosis",
        "description": "Presence of unilateral ptosis with synchronous elevation of the upper eyelid on jaw movement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-onset",
        "description": "Onset of symptoms in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-neurological-deficits",
        "description": "No evidence of other neurological or muscular disorders causing ptosis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Unilateral ptosis with jaw-winking phenomenon present from infancy or early childhood",
    "notes": "Diagnosis is primarily clinical; electrophysiological studies may support but are not routinely required."
