  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Congenital Muscular Dystrophy with Intellectual Disability and Severe Epilepsy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early onset hypotonia and muscle weakness consistent with congenital muscular dystrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Presence of moderate to severe intellectual disability confirmed by neuropsychological assessment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-epilepsy",
        "description": "Refractory epilepsy with onset in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic variants identified in genes associated with congenital muscular dystrophy and neurodevelopmental disorders",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes and abnormal protein expression",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early onset muscular dystrophy with intellectual disability and severe epilepsy; genetic confirmation supports diagnosis but is not mandatory.",
    "notes": "Diagnosis requires multidisciplinary evaluation including neurology, genetics, and neuropsychology."
  },
