  "keyFindings": {
    "laboratory": [
      "Hypokalemia, hypomagnesemia, metabolic alkalosis on serum electrolyte panel",
      "Elevated plasma renin and aldosterone levels",
      "Normal or low serum calcium with occasional hypocalcemia"
    ],
    "imaging": [
      "Echocardiogram showing dilated left ventricle with reduced ejection fraction",
      "Renal ultrasound may show nephrocalcinosis"
    ],
    "genetic": [
      "RRAGD (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electrocardiogram abnormalities including arrhythmias",
      "Muscle biopsy rarely performed but may show nonspecific changes"
    ]
  },
  "differentialDiagnoses": [
