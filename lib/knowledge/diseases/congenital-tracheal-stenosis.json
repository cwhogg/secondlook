  "diagnosticCriteria": {
    "formalCriteriaName": "Congenital Tracheal Stenosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "tracheal-narrowing",
        "description": "Presence of intrinsic narrowing of the tracheal lumen confirmed by bronchoscopy or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "symptomatic-airway-obstruction",
        "description": "Clinical signs of airway obstruction such as stridor, respiratory distress, or recurrent respiratory infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "associated-cardiac-anomalies",
        "description": "Presence of associated congenital cardiovascular malformations (e.g., pulmonary artery sling)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of intrinsic tracheal narrowing confirmed by imaging or bronchoscopy plus clinical signs of airway obstruction",
    "notes": "Diagnosis is often confirmed by bronchoscopy and CT imaging; genetic testing may be considered if syndromic features are present."
  },
