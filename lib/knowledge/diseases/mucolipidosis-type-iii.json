  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and biochemical diagnostic criteria for Mucolipidosis III",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of UDP-N-acetylglucosamine-1-phosphotransferase enzyme activity in fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of progressive skeletal abnormalities including dysostosis multiplex and joint stiffness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in GNPTAB or GNPTG genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-mucolipids",
        "description": "Elevated urinary excretion of multiple lysosomal enzymes and mucolipids",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical features consistent with mucolipidosis III plus either enzyme deficiency or biallelic pathogenic variants in GNPTAB/GNPTG",
    "notes": "Diagnosis is confirmed by biochemical enzyme assay and/or molecular genetic testing."
  },
