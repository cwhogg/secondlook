{
  "id": "subacute-sclerosing-panencephalitis",
  "name": "Subacute Sclerosing Panencephalitis",
  "aliases": [
    "SSPE",
    "Dawson's encephalitis"
  ],
  "icd10Codes": [
    "G04.1"
  ],
  "omimId": "605283",
  "orphanetId": "791",
  "prevalence": {
    "estimate": "1 in 100,000 to 1 in 1,000,000",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 5,
      "max": 15,
      "peak": 8
    },
    "sexPredilection": "slight-male",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Jabbour Criteria",
    "criteria": [
      {
        "id": "clinical-course",
        "description": "Progressive cognitive decline and behavioral changes over months to years",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroencephalogram",
        "description": "Periodic, stereotyped, high-voltage slow-wave complexes on EEG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "measles-antibody",
        "description": "Elevated measles antibody titers in cerebrospinal fluid or serum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Brain biopsy showing characteristic viral inclusions and gliosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-seizures",
        "description": "Presence of myoclonic seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive neurological decline plus typical EEG findings and elevated measles antibody titers in CSF or serum",
    "notes": "Brain biopsy is rarely required but can confirm diagnosis"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Periodic myoclonic jerks",
        "frequency": 0.85,
        "bodySystem": "neurological",
        "notes": "Characteristic periodic myoclonic seizures are highly suggestive"
      },
      {
        "symptomName": "Cognitive decline progressing to dementia",
        "frequency": 0.9,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Periodic stereotyped EEG complexes",
        "frequency": 0.75,
        "bodySystem": "neurological",
        "notes": "Electroencephalogram pattern is diagnostic"
      }
    ],
    "common": [
      {
        "symptomName": "Behavioral changes including irritability and personality alteration",
        "frequency": 0.7,
        "bodySystem": "psychiatric"
      },
      {
        "symptomName": "Seizures other than myoclonic jerks",
        "frequency": 0.65,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Ataxia and motor incoordination",
        "frequency": 0.6,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Visual disturbances including optic atrophy",
        "frequency": 0.55,
        "bodySystem": "ophthalmological"
      },
      {
        "symptomName": "Muscle weakness and spasticity",
        "frequency": 0.5,
        "bodySystem": "neurological"
      }
    ],
    "occasional": [
      {
        "symptomName": "Dysarthria and speech difficulties",
        "frequency": 0.4,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Choreoathetosis or abnormal involuntary movements",
        "frequency": 0.3,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Headache",
        "frequency": 0.25,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Fatigue and lethargy",
        "frequency": 0.2,
        "bodySystem": "constitutional"
      },
      {
        "symptomName": "Sleep disturbances",
        "frequency": 0.15,
        "bodySystem": "neurological"
      }
    ],
    "rare": [
      {
        "symptomName": "Hydrocephalus",
        "frequency": 0.05,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Autonomic dysfunction",
        "frequency": 0.03,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Psychosis",
        "frequency": 0.02,
        "bodySystem": "psychiatric"
      }
    ]
  },
  "systemsAffected": [
    "neurological",
    "psychiatric",
    "ophthalmological",
    "constitutional"
  ],
  "keyFindings": {
    "laboratory": [
      "Elevated measles-specific IgG antibody titers in cerebrospinal fluid and serum",
      "Mild lymphocytic pleocytosis in CSF"
    ],
    "imaging": [
      "MRI brain showing white matter demyelination and cortical atrophy",
      "EEG with periodic, stereotyped high-voltage slow-wave complexes"
    ],
    "genetic": [],
    "other": [
      "Brain biopsy demonstrating viral inclusions and gliosis (rarely performed)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "progressive-multifocal-leukoencephalopathy",
      "distinguishingFeatures": [
        "JC virus infection in immunocompromised patients",
        "Absence of measles antibody elevation",
        "MRI shows multifocal demyelination without periodic EEG complexes"
      ]
    },
    {
      "diseaseId": "juvenile-onset-alzheimer-disease",
      "distinguishingFeatures": [
        "Gradual cognitive decline without seizures",
        "No measles virus involvement",
        "Normal EEG without periodic complexes"
      ]
    },
    {
      "diseaseId": "mitochondrial-encephalomyopathy",
      "distinguishingFeatures": [
        "Multisystem involvement including muscle and metabolic abnormalities",
        "Lactic acidosis on laboratory testing",
        "No measles antibody elevation or characteristic EEG"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive cognitive decline in a child or adolescent",
    "Periodic myoclonic jerks with characteristic EEG pattern",
    "History of measles infection or lack of measles vaccination"
  ],
  "specialistType": [
    "Neurologist",
    "Infectious Disease Specialist",
    "Pediatrician"
  ],
  "lastUpdated": "2026-02-17",
  "references": [
