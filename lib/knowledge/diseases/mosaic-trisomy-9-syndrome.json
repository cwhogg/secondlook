  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Mosaic Trisomy 9",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Detection of trisomy 9 mosaicism in peripheral blood or other tissues by karyotyping or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial anomalies including micrognathia, cleft palate, and low-set ears",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-malformations",
        "description": "Presence of congenital malformations such as cardiac defects, skeletal abnormalities, or renal anomalies",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of trisomy 9 mosaicism plus at least one major clinical feature",
    "notes": "Diagnosis requires cytogenetic evidence due to phenotypic variability and mosaicism levels."
  },
