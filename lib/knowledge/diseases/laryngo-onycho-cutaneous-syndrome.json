  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnostic criteria for LOC syndrome",
    "criteria": [
      {
        "id": "laryngeal-involvement",
        "description": "Presence of laryngeal mucosal erosions and granulation tissue causing hoarseness or respiratory distress",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "onychodystrophy",
        "description": "Congenital nail dystrophy characterized by thickened, dystrophic, or absent nails",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-lesions",
        "description": "Chronic cutaneous erosions and granulation tissue primarily on the dorsal hands and feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "plectin-gene-mutation",
        "description": "Identification of pathogenic mutations in the PLEC gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing epidermolysis with granulation tissue and absence of basement membrane zone abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical features (laryngeal involvement, onychodystrophy, cutaneous lesions) plus identification of PLEC gene mutation",
    "notes": "Diagnosis is confirmed by genetic testing; clinical presentation may vary in severity."
  },
