  "diagnosticCriteria": {
    "formalCriteriaName": "Multi-minicore Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of multiple small cores with reduced oxidative enzyme activity on muscle biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Congenital or early-onset hypotonia and proximal muscle weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in SEPN1 or RYR1 genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "Myopathic changes on electromyography",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-involvement",
        "description": "Evidence of restrictive respiratory insufficiency",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic muscle biopsy findings plus clinical features of hypotonia and weakness; genetic confirmation supports diagnosis",
    "notes": "Genetic heterogeneity exists; some cases lack identifiable mutations."
  },
