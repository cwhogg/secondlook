  "diagnosticCriteria": {
    "formalCriteriaName": "Pulmonary Capillary Hemangiomatosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histopathological evidence of proliferation of pulmonary capillaries within alveolar septa",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-hypertension",
        "description": "Presence of pulmonary arterial hypertension confirmed by right heart catheterization",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of pulmonary hypertension such as pulmonary veno-occlusive disease and chronic thromboembolic pulmonary hypertension",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Characteristic radiologic findings on high-resolution CT including diffuse ground-glass opacities and septal thickening",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of capillary proliferation plus evidence of pulmonary hypertension and exclusion of other causes",
    "notes": "Definitive diagnosis requires lung biopsy; clinical and imaging findings support diagnosis but are not definitive alone."
  },
