  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Diagnostic Criteria for G6PD Deficiency",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced G6PD enzyme activity in red blood cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemolytic-anemia",
        "description": "Episodic hemolytic anemia triggered by oxidative stress (e.g., infections, drugs, fava beans)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic G6PD gene variants",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "blood-smear",
        "description": "Presence of Heinz bodies and bite cells on peripheral blood smear",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Reduced G6PD enzyme activity plus clinical evidence of hemolytic anemia",
    "notes": "Genetic testing supports diagnosis but is not mandatory; enzyme activity testing may be falsely normal during acute hemolysis."
  },
