  "keyFindings": {
    "laboratory": [
      "Elevated serum cholesterol and triglycerides in some cases",
      "Normal or mildly elevated inflammatory markers"
    ],
    "imaging": [
      "Radiographic evidence of acro-osteolysis",
      "Delayed cranial suture closure on skull X-ray",
      "Basal ganglia calcifications on CT brain"
    ],
    "genetic": [
      "Mutations in LMNA gene (Type A)",
      "Mutations in ZMPSTE24 gene (Type B)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy showing loss of subcutaneous fat",
      "Electrocardiogram abnormalities in some patients"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hutchinson-gilford-progeria-syndrome",
      "distinguishingFeatures": [
        "Earlier onset in infancy",
        "More severe growth retardation",
        "Characteristic 'bird-like' facies with prominent scalp veins"
      ]
    },
    {
      "diseaseId": "werner-syndrome",
      "distinguishingFeatures": [
        "Adult onset typically in 20s-30s",
        "Premature aging with cataracts and diabetes",
        "No acro-osteolysis"
      ]
    },
    {
      "diseaseId": "biallelic-zmpste24-deficiency",
      "distinguishingFeatures": [
        "Severe progeroid features with early lethality",
        "More pronounced lipodystrophy",
        "Severe skeletal abnormalities"
      ]
    }
  ],
