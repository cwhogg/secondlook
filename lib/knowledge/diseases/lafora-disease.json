  ],
  "keyFindings": {
    "laboratory": [
      "Skin biopsy showing Lafora bodies with periodic acid-Schiff (PAS) staining",
      "Elevated lactate in cerebrospinal fluid in some cases"
    ],
    "imaging": [
      "MRI brain may show cerebral and cerebellar atrophy in advanced stages",
      "EEG with generalized epileptiform discharges and background slowing"
    ],
    "genetic": [
      "Mutations in EPM2A gene (encoding laforin)",
      "Mutations in NHLRC1 gene (encoding malin)"
    ],
    "other": [
      "Progressive neurological deterioration despite treatment",
      "Poor response to conventional antiepileptic drugs"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "unverricht-lundborg-disease",
      "distinguishingFeatures": [
        "Later onset (usually 6-16 years)",
        "Slower progression",
        "Absence of Lafora bodies"
      ]
    },
    {
      "diseaseId": "myoclonic-epilepsy-with-ragged-red-fibers",
      "distinguishingFeatures": [
        "Mitochondrial inheritance pattern",
        "Presence of ragged-red fibers on muscle biopsy",
        "Systemic involvement including myopathy"
      ]
    }
  ],
  "redFlags": [
