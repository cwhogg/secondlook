  "diagnosticCriteria": {
    "formalCriteriaName": "Centronuclear Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Muscle biopsy showing centrally located nuclei in the majority of muscle fibers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in genes associated with autosomal recessive centronuclear myopathy (e.g., BIN1, DNM2, MTM1 in rare cases)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Progressive muscle weakness predominantly affecting proximal muscles with hypotonia and delayed motor milestones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Electromyography showing myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-causes",
        "description": "Exclusion of other neuromuscular disorders by clinical, laboratory, and genetic testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic muscle biopsy findings plus biallelic pathogenic variants in associated genes and compatible clinical features",
    "notes": "Muscle biopsy and genetic testing are essential for definitive diagnosis."
  },
