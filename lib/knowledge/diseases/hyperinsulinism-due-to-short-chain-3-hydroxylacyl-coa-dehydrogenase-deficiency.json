  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for congenital hyperinsulinism due to SCHAD deficiency",
    "criteria": [
      {
        "id": "hypoglycemia",
        "description": "Persistent hypoglycemia with inappropriately elevated insulin levels during hypoglycemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of reduced or absent short chain 3-hydroxylacyl-CoA dehydrogenase enzyme activity in liver or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the HADH gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-treatment",
        "description": "Clinical response to diazoxide therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-causes",
        "description": "Exclusion of other causes of congenital hyperinsulinism such as mutations in ABCC8 or KCNJ11",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent hypoglycemia with elevated insulin plus either enzyme deficiency or pathogenic HADH mutation",
    "notes": "Diagnosis requires biochemical confirmation and genetic testing due to overlap with other hyperinsulinism forms."
  },
