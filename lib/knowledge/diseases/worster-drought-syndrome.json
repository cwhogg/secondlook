  "diagnosticCriteria": {
    "formalCriteriaName": "Worster-Drought Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "bilateral-pseudobulbar-palsy",
        "description": "Presence of bilateral upper motor neuron pseudobulbar palsy affecting cranial nerves IX, X, and XII",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-or-early-onset",
        "description": "Congenital or early infancy onset of symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-progressive-neurodegeneration",
        "description": "Lack of progressive neurodegenerative disease or structural brain lesions explaining symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oromotor-dysfunction",
        "description": "Oromotor dysfunction including impaired tongue movement, drooling, and dysphagia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "speech-impairment",
        "description": "Dysarthria or absent speech development",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met for diagnosis",
    "notes": "Diagnosis is clinical and supported by exclusion of other causes"
  },
