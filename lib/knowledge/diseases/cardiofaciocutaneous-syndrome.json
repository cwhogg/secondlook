  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Cardiofaciocutaneous Syndrome",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive craniofacial features including high forehead, bitemporal narrowing, and downslanting palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-defects",
        "description": "Presence of congenital heart defects such as pulmonic stenosis or hypertrophic cardiomyopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-abnormalities",
        "description": "Skin abnormalities including sparse, curly hair, ichthyosis, and hyperkeratosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic mutation in BRAF, MEK1 (MAP2K1), or MEK2 (MAP2K2) genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical features (facial dysmorphism, cardiac defects, and cutaneous abnormalities) with or without genetic confirmation",
    "notes": "Genetic testing is strongly recommended to confirm diagnosis and differentiate from related RASopathies."
  },
