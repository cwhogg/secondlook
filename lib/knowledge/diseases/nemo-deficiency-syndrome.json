  "keyFindings": {
    "laboratory": [
      "Reduced NF-kB activation in immune cells",
      "Lymphopenia with decreased T and B cell counts",
      "Hypogammaglobulinemia"
    ],
    "imaging": [
      "Chest X-ray may show recurrent pneumonia",
      "Abdominal ultrasound may reveal hepatosplenomegaly"
    ],
