  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Immunological Diagnostic Criteria for MHC Class II Deficiency",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Recurrent severe bacterial, viral, and opportunistic infections beginning in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotyping",
        "description": "Absent or markedly reduced expression of MHC class II molecules on antigen-presenting cells by flow cytometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in genes regulating MHC class II expression (e.g., CIITA, RFXANK, RFX5, RFXAP)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunoglobulin-levels",
        "description": "Hypogammaglobulinemia with low or absent class-switched immunoglobulins",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cd4-lymphopenia",
        "description": "Markedly reduced CD4+ T cell counts",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent severe infections plus absent MHC class II expression on antigen-presenting cells and identification of pathogenic variants in MHC class II regulatory genes",
    "notes": "Diagnosis requires integration of clinical, immunological, and genetic data."
  },
