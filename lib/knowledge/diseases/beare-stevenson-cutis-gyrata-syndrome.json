  "diagnosticCriteria": {
    "formalCriteriaName": "Beare-Stevenson Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of cranial sutures, especially coronal and lambdoid",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutis-gyrata",
        "description": "Cutis gyrata characterized by furrowed, ridged skin folds primarily on the scalp and face",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midface-hypoplasia",
        "description": "Midface hypoplasia with prominent forehead and depressed nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-tag",
        "description": "Presence of multiple skin tags or acrochordons",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic FGFR2 gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (craniosynostosis, cutis gyrata, midface hypoplasia) or confirmed FGFR2 mutation with two major clinical features",
    "notes": "Genetic testing for FGFR2 mutations is strongly recommended to confirm diagnosis."
  },
