        "Absence of FMR1 premutation",
        "More rapid progression",
        "Prominent autonomic failure"
      ]
    },
    {
      "diseaseId": "essential-tremor",
      "distinguishingFeatures": [
        "No ataxia or cognitive decline",
        "No FMR1 premutation",
        "Tremor primarily postural and kinetic"
      ]
    },
    {
      "diseaseId": "spinocerebellar-ataxia",
