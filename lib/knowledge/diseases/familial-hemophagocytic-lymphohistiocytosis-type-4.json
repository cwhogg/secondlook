  "diagnosticCriteria": {
    "formalCriteriaName": "HLH-2004 Diagnostic Criteria",
    "criteria": [
      {
        "id": "fever",
        "description": "Persistent high fever",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cytopenias",
        "description": "Cytopenias affecting ≥2 of 3 lineages in peripheral blood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemophagocytosis",
        "description": "Hemophagocytosis in bone marrow, spleen, or lymph nodes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "lowNKactivity",
        "description": "Low or absent natural killer (NK) cell activity",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hyperferritinemia",
        "description": "Elevated ferritin levels (>500 ng/mL)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "geneticMutation",
        "description": "Biallelic pathogenic mutations in STX11 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of molecular diagnosis (biallelic STX11 mutations) or at least 5 of 8 HLH-2004 clinical criteria including fever, cytopenias, and hyperferritinemia",
    "notes": "Genetic testing is critical for confirmation due to overlap with secondary HLH."
  },
