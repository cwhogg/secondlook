  "diagnosticCriteria": {
    "formalCriteriaName": "Cantu Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypertrichosis",
        "description": "Congenital generalized hypertrichosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-anomalies",
        "description": "Cardiac anomalies including cardiomegaly, pericardial effusion, or patent ductus arteriosus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Distinctive coarse facial features including broad nasal bridge, full lips, and epicanthal folds",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal abnormalities such as osteochondrodysplasia or broad thumbs",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in ABCC9 or KCNJ8 genes",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital hypertrichosis, cardiac anomalies, and distinctive facial features; genetic confirmation supports diagnosis",
    "notes": "Genetic testing for ABCC9 or KCNJ8 mutations is highly supportive but not mandatory if clinical criteria are met"
  },
