        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in genes associated with pancreatic development (e.g., PDX1, GATA6)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "endocrine-dysfunction",
        "description": "Presence of diabetes mellitus or impaired glucose tolerance due to endocrine insufficiency",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of imaging-confirmed partial absence of pancreatic tissue plus clinical or laboratory evidence of exocrine insufficiency",
    "notes": "Genetic testing supports diagnosis but is not mandatory."
