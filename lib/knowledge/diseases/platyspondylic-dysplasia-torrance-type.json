  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Platyspondylic Dysplasia, Torrance Type",
    "criteria": [
      {
        "id": "platyspondyly",
        "description": "Marked platyspondyly (flattened vertebral bodies) evident on spinal radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-limbed-dwarfism",
        "description": "Severe short-limbed dwarfism with disproportionate shortening of the limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metaphyseal-abnormalities",
        "description": "Metaphyseal irregularities and flaring seen on long bone radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia and frontal bossing",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the COL2A1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of marked platyspondyly and short-limbed dwarfism with metaphyseal abnormalities on radiographs",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical and radiological features are definitive."
  },
