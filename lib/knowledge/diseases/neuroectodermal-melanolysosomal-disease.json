      "MRI showing basal ganglia hyperintensities and cerebral atrophy",
      "CT scan may reveal calcifications in deep brain nuclei"
    ],
    "genetic": [
      "MYO5A (causative)",
      "Autosomal recessive inheritance pattern confirmed by family studies"
    ],
    "other": [
      "Histopathology demonstrating melanin-laden lysosomes in neural and skin biopsy specimens"
    ]
  },
