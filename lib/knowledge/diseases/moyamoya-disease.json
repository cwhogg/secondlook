  "keyFindings": {
    "laboratory": [
      "Generally normal routine blood tests",
      "Exclusion of autoimmune markers and coagulation disorders"
    ],
    "imaging": [
      "Cerebral angiography showing stenosis/occlusion of distal internal carotid arteries",
      "Prominent basal collateral vessels (moyamoya vessels)",
      "MRI/MRA demonstrating ischemic lesions and vessel abnormalities"
    ],
    "genetic": [
      "TWIST2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Neuropsychological testing may reveal cognitive deficits"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "atherosclerotic-cerebrovascular-disease",
      "distinguishingFeatures": [
        "Older age of onset",
        "Presence of vascular risk factors (hypertension, diabetes, hyperlipidemia)",
        "Absence of moyamoya collateral vessels on angiography"
      ]
    },
    {
      "diseaseId": "vasculitis-of-central-nervous-system",
      "distinguishingFeatures": [
        "Systemic inflammatory signs",
        "Positive autoimmune markers",
        "Inflammatory changes on vessel wall imaging"
      ]
    },
    {
      "diseaseId": "fibromuscular-dysplasia",
      "distinguishingFeatures": [
        "Involvement of extracranial arteries",
        "Characteristic 'string of beads' appearance on angiography",
        "Less common in intracranial vessels"
      ]
    }
  ],
  "redFlags": [
    "Sudden onset hemiparesis or aphasia",
    "Recurrent transient ischemic attacks",
    "Intracranial hemorrhage in young patients"
  ],
