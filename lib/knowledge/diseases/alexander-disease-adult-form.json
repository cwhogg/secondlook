  "diagnosticCriteria": {
    "formalCriteriaName": "Adult Alexander Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "gfap-mutation",
        "description": "Presence of pathogenic GFAP gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bulbar-dysfunction",
        "description": "Progressive bulbar dysfunction including dysarthria and dysphagia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "white-matter-changes",
        "description": "MRI evidence of frontal white matter abnormalities with contrast enhancement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "spasticity",
        "description": "Spasticity and pyramidal signs in limbs",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-leukodystrophies",
        "description": "Exclusion of other leukodystrophies by clinical and genetic testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic GFAP mutation plus progressive bulbar dysfunction and characteristic MRI findings",
    "notes": "Diagnosis is confirmed by genetic testing and characteristic neuroimaging; clinical presentation may vary."
  },
