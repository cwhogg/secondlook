  "diagnosticCriteria": {
    "formalCriteriaName": "Budd-Chiari Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "hepatic-vein-obstruction",
        "description": "Evidence of hepatic vein or inferior vena cava obstruction on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of hepatomegaly, ascites, and abdominal pain",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-function-abnormalities",
        "description": "Elevated liver enzymes and signs of liver congestion",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of portal hypertension and liver disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hepatic vein or IVC obstruction on imaging plus clinical features consistent with hepatic congestion",
    "notes": "Liver biopsy may be supportive but is not mandatory"
  },
