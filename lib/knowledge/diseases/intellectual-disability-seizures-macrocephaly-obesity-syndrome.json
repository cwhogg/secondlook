  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Intellectual Disability-Seizures-Macrocephaly-Obesity Syndrome",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of global developmental delay or intellectual disability confirmed by standardized cognitive testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "Recurrent unprovoked seizures of variable type documented clinically or by EEG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "macrocephaly",
        "description": "Head circumference greater than 2 standard deviations above the mean for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "obesity",
        "description": "Body mass index (BMI) above the 95th percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-features",
        "description": "Additional features such as hypotonia, behavioral abnormalities, or dysmorphic facial features",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of intellectual disability, seizures, macrocephaly, and obesity",
    "notes": "Diagnosis is clinical and supported by exclusion of other syndromes with overlapping features."
  },
