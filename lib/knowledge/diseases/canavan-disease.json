  "diagnosticCriteria": {
    "formalCriteriaName": "Canavan Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the ASPA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-n-acetylaspartate",
        "description": "Elevated N-acetylaspartate (NAA) levels in brain MR spectroscopy or urine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive developmental delay with hypotonia and macrocephaly in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mri-findings",
        "description": "Diffuse symmetric white matter abnormalities with spongiform changes on MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic ASPA mutations plus elevated NAA levels and consistent clinical presentation",
    "notes": "Genetic testing is definitive; biochemical and imaging studies support diagnosis."
  },
