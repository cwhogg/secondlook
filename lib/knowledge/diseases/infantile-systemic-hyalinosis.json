  "keyFindings": {
    "laboratory": [
      "Mild anemia with normocytic normochromic indices",
      "Hypoalbuminemia due to protein-losing enteropathy",
      "Elevated inflammatory markers (ESR, CRP) in some cases"
    ],
    "imaging": [
      "Radiographs showing joint contractures and osteopenia",
      "Ultrasound may reveal hepatomegaly",
      "Chest X-ray may show restrictive lung changes"
    ],
    "genetic": [
      "ANTXR2 (causative)",
      "Autosomal recessive inheritance pattern"
    ],
    "other": [
      "Histopathology demonstrating hyaline material deposits in skin and connective tissue biopsies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "juvenile-hyaline-fibromatosis",
      "distinguishingFeatures": [
        "Less severe systemic involvement",
        "Later onset compared to infantile systemic hyalinosis",
        "Less prominent gastrointestinal symptoms"
      ]
    },
    {
      "diseaseId": "mucopolysaccharidoses",
      "distinguishingFeatures": [
        "Presence of coarse facial features",
        "Characteristic lysosomal enzyme deficiencies",
        "Different genetic mutations and storage material"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive joint contractures with severe pain",
    "Failure to thrive with chronic diarrhea and malabsorption",
    "Widespread cutaneous nodules and plaques with hyaline deposits"
  ],
