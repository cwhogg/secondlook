  "diagnosticCriteria": {
    "formalCriteriaName": "Pediatric Hepatocellular Carcinoma Diagnostic Criteria",
    "criteria": [
      {
        "id": "imaging",
        "description": "Characteristic liver mass with arterial phase hyperenhancement and venous/delayed phase washout on imaging (CT or MRI)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alpha-fetoprotein",
        "description": "Elevated serum alpha-fetoprotein (AFP) levels above age-adjusted normal range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological confirmation of hepatocellular carcinoma on liver biopsy or surgical specimen",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of hepatomegaly or abdominal mass with or without constitutional symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic imaging findings plus either elevated AFP or histopathological confirmation",
    "notes": "Liver biopsy may be contraindicated in some cases due to bleeding risk; diagnosis can be made based on imaging and AFP in typical cases."
  },
