  "diagnosticCriteria": {
    "formalCriteriaName": "Comprehensive Diagnostic Criteria for IgG4-Related Disease",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Swelling or enlargement of the submandibular gland(s)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serum-igg4-elevation",
        "description": "Elevated serum IgG4 concentration (>135 mg/dL)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histopathological findings showing dense lymphoplasmacytic infiltration rich in IgG4-positive plasma cells, storiform fibrosis, and obliterative phlebitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Characteristic imaging findings on ultrasound, CT, or MRI showing gland enlargement with homogeneous enhancement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of typical clinical presentation, elevated serum IgG4, and confirmatory histopathology",
    "notes": "Diagnosis requires exclusion of malignancy and other causes of sialadenitis"
  },
