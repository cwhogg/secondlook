  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; metabolic screening typically unremarkable"
    ],
    "imaging": [
      "Brain MRI showing cortical dysplasia, hypoplasia, or other structural anomalies",
      "EEG demonstrating multifocal epileptiform discharges"
    ],
    "genetic": [
      "PIGG (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Developmental assessments confirming intellectual disability",
      "Clinical observation of refractory seizures"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "early-infantile-epileptic-encephalopathy",
      "distinguishingFeatures": [
        "More severe seizure onset within first months of life",
        "Often associated with specific genetic mutations distinct from EOE-ID-BA syndrome",
        "May lack structural brain anomalies"
      ]
    },
    {
      "diseaseId": "cortical-dysplasia-associated-epilepsy",
      "distinguishingFeatures": [
        "Focal seizures rather than generalized early-onset epilepsy",
        "Brain MRI shows localized cortical dysplasia without global brain anomalies",
        "Intellectual disability may be less severe or absent"
      ]
    }
  ],
