  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Rubinstein-Taybi Syndrome due to 16p13.3 Microdeletion",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including downslanting palpebral fissures, prominent nasal bridge, and broad nasal tip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "broad-thumb-hallux",
        "description": "Broad and angulated thumbs and halluces",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "16p13-3-microdeletion",
        "description": "Confirmed heterozygous microdeletion at chromosome 16p13.3 involving CREBBP gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital heart defects such as patent ductus arteriosus or atrial septal defect",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic facial dysmorphism, broad thumbs/halluces, intellectual disability, and confirmed 16p13.3 microdeletion",
    "notes": "Genetic testing is essential to confirm diagnosis due to phenotypic overlap with other syndromes."
  },
