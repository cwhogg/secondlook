        "Normal total IgG levels"
      ]
    },
    {
      "diseaseId": "secondary-immunodeficiency",
      "distinguishingFeatures": [
        "Presence of underlying cause such as HIV, malignancy, or immunosuppressive therapy",
        "Reversible immunoglobulin abnormalities upon treatment of underlying cause"
      ]
    }
  ],
