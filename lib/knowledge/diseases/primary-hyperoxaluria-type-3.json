    "formalCriteriaName": "Diagnostic criteria for Primary Hyperoxaluria Type 3",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the HOGA1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyperoxaluria",
        "description": "Elevated urinary oxalate excretion confirmed by 24-hour urine collection",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "kidney-stones",
        "description": "Recurrent calcium oxalate kidney stones or nephrocalcinosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-ph1-ph2",
        "description": "Exclusion of Primary Hyperoxaluria Types 1 and 2 by genetic testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic HOGA1 mutations plus elevated urinary oxalate and clinical evidence of kidney stones or nephrocalcinosis",
    "notes": "Diagnosis requires genetic confirmation due to overlap with other hyperoxaluria types."
  },
