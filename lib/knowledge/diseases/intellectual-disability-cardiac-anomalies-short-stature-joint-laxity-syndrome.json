  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Intellectual Disability-Cardiac Anomalies-Short Stature-Joint Laxity Syndrome",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of intellectual disability ranging from mild to moderate severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-anomalies",
        "description": "Congenital cardiac anomalies including septal defects or valvular abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Postnatal short stature below the 3rd percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-laxity",
        "description": "Generalized joint hypermobility confirmed by clinical assessment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including broad nasal bridge and prominent forehead",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Delayed motor milestones and speech development",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of intellectual disability, congenital cardiac anomalies, short stature, and joint laxity",
    "notes": "Diagnosis is clinical and supported by genetic testing when available"
  },
