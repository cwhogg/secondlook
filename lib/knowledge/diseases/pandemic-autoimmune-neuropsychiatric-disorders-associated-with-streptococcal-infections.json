  "diagnosticCriteria": {
    "formalCriteriaName": "Swedo Criteria for PANDAS",
    "criteria": [
      {
        "id": "sudden-onset-ocd-or-tics",
        "description": "Presence of obsessive-compulsive disorder and/or tic disorder with abrupt onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pediatric-onset",
        "description": "Onset of symptoms between age 3 and puberty",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "temporal-association-strep",
        "description": "Temporal association between symptom onset/exacerbations and group A beta-hemolytic streptococcal infection",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-abnormalities",
        "description": "Presence of neurological abnormalities such as motor hyperactivity or choreiform movements",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "episodic-course",
        "description": "Episodic course of symptom severity with sudden exacerbations and remissions",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met: abrupt onset of OCD/tics, pediatric onset, and temporal association with streptococcal infection.",
    "notes": "Diagnosis is clinical; laboratory confirmation of streptococcal infection supports diagnosis but is not definitive."
  },
