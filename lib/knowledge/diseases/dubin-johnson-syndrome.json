  "keyFindings": {
    "laboratory": [
      "Elevated conjugated (direct) bilirubin with normal or mildly elevated liver enzymes",
      "Urinary coproporphyrin I isomer >80% of total coproporphyrin",
      "Normal serum bile acids"
    ],
    "imaging": [
      "Ultrasound may show normal liver or mild hepatomegaly",
      "No biliary obstruction"
    ],
    "genetic": [
      "ABCC2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Liver biopsy showing coarse, dark melanin-like pigment in hepatocytes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "rotor-syndrome",
      "distinguishingFeatures": [
        "Absence of pigment deposition in liver biopsy",
        "Normal urinary coproporphyrin I isomer ratio",
        "Benign conjugated hyperbilirubinemia with similar clinical presentation"
      ]
    },
    {
      "diseaseId": "gilbert-syndrome",
      "distinguishingFeatures": [
        "Predominantly unconjugated hyperbilirubinemia",
        "Normal liver histology",
        "No pigment deposition"
      ]
    },
    {
      "diseaseId": "cholestatic-liver-disease",
      "distinguishingFeatures": [
        "Elevated liver enzymes",
        "Signs of hepatocellular injury or inflammation",
        "Possible biliary obstruction on imaging"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive jaundice",
    "Signs of liver failure (encephalopathy, coagulopathy)",
    "Markedly elevated liver enzymes or bilirubin"
  ],
