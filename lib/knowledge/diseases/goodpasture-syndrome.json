  "diagnosticCriteria": {
    "formalCriteriaName": "Anti-GBM Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "anti-gbm-antibodies",
        "description": "Presence of circulating anti-glomerular basement membrane antibodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-involvement",
        "description": "Rapidly progressive glomerulonephritis with hematuria and proteinuria",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-hemorrhage",
        "description": "Diffuse alveolar hemorrhage or pulmonary hemorrhage",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-biopsy",
        "description": "Renal biopsy showing linear IgG deposition along the glomerular basement membrane",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of circulating anti-GBM antibodies plus clinical evidence of glomerulonephritis and/or pulmonary hemorrhage",
    "notes": "Diagnosis is confirmed by renal biopsy and serologic testing for anti-GBM antibodies."
  },
