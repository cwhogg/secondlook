  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Bilateral Renal Hypoplasia",
    "criteria": [
      {
        "id": "reduced-kidney-size",
        "description": "Bilateral kidneys with reduced size confirmed by imaging (ultrasound or MRI)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "reduced-nephron-number",
        "description": "Histological evidence of reduced nephron number if biopsy performed",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "impaired-renal-function",
        "description": "Evidence of impaired renal function such as elevated serum creatinine or decreased glomerular filtration rate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-malformations",
        "description": "Exclusion of other renal malformations such as dysplasia or cystic kidney disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Bilateral reduced kidney size on imaging plus evidence of impaired renal function, with exclusion of other renal malformations",
    "notes": "Genetic testing may be supportive but is not diagnostic; biopsy is rarely performed."
  },
