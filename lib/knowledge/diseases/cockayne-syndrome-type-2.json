  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Cockayne Syndrome",
    "criteria": [
      {
        "id": "growth-retardation",
        "description": "Severe postnatal growth failure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-deterioration",
        "description": "Progressive neurodegeneration with microcephaly and developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "photosensitivity",
        "description": "Marked photosensitivity without increased skin cancer risk",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facies",
        "description": "Cachectic appearance with sunken eyes, thin nose, and aged facial features",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-abnormalities",
        "description": "Bilateral cataracts and pigmentary retinopathy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "dna-repair-defect",
        "description": "Defective nucleotide excision repair demonstrated by cellular assays",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (growth retardation, neurological deterioration, photosensitivity) plus supportive genetic or cellular evidence",
    "notes": "Genetic confirmation via ERCC6 or ERCC8 mutations supports diagnosis"
  },
