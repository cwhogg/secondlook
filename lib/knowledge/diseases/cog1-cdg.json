  "diagnosticCriteria": {
    "formalCriteriaName": "CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "abnormal-transferrin-glycosylation",
        "description": "Presence of abnormal serum transferrin glycosylation pattern detected by isoelectric focusing or mass spectrometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pathogenic-cog1-mutation",
        "description": "Identification of biallelic pathogenic variants in the COG1 gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of multisystem clinical features consistent with CDG including developmental delay and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-glycosylation-of-other-proteins",
        "description": "Demonstration of defective glycosylation of other serum glycoproteins (e.g., apolipoprotein C-III)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Abnormal transferrin glycosylation plus biallelic pathogenic COG1 variants with compatible clinical features",
    "notes": "Diagnosis requires integration of biochemical, genetic, and clinical data."
  },
