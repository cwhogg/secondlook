  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Granular Corneal Dystrophy",
    "criteria": [
      {
        "id": "corneal-hyaline-deposits",
        "description": "Presence of discrete, sharply demarcated hyaline deposits in the corneal stroma visible on slit-lamp examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-vision-loss",
        "description": "Progressive decrease in visual acuity due to stromal opacities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pathogenic-ctgf-mutation",
        "description": "Identification of pathogenic mutation in the TGFBI gene (commonly R555W mutation)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Histopathological confirmation of hyaline deposits in corneal stroma if biopsy performed",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic corneal hyaline deposits on slit-lamp examination plus identification of pathogenic TGFBI mutation or compatible family history",
    "notes": "Genetic testing is recommended to confirm diagnosis and differentiate from other corneal dystrophies."
  },
