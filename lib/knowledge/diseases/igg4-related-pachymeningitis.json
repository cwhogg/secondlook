  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for IgG4-Related Pachymeningitis",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histopathological evidence of dense lymphoplasmacytic infiltrate rich in IgG4-positive plasma cells with storiform fibrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serum-igg4",
        "description": "Elevated serum IgG4 concentration (>135 mg/dL)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "MRI showing dural thickening and enhancement consistent with pachymeningitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of infectious, neoplastic, and other autoimmune causes of pachymeningitis",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-steroids",
        "description": "Clinical and radiological improvement following corticosteroid therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of histopathological findings with elevated serum IgG4 and characteristic MRI findings, plus exclusion of other causes",
    "notes": "Diagnosis often requires multidisciplinary evaluation including neurology, pathology, and rheumatology"
  },
