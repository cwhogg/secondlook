  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Arthrochalasia Ehlers-Danlos syndrome",
    "criteria": [
      {
        "id": "congenital-hip-dislocation",
        "description": "Congenital bilateral hip dislocation present at birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-generalized-joint-hypermobility",
        "description": "Severe generalized joint hypermobility with recurrent subluxations and dislocations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-hyperextensibility",
        "description": "Skin hyperextensibility with soft, doughy skin texture",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "type-i-collagen-gene-mutation",
        "description": "Presence of heterozygous mutations in COL1A1 or COL1A2 genes affecting type I collagen processing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-hypotonia",
        "description": "Congenital muscle hypotonia contributing to joint instability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "easy-bruising",
        "description": "Easy bruising without significant trauma",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital bilateral hip dislocation, severe generalized joint hypermobility, skin hyperextensibility, and identification of pathogenic COL1A1 or COL1A2 mutation",
    "notes": "Genetic testing confirming mutation in type I collagen genes is critical for definitive diagnosis."
  },
