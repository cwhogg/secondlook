  "diagnosticCriteria": {
    "formalCriteriaName": "BPAN Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive developmental delay in childhood followed by onset of parkinsonism and dystonia in adolescence or adulthood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-mri-iron-accumulation",
        "description": "Characteristic brain MRI showing iron accumulation in the globus pallidus and substantia nigra with a distinctive 'halo' sign",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "wdr45-mutation",
        "description": "Identification of pathogenic mutation in the WDR45 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-neuropsychiatric",
        "description": "Presence of neuropsychiatric symptoms such as cognitive decline, seizures, or autism spectrum features",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive neurodevelopmental delay with characteristic brain MRI findings and confirmed WDR45 gene mutation",
    "notes": "Genetic testing is essential for definitive diagnosis; MRI findings are highly suggestive but not pathognomonic alone."
  },
