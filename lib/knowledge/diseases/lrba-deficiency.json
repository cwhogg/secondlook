{
  "id": "lrba-deficiency",
  "name": "Lipopolysaccharide-Responsive and Beige-Like Anchor Protein Deficiency",
  "aliases": [
    "LRBA Deficiency",
    "LRBA Syndrome",
    "LRBA-related Immunodeficiency"
  ],
  "icd10Codes": [
    "D84.9"
  ],
  "omimId": "614700",
  "orphanetId": "238091",
  "prevalence": {
    "estimate": "1 in 1,000,000",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 20,
      "peak": 5
    },
    "sexPredilection": "equal",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed LRBA Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the LRBA gene identified by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogammaglobulinemia",
        "description": "Presence of hypogammaglobulinemia with low IgG and IgA levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoimmune-manifestations",
        "description": "Clinical evidence of autoimmunity such as autoimmune cytopenias or enteropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "reduced-CTLA4-expression",
        "description": "Reduced CTLA4 protein expression on regulatory T cells by flow cytometry",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "recurrent-infections",
        "description": "History of recurrent bacterial and viral infections",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic LRBA mutations plus hypogammaglobulinemia and at least one autoimmune manifestation",
    "notes": "Diagnosis may be supported by immunophenotyping showing reduced CTLA4 expression and clinical history."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Autoimmune enteropathy",
        "frequency": 0.85,
        "bodySystem": "gastrointestinal",
        "notes": "Severe chronic diarrhea due to autoimmune gut inflammation"
      },
      {
        "symptomName": "Hypogammaglobulinemia",
        "frequency": 0.9,
        "bodySystem": "immunological",
        "notes": "Marked reduction in serum immunoglobulin levels"
      },
      {
        "symptomName": "Autoimmune cytopenias",
        "frequency": 0.75,
        "bodySystem": "hematological",
        "notes": "Autoimmune hemolytic anemia and/or immune thrombocytopenia"
      }
    ],
    "common": [
      {
        "symptomName": "Recurrent respiratory tract infections",
        "frequency": 0.8,
        "bodySystem": "respiratory",
        "notes": "Frequent bacterial pneumonias and sinusitis"
      },
      {
        "symptomName": "Splenomegaly",
        "frequency": 0.7,
        "bodySystem": "hematological",
        "notes": "Enlarged spleen detected clinically or radiologically"
      },
      {
        "symptomName": "Lymphadenopathy",
        "frequency": 0.65,
        "bodySystem": "hematological",
        "notes": "Enlarged lymph nodes commonly present"
      },
      {
        "symptomName": "Chronic lung disease",
        "frequency": 0.6,
        "bodySystem": "respiratory",
        "notes": "Bronchiectasis or interstitial lung disease on imaging"
      },
      {
        "symptomName": "Growth retardation",
        "frequency": 0.55,
        "bodySystem": "constitutional",
        "notes": "Failure to thrive or poor weight gain"
      }
    ],
    "occasional": [
      {
        "symptomName": "Autoimmune endocrinopathies",
        "frequency": 0.3,
        "bodySystem": "endocrine",
        "notes": "Including type 1 diabetes mellitus or thyroiditis"
      },
      {
        "symptomName": "Neurological manifestations",
        "frequency": 0.25,
        "bodySystem": "neurological",
        "notes": "Peripheral neuropathy or demyelinating features"
      },
      {
        "symptomName": "Chronic diarrhea without enteropathy",
        "frequency": 0.4,
        "bodySystem": "gastrointestinal",
        "notes": "Non-autoimmune causes of diarrhea may occur"
      },
      {
        "symptomName": "Mucocutaneous candidiasis",
        "frequency": 0.15,
        "bodySystem": "dermatological",
        "notes": "Recurrent fungal infections of skin and mucosa"
      },
      {
        "symptomName": "Arthritis",
        "frequency": 0.2,
        "bodySystem": "musculoskeletal",
        "notes": "Inflammatory joint involvement"
      }
    ],
    "rare": [
      {
        "symptomName": "Interstitial nephritis",
        "frequency": 0.05,
        "bodySystem": "renal",
        "notes": "Autoimmune kidney inflammation"
      },
      {
        "symptomName": "Vasculitis",
        "frequency": 0.03,
        "bodySystem": "hematological",
        "notes": "Small vessel vasculitis reported in some cases"
      },
      {
        "symptomName": "Seizures",
        "frequency": 0.02,
        "bodySystem": "neurological",
        "notes": "Rare neurological complications"
      },
      {
        "symptomName": "Pulmonary hypertension",
        "frequency": 0.01,
        "bodySystem": "cardiovascular",
        "notes": "Secondary to chronic lung disease"
      }
    ]
  },
  "systemsAffected": [
    "immunological",
