  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Spastic Paraplegia-Paget Disease of Bone Syndrome",
    "criteria": [
      {
        "id": "spasticity",
        "description": "Progressive lower limb spasticity and weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "paget-bone-changes",
        "description": "Radiological evidence of Paget disease of bone (e.g., cortical thickening, bone enlargement)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with spastic paraplegia and Paget disease (e.g., VCP gene mutations)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "electrophysiology",
        "description": "Electromyography showing upper motor neuron signs without peripheral neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive lower limb spasticity plus radiological evidence of Paget disease of bone",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory. Family history supports diagnosis."
  },
