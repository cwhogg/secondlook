  "diagnosticCriteria": {
    "formalCriteriaName": "Neary Criteria for Semantic Dementia",
    "criteria": [
      {
        "id": "semantic-memory-loss",
        "description": "Prominent loss of semantic memory including impaired naming and single-word comprehension",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fluent-speech",
        "description": "Fluent spontaneous speech with preserved grammar and phonology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-object-knowledge",
        "description": "Impaired knowledge of objects and concepts despite preserved episodic memory",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-neurodegenerative-signs",
        "description": "No significant motor neuron disease, parkinsonism, or other neurological deficits at onset",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-temporal-lobe-atrophy",
        "description": "MRI or CT showing asymmetric anterior temporal lobe atrophy, usually left-sided",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (semantic memory loss, fluent speech, impaired object knowledge) with supportive imaging findings",
    "notes": "Diagnosis is clinical and supported by neuroimaging and neuropsychological testing."
  },
