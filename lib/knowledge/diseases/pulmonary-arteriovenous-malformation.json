  "keyFindings": {
    "laboratory": [
      "Elevated hematocrit and hemoglobin due to secondary polycythemia",
      "Arterial blood gas showing hypoxemia with normal or low CO2"
    ],
    "imaging": [
      "Contrast-enhanced chest CT demonstrating feeding artery, nidus, and draining vein",
      "Pulmonary angiography confirming direct arteriovenous communication",
      "Bubble contrast echocardiography showing right-to-left shunt"
    ],
    "genetic": [
      "Pathogenic variants in ENG, ACVRL1, or SMAD4 genes in hereditary hemorrhagic telangiectasia-associated cases",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Pulse oximetry showing decreased oxygen saturation",
      "Physical exam findings of digital clubbing and cyanosis"
    ]
  },
