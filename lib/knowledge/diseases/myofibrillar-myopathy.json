        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Progressive distal and/or proximal muscle weakness with onset in adulthood or adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "EMG showing myopathic changes with or without spontaneous activity",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-involvement",
        "description": "Presence of cardiomyopathy or conduction defects",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic muscle biopsy findings plus either pathogenic genetic variant or compatible clinical phenotype",
    "notes": "Diagnosis often requires integration of clinical, histopathological, and genetic data."
