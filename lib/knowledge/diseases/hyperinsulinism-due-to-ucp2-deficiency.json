  "keyFindings": {
    "laboratory": [
      "Elevated serum insulin during hypoglycemia",
      "Low blood glucose levels (<50 mg/dL) during episodes",
      "Suppressed beta-hydroxybutyrate and free fatty acids during hypoglycemia"
    ],
    "imaging": [
      "Pancreatic imaging typically normal; may show beta-cell hyperplasia in rare cases"
    ],
    "genetic": [
      "UCP2 (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Positive response to diazoxide therapy in some patients",
      "Exclusion of other hyperinsulinism gene mutations"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-hyperinsulinism-due-to-abcc8-mutation",
      "distinguishingFeatures": [
