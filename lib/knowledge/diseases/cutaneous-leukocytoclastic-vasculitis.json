  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (ESR, CRP)",
      "Normal or mild leukocytosis",
      "Possible hypocomplementemia in immune complex-mediated cases"
    ],
    "imaging": [
      "Not routinely required; imaging to exclude systemic vasculitis if suspected"
    ],
