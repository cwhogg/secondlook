  "keyFindings": {
    "laboratory": [
      "Serum potassium levels may be low or normal during paralysis episodes",
      "Elevated creatine kinase during attacks"
    ],
    "imaging": [
      "ECG showing prolonged QT interval and ventricular arrhythmias",
      "Echocardiogram may show normal cardiac structure"
    ],
    "genetic": [
      "Pathogenic mutations in KCNJ2 gene (encoding Kir2.1 potassium channel)"
    ],
    "other": [
      "Electromyography may show myopathic changes",
      "Family history consistent with autosomal dominant inheritance"
    ]
  },
  "differentialDiagnoses": [
