  "keyFindings": {
    "laboratory": [
      "Elevated erythrocyte sedimentation rate (ESR) and C-reactive protein (CRP)",
      "Negative rheumatoid factor (RF)",
      "Antinuclear antibody (ANA) positive in approximately 40-80% of cases"
    ],
    "imaging": [
      "Plain radiographs showing soft tissue swelling and joint space narrowing in affected joints",
      "Ultrasound or MRI may reveal synovial hypertrophy and effusion"
    ],
    "genetic": [
      "PTPN22 (susceptibility)",
      "STAT4 (susceptibility)",
      "IL2RA (susceptibility)",
      "CD247 (susceptibility)",
      "PTPN2 (susceptibility)",
      "ANKRD55 (susceptibility)",
      "IL2RB (susceptibility)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Slit-lamp examination for detection of asymptomatic chronic anterior uveitis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "polyarticular-juvenile-idiopathic-arthritis",
      "distinguishingFeatures": [
        "Involvement of five or more joints within the first six months",
        "Often rheumatoid factor positive",
        "More systemic symptoms"
      ]
    },
    {
      "diseaseId": "infectious-septic-arthritis",
      "distinguishingFeatures": [
        "Acute onset with severe joint pain",
        "Systemic signs of infection such as high fever",
        "Positive joint fluid culture"
      ]
    },
    {
      "diseaseId": "reactive-arthritis",
      "distinguishingFeatures": [
        "History of preceding infection",
        "Usually involves lower limb joints",
        "Presence of enthesitis and mucocutaneous lesions"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive joint destruction",
    "High-grade fever or systemic toxicity",
    "Visual symptoms suggestive of uveitis complications"
  ],
