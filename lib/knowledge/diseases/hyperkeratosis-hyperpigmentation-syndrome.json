  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Skin biopsy showing hyperkeratosis with epidermal hyperplasia"
    ],
    "imaging": [
      "Not typically required"
    ],
    "genetic": [
      "Mutations in keratin genes (e.g., KRT1, KRT10) reported in some cases",
