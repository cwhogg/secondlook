  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for X-linked Charcot-Marie-Tooth disease type 2",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Progressive distal muscle weakness and atrophy predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies showing axonal neuropathy with reduced amplitude and relatively preserved conduction velocity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in GJB1 gene or other associated genes on the X chromosome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "X-linked inheritance pattern with affected males and carrier females",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing neurogenic atrophy (if performed)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal muscle weakness with electrophysiological evidence of axonal neuropathy plus identification of pathogenic mutation in an X-linked gene",
    "notes": "Genetic testing is essential for definitive diagnosis; electrophysiological studies help differentiate from demyelinating forms."
  },
