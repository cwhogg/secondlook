  "diagnosticCriteria": {
    "formalCriteriaName": "Progeria Diagnostic Criteria",
    "criteria": [
      {
        "id": "growth-retardation",
        "description": "Severe postnatal growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facies",
        "description": "Distinctive facial features including micrognathia, prominent scalp veins, and beaked nose",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alopecia",
        "description": "Progressive alopecia including scalp hair loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiovascular-disease",
        "description": "Early onset atherosclerosis and cardiovascular complications",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiologic-bone-changes",
        "description": "Characteristic skeletal abnormalities on imaging such as clavicular hypoplasia and acroosteolysis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: severe postnatal growth retardation, characteristic facial features, and alopecia",
    "notes": "Genetic testing for LMNA mutation supports diagnosis but is not mandatory if clinical criteria are met"
  },
