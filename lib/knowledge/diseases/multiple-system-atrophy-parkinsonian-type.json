  "diagnosticCriteria": {
    "formalCriteriaName": "Second Consensus Diagnostic Criteria for Multiple System Atrophy",
    "criteria": [
      {
        "id": "parkinsonism",
        "description": "Parkinsonism defined as bradykinesia with rigidity and/or tremor",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "poor-levodopa-response",
        "description": "Poor or absent response to levodopa therapy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autonomic-dysfunction",
        "description": "Presence of autonomic failure including orthostatic hypotension or urinary incontinence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-support",
        "description": "MRI evidence of putaminal atrophy or hypointensity, or pontine/cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cerebellar-features",
        "description": "Presence of cerebellar signs such as ataxia (may be mild or absent in parkinsonian type)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Parkinsonism with poor levodopa response plus autonomic failure",
    "notes": "Definite diagnosis requires neuropathological confirmation; probable diagnosis based on clinical criteria."
  },
