    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Gass and Blodi Classification",
    "criteria": [
      {
        "id": "telangiectatic-capillaries",
        "description": "Presence of abnormal dilated and telangiectatic retinal capillaries in the juxtafoveal region",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "loss-of-retinal-transparency",
        "description": "Loss of retinal transparency or grayish discoloration in the temporal juxtafoveal area",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "right-angle-veins",
        "description": "Right-angle venules emerging from the deep capillary plexus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "crystalline-deposits",
        "description": "Presence of small yellow-white crystalline deposits in the macula",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "foveal-sparing",
        "description": "Relative sparing of the foveal center in early stages",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least two major criteria including telangiectatic capillaries and loss of retinal transparency",
    "notes": "Diagnosis is primarily clinical supported by multimodal imaging including fluorescein angiography and OCT."
  },
  "symptoms": {
    "pathognomonic": [
