  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Friedreich Ataxia-Like Syndromes",
    "criteria": [
      {
        "id": "progressive-ataxia",
        "description": "Progressive cerebellar ataxia with gait disturbance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiomyopathy",
        "description": "Presence of hypertrophic or dilated cardiomyopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with FA-like syndromes excluding FXN gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-deep-tendon-reflexes",
        "description": "Absent or reduced deep tendon reflexes in lower limbs",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sensory-neuropathy",
        "description": "Evidence of sensory peripheral neuropathy on nerve conduction studies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive ataxia, cardiomyopathy, and pathogenic genetic variants in FA-like syndrome genes",
    "notes": "Diagnosis requires exclusion of classic Friedreich ataxia (FXN gene mutations) and other ataxias."
  },
