  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Pfeiffer Syndrome Type 2",
    "criteria": [
      {
        "id": "cloverleaf-skull",
        "description": "Presence of cloverleaf (kleeblattschädel) skull deformity due to premature craniosynostosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "broad-thumb-big-toe",
        "description": "Broad and medially deviated thumbs and great toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midface-hypoplasia",
        "description": "Severe midface hypoplasia with proptosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-impairment",
        "description": "Neurological impairment due to increased intracranial pressure or brain anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Conductive or sensorineural hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of cloverleaf skull deformity plus broad thumbs and great toes and severe midface hypoplasia",
    "notes": "Genetic testing for FGFR2 mutations can support diagnosis but is not mandatory."
  },
