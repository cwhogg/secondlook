        "symptomName": "Persistent conjugated hyperbilirubinemia",
        "frequency": 0.95,
        "bodySystem": "gastrointestinal",
        "notes": "Jaundice persisting beyond 2 weeks of age"
      },
      {
        "symptomName": "Acholic (pale) stools",
        "frequency": 0.85,
        "bodySystem": "gastrointestinal"
      },
      {
        "symptomName": "Dark urine due to choluria",
        "frequency": 0.75,
        "bodySystem": "renal"
      }
    ],
    "common": [
