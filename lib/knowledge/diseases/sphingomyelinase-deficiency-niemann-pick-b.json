  "diagnosticCriteria": {
    "formalCriteriaName": "Niemann-Pick Disease Type B Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficient acid sphingomyelinase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepatosplenomegaly",
        "description": "Presence of hepatosplenomegaly confirmed by clinical examination or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the SMPD1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-involvement",
        "description": "Evidence of interstitial lung disease or pulmonary infiltration",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "bone-marrow-foam-cells",
        "description": "Presence of foam cells in bone marrow aspirate",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient acid sphingomyelinase enzyme activity plus either pathogenic SMPD1 mutations or clinical hepatosplenomegaly",
    "notes": "Diagnosis requires enzyme assay confirmation; genetic testing supports diagnosis and family counseling."
  },
