  "keyFindings": {
    "laboratory": [
      "Audiometry confirming sensorineural hearing loss"
    ],
    "imaging": [
      "CT or MRI may show inner ear malformations in some cases"
    ],
    "genetic": [
      "Heterozygous mutations in the PAX3 gene on chromosome 2q35"
    ],
    "other": [
      "W index measurement >1.95 confirms dystopia canthorum"
    ]
  },
