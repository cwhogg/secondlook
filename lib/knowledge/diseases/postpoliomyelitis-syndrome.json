  "diagnosticCriteria": {
    "formalCriteriaName": "Halstead criteria",
    "criteria": [
      {
        "id": "prior-polio-confirmation",
        "description": "Confirmed history of paralytic poliomyelitis with residual motor neuron loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "new-muscle-weakness",
        "description": "New onset of muscle weakness or abnormal muscle fatigability after a period of neurological stability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "symptom-duration",
        "description": "Symptoms present for at least one year",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other neuromuscular, orthopedic, or systemic causes for symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-fatigue",
        "description": "Presence of new fatigue or muscle atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All major criteria must be met including prior poliomyelitis, new muscle weakness, symptom duration ≥1 year, and exclusion of other causes.",
    "notes": "Diagnosis is clinical and requires careful exclusion of other neuromuscular disorders."
  },
