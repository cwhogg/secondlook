  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "CSF analysis typically unremarkable"
    ],
    "imaging": [
      "MRI showing cerebellar atrophy predominantly affecting the vermis",
      "Dopamine transporter (DAT) scan may show reduced uptake in basal ganglia"
    ],
    "genetic": [
      "FGF14 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography may show mild peripheral neuropathy",
      "Neuropsychological testing may reveal mild cognitive deficits"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "spinocerebellar-ataxia-type-2",
      "distinguishingFeatures": [
        "Mutation in ATXN2 gene",
        "Earlier onset with more prominent pyramidal signs",
        "Absence of parkinsonism features typical of SCA27A"
      ]
    },
    {
      "diseaseId": "multiple-system-atrophy",
      "distinguishingFeatures": [
        "Rapid progression",
