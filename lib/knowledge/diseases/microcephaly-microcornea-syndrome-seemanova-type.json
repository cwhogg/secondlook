    "formalCriteriaName": "Seemanova diagnostic criteria for microcephaly-microcornea syndrome",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Congenital microcephaly with head circumference significantly below the mean for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microcornea",
        "description": "Bilateral microcornea with corneal diameter less than 10 mm in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent nasal bridge and thin upper lip",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "Presence of seizures or epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital microcephaly, bilateral microcornea, and developmental delay",
    "notes": "Diagnosis is clinical; genetic testing may assist but no specific gene identified"
  },
