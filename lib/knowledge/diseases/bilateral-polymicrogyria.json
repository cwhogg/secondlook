  "diagnosticCriteria": {
    "formalCriteriaName": "Radiological and Clinical Diagnostic Criteria for Polymicrogyria",
    "criteria": [
      {
        "id": "imaging-confirmation",
        "description": "MRI demonstrating excessive small, irregular gyri with abnormal cortical lamination bilaterally",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-neurological-features",
        "description": "Presence of developmental delay and/or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizure-history",
        "description": "History of focal or generalized epilepsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with polymicrogyria (e.g., PIK3R2, TUBB2B)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Bilateral polymicrogyria diagnosis requires MRI confirmation of bilateral cortical malformations plus clinical evidence of developmental delay or epilepsy.",
    "notes": "Genetic testing may support diagnosis but is not mandatory."
  },
