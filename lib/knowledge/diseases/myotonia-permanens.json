  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electromyographic Diagnostic Criteria for Myotonia Permanens",
    "criteria": [
      {
        "id": "clinical-myotonia",
        "description": "Presence of persistent muscle stiffness and delayed relaxation after voluntary contraction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "emg-myotonic-discharge",
        "description": "Electromyography showing characteristic myotonic discharges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the SCN4A gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-muscle-wasting",
        "description": "Lack of progressive muscle atrophy differentiating from dystrophic myotonias",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical myotonia, characteristic EMG findings, and pathogenic SCN4A mutation",
    "notes": "Diagnosis requires exclusion of dystrophic myotonias and other neuromuscular disorders."
  },
