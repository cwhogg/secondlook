  "keyFindings": {
    "laboratory": [
      "Severe pancytopenia with aplastic anemia",
      "Markedly shortened telomere length on flow-FISH or qPCR"
    ],
    "imaging": [
      "Bilateral exudative retinopathy on fundoscopic exam and fluorescein angiography",
      "Intracranial calcifications on CT or MRI brain",
      "Cerebellar hypoplasia on brain MRI"
    ],
    "genetic": [
      "Pathogenic heterozygous mutations in TINF2 gene"
    ],
