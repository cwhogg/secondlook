  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnostic criteria for Snyder-type XLID",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of moderate to severe intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including broad nasal bridge, prominent forehead, and large ears",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the gene associated with Snyder-type XLID (e.g., CASK gene mutations)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Early onset hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "History of seizures or epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of intellectual disability and characteristic facial dysmorphism plus genetic confirmation of pathogenic variant",
    "notes": "Diagnosis relies heavily on genetic testing due to phenotypic overlap with other XLID syndromes."
  },
