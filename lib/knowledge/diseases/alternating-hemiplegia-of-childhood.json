  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "CSF analysis typically normal"
    ],
    "imaging": [
      "Brain MRI usually normal or nonspecific",
      "Occasional cerebellar atrophy in advanced cases"
    ],
    "genetic": [
      "CACNA1A (candidate)",
      "ATP1A2 (causative)",
      "ATP1A3 (causative)",
      "SCN2A (causative)",
      "SLC2A1 (causative)",
      "MT-TL2 (causative)",
      "SLC1A3 (candidate)",
      "RHOBTB2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "EEG may show nonspecific abnormalities or epileptiform discharges",
      "Video EEG during attacks may help differentiate from epilepsy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hemiplegic-migraine",
      "distinguishingFeatures": [
        "Typically later onset",
        "Migraine headaches with aura",
        "No symptom resolution with sleep"
      ]
    },
    {
      "diseaseId": "epileptic-hemiplegia",
      "distinguishingFeatures": [
        "Hemiplegia associated with epileptic seizures",
        "EEG abnormalities during episodes",
        "No alternating pattern"
      ]
    },
    {
      "diseaseId": "stroke-in-infant",
      "distinguishingFeatures": [
        "Sudden onset hemiplegia without remission",
        "Neuroimaging evidence of infarction",
        "No symptom resolution with sleep"
      ]
    }
  ],
  "redFlags": [
    "Progressive neurological deterioration",
    "Failure to improve or resolve symptoms with sleep",
    "Onset after 18 months of age"
  ],
