  "diagnosticCriteria": {
    "formalCriteriaName": "EB Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-blistering",
        "description": "Presence of generalized mucocutaneous blistering and erosions at or shortly after birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Immunofluorescence antigen mapping showing cleavage within the lamina lucida of the basement membrane zone",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes encoding laminin-332, type XVII collagen, or integrin subunits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy demonstrating subepidermal blister with cleavage at lamina lucida",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized blistering at birth plus confirmation by immunofluorescence mapping or genetic testing",
    "notes": "Genetic testing is increasingly used to confirm diagnosis and subtype classification."
  },
