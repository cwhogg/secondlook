  "diagnosticCriteria": {
    "formalCriteriaName": "Ring Chromosome 14 Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "ring-chromosome-detection",
        "description": "Cytogenetic identification of ring chromosome 14 in peripheral blood or other tissues",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epilepsy",
        "description": "Presence of refractory epilepsy with multiple seizure types",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Characteristic dysmorphic facial features including microcephaly and hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of ring chromosome 14 confirmed by cytogenetic analysis plus clinical features of epilepsy and intellectual disability",
    "notes": "Diagnosis is confirmed by cytogenetic analysis; clinical features support diagnosis."
  },
