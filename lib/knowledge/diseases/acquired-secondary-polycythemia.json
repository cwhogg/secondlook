      },
      {
        "id": "absence-of-jak2-mutation",
        "description": "Negative testing for JAK2 V617F and exon 12 mutations to exclude polycythemia vera",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "identification-of-hypoxia-or-erythropoietin-stimulus",
        "description": "Presence of chronic hypoxia or erythropoietin-secreting tumor or other stimulus",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated hemoglobin/hematocrit plus elevated erythropoietin levels with exclusion of primary polycythemia (negative JAK2 mutation), and identification of underlying cause of erythropoietin stimulation",
    "notes": "Diagnosis requires exclusion of primary polycythemia and identification of secondary cause such as chronic hypoxia or erythropoietin-producing tumors."
