  "keyFindings": {
    "laboratory": [
      "Hypoxemia on arterial blood gas analysis",
      "Elevated lactate dehydrogenase (LDH) in bronchoalveolar lavage fluid"
    ],
    "imaging": [
      "High-resolution CT showing diffuse ground-glass opacities",
      "Interstitial thickening and fibrosis",
      "Possible cystic changes or honeycombing in advanced disease"
    ],
    "genetic": [
      "Pathogenic mutations in SFTPB, SFTPC, or ABCA3 genes"
    ],
    "other": [
      "Lung biopsy demonstrating abnormal surfactant metabolism and alveolar proteinosis",
      "Pulmonary function tests showing restrictive pattern"
    ]
  },
  "differentialDiagnoses": [
