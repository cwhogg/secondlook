  "diagnosticCriteria": {
    "formalCriteriaName": "Cryoglobulinemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "presence-cryoglobulins",
        "description": "Detection of monoclonal cryoglobulins in serum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-manifestations",
        "description": "Presence of clinical symptoms such as purpura, arthralgia, or peripheral neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-secondary-causes",
        "description": "Exclusion of secondary causes such as hepatitis C infection or autoimmune diseases",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "complement-levels",
        "description": "Low complement levels (especially C4) supporting diagnosis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of monoclonal cryoglobulins in serum plus at least one major clinical manifestation and exclusion of secondary causes",
    "notes": "Diagnosis requires careful exclusion of mixed cryoglobulinemia and secondary etiologies."
  },
