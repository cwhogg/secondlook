  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "CSF analysis typically normal"
    ],
    "imaging": [
      "Brain MRI usually normal or nonspecific",
      "Occasional mild cerebral atrophy in chronic cases"
    ],
    "genetic": [
      "ARHGEF9 (causative, loss-of-function)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "EEG showing epileptiform discharges during seizures",
      "Electromyography demonstrating exaggerated startle reflex"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "stiff-person-syndrome",
      "distinguishingFeatures": [
        "Progressive muscle rigidity without exaggerated startle reflex",
        "Presence of anti-GAD antibodies",
        "Later onset compared to hyperekplexia"
      ]
    },
    {
      "diseaseId": "reflex-epilepsy",
      "distinguishingFeatures": [
        "Seizures triggered by specific stimuli without startle-induced stiffness",
        "Lack of continuous hypertonia after startle",
        "Normal glycine receptor gene testing"
      ]
    }
  ],
  "redFlags": [
    "Recurrent apnea episodes in neonates",
    "Status epilepticus or prolonged seizures",
    "Sudden unexpected death in epilepsy (SUDEP) risk"
  ],
