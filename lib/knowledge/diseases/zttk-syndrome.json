  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific biochemical markers",
      "Possible hypothyroidism on thyroid function tests"
    ],
    "imaging": [
      "Brain MRI showing ventriculomegaly, corpus callosum hypoplasia or agenesis",
      "Echocardiogram revealing congenital heart defects"
    ],
    "genetic": [
      "SON (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Characteristic facial dysmorphism on clinical examination",
      "Developmental assessment confirming intellectual disability"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cohen-syndrome",
      "distinguishingFeatures": [
        "Distinct facial features including prominent nasal bridge and thick hair",
        "Neutropenia and retinal dystrophy common in Cohen syndrome",
        "Different genetic etiology (VPS13B mutations)"
      ]
    },
    {
      "diseaseId": "cornelia-de-lange-syndrome",
