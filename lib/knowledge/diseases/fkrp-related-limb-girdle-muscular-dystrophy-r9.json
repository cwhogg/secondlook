  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for FKRP-related LGMD R9",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness predominantly affecting limb-girdle muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes with reduced or abnormal alpha-dystroglycan glycosylation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic FKRP gene mutations by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serum-creatine-kinase",
        "description": "Elevated serum creatine kinase (CK) levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-assessment",
        "description": "Evidence of cardiomyopathy on cardiac evaluation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal muscle weakness with confirmatory muscle biopsy findings and identification of FKRP pathogenic variants",
    "notes": "Genetic confirmation is essential for definitive diagnosis; cardiac evaluation is recommended due to risk of cardiomyopathy."
  },
