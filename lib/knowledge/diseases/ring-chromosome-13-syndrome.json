  "diagnosticCriteria": {
    "formalCriteriaName": "Ring Chromosome 13 Diagnostic Criteria",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Identification of ring chromosome 13 by karyotype or chromosomal microarray",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Prenatal or postnatal growth retardation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial anomalies including microcephaly and micrognathia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-anomalies",
        "description": "Presence of ocular abnormalities such as coloboma or microphthalmia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of ring chromosome 13 plus at least one major clinical feature",
    "notes": "Diagnosis relies primarily on cytogenetic analysis; clinical features support diagnosis and guide management."
  },
