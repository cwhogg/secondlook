        "Low C2 and C4 levels",
        "Less severe infections compared to C3 deficiency"
      ]
    },
    {
      "diseaseId": "properdin-deficiency",
      "distinguishingFeatures": [
        "X-linked inheritance",
        "Predisposition mainly to Neisseria infections",
        "Normal C3 levels"
      ]
    }
  ],
  "redFlags": [
