  "diagnosticCriteria": {
    "formalCriteriaName": "Southeast Asian Ovalocytosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "ovalocytes-on-blood-smear",
        "description": "Presence of characteristic oval-shaped erythrocytes with rigid membranes on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "band-3-gene-deletion",
        "description": "Detection of 27 base pair deletion in the SLC4A1 (band 3) gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "osmotic-resistance-test",
        "description": "Increased erythrocyte osmotic resistance on laboratory testing",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic ovalocytes on blood smear plus confirmation of band 3 gene deletion",
    "notes": "Diagnosis is primarily based on hematological findings and molecular genetic confirmation."
  },
