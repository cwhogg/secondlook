  "keyFindings": {
    "laboratory": [
      "Deficient alpha-L-iduronidase enzyme activity in leukocytes or fibroblasts",
      "Elevated urinary glycosaminoglycans (dermatan sulfate and heparan sulfate)"
    ],
    "imaging": [
      "Skeletal X-rays showing dysostosis multiplex",
      "Brain MRI may show hydrocephalus or white matter changes",
      "Echocardiography revealing valvular thickening and cardiomyopathy"
    ],
    "genetic": [
      "IDUA (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Corneal clouding on slit-lamp examination",
      "Electrodiagnostic studies may show carpal tunnel syndrome"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hunter-syndrome",
      "distinguishingFeatures": [
        "X-linked inheritance (male predominance)",
        "Absence of corneal clouding",
        "Later onset and milder cognitive impairment"
      ]
    },
    {
      "diseaseId": "sanfilippo-syndrome",
      "distinguishingFeatures": [
        "Predominantly severe neurological decline",
        "Minimal somatic involvement",
        "Different enzyme deficiencies (heparan N-sulfatase, etc.)"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive developmental delay in infancy",
    "Coarse facial features with corneal clouding",
    "Skeletal abnormalities with joint stiffness and contractures"
  ],
