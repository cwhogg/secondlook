  "keyFindings": {
    "laboratory": [
      "No specific laboratory abnormalities; routine labs may show secondary effects such as anemia or infection"
    ],
    "imaging": [
      "Prenatal ultrasound showing omphalocele and ectopia cordis",
      "Chest and abdominal X-rays demonstrating sternal and diaphragmatic defects",
      "Echocardiography revealing intracardiac anomalies",
      "CT or MRI for detailed thoracoabdominal defect assessment"
    ],
    "genetic": [
      "No consistent genetic mutation identified; some cases associated with chromosomal abnormalities or sporadic mutations"
    ],
    "other": [
      "Surgical exploration findings confirming defects",
      "Histopathology of diaphragmatic or pericardial tissue may be performed postoperatively"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ectopia-cordis",
      "distinguishingFeatures": [
        "Heart located outside thoracic cavity without associated abdominal wall or diaphragmatic defects",
        "Absence of full pentalogy features"
      ]
    },
    {
      "diseaseId": "omphalocele",
      "distinguishingFeatures": [
        "Isolated abdominal wall defect without sternal, diaphragmatic, or cardiac anomalies"
      ]
    },
    {
      "diseaseId": "thoracoabdominal-syndrome",
      "distinguishingFeatures": [
        "Overlap with Pentalogy of Cantrell but may lack full spectrum of defects",
        "Genetic inheritance patterns differ"
      ]
    }
  ],
