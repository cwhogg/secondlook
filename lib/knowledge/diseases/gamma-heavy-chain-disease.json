  "diagnosticCriteria": {
    "formalCriteriaName": "Gamma-heavy chain disease diagnostic criteria",
    "criteria": [
      {
        "id": "monoclonal-gamma-heavy-chain",
        "description": "Detection of monoclonal truncated gamma-heavy chains in serum or urine by immunofixation electrophoresis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphoplasmacytic-infiltrate",
        "description": "Histopathological evidence of lymphoplasmacytic infiltration in lymph nodes, bone marrow, or affected tissues",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical manifestations such as lymphadenopathy, hepatosplenomegaly, or constitutional symptoms",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of monoclonal truncated gamma-heavy chains plus histopathological confirmation of lymphoplasmacytic infiltration",
    "notes": "Diagnosis requires exclusion of other heavy chain diseases and lymphoproliferative disorders."
  },
