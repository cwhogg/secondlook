  "differentialDiagnoses": [
    {
      "diseaseId": "pfeiffer-syndrome",
      "distinguishingFeatures": [
        "More severe midface hypoplasia",
        "Cloverleaf skull deformity in severe cases",
        "FGFR1 or FGFR2 mutations instead of TWIST1"
      ]
    },
    {
      "diseaseId": "apert-syndrome",
      "distinguishingFeatures": [
        "Complex syndactyly with fusion of bones (mitten hands)",
        "Severe midface hypoplasia",
        "FGFR2 mutations"
      ]
    }
  ],
  "redFlags": [
    "Progressive intracranial hypertension signs",
    "Severe airway obstruction due to midface hypoplasia",
    "Visual impairment from untreated ptosis or craniosynostosis"
  ],
