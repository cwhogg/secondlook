        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "myoclonic-epilepsy",
        "description": "Recurrent myoclonic seizures with EEG abnormalities consistent with myoclonic epilepsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorimotor-neuropathy",
        "description": "Electrophysiological evidence of sensorimotor peripheral neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset",
        "description": "Symptom onset before age 15",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-metabolic-causes",
        "description": "Exclusion of metabolic and acquired causes by laboratory testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: early-onset progressive spastic ataxia, myoclonic epilepsy, and sensorimotor neuropathy",
    "notes": "Diagnosis requires exclusion of other hereditary ataxias and epileptic syndromes."
  },
