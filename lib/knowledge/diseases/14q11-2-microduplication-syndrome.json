        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Infantile hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 14q11.2 microduplication plus at least one major clinical feature such as developmental delay",
    "notes": "Diagnosis relies primarily on genetic testing supported by clinical features."
