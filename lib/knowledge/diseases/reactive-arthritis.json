  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP during acute phase",
      "HLA-B27 positive in 50-80% of patients (predicts severity and chronicity)",
      "Rheumatoid factor negative",
      "Synovial fluid: inflammatory (WBC 2,000-50,000), culture negative",
      "Urethral swab or first-void urine NAAT for Chlamydia trachomatis",
      "Stool culture for enteric pathogens (Salmonella, Shigella, Yersinia, Campylobacter)"
    ],
    "imaging": [
      "Radiographs often normal early in disease",
      "Entheseal calcification (Achilles, plantar fascia) in chronic cases",
      "Sacroiliac joint imaging may show asymmetric sacroiliitis",
      "MRI: bone marrow edema at entheses and sacroiliac joints",
      "Ultrasound: enthesitis, joint effusion, synovitis"
    ],
    "genetic": [
      "HLA-B (biomarker)",
      "HLA-B (susceptibility)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Careful sexual and travel/food history for triggering infection",
      "Joint aspiration to exclude septic arthritis and crystal arthropathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "psoriatic-arthritis",
      "distinguishingFeatures": [
        "PsA has psoriatic skin plaques (not keratoderma blennorrhagica)",
