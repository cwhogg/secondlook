  "keyFindings": {
    "laboratory": [
      "Arterial blood gas may show hypoxemia during episodes",
      "Normal routine blood tests unless secondary infection present"
    ],
    "imaging": [
      "CT scan showing segmental or diffuse tracheal narrowing",
      "Bronchoscopy revealing intrinsic tracheal stenosis with complete tracheal rings",
      "Chest X-ray may show hyperinflation or atelectasis"
    ],
    "genetic": [
      "No specific gene identified; may be associated with syndromes involving congenital malformations"
    ],
    "other": [
      "Pulmonary function tests showing fixed upper airway obstruction pattern",
      "Echocardiography to assess for associated cardiovascular anomalies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "acquired-tracheal-stenosis",
      "distinguishingFeatures": [
        "History of intubation or tracheal trauma",
        "Onset after birth rather than congenital"
      ]
    },
    {
      "diseaseId": "vascular-ring-syndrome",
      "distinguishingFeatures": [
        "External compression of trachea by vascular structures",
        "Imaging shows vascular anomaly encircling trachea"
      ]
    }
  ],
  "redFlags": [
