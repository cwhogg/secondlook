  "keyFindings": {
    "laboratory": [
      "Normal or mildly elevated inflammatory markers (ESR, CRP)",
      "Autoantibodies usually negative or low titer ANA",
      "Absence of systemic sclerosis-specific antibodies (e.g. anti-Scl-70, anti-centromere)"
    ],
    "imaging": [
      "MRI may show dermal and subcutaneous thickening",
      "Ultrasound can detect skin and soft tissue fibrosis"
    ],
    "genetic": [
      "No specific genetic markers identified; possible HLA associations"
    ],
    "other": [
      "Skin biopsy demonstrating thickened collagen bundles and loss of adnexal structures"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "systemic-sclerosis",
      "distinguishingFeatures": [
        "Presence of Raynaud phenomenon",
        "Systemic organ involvement",
        "Positive systemic sclerosis-specific autoantibodies"
      ]
    },
    {
      "diseaseId": "lichen-sclerosus",
      "distinguishingFeatures": [
        "Predominantly affects genital and perianal skin",
        "Thinner, white atrophic plaques",
        "Histopathology shows epidermal thinning and basal cell degeneration"
      ]
    },
    {
      "diseaseId": "morpheaform-basalioma",
      "distinguishingFeatures": [
        "Malignant skin tumor with infiltrative growth",
        "Histopathology shows basaloid tumor cells",
        "Ulceration or bleeding lesions"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of skin thickening beyond localized plaques",
    "Development of systemic symptoms (e.g. Raynaud phenomenon, dysphagia)",
    "Neurological deficits or seizures in linear morphea involving the face/scalp"
  ],
