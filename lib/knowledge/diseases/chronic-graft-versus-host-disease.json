  "diagnosticCriteria": {
    "formalCriteriaName": "National Institutes of Health (NIH) Consensus Criteria for Chronic GVHD",
    "criteria": [
      {
        "id": "clinical-manifestations",
        "description": "Presence of characteristic clinical manifestations involving one or more organs (skin, mouth, eyes, liver, lungs, gastrointestinal tract)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histopathologic confirmation of GVHD in affected tissue biopsy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-acute-gvhd",
        "description": "Exclusion of acute GVHD and other causes of symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "duration",
        "description": "Symptoms persisting or developing beyond 100 days post-transplant",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "laboratory-markers",
        "description": "Supportive laboratory abnormalities such as elevated liver enzymes or autoantibodies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical manifestations in at least one organ system persisting beyond 100 days post-transplant, with exclusion of acute GVHD.",
    "notes": "Diagnosis is clinical and supported by histopathology and exclusion of other causes."
  },
