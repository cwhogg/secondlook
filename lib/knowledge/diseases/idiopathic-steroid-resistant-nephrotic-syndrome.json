  "keyFindings": {
    "laboratory": [
      "Nephrotic-range proteinuria (>3.5 g/day)",
      "Hypoalbuminemia (<2.5 g/dL)",
      "Hyperlipidemia (elevated cholesterol and triglycerides)",
      "Normal serum complement levels",
      "Possible microscopic hematuria"
    ],
    "imaging": [
      "Renal ultrasound typically normal or may show increased echogenicity",
      "Chest X-ray if pulmonary edema suspected"
    ],
    "genetic": [
      "Mutations in NPHS2 (podocin), WT1, and other podocyte-related genes associated with steroid resistance"
    ],
    "other": [
      "Renal biopsy showing minimal change disease or focal segmental glomerulosclerosis",
      "Exclusion of secondary causes by clinical and laboratory evaluation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "secondary-nephrotic-syndrome",
      "distinguishingFeatures": [
        "Presence of systemic disease (e.g., lupus, diabetes)",
        "Positive serologic markers for secondary causes",
        "Response to treatment of underlying condition"
      ]
    },
    {
      "diseaseId": "steroid-sensitive-nephrotic-syndrome",
      "distinguishingFeatures": [
        "Complete remission with corticosteroid therapy",
        "Absence of genetic mutations associated with resistance",
        "Typically minimal change disease on biopsy"
      ]
    },
    {
      "diseaseId": "congenital-nephrotic-syndrome",
      "distinguishingFeatures": [
        "Onset within first 3 months of life",
        "Genetic mutations distinct from idiopathic SRNS",
        "Poor response to steroids from birth"
      ]
    }
  ],
  "redFlags": [
