    "formalCriteriaName": "Secondary Polycythemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-hemoglobin-hematocrit",
        "description": "Elevated hemoglobin and hematocrit levels above normal reference ranges",
