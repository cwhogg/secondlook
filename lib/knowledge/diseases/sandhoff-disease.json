  "diagnosticCriteria": {
    "formalCriteriaName": "Sandhoff Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of both hexosaminidase A and B enzyme activities in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic mutations in the HEXB gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive neurodegeneration with developmental regression and cherry-red macula",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing cerebral and cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hexosaminidase A and B deficiency plus pathogenic HEXB mutations with compatible clinical presentation",
    "notes": "Enzyme assay and genetic testing are essential for definitive diagnosis."
  },
