        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Severe combined immunodeficiency confirmed by lymphocyte subset analysis showing profound T-cell and B-cell lymphopenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Early onset recurrent severe infections and failure to thrive",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with combined skeletal dysplasia and immunodeficiency (e.g., RMRP gene mutations)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of radiological short-limb skeletal dysplasia plus confirmed severe combined immunodeficiency by immunophenotyping and clinical presentation of recurrent infections",
    "notes": "Genetic testing can support diagnosis but is not mandatory."
  },
