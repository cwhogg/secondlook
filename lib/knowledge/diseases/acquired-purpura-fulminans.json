  "keyFindings": {
    "laboratory": [
      "Thrombocytopenia",
      "Prolonged prothrombin time (PT) and activated partial thromboplastin time (aPTT)",
      "Elevated D-dimer and fibrin degradation products",
      "Reduced protein C and protein S activity",
      "Positive blood cultures for causative bacteria"
    ],
    "imaging": [
      "Skin biopsy showing dermal vascular thrombosis",
      "Imaging may show adrenal hemorrhage in Waterhouse-Friderichsen syndrome"
    ],
    "genetic": [
      "No primary genetic mutations; acquired protein C deficiency secondary to sepsis"
    ],
    "other": [
      "Clinical evidence of severe bacterial infection",
      "Signs of septic shock"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-purpura-fulminans",
      "distinguishingFeatures": [
        "Onset in neonatal period or infancy",
        "Genetic protein C or S deficiency",
        "Absence of acute infection"
      ]
    },
    {
      "diseaseId": "disseminated-intravascular-coagulation",
      "distinguishingFeatures": [
        "DIC secondary to other causes such as malignancy or trauma",
        "Lack of characteristic purpuric skin necrosis",
        "Different clinical context"
      ]
    },
    {
      "diseaseId": "meningococcemia",
      "distinguishingFeatures": [
        "Presence of meningitis symptoms",
        "Rapid progression of rash but may lack extensive necrosis initially",
        "Positive cerebrospinal fluid cultures"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressing purpuric skin lesions with necrosis",
