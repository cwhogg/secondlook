  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for spondylodysplastic Ehlers-Danlos syndrome",
    "criteria": [
      {
        "id": "short-stature",
        "description": "Short stature with disproportionate short trunk",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-hypotonia",
        "description": "Congenital or early-onset muscle hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-hypermobility",
        "description": "Generalized joint hypermobility with recurrent dislocations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-hyperextensibility",
        "description": "Soft, velvety, and hyperextensible skin",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiologic-spinal-abnormalities",
        "description": "Radiologic evidence of platyspondyly and other spinal dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consistent family history or confirmed pathogenic variant in B4GALT7, B3GALT6, or SLC39A13",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (short stature with disproportionate short trunk, muscle hypotonia, joint hypermobility) plus radiologic spinal abnormalities, supported by genetic testing if available.",
    "notes": "Genetic confirmation is recommended but not mandatory if clinical criteria are met."
  },
