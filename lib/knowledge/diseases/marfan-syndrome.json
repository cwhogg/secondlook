  "confidenceInData": "medium",
  "commonPitfalls": [
    "Often misdiagnosed as other connective tissue disorders due to overlapping features such as joint hypermobility and skin findings.",
    "Aortic root dilation may be missed if echocardiography is not performed or interpreted correctly.",
    "Ectopia lentis can be subtle and overlooked without a thorough ophthalmologic exam.",
    "Tall stature and long limbs may be attributed to normal familial tallness or constitutional growth patterns."
  ],
  "extendedDiscriminators": [
    {
      "vsCondition": "Loeys-Dietz syndrome",
      "feature": "Marfan syndrome typically lacks the bifid uvula, hypertelorism, and arterial tortuosity seen in Loeys-Dietz syndrome."
    },
    {
      "vsCondition": "Ehlers-Danlos syndrome (vascular type)",
      "feature": "Marfan syndrome features aortic root dilation and ectopia lentis, which are not characteristic of vascular Ehlers-Danlos syndrome."
    },
    {
      "vsCondition": "Ehlers-Danlos syndrome (hypermobile type)",
      "feature": "Marfan syndrome presents with aortic root dilation and lens dislocation, which are absent in hypermobile Ehlers-Danlos syndrome."
    },
    {
      "vsCondition": "Stickler syndrome",
      "feature": "Marfan syndrome is distinguished by ectopia lentis and aortic root dilation, while Stickler syndrome more commonly presents with midface hypoplasia, cleft palate, and vitreoretinal degeneration."
    }
  ],
  "ruleOutCriteria": [
    "Absence of aortic root dilation on serial echocardiography in an adult with otherwise suggestive features.",
    "Normal lens position (no ectopia lentis) on comprehensive ophthalmologic examination.",
    "Negative genetic testing for pathogenic FBN1 mutations in a patient meeting revised Ghent criteria."
  ],
