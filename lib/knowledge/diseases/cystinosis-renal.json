  ],
  "icd10Codes": [
    "E72.0"
  ],
  "omimId": "219800",
  "orphanetId": "791",
  "prevalence": {
    "estimate": "1 in 100,000 to 200,000",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 5,
      "peak": 1
    },
    "sexPredilection": "equal",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Nephropathic Cystinosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "cystine-crystals",
        "description": "Presence of cystine crystals in corneal epithelium or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fanconi-syndrome",
        "description": "Clinical evidence of proximal renal tubular dysfunction consistent with Fanconi syndrome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ctns-gene-mutation",
        "description": "Identification of pathogenic mutations in the CTNS gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-leukocyte-cystine",
        "description": "Elevated leukocyte cystine levels above diagnostic threshold",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of elevated leukocyte cystine levels and either clinical Fanconi syndrome or CTNS gene mutation confirmation",
    "notes": "Diagnosis is confirmed by biochemical and genetic testing; corneal cystine crystals may be absent in very young patients."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Corneal cystine crystal deposition",
        "frequency": 0.85,
        "bodySystem": "ophthalmological",
        "notes": "Visible on slit-lamp examination"
      },
      {
        "symptomName": "Proximal renal tubular dysfunction (Fanconi syndrome)",
        "frequency": 0.9,
        "bodySystem": "renal",
        "notes": "Includes aminoaciduria, phosphaturia, glucosuria"
      },
      {
        "symptomName": "Elevated leukocyte cystine levels",
        "frequency": 0.95,
        "bodySystem": "hematological",
        "notes": "Diagnostic biochemical hallmark"
      }
    ],
    "common": [
      {
        "symptomName": "Polyuria and polydipsia",
        "frequency": 0.75,
        "bodySystem": "renal",
        "notes": "Due to renal tubular dysfunction"
      },
      {
        "symptomName": "Growth retardation",
        "frequency": 0.7,
        "bodySystem": "constitutional",
        "notes": "Secondary to renal losses and metabolic disturbances"
      },
      {
        "symptomName": "Photophobia",
        "frequency": 0.65,
        "bodySystem": "ophthalmological",
        "notes": "Due to corneal crystal irritation"
      },
      {
        "symptomName": "Hypophosphatemic rickets",
        "frequency": 0.6,
        "bodySystem": "musculoskeletal",
        "notes": "Resulting from phosphate wasting"
      },
      {
        "symptomName": "Muscle weakness",
        "frequency": 0.55,
        "bodySystem": "musculoskeletal",
        "notes": "Due to electrolyte imbalances"
      }
    ],
    "occasional": [
      {
        "symptomName": "Hypothyroidism",
        "frequency": 0.3,
        "bodySystem": "endocrine",
        "notes": "Due to cystine accumulation in thyroid gland"
      },
      {
        "symptomName": "Photophobia-related eye pain",
        "frequency": 0.25,
        "bodySystem": "ophthalmological",
        "notes": "Associated with corneal crystal deposits"
      },
      {
        "symptomName": "Renal tubular acidosis",
        "frequency": 0.4,
        "bodySystem": "renal",
        "notes": "Metabolic acidosis from proximal tubule dysfunction"
      },
      {
        "symptomName": "Delayed puberty",
        "frequency": 0.15,
        "bodySystem": "reproductive",
        "notes": "Secondary to chronic illness"
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.35,
        "bodySystem": "constitutional",
        "notes": "Common nonspecific symptom"
      }
    ],
    "rare": [
      {
        "symptomName": "Myopathy",
        "frequency": 0.05,
        "bodySystem": "musculoskeletal",
        "notes": "Due to cystine accumulation in muscle tissue"
      },
      {
        "symptomName": "Neurological impairment",
        "frequency": 0.07,
        "bodySystem": "neurological",
        "notes": "Including peripheral neuropathy in late stages"
      },
      {
        "symptomName": "Cardiomyopathy",
        "frequency": 0.02,
        "bodySystem": "cardiovascular",
        "notes": "Rare late complication"
      },
      {
        "symptomName": "Hepatomegaly",
        "frequency": 0.03,
        "bodySystem": "gastrointestinal",
        "notes": "Due to cystine accumulation in liver"
      }
    ]
  },
  "systemsAffected": [
    "renal",
