  "diagnosticCriteria": {
    "formalCriteriaName": "Antisynthetase Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "anti-pl-12-antibody",
        "description": "Presence of anti-PL-12 antibodies detected by immunoassay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "interstitial-lung-disease",
        "description": "Evidence of interstitial lung disease confirmed by imaging or pulmonary function tests",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "myositis",
        "description": "Clinical or laboratory evidence of myositis (elevated muscle enzymes or muscle weakness)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "arthritis",
        "description": "Non-erosive arthritis or arthralgia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "mechanic-hands",
        "description": "Characteristic hyperkeratotic skin changes on the hands",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of anti-PL-12 antibodies plus interstitial lung disease, with or without myositis or arthritis",
    "notes": "Diagnosis is supported by clinical features and exclusion of other connective tissue diseases."
  },
