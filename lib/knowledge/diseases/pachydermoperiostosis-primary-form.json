  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (ESR, CRP) in some cases",
      "Normal or mildly elevated alkaline phosphatase"
    ],
    "imaging": [
      "Periosteal new bone formation along diaphyses of long bones on X-ray",
      "Soft tissue thickening visible on imaging"
    ],
    "genetic": [
      "Mutations in HPGD gene",
      "Mutations in SLCO2A1 gene"
    ],
    "other": [
      "Family history consistent with autosomal dominant inheritance",
      "Skin biopsy showing dermal thickening and mucin deposition"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "secondary-hypertrophic-osteoarthropathy",
      "distinguishingFeatures": [
        "Associated with underlying cardiopulmonary or neoplastic disease",
        "Onset usually in adulthood",
        "Absence of pachydermia"
      ]
    },
    {
      "diseaseId": "acromegaly",
      "distinguishingFeatures": [
        "Elevated growth hormone and IGF-1 levels",
        "Characteristic facial and skeletal changes without periostitis",
        "Presence of pituitary adenoma on imaging"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of digital clubbing and periostitis",
    "Presence of systemic symptoms suggesting secondary causes",
    "Signs of underlying malignancy or cardiopulmonary disease"
  ],
