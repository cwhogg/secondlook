  "diagnosticCriteria": {
    "formalCriteriaName": "Goldberg-Shprintzen Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "megacolon",
        "description": "Presence of congenital megacolon (Hirschsprung disease)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial abnormalities including microcephaly, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "musculoskeletal-anomalies",
        "description": "Presence of musculoskeletal anomalies such as joint contractures or scoliosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the KIAA1279 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital megacolon, characteristic craniofacial dysmorphism, and intellectual disability",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory"
  },
