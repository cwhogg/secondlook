  "diagnosticCriteria": {
    "formalCriteriaName": "Netchine-Harbison Clinical Scoring System (NH-CSS)",
    "criteria": [
      {
        "id": "prenatal-growth-retardation",
        "description": "Prenatal growth retardation (birth weight and/or length ≤ -2 SD)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "postnatal-growth-retardation",
        "description": "Postnatal growth retardation (height ≤ -2 SD at 24 months or older)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "relative-macrocephaly",
        "description": "Relative macrocephaly at birth (head circumference ≥ 1.5 SD above birth weight and/or length SD scores)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "body-hemihypoplasia",
        "description": "Body asymmetry (hemihypoplasia)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "feeding-difficulties",
        "description": "Feeding difficulties and/or low BMI (≤ -2 SD) at 24 months",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "protruding-forehead",
        "description": "Prominent forehead during early childhood",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "At least 4 of 6 NH-CSS criteria including both prenatal and postnatal growth retardation",
    "notes": "Molecular confirmation of 11p15 imprinting defect supports diagnosis but is not mandatory"
  },
