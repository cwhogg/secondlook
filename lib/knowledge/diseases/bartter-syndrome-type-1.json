  "prevalence": {
    "estimate": "1 in 1,000,000",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 5,
      "peak": 1
    },
    "sexPredilection": "equal",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Bartter Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypokalemia",
        "description": "Persistent hypokalemia despite normal dietary intake",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-alkalosis",
        "description": "Metabolic alkalosis with elevated blood pH and bicarbonate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the SLC12A1 (NKCC2) gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-salt-wasting",
        "description": "Evidence of renal salt wasting with elevated urinary sodium excretion",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-blood-pressure",
        "description": "Normotension or low blood pressure despite salt wasting",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypokalemia, metabolic alkalosis, and genetic confirmation of SLC12A1 mutations",
    "notes": "Diagnosis may be supported by clinical and biochemical findings in absence of genetic confirmation"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Hypokalemia",
        "frequency": 0.95,
        "bodySystem": "endocrine",
        "notes": "Low serum potassium levels due to renal loss"
      },
      {
        "symptomName": "Metabolic alkalosis",
        "frequency": 0.9,
        "bodySystem": "endocrine",
        "notes": "Elevated blood pH and bicarbonate levels"
      },
      {
        "symptomName": "Renal salt wasting",
        "frequency": 0.85,
        "bodySystem": "renal",
        "notes": "Excessive urinary sodium loss leading to volume depletion"
      }
    ],
    "common": [
      {
        "symptomName": "Polyuria",
        "frequency": 0.8,
        "bodySystem": "renal",
        "notes": "Increased urine output due to impaired salt reabsorption"
      },
      {
        "symptomName": "Polydipsia",
        "frequency": 0.75,
        "bodySystem": "renal",
        "notes": "Excessive thirst secondary to volume depletion"
      },
      {
        "symptomName": "Muscle weakness",
        "frequency": 0.7,
        "bodySystem": "musculoskeletal",
        "notes": "Due to hypokalemia affecting muscle function"
      },
      {
        "symptomName": "Growth retardation",
        "frequency": 0.65,
        "bodySystem": "constitutional",
        "notes": "Poor growth in affected children"
      },
      {
        "symptomName": "Normal or low blood pressure",
        "frequency": 0.6,
        "bodySystem": "cardiovascular",
        "notes": "Despite salt wasting and volume depletion"
      }
    ],
    "occasional": [
      {
        "symptomName": "Nephrocalcinosis",
        "frequency": 0.4,
        "bodySystem": "renal",
        "notes": "Calcium deposition in renal parenchyma"
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.35,
        "bodySystem": "constitutional",
        "notes": "Generalized tiredness"
      },
      {
        "symptomName": "Constipation",
        "frequency": 0.3,
        "bodySystem": "gastrointestinal",
        "notes": "Due to electrolyte imbalance"
      },
      {
        "symptomName": "Hypomagnesemia",
        "frequency": 0.25,
        "bodySystem": "endocrine",
        "notes": "Low serum magnesium levels"
      },
      {
        "symptomName": "Hypercalciuria",
        "frequency": 0.2,
        "bodySystem": "renal",
        "notes": "Increased urinary calcium excretion"
      }
    ],
    "rare": [
      {
        "symptomName": "Arrhythmias",
        "frequency": 0.08,
        "bodySystem": "cardiovascular",
        "notes": "Secondary to severe hypokalemia"
      },
      {
        "symptomName": "Tetany",
        "frequency": 0.05,
        "bodySystem": "musculoskeletal",
        "notes": "Muscle spasms due to electrolyte disturbances"
      },
      {
        "symptomName": "Sensorineural hearing loss",
        "frequency": 0.03,
        "bodySystem": "neurological",
        "notes": "Rarely reported in Bartter syndrome variants"
      }
    ]
  },
  "systemsAffected": [
