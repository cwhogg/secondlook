  "diagnosticCriteria": {
    "formalCriteriaName": "Combined Pituitary Hormone Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "hormone-deficiency",
        "description": "Deficiency of two or more anterior pituitary hormones confirmed by biochemical testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in known CPHD-associated genes (e.g., PROP1, POU1F1, HESX1)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pituitary-imaging",
        "description": "MRI evidence of pituitary hypoplasia, stalk abnormalities, or ectopic posterior pituitary",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical signs consistent with hormone deficiencies such as growth failure and hypoglycemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biochemical confirmation of deficiency in two or more anterior pituitary hormones plus clinical features consistent with CPHD",
    "notes": "Genetic testing and pituitary imaging support diagnosis and guide management but are not mandatory for initial diagnosis."
  },
