  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnostic criteria for CMT1F",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of a demyelinating peripheral neuropathy with distal muscle weakness and sensory loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-conduction-velocity",
        "description": "Nerve conduction studies showing uniformly slowed motor nerve conduction velocities (<38 m/s)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the periaxin (PRX) gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant or recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Nerve biopsy showing demyelination and onion bulb formations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical neuropathy with slowed nerve conduction velocities plus identification of pathogenic PRX gene mutation",
    "notes": "Genetic confirmation is essential for definitive diagnosis; nerve conduction studies support clinical findings."
  },
