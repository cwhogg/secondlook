      ]
    },
    {
      "diseaseId": "spondylocostal-dysostosis",
      "distinguishingFeatures": [
        "Multiple vertebral segmentation defects and rib anomalies but no uniparental disomy or facial features of Kagami-Ogata syndrome"
      ]
    },
    {
      "diseaseId": "prader-willi-syndrome",
      "distinguishingFeatures": [
        "Hypotonia and feeding difficulties present but genetic cause involves chromosome 15, not 14",
