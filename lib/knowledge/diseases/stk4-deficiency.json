  "diagnosticCriteria": {
    "formalCriteriaName": "STK4 Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic mutations in the STK4 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphopenia",
        "description": "Persistent lymphopenia, particularly affecting CD4+ and CD8+ T cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-viral-infections",
        "description": "History of recurrent or severe viral infections, especially herpesviruses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-tcell-survival",
        "description": "Functional evidence of impaired T-cell survival or apoptosis in vitro",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "immunoglobulin-levels",
        "description": "Variable immunoglobulin levels, often normal or mildly reduced",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic STK4 mutations plus persistent lymphopenia and recurrent viral infections",
    "notes": "Genetic testing is essential for definitive diagnosis; functional assays support clinical findings."
  },
