  "keyFindings": {
    "laboratory": [
      "Elevated serum luteinizing hormone (LH) and follicle-stimulating hormone (FSH)",
      "Low serum testosterone in males or estradiol in females",
      "Normal karyotype (46,XX or 46,XY)"
    ],
    "imaging": [
      "Hypoplastic or small gonads on ultrasound or MRI",
      "Delayed bone age on radiographs"
    ],
    "genetic": [
      "No specific gene mutation identified; presumed genetic etiology",
      "Exclusion of chromosomal abnormalities",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Exclusion of autoimmune or infectious causes by serology",
      "Clinical assessment of pubertal development"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "androgen-insensitivity-syndrome",
      "distinguishingFeatures": [
        "46,XY karyotype with female phenotype",
        "Normal or elevated testosterone with androgen receptor defects",
        "Absent or sparse pubic and axillary hair but no alopecia"
      ]
    },
    {
      "diseaseId": "turner-syndrome",
      "distinguishingFeatures": [
        "45,X or mosaic karyotype",
        "Characteristic phenotypic features (webbed neck, short stature)",
        "Primary ovarian failure but no partial alopecia"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of alopecia beyond partial scalp involvement",
    "Severe delay or absence of puberty beyond expected age",
    "Signs of gonadal malignancy or mass"
  ],
