    "laboratory": [
      "Normal routine blood tests except possible hypothyroidism",
      "Metabolic screening usually normal"
    ],
    "imaging": [
      "Brain MRI may show nonspecific findings or mild cerebral atrophy",
      "Echocardiography to identify congenital heart defects",
      "Skeletal X-rays may reveal scoliosis"
    ],
    "genetic": [
      "Presence of isochromosome 18p confirmed by karyotyping or FISH",
      "Array CGH may detect tetrasomy 18p"
    ],
