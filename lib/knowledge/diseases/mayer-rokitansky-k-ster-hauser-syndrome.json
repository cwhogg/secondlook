  "keyFindings": {
    "laboratory": [
      "Normal female hormone profile (FSH, LH, estradiol)",
      "Normal 46,XX karyotype"
    ],
    "imaging": [
      "MRI or ultrasound showing absence or hypoplasia of uterus and upper vagina",
      "Renal ultrasound or MRI revealing renal anomalies",
      "Spinal X-rays demonstrating vertebral anomalies"
    ],
    "genetic": [
      "No consistent single gene mutation identified; some familial cases suggest genetic heterogeneity",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Normal ovarian function confirmed by hormone levels and imaging"
    ]
  },
