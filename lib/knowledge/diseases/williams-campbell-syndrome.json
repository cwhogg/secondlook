  "diagnosticCriteria": {
    "formalCriteriaName": "Williams-Campbell Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cartilage-deficiency",
        "description": "Deficiency or absence of cartilage in subsegmental bronchi demonstrated by bronchoscopy or histopathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bronchiectasis",
        "description": "Presence of bronchiectasis predominantly affecting subsegmental bronchi on high-resolution CT scan",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-airflow-obstruction",
        "description": "Clinical evidence of airflow obstruction with recurrent respiratory infections and wheezing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of bronchiectasis such as cystic fibrosis or primary ciliary dyskinesia",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "All three major criteria (cartilage deficiency, bronchiectasis on imaging, clinical airflow obstruction) plus exclusion of other causes",
    "notes": "Bronchoscopy and imaging are critical for diagnosis; genetic testing is not currently diagnostic."
  },
  "symptoms": {
