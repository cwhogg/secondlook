  "differentialDiagnoses": [
    {
      "diseaseId": "age-related-macular-degeneration",
      "distinguishingFeatures": [
        "Typically older onset (>60 years)",
        "More common in Caucasians",
        "No C1QTNF5 mutations",
        "Presence of drusen rather than subretinal deposits characteristic of L-ORD"
      ]
    },
    {
      "diseaseId": "retinitis-pigmentosa",
      "distinguishingFeatures": [
        "Earlier onset (usually <40 years)",
        "Peripheral vision loss predominates",
        "Bone spicule pigmentation on fundus exam",
        "Different genetic mutations involved"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of central vision loss",
