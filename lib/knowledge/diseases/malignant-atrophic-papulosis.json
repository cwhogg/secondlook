  "keyFindings": {
    "laboratory": [
      "Non-specific inflammatory markers may be elevated",
      "Normal autoantibody panels (ANA, ANCA) usually negative"
    ],
    "imaging": [
      "MRI showing CNS infarcts",
      "CT or endoscopy revealing gastrointestinal ulcerations and infarcts"
    ],
    "genetic": [
      "No consistent genetic mutation identified; considered sporadic or autoimmune",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Skin biopsy demonstrating wedge-shaped dermal necrosis and occlusive vasculopathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "livedoid-vasculopathy",
      "distinguishingFeatures": [
        "Livedoid vasculopathy presents with painful ulcers and livedo racemosa rather than porcelain-white papules",
        "Histopathology shows fibrin thrombi without wedge-shaped necrosis"
      ]
    },
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "Presence of systemic autoantibodies (ANA, anti-dsDNA)",
        "Different skin lesion morphology and systemic manifestations"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of gastrointestinal ischemia with risk of perforation",
    "Neurological deficits indicating CNS infarcts",
    "Development of systemic involvement indicating malignant course"
  ],
