  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for GAPO syndrome",
    "criteria": [
      {
        "id": "growth-retardation",
        "description": "Severe postnatal growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alopecia",
        "description": "Progressive alopecia involving scalp and eyebrows",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pseudoanodontia",
        "description": "Delayed or absent eruption of teeth (pseudoanodontia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "optic-atrophy",
        "description": "Bilateral optic atrophy leading to visual impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-features",
        "description": "Characteristic craniofacial dysmorphism including prominent forehead, large nose, and prognathism",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "delayed-psychomotor-development",
        "description": "Mild to moderate developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all four major criteria: severe growth retardation, alopecia, pseudoanodontia, and optic atrophy",
    "notes": "Genetic testing for mutations in the ANTXR1 gene can confirm diagnosis"
  },
