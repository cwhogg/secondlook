  "diagnosticCriteria": {
    "formalCriteriaName": "3q13 Microdeletion Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of a heterozygous microdeletion involving the 3q13 region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Neonatal or infantile hypotonia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "dysmorphic-features",
        "description": "Characteristic craniofacial dysmorphic features including macrocephaly, frontal bossing, and hypertelorism",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-issues",
        "description": "Behavioral abnormalities such as autistic features or attention deficit",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of a pathogenic 3q13 microdeletion plus developmental delay or intellectual disability",
    "notes": "Diagnosis is confirmed by genetic testing; clinical features support but are variable."
  },
