  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild elevation of FSH and LH in some cases"
    ],
    "imaging": [
      "Brain MRI may show nonspecific findings related to developmental delays"
    ],
    "genetic": [
      "Karyotype showing 47,XYY",
      "Fluorescence in situ hybridization (FISH) confirming extra Y chromosome"
    ],
    "other": [
      "Neuropsychological testing revealing mild cognitive and behavioral impairments"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "klinefelter-syndrome",
      "distinguishingFeatures": [
        "Presence of an extra X chromosome (47,XXY) instead of Y",
        "More pronounced hypogonadism and infertility",
        "Gynecomastia more common and severe"
      ]
    },
    {
      "diseaseId": "fragile-x-syndrome",
      "distinguishingFeatures": [
        "Intellectual disability more severe",
        "Distinct facial features (long face, large ears)",
        "Family history of fragile X mutation"
      ]
    }
  ],
