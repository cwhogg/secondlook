  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Congenital Myasthenic Syndromes",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of fatigable muscle weakness with onset in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electrophysiological evidence of impaired neuromuscular transmission including decremental response on repetitive nerve stimulation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes encoding synaptic proteins (e.g., COLQ, CHAT)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-treatment",
        "description": "Clinical improvement with acetylcholinesterase inhibitors or other targeted therapies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of autoimmune myasthenia gravis and other neuromuscular disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of fatigable muscle weakness with electrophysiological evidence of neuromuscular transmission defect and identification of pathogenic synaptic gene variants",
    "notes": "Genetic confirmation is critical for subtype classification and treatment guidance."
  },
