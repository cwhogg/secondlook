  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Imaging Criteria for Acute Peripheral Arterial Occlusion",
    "criteria": [
      {
        "id": "sudden-limb-ischemia",
        "description": "Sudden onset of limb ischemia symptoms including pain, pallor, pulselessness, paresthesia, paralysis, and poikilothermia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-pulse",
        "description": "Absent or diminished distal arterial pulses in the affected limb",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-confirmation",
        "description": "Confirmation of arterial occlusion by Doppler ultrasound, CT angiography, or conventional angiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "history-of-embolism-or-thrombosis",
        "description": "History of embolic events or thrombosis predisposing to arterial occlusion",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "limb-coldness",
        "description": "Coldness of the affected limb compared to contralateral side",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of sudden limb ischemia symptoms with absent distal pulses and imaging confirmation of arterial occlusion",
    "notes": "Early diagnosis is critical to prevent limb loss; clinical suspicion should prompt urgent vascular imaging."
  },
