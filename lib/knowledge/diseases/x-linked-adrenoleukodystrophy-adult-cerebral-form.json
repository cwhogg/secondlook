  "keyFindings": {
    "laboratory": [
      "Elevated plasma very long chain fatty acids (VLCFA)",
      "Low cortisol and elevated ACTH levels indicating adrenal insufficiency",
      "Abnormal adrenal function tests"
    ],
    "imaging": [
      "MRI showing symmetrical cerebral white matter demyelination, especially parieto-occipital regions",
      "Contrast enhancement at lesion edges in active disease"
    ],
    "genetic": [
      "Pathogenic mutations in ABCD1 gene on X chromosome"
    ],
    "other": [
      "Adrenal gland atrophy on imaging",
      "Neurophysiological evidence of peripheral neuropathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "multiple-sclerosis",
      "distinguishingFeatures": [
        "Relapsing-remitting course",
        "Oligoclonal bands in CSF",
        "Lesions not typically involving adrenal insufficiency"
      ]
    },
    {
      "diseaseId": "metachromatic-leukodystrophy",
      "distinguishingFeatures": [
        "Arylsulfatase A deficiency",
        "Different pattern of demyelination on MRI",
        "No adrenal insufficiency"
      ]
    },
    {
      "diseaseId": "adrenomyeloneuropathy",
      "distinguishingFeatures": [
        "Adult-onset spinal cord predominant symptoms",
        "Less prominent cerebral involvement",
        "Similar VLCFA elevation but different clinical presentation"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive cognitive decline in adult male",
    "Signs of adrenal crisis (hypotension, hyperpigmentation, electrolyte imbalance)",
    "Characteristic MRI white matter changes with contrast enhancement"
  ],
