  "diagnosticCriteria": {
    "formalCriteriaName": "Comprehensive Diagnostic Criteria for IgG4-Related Disease",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Persistent swelling or enlargement of lacrimal and/or salivary glands",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serum-igg4-elevation",
        "description": "Elevated serum IgG4 concentration (>135 mg/dL)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Characteristic histopathological features including dense lymphoplasmacytic infiltrate rich in IgG4-positive plasma cells, storiform fibrosis, and obliterative phlebitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Imaging evidence of glandular enlargement with homogeneous enhancement on CT or MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical presentation, elevated serum IgG4, and characteristic histopathology) must be met for definitive diagnosis.",
    "notes": "Exclusion of other causes such as Sjögren’s syndrome and lymphoma is essential."
  },
