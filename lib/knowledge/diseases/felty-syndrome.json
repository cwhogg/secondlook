  "diagnosticCriteria": {
    "formalCriteriaName": "Felty Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-rheumatoid-arthritis",
        "description": "Presence of chronic rheumatoid arthritis, usually seropositive",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neutropenia",
        "description": "Persistent neutropenia with absolute neutrophil count <1500/mm³",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "splenomegaly",
        "description": "Clinically or radiologically confirmed splenomegaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "positive-rheumatoid-factor",
        "description": "Positive rheumatoid factor serology",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "anti-ccp-antibodies",
        "description": "Presence of anti-cyclic citrullinated peptide antibodies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic rheumatoid arthritis, neutropenia, and splenomegaly",
    "notes": "Diagnosis is clinical and supported by laboratory findings; exclusion of other causes of neutropenia is essential."
