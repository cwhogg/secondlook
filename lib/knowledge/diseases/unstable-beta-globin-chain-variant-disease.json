      "Decreased hemoglobin and hematocrit"
    ],
    "imaging": [
      "Ultrasound evidence of splenomegaly",
      "Abdominal ultrasound showing gallstones"
    ],
    "genetic": [
      "HBB (causative)",
      "Autosomal dominant inheritance"
    ],
