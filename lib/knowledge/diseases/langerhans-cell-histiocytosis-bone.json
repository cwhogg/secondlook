  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (ESR, CRP) in some cases",
      "Normal or mildly elevated white blood cell count",
      "No specific serologic markers"
    ],
    "imaging": [
      "X-ray showing lytic, punched-out bone lesions",
      "CT/MRI for extent and soft tissue involvement",
      "Bone scintigraphy may show multiple lesions"
    ],
    "genetic": [
      "Somatic mutations in BRAF V600E in ~50% of cases",
      "MAP2K1 mutations in some cases"
    ],
    "other": [
      "Histopathology showing Langerhans cells with Birbeck granules on electron microscopy",
      "Immunohistochemistry positive for CD1a, Langerin (CD207), and S100"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "osteomyelitis",
      "distinguishingFeatures": [
        "Infectious etiology with systemic signs of infection",
        "Positive cultures or response to antibiotics",
        "Lack of clonal Langerhans cells on biopsy"
      ]
    },
    {
      "diseaseId": "metastatic-bone-disease",
      "distinguishingFeatures": [
        "History of primary malignancy",
        "Different radiologic pattern (often mixed lytic and sclerotic)",
        "Absence of Langerhans cells on histology"
      ]
    },
    {
      "diseaseId": "multiple-myeloma",
      "distinguishingFeatures": [
        "Presence of monoclonal protein in serum or urine",
        "Older age group",
        "Plasma cells on bone marrow biopsy"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive bone destruction",
    "Neurological symptoms indicating CNS involvement",
    "Pathological fractures causing functional impairment"
  ],
