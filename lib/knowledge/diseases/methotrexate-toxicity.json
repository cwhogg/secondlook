        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pulmonary-symptoms",
        "description": "Interstitial pneumonitis or pulmonary infiltrates",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "History of methotrexate use plus at least two major criteria including hematologic abnormalities",
    "notes": "Diagnosis is clinical and supported by laboratory findings; exclusion of other causes is essential."
  },
