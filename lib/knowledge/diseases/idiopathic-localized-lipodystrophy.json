  "diagnosticCriteria": {
    "formalCriteriaName": "Idiopathic Localized Lipodystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "localized-fat-loss",
        "description": "Presence of well-demarcated, localized loss of subcutaneous adipose tissue without preceding trauma or injection",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-systemic-involvement",
        "description": "No evidence of generalized or partial lipodystrophy or systemic metabolic abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathological-confirmation",
        "description": "Histopathology showing selective loss of adipocytes with minimal inflammation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-secondary-causes",
        "description": "Exclusion of secondary causes such as injections, trauma, infections, or autoimmune diseases",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met with exclusion of secondary causes",
    "notes": "Diagnosis is primarily clinical supported by histopathology and exclusion of other causes"
  },
