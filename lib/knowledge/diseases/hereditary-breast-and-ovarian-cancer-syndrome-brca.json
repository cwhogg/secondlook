  "differentialDiagnoses": [
    {
      "diseaseId": "li-fraumeni-syndrome",
      "distinguishingFeatures": [
        "TP53 mutation instead of BRCA mutations",
        "Broader spectrum of cancers including sarcomas and brain tumors",
