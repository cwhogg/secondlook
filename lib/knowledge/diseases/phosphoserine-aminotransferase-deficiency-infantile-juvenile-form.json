      "diseaseId": "serine-biosynthesis-deficiency",
      "distinguishingFeatures": [
        "Includes deficiencies in PHGDH, PSAT1, and PSPH genes",
        "Overlapping clinical features but requires genetic differentiation",
        "Variable response to serine supplementation"
      ]
    }
