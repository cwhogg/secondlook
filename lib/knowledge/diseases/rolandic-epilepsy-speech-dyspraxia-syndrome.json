  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Rolandic Epilepsy-Speech Dyspraxia Syndrome",
    "criteria": [
      {
        "id": "clinical-seizures",
        "description": "Presence of focal seizures with centrotemporal (rolandic) EEG spikes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "speech-dyspraxia",
        "description": "Clinical evidence of developmental speech dyspraxia or childhood apraxia of speech",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-of-onset",
        "description": "Onset of seizures and speech difficulties typically between ages 3 and 13",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-neurodevelopment",
        "description": "Normal neurodevelopmental milestones prior to onset",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-neurological-disorders",
        "description": "No evidence of other neurological or structural brain abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of focal seizures with centrotemporal EEG spikes plus clinical evidence of speech dyspraxia in a child aged 3-13 years without other neurological abnormalities",
    "notes": "Diagnosis is clinical and supported by EEG findings; neuroimaging is typically normal."
  },
