  "keyFindings": {
    "laboratory": [
      "Elevated plasma very long chain fatty acids (VLCFA)",
      "Adrenal hormone profile consistent with primary adrenal insufficiency",
      "Normal routine blood counts and metabolic panels"
    ],
    "imaging": [
      "MRI brain showing bilateral symmetric demyelination in parieto-occipital white matter",
      "Contrast enhancement at lesion margins in active disease"
    ],
    "genetic": [
      "ABCD1 (causative)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Adrenal gland atrophy on imaging in some cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "metachromatic-leukodystrophy",
      "distinguishingFeatures": [
        "Arylsulfatase A deficiency",
        "Different pattern of white matter involvement on MRI",
        "Absence of elevated VLCFA"
      ]
    },
    {
      "diseaseId": "adrenomyeloneuropathy",
      "distinguishingFeatures": [
        "Adult onset with predominant spinal cord involvement",
        "Slower progression",
        "Less prominent cerebral demyelination on MRI"
      ]
    },
    {
      "diseaseId": "multiple sclerosis",
      "distinguishingFeatures": [
        "Relapsing-remitting course",
        "Oligoclonal bands in CSF",
        "MRI lesions not symmetric and not primarily parieto-occipital"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive neurocognitive decline in a young male",
    "Characteristic parieto-occipital demyelination on MRI",
    "Elevated plasma VLCFA levels"
  ],
