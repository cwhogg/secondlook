  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (ESR, CRP) often normal or mildly elevated",
      "CSF pleocytosis and elevated protein",
      "Negative systemic autoimmune serologies"
    ],
    "imaging": [
      "MRI brain showing multifocal ischemic lesions or infarcts",
      "Conventional cerebral angiography demonstrating segmental narrowing and beading of cerebral vessels",
      "High-resolution vessel wall MRI showing vessel wall enhancement"
    ],
    "genetic": [
      "No known genetic mutations associated"
    ],
    "other": [
      "Brain biopsy showing transmural inflammation of small and medium-sized vessels with lymphocytic infiltrate"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "secondary-angiitis-of-the-central-nervous-system",
      "distinguishingFeatures": [
        "Presence of systemic vasculitis features",
        "Positive systemic autoimmune markers",
        "Evidence of systemic organ involvement"
      ]
    },
    {
      "diseaseId": "reversible-cerebral-vasoconstriction-syndrome",
      "distinguishingFeatures": [
        "Thunderclap headache onset",
        "Reversible segmental cerebral artery narrowing on angiography",
        "Lack of inflammatory CSF changes"
      ]
    },
    {
      "diseaseId": "infectious-vasculitis-of-the-cns",
      "distinguishingFeatures": [
        "Positive infectious serologies or cultures",
        "Response to antimicrobial therapy",
        "Presence of systemic infection signs"
      ]
    }
  ],
  "redFlags": [
