  "diagnosticCriteria": {
    "formalCriteriaName": "Arachnodactyly-Abnormal Ossification-Intellectual Disability Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "arachnodactyly",
        "description": "Presence of abnormally long and slender fingers and toes (arachnodactyly)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-ossification",
        "description": "Radiological evidence of abnormal ossification including ectopic bone formation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Documented intellectual disability ranging from mild to severe",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including elongated face and high-arched palate",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "joint-hypermobility",
        "description": "Generalized joint hypermobility without systemic connective tissue disorder",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: arachnodactyly, abnormal ossification on imaging, and intellectual disability",
    "notes": "Diagnosis is clinical supported by radiological and neurodevelopmental assessments."
  },
