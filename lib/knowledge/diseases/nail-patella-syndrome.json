  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Nail-Patella Syndrome",
    "criteria": [
      {
        "id": "nail-dysplasia",
        "description": "Presence of nail dysplasia including absent, hypoplastic, or dystrophic nails especially affecting thumbnails",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "patellar-hypoplasia",
        "description": "Hypoplasia or aplasia of the patella confirmed clinically or radiographically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "iliac-horns",
        "description": "Radiographic evidence of bilateral iliac horns on pelvic X-ray",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-involvement",
        "description": "Proteinuria or nephropathy suggestive of renal involvement",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of nail dysplasia and patellar hypoplasia, with or without iliac horns",
    "notes": "Genetic testing for LMX1B mutations can confirm diagnosis but is not mandatory."
  },
