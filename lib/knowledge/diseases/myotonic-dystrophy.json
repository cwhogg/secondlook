  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 65,
      "peak": 14
    },
    "sexPredilection": "equal",
    "ethnicAssociations": [
      "DM1 affects all ethnicities; most common muscular dystrophy in adults of European descent",
      "DM1 extremely high prevalence in Saguenay-Lac-Saint-Jean region of Quebec (founder effect)",
      "DM2 primarily affects populations of European descent",
      "DM2 very rare in other ethnicities"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Criteria",
    "criteria": [
      {
        "id": "dm-1",
        "description": "Clinical myotonia (delayed relaxation after muscle contraction)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "dm-2",
        "description": "Progressive distal weakness and wasting (DM1) or proximal weakness (DM2)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "dm-3",
        "description": "Multisystem involvement (cataracts, cardiac, endocrine, CNS)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "dm-4",
        "description": "CTG repeat expansion in DMPK gene (DM1) or CCTG repeat expansion in CNBP/ZNF9 gene (DM2)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dm-5",
        "description": "EMG showing myotonic discharges",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation with CTG repeat expansion in DMPK (DM1) or CCTG expansion in CNBP (DM2). Clinical features support testing but genetic test is definitive.",
    "notes": "DM1 CTG repeats: normal 5-34, premutation 35-49, pathogenic 50-~4000+. DM1 shows anticipation with maternal transmission causing congenital form. DM2 does not have congenital form and is generally milder. Congenital DM1 presents with hypotonia and respiratory failure in neonates."
  },
