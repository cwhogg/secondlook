  "diagnosticCriteria": {
    "formalCriteriaName": "Frasier Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "wt1-mutation",
        "description": "Presence of pathogenic WT1 gene mutation, typically splice-site mutations affecting exon 9",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gonadal-dysgenesis",
        "description": "Gonadal dysgenesis with ambiguous or female external genitalia in 46,XY individuals",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-glomerulopathy",
        "description": "Progressive nephropathy characterized by steroid-resistant nephrotic syndrome and focal segmental glomerulosclerosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gonadoblastoma-risk",
        "description": "Increased risk of gonadoblastoma in dysgenetic gonads",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of WT1 mutation plus clinical evidence of gonadal dysgenesis and progressive nephropathy",
    "notes": "Genetic testing is essential for confirmation; renal biopsy may support diagnosis"
  },
