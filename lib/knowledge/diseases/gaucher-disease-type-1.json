  "keyFindings": {
    "laboratory": [
      "Reduced glucocerebrosidase enzyme activity in leukocytes or fibroblasts",
      "Anemia and thrombocytopenia on complete blood count",
      "Elevated chitotriosidase and CCL18/PARC levels as biomarkers"
    ],
    "imaging": [
      "MRI showing bone marrow infiltration and osteonecrosis",
      "Ultrasound or CT demonstrating hepatosplenomegaly",
      "Skeletal X-rays showing Erlenmeyer flask deformity of distal femur"
    ],
    "genetic": [
      "GBA1 (causative)",
      "SCARB2 (modifier)",
      "Autosomal recessive inheritance"
    ],
