  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild hypothyroidism on thyroid function tests"
    ],
    "imaging": [
      "Skull X-ray or CT showing premature cranial suture fusion",
      "Echocardiogram detecting septal defects",
      "Renal ultrasound revealing structural anomalies"
    ],
    "genetic": [
      "FGFR2 (causative)",
      "No specific gene identified; suspected autosomal recessive inheritance pattern",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Dermatological biopsy showing hyperkeratosis and papillomatosis in acanthosis nigricans lesions"
    ]
  },
  "differentialDiagnoses": [
