    "ethnicAssociations": [
      "All ethnicities affected; most common cause of hyperthyroidism in iodine-sufficient regions"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "ATA/AACE Clinical Guidelines for Hyperthyroidism and Graves Disease",
    "criteria": [
      {
        "id": "gd-1",
        "description": "Suppressed TSH with elevated free T4 and/or free T3 (thyrotoxicosis)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gd-2",
        "description": "Positive TSH receptor antibodies (TRAb/TSI)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gd-3",
        "description": "Diffuse increased radioiodine uptake on thyroid scan",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gd-4",
        "description": "Diffuse goiter on examination",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "gd-5",
        "description": "Graves ophthalmopathy (proptosis, lid retraction, periorbital edema)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gd-6",
        "description": "Thyroid bruit on auscultation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical thyrotoxicosis (suppressed TSH, elevated free T4/T3) plus positive TRAb or diffuse increased uptake on thyroid scan",
    "notes": "In the presence of typical Graves ophthalmopathy with thyrotoxicosis, the diagnosis can be made clinically without further testing."
  },
  "symptoms": {
