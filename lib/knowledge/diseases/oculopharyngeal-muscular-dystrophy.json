  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Oculopharyngeal Muscular Dystrophy",
    "criteria": [
      {
        "id": "ptosis",
        "description": "Progressive bilateral ptosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysphagia",
        "description": "Progressive dysphagia due to pharyngeal muscle weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Detection of expanded GCN trinucleotide repeat in PABPN1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-weakness",
        "description": "Mild proximal limb muscle weakness",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing rimmed vacuoles and intranuclear inclusions",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive bilateral ptosis and dysphagia with confirmatory genetic testing for PABPN1 mutation",
    "notes": "Muscle biopsy is supportive but not mandatory if genetic testing is positive."
  },
