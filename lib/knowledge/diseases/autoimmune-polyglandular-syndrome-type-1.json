{
  "id": "autoimmune-polyglandular-syndrome-type-1",
  "name": "Autoimmune Polyglandular Syndrome Type 1",
  "aliases": [
    "APS Type 1",
    "Autoimmune Polyendocrinopathy-Candidiasis-Ectodermal Dystrophy (APECED)"
  ],
  "icd10Codes": [
    "E31.0"
  ],
  "omimId": "240300",
  "orphanetId": "284",
  "prevalence": {
    "estimate": "1 in 100,000 to 1 in 200,000",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 20,
      "peak": 5
    },
    "sexPredilection": "equal",
    "ethnicAssociations": [
      "Finnish",
      "Iranian Jewish",
      "Norwegian"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Ferre-Lionakis Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-mucocutaneous-candidiasis",
        "description": "Presence of chronic mucocutaneous candidiasis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypoparathyroidism",
        "description": "Hypoparathyroidism confirmed by laboratory testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "adrenal-insufficiency",
        "description": "Primary adrenal insufficiency (Addison’s disease)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoantibodies-aps1",
        "description": "Presence of autoantibodies against interferon-ω and interferon-α",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least two of the three major criteria: chronic mucocutaneous candidiasis, hypoparathyroidism, and adrenal insufficiency",
    "notes": "Genetic testing for AIRE gene mutations supports diagnosis"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Chronic mucocutaneous candidiasis",
        "frequency": 0.95,
        "bodySystem": "immunological",
        "notes": "Recurrent or persistent Candida infections of skin, nails, and mucosa"
      },
      {
        "symptomName": "Hypoparathyroidism",
        "frequency": 0.85,
        "bodySystem": "endocrine",
        "notes": "Leads to hypocalcemia and tetany"
      },
      {
        "symptomName": "Primary adrenal insufficiency",
        "frequency": 0.75,
        "bodySystem": "endocrine",
        "notes": "Addison’s disease causing fatigue, hypotension, and hyperpigmentation"
      }
    ],
    "common": [
      {
        "symptomName": "Alopecia areata",
        "frequency": 0.65,
        "bodySystem": "dermatological",
        "notes": "Patchy hair loss"
      },
      {
        "symptomName": "Dental enamel hypoplasia",
        "frequency": 0.6,
        "bodySystem": "musculoskeletal",
        "notes": "Defective tooth enamel development"
      },
      {
        "symptomName": "Gastrointestinal malabsorption",
        "frequency": 0.55,
        "bodySystem": "gastrointestinal",
        "notes": "Diarrhea and nutrient deficiencies"
      },
      {
        "symptomName": "Keratitis",
        "frequency": 0.5,
        "bodySystem": "ophthalmological",
        "notes": "Inflammation of the cornea"
      }
    ],
    "occasional": [
      {
        "symptomName": "Chronic diarrhea",
        "frequency": 0.4,
        "bodySystem": "gastrointestinal",
        "notes": "Due to autoimmune enteropathy"
      },
      {
        "symptomName": "Vitiligo",
        "frequency": 0.35,
        "bodySystem": "dermatological",
        "notes": "Depigmented skin patches"
      },
      {
        "symptomName": "Nail dystrophy",
        "frequency": 0.3,
        "bodySystem": "dermatological",
        "notes": "Abnormal nail growth and appearance"
      },
      {
        "symptomName": "Autoimmune hepatitis",
        "frequency": 0.2,
        "bodySystem": "gastrointestinal",
        "notes": "Liver inflammation due to autoimmunity"
      },
      {
        "symptomName": "Pneumonitis",
        "frequency": 0.15,
        "bodySystem": "respiratory",
        "notes": "Inflammation of lung tissue"
      }
    ],
    "rare": [
      {
        "symptomName": "Enamel hypoplasia-related dental caries",
        "frequency": 0.08,
        "bodySystem": "musculoskeletal",
        "notes": "Increased susceptibility to cavities"
      },
      {
        "symptomName": "Primary ovarian insufficiency",
        "frequency": 0.07,
        "bodySystem": "reproductive",
        "notes": "Premature ovarian failure in females"
      },
      {
        "symptomName": "Autoimmune thyroiditis",
        "frequency": 0.05,
        "bodySystem": "endocrine",
        "notes": "Hashimoto’s thyroiditis or hypothyroidism"
      },
      {
        "symptomName": "Chronic active hepatitis",
        "frequency": 0.04,
        "bodySystem": "gastrointestinal",
        "notes": "Progressive liver disease"
      }
    ]
  },
  "systemsAffected": [
    "endocrine",
    "immunological",
    "dermatological",
    "gastrointestinal",
    "ophthalmological",
    "reproductive",
    "respiratory",
    "constitutional"
  ],
  "keyFindings": {
    "laboratory": [
      "Hypocalcemia with low parathyroid hormone levels",
      "Elevated ACTH with low cortisol (adrenal insufficiency)",
      "Presence of autoantibodies against interferon-ω and interferon-α",
      "Positive anti-adrenal and anti-parathyroid antibodies"
    ],
    "imaging": [
      "Adrenal gland atrophy on CT or MRI",
      "Dental radiographs showing enamel hypoplasia"
    ],
    "genetic": [
      "Biallelic mutations in the AIRE gene"
    ],
    "other": [
      "Histopathology of affected tissues showing lymphocytic infiltration",
      "Positive fungal cultures from mucocutaneous lesions"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autoimmune-polyglandular-syndrome-type-2",
      "distinguishingFeatures": [
        "Later onset (usually adulthood)",
        "Absence of chronic mucocutaneous candidiasis",
        "Different genetic background (HLA associations)"
      ]
    },
    {
      "diseaseId": "isolated-primary-adrenal-insufficiency",
      "distinguishingFeatures": [
        "Lack of other endocrine or mucocutaneous manifestations",
        "No AIRE gene mutations",
        "Negative interferon autoantibodies"
      ]
    }
  ],
  "redFlags": [
    "Recurrent or persistent mucocutaneous candidiasis in a child",
    "Hypocalcemic tetany or seizures due to hypoparathyroidism",
    "Signs of adrenal crisis such as hypotension, fatigue, and hyperpigmentation"
  ],
  "specialistType": [
    "Endocrinologist",
    "Immunologist",
    "Dermatologist",
    "Gastroenterologist"
  ],
