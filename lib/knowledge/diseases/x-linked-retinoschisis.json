  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for X-linked Retinoschisis",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Bilateral foveal schisis with characteristic spoke-wheel pattern on fundus examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroretinogram",
        "description": "Reduced b-wave amplitude with normal a-wave on electroretinography (ERG)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic RS1 gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical findings plus either compatible ERG findings or confirmed RS1 gene mutation",
    "notes": "Genetic testing is confirmatory; ERG helps differentiate from other retinal dystrophies."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Bilateral foveal schisis with spoke-wheel pattern",
        "frequency": 0.9,
        "bodySystem": "ophthalmological",
        "notes": "Classic fundoscopic finding",
        "searchTerms": [
          "central retinal splitting with spoke pattern",
          "foveal schisis with wheel-like appearance",
          "eye retina splitting in center"
        ]
      },
      {
        "symptomName": "Reduced b-wave amplitude with normal a-wave on ERG",
        "frequency": 0.85,
        "bodySystem": "ophthalmological",
        "notes": "Electrophysiological hallmark",
        "searchTerms": [
          "reduced ERG b-wave with normal a-wave",
          "abnormal retinal response with normal initial wave",
          "decreased b-wave amplitude on eye test"
        ]
      }
    ],
    "common": [
      {
        "symptomName": "Progressive central vision loss",
        "frequency": 0.75,
        "bodySystem": "ophthalmological",
        "notes": "Usually presents in childhood",
        "searchTerms": [
          "gradual loss of central vision",
          "progressive central eyesight decline",
          "worsening vision in center of eye"
