  "diagnosticCriteria": {
    "formalCriteriaName": "International Criteria for Behcet's Disease (ICBD) 2014",
    "criteria": [
      {
        "id": "bd-1",
        "description": "Recurrent oral aphthous ulcers (2 points)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "bd-2",
        "description": "Genital aphthous ulcers (2 points)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "bd-3",
        "description": "Ocular lesions: anterior uveitis, posterior uveitis, retinal vasculitis (2 points)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "bd-4",
        "description": "Skin lesions: erythema nodosum, pseudofolliculitis, papulopustular lesions, acneiform nodules (1 point)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "bd-5",
        "description": "Vascular manifestations: arterial thrombosis, large vein thrombosis, phlebitis, superficial phlebitis (1 point)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "bd-6",
        "description": "Positive pathergy test (1 point; optional, applied in countries where pathergy testing is performed)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "bd-7",
        "description": "Neurological manifestations (1 point)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Total score >= 4 points",
    "notes": "Oral ulcers are the most common manifestation but are no longer an absolute requirement. Pathergy test specificity varies by geography and is most reliable in endemic regions."
  },
