  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Poland Syndrome",
    "criteria": [
      {
        "id": "chest-wall-hypoplasia",
        "description": "Unilateral absence or hypoplasia of the pectoralis major muscle",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "upper-limb-anomalies",
        "description": "Ipsilateral upper limb anomalies such as symbrachydactyly or brachydactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rib-abnormalities",
        "description": "Presence of rib cage deformities or absence of ribs on the affected side",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "breast-hypoplasia",
        "description": "Ipsilateral breast and nipple hypoplasia or aplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of unilateral pectoralis major muscle hypoplasia or absence plus at least one ipsilateral upper limb anomaly",
    "notes": "Diagnosis is primarily clinical; imaging may assist in confirming musculoskeletal anomalies."
  },
