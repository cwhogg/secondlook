  "keyFindings": {
    "laboratory": [
      "Hypokalemia with metabolic alkalosis",
      "Low plasma renin activity",
      "Low serum aldosterone levels",
      "Normal or low serum sodium"
    ],
    "imaging": [
      "Possible evidence of hypertensive end-organ damage on echocardiogram or renal ultrasound"
    ],
    "genetic": [
      "Gain-of-function mutations in SCNN1B or SCNN1G genes encoding epithelial sodium channel subunits"
    ],
    "other": [
      "Resistance to conventional antihypertensive therapy excluding mineralocorticoid receptor antagonists"
    ]
  },
  "differentialDiagnoses": [
