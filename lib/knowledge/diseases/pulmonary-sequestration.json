  "diagnosticCriteria": {
    "formalCriteriaName": "Pulmonary Sequestration Diagnostic Criteria",
    "criteria": [
      {
        "id": "aberrant-arterial-supply",
        "description": "Presence of nonfunctional lung tissue supplied by an aberrant systemic artery",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-bronchial-connection",
        "description": "Lack of normal connection between sequestered lung tissue and bronchial tree",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-confirmation",
        "description": "Radiologic evidence of sequestered lung segment on CT or MRI with systemic arterial supply",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Recurrent localized pulmonary infections or respiratory distress",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (aberrant arterial supply, absence of bronchial connection, and imaging confirmation) must be met",
    "notes": "Diagnosis is primarily radiologic and surgical confirmation may be required"
  },
