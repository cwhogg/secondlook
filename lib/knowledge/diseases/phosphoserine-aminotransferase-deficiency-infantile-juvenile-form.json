  "diagnosticCriteria": {
    "formalCriteriaName": "Phosphoserine Aminotransferase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of developmental delay and progressive microcephaly in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-analysis",
        "description": "Low plasma and cerebrospinal fluid serine levels with elevated phosphoserine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the PSAT1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging-findings",
        "description": "Brain MRI showing cerebral atrophy and delayed myelination",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-serine-supplementation",
        "description": "Clinical and biochemical improvement upon L-serine supplementation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus biochemical abnormalities and confirmation by genetic testing",
    "notes": "Early diagnosis is critical for initiation of serine supplementation therapy"
  },
