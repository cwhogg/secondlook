  "keyFindings": {
    "laboratory": [
      "Detection of amyloid deposits by Congo red staining with apple-green birefringence under polarized light",
      "Elevated serum amyloid P component",
      "Proteinuria in cases with renal involvement"
    ],
    "imaging": [
      "MRI showing cranial nerve enhancement or neuropathy",
      "Echocardiography indicating restrictive cardiomyopathy",
      "Corneal confocal microscopy demonstrating lattice deposits"
    ],
    "genetic": [
      "GSN (causative)",
      "Autosomal dominant inheritance pattern"
    ],
    "other": [
      "Nerve conduction studies showing sensorimotor polyneuropathy",
      "Skin or nerve biopsy confirming amyloid deposits"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "familial-amyloid-polyneuropathy",
      "distinguishingFeatures": [
        "Mutations in TTR gene instead of GSN",
        "Predominant autonomic neuropathy and cardiomyopathy",
        "Absence of corneal lattice dystrophy"
      ]
    },
    {
      "diseaseId": "senile-systemic-amyloidosis",
      "distinguishingFeatures": [
        "Late onset (>70 years)",
        "Wild-type transthyretin deposits",
        "Primarily cardiac involvement without neuropathy or corneal changes"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of cranial neuropathies",
    "Early onset corneal lattice dystrophy with systemic symptoms",
    "Family history of similar amyloid-related neuropathies"
  ],
