  "keyFindings": {
    "laboratory": [
      "Low or normal serum bile acid levels despite cholestasis",
      "Elevated atypical bile acid intermediates on urine and serum mass spectrometry",
      "Elevated liver transaminases and bilirubin",
      "Prolonged prothrombin time due to vitamin K deficiency"
    ],
    "imaging": [
      "Ultrasound showing hepatomegaly and possible liver fibrosis",
      "Liver biopsy demonstrating giant cell hepatitis and cholestasis"
    ],
    "genetic": [
      "HSD3B7 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Response to bile acid replacement therapy (e.g., cholic acid) supports diagnosis"
    ]
  },
