    "laboratory": [
      "Marked hypocholesterolemia with low LDL and HDL cholesterol",
      "Low serum levels of fat-soluble vitamins (A, D, E, K)",
      "Steatorrhea confirmed by fecal fat analysis"
    ],
    "imaging": [
      "Normal abdominal imaging; no structural abnormalities",
      "Occasional neuroimaging showing demyelination in advanced cases"
    ],
    "genetic": [
      "SAR1B (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Intestinal biopsy showing enterocytes with lipid droplet accumulation and absence of chylomicrons on electron microscopy"
    ]
  },
