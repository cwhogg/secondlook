  "keyFindings": {
    "laboratory": [
      "Elevated serum phosphate and calcium levels may be present but are not consistent",
      "Normal or mildly elevated inflammatory markers"
    ],
    "imaging": [
      "Diffuse arterial calcifications visible on X-ray, CT, or ultrasound",
      "Echocardiography showing cardiac dysfunction and possible pericardial effusion"
    ],
    "genetic": [
      "ABCC6 (causative)",
      "ENPP1 (causative, loss-of-function)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology showing calcification of the internal elastic lamina and intimal proliferation in arteries"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pseudoxanthoma-elasticum",
      "distinguishingFeatures": [
        "Calcifications primarily affect elastic fibers of skin, eyes, and arteries",
        "Later onset and presence of characteristic skin and ocular findings"
      ]
    },
    {
      "diseaseId": "idiopathic-calcification-of-arteries",
      "distinguishingFeatures": [
        "Lack of genetic mutations in ENPP1 or ABCC6",
        "Less severe or localized arterial calcifications"
      ]
    },
    {
      "diseaseId": "arterial-medial-calcification-of-uremic-arteries",
      "distinguishingFeatures": [
        "Occurs in patients with chronic kidney disease",
        "Associated with abnormal calcium-phosphate metabolism"
      ]
    }
  ],
  "redFlags": [
    "Severe heart failure within first months of life",
