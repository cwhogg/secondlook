  "differentialDiagnoses": [
    {
      "diseaseId": "sitosterolemia",
      "distinguishingFeatures": [
        "Elevated plant sterols rather than cholestanol",
        "Absence of neurological symptoms",
        "Different genetic mutations (ABCG5/ABCG8)"
      ]
    },
    {
      "diseaseId": "familial-hypercholesterolemia",
      "distinguishingFeatures": [
        "Elevated LDL cholesterol without neurological symptoms",
        "Xanthomas present but no cataracts or cerebellar signs",
        "Different lipid profile"
      ]
    },
    {
      "diseaseId": "refsum-disease",
      "distinguishingFeatures": [
        "Phytanic acid accumulation",
        "Retinitis pigmentosa and peripheral neuropathy",
        "No tendon xanthomas"
      ]
    }
  ],
