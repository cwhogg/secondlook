        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-congenital",
        "description": "Exclusion of congenital von Willebrand disease by history and family studies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of mucocutaneous bleeding, laboratory evidence of von Willebrand factor deficiency or dysfunction, and identification of an underlying associated disorder",
    "notes": "Diagnosis requires exclusion of congenital von Willebrand disease and other bleeding disorders."
