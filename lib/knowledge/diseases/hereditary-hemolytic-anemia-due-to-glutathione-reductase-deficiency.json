  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced or absent erythrocyte glutathione reductase enzyme activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chronic-hemolysis",
        "description": "Evidence of chronic hemolytic anemia with reticulocytosis and elevated indirect bilirubin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the GSR gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other enzymopathies and hemoglobinopathies causing hemolytic anemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced glutathione reductase activity plus clinical and laboratory evidence of chronic hemolytic anemia, confirmed by genetic testing",
    "notes": "Diagnosis relies heavily on enzymatic assay and molecular genetic confirmation due to rarity and nonspecific clinical features."
  },
