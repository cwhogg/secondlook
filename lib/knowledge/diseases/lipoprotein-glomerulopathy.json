  "keyFindings": {
    "laboratory": [
      "Heavy proteinuria (>3.5 g/day)",
      "Hypoalbuminemia",
      "Elevated plasma lipoprotein levels",
      "Microscopic hematuria"
    ],
    "imaging": [
      "Renal ultrasound typically normal or shows mild enlargement",
      "No specific imaging findings for lipoprotein thrombi"
    ],
    "genetic": [
      "Pathogenic mutations in APOE gene (e.g., APOE Kyoto, APOE Sendai variants)"
    ],
    "other": [
      "Renal biopsy showing lipoprotein thrombi within glomerular capillaries on light microscopy and electron microscopy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "membranous-nephropathy",
      "distinguishingFeatures": [
        "Subepithelial immune deposits on biopsy",
        "Absence of lipoprotein thrombi",
        "Positive anti-PLA2R antibodies in primary cases"
      ]
    },
    {
      "diseaseId": "focal-segmental-glomerulosclerosis",
      "distinguishingFeatures": [
        "Segmental sclerosis on biopsy",
        "No lipoprotein thrombi",
        "Often associated with secondary causes"
      ]
    },
    {
      "diseaseId": "lipid-nephrosis",
      "distinguishingFeatures": [
        "Lipid droplets in podocytes rather than thrombi in capillaries",
        "Different histopathological pattern"
      ]
    }
  ],
