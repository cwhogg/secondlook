  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Collagen biochemical studies showing altered dermatan sulfate biosynthesis"
    ],
    "imaging": [
      "Radiographs showing distal joint contractures and scoliosis",
      "Echocardiography revealing mitral valve prolapse or aortic root dilation"
    ],
    "genetic": [
      "CHST14 (causative, loss-of-function)",
      "DSE (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy demonstrating altered dermatan sulfate proteoglycan composition"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "kyphoscoliotic-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Severe congenital hypotonia with progressive scoliosis",
        "Lysyl hydroxylase deficiency",
        "Absence of distal joint contractures"
      ]
    },
    {
      "diseaseId": "classical-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Marked skin hyperextensibility and atrophic scarring",
        "Joint hypermobility without congenital contractures",
        "Mutations in COL5A1 or COL5A2 genes"
      ]
    }
  ],
  "redFlags": [
    "Severe congenital distal joint contractures",
    "Early-onset muscle hypotonia with delayed motor development",
    "Presence of characteristic craniofacial dysmorphism"
  ],
