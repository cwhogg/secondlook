  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Hyperinsulinism due to INSR Deficiency",
    "criteria": [
      {
        "id": "hypoglycemia",
        "description": "Persistent fasting hypoglycemia with inappropriately elevated insulin levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "insulin-receptor-mutation",
        "description": "Identification of pathogenic or likely pathogenic variants in the INSR gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-insulin-signaling",
        "description": "Demonstration of impaired insulin receptor function via biochemical or functional assays",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of congenital hyperinsulinism such as ABCC8 or KCNJ11 mutations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent hypoglycemia with elevated insulin levels plus identification of pathogenic INSR mutation",
    "notes": "Functional assays may support diagnosis but are not mandatory if genetic confirmation is present."
  },
