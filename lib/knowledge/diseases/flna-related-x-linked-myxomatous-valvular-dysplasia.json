        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Presence of mild skeletal abnormalities such as joint hypermobility or pectus deformities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of myxomatous valvular degeneration plus a pathogenic FLNA variant",
    "notes": "Diagnosis may be supported by family history and skeletal findings but requires genetic confirmation."
