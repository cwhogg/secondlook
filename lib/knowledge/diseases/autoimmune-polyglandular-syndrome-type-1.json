  "keyFindings": {
    "laboratory": [
      "Hypocalcemia with low parathyroid hormone levels",
      "Elevated ACTH with low cortisol (adrenal insufficiency)",
      "Presence of autoantibodies against interferon-ω and interferon-α",
      "Positive anti-adrenal and anti-parathyroid antibodies"
    ],
    "imaging": [
      "Adrenal gland atrophy on CT or MRI",
      "Dental radiographs showing enamel hypoplasia"
    ],
    "genetic": [
      "Biallelic mutations in the AIRE gene"
    ],
    "other": [
      "Histopathology of affected tissues showing lymphocytic infiltration",
      "Positive fungal cultures from mucocutaneous lesions"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autoimmune-polyglandular-syndrome-type-2",
      "distinguishingFeatures": [
        "Later onset (usually adulthood)",
        "Absence of chronic mucocutaneous candidiasis",
        "Different genetic background (HLA associations)"
      ]
    },
    {
      "diseaseId": "isolated-primary-adrenal-insufficiency",
      "distinguishingFeatures": [
        "Lack of other endocrine or mucocutaneous manifestations",
        "No AIRE gene mutations",
        "Negative interferon autoantibodies"
      ]
    }
  ],
  "redFlags": [
    "Recurrent or persistent mucocutaneous candidiasis in a child",
    "Hypocalcemic tetany or seizures due to hypoparathyroidism",
    "Signs of adrenal crisis such as hypotension, fatigue, and hyperpigmentation"
  ],
  "specialistType": [
