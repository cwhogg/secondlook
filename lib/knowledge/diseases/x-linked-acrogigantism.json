  "keyFindings": {
    "laboratory": [
      "Elevated serum growth hormone (GH)",
      "Elevated serum insulin-like growth factor 1 (IGF-1)",
      "Normal or suppressed prolactin levels"
    ],
    "imaging": [
      "MRI showing pituitary hyperplasia or microadenoma",
      "No evidence of large pituitary macroadenomas typical of other gigantism causes"
    ],
    "genetic": [
      "GPR101 gene duplication or mutation detected by molecular genetic testing",
      "X-linked dominant inheritance"
    ],
    "other": [
      "Accelerated bone age on radiographs",
      "Clinical evidence of rapid linear growth in infancy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pituitary-gigantism",
