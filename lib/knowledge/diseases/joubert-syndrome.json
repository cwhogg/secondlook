  "diagnosticCriteria": {
    "formalCriteriaName": "Joubert Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "molar-tooth-sign",
        "description": "Presence of the molar tooth sign on brain MRI indicating cerebellar vermis hypoplasia and brainstem malformation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-respiratory-pattern",
        "description": "Abnormal neonatal breathing pattern including episodic tachypnea and apnea",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia-and-developmental-delay",
        "description": "Hypotonia in infancy with global developmental delay and intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-motor-apraxia",
        "description": "Impaired voluntary horizontal eye movements (ocular motor apraxia)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "polydactyly-or-other-malformations",
        "description": "Presence of polydactyly or other congenital malformations such as renal cystic disease or retinal dystrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of the molar tooth sign on MRI plus at least two major clinical features including abnormal respiratory pattern and developmental delay",
    "notes": "Genetic testing can support diagnosis but is not mandatory."
  },
