  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Unstable Hemoglobinopathies",
    "criteria": [
      {
        "id": "clinical-hemolytic-anemia",
        "description": "Presence of chronic hemolytic anemia with reticulocytosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemoglobin-instability-test",
        "description": "Positive hemoglobin instability tests such as isopropanol or heat stability tests",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of mutations in globin genes causing unstable hemoglobin variants",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peripheral-blood-smear",
        "description": "Presence of Heinz bodies and bite cells on peripheral blood smear",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical hemolytic anemia, positive hemoglobin instability test, and genetic confirmation) must be met for diagnosis",
    "notes": "Diagnosis may be supported by peripheral blood smear findings and family history"
  },
