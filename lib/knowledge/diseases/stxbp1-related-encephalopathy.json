  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed criteria for STXBP1-related encephalopathy diagnosis",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic or likely pathogenic variant in STXBP1 gene identified by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset-epilepsy",
        "description": "Onset of epileptic seizures within the first two years of life, often neonatal or infantile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-impairment",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "movement-disorders",
        "description": "Presence of movement abnormalities such as ataxia, dystonia, or tremor",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electroencephalographic-features",
        "description": "EEG abnormalities including burst suppression, hypsarrhythmia, or focal epileptiform discharges",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Identification of a pathogenic STXBP1 variant plus early-onset epilepsy and developmental impairment",
    "notes": "Diagnosis relies heavily on genetic confirmation combined with clinical and EEG features."
  },
