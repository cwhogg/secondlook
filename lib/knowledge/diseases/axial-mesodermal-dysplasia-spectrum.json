  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible thyroid function abnormalities in some cases"
    ],
    "imaging": [
      "Spinal X-rays showing vertebral segmentation defects",
      "Chest radiographs revealing rib anomalies",
      "Echocardiography identifying congenital heart defects",
      "Renal ultrasound demonstrating renal hypoplasia or agenesis"
    ],
    "genetic": [
      "Pathogenic variants in genes regulating axial mesoderm development (e.g., TBX6, MESP2)"
    ],
    "other": [
      "Clinical examination revealing midline facial dysmorphisms",
      "Developmental assessment for neurological involvement"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "spondylocostal-dysostosis",
      "distinguishingFeatures": [
        "Primarily vertebral and rib segmentation defects without significant facial dysmorphisms",
        "Inheritance pattern often autosomal recessive"
      ]
    },
    {
      "diseaseId": "vacterl-association",
      "distinguishingFeatures": [
        "Combination of vertebral defects, anal atresia, cardiac defects, tracheoesophageal fistula, renal anomalies, and limb abnormalities",
        "More variable phenotype with multiple system involvement"
      ]
    }
  ],
  "redFlags": [
    "Severe respiratory distress due to pulmonary hypoplasia",
    "Congenital heart failure symptoms in neonatal period",
    "Progressive neurological impairment or developmental delay"
  ],
