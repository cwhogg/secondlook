  "keyFindings": {
    "laboratory": [
      "Low serum niacin (nicotinic acid) or NAD/NADP levels",
      "Mild anemia and hypoalbuminemia",
      "Elevated liver enzymes in chronic cases"
    ],
    "imaging": [
      "Brain MRI may show cortical atrophy in advanced dementia"
    ],
    "genetic": [
      "No primary genetic etiology; secondary to nutritional deficiency"
    ],
    "other": [
      "Clinical improvement after niacin supplementation confirms diagnosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "seborrheic-dermatitis",
      "distinguishingFeatures": [
        "Non-symmetrical rash",
        "Involvement of scalp and oily skin areas",
        "Lack of gastrointestinal and neuropsychiatric symptoms"
      ]
    },
    {
      "diseaseId": "carcinoid-syndrome",
      "distinguishingFeatures": [
        "Flushing rather than photosensitive dermatitis",
        "Presence of diarrhea but with elevated serotonin metabolites",
        "No response to niacin supplementation"
      ]
    },
    {
      "diseaseId": "hartnup-disease",
      "distinguishingFeatures": [
        "Genetic disorder causing niacin deficiency",
        "Presence of aminoaciduria",
        "Usually presents in childhood"
      ]
    }
  ],
  "redFlags": [
    "Progressive dementia and cognitive decline",
    "Severe dehydration from chronic diarrhea",
    "Worsening photosensitive dermatitis with secondary infection"
  ],
