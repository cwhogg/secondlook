  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Pallister-Killian Syndrome",
    "criteria": [
      {
        "id": "mosaic-tetrasomy-12p",
        "description": "Presence of mosaic tetrasomy of chromosome 12p detected by cytogenetic or molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial dysmorphisms including high forehead, sparse scalp hair, hypertelorism, and flat nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay and intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Congenital hypotonia observed in infancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "skin-pigmentation-anomalies",
        "description": "Hypopigmented or hyperpigmented streaks or patches on the skin",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of mosaic tetrasomy 12p plus at least two major clinical features",
    "notes": "Diagnosis is confirmed by cytogenetic or molecular detection of mosaic tetrasomy 12p, often requiring skin fibroblast analysis due to low blood mosaicism."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Mosaic tetrasomy of chromosome 12p",
        "frequency": 0.95,
        "bodySystem": "constitutional",
        "notes": "Detected by cytogenetic or molecular testing; hallmark of the syndrome"
      },
      {
        "symptomName": "Distinctive craniofacial dysmorphism",
        "frequency": 0.85,
        "bodySystem": "constitutional",
        "notes": "Includes high forehead, sparse scalp hair, hypertelorism, flat nasal bridge"
      },
      {
        "symptomName": "Severe hypotonia in infancy",
        "frequency": 0.75,
        "bodySystem": "musculoskeletal",
        "notes": "Marked muscle weakness present from birth"
      }
    ],
    "common": [
      {
        "symptomName": "Intellectual disability",
        "frequency": 0.85,
        "bodySystem": "neurological",
        "notes": "Ranges from moderate to severe"
      },
      {
        "symptomName": "Epilepsy",
        "frequency": 0.65,
        "bodySystem": "neurological",
        "notes": "Seizures often develop in childhood"
      },
      {
        "symptomName": "Skin pigmentation anomalies",
        "frequency": 0.6,
        "bodySystem": "dermatological",
        "notes": "Hypo- or hyperpigmented streaks or patches"
      },
      {
        "symptomName": "Hearing impairment",
        "frequency": 0.55,
        "bodySystem": "otolaryngological",
        "notes": "Sensorineural or conductive hearing loss"
      },
      {
        "symptomName": "Congenital diaphragmatic hernia",
        "frequency": 0.5,
        "bodySystem": "respiratory",
        "notes": "May cause respiratory distress in neonates"
      }
    ],
    "occasional": [
      {
        "symptomName": "Cardiac malformations",
        "frequency": 0.4,
        "bodySystem": "cardiovascular",
        "notes": "Including ventricular septal defects and patent ductus arteriosus"
      },
      {
        "symptomName": "Gastrointestinal anomalies",
        "frequency": 0.3,
        "bodySystem": "gastrointestinal",
        "notes": "Feeding difficulties, reflux, or constipation"
      },
      {
        "symptomName": "Ophthalmological abnormalities",
        "frequency": 0.25,
        "bodySystem": "ophthalmological",
        "notes": "Strabismus, refractive errors"
      },
      {
        "symptomName": "Skeletal anomalies",
        "frequency": 0.2,
        "bodySystem": "musculoskeletal",
        "notes": "Including joint contractures and scoliosis"
      },
      {
        "symptomName": "Recurrent respiratory infections",
        "frequency": 0.15,
        "bodySystem": "respiratory",
        "notes": "Due to hypotonia and anatomical anomalies"
      }
    ],
    "rare": [
      {
        "symptomName": "Endocrine abnormalities",
        "frequency": 0.08,
        "bodySystem": "endocrine",
        "notes": "Including hypothyroidism"
      },
      {
        "symptomName": "Renal anomalies",
        "frequency": 0.05,
        "bodySystem": "renal",
        "notes": "Structural kidney abnormalities"
      },
      {
        "symptomName": "Immunological dysfunction",
        "frequency": 0.04,
        "bodySystem": "immunological",
        "notes": "Occasional immune deficiency"
      }
    ]
  },
