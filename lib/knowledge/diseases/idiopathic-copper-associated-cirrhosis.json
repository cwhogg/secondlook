  "keyFindings": {
    "laboratory": [
      "Elevated hepatic copper concentration >250 µg/g dry weight",
      "Normal serum ceruloplasmin levels",
      "Mild thrombocytopenia and coagulopathy",
      "Elevated liver transaminases (ALT, AST) mildly elevated"
    ],
    "imaging": [
      "Ultrasound showing nodular liver contour consistent with cirrhosis",
      "Doppler ultrasound demonstrating portal hypertension",
      "MRI may show liver fibrosis and copper accumulation patterns"
    ],
    "genetic": [
      "Absence of pathogenic ATP7B mutations (Wilson disease gene)"
    ],
    "other": [
      "Liver biopsy demonstrating cirrhosis with copper accumulation and absence of other etiologies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "wilson-disease",
      "distinguishingFeatures": [
        "Low ceruloplasmin levels",
        "Presence of ATP7B gene mutations",
        "Kayser-Fleischer rings on ophthalmologic exam"
      ]
    },
    {
      "diseaseId": "autoimmune-hepatitis",
      "distinguishingFeatures": [
        "Positive autoimmune markers (ANA, SMA)",
        "Elevated IgG levels",
        "Histology showing interface hepatitis without copper accumulation"
      ]
    },
    {
      "diseaseId": "alcoholic-cirrhosis",
      "distinguishingFeatures": [
        "History of significant alcohol use",
        "Characteristic histological features (steatosis, Mallory bodies)",
        "Absence of elevated hepatic copper concentration"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of liver failure",
