  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Acrocallosal Syndrome",
    "criteria": [
      {
        "id": "corpus-callosum-agensis",
        "description": "Agenesis or hypoplasia of the corpus callosum confirmed by neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "polydactyly",
        "description": "Postaxial polydactyly of hands and/or feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-features",
        "description": "Characteristic craniofacial anomalies including macrocephaly, hypertelorism, and prominent forehead",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of agenesis/hypoplasia of corpus callosum, polydactyly, and characteristic craniofacial features",
    "notes": "Genetic testing for KIF7 mutations can support diagnosis but is not mandatory"
  },
