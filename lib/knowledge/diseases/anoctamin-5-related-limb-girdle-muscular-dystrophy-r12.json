  "diagnosticCriteria": {
    "formalCriteriaName": "LGMD Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness predominantly affecting limb-girdle muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the ANO5 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes with absence or reduction of anoctamin-5 protein",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "serum-creatine-kinase",
        "description": "Elevated serum creatine kinase (CK) levels, often 10-20 times above normal",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive limb-girdle muscle weakness plus genetic confirmation of ANO5 pathogenic variants",
    "notes": "Muscle biopsy and CK elevation support diagnosis but are not mandatory if genetic testing is conclusive."
  },
