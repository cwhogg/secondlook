  "diagnosticCriteria": {
    "formalCriteriaName": "CDC Toxic Shock Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "fever",
        "description": "Fever ≥ 38.9°C (102°F)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rash",
        "description": "Diffuse macular erythroderma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotension",
        "description": "Systolic blood pressure ≤ 90 mm Hg for adults or less than fifth percentile by age for children",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multi-organ-involvement",
        "description": "Involvement of three or more organ systems (gastrointestinal, muscular, mucous membrane, renal, hepatic, hematologic, central nervous system)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "desquamation",
        "description": "Desquamation of skin, especially palms and soles, 1-2 weeks after onset",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Fever, rash, hypotension, and involvement of at least three organ systems",
    "notes": "Exclusion of other causes such as staphylococcal scalded skin syndrome and other septic shock etiologies is essential."
  },
