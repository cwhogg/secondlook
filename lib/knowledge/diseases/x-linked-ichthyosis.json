  "keyFindings": {
    "laboratory": [
      "Reduced or absent steroid sulfatase enzyme activity in leukocytes or skin fibroblasts",
      "Normal routine blood tests"
    ],
    "imaging": [
      "Ultrasound for cryptorchidism if present"
    ],
    "genetic": [
      "Deletion or mutation of STS gene on chromosome Xp22.31 detected by molecular genetic testing"
    ],
    "other": [
      "Family history consistent with X-linked inheritance"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ichthyosis-vulgaris",
      "distinguishingFeatures": [
        "Autosomal dominant inheritance",
        "Fine white scaling predominantly on extensor surfaces",
        "Normal steroid sulfatase activity"
      ]
    },
    {
      "diseaseId": "lamellar-ichthyosis",
      "distinguishingFeatures": [
        "Autosomal recessive inheritance",
        "Large, dark, plate-like scales over entire body",
        "Onset at birth with collodion membrane"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of skin scaling with systemic symptoms",
    "Signs of testicular malignancy (e.g., testicular mass or pain)",
    "Severe neurodevelopmental delay or regression"
