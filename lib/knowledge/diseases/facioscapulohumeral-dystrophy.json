  "diagnosticCriteria": {
    "formalCriteriaName": "FSHD Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-pattern",
        "description": "Progressive weakness of facial, scapular, and humeral muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-test",
        "description": "Detection of D4Z4 repeat contraction on chromosome 4q35",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "EMG showing myopathic changes consistent with muscular dystrophy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes and absence of inflammation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of FSHD or similar muscle weakness",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of typical clinical pattern plus confirmatory genetic testing for D4Z4 repeat contraction",
    "notes": "Genetic testing is considered the gold standard for diagnosis; clinical features guide testing."
  },
