  "diagnosticCriteria": {
    "formalCriteriaName": "Juvenile Open-Angle Glaucoma Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-intraocular-pressure",
        "description": "Intraocular pressure (IOP) greater than 21 mmHg on repeated measurements",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "optic-nerve-head-cupping",
        "description": "Characteristic glaucomatous optic nerve head changes including increased cup-to-disc ratio",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "visual-field-defects",
        "description": "Reproducible visual field defects consistent with glaucoma on perimetry testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "open-anterior-chamber-angle",
        "description": "Open anterior chamber angle on gonioscopy excluding angle-closure glaucoma",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of juvenile or early-onset glaucoma",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated intraocular pressure, characteristic optic nerve head changes, and corresponding visual field defects",
    "notes": "Diagnosis requires exclusion of secondary causes of glaucoma and angle-closure glaucoma."
  },
