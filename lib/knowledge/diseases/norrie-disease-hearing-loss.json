  "keyFindings": {
    "laboratory": [
      "Genetic testing identifying pathogenic variants in the NDP gene"
    ],
    "imaging": [
      "Ocular ultrasound showing retinal detachment or fibrovascular membranes",
      "MRI brain may show nonspecific findings related to developmental delay"
    ],
    "genetic": [
      "Mutations in the NDP gene on chromosome Xp11.3"
    ],
    "other": [
      "Electroretinogram (ERG) showing absent or severely reduced retinal responses",
      "Audiometry demonstrating progressive sensorineural hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "retinopathy-of-prematurity",
      "distinguishingFeatures": [
        "History of prematurity and oxygen therapy",
        "Retinal changes limited to premature infants",
        "No associated hearing loss"
      ]
    },
    {
      "diseaseId": "familial-exudative-vitreo-retinopathy",
      "distinguishingFeatures": [
        "Variable vision loss without congenital blindness",
        "No progressive sensorineural hearing loss",
        "Different genetic mutations (e.g., FZD4, LRP5)"
      ]
    },
    {
      "diseaseId": "congenital-stapes-ankylosis",
      "distinguishingFeatures": [
        "Conductive hearing loss rather than sensorineural",
        "No associated blindness",
        "Normal retinal examination"
      ]
    }
  ],
