        "requiredForDiagnosis": true
      },
      {
        "id": "prenatal-ultrasound-findings",
        "description": "Ultrasound evidence of intrauterine growth restriction and structural anomalies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed tetraploid karyotype plus presence of multiple congenital anomalies",
    "notes": "Tetraploidy is typically lethal in utero or shortly after birth; diagnosis is primarily cytogenetic."
  },
