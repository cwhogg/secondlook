  "diagnosticCriteria": {
    "formalCriteriaName": "No standardized formal criteria; diagnosis based on clinical, imaging, and histopathological findings",
    "criteria": [
      {
        "id": "fibrotic-mass",
        "description": "Presence of a retroperitoneal fibrotic mass encasing the abdominal aorta and/or ureters on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-secondary-causes",
        "description": "Exclusion of secondary causes such as malignancy, infection, or drug-induced fibrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histopathological confirmation showing fibroinflammatory tissue with absence of malignancy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-inflammatory-markers",
        "description": "Elevated ESR and CRP supporting active inflammation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of retroperitoneal fibrotic mass on imaging with exclusion of secondary causes",
    "notes": "Histopathology is helpful but not always required; clinical and radiologic correlation is essential"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Flank pain due to ureteral obstruction",
        "frequency": 0.85,
        "bodySystem": "renal",
        "notes": "Often unilateral or bilateral"
      },
      {
        "symptomName": "Palpable abdominal or flank mass",
        "frequency": 0.75,
        "bodySystem": "gastrointestinal",
        "notes": "Due to fibrotic tissue surrounding vessels and ureters"
      }
    ],
    "common": [
      {
        "symptomName": "Lower back pain",
        "frequency": 0.65,
        "bodySystem": "musculoskeletal",
        "notes": "Chronic dull ache"
      },
      {
        "symptomName": "Hydronephrosis",
        "frequency": 0.7,
        "bodySystem": "renal",
        "notes": "Secondary to ureteral obstruction"
      },
      {
        "symptomName": "Weight loss",
        "frequency": 0.6,
        "bodySystem": "constitutional",
        "notes": "Often associated with chronic inflammation"
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.55,
        "bodySystem": "constitutional",
        "notes": "Common systemic symptom"
      },
      {
        "symptomName": "Lower extremity edema",
        "frequency": 0.5,
        "bodySystem": "cardiovascular",
        "notes": "Due to venous or lymphatic obstruction"
      }
    ],
    "occasional": [
      {
        "symptomName": "Fever",
        "frequency": 0.3,
        "bodySystem": "constitutional",
        "notes": "Low-grade fever from inflammation"
      },
      {
        "symptomName": "Gastrointestinal symptoms (nausea, vomiting)",
        "frequency": 0.25,
        "bodySystem": "gastrointestinal",
        "notes": "Due to involvement of adjacent GI tract"
      },
      {
        "symptomName": "Hypertension",
        "frequency": 0.2,
        "bodySystem": "cardiovascular",
        "notes": "Secondary to renal artery involvement"
      },
      {
        "symptomName": "Anemia of chronic disease",
        "frequency": 0.15,
        "bodySystem": "hematological",
        "notes": "Reflects chronic inflammation"
      },
      {
        "symptomName": "Leg claudication",
        "frequency": 0.1,
        "bodySystem": "musculoskeletal",
        "notes": "Due to vascular involvement"
      }
    ],
    "rare": [
      {
        "symptomName": "Hydrocele",
        "frequency": 0.05,
        "bodySystem": "reproductive",
        "notes": "Due to lymphatic obstruction"
      },
      {
        "symptomName": "Testicular pain",
        "frequency": 0.04,
        "bodySystem": "reproductive",
        "notes": "Secondary to retroperitoneal fibrosis"
      },
      {
        "symptomName": "Peripheral neuropathy",
        "frequency": 0.03,
        "bodySystem": "neurological",
        "notes": "Rare involvement of nerve roots"
      }
    ]
  },
