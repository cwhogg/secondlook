    "laboratory": [
      "Normal routine blood tests; possible hypothyroidism on thyroid panel"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter abnormalities",
      "Echocardiogram revealing congenital heart defects"
    ],
    "genetic": [
      "Chromosomal microarray or karyotype showing inverted duplication and terminal deletion on chromosome 8p"
    ],
    "other": [
      "Developmental and neuropsychological assessments confirming intellectual disability and developmental delay"
    ]
  },
