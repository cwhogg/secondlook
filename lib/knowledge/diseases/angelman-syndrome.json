  "diagnosticCriteria": {
    "formalCriteriaName": "Williams et al. Consensus Criteria for Angelman Syndrome (2006 Update)",
    "criteria": [
      {
        "id": "as-c1",
        "description": "Severe developmental delay / intellectual disability with minimal or no speech",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "as-c2",
        "description": "Movement or balance disorder (ataxia, tremulous movement of limbs)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "as-c3",
        "description": "Behavioral uniqueness: frequent laughter/smiling, apparent happy demeanor, excitability with hand-flapping",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "as-c4",
        "description": "Speech impairment with minimal or no use of words; receptive language better than expressive",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "as-c5",
        "description": "Seizures (onset usually <3 years of age)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "as-c6",
        "description": "Characteristic EEG pattern (large-amplitude slow-spike waves)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "as-c7",
        "description": "Microcephaly (deceleration of head growth by age 2)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "as-c8",
        "description": "Loss of maternal UBE3A expression confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical features (all 4 major clinical criteria) confirmed by genetic testing showing loss of maternal UBE3A expression. Genetic test is confirmatory but clinical diagnosis is primary.",
    "notes": "Four genetic mechanisms: maternal deletion of 15q11-q13 (~70%), paternal UPD (~3-5%), imprinting defect (~3-5%), UBE3A mutation (~10-15%). ~10% have no identifiable molecular mechanism. Deletion class tends to have more severe phenotype."
  },
