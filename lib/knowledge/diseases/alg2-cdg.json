  "diagnosticCriteria": {
    "formalCriteriaName": "ALG2-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypotonia",
        "description": "Congenital hypotonia presenting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multisystem-involvement",
        "description": "Multisystem involvement including neurological, gastrointestinal, and musculoskeletal manifestations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-transferrin-glycosylation",
        "description": "Abnormal serum transferrin isoelectric focusing pattern indicating N-glycosylation defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pathogenic-ALG2-variants",
        "description": "Identification of biallelic pathogenic variants in the ALG2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-transaminases",
        "description": "Elevated liver transaminases as a supportive laboratory finding",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital hypotonia, abnormal transferrin glycosylation pattern, and biallelic pathogenic ALG2 variants",
    "notes": "Diagnosis is confirmed by molecular genetic testing and biochemical evidence of glycosylation defect."
  },
