  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electrophysiological Diagnostic Criteria for CMT1B",
    "criteria": [
      {
        "id": "demyelinating-neuropathy",
        "description": "Evidence of demyelinating peripheral neuropathy on nerve conduction studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mpz-gene-mutation",
        "description": "Identification of pathogenic mutation in the MPZ gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of distal muscle weakness and atrophy with sensory loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Nerve biopsy showing onion bulb formations consistent with demyelination and remyelination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of demyelinating neuropathy on electrophysiology, clinical features of distal weakness and sensory loss, and identification of MPZ gene mutation",
    "notes": "Genetic testing is essential for definitive diagnosis; nerve biopsy is rarely required."
  },
