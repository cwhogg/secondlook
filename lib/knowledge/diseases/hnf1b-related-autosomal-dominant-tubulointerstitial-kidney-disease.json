  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for HNF1B-related ADTKD",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic HNF1B mutation or deletion by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-cysts-or-dysplasia",
        "description": "Presence of renal cysts or structural kidney abnormalities on imaging",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant family history of kidney disease or diabetes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "tubulointerstitial-kidney-disease",
        "description": "Evidence of tubulointerstitial kidney disease with progressive renal impairment",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "extrarenal-manifestations",
        "description": "Presence of extrarenal features such as maturity-onset diabetes of the young (MODY5), pancreatic atrophy, or genital tract malformations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic HNF1B mutation identified plus either renal cystic/dysplastic abnormalities or tubulointerstitial kidney disease",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical features vary widely."
  },
