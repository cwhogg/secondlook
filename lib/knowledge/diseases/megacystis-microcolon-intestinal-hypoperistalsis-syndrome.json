  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for MMIHS",
    "criteria": [
      {
        "id": "megacystis",
        "description": "Presence of an enlarged urinary bladder (megacystis) detected by prenatal ultrasound or postnatal imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microcolon",
        "description": "Radiological evidence of microcolon on contrast enema studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intestinal-hypoperistalsis",
        "description": "Demonstration of decreased or absent intestinal peristalsis on manometry or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological confirmation of visceral smooth muscle abnormalities or myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with visceral myopathy (e.g., ACTG2)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of megacystis, microcolon, and intestinal hypoperistalsis documented by imaging or functional studies",
    "notes": "Diagnosis is primarily clinical and radiological; genetic and histopathological studies support but are not mandatory"
  },
