  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Congenital Fiber-Type Disproportion Myopathy",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Muscle biopsy showing type 1 fiber hypotrophy with type 1 fibers at least 12% smaller than type 2 fibers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Congenital or early-onset muscle weakness predominantly affecting proximal muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with CFTD (e.g., ACTA1, TPM3, SEPN1)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "Electromyographic evidence of myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-nerve-conduction",
        "description": "Normal nerve conduction studies to exclude neuropathic causes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic muscle biopsy findings plus clinical presentation of congenital muscle weakness",
    "notes": "Genetic testing can support diagnosis but is not mandatory; exclusion of other congenital myopathies is essential."
  },
