    "criteria": [
      {
        "id": "elevated-tsh",
        "description": "Elevated serum thyroid-stimulating hormone (TSH) levels in neonatal screening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-thyroxine",
        "description": "Low serum free thyroxine (T4) levels in confirmatory testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "transient-thyroid-dysfunction",
        "description": "Normalization of thyroid function within the first 3 years of life without ongoing treatment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with transient congenital hypothyroidism",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated neonatal TSH and low free T4 with subsequent normalization of thyroid function within 3 years",
    "notes": "Differentiation from permanent congenital hypothyroidism requires longitudinal thyroid function monitoring."
  },
