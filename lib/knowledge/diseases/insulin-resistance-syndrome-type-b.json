  "keyFindings": {
    "laboratory": [
      "Detection of insulin receptor autoantibodies",
      "Marked hyperglycemia with elevated fasting glucose and HbA1c",
      "Hyperinsulinemia despite severe insulin resistance",
      "Elevated androgen levels in females"
    ],
    "imaging": [
      "Hepatic ultrasound may show fatty infiltration",
      "Possible imaging to exclude pancreatic or adrenal tumors"
    ],
    "genetic": [
      "No consistent genetic mutations; autoimmune etiology predominant"
    ],
    "other": [
      "Association with other autoimmune disorders such as SLE, scleroderma",
      "Response to immunosuppressive therapy supports diagnosis"
    ]
  },
