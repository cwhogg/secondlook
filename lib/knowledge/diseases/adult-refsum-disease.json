  "keyFindings": {
    "laboratory": [
      "Markedly elevated plasma phytanic acid levels",
      "Normal or mildly elevated plasma pristanic acid",
      "Possible mild elevation of liver enzymes"
    ],
    "imaging": [
      "MRI brain may show cerebellar atrophy",
      "Retinal imaging consistent with retinitis pigmentosa"
    ],
    "genetic": [
      "PHYH (causative)",
      "PEX7 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electrophysiological studies showing sensorimotor peripheral neuropathy",
      "Skin biopsy may show ichthyosis"
    ]
  },
