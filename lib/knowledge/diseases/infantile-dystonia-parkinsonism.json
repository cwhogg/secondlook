  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests excluding secondary causes",
      "CSF neurotransmitter analysis may show abnormalities in dopamine metabolites"
    ],
    "imaging": [
      "Brain MRI typically normal or may show subtle basal ganglia changes",
      "DAT-SPECT imaging showing reduced dopamine transporter uptake in striatum"
    ],
    "genetic": [
      "SLC6A3 (causative)",
      "WARS2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography showing dystonic muscle activity",
      "Response variability to levodopa therapy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dopamine-responsive-dystonia",
      "distinguishingFeatures": [
        "Marked and sustained response to low-dose levodopa",
        "Later onset compared to infantile dystonia-parkinsonism"
      ]
    },
    {
      "diseaseId": "juvenile-parkinson-disease",
      "distinguishingFeatures": [
        "Predominantly parkinsonism without prominent dystonia early in disease",
        "Different genetic mutations such as PARK2"
      ]
    }
  ],
  "redFlags": [
