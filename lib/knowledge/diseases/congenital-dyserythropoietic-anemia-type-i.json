  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Congenital Dyserythropoietic Anemia Type I",
    "criteria": [
      {
        "id": "bone-marrow-abnormalities",
        "description": "Presence of characteristic binucleated erythroblasts and chromatin bridges in bone marrow aspirate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ineffective-erythropoiesis",
        "description": "Evidence of ineffective erythropoiesis with anemia and reticulocytopenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in CDAN1 or C15orf41 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemolysis-markers",
        "description": "Elevated serum lactate dehydrogenase and indirect hyperbilirubinemia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "iron-overload",
        "description": "Evidence of secondary iron overload in liver or spleen",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic bone marrow abnormalities plus either genetic confirmation or clinical evidence of ineffective erythropoiesis with anemia",
    "notes": "Genetic testing is strongly recommended to confirm diagnosis and differentiate from other congenital anemias."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Binucleated erythroblasts in bone marrow",
        "frequency": 0.95,
        "bodySystem": "hematological",
        "notes": "Distinctive morphological hallmark"
      },
      {
        "symptomName": "Ineffective erythropoiesis leading to anemia",
        "frequency": 0.9,
        "bodySystem": "hematological"
      }
    ],
    "common": [
      {
        "symptomName": "Pallor due to anemia",
        "frequency": 0.85,
        "bodySystem": "constitutional"
      },
      {
        "symptomName": "Fatigue and weakness",
        "frequency": 0.8,
        "bodySystem": "constitutional"
      },
      {
        "symptomName": "Jaundice from mild hemolysis",
        "frequency": 0.7,
        "bodySystem": "hematological"
      },
      {
        "symptomName": "Splenomegaly",
        "frequency": 0.65,
        "bodySystem": "hematological"
      },
      {
        "symptomName": "Mild hepatomegaly",
        "frequency": 0.6,
        "bodySystem": "hematological"
      }
    ],
    "occasional": [
      {
        "symptomName": "Iron overload complications",
        "frequency": 0.4,
        "bodySystem": "hematological",
        "notes": "Due to repeated transfusions or increased absorption"
      },
      {
        "symptomName": "Gallstones",
        "frequency": 0.3,
        "bodySystem": "gastrointestinal"
      },
      {
        "symptomName": "Growth retardation in children",
        "frequency": 0.25,
        "bodySystem": "constitutional"
      },
      {
        "symptomName": "Bone deformities",
        "frequency": 0.15,
        "bodySystem": "musculoskeletal",
        "notes": "Due to marrow expansion"
      }
    ],
    "rare": [
      {
        "symptomName": "Cardiac complications secondary to anemia",
        "frequency": 0.08,
        "bodySystem": "cardiovascular"
      },
      {
        "symptomName": "Endocrine dysfunction from iron overload",
