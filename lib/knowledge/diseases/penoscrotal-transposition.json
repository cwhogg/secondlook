  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnosis of Penoscrotal Transposition",
    "criteria": [
      {
        "id": "abnormal-penile-position",
        "description": "Ectopic placement of the penis relative to the scrotum, with the penis located inferior or posterior to the scrotum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "scrotal-malformation",
        "description": "Abnormal scrotal morphology including bifid or laterally displaced scrotal halves",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "associated-genitourinary-anomalies",
        "description": "Presence of associated anomalies such as hypospadias or cryptorchidism",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of abnormal penile position relative to the scrotum and scrotal malformation",
    "notes": "Diagnosis is primarily clinical and may be supported by imaging to assess associated anomalies."
  },
