  "diagnosticCriteria": {
    "formalCriteriaName": "Radiologic and Clinical Diagnostic Criteria for Horseshoe Kidney",
    "criteria": [
      {
        "id": "fusion-of-lower-poles",
        "description": "Presence of fusion of the lower poles of both kidneys forming a U-shaped structure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-renal-position",
        "description": "Abnormal position of kidneys lower than usual in the abdomen",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-evidence",
        "description": "Imaging confirmation via ultrasound, CT, or MRI showing isthmus connecting kidneys",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "associated-obstruction",
        "description": "Evidence of urinary tract obstruction or hydronephrosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-stones",
        "description": "Presence of nephrolithiasis on imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Imaging evidence of fusion of lower poles forming a U-shaped kidney with abnormal renal position",
    "notes": "Diagnosis is primarily radiologic; clinical symptoms may be absent or nonspecific."
  },
