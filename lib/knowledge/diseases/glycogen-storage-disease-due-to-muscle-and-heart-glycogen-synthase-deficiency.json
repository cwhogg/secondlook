  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Glycogen Storage Disease Type 0b",
    "criteria": [
      {
        "id": "enzyme-activity-deficiency",
        "description": "Demonstration of markedly reduced or absent glycogen synthase activity in muscle and/or cardiac tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic mutations in the GYS1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of exercise intolerance, muscle weakness, and cardiomyopathy consistent with glycogen storage disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing decreased glycogen content and abnormal glycogen structure",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-imaging",
        "description": "Echocardiographic evidence of cardiomyopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus either enzyme activity deficiency or pathogenic GYS1 mutation",
    "notes": "Muscle biopsy and cardiac imaging support diagnosis but are not mandatory if genetic and enzymatic evidence is conclusive."
  },
