      ]
    },
    {
      "diseaseId": "sheldon-hall-syndrome",
      "distinguishingFeatures": [
        "Less severe facial involvement",
        "Different pattern of joint contractures",
        "MYH3 mutations but distinct clinical phenotype"
      ]
    }
  ],
