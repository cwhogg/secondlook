  "diagnosticCriteria": {
    "formalCriteriaName": "2017 International Classification of the Ehlers-Danlos Syndromes",
    "criteria": [
      {
        "id": "veds-maj1",
        "description": "Family history of vEDS with documented causative COL3A1 variant",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "veds-maj2",
        "description": "Arterial rupture at young age",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "veds-maj3",
        "description": "Spontaneous sigmoid colon perforation without known diverticular disease or other bowel pathology",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "veds-maj4",
        "description": "Uterine rupture during third trimester without prior C-section or severe peri-partum perineal tears",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "veds-maj5",
        "description": "Carotid-cavernous sinus fistula without trauma",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "veds-min1",
        "description": "Bruising without identified trauma and/or in unusual sites",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "veds-min2",
        "description": "Thin, translucent skin with visible subcutaneous vasculature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "veds-min3",
        "description": "Characteristic facial appearance (thin lips, small chin, thin nose, prominent eyes)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "veds-min4",
        "description": "Spontaneous pneumothorax",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "veds-min5",
        "description": "Acrogeria (aged appearance of extremities, especially hands)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "veds-min6",
        "description": "Talipes equinovarus (clubfoot)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "veds-min7",
        "description": "Congenital hip dislocation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "veds-min8",
        "description": "Hypermobility of small joints",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "veds-min9",
        "description": "Tendon and muscle rupture",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "veds-min10",
        "description": "Keratoconus",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "veds-min11",
        "description": "Gingival recession and fragility",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "veds-min12",
        "description": "Early-onset varicose veins (before age 30 and nulliparous if female)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Any major criterion or several minor criteria should raise suspicion. Confirmatory testing requires identification of a causative COL3A1 (or rarely COL1A1) variant.",
    "notes": "This is the most life-threatening EDS subtype. Median life expectancy is approximately 50 years. Invasive vascular procedures carry high risk."
  },
