  "keyFindings": {
    "laboratory": [
      "Hypocalcemia (low serum calcium)",
      "Hyperphosphatemia (elevated serum phosphate)",
      "Low or inappropriately normal parathyroid hormone (PTH) levels",
      "Normal to low magnesium levels"
    ],
    "imaging": [
      "Basal ganglia calcifications on CT or MRI",
      "Cataracts on ophthalmologic exam",
      "Intracranial calcifications"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Positive Chvostek's and Trousseau's signs",
      "Electrocardiogram showing prolonged QT interval"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autoimmune-hypoparathyroidism",
      "distinguishingFeatures": [
        "Presence of autoimmune markers",
        "Later onset compared to congenital form",
        "Associated autoimmune endocrinopathies"
      ]
    },
    {
      "diseaseId": "di-geoerge-syndrome",
      "distinguishingFeatures": [
        "22q11.2 deletion syndrome",
        "Additional features such as cardiac defects, thymic hypoplasia",
        "Hypoparathyroidism as part of multisystem involvement"
      ]
    },
    {
      "diseaseId": "pseudohypoparathyroidism",
      "distinguishingFeatures": [
        "Elevated PTH levels despite hypocalcemia",
        "Resistance to PTH rather than deficiency",
        "Characteristic physical features (Albright hereditary osteodystrophy)"
      ]
    }
  ],
