  "keyFindings": {
    "laboratory": [
      "Generally nonspecific; may show leukocytosis if infected cysts present"
    ],
    "imaging": [
      "Prenatal ultrasound showing cystic lung lesions",
      "Chest X-ray revealing cystic or solid lung masses",
      "CT scan demonstrating multicystic or solid lesions with air-fluid levels"
    ],
    "genetic": [
      "No consistent genetic mutations identified; sporadic developmental anomaly"
    ],
    "other": [
      "Histopathology showing cystic adenomatoid malformation of lung tissue"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "bronchopulmonary-sequestration",
      "distinguishingFeatures": [
        "Presence of systemic arterial supply on imaging",
        "Lack of communication with tracheobronchial tree"
      ]
    },
    {
      "diseaseId": "congenital-lobar-emphysema",
      "distinguishingFeatures": [
        "Overinflation of a pulmonary lobe without cystic lesions",
        "Absence of discrete cystic masses on imaging"
      ]
    },
    {
      "diseaseId": "bronchogenic-cyst",
      "distinguishingFeatures": [
        "Usually solitary cystic lesion",
        "Located centrally near mediastinum rather than lung parenchyma"
      ]
    }
  ],
  "redFlags": [
    "Severe respiratory distress in neonate",
    "Rapidly enlarging cystic lung mass",
    "Signs of infection or sepsis related to cystic lesions"
  ],
