  "diagnosticCriteria": {
    "formalCriteriaName": "LIDD Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "lipodystrophy",
        "description": "Generalized or partial loss of subcutaneous adipose tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-deafness",
        "description": "Bilateral sensorineural hearing loss confirmed by audiometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent forehead and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "metabolic-abnormalities",
        "description": "Presence of insulin resistance or dyslipidemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: lipodystrophy, intellectual disability, and sensorineural deafness",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
