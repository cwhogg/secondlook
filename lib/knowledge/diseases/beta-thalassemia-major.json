  "diagnosticCriteria": {
    "formalCriteriaName": "Beta-thalassemia major diagnostic criteria",
    "criteria": [
      {
        "id": "severe-anemia",
        "description": "Severe microcytic hypochromic anemia presenting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemoglobin-electrophoresis",
        "description": "Hemoglobin electrophoresis showing absent or markedly reduced HbA with elevated HbF and HbA2",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic mutations in the HBB gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-hyperplasia",
        "description": "Evidence of bone marrow expansion on imaging or biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "transfusion-dependence",
        "description": "Requirement for regular blood transfusions starting in early childhood",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe anemia with characteristic hemoglobin electrophoresis findings and confirmation by genetic testing",
    "notes": "Diagnosis is confirmed by molecular genetic testing; clinical features and laboratory findings support diagnosis."
  },
