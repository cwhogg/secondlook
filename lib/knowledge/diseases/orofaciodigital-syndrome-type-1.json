  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for OFD1",
    "criteria": [
      {
        "id": "oral-clefts",
        "description": "Presence of cleft tongue or lobulated tongue with hamartomas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism, broad nasal bridge, and cleft lip/palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digital-anomalies",
        "description": "Digital malformations such as brachydactyly, clinodactyly, or syndactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-cysts",
        "description": "Presence of polycystic kidney disease or renal cysts",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-features",
        "description": "Central nervous system anomalies including intellectual disability or brain malformations",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (oral clefts/hamartomas, facial dysmorphism, and digital anomalies) with or without supportive minor criteria",
    "notes": "Genetic testing for OFD1 gene mutations can confirm diagnosis; X-linked dominant inheritance with male lethality"
  },
