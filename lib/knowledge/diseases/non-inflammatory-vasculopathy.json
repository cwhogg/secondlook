    "formalCriteriaName": "Non-inflammatory Vasculopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "vascular-occlusion",
        "description": "Evidence of vascular occlusion or stenosis without inflammatory cell infiltrate on histopathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-inflammation",
        "description": "Lack of inflammatory markers in blood tests and tissue biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of ischemic symptoms consistent with vascular compromise such as tissue necrosis or ulceration",
        "category": "minor",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Imaging evidence of vessel wall thickening or luminal narrowing without enhancement typical of vasculitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of vascular occlusion without inflammation on biopsy plus clinical ischemic features",
    "notes": "Diagnosis requires exclusion of inflammatory vasculitis and other mimics."
  },
