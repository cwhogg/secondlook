  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Malan Overgrowth Syndrome",
    "criteria": [
      {
        "id": "overgrowth",
        "description": "Postnatal overgrowth with height and head circumference >2 SD above mean",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial gestalt including prominent forehead, depressed nasal bridge, and pointed chin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurodevelopmental-delay",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic variant in NFIX gene confirmed by molecular testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-anomalies",
        "description": "Presence of scoliosis or other skeletal abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of postnatal overgrowth, characteristic facial features, neurodevelopmental delay, and pathogenic NFIX variant",
    "notes": "Diagnosis relies heavily on genetic confirmation due to phenotypic overlap with other overgrowth syndromes."
  },
