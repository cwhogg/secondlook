  "differentialDiagnoses": [
    {
      "diseaseId": "marfan-syndrome",
      "distinguishingFeatures": [
        "Tall stature vs short stature in WMS",
        "Ectopia lentis with elongated lens vs microspherophakia",
        "Aortic root dilation more common and severe"
      ]
    },
    {
      "diseaseId": "homocystinuria",
      "distinguishingFeatures": [
        "Lens dislocation downward vs typically upward in WMS",
        "Marfanoid habitus with intellectual disability",
        "Elevated homocysteine levels"
      ]
    }
