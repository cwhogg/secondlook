  "diagnosticCriteria": {
    "formalCriteriaName": "PDHA1 Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced pyruvate dehydrogenase complex enzyme activity in fibroblasts or muscle tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the PDHA1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lactic-acidosis",
        "description": "Persistent lactic acidosis with elevated blood lactate and pyruvate levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Neurological manifestations including developmental delay and hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced PDH enzyme activity or pathogenic PDHA1 mutation plus clinical and biochemical evidence of lactic acidosis",
    "notes": "Molecular genetic testing is confirmatory; enzyme assay may be required if genetic testing is inconclusive."
  },
