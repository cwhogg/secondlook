  "keyFindings": {
    "laboratory": [
      "Marked thrombocytopenia (platelet count often <50,000/µL) in infancy",
      "Normal to mildly decreased white blood cell counts",
      "Transient hypocalcemia in neonatal period"
    ],
    "imaging": [
      "Radiographs showing bilateral absence of radius bones with presence of thumbs",
      "Echocardiogram for associated cardiac defects",
      "Renal ultrasound for structural anomalies"
    ],
    "genetic": [
      "Compound heterozygous mutations or deletions involving RBM8A gene on chromosome 1q21.1"
    ],
    "other": [
      "Clinical observation of petechiae and bruising",
      "Feeding assessment for intolerance or difficulties"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "fanconi-anemia",
      "distinguishingFeatures": [
        "Absent thumbs (unlike TAR where thumbs are present)",
        "Progressive bone marrow failure",
        "Increased risk of malignancy"
      ]
    },
    {
      "diseaseId": "holt-oram-syndrome",
      "distinguishingFeatures": [
        "Cardiac septal defects with upper limb malformations",
        "Presence of radius but hypoplastic or absent thumbs",
        "No thrombocytopenia"
      ]
    }
  ],
  "redFlags": [
    "Severe thrombocytopenia with bleeding risk in neonate",
    "Bilateral absent radius with preserved thumbs",
    "Recurrent bleeding episodes or petechiae in infancy"
  ],
