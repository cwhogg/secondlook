  "diagnosticCriteria": {
    "formalCriteriaName": "Marshall Criteria",
    "criteria": [
      {
        "id": "periodic-fever",
        "description": "Recurrent episodes of fever lasting 3-6 days occurring at regular intervals",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aphthous-stomatitis",
        "description": "Presence of aphthous ulcers in the oral mucosa during febrile episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pharyngitis",
        "description": "Pharyngitis or tonsillitis during febrile episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cervical-adenitis",
        "description": "Tender cervical lymphadenitis during febrile episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-growth",
        "description": "Normal growth and development between episodes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of cyclic neutropenia and other infectious or autoimmune diseases",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent periodic fever episodes with at least two of the following: aphthous stomatitis, pharyngitis, and cervical adenitis, with exclusion of other causes",
    "notes": "Diagnosis is clinical and requires exclusion of other periodic fever syndromes and infections."
  },
