  "keyFindings": {
    "laboratory": [
      "Markedly elevated serum total bilirubin (unconjugated hyperbilirubinemia)",
      "Blood type incompatibility (e.g., ABO or Rh incompatibility)",
      "Positive Coombs test in hemolytic disease"
    ],
    "imaging": [
      "MRI showing increased T2 signal intensity in globus pallidus and subthalamic nuclei",
      "CT scan may be normal or show basal ganglia hypodensity"
    ],
    "genetic": [
      "Mutations in genes affecting bilirubin metabolism (e.g., UGT1A1 in Crigler-Najjar syndrome) may predispose"
    ],
    "other": [
      "Clinical observation of progressive neurological deterioration",
      "Response to phototherapy or exchange transfusion"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hypoxic-ischemic-encephalopathy",
      "distinguishingFeatures": [
        "History of perinatal asphyxia",
        "Diffuse brain injury on imaging rather than basal ganglia predominant",
        "Lack of severe hyperbilirubinemia"
      ]
    },
    {
      "diseaseId": "neonatal-sepsis",
      "distinguishingFeatures": [
        "Positive blood cultures",
        "Fever or hypothermia",
        "Systemic signs of infection"
      ]
    },
    {
      "diseaseId": "metabolic-encephalopathies",
      "distinguishingFeatures": [
        "Abnormal metabolic screening tests",
        "No significant hyperbilirubinemia",
        "Variable neurological presentation"
      ]
    }
  ],
  "redFlags": [
