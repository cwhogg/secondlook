        "requiredForDiagnosis": true
      },
      {
        "id": "fetal-hydrops",
        "description": "Presence of non-immune fetal hydrops detected prenatally",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-deterioration",
        "description": "Severe neurological impairment including fetal akinesia and brainstem dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Biallelic pathogenic GBA mutations or glucocerebrosidase enzyme deficiency plus clinical features consistent with fetal/neonatal presentation",
    "notes": "Prenatal diagnosis may be supported by ultrasound findings and family history."
