  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Shiga toxin-associated hemolytic uremic syndrome",
    "criteria": [
      {
        "id": "microangiopathic-hemolytic-anemia",
        "description": "Presence of microangiopathic hemolytic anemia evidenced by schistocytes on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thrombocytopenia",
        "description": "Thrombocytopenia with platelet count below normal reference range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acute-renal-impairment",
        "description": "Acute kidney injury demonstrated by elevated serum creatinine or reduced urine output",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "evidence-of-shiga-toxin",
        "description": "Detection of Shiga toxin or Shiga toxin-producing Escherichia coli in stool or blood",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "preceding-gastroenteritis",
        "description": "History of recent diarrheal illness, often bloody",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microangiopathic hemolytic anemia, thrombocytopenia, and acute renal impairment",
    "notes": "Detection of Shiga toxin or STEC infection supports diagnosis but is not mandatory if clinical criteria are met."
  },
