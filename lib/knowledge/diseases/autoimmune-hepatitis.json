  "diagnosticCriteria": {
    "formalCriteriaName": "Simplified International Autoimmune Hepatitis Group (IAIHG) Criteria 2008",
    "criteria": [
      {
        "id": "aih-1",
        "description": "ANA or SMA >= 1:40 (1 point), >= 1:80 or anti-LKM1 >= 1:40 (2 points)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aih-2",
        "description": "Elevated IgG above upper limit of normal (1 point), >= 1.1x ULN (2 points)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aih-3",
        "description": "Liver histology compatible with AIH: interface hepatitis (1 point), typical of AIH (2 points)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aih-4",
        "description": "Absence of viral hepatitis (2 points)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aih-5",
        "description": "Anti-SLA/LP positive (highly specific for AIH)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Score >= 6 (probable AIH) or >= 7 (definite AIH) on simplified criteria",
    "notes": "Type 1 AIH: ANA and/or SMA positive; most common form. Type 2 AIH: anti-LKM1 and/or anti-LC1 positive; more common in children. Anti-SLA/LP is the most specific antibody for AIH."
  },
