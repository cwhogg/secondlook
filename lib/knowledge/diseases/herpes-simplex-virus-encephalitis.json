  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for HSV Encephalitis",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Acute onset of fever, altered mental status, or focal neurological deficits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "csf-analysis",
        "description": "Cerebrospinal fluid pleocytosis with lymphocytic predominance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hsv-dna-pcr",
        "description": "Positive HSV DNA detected by PCR in cerebrospinal fluid",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-mri",
        "description": "MRI showing temporal lobe abnormalities consistent with encephalitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acute neurological symptoms plus positive HSV DNA PCR in CSF or characteristic MRI findings",
    "notes": "Early diagnosis is critical for initiating antiviral therapy"
  },
