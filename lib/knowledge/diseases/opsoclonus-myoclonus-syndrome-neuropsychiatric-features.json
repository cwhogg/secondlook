  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Opsoclonus-Myoclonus Syndrome",
    "criteria": [
      {
        "id": "opsoclonus",
        "description": "Presence of chaotic, multidirectional, conjugate saccadic eye movements (opsoclonus)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "myoclonus",
        "description": "Multifocal, arrhythmic myoclonic jerks involving limbs and trunk",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuropsychiatric",
        "description": "Neuropsychiatric symptoms including irritability, cognitive dysfunction, and behavioral changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ataxia",
        "description": "Cerebellar ataxia manifesting as gait instability and dysmetria",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "autoimmuneMarkers",
        "description": "Evidence of autoimmune etiology such as presence of anti-neuronal antibodies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of opsoclonus, myoclonus, and neuropsychiatric symptoms",
    "notes": "Diagnosis is clinical; supportive laboratory and imaging findings aid confirmation"
  },
