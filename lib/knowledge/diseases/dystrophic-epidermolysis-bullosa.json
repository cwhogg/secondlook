  "keyFindings": {
    "laboratory": [
      "Anemia of chronic disease or iron deficiency",
      "Elevated inflammatory markers in chronic wounds"
    ],
    "imaging": [
      "Barium swallow showing esophageal strictures",
      "X-rays demonstrating pseudosyndactyly and contractures"
    ],
    "genetic": [
      "Mutations in COL7A1 gene encoding type VII collagen"
    ],
    "other": [
      "Immunofluorescence mapping showing reduced or absent type VII collagen",
      "Electron microscopy demonstrating sublamina densa cleavage"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "junctional-epidermolysis-bullosa",
      "distinguishingFeatures": [
        "Blistering occurs within the lamina lucida of the basement membrane",
        "Usually more severe mucosal involvement",
        "Mutations in genes encoding laminin-332 or integrins"
      ]
    },
    {
      "diseaseId": "simplex-epidermolysis-bullosa",
      "distinguishingFeatures": [
        "Blistering occurs within the basal keratinocytes of the epidermis",
        "Generally milder disease with less scarring",
        "Mutations in keratin 5 or keratin 14 genes"
      ]
    }
  ],
  "redFlags": [
    "Rapidly enlarging non-healing ulcer in chronic wound (possible squamous cell carcinoma)",
    "Severe esophageal strictures causing feeding difficulties",
    "Signs of systemic infection or sepsis from infected skin lesions"
  ],
