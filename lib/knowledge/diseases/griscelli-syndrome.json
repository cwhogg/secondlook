  "keyFindings": {
    "laboratory": [
      "Cytopenias and elevated ferritin consistent with HLH",
      "Elevated triglycerides and low fibrinogen during HLH episodes",
      "Abnormal NK cell function tests"
    ],
    "imaging": [
      "Brain MRI may show demyelination or cerebral atrophy",
      "Chest imaging may reveal interstitial lung disease"
    ],
    "genetic": [
      "Pathogenic variants in RAB27A (GS type 2), MYO5A (GS type 1), or MLPH (GS type 3)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Hair shaft microscopy showing large melanosome aggregates",
      "Bone marrow biopsy showing hemophagocytosis during HLH"
    ]
  },
