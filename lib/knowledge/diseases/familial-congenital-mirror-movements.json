  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Congenital Mirror Movements Diagnostic Criteria",
    "criteria": [
      {
        "id": "bilateral-mirror-movements",
        "description": "Presence of involuntary mirror movements in homologous muscles during voluntary unilateral movement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "familial-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-neurological-deficits",
        "description": "No evidence of other neurological abnormalities or progressive neurological disease",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-neuroimaging",
        "description": "Normal brain and spinal cord MRI excluding structural lesions",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral mirror movements with a positive family history and absence of other neurological deficits",
    "notes": "Diagnosis is clinical; genetic testing may support but is not mandatory."
  },
