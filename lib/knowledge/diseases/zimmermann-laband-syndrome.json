  "diagnosticCriteria": {
    "formalCriteriaName": "Zimmermann-Laband Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "gingival-hyperplasia",
        "description": "Congenital gingival fibromatosis causing gingival hyperplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nail-hypoplasia",
        "description": "Hypoplasia or aplasia of the distal phalangeal nails",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including bulbous nose, thick alae nasi, and thickened lips",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepatosplenomegaly",
        "description": "Presence of hepatosplenomegaly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypertrichosis",
        "description": "Excessive hair growth (hypertrichosis)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital gingival fibromatosis, nail hypoplasia, and characteristic facial dysmorphism",
    "notes": "Diagnosis is clinical; genetic testing for mutations in KCNH1 or ATP6V1B2 genes may support diagnosis."
  },
