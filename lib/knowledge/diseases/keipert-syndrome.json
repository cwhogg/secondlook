  "diagnosticCriteria": {
    "formalCriteriaName": "Keipert Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including hypertelorism and midface hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Radiological evidence of multiple skeletal anomalies such as short stature and limb deformities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability documented clinically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the Keipert syndrome-associated gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiovascular-anomalies",
        "description": "Presence of congenital heart defects such as septal defects",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (craniofacial dysmorphism, skeletal abnormalities, developmental delay) with or without genetic confirmation",
    "notes": "Genetic testing is supportive but not mandatory for diagnosis."
  },
