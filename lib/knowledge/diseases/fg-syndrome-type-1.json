  "diagnosticCriteria": {
    "formalCriteriaName": "FG Syndrome Type 1 Diagnostic Criteria",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Moderate to severe intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia with poor muscle tone",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facial-features",
        "description": "Distinctive facial dysmorphism including macrocephaly, broad forehead, downslanting palpebral fissures, and small chin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "constipation",
        "description": "Chronic constipation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "corpus-callosum-abnormalities",
        "description": "Corpus callosum hypoplasia or agenesis on neuroimaging",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-anomalies",
        "description": "Congenital heart defects such as atrial or ventricular septal defects",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (intellectual disability, neonatal hypotonia, and characteristic facial features) plus confirmation of MED12 gene mutation",
    "notes": "Molecular genetic testing for MED12 mutations confirms diagnosis."
  },
