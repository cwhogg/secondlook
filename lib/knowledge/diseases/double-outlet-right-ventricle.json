    "formalCriteriaName": "Echocardiographic and Cardiac MRI Diagnostic Criteria for DORV",
    "criteria": [
      {
        "id": "anatomical-criteria",
        "description": "Both great arteries arise predominantly from the right ventricle",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ventricular-septal-defect",
        "description": "Presence of a ventricular septal defect (VSD) allowing left ventricular outflow",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-confirmation",
        "description": "Confirmation of great artery origin and VSD location by echocardiography or cardiac MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Cyanosis and heart murmur consistent with congenital heart defect",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both great arteries arising from the right ventricle confirmed by imaging plus a ventricular septal defect",
    "notes": "Diagnosis typically requires multimodal imaging including echocardiography and cardiac MRI or catheterization."
  },
