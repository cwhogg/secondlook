  "keyFindings": {
    "laboratory": [
      "Normal or mildly altered thyroid hormone levels (TSH, free T4)",
      "Negative thyroid autoantibodies",
      "Normal serum calcium and calcitonin levels"
    ],
    "imaging": [
      "Ultrasound showing multiple thyroid nodules of varying size",
      "Thyroid scintigraphy demonstrating heterogeneous uptake",
      "Neck MRI or CT if compressive symptoms present"
    ],
    "genetic": [
      "KEAP1 (causative)",
      "DICER1 (susceptibility)",
      "Familial clustering with autosomal dominant inheritance pattern"
    ],
    "other": [
      "Fine needle aspiration biopsy to exclude malignancy in suspicious nodules"
    ]
  },
  "differentialDiagnoses": [
