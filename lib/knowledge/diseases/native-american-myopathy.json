  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Native American Myopathy",
    "criteria": [
      {
        "id": "congenital-muscle-weakness",
        "description": "Congenital onset of generalized muscle weakness and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including ptosis, elongated face, and high-arched palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the STAC3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distal-arthrogryposis",
        "description": "Presence of distal joint contractures and clubfoot",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "malignant-hyperthermia-susceptibility",
        "description": "History or susceptibility to malignant hyperthermia during anesthesia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital muscle weakness with characteristic facial features plus genetic confirmation of STAC3 mutation",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical features may overlap with other congenital myopathies."
  },
