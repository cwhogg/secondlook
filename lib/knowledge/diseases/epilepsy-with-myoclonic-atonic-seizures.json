        "requiredForDiagnosis": true
      },
      {
        "id": "electroencephalogram-findings",
        "description": "EEG showing generalized spike-and-wave or polyspike-and-wave discharges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-development-prior",
        "description": "Normal psychomotor development prior to seizure onset",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
