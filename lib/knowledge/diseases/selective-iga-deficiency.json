  "keyFindings": {
    "laboratory": [
      "Undetectable serum IgA (<7 mg/dL)",
      "Normal serum IgG and IgM levels",
      "Normal specific antibody responses to vaccines (usually)",
      "Anti-IgA antibodies may be present (class-specific or subclass-specific)",
      "Screen for celiac disease (anti-tissue transglutaminase IgG, since IgA-based tests will be false negative)"
    ],
    "imaging": [
      "Usually no imaging abnormalities",
      "CT sinuses if chronic sinusitis",
      "CT chest if recurrent lower respiratory infections"
    ],
    "genetic": [
      "TRAPPC11 (causative)",
      "AAAS (causative)",
      "GMPPA (causative, loss-of-function)",
      "Usually sporadic; occasionally autosomal dominant or recessive inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "IgA typing should be repeated to confirm persistence",
      "Anti-IgA antibody testing before blood transfusions",
      "Celiac disease screening recommended"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "common-variable-immunodeficiency",
      "distinguishingFeatures": [
        "CVID has low IgG plus low IgA and/or IgM",
        "Poor vaccine responses in CVID",
        "More symptomatic with recurrent serious infections"
      ]
    },
    {
      "diseaseId": "transient-hypogammaglobulinemia-of-infancy",
      "distinguishingFeatures": [
        "Resolves by age 2-4 years",
        "All immunoglobulins may be low",
        "Normal B cell numbers and function"
      ]
    },
    {
      "diseaseId": "drug-induced-iga-deficiency",
      "distinguishingFeatures": [
        "Temporal association with medications (phenytoin, sulfasalazine, gold)",
        "May reverse after drug discontinuation"
      ]
    }
  ],
  "redFlags": [
    "Anaphylactic reaction to blood transfusion (anti-IgA antibody mediated)",
    "Development of progressive hypogammaglobulinemia suggesting evolution to CVID",
    "Recurrent severe sinopulmonary infections with bronchiectasis",
    "Coexistent celiac disease (should be screened for)",
    "Multiple autoimmune diseases developing"
  ],
  "specialistType": [
