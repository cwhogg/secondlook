  "diagnosticCriteria": {
    "formalCriteriaName": "DNAJB2-related CMT2 Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of a length-dependent sensorimotor axonal neuropathy with distal muscle weakness and atrophy",
