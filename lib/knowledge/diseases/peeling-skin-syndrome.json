  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Diagnostic Criteria for Peeling Skin Syndrome",
    "criteria": [
      {
        "id": "chronic-peeling",
        "description": "Chronic, painless, superficial peeling of the skin beginning in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological evidence of separation within the stratum corneum or stratum granulosum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes such as TGM5, CDSN, or CSTA",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-inflammation",
        "description": "Lack of significant inflammation or systemic symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic painless skin peeling with histopathological confirmation and either genetic confirmation or consistent family history",
    "notes": "Diagnosis is primarily clinical supported by histopathology and genetic testing; exclusion of other peeling disorders is essential."
  },
