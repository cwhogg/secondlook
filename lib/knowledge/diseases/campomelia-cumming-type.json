  "diagnosticCriteria": {
    "formalCriteriaName": "Campomelia, Cumming type Diagnostic Criteria",
    "criteria": [
      {
        "id": "bowed-long-bones",
        "description": "Presence of bowed long bones, especially tibia and femur",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sex-reversal",
        "description": "46,XY sex reversal or ambiguous genitalia in genetic males",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-distress",
        "description": "Neonatal respiratory distress due to tracheomalacia or thoracic hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of SOX9 gene mutation or deletion",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of bowed long bones and characteristic facial dysmorphism plus either genetic confirmation or sex reversal/ambiguous genitalia",
    "notes": "Diagnosis is primarily clinical with genetic confirmation recommended."
  },
