  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Gerstmann Syndrome",
    "criteria": [
      {
        "id": "finger-agnosia",
        "description": "Inability to recognize or differentiate fingers on the hand",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "agraphia",
        "description": "Impairment in writing ability despite intact motor function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acalculia",
        "description": "Difficulty performing simple arithmetic calculations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "left-right-disorientation",
        "description": "Inability to distinguish left from right on oneself or others",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging-lesion",
        "description": "Lesion localized to the dominant parietal lobe, especially angular gyrus",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all four major symptoms (finger agnosia, agraphia, acalculia, left-right disorientation)",
    "notes": "Diagnosis is clinical and supported by neuroimaging findings; exclusion of other causes is necessary."
  },
