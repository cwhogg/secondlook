  "diagnosticCriteria": {
    "formalCriteriaName": "Mohr Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "oral-anomalies",
        "description": "Presence of oral anomalies including cleft lip and/or cleft palate, lobulated tongue, and oral frenula abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features such as hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digital-malformations",
        "description": "Presence of digital anomalies including polydactyly, syndactyly, brachydactyly, or clinodactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-findings",
        "description": "Radiographic evidence of short metacarpals and metatarsals",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (oral anomalies, facial dysmorphism, and digital malformations)",
    "notes": "Genetic testing can support diagnosis but is not always available."
  },
