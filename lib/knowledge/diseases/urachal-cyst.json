  "differentialDiagnoses": [
    {
      "diseaseId": "omphalomesenteric-duct-cyst",
      "distinguishingFeatures": [
        "Located along midline but closer to umbilicus",
        "May have intestinal mucosa on histology",
        "Often associated with umbilical discharge"
      ]
    },
    {
      "diseaseId": "umbilical-hernia",
      "distinguishingFeatures": [
        "Reducible mass at umbilicus",
        "No cystic structure on imaging",
        "No epithelial lining on histology"
      ]
    },
    {
      "diseaseId": "bladder-diverticulum",
      "distinguishingFeatures": [
