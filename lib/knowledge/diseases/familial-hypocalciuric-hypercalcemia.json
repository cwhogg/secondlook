  "keyFindings": {
    "laboratory": [
      "Mildly elevated serum calcium",
      "Low 24-hour urinary calcium excretion",
      "Normal or mildly elevated PTH levels",
      "Normal serum phosphate"
    ],
    "imaging": [
      "Usually normal skeletal imaging",
      "Occasional nephrolithiasis on renal ultrasound or CT"
    ],
    "genetic": [
      "Inactivating mutations in the calcium-sensing receptor gene (CaSR)"
    ],
    "other": [
      "Family history consistent with autosomal dominant inheritance"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "primary-hyperparathyroidism",
      "distinguishingFeatures": [
        "Elevated serum calcium with elevated or inappropriately normal PTH",
        "Increased urinary calcium excretion",
        "Possible parathyroid adenoma on imaging"
      ]
    },
    {
      "diseaseId": "malignancy-associated-hypercalcemia",
      "distinguishingFeatures": [
        "Rapidly progressive hypercalcemia",
        "Suppressed PTH levels",
        "Presence of malignancy or metastases"
      ]
    },
    {
      "diseaseId": "vitamin-d-toxicity",
      "distinguishingFeatures": [
        "Elevated serum calcium with suppressed PTH",
        "Elevated 25-hydroxyvitamin D levels",
        "History of vitamin D supplementation"
      ]
    }
  ],
  "redFlags": [
    "Severe hypercalcemia (>3.0 mmol/L)",
    "Symptoms of hypercalcemic crisis (confusion, dehydration, arrhythmia)",
    "Rapidly rising serum calcium levels"
  ],
