  "diagnosticCriteria": {
    "formalCriteriaName": "Najm Type XLID Diagnostic Criteria",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of moderate to severe intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay evident in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including broad nasal bridge and prominent forehead",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "Recurrent seizures or epilepsy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "X-linked inheritance pattern with affected males and carrier females",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of intellectual disability and developmental delay with either characteristic facial dysmorphism or seizures, plus supportive family history consistent with X-linked inheritance",
    "notes": "Genetic testing confirming mutation in the implicated gene is confirmatory."
  },
