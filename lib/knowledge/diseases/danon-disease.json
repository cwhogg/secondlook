        "description": "Presence of intellectual disability or cognitive impairment",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-conduction-defects",
        "description": "Electrocardiographic evidence of conduction abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Hypertrophic cardiomyopathy plus pathogenic LAMP2 mutation",
    "notes": "Muscle biopsy showing autophagic vacuoles with sarcolemmal features supports diagnosis"
