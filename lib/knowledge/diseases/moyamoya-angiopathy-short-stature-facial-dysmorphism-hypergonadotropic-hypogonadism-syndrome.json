  "keyFindings": {
    "laboratory": [
      "Elevated serum follicle-stimulating hormone (FSH) and luteinizing hormone (LH) levels",
      "Low serum estradiol or testosterone consistent with gonadal failure",
      "Normal to mildly elevated thyroid stimulating hormone (TSH) in some cases"
    ],
    "imaging": [
      "Cerebral angiography or MRI/MRA showing bilateral stenosis or occlusion of distal internal carotid arteries with basal collateral vessels (moyamoya vessels)",
      "Skeletal X-rays showing short stature and occasional bone anomalies"
    ],
    "genetic": [
      "BRCC3 (phenotype modifier)",
      "No definitive causative gene identified; possible autosomal recessive inheritance pattern suggested",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Clinical assessment revealing characteristic facial dysmorphism",
      "Endocrinological evaluation confirming hypergonadotropic hypogonadism"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "turner-syndrome",
      "distinguishingFeatures": [
        "Presence of monosomy X or mosaicism on karyotype",
        "Characteristic webbed neck and lymphedema",
        "Absence of moyamoya angiopathy"
      ]
    },
    {
      "diseaseId": "cockayne-syndrome",
      "distinguishingFeatures": [
        "Progressive neurodegeneration with photosensitivity",
        "Characteristic cachectic dwarfism",
        "No moyamoya angiopathy or hypergonadotropic hypogonadism"
      ]
    },
    {
      "diseaseId": "moyamoya-disease-isolated",
      "distinguishingFeatures": [
        "Moyamoya angiopathy without associated short stature or endocrine abnormalities",
        "Lack of facial dysmorphism",
        "Normal gonadal function"
      ]
    }
  ],
  "redFlags": [
    "Sudden onset of focal neurological deficits or stroke-like episodes in childhood",
