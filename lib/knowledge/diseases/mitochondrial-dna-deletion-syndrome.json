        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mtDNA-deletion",
        "description": "Detection of large-scale mitochondrial DNA deletions in muscle biopsy or blood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ragged-red-fibers",
        "description": "Presence of ragged-red fibers on muscle biopsy",
