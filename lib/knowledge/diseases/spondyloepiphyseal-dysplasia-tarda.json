        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-short-trunk-dwarfism",
        "description": "Progressive short-trunk dwarfism manifesting in late childhood or adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history-x-linked",
        "description": "Positive family history consistent with X-linked inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development without neurological deficits",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive short-trunk dwarfism with characteristic radiographic epiphyseal abnormalities, with or without positive family history",
    "notes": "Genetic testing for TRAPPC2 mutations can confirm diagnosis but is not mandatory."
