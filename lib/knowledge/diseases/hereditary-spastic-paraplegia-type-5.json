    "laboratory": [
      "Elevated 27-hydroxycholesterol levels in plasma",
      "Normal routine blood tests"
    ],
    "imaging": [
      "MRI brain and spinal cord typically normal or showing mild corticospinal tract atrophy"
    ],
    "genetic": [
      "Pathogenic variants in CYP7B1 gene"
    ],
