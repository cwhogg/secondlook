  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate elevation)",
      "Normal metabolic panel"
    ],
    "imaging": [
      "Brain MRI showing diffuse white matter hyperintensities on T2-weighted images",
      "Muscle MRI may show muscle atrophy and fatty infiltration"
    ],
    "genetic": [
      "LAMA2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy with absent or severely reduced laminin alpha-2 immunostaining"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dystroglycanopathy-congenital-muscular-dystrophy",
      "distinguishingFeatures": [
        "Deficiency of alpha-dystroglycan glycosylation",
        "More frequent brain malformations including cobblestone lissencephaly",
        "Different genetic mutations (e.g., POMT1, FKRP)"
      ]
    },
    {
      "diseaseId": "collagen-vi-related-congenital-muscular-dystrophy",
      "distinguishingFeatures": [
        "Presence of skin abnormalities such as keloids or hyperkeratosis",
        "Mutations in COL6A1, COL6A2, or COL6A3 genes",
        "Muscle biopsy shows collagen VI deficiency"
      ]
    }
  ],
  "redFlags": [
    "Severe hypotonia and muscle weakness presenting at birth",
    "Rapid progression of respiratory insufficiency",
    "Absence of laminin alpha-2 on muscle biopsy"
  ],
