  "keyFindings": {
    "laboratory": [
      "Reduced or absent procollagen I N-proteinase enzyme activity in fibroblast cultures",
      "Abnormal collagen fibril morphology on electron microscopy"
    ],
    "imaging": [
      "Radiographs showing joint subluxations or dislocations",
      "Echocardiography for mitral valve prolapse assessment"
    ],
    "genetic": [
      "ADAMTS2 (causative)",
      "ADAMTSL2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy demonstrating characteristic collagen abnormalities"
    ]
  },
  "differentialDiagnoses": [
