  "diagnosticCriteria": {
    "formalCriteriaName": "Wiedemann-Rautenstrauch Diagnostic Criteria",
    "criteria": [
      {
        "id": "progeroid-facies",
        "description": "Characteristic aged facial appearance with prominent scalp veins and sparse hair",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intrauterine-growth-retardation",
        "description": "Severe intrauterine growth retardation leading to low birth weight",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lipodystrophy",
        "description": "Generalized loss of subcutaneous fat resulting in thin, wrinkled skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-anomalies",
        "description": "Delayed dentition and dental hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Osteopenia and abnormal bone maturation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: progeroid facies, intrauterine growth retardation, and lipodystrophy",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
