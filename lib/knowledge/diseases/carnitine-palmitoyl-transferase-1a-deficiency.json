  "diagnosticCriteria": {
    "formalCriteriaName": "Biochemical and Genetic Diagnostic Criteria for CPT1A Deficiency",
    "criteria": [
      {
        "id": "hypoketotic-hypoglycemia",
        "description": "Episodes of hypoketotic hypoglycemia during fasting or illness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-plasma-free-carnitine",
        "description": "Elevated plasma free carnitine with low acylcarnitine profile on tandem mass spectrometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cpt1a-gene-mutation",
        "description": "Identification of pathogenic variants in the CPT1A gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-biopsy-enzyme-assay",
        "description": "Reduced CPT1 enzyme activity in liver biopsy samples",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-history",
        "description": "History of fasting intolerance and metabolic crises triggered by illness or prolonged fasting",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypoketotic hypoglycemia episodes plus either molecular genetic confirmation of CPT1A mutations or characteristic biochemical profile",
    "notes": "Diagnosis is confirmed by molecular genetic testing; enzyme assay and clinical history support diagnosis."
  },
