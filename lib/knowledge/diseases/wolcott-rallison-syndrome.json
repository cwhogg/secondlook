  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnosis of Wolcott-Rallison syndrome",
    "criteria": [
      {
        "id": "early-onset-diabetes",
        "description": "Neonatal or early infancy onset of insulin-dependent diabetes mellitus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multiple-epiphyseal-dysplasia",
        "description": "Radiological evidence of multiple epiphyseal dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eif2ak3-mutation",
        "description": "Biallelic pathogenic variants in the EIF2AK3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepatic-dysfunction",
        "description": "Recurrent episodes of acute liver failure or chronic hepatic dysfunction",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Severe growth retardation and failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset insulin-dependent diabetes mellitus plus multiple epiphyseal dysplasia and confirmation of biallelic EIF2AK3 mutations",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical features may vary."
  },
