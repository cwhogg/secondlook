      "Elevated phosphoserine levels",
      "Normal or mildly elevated lactate"
    ],
    "imaging": [
      "Brain MRI showing cerebral atrophy",
      "Delayed myelination",
      "Occasional ventriculomegaly"
    ],
    "genetic": [
      "PSAT1 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Improvement of symptoms with L-serine supplementation",
      "Electroencephalogram abnormalities consistent with seizures"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "3-phosphoglycerate-dehydrogenase-deficiency",
      "distinguishingFeatures": [
        "Defect in PHGDH gene rather than PSAT1",
