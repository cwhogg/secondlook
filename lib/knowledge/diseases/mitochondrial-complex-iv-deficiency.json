  "keyFindings": {
    "laboratory": [
      "Elevated blood and CSF lactate and pyruvate levels",
      "Reduced Complex IV enzymatic activity in muscle biopsy or fibroblasts",
      "Elevated serum creatine kinase (mildly elevated)"
    ],
    "imaging": [
      "Brain MRI showing basal ganglia, brainstem, or cerebral white matter abnormalities",
      "Magnetic resonance spectroscopy (MRS) demonstrating lactate peak"
    ],
    "genetic": [
      "Pathogenic variants in mitochondrial DNA-encoded COX genes (e.g., MT-CO1, MT-CO2, MT-CO3)",
      "Pathogenic variants in nuclear genes encoding Complex IV assembly factors (e.g., SURF1, SCO1, SCO2)"
    ],
    "other": [
      "Muscle biopsy showing ragged red fibers and cytochrome c oxidase-negative fibers",
      "Electromyography (EMG) consistent with myopathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "mitochondrial-complex-i-deficiency",
      "distinguishingFeatures": [
        "Predominant Complex I enzymatic deficiency",
        "Different genetic mutations affecting Complex I subunits",
        "Variable clinical presentation with less frequent cardiomyopathy"
      ]
    },
    {
      "diseaseId": "mitochondrial-myopathy",
      "distinguishingFeatures": [
        "Broader group of mitochondrial disorders without isolated Complex IV deficiency",
        "May have different enzymatic defects and clinical features",
        "Muscle biopsy and genetic testing differentiate"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive muscle weakness with respiratory failure",
    "Severe lactic acidosis refractory to treatment",
    "Early onset neurodevelopmental regression"
  ],
