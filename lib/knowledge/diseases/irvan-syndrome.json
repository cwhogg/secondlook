  "diagnosticCriteria": {
    "formalCriteriaName": "IRVAN Diagnostic Criteria",
    "criteria": [
      {
        "id": "retinal-vasculitis",
        "description": "Presence of idiopathic retinal vasculitis affecting medium and large retinal vessels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "retinal-aneurysms",
        "description": "Multiple aneurysmal dilations of retinal arterioles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroretinitis",
        "description": "Neuroretinitis characterized by optic disc swelling with peripapillary exudates",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peripheral-ischemia",
        "description": "Peripheral retinal ischemia demonstrated by fluorescein angiography",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "macular-edema",
        "description": "Macular edema or exudation causing visual impairment",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (retinal vasculitis, retinal aneurysms, and neuroretinitis) must be present for diagnosis",
    "notes": "Diagnosis is primarily clinical supported by fluorescein angiography findings; exclusion of systemic vasculitis or infectious causes is essential"
  },
