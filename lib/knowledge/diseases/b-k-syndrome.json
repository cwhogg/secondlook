  "diagnosticCriteria": {
    "formalCriteriaName": "Böök Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including midface hypoplasia and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Radiological evidence of multiple skeletal anomalies such as clavicular hypoplasia and vertebral segmentation defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation with short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (craniofacial dysmorphism and skeletal abnormalities) with supportive clinical features",
    "notes": "Genetic testing may assist but is not definitive due to limited molecular characterization."
  },
