  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiographic Diagnostic Criteria for Fibrous Dysplasia",
    "criteria": [
      {
        "id": "radiographic-lesions",
        "description": "Characteristic radiographic appearance of ground-glass bone lesions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Biopsy showing fibrous stroma with irregular woven bone trabeculae without osteoblastic rimming",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of bone deformity, pain, or pathological fractures consistent with fibrous dysplasia",
        "category": "minor",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Detection of activating GNAS gene mutation in affected tissue",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic radiographic lesions plus either histopathological confirmation or compatible clinical presentation",
    "notes": "Genetic testing is supportive but not mandatory for diagnosis."
  },
