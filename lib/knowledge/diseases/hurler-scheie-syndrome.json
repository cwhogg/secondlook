  "keyFindings": {
    "laboratory": [
      "Reduced alpha-L-iduronidase enzyme activity in leukocytes or fibroblasts",
      "Elevated urinary dermatan sulfate and heparan sulfate"
    ],
    "imaging": [
      "Skeletal X-rays showing dysostosis multiplex",
      "Echocardiogram revealing valvular thickening and cardiomyopathy",
      "Brain MRI may show mild ventriculomegaly or hydrocephalus"
    ],
    "genetic": [
      "IDUA (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electrocardiogram abnormalities related to cardiac involvement",
      "Pulmonary function tests may show restrictive pattern"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hurler-syndrome",
      "distinguishingFeatures": [
        "Earlier onset (infancy)",
        "More severe cognitive impairment",
        "More pronounced skeletal abnormalities"
      ]
    },
    {
      "diseaseId": "scheie-syndrome",
      "distinguishingFeatures": [
        "Later onset (adolescence or adulthood)",
        "Milder symptoms",
        "Minimal or no cognitive impairment"
      ]
    },
    {
      "diseaseId": "mucopolysaccharidosis-type-ii-hunter-syndrome",
      "distinguishingFeatures": [
        "X-linked inheritance",
        "Absence of corneal clouding",
        "Presence of aggressive behavior in some cases"
      ]
    }
  ],
  "redFlags": [
