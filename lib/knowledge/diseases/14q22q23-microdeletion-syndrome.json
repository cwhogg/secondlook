  "keyFindings": {
    "laboratory": [
      "Hormonal assays showing hypopituitarism (low GH, TSH, ACTH levels)"
    ],
    "imaging": [
      "MRI showing pituitary hypoplasia",
      "Orbital imaging demonstrating anophthalmia or microphthalmia",
      "Brain MRI may show midline structural anomalies"
    ],
    "genetic": [
      "Chromosomal microarray or FISH confirming microdeletion at 14q22q23",
      "Deletion involving genes such as OTX2 and BMP4"
    ],
    "other": [
      "Clinical ophthalmologic examination confirming eye anomalies",
      "Endocrinological evaluation for pituitary function"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "otx2-related-anophthalmia-microphthalmia",
      "distinguishingFeatures": [
        "Mutations limited to OTX2 gene without larger chromosomal deletion",
        "Variable pituitary involvement",
        "Often familial inheritance pattern"
      ]
    },
    {
      "diseaseId": "septo-optic-dysplasia",
      "distinguishingFeatures": [
        "Optic nerve hypoplasia with midline brain defects",
        "Hypopituitarism present but no chromosomal deletion",
        "Absence of anophthalmia"
      ]
    }
  ],
  "redFlags": [
    "Bilateral absence of eyes at birth",
    "Severe hypopituitarism causing life-threatening hormonal deficiencies",
    "Feeding difficulties due to cleft palate and craniofacial anomalies"
