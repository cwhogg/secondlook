  "diagnosticCriteria": {
    "formalCriteriaName": "Radiological and Clinical Diagnostic Criteria for Subependymal Nodular Heterotopia",
    "criteria": [
      {
        "id": "imaging-nodules",
        "description": "Presence of nodular heterotopic gray matter along the lateral ventricular walls on MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-epilepsy",
        "description": "History of focal epilepsy or seizures consistent with cortical malformation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-fila1-mutation",
        "description": "Identification of pathogenic mutation in the FLNA gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic subependymal nodules on MRI plus clinical history of epilepsy or seizures",
    "notes": "Genetic testing for FLNA mutations supports diagnosis but is not mandatory."
  },
