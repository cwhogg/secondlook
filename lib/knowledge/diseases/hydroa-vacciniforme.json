  "keyFindings": {
    "laboratory": [
      "Positive EBV-encoded RNA (EBER) in situ hybridization in skin biopsy",
      "Mild lymphocytosis or atypical lymphocytes in peripheral blood",
      "Elevated liver enzymes in some cases"
    ],
    "imaging": [
      "Ultrasound may show mild hepatosplenomegaly",
      "CT or MRI if systemic involvement suspected"
    ],
    "genetic": [
      "No specific genetic mutation identified; association with EBV infection"
    ],
    "other": [
      "Phototesting reproduces characteristic lesions",
      "Histopathology shows necrotic keratinocytes with perivascular lymphocytic infiltrate"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "polymorphic-light-eruption",
      "distinguishingFeatures": [
        "Polymorphic-light-eruption lacks vacciniforme scarring",
        "Usually resolves without scarring",
        "No EBV association"
      ]
    },
    {
      "diseaseId": "epstein-barr-virus-associated-lymphoproliferative-disorder",
      "distinguishingFeatures": [
        "More aggressive systemic symptoms",
        "Histopathology shows malignant lymphoid proliferation",
        "May have systemic organ involvement"
      ]
    },
    {
      "diseaseId": "solar-urticaria",
      "distinguishingFeatures": [
        "Immediate wheal-and-flare reaction to sunlight",
        "No vesiculopapular lesions or scarring",
        "Negative EBV markers"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of skin lesions with ulceration",
    "Development of systemic symptoms such as high fever and weight loss",
    "Signs of lymphoproliferative disorder or systemic EBV infection"
  ],
