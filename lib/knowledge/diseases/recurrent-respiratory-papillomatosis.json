  "differentialDiagnoses": [
    {
      "diseaseId": "laryngeal-carcinoma",
      "distinguishingFeatures": [
        "Malignant lesions with invasive growth",
        "Histopathology showing carcinoma rather than benign papillomas",
        "Typically older age group with smoking history"
      ]
    },
    {
      "diseaseId": "vocal-cord-nodules",
      "distinguishingFeatures": [
        "Non-papillomatous benign lesions",
        "No HPV association",
        "Usually related to voice overuse"
      ]
    },
    {
      "diseaseId": "chronic-laryngitis",
      "distinguishingFeatures": [
        "Inflammatory changes without papillomatous growth",
        "No HPV DNA detected",
        "Symptoms related to infection or irritation"
      ]
    }
  ],
  "redFlags": [
    "Progressive airway obstruction causing respiratory distress",
    "Rapid increase in lesion size or number",
    "Signs of malignant transformation such as persistent ulceration or bleeding"
  ],
