  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and biochemical diagnostic criteria for Lowe syndrome",
    "criteria": [
      {
        "id": "ocular-features",
        "description": "Congenital bilateral cataracts and glaucoma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-features",
        "description": "Hypotonia, intellectual disability, and delayed psychomotor development",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-features",
        "description": "Proximal renal tubular dysfunction (Fanconi-type renal tubular acidosis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "OCRL1-mutation",
        "description": "Pathogenic variants in the OCRL gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-features",
        "description": "Growth retardation, muscle hypotonia, and behavioral abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital bilateral cataracts, neurological involvement with intellectual disability, and proximal renal tubular dysfunction, confirmed by pathogenic OCRL gene mutation",
    "notes": "Genetic testing for OCRL mutations is confirmatory; biochemical tests support diagnosis."
  },
