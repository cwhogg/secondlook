  "diagnosticCriteria": {
    "formalCriteriaName": "ATS/IDSA Diagnostic Criteria for NTM Pulmonary Disease",
    "criteria": [
      {
        "id": "clinical-symptoms",
        "description": "Presence of pulmonary symptoms such as chronic cough, sputum production, or hemoptysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-abnormalities",
        "description": "Chest imaging showing nodular or cavitary opacities, or multifocal bronchiectasis with multiple small nodules",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microbiological-evidence",
        "description": "Positive culture results from at least two separate expectorated sputum samples or one bronchial wash/lavage positive for NTM species",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-diseases",
        "description": "Exclusion of other diagnoses such as tuberculosis or malignancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical symptoms, radiographic abnormalities, and microbiological evidence) must be met",
    "notes": "Diagnosis requires exclusion of other pulmonary diseases, especially tuberculosis."
  },
