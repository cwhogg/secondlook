  "diagnosticCriteria": {
    "formalCriteriaName": "Armstrong Criteria for Corticobasal Degeneration",
    "criteria": [
      {
        "id": "asymmetric-rigidity",
        "description": "Asymmetric limb rigidity or akinesia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "apraxia",
        "description": "Limb apraxia, especially ideomotor apraxia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cortical-sensory-loss",
        "description": "Cortical sensory deficits such as astereognosis or agraphesthesia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alien-limb",
        "description": "Alien limb phenomenon",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cognitive-impairment",
        "description": "Executive dysfunction or cognitive decline",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of asymmetric rigidity or akinesia plus at least two of apraxia, cortical sensory loss, or alien limb phenomenon",
    "notes": "Diagnosis is clinical; imaging and pathology support but are not definitive."
  },
