      },
      {
        "symptomName": "Subretinal neovascularization",
        "frequency": 0.3,
        "bodySystem": "ophthalmological",
        "notes": "Abnormal new blood vessel growth beneath the retina"
      },
      {
        "symptomName": "Mild metamorphopsia progression",
        "frequency": 0.25,
        "bodySystem": "ophthalmological"
      },
      {
        "symptomName": "Mild color vision changes",
