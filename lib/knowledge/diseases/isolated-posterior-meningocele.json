    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Posterior Meningocele",
    "criteria": [
      {
        "id": "visible-sac",
        "description": "Presence of a cystic, fluid-filled sac protruding through a defect in the posterior vertebral arches",
