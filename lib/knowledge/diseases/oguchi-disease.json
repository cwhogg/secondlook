  "diagnosticCriteria": {
    "formalCriteriaName": "Oguchi Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "mizuo-nakamura-phenomenon",
        "description": "Presence of Mizuo-Nakamura phenomenon: golden-yellow discoloration of the retina that disappears after prolonged dark adaptation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroretinogram-abnormality",
        "description": "Electroretinogram (ERG) showing markedly reduced rod responses with normal cone responses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in SAG or GRK1 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-history",
        "description": "Congenital or early childhood onset of stationary night blindness without progressive vision loss",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of Mizuo-Nakamura phenomenon, characteristic ERG findings, and pathogenic variants in SAG or GRK1 genes",
    "notes": "Diagnosis relies heavily on clinical observation of Mizuo-Nakamura phenomenon and electrophysiological testing supported by genetic confirmation."
  },
