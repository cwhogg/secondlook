  "diagnosticCriteria": {
    "formalCriteriaName": "Hereditary Pyropoikilocytosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "hemolytic-anemia",
        "description": "Presence of chronic hemolytic anemia with reticulocytosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "red-cell-morphology",
        "description": "Marked red blood cell poikilocytosis with microspherocytes and elliptocytes on peripheral smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thermal-instability-test",
        "description": "Increased red cell fragmentation and shape abnormalities upon heat exposure (thermal sensitivity test)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of hereditary hemolytic anemia or red cell membrane disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "spectrin-deficiency",
        "description": "Biochemical or genetic evidence of spectrin or other red cell membrane protein abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic hemolytic anemia, characteristic red blood cell morphology, and positive thermal instability test",
    "notes": "Diagnosis is supported by family history and confirmed by genetic or protein analysis when available."
  },
