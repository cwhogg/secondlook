  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Trisomy 18p Syndrome",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Presence of an extra copy of the short arm of chromosome 18 confirmed by karyotyping or molecular cytogenetics",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facial-features",
        "description": "Distinctive craniofacial dysmorphisms including microcephaly, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital heart anomalies such as ventricular septal defect",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Pre- and postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of trisomy 18p plus presence of at least two major clinical features",
    "notes": "Diagnosis relies heavily on cytogenetic analysis; clinical features support but are variable."
  },
