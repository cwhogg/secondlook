  "diagnosticCriteria": {
    "formalCriteriaName": "Schimmelpenning-Feuerstein-Mims Diagnostic Criteria",
    "criteria": [
      {
        "id": "nevus-sebaceus",
        "description": "Presence of a congenital linear nevus sebaceus typically on the scalp or face",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-abnormalities",
        "description": "Neurological manifestations such as seizures, intellectual disability, or hemimegalencephaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "Ocular abnormalities including coloboma, choristoma, or strabismus",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-malformations",
        "description": "Skeletal defects such as scoliosis or limb asymmetry",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of a linear nevus sebaceus plus at least one major extracutaneous manifestation (neurological or ocular abnormalities)",
    "notes": "Diagnosis is clinical; genetic testing may support but is not definitive."
  },
