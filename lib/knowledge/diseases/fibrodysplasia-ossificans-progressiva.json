  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Inflammatory markers may be elevated during flare-ups"
    ],
    "imaging": [
      "Radiographs showing heterotopic ossification in characteristic patterns",
      "CT or MRI to assess extent of soft tissue ossification"
    ],
    "genetic": [
      "Pathogenic mutation in ACVR1 gene (most commonly c.617G>A; R206H)"
    ],
    "other": [
      "Physical examination revealing malformed great toes",
      "Clinical history of progressive ossification and flare-ups"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "progressive-osseous-heteroplasia",
      "distinguishingFeatures": [
        "Heterotopic ossification begins in skin and subcutaneous tissues",
        "No congenital toe malformations",
        "Different genetic mutations (GNAS gene)"
      ]
    },
    {
      "diseaseId": "myositis-ossificans-traumatica",
      "distinguishingFeatures": [
        "Localized ossification following trauma",
        "No congenital malformations",
        "Non-progressive and limited to injury site"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive heterotopic ossification causing joint ankylosis",
    "Respiratory distress due to chest wall restriction",
    "Flare-ups triggered by trauma or intramuscular injections"
  ],
  "specialistType": [
