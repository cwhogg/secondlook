  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Epidermolysis Bullosa",
    "criteria": [
      {
        "id": "clinical-blistering",
        "description": "Presence of skin blistering and erosions following minor trauma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "subbasement-membrane-cleft",
        "description": "Histopathology showing cleavage below the basement membrane zone",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "type-vii-collagen-deficiency",
        "description": "Immunofluorescence or genetic testing demonstrating type VII collagen abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant or recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical blistering plus histopathologic confirmation of subbasement membrane cleavage and demonstration of type VII collagen abnormality",
    "notes": "Genetic testing for COL7A1 mutations confirms diagnosis and subtype"
  },
