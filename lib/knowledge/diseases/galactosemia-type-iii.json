  "diagnosticCriteria": {
    "formalCriteriaName": "Galactosemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced or absent UDP-galactose-4-epimerase enzyme activity in erythrocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "galactosemia-symptoms",
        "description": "Presence of clinical symptoms consistent with galactosemia such as feeding difficulties, hepatomegaly, or cataracts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the GALE gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "galactosemia-metabolites",
        "description": "Elevated galactose or galactose-1-phosphate levels in blood or urine",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced UDP-galactose-4-epimerase enzyme activity plus either pathogenic GALE gene variants or consistent clinical symptoms",
    "notes": "Enzyme activity testing is critical to distinguish Type III from other galactosemias."
  },
