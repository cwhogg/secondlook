  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Intellectual Disability-Strabismus Syndrome",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of intellectual disability confirmed by standardized cognitive testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "strabismus",
        "description": "Manifest strabismus diagnosed by ophthalmologic examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay evident in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Mild facial dysmorphic features such as broad nasal bridge and epicanthal folds",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Generalized hypotonia noted in infancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of intellectual disability, strabismus, and developmental delay",
    "notes": "Diagnosis is clinical; genetic testing may be supportive but is not definitive."
