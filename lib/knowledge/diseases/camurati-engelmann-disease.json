  "diagnosticCriteria": {
    "formalCriteriaName": "Camurati-Engelmann Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "diaphyseal-bone-thickening",
        "description": "Bilateral and symmetric cortical thickening of the diaphyses of long bones on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-pain-and-muscle-weakness",
        "description": "Progressive bone pain and proximal muscle weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tgfb1-mutation",
        "description": "Presence of pathogenic mutation in TGFB1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-metabolic-bone-markers",
        "description": "Normal or mildly elevated bone metabolic markers",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic diaphyseal cortical thickening on imaging plus bone pain and muscle weakness, with or without confirmed TGFB1 mutation",
    "notes": "Genetic testing for TGFB1 mutation is confirmatory but not always available."
  },
