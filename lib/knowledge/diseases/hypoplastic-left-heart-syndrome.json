  "keyFindings": {
    "laboratory": [
      "Metabolic acidosis on blood gas analysis",
      "Elevated lactate levels"
    ],
    "imaging": [
      "Echocardiography showing hypoplastic left ventricle and aortic atresia",
      "Chest X-ray showing cardiomegaly and pulmonary venous congestion"
    ],
    "genetic": [
      "No single causative gene identified; multifactorial etiology suspected",
      "Associations with mutations in cardiac developmental genes (e.g., NKX2-5, NOTCH1)"
    ],
    "other": [
      "Prenatal ultrasound may detect abnormal cardiac anatomy",
      "Dependence on patent ductus arteriosus for systemic circulation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "critical-aortic-stenosis",
      "distinguishingFeatures": [
        "Presence of left ventricular hypertrophy rather than hypoplasia",
        "Patent but stenotic aortic valve instead of atresia"
      ]
    },
    {
      "diseaseId": "mitral-atresia-with-intact-ventricular-septum",
      "distinguishingFeatures": [
        "Atresia of mitral valve with intact ventricular septum",
        "Left ventricle may be small but not as severely hypoplastic as in HLHS"
      ]
    }
  ],
