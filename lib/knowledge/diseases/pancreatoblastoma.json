  "keyFindings": {
    "laboratory": [
      "Elevated serum alpha-fetoprotein (AFP)",
      "Mild anemia in some cases",
      "Occasional elevated liver enzymes if biliary obstruction present"
    ],
    "imaging": [
      "Well-circumscribed pancreatic mass with heterogeneous enhancement on CT/MRI",
      "Possible calcifications within tumor",
      "Local invasion or metastases to liver or lymph nodes"
    ],
    "genetic": [
      "Somatic mutations in CTNNB1 (beta-catenin gene) frequently observed",
      "No consistent germline mutation identified"
    ],
    "other": [
      "Histopathology showing squamoid nests and acinar differentiation",
      "Immunohistochemistry positive for trypsin and chymotrypsin"
    ]
