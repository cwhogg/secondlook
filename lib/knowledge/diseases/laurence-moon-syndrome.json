  "diagnosticCriteria": {
    "formalCriteriaName": "Laurence-Moon Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "retinitis-pigmentosa",
        "description": "Presence of retinitis pigmentosa causing progressive vision loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "spastic-paraplegia",
        "description": "Spastic paraplegia or pyramidal tract signs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogonadism",
        "description": "Hypogonadism manifesting as delayed or absent secondary sexual characteristics",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "polydactyly-absence",
        "description": "Absence of polydactyly differentiating from Bardet-Biedl syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: retinitis pigmentosa, spastic paraplegia, and hypogonadism",
    "notes": "Differentiation from Bardet-Biedl syndrome is critical due to overlapping features but absence of polydactyly and obesity in Laurence-Moon syndrome."
  },
