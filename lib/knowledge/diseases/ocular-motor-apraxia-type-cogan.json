  "diagnosticCriteria": {
    "formalCriteriaName": "Cogan Ocular Motor Apraxia Diagnostic Criteria",
    "criteria": [
      {
        "id": "impaired-horizontal-voluntary-saccades",
        "description": "Impaired voluntary horizontal saccadic eye movements",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "compensatory-head-thrusts",
        "description": "Presence of compensatory head thrusts to initiate horizontal gaze",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-vertical-eye-movements",
        "description": "Preserved vertical eye movements and vestibulo-ocular reflexes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-structural-brain-lesions",
        "description": "No evidence of structural brain lesions on neuroimaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (impaired horizontal voluntary saccades and compensatory head thrusts) with supportive findings",
    "notes": "Diagnosis is clinical and supported by neuro-ophthalmological examination and imaging"
  },
