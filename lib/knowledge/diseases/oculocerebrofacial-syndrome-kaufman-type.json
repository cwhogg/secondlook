  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible hypothyroidism on thyroid function tests"
    ],
    "imaging": [
      "Brain MRI showing delayed myelination and cerebral atrophy",
      "Ocular ultrasound confirming microphthalmia",
      "Skeletal X-rays showing joint contractures and bone anomalies"
    ],
    "genetic": [
      "UBE3B (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electroencephalogram (EEG) may show epileptiform activity in patients with seizures"
    ]
  },
