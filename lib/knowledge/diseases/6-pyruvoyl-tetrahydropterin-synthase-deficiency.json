  "diagnosticCriteria": {
    "formalCriteriaName": "Biochemical and Genetic Diagnostic Criteria for PTPS Deficiency",
    "criteria": [
      {
        "id": "hyperphenylalaninemia",
        "description": "Elevated blood phenylalanine levels detected by newborn screening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biopterin-and-neopterin-profile",
        "description": "Abnormal cerebrospinal fluid and urine pterin profile showing decreased biopterin and elevated neopterin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ptps-enzyme-activity",
        "description": "Reduced or absent 6-pyruvoyl-tetrahydropterin synthase enzyme activity in fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the PTS gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of neurological symptoms such as hypotonia and movement disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hyperphenylalaninemia plus abnormal pterin profile and confirmation by enzyme assay or genetic testing",
    "notes": "Newborn screening for phenylketonuria often detects this disorder; confirmatory biochemical and genetic testing is essential."
  },
