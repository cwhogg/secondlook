  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Isolated Congenital Hypoglossia/Aglossia",
    "criteria": [
      {
        "id": "absent-or-hypoplastic-tongue",
        "description": "Complete absence (aglossia) or significant hypoplasia of the tongue confirmed by clinical examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-orofacial-structures",
        "description": "Absence of other major craniofacial anomalies or syndromic features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "functional-assessment",
        "description": "Impaired tongue mobility and associated feeding or speech difficulties documented by clinical evaluation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of absent or hypoplastic tongue with no other syndromic anomalies",
    "notes": "Diagnosis is primarily clinical supported by imaging to exclude associated anomalies."
  },
