  "diagnosticCriteria": {
    "formalCriteriaName": "Hydrolethalus Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "ventriculomegaly",
        "description": "Severe ventriculomegaly with hydrocephalus detected prenatally or at birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "polydactyly",
        "description": "Postaxial polydactyly of hands and/or feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brainmalformations",
        "description": "Agenesis or hypoplasia of the corpus callosum and other midline brain malformations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facialdysmorphism",
        "description": "Characteristic facial features including micrognathia and cleft lip/palate",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "geneticconfirmation",
        "description": "Identification of pathogenic HYLS1 gene mutation",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe ventriculomegaly with hydrocephalus, polydactyly, and brain malformations; genetic confirmation supports diagnosis",
    "notes": "Prenatal ultrasound and genetic testing are critical for early diagnosis"
