  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Autoimmune Cholangiopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "cholestatic-liver-enzyme-elevation",
        "description": "Persistent elevation of cholestatic liver enzymes (ALP, GGT) for more than 6 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoantibodies",
        "description": "Presence of autoantibodies such as anti-nuclear antibody (ANA) or anti-smooth muscle antibody (ASMA)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histological-evidence",
        "description": "Liver biopsy showing lymphocytic infiltration and bile duct injury consistent with autoimmune cholangiopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-evidence",
        "description": "Cholangiographic abnormalities demonstrating bile duct irregularities without evidence of obstruction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of cholestasis such as primary sclerosing cholangitis or biliary obstruction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (cholestatic liver enzyme elevation, presence of autoantibodies, and histological evidence) must be met",
    "notes": "Diagnosis requires exclusion of other cholestatic liver diseases"
  },
