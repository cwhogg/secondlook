{
  "id": "bardet-biedl-syndrome",
  "name": "Bardet-Biedl Syndrome",
  "aliases": [
    "BBS",
    "Laurence-Moon-Bardet-Biedl syndrome"
  ],
  "icd10Codes": [
    "Q87.8"
  ],
  "omimId": "209900",
  "orphanetId": "225",
  "prevalence": {
    "estimate": "1 in 140,000 to 1 in 160,000",
    "range": "0.0006%-0.0007%",
    "classification": "rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 20,
      "peak": 5
    },
    "sexPredilection": "equal",
    "ethnicAssociations": [
      "Caucasian",
      "Middle Eastern",
      "North African"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Beales et al. 1999 Diagnostic Criteria",
    "criteria": [
      {
        "id": "retinal-dystrophy",
        "description": "Rod-cone dystrophy (retinal dystrophy) leading to progressive vision loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "polydactyly",
        "description": "Postaxial polydactyly of hands or feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "obesity",
        "description": "Central obesity developing in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-anomalies",
        "description": "Structural and functional renal abnormalities",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cognitive-impairment",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypogonadism",
        "description": "Hypogonadism or genital anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "brachydactyly-syndactyly",
        "description": "Brachydactyly or syndactyly of the fingers or toes",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of four major criteria or three major plus two minor criteria",
    "notes": "Genetic testing can confirm diagnosis but is not required for clinical diagnosis."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Rod-cone retinal dystrophy",
        "frequency": 0.95,
        "bodySystem": "ophthalmological",
        "notes": "Progressive vision loss typically beginning in childhood"
      },
      {
        "symptomName": "Postaxial polydactyly",
        "frequency": 0.85,
        "bodySystem": "musculoskeletal",
        "notes": "Extra digit(s) on hands or feet"
      },
      {
        "symptomName": "Central obesity",
        "frequency": 0.8,
        "bodySystem": "endocrine",
        "notes": "Develops in early childhood"
      }
    ],
    "common": [
      {
        "symptomName": "Renal structural anomalies",
        "frequency": 0.65,
        "bodySystem": "renal",
        "notes": "Includes cystic dysplasia, scarring, and functional impairment"
      },
      {
        "symptomName": "Mild to moderate intellectual disability",
        "frequency": 0.6,
        "bodySystem": "neurological",
        "notes": "Variable cognitive impairment"
      },
      {
        "symptomName": "Hypogonadism or genital anomalies",
        "frequency": 0.55,
        "bodySystem": "reproductive",
        "notes": "Micropenis, cryptorchidism, or hypoplastic genitalia"
      },
      {
        "symptomName": "Brachydactyly or syndactyly",
        "frequency": 0.5,
        "bodySystem": "musculoskeletal",
        "notes": "Shortened or fused digits"
      }
    ],
    "occasional": [
      {
        "symptomName": "Diabetes mellitus",
        "frequency": 0.3,
        "bodySystem": "endocrine",
        "notes": "Type 2 diabetes associated with obesity"
      },
      {
        "symptomName": "Hypertension",
        "frequency": 0.25,
        "bodySystem": "cardiovascular",
        "notes": "Secondary to renal disease or obesity"
      },
      {
        "symptomName": "Speech delay",
        "frequency": 0.2,
        "bodySystem": "neurological",
        "notes": "Delayed language development"
      },
      {
        "symptomName": "Dental anomalies",
        "frequency": 0.15,
        "bodySystem": "gastrointestinal",
        "notes": "Hypodontia or enamel hypoplasia"
      }
    ],
    "rare": [
      {
        "symptomName": "Hepatic fibrosis",
        "frequency": 0.08,
        "bodySystem": "gastrointestinal",
        "notes": "Liver fibrosis in some cases"
      },
      {
        "symptomName": "Congenital heart defects",
        "frequency": 0.05,
        "bodySystem": "cardiovascular",
        "notes": "Rare structural cardiac anomalies"
      },
      {
        "symptomName": "Ataxia",
        "frequency": 0.04,
        "bodySystem": "neurological",
        "notes": "Impaired coordination"
      },
      {
        "symptomName": "Hearing loss",
        "frequency": 0.03,
        "bodySystem": "otolaryngological",
        "notes": "Sensorineural hearing impairment"
      }
    ]
  },
  "systemsAffected": [
    "ophthalmological",
    "musculoskeletal",
    "endocrine",
    "renal",
    "neurological",
    "reproductive",
    "cardiovascular",
    "gastrointestinal",
    "otolaryngological"
  ],
  "keyFindings": {
    "laboratory": [
      "Elevated serum creatinine indicating renal impairment",
      "Hyperglycemia in cases with diabetes mellitus"
    ],
    "imaging": [
      "Renal ultrasound showing cystic dysplasia or scarring",
      "Retinal imaging demonstrating rod-cone dystrophy",
      "MRI brain may show mild structural abnormalities"
    ],
    "genetic": [
      "Biallelic pathogenic variants in BBS genes (e.g., BBS1, BBS10)",
      "Genetic heterogeneity with at least 21 known BBS genes"
    ],
    "other": [
      "Electroretinogram (ERG) showing reduced rod and cone function",
      "Anthropometric measurements confirming central obesity"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "laurence-moon-syndrome",
      "distinguishingFeatures": [
        "Spastic paraplegia and absence of polydactyly",
        "More prominent neurological symptoms"
      ]
    },
    {
      "diseaseId": "alstrom-syndrome",
      "distinguishingFeatures": [
        "Cardiomyopathy and sensorineural hearing loss",
        "Absence of polydactyly"
      ]
    }
  ],
  "redFlags": [
    "Progressive vision loss in childhood",
    "Renal failure or significant renal impairment",
    "Early onset obesity with polydactyly"
  ],
  "specialistType": [
    "Geneticist",
    "Nephrologist",
    "Ophthalmologist",
    "Endocrinologist",
    "Pediatrician"
  ],
  "lastUpdated": "2026-02-17",
  "references": [
