  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Frontometaphyseal Dysplasia",
    "criteria": [
      {
        "id": "cranial-hyperostosis",
        "description": "Prominent cranial hyperostosis, especially of the frontal bone",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metaphyseal-flaring",
        "description": "Metaphyseal flaring and irregularities of long bones on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-loss",
        "description": "Conductive hearing loss due to otosclerosis or ossicular anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including supraorbital ridge prominence and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "FGD1-mutation",
        "description": "Identification of pathogenic mutation in the FLNA gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of cranial hyperostosis, metaphyseal abnormalities, and characteristic facial dysmorphism",
    "notes": "Genetic testing for FLNA mutations supports diagnosis but is not mandatory."
  },
