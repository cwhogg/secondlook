  "differentialDiagnoses": [
    {
      "diseaseId": "urethral-stricture",
      "distinguishingFeatures": [
        "Usually acquired rather than congenital",
        "Narrowing typically in anterior urethra",
        "No characteristic valve folds on cystoscopy"
      ]
    },
    {
      "diseaseId": "neurogenic-bladder",
      "distinguishingFeatures": [
        "Associated with neurological deficits",
        "Absent valve structures",
        "Bladder dysfunction due to nerve injury"
      ]
    }
  ],
