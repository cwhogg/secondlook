{
  "id": "iga-vasculitis",
  "name": "IgA Vasculitis",
  "aliases": [
    "Henoch-Schonlein Purpura",
    "HSP",
    "IgA Vasculitis (Henoch-Schonlein)",
    "Anaphylactoid Purpura"
  ],
  "icd10Codes": [
    "D69.0"
  ],
  "omimId": "600807",
  "orphanetId": "761",
  "prevalence": {
    "estimate": "10-20 per 100,000 in children; 1-2 per 100,000 in adults",
    "range": "1-20 per 100,000",
    "classification": "uncommon"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 3,
      "max": 10,
      "peak": 6
    },
    "sexPredilection": "slight-male",
    "ethnicAssociations": [
      "Asian populations (higher incidence)",
      "Caucasian"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "EULAR/PRINTO/PRES 2010 Classification Criteria for IgA Vasculitis",
    "criteria": [
      {
        "id": "igav-1",
        "description": "Palpable purpura (mandatory criterion) with lower limb predominance, not related to thrombocytopenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "igav-2",
        "description": "Diffuse abdominal pain (acute onset)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "igav-3",
        "description": "Biopsy showing predominant IgA deposition (skin or kidney)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "igav-4",
        "description": "Arthritis or arthralgia (acute onset)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "igav-5",
        "description": "Renal involvement: proteinuria >0.3 g/24h or albumin/creatinine ratio >30 mmol/mg, or hematuria or red cell casts",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Palpable purpura plus at least one of the four additional criteria",
    "notes": "More severe in adults than children. Adult-onset IgA vasculitis has higher rates of renal involvement and worse renal prognosis."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Palpable purpura (lower extremities and buttocks)",
        "snomedCode": "20143000",
        "frequency": 0.95,
        "bodySystem": "dermatological",
        "notes": "Non-thrombocytopenic; gravity-dependent distribution; mandatory for diagnosis"
      },
      {
        "symptomName": "IgA deposits on skin or renal biopsy",
        "frequency": 0.8,
        "bodySystem": "constitutional"
      }
    ],
    "common": [
      {
        "symptomName": "Arthritis/arthralgia (knees, ankles)",
        "snomedCode": "57676002",
        "frequency": 0.75,
        "bodySystem": "musculoskeletal",
        "notes": "Non-destructive; periarticular swelling"
      },
      {
        "symptomName": "Colicky abdominal pain",
        "snomedCode": "21522001",
        "frequency": 0.65,
        "bodySystem": "gastrointestinal"
      },
      {
        "symptomName": "Hematuria (microscopic or gross)",
        "snomedCode": "34436003",
        "frequency": 0.4,
        "bodySystem": "renal"
      },
      {
        "symptomName": "Proteinuria",
        "snomedCode": "29738008",
        "frequency": 0.35,
        "bodySystem": "renal"
      },
      {
        "symptomName": "Nausea and vomiting",
        "snomedCode": "422587007",
        "frequency": 0.35,
        "bodySystem": "gastrointestinal"
      }
    ],
    "occasional": [
      {
        "symptomName": "Gastrointestinal bleeding (melena, hematochezia)",
        "snomedCode": "74474003",
        "frequency": 0.2,
        "bodySystem": "gastrointestinal"
      },
      {
        "symptomName": "Intussusception",
        "snomedCode": "19063002",
        "frequency": 0.05,
        "bodySystem": "gastrointestinal",
        "notes": "Especially in children; usually ileocolic"
      },
      {
        "symptomName": "Testicular/scrotal involvement (orchitis)",
        "snomedCode": "274718006",
        "frequency": 0.1,
        "bodySystem": "constitutional",
        "notes": "Acute scrotum in boys; can mimic testicular torsion"
      },
      {
        "symptomName": "Subcutaneous edema (scalp, periorbital in young children)",
        "snomedCode": "65124004",
        "frequency": 0.15,
        "bodySystem": "dermatological"
      }
    ],
    "rare": [
      {
        "symptomName": "Nephrotic syndrome",
        "snomedCode": "52254009",
        "frequency": 0.05,
        "bodySystem": "renal"
      },
      {
        "symptomName": "Rapidly progressive glomerulonephritis",
        "snomedCode": "36171008",
        "frequency": 0.03,
        "bodySystem": "renal"
      },
      {
        "symptomName": "Pulmonary hemorrhage",
        "snomedCode": "233608003",
        "frequency": 0.02,
        "bodySystem": "respiratory"
      },
      {
        "symptomName": "Seizures/CNS vasculitis",
        "snomedCode": "91175000",
        "frequency": 0.02,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Pancreatitis",
        "snomedCode": "75694006",
        "frequency": 0.02,
        "bodySystem": "gastrointestinal"
      }
    ]
  },
  "systemsAffected": [
    "dermatological",
    "musculoskeletal",
    "gastrointestinal",
    "renal"
  ],
  "keyFindings": {
    "laboratory": [
      "Normal platelet count (distinguishes from thrombocytopenic purpura)",
      "Elevated serum IgA (30-50%)",
      "Elevated ESR and CRP",
      "Normal coagulation studies",
      "Urinalysis: hematuria, proteinuria, RBC casts",
      "Elevated serum creatinine in severe nephritis",
      "Fecal occult blood positive"
    ],
    "imaging": [
      "Abdominal ultrasound: bowel wall thickening, intussusception",
      "CT abdomen: bowel wall edema, mesenteric lymphadenopathy",
      "Testicular ultrasound: increased flow (epididymo-orchitis vs. torsion)"
    ],
    "genetic": [
      "HLA-DRB1*01 association",
      "HLA-B35 association reported",
      "Complement factor H-related gene variants"
    ],
    "other": [
      "Skin biopsy: leukocytoclastic vasculitis with IgA deposition on immunofluorescence",
      "Renal biopsy: mesangial IgA deposition (similar to IgA nephropathy), crescents in severe cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "immune-thrombocytopenic-purpura",
      "distinguishingFeatures": [
        "Low platelet count",
        "Non-palpable petechiae",
        "No abdominal/joint symptoms"
      ]
    },
    {
      "diseaseId": "microscopic-polyangiitis",
      "distinguishingFeatures": [
        "ANCA positive",
        "Pauci-immune GN (no IgA)",
        "Adults",
        "Pulmonary-renal syndrome"
      ]
    },
    {
      "diseaseId": "cryoglobulinemic-vasculitis",
      "distinguishingFeatures": [
        "Cryoglobulins present",
        "HCV association",
        "Complement consumption",
        "Peripheral neuropathy"
      ]
    },
    {
      "diseaseId": "meningococcemia",
      "distinguishingFeatures": [
        "Rapidly progressive",
        "Fever and meningismus",
        "Blood cultures positive",
        "Purpura fulminans"
      ]
    }
  ],
  "redFlags": [
    "Progressive renal insufficiency (especially in adults)",
    "Nephrotic-range proteinuria",
    "Massive GI hemorrhage",
    "Signs of intussusception (colicky pain, currant jelly stool)",
    "Acute scrotum (must exclude testicular torsion)",
    "Recurrence beyond 6 months (consider renal monitoring)"
  ],
  "specialistType": [
