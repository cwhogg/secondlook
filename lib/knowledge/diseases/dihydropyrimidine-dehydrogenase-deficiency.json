  "diagnosticCriteria": {
    "formalCriteriaName": "DPD Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced or absent dihydropyrimidine dehydrogenase enzyme activity in peripheral blood mononuclear cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the DPYD gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-pyrimidine-profile",
        "description": "Abnormal urinary excretion pattern of pyrimidine metabolites (increased dihydrouracil and dihydrothymine)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced enzyme activity and/or pathogenic DPYD gene variants",
    "notes": "Diagnosis can be confirmed by enzyme assay or genetic testing; urinary metabolite analysis supports diagnosis."
  },
