  "diagnosticCriteria": {
    "formalCriteriaName": "Mitochondrial Disease Diagnostic Criteria (MDC)",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of multisystemic clinical manifestations consistent with mitochondrial dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-evidence",
        "description": "Deficient activity of multiple respiratory chain complexes in muscle or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in nuclear genes affecting oxidative phosphorylation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Muscle biopsy showing ragged-red fibers or cytochrome c oxidase (COX) deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multisystemic clinical features plus biochemical evidence of multiple respiratory chain complex deficiencies and genetic confirmation of pathogenic variants in oxidative phosphorylation genes",
    "notes": "Diagnosis requires integration of clinical, biochemical, and genetic data due to phenotypic heterogeneity."
  },
