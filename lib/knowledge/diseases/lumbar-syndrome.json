  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Lumbar Syndrome",
    "criteria": [
      {
        "id": "chronic-lumbar-pain",
        "description": "Persistent lumbar region pain lasting more than 3 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "restricted-lumbar-mobility",
        "description": "Reduced range of motion in lumbar spine on physical examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-radiculopathy",
        "description": "No clinical or imaging evidence of radiculopathy or nerve root compression",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-exclusion",
        "description": "Imaging studies excluding vertebral fractures, tumors, or infections",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria with exclusion of radiculopathy and other specific lumbar pathologies",
    "notes": "Diagnosis is primarily clinical supported by imaging to exclude other causes"
  },
