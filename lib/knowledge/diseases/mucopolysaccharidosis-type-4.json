  "keyFindings": {
    "laboratory": [
      "Elevated urinary keratan sulfate",
      "Reduced N-acetylgalactosamine-6-sulfatase or beta-galactosidase enzyme activity"
    ],
    "imaging": [
      "Radiographs showing platyspondyly, odontoid hypoplasia, and dysostosis multiplex",
      "MRI of cervical spine demonstrating atlantoaxial instability"
    ],
    "genetic": [
      "Mutations in GALNS gene (MPS IVA) or GLB1 gene (MPS IVB)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Corneal clouding on slit-lamp examination",
      "Cardiac echocardiography showing valve thickening or regurgitation"
    ]
  },
  "differentialDiagnoses": [
    {
