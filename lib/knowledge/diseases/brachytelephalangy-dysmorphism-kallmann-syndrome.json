  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Kallmann Syndrome with Brachytelephalangy",
    "criteria": [
      {
        "id": "anosmia-hyposmia",
        "description": "Congenital anosmia or hyposmia confirmed by olfactory testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogonadotropic-hypogonadism",
        "description": "Hypogonadotropic hypogonadism with delayed or absent puberty",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brachytelephalangy",
        "description": "Shortening of distal phalanges of fingers (brachytelephalangy) confirmed radiologically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Presence of characteristic facial dysmorphism (e.g., midface hypoplasia, hypertelorism)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked or autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital anosmia or hyposmia, hypogonadotropic hypogonadism, and brachytelephalangy",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
