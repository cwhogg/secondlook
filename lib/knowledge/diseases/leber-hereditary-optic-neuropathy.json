        "requiredForDiagnosis": true
      },
      {
        "id": "optic-nerve-atrophy",
        "description": "Optic nerve atrophy or pallor observed on fundoscopic examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of maternal inheritance of optic neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "visual-field-defects",
        "description": "Central or cecocentral scotomas on visual field testing",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of a primary mitochondrial DNA mutation plus acute or subacute central vision loss with optic nerve atrophy",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical presentation may vary."
  },
