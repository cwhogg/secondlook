  "diagnosticCriteria": {
    "formalCriteriaName": "No standardized formal criteria; diagnosis based on clinical, biochemical, and genetic findings",
    "criteria": [
      {
        "id": "tendon-xanthomas",
        "description": "Presence of tendon xanthomas, especially in Achilles tendons",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-dysfunction",
        "description": "Progressive neurological symptoms including cerebellar ataxia, cognitive decline, and pyramidal signs",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-serum-cholestanol",
        "description": "Elevated serum cholestanol levels and abnormal bile alcohol profiles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the CYP27A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "juvenile-cataracts",
        "description": "Early-onset bilateral cataracts",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated serum cholestanol and pathogenic CYP27A1 mutations with supportive clinical features",
    "notes": "Diagnosis is confirmed by biochemical and genetic testing; clinical features support suspicion."
  },
