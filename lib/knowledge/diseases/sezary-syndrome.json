  "diagnosticCriteria": {
    "formalCriteriaName": "WHO-EORTC Diagnostic Criteria for Sezary Syndrome",
    "criteria": [
      {
        "id": "erythroderma",
        "description": "Generalized erythroderma involving >80% of body surface area",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "circulating-sezary-cells",
        "description": "Presence of clonally related malignant T cells (Sezary cells) in peripheral blood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphadenopathy",
        "description": "Generalized lymphadenopathy with histopathologic evidence of lymphoma involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotyping",
        "description": "Aberrant T-cell immunophenotype (e.g., loss of CD7 or CD26) on flow cytometry",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "molecular-clonality",
        "description": "Detection of T-cell receptor gene rearrangement confirming clonality",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of erythroderma, circulating Sezary cells, and lymphadenopathy with histopathologic confirmation",
    "notes": "Diagnosis requires integration of clinical, hematologic, immunophenotypic, and molecular findings."
  },
