  "diagnosticCriteria": {
    "formalCriteriaName": "Bangstad Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "metabolic-abnormalities",
        "description": "Presence of multiple acyl-CoA dehydrogenase deficiencies confirmed by biochemical assays",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Neonatal or infantile onset of hypotonia and metabolic acidosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in ETFDH or related genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing lipid storage myopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-treatment",
        "description": "Clinical improvement with riboflavin supplementation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (metabolic abnormalities, clinical features, and genetic confirmation) must be met for diagnosis.",
    "notes": "Early diagnosis is critical due to potential responsiveness to riboflavin therapy."
  },
