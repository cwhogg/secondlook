  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for SCA10",
    "criteria": [
      {
        "id": "ataxia",
        "description": "Progressive cerebellar ataxia characterized by gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epilepsy",
        "description": "Presence of epileptic seizures, often generalized tonic-clonic",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Detection of expanded ATTCT pentanucleotide repeat in the ATXN10 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive cerebellar ataxia plus genetic confirmation of ATXN10 repeat expansion",
    "notes": "Epilepsy is common but not mandatory for diagnosis; genetic testing is definitive."
  },
