  "keyFindings": {
    "laboratory": [
      "Iron deficiency anemia on CBC",
      "Hypoproteinemia in protein-losing enteropathy"
    ],
    "imaging": [
      "Endoscopic visualization of multiple juvenile polyps",
      "Barium studies showing polyp-related filling defects or intussusception"
    ],
    "genetic": [
      "TWIST2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology showing hamartomatous juvenile polyps with abundant lamina propria and cystic glands"
    ]
  },
