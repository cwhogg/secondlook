  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Pfeiffer Syndrome Type 3",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Presence of cloverleaf skull (kleeblattschädel) or severe craniosynostosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "broad-thumb-toe",
        "description": "Broad and medially deviated thumbs and great toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midface-hypoplasia",
        "description": "Severe midface hypoplasia with proptosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-impairment",
        "description": "Neurological impairment due to increased intracranial pressure",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Conductive or sensorineural hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: severe craniosynostosis (often cloverleaf skull), broad thumbs and great toes, and midface hypoplasia",
    "notes": "Genetic testing for FGFR2 mutations can support diagnosis but is not mandatory."
  },
