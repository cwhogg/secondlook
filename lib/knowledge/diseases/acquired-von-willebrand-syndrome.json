  "keyFindings": {
    "laboratory": [
      "Reduced von Willebrand factor antigen (vWF:Ag)",
      "Reduced ristocetin cofactor activity (vWF:RCo)",
      "Prolonged bleeding time",
      "Normal platelet count",
      "Normal or mildly prolonged activated partial thromboplastin time (aPTT)"
    ],
    "imaging": [
      "Imaging may be used to identify bleeding sites (e.g., endoscopy for GI bleeding, MRI for intracranial hemorrhage)"
    ],
    "genetic": [
      "No germline mutations in VWF gene (distinguishes from congenital von Willebrand disease)"
    ],
    "other": [
      "Identification of underlying disorders such as monoclonal gammopathy, autoimmune diseases, or cardiovascular abnormalities"
    ]
  },
