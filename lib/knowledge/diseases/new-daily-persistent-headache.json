  "diagnosticCriteria": {
    "formalCriteriaName": "International Classification of Headache Disorders (ICHD-3) Criteria for New Daily Persistent Headache",
    "criteria": [
      {
        "id": "onset",
        "description": "Distinct and clearly remembered onset of headache, with pain becoming continuous and unremitting within 24 hours",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "duration",
        "description": "Headache present daily and unremitting for more than 3 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion",
        "description": "No evidence of secondary headache disorder after appropriate investigations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "headacheCharacteristics",
        "description": "Headache may be bilateral or unilateral, pressing or tightening in quality, mild to moderate intensity",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "associatedSymptoms",
        "description": "May have associated photophobia, phonophobia, or mild nausea without vomiting",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met: sudden onset with continuous daily headache within 24 hours, duration >3 months, and exclusion of secondary causes",
    "notes": "Diagnosis requires careful exclusion of secondary causes such as infection, vascular disorders, or neoplasm."
  },
