  "keyFindings": {
    "laboratory": [
      "Elevated double-negative T cells (CD3+ TCRαβ+ CD4- CD8-)",
      "Positive Coombs test in autoimmune hemolytic anemia",
      "Elevated serum vitamin B12 and IL-10 levels",
      "Hypergammaglobulinemia"
    ],
    "imaging": [
      "Lymphadenopathy and splenomegaly on ultrasound or CT scan",
      "Hepatomegaly on abdominal imaging"
    ],
    "genetic": [
      "Mutations in FAS (TNFRSF6), FASLG, or CASP10 genes"
    ],
    "other": [
      "Defective lymphocyte apoptosis demonstrated by in vitro functional assays"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "common-variable-immunodeficiency-cvid",
      "distinguishingFeatures": [
        "Hypogammaglobulinemia rather than hypergammaglobulinemia",
        "Recurrent bacterial infections predominant",
        "Absence of elevated double-negative T cells"
      ]
    },
    {
      "diseaseId": "systemic-lupus-erythematosus-sle",
      "distinguishingFeatures": [
        "Presence of ANA and anti-dsDNA antibodies",
        "Multisystem autoimmune involvement",
        "Lymphadenopathy less persistent and less prominent"
      ]
    }
  ],
  "redFlags": [
