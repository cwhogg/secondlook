  "keyFindings": {
    "laboratory": [
      "Elevated alpha-fetoprotein in maternal serum screening",
      "Abnormal prenatal screening markers (e.g., low PAPP-A)"
    ],
    "imaging": [
      "Ultrasound showing intrauterine growth restriction and congenital anomalies",
      "Echocardiography revealing structural heart defects",
      "X-ray showing rocker-bottom feet"
    ],
    "genetic": [
      "Karyotype demonstrating trisomy 18",
      "Fluorescence in situ hybridization (FISH) confirming extra chromosome 18"
    ],
    "other": [
      "Prenatal diagnosis via chorionic villus sampling or amniocentesis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "trisomy-13-patau-syndrome",
