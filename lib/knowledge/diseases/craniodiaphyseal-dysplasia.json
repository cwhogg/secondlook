  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific biochemical markers"
    ],
    "imaging": [
      "Radiographs showing diffuse hyperostosis and sclerosis of craniofacial bones and diaphyses of long bones",
      "CT scan demonstrating foraminal narrowing and cranial nerve compression",
      "MRI may show brain and nerve involvement secondary to bone overgrowth"
    ],
    "genetic": [
      "SOST (causative)",
      "SP7 (causative)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
