  "keyFindings": {
    "laboratory": [
      "Elevated serum VEGF-D levels",
      "Mild hypoxemia on arterial blood gas analysis"
    ],
    "imaging": [
      "High-resolution CT showing diffuse thin-walled lung cysts",
      "Abdominal ultrasound or CT showing renal angiomyolipomas",
      "Chest X-ray may show pneumothorax or pleural effusions"
    ],
    "genetic": [
      "Mutations in TSC1 or TSC2 genes in some cases",
      "Association with tuberous sclerosis complex",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Histopathology showing proliferation of abnormal smooth muscle-like LAM cells",
      "Immunohistochemistry positive for HMB-45 marker"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pulmonary-emphysema",
      "distinguishingFeatures": [
        "Absence of cystic lung lesions typical of LAM",
        "Smoking history common in emphysema",
        "No association with angiomyolipomas or elevated VEGF-D"
      ]
    },
    {
      "diseaseId": "pulmonary-langerhans-cell-histiocytosis",
      "distinguishingFeatures": [
        "Nodular and cystic lung lesions predominantly in upper lobes",
        "Smoking history common",
        "Presence of Langerhans cells on biopsy"
      ]
    },
    {
      "diseaseId": "tuberous-sclerosis-complex",
      "distinguishingFeatures": [
        "Multisystem involvement with skin lesions, seizures",
        "LAM may be a manifestation but TSC has broader clinical features"
      ]
    }
  ],
  "redFlags": [
    "Recurrent spontaneous pneumothorax",
    "Rapidly progressive dyspnea",
    "Chylous pleural effusions or ascites"
  ],
