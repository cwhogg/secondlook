  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible mild lymphopenia",
      "Elevated PI3K-AKT pathway activity in affected tissues (research setting)"
    ],
    "imaging": [
      "Brain MRI showing polymicrogyria and megalencephaly",
      "MRI or ultrasound revealing vascular malformations",
      "Occasional hydrocephalus or Chiari malformation"
    ],
    "genetic": [
      "PIK3CA (somatic)"
    ],
    "other": [
      "Skin biopsy showing capillary malformations",
      "Clinical measurement of head circumference above 98th percentile"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "proteus-syndrome",
      "distinguishingFeatures": [
        "Asymmetric overgrowth with cerebriform connective tissue nevi",
        "Absence of polymicrogyria",
        "Distinctive skeletal abnormalities"
      ]
    },
    {
      "diseaseId": "sturge-weber-syndrome",
      "distinguishingFeatures": [
        "Facial port-wine stain in trigeminal nerve distribution",
        "Leptomeningeal angiomas rather than polymicrogyria",
        "Glaucoma and seizures"
      ]
    }
  ],
  "redFlags": [
    "Rapidly increasing head circumference in infancy",
    "Severe refractory seizures",
    "Signs of increased intracranial pressure or hydrocephalus"
  ],
