  "keyFindings": {
    "laboratory": [
      "Elevated FSH and LH (hypergonadotropic hypogonadism)",
      "Low estradiol",
      "Thyroid function tests (annual screening for hypothyroidism)",
      "Fasting glucose and lipid panel (metabolic surveillance)",
      "Liver function tests (elevated in some patients)"
    ],
    "imaging": [
      "Echocardiography and cardiac MRI (bicuspid aortic valve, coarctation, aortic dilation)",
      "Renal ultrasound (horseshoe kidney, duplicated collecting system)",
      "Bone age X-ray (delayed)",
      "Pelvic ultrasound (streak gonads)",
      "Aortic imaging with MRI at regular intervals throughout life"
    ],
    "genetic": [
      "Karyotype: 45,X (classic, ~50%)",
      "Mosaicism: 45,X/46,XX (~30%)",
      "Structural X abnormalities: isochromosome Xq, ring X, partial deletions (~20%)",
      "SHOX gene haploinsufficiency accounts for short stature",
      "Y chromosome material should be checked (risk of gonadoblastoma if present)"
    ],
    "other": [
      "Audiometry (sensorineural and/or conductive hearing loss)",
      "Bone density assessment (osteoporosis risk)",
      "Neuropsychological assessment (nonverbal learning difficulties, visuospatial processing)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "noonan-syndrome",
      "distinguishingFeatures": [
        "Noonan syndrome has normal karyotype",
        "Affects both sexes",
        "RAS-MAPK pathway gene mutations (PTPN11, RAF1, etc.)",
        "Pulmonary stenosis more common than left-sided heart defects"
      ]
    },
    {
      "diseaseId": "constitutional-growth-delay",
      "distinguishingFeatures": [
        "Normal karyotype",
        "Delayed bone age with catch-up growth",
        "No dysmorphic features",
        "Normal puberty (just delayed)"
      ]
    },
    {
      "diseaseId": "premature-ovarian-insufficiency",
      "distinguishingFeatures": [
        "Normal karyotype",
        "Normal height",
        "Various etiologies (autoimmune, FMR1 premutation, iatrogenic)"
      ]
    }
  ],
  "redFlags": [
    "Aortic root dilation requiring surgical intervention",
    "Aortic dissection (medical emergency, especially in pregnancy)",
    "Severe hypertension",
    "Y chromosome material on karyotype (gonadoblastoma risk; prophylactic gonadectomy indicated)",
    "Pregnancy (very high cardiovascular risk; requires specialized monitoring)"
  ],
