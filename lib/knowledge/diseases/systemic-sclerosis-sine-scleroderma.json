  "diagnosticCriteria": {
    "formalCriteriaName": "2013 ACR/EULAR Classification Criteria for Systemic Sclerosis (adapted)",
    "criteria": [
      {
        "id": "internal-organ-involvement",
        "description": "Presence of internal organ involvement consistent with systemic sclerosis (e.g., interstitial lung disease, pulmonary arterial hypertension, renal crisis, gastrointestinal dysmotility)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-skin-thickening",
        "description": "Absence of clinically detectable skin thickening or sclerosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoantibodies",
        "description": "Presence of systemic sclerosis-specific autoantibodies (e.g., anti-centromere, anti-topoisomerase I, anti-RNA polymerase III)",
        "category": "minor",
        "requiredForDiagnosis": true
      },
      {
        "id": "nailfold-capillaroscopy",
        "description": "Abnormal nailfold capillaroscopy findings typical of systemic sclerosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Internal organ involvement consistent with systemic sclerosis plus presence of systemic sclerosis-specific autoantibodies in the absence of skin thickening",
    "notes": "Diagnosis requires exclusion of other causes of internal organ fibrosis and vasculopathy."
  },
