        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "variable-phenotype",
        "description": "Variable clinical presentation including mild to moderate dysmorphic features and neuropsychiatric manifestations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of 22q11.2 duplication by genetic testing is required; clinical features support diagnosis but are variable and not mandatory.",
    "notes": "Phenotypic variability is high; some individuals may be asymptomatic carriers."
