  "diagnosticCriteria": {
    "formalCriteriaName": "Temple-Baraitser Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Severe intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-or-hypoplastic-thumb-nails",
        "description": "Absent or hypoplastic thumb nails",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hallux-hypertrophy",
        "description": "Marked hallux (great toe) hypertrophy with broad distal phalanx",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epilepsy",
        "description": "Early-onset epilepsy or seizures",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including broad nasal bridge and prominent philtrum",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe intellectual disability plus absent or hypoplastic thumb nails and hallux hypertrophy",
    "notes": "Molecular confirmation by identification of pathogenic variants in the KCNH1 gene supports diagnosis"
  },
