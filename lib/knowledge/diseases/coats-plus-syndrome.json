  "keyFindings": {
    "laboratory": [
      "Cytopenias including anemia, leukopenia, thrombocytopenia",
      "Shortened telomere length on flow-FISH or qPCR"
    ],
    "imaging": [
      "Bilateral intracranial calcifications on CT or MRI",
      "Retinal fluorescein angiography showing telangiectasia and exudates",
      "Skeletal X-rays showing metaphyseal dysplasia"
    ],
    "genetic": [
      "Pathogenic biallelic mutations in CTC1 gene",
      "Mutations in other telomere maintenance genes (rare)"
    ],
    "other": [
      "Bone marrow biopsy showing hypocellularity or aplasia",
      "Liver biopsy indicating fibrosis in some cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "coats-disease",
      "distinguishingFeatures": [
        "Unilateral retinal telangiectasia without systemic features",
        "Absence of brain calcifications and bone marrow failure"
      ]
    },
    {
      "diseaseId": "dyskeratosis-congenita",
      "distinguishingFeatures": [
        "Classic triad of nail dystrophy, skin pigmentation, and oral leukoplakia",
        "Telomere shortening with bone marrow failure but lacks retinal telangiectasia"
      ]
    },
    {
      "diseaseId": "leukoencephalopathy-with-calcifications-and-cysts",
      "distinguishingFeatures": [
        "Presence of brain cysts in addition to calcifications",
        "No retinal involvement or bone marrow failure"
      ]
    }
  ],
