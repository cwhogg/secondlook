  "keyFindings": {
    "laboratory": [
      "Normal inflammatory markers (ESR, CRP)",
      "Normal calcium and phosphate levels"
    ],
    "imaging": [
      "Multiple symmetric, well-defined sclerotic lesions in epiphyseal and metaphyseal regions on X-ray",
      "Bone scintigraphy typically normal or mildly increased uptake",
      "CT and MRI show dense bone islands without marrow replacement"
    ],
    "genetic": [
      "LEMD3 (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Family history consistent with autosomal dominant inheritance"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "osteopathia-striata",
      "distinguishingFeatures": [
        "Linear striated sclerotic lesions rather than round or ovoid spots",
        "Different radiographic pattern"
      ]
    },
    {
      "diseaseId": "melorheostosis",
      "distinguishingFeatures": [
        "Flowing hyperostosis resembling dripping candle wax on X-ray",
        "Usually unilateral and segmental involvement"
      ]
    },
    {
      "diseaseId": "metastatic-bone-disease",
      "distinguishingFeatures": [
        "Asymmetric lesions with clinical signs of malignancy",
        "Elevated tumor markers and systemic symptoms"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive bone pain or swelling",
    "Presence of systemic symptoms such as weight loss or fever",
    "Unusual lesion morphology or asymmetry suggesting malignancy"
  ],
