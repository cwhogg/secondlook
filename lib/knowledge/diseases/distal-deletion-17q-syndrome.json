  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests except possible hypothyroidism markers",
      "Metabolic screening typically unremarkable"
    ],
    "imaging": [
      "Brain MRI may show nonspecific cerebral atrophy or delayed myelination",
      "Echocardiography reveals congenital heart defects",
      "Skeletal X-rays demonstrate clinodactyly or scoliosis"
    ],
    "genetic": [
      "Confirmed terminal or interstitial deletion of distal 17q by karyotyping, FISH, or microarray",
      "Deletion size and breakpoints vary among patients"
    ],
    "other": [
      "Developmental assessments confirm intellectual disability",
      "Audiological testing may reveal hearing loss"
    ]
  },
