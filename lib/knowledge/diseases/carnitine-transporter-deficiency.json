  "keyFindings": {
    "laboratory": [
      "Low plasma free carnitine concentration",
      "Hypoketotic hypoglycemia during metabolic crises",
      "Elevated creatine kinase during rhabdomyolysis episodes"
    ],
    "imaging": [
      "Echocardiography showing cardiomyopathy",
      "MRI or ultrasound showing hepatomegaly or hepatic steatosis"
    ],
    "genetic": [
      "Pathogenic variants in SLC22A5 gene encoding OCTN2 transporter",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Reduced carnitine uptake in cultured fibroblasts",
      "Improvement of symptoms with carnitine supplementation"
    ]
  },
  "differentialDiagnoses": [
