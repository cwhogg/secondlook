  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (CK) levels",
      "Normal or mildly elevated liver enzymes"
    ],
    "imaging": [
      "Muscle MRI showing fatty replacement and muscle atrophy predominantly in pelvic and shoulder girdle muscles",
      "Echocardiography may reveal cardiac involvement"
    ],
    "genetic": [
      "SGCG (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy demonstrating dystrophic changes and absent or reduced gamma-sarcoglycan protein by immunohistochemistry",
      "Electromyography showing myopathic pattern"
    ]
  },
