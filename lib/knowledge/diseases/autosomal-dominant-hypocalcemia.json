  "keyFindings": {
    "laboratory": [
      "Low serum calcium levels",
      "Low or inappropriately normal serum parathyroid hormone (PTH)",
      "Elevated urinary calcium excretion (hypercalciuria)",
      "Normal to low serum magnesium"
    ],
    "imaging": [
      "Basal ganglia calcifications on brain CT or MRI",
      "Nephrocalcinosis on renal ultrasound or CT",
      "Chondrocalcinosis on joint imaging"
    ],
    "genetic": [
      "CASR (causative, gain-of-function)",
      "GNA11 (causative, gain-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Family history consistent with autosomal dominant inheritance"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hypoparathyroidism",
      "distinguishingFeatures": [
        "Low serum calcium with low PTH but absence of hypercalciuria",
        "No activating CaSR mutations",
        "Often post-surgical or autoimmune etiology"
      ]
    },
    {
      "diseaseId": "pseudohypoparathyroidism",
      "distinguishingFeatures": [
        "Hypocalcemia with elevated PTH levels",
        "Resistance to PTH action rather than deficiency",
        "Characteristic physical features in some subtypes"
      ]
    }
  ],
  "redFlags": [
    "Severe hypocalcemic tetany or seizures",
    "Nephrocalcinosis leading to renal impairment",
    "Basal ganglia calcifications with neurological symptoms"
  ],
