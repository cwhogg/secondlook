  "keyFindings": {
    "laboratory": [
      "Cellular hypersensitivity to UV light in fibroblast cultures",
      "Elevated DNA repair synthesis assays showing defective nucleotide excision repair"
    ],
    "imaging": [
      "MRI showing cerebral and cerebellar atrophy",
      "Skeletal X-rays revealing osteopenia and bone dysplasia"
    ],
    "genetic": [
      "ERCC5 (causative)",
      "ERCC4 (causative)",
      "ERCC2 (causative)",
      "ERCC3 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Abnormal photosensitivity testing",
      "Neurophysiological studies showing sensorineural hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "xeroderma-pigmentosum",
      "distinguishingFeatures": [
        "Predominant skin photosensitivity without severe neurodegeneration",
        "Later onset or absence of growth failure",
        "Different mutation spectrum primarily affecting DNA repair genes without Cockayne features"
      ]
    },
    {
      "diseaseId": "cockayne-syndrome",
      "distinguishingFeatures": [
        "Severe neurodegeneration and growth failure without marked photosensitivity",
        "Lack of early-onset skin cancers",
        "Distinct genetic mutations primarily in CSA or CSB genes"
      ]
    }
  ],
  "redFlags": [
    "Early onset severe photosensitivity with poikiloderma",
    "Progressive neurodegeneration and developmental delay in infancy",
    "Confirmed defective nucleotide excision repair on molecular or cellular testing"
  ],
