  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Hemihyperplasia-Multiple Lipomatosis Syndrome",
    "criteria": [
      {
        "id": "hemihyperplasia",
        "description": "Unilateral or asymmetric overgrowth of one or more body parts (hemihyperplasia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multiple-lipomas",
        "description": "Presence of multiple benign subcutaneous lipomas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-malignancy",
        "description": "No evidence of malignant tumors or other overgrowth syndromes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-confirmation",
        "description": "Imaging evidence supporting asymmetric tissue overgrowth and lipoma distribution",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hemihyperplasia and multiple lipomas with exclusion of other overgrowth syndromes",
    "notes": "Diagnosis is clinical and supported by imaging; genetic testing may be inconclusive."
  },
