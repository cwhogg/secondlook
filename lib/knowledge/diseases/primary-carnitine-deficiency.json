  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Primary Carnitine Deficiency",
    "criteria": [
      {
        "id": "low-plasma-carnitine",
        "description": "Persistently low plasma free carnitine levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the SLC22A5 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical symptoms such as hypoketotic hypoglycemia, muscle weakness, or cardiomyopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-carnitine-transport",
        "description": "Demonstration of defective carnitine transport in fibroblasts or lymphocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-carnitine-supplementation",
        "description": "Clinical and biochemical improvement with carnitine supplementation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of low plasma carnitine, clinical features consistent with the disorder, and genetic confirmation of SLC22A5 mutations",
    "notes": "Newborn screening may detect low carnitine levels; confirmatory testing is essential."
  },
