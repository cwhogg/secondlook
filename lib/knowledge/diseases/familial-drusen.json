  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Drusen Diagnostic Criteria",
    "criteria": [
      {
        "id": "fundus-drusen",
        "description": "Presence of multiple drusen deposits in the macular region detected by fundoscopic examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of drusen or macular degeneration consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-confirmation",
        "description": "Confirmation of drusen deposits by optical coherence tomography (OCT) or fluorescein angiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "visual-acuity",
        "description": "Mild to moderate reduction in visual acuity or metamorphopsia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple macular drusen deposits confirmed by imaging plus a positive family history",
    "notes": "Genetic testing may support diagnosis but is not routinely required."
  },
