  "diagnosticCriteria": {
    "formalCriteriaName": "STXBP1-DEE Diagnostic Criteria",
    "criteria": [
      {
        "id": "pathogenic-stxbp1-variant",
        "description": "Presence of a heterozygous pathogenic or likely pathogenic variant in STXBP1 gene (confirmed by molecular genetic testing)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset-epilepsy",
        "description": "Onset of epilepsy (seizures) within the first year of life, typically before 12 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability, present from infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-secondary-causes",
        "description": "Exclusion of acquired or metabolic causes of encephalopathy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "movement-disorder",
        "description": "Presence of movement disorder (e.g., ataxia, dystonia, tremor)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met. Minor criteria are supportive but not required.",
    "notes": "Diagnosis is confirmed by molecular genetic testing. Clinical presentation is variable but typically includes early-onset epilepsy and developmental delay."
  },
