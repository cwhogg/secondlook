  "keyFindings": {
    "laboratory": [
      "Routine laboratory studies are typically normal",
      "EEG showing characteristic pattern: high-amplitude 2-3 Hz slow waves, often most prominent posteriorly",
      "Rhythmic theta activity (4-6 Hz) over frontal regions"
    ],
    "imaging": [
      "Brain MRI typically normal or nonspecific (mild cortical atrophy or cerebellar changes in some)",
      "MRI may show myelination delay in infancy"
    ],
    "genetic": [
      "DNA methylation analysis at 15q11-q13 (first-line test; detects deletions, UPD, and some imprinting defects)",
      "Maternal deletion of 15q11-q13 (~70%, detected by FISH/microarray)",
      "Paternal uniparental disomy 15 (~3-5%)",
      "Imprinting center defect (~3-5%)",
      "UBE3A gene mutation (~10-15%, requires gene sequencing)",
      "~10% clinically diagnosed but no molecular abnormality found"
    ],
    "other": [
      "Developmental assessment showing severe delays",
      "Behavioral assessment",
      "Video-EEG monitoring for seizure characterization"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "prader-willi-syndrome",
      "distinguishingFeatures": [
        "PWS involves paternal 15q11-q13 (not maternal)",
        "Hyperphagia and obesity are hallmarks of PWS",
        "Hypotonia in infancy but no seizures typically",
        "Different behavioral phenotype (stubbornness rather than happy demeanor)"
      ]
    },
    {
      "diseaseId": "rett-syndrome",
      "distinguishingFeatures": [
        "Rett shows regression after period of normal development",
        "Hand-wringing stereotypies (different from hand-flapping)",
        "MECP2 mutations",
        "Almost exclusively female"
      ]
    },
    {
      "diseaseId": "pitt-hopkins-syndrome",
      "distinguishingFeatures": [
        "TCF4 mutations",
        "Episodic hyperventilation",
        "Distinctive facial features (deep-set eyes, wide mouth)",
        "Overlap in happy affect and absent speech"
      ]
    },
    {
      "diseaseId": "mowat-wilson-syndrome",
      "distinguishingFeatures": [
        "ZEB2 mutations",
        "Hirschsprung disease frequently associated",
        "Distinctive facial features",
        "Also has happy demeanor but different pattern"
      ]
    }
  ],
  "redFlags": [
    "Refractory seizures requiring aggressive anticonvulsant management",
    "Status epilepticus (medical emergency)",
    "Severe sleep disturbance impacting quality of life",
    "Progressive scoliosis requiring surgical intervention",
    "Recurrence risk counseling critical (depends on genetic mechanism)"
  ],
