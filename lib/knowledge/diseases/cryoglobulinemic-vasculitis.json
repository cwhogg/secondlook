  "keyFindings": {
    "laboratory": [
      "Serum cryoglobulins positive (must be collected at 37C and processed appropriately)",
      "Low C4 complement (often very low; disproportionate to C3)",
      "Rheumatoid factor positive (often high titer)",
      "Hepatitis C antibody and HCV RNA positive (70-90%)",
      "Elevated liver transaminases",
      "Monoclonal IgM kappa on immunofixation (Type II)",
      "Elevated ESR"
    ],
    "imaging": [
      "Renal ultrasound: normal or slightly enlarged kidneys",
      "Chest CT: if pulmonary involvement suspected",
      "Nerve conduction studies: axonal sensorimotor neuropathy"
    ],
    "genetic": [
      "No strong single-gene associations",
      "HLA-DR11 reported in some populations"
    ],
    "other": [
      "Skin biopsy: leukocytoclastic vasculitis with intraluminal cryoglobulin deposits",
      "Renal biopsy: type I membranoproliferative glomerulonephritis with subendothelial deposits, intraluminal thrombi",
      "Nerve biopsy: epineural vasculitis, axonal degeneration"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "iga-vasculitis",
      "distinguishingFeatures": [
        "IgA deposits on biopsy",
        "Younger patients (children)",
        "Abdominal pain and joint symptoms predominate",
