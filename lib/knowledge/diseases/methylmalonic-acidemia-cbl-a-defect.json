  "diagnosticCriteria": {
    "formalCriteriaName": "Biochemical and Genetic Diagnostic Criteria for MMA cblA Defect",
    "criteria": [
      {
        "id": "elevated-methylmalonic-acid",
        "description": "Elevated methylmalonic acid levels in plasma and/or urine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "reduced-methylmalonyl-coa-mutase-activity",
        "description": "Reduced activity of methylmalonyl-CoA mutase enzyme in cultured fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mmab-gene-mutation",
        "description": "Identification of pathogenic mutations in the MMAB gene (cblA gene)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical features consistent with methylmalonic acidemia such as metabolic acidosis and neurological symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated methylmalonic acid plus either reduced enzyme activity or pathogenic MMAB gene mutations",
    "notes": "Genetic confirmation is considered definitive; biochemical testing is essential for initial diagnosis."
  },
