  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed criteria for Early-onset progressive encephalopathy-hearing loss-pons hypoplasia-brain atrophy syndrome",
    "criteria": [
      {
        "id": "progressive-encephalopathy",
        "description": "Progressive neurological deterioration with developmental regression or delay starting in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss confirmed by audiological testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pons-hypoplasia-brain-atrophy",
        "description": "Neuroimaging evidence of pons hypoplasia and cerebral or cerebellar brain atrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-alternative-diagnosis",
        "description": "Exclusion of other metabolic, genetic, or acquired causes of encephalopathy and hearing loss",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: progressive encephalopathy, bilateral sensorineural hearing loss, and neuroimaging showing pons hypoplasia with brain atrophy",
    "notes": "Diagnosis relies heavily on clinical presentation combined with characteristic MRI findings and exclusion of other etiologies."
  },
