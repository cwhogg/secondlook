  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for Leydig Cell Hypoplasia",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of ambiguous or female external genitalia in 46,XY individuals",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hormonal-profile",
        "description": "Low serum testosterone with elevated luteinizing hormone (LH) levels indicating Leydig cell dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of inactivating mutations in the LHCGR gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Testicular biopsy showing hypoplastic or absent Leydig cells",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical features consistent with Leydig cell dysfunction plus confirmatory hormonal profile and genetic testing identifying LHCGR mutations",
    "notes": "Diagnosis is primarily clinical and biochemical, supported by genetic confirmation."
  },
