  "diagnosticCriteria": {
    "formalCriteriaName": "INAD Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive hypotonia and developmental regression in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing cerebellar atrophy and signal abnormalities in basal ganglia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Biallelic pathogenic variants in the PLA2G6 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "axonal-spheroids",
        "description": "Presence of axonal spheroids on nerve biopsy or autopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive hypotonia and developmental regression with supportive neuroimaging and/or confirmed biallelic PLA2G6 mutations",
    "notes": "Genetic confirmation is considered definitive; nerve biopsy is rarely required."
  },
