  "keyFindings": {
    "laboratory": [
      "Elevated serum testosterone levels with impaired androgen action",
      "Elevated luteinizing hormone (LH) with normal or elevated follicle-stimulating hormone (FSH)",
      "Normal female-range estradiol levels in some cases"
    ],
    "imaging": [
      "Absent or rudimentary Müllerian structures on pelvic ultrasound or MRI",
      "Undescended testes on scrotal or abdominal ultrasound"
    ],
    "genetic": [
      "AR (causative)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Histopathology of testes may show immature seminiferous tubules",
      "Androgen receptor functional assays demonstrating reduced receptor activity"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "complete-androgen-insensitivity-syndrome",
      "distinguishingFeatures": [
        "Complete feminization of external genitalia",
