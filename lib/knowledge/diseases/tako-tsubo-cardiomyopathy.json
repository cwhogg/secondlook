  "keyFindings": {
    "laboratory": [
      "Mild to moderate elevation of cardiac troponin I or T",
      "Elevated brain natriuretic peptide (BNP) or NT-proBNP"
    ],
    "imaging": [
      "Echocardiography showing transient left ventricular apical ballooning with basal hyperkinesis",
      "Coronary angiography demonstrating absence of obstructive coronary artery disease",
      "Cardiac MRI excluding myocarditis and confirming wall motion abnormalities"
    ],
    "genetic": [
      "No known consistent genetic mutations associated"
    ],
    "other": [
      "Electrocardiogram showing ST-segment elevation or T-wave inversion",
      "Transient left ventricular systolic dysfunction reversible within days to weeks"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "acute-myocardial-infarction",
      "distinguishingFeatures": [
        "Presence of obstructive coronary artery disease on angiography",
        "Persistent wall motion abnormalities",
        "Higher and sustained troponin elevation"
      ]
    },
    {
      "diseaseId": "myocarditis",
      "distinguishingFeatures": [
        "Inflammatory infiltrates on cardiac MRI or biopsy",
        "Viral prodrome or systemic infection signs",
        "Diffuse rather than regional wall motion abnormalities"
      ]
    },
    {
      "diseaseId": "pheochromocytoma-induced-cardiomyopathy",
      "distinguishingFeatures": [
        "Elevated catecholamine levels",
        "Presence of adrenal tumor",
        "Paroxysmal hypertension and episodic symptoms"
      ]
    }
  ],
  "redFlags": [
    "Sudden onset chest pain with ST-segment elevation",
    "Signs of cardiogenic shock or hemodynamic instability",
    "Ventricular arrhythmias or syncope"
  ],
