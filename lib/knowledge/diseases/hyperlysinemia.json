      "Increased urinary lysine excretion",
      "Reduced saccharopine dehydrogenase enzyme activity"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter changes or be normal"
    ],
    "genetic": [
      "AASS (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Normal liver function tests in most cases",
      "No specific histopathological findings"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "glutaric-aciduria-type-1",
      "distinguishingFeatures": [
        "Elevated glutaric acid in urine",
        "Characteristic MRI findings with frontotemporal atrophy",
        "Different genetic mutations (GCDH gene)"
      ]
    },
    {
      "diseaseId": "hyperprolinemia",
      "distinguishingFeatures": [
        "Elevated plasma proline instead of lysine",
        "Different enzyme deficiencies (proline oxidase or pyrroline-5-carboxylate dehydrogenase)",
        "Distinct clinical features including neuropsychiatric symptoms"
      ]
    }
  ],
