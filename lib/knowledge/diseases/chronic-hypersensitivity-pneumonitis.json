  "diagnosticCriteria": {
    "formalCriteriaName": "ATS/JRS/ALAT Clinical Practice Guideline for Hypersensitivity Pneumonitis",
    "criteria": [
      {
        "id": "exposure-history",
        "description": "Documented exposure to known inciting antigen",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-pattern",
        "description": "High-resolution CT showing fibrosis with features suggestive of hypersensitivity pneumonitis (e.g., mosaic attenuation, air trapping)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Lung biopsy showing granulomatous inflammation and fibrosis consistent with hypersensitivity pneumonitis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "bronchoalveolar-lavage",
        "description": "Lymphocytosis on bronchoalveolar lavage (>20-30%)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "serum-precipitins",
        "description": "Presence of serum precipitating antibodies against suspected antigen",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of documented antigen exposure plus characteristic imaging findings; histopathology or BAL lymphocytosis supportive but not mandatory",
    "notes": "Diagnosis often requires multidisciplinary discussion integrating clinical, radiologic, and pathologic data."
  },
