        "requiredForDiagnosis": true
      },
      {
        "id": "complex-brachydactyly",
        "description": "Presence of complex brachydactyly involving multiple digits with abnormal phalangeal morphology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "foot-malformations",
        "description": "Associated foot malformations including talipes equinovarus or other positional deformities",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "limb-length-discrepancy",
        "description": "Significant limb length discrepancy due to fibular deficiency",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiographic-confirmation",
        "description": "Radiographic evidence confirming fibular aplasia and digital anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of fibular aplasia confirmed by imaging plus complex brachydactyly involving multiple digits",
    "notes": "Diagnosis is primarily clinical supported by radiographic findings; genetic testing may assist but is not definitive."
