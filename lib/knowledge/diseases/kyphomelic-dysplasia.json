  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Kyphomelic Dysplasia",
    "criteria": [
      {
        "id": "kyphosis",
        "description": "Presence of marked thoracolumbar kyphosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-shortening",
        "description": "Severe shortening of the proximal and middle segments of limbs (rhizomelic and mesomelic shortening)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-abnormalities",
        "description": "Characteristic radiographic findings including platyspondyly and metaphyseal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-features",
        "description": "Mild facial dysmorphism including midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Prenatal and postnatal growth retardation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of thoracolumbar kyphosis, limb shortening, and characteristic radiological abnormalities",
    "notes": "Genetic testing may confirm diagnosis but is not always available."
  },
