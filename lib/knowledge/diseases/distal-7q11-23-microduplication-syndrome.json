    "formalCriteriaName": "Distal 7q11.23 Microduplication Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of microduplication at distal 7q11.23 region confirmed by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "speech-delay",
        "description": "Significant speech and language delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-features",
        "description": "Behavioral abnormalities including anxiety or autistic features",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Mild facial dysmorphic features such as broad forehead and bulbous nasal tip",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of distal 7q11.23 microduplication plus presence of developmental delay and speech delay",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support but are variable."
