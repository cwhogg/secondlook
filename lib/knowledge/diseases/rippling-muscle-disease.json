  "diagnosticCriteria": {
    "formalCriteriaName": "Rippling Muscle Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "muscle-rippling",
        "description": "Visible rippling waves on muscle percussion or stretch",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-stiffness",
        "description": "Muscle stiffness and delayed relaxation after contraction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyographic evidence of myopathic changes without myotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in CAV3 or related genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (muscle rippling and muscle stiffness) with supportive electromyography or genetic testing",
    "notes": "Diagnosis is clinical supported by EMG and genetic testing; muscle biopsy may show nonspecific myopathic changes."
  },
