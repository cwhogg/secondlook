  "keyFindings": {
    "laboratory": [
      "Immunofixation electrophoresis showing monoclonal truncated gamma-heavy chains",
      "Bone marrow biopsy with lymphoplasmacytic infiltration",
      "Anemia and elevated ESR"
    ],
    "imaging": [
      "CT or ultrasound showing lymphadenopathy and hepatosplenomegaly",
      "Skeletal survey may show lytic lesions"
    ],
    "genetic": [
      "No specific genetic mutation identified; clonal B-cell proliferation"
    ],
    "other": [
      "Urine protein electrophoresis positive for gamma-heavy chains",
      "Flow cytometry of bone marrow or lymph node biopsy showing clonal B-cell population"
    ]
  },
