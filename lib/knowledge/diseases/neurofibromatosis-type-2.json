  "keyFindings": {
    "laboratory": [
      "Routine labs typically normal",
      "Audiometry showing sensorineural hearing loss (often asymmetric initially)"
    ],
    "imaging": [
      "MRI brain with gadolinium: bilateral enhancing vestibular schwannomas",
      "MRI brain: meningiomas (convexity, skull base, or posterior fossa)",
      "MRI whole spine: schwannomas, meningiomas, ependymomas",
      "Whole-body MRI for tumor surveillance"
    ],
    "genetic": [
      "NF2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Slit-lamp examination for posterior subcapsular cataracts",
      "Ophthalmologic exam for epiretinal membranes and retinal hamartomas",
      "Brainstem auditory evoked responses (BAER)",
      "Vestibular function testing"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "schwannomatosis",
      "distinguishingFeatures": [
        "No vestibular schwannomas (or unilateral only with no other NF2 criteria)",
        "SMARCB1 or LZTR1 mutations",
        "Pain is predominant symptom",
        "Later onset typically"
      ]
    },
    {
      "diseaseId": "neurofibromatosis-type-1",
      "distinguishingFeatures": [
        "NF1 has cafe-au-lait macules and neurofibromas, not schwannomas",
        "Lisch nodules present in NF1",
        "No bilateral VS in NF1",
        "NF1 gene on chromosome 17"
      ]
    },
    {
      "diseaseId": "sporadic-vestibular-schwannoma",
      "distinguishingFeatures": [
        "Unilateral only",
        "No family history",
        "No other NF2-associated tumors",
        "Older age at presentation (typically >50 years)"
      ]
    },
    {
      "diseaseId": "meningiomatosis",
      "distinguishingFeatures": [
        "Multiple meningiomas without schwannomas",
        "No vestibular tumors",
        "Different genetic basis"
      ]
    }
  ],
  "redFlags": [
    "Sudden hearing loss (tumor hemorrhage or rapid growth)",
    "Signs of brainstem compression from large vestibular schwannomas",
    "Spinal cord compression from spinal tumors",
    "Rapid tumor growth suggesting malignant transformation",
    "Young child with unilateral vestibular schwannoma (consider mosaic NF2)"
  ],
