  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible elevated lactate in some cases"
    ],
    "imaging": [
      "MRI brain may show nonspecific cerebral atrophy or delayed myelination"
    ],
    "genetic": [
      "Mutations in MECP2 gene on X chromosome detected in >90% of classic cases"
    ],
    "other": [
      "EEG abnormalities consistent with epilepsy",
      "Polysomnography may show breathing irregularities"
    ]
  },
