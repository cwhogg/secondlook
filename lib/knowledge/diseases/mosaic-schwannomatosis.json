  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Mosaic Schwannomatosis",
    "criteria": [
      {
        "id": "criterion-1",
        "description": "Presence of multiple schwannomas confined to a single body segment or region",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-2",
        "description": "Absence of vestibular schwannomas on MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-3",
        "description": "Mosaic or segmental distribution of schwannomas confirmed by clinical and radiological assessment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-4",
        "description": "Histopathological confirmation of schwannoma from at least one lesion",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "criterion-5",
        "description": "Exclusion of NF2 and generalized schwannomatosis by genetic testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple schwannomas limited to one body segment without vestibular schwannomas and confirmed mosaic distribution",
    "notes": "Genetic testing is recommended to exclude NF2 and generalized schwannomatosis."
  },
