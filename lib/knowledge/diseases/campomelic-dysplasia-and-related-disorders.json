  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; genetic testing revealing SOX9 mutations"
    ],
    "imaging": [
      "Radiographs showing bowed long bones, hypoplastic pelvis, and 11 pairs of ribs",
      "MRI or CT may reveal laryngeal and tracheal abnormalities"
    ],
    "genetic": [
      "Heterozygous pathogenic variants in SOX9 gene on chromosome 17q24"
    ],
    "other": [
      "Prenatal ultrasound may detect bowed limbs and polyhydramnios",
      "Laryngoscopy may confirm laryngeal hypoplasia"
    ]
  },
