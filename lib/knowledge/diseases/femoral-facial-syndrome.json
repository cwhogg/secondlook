  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Femoral-Facial Syndrome",
    "criteria": [
      {
        "id": "femoral-hypoplasia",
        "description": "Bilateral femoral hypoplasia or aplasia with shortened lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including micrognathia, cleft palate, and short nose with anteverted nostrils",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genitourinary-anomalies",
        "description": "Presence of genitourinary malformations such as renal hypoplasia or cryptorchidism",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "vertebral-anomalies",
        "description": "Vertebral segmentation defects or scoliosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "prenatal-history",
        "description": "Prenatal history of oligohydramnios or intrauterine growth restriction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral femoral hypoplasia and characteristic facial dysmorphism",
    "notes": "Diagnosis is primarily clinical supported by imaging and exclusion of other syndromes."
  },
