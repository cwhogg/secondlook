  "diagnosticCriteria": {
    "formalCriteriaName": "International Headache Society Diagnostic Criteria for Burning Mouth Syndrome",
    "criteria": [
      {
        "id": "persistent-burning",
        "description": "Persistent burning sensation in the oral mucosa for more than 4-6 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-clinical-exam",
        "description": "Normal clinical oral mucosa without visible lesions or signs of local disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of local and systemic causes of oral burning such as candidiasis, nutritional deficiencies, or diabetes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "symptom-diurnal-variation",
        "description": "Symptoms often worsen throughout the day",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "associated-dysgeusia",
        "description": "Presence of altered taste sensation (dysgeusia)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent oral burning sensation for >4-6 months with normal oral mucosa and exclusion of other causes",
    "notes": "Diagnosis is primarily clinical and by exclusion; no definitive laboratory or imaging test confirms BMS."
  },
