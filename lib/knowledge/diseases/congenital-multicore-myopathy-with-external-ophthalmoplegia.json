  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Congenital Multicore Myopathy with External Ophthalmoplegia",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Muscle biopsy demonstrating multiple cores on oxidative enzyme staining",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "external-ophthalmoplegia",
        "description": "Presence of external ophthalmoplegia with limited eye movements",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with multicore myopathy (e.g., SEPN1, RYR1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-myopathy",
        "description": "Congenital or early-onset muscle weakness predominantly affecting axial and proximal muscles",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-involvement",
        "description": "Evidence of restrictive respiratory insufficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of muscle biopsy showing multicore lesions plus clinical evidence of external ophthalmoplegia and genetic confirmation of pathogenic variants",
    "notes": "Diagnosis requires integration of clinical, histopathological, and genetic data."
  },
