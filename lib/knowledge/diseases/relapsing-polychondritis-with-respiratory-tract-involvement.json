  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (ESR, CRP)",
      "Normocytic anemia",
      "Negative or low-titer autoantibodies (ANA, RF often negative)"
    ],
    "imaging": [
      "CT chest showing thickening and calcification of tracheal and bronchial walls",
      "Bronchoscopy revealing airway collapse and inflammation",
      "MRI or PET scan may show cartilage inflammation"
    ],
