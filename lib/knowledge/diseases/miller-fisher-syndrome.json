  "keyFindings": {
    "laboratory": [
      "Presence of anti-GQ1b IgG antibodies in serum",
      "Elevated cerebrospinal fluid protein with normal cell count (albuminocytologic dissociation)"
    ],
    "imaging": [
      "Typically normal brain MRI; used to exclude alternative diagnoses"
    ],
    "genetic": [
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Nerve conduction studies may show demyelinating features",
      "Electromyography may show reduced motor nerve conduction velocities"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "guillain-barre-syndrome",
      "distinguishingFeatures": [
        "Predominant limb weakness rather than ophthalmoplegia",
        "More frequent limb areflexia without prominent ataxia",
        "Less common anti-GQ1b antibodies"
      ]
    },
    {
      "diseaseId": "botulism",
      "distinguishingFeatures": [
        "Descending symmetrical paralysis",
        "Pupillary involvement with dilated fixed pupils",
        "History of ingestion of contaminated food or wound infection"
      ]
    },
    {
      "diseaseId": "myasthenia-gravis",
      "distinguishingFeatures": [
        "Fluctuating muscle weakness worsening with activity",
        "Positive acetylcholine receptor antibodies",
        "Absence of areflexia and ataxia"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of respiratory muscle weakness",
    "Development of bulbar palsy with airway compromise",
    "Loss of consciousness or altered mental status"
  ],
