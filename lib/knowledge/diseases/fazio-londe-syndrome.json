  "keyFindings": {
    "laboratory": [
      "Normal sensory nerve conduction studies",
      "Elevated creatine kinase in some cases"
    ],
    "imaging": [
      "MRI brain typically normal or nonspecific",
      "No structural abnormalities in bulbar region"
    ],
    "genetic": [
      "Mutations in SLC52A3 gene (riboflavin transporter deficiency)",
      "Other related gene mutations (e.g., SLC52A2)"
    ],
    "other": [
      "Electromyography showing denervation and motor neuron loss",
      "Absence of sensory nerve involvement"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "juvenile-amyotrophic-lateral-sclerosis",
      "distinguishingFeatures": [
        "Involvement of both upper and lower motor neurons",
        "Possible sensory involvement absent",
        "Later onset compared to Fazio-Londe"
      ]
    },
    {
      "diseaseId": "brown-vialetto-van-laere-syndrome",
      "distinguishingFeatures": [
        "Similar bulbar palsy with sensorineural deafness",
        "Associated with riboflavin transporter mutations",
        "Hearing loss distinguishes from Fazio-Londe"
      ]
    }
  ],
  "redFlags": [
