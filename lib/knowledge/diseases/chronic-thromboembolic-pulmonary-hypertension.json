  "diagnosticCriteria": {
    "formalCriteriaName": "European Society of Cardiology/European Respiratory Society Guidelines for CTEPH",
    "criteria": [
      {
        "id": "persistent-pulmonary-hypertension",
        "description": "Mean pulmonary arterial pressure ≥25 mmHg at rest measured by right heart catheterization",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chronic-thromboembolic-obstruction",
        "description": "Presence of mismatched perfusion defects on ventilation/perfusion lung scan or evidence of chronic thromboembolic obstruction on pulmonary angiography or CT pulmonary angiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of pulmonary hypertension such as left heart disease or lung diseases",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "symptoms-compatible",
        "description": "Symptoms consistent with pulmonary hypertension such as exertional dyspnea and fatigue",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent pulmonary hypertension with evidence of chronic thromboembolic obstruction and exclusion of other causes",
    "notes": "Right heart catheterization is mandatory for definitive diagnosis."
  },
