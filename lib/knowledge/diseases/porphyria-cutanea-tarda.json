  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and biochemical criteria for porphyria cutanea tarda",
    "criteria": [
      {
        "id": "pct-c1",
        "description": "Elevated urinary uroporphyrins and heptacarboxylporphyrins with characteristic predominance of uroporphyrin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pct-c2",
        "description": "Elevated plasma porphyrins with characteristic fluorescence emission peak at ~619 nm",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pct-c3",
        "description": "Elevated isocoproporphyrins in feces (pathognomonic for UROD deficiency)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pct-c4",
        "description": "Characteristic skin lesions on sun-exposed areas (blisters, erosions, milia, scarring, hypertrichosis)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pct-c5",
        "description": "Reduced hepatic UROD enzyme activity (<20% of normal)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "pct-c6",
        "description": "Presence of susceptibility factors (hepatitis C, alcohol, estrogen, iron overload, HIV)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Characteristic skin findings plus elevated urinary uroporphyrins with isocoproporphyrins in feces. Type II (familial) confirmed by UROD gene mutation.",
    "notes": "Type I (sporadic, ~75-80%) has no UROD mutation; Type II (familial, ~20%) has autosomal dominant UROD mutation; Type III (familial, rare) clusters in families without UROD mutation."
  },
