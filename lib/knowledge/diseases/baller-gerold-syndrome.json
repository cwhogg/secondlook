  "diagnosticCriteria": {
    "formalCriteriaName": "Baller-Gerold Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of cranial sutures (craniosynostosis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radial-aplasia",
        "description": "Radial ray defects including aplasia or hypoplasia of the radius",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recql4-mutation",
        "description": "Pathogenic mutation in the RECQL4 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis and radial ray defects with confirmation of RECQL4 gene mutation",
    "notes": "Diagnosis is clinical and genetic; exclusion of other syndromes with overlapping features is essential."
  },
