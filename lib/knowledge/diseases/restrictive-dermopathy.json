      ]
    },
    {
      "diseaseId": "congenital-contractural-arachnodactyly",
      "distinguishingFeatures": [
        "Marfanoid habitus with arachnodactyly",
        "Absence of taut, rigid skin and characteristic facial dysmorphism"
      ]
    },
    {
      "diseaseId": "harlequin-ichthyosis",
