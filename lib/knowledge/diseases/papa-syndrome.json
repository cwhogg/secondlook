  "keyFindings": {
    "laboratory": [
      "Elevated C-reactive protein (CRP) and erythrocyte sedimentation rate (ESR) during flares",
      "Sterile synovial fluid with neutrophilic predominance",
      "Mild anemia of chronic disease"
    ],
    "imaging": [
      "Radiographs showing joint effusions and osteolytic lesions",
      "MRI may show synovitis and bone marrow edema"
    ],
    "genetic": [
      "PSTPIP1 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology of skin lesions consistent with pyoderma gangrenosum"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pediatric-pyogenic-arthritis",
      "distinguishingFeatures": [
        "Infectious arthritis with positive bacterial cultures",
        "Lack of associated skin manifestations"
      ]
    },
    {
      "diseaseId": "pustular-psoriasis",
      "distinguishingFeatures": [
        "Psoriatic plaques and nail changes",
        "Absence of sterile arthritis and pyoderma gangrenosum"
      ]
    },
    {
      "diseaseId": "hidradenitis-suppurativa",
      "distinguishingFeatures": [
        "Chronic recurrent abscesses in apocrine gland-bearing areas",
        "No sterile arthritis or pyoderma gangrenosum"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive joint destruction",
    "Non-healing painful skin ulcers",
    "Signs of systemic amyloidosis (e.g., proteinuria, renal impairment)"
  ],
