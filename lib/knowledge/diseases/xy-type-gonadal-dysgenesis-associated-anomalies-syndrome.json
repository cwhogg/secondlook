  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for XY Gonadal Dysgenesis",
    "criteria": [
      {
        "id": "gonadal-streak",
        "description": "Presence of bilateral gonadal streaks without functional gonadal tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "46xy-karyotype",
        "description": "46,XY karyotype confirmed by cytogenetic analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "female-phenotype",
        "description": "Phenotypically female external genitalia with absence of secondary sexual characteristics",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-mullerian-structures",
        "description": "Absence or hypoplasia of Müllerian derivatives (uterus, upper vagina) on imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-gonadotropins",
        "description": "Elevated serum FSH and LH indicating hypergonadotropic hypogonadism",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of 46,XY karyotype, bilateral gonadal streaks, and female phenotype with absent secondary sexual characteristics",
    "notes": "Genetic testing for SRY mutations or deletions may support diagnosis"
  },
