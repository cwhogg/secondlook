  "keyFindings": {
    "laboratory": [
      "Elevated liver enzymes related to chronic alcoholism",
      "Possible vitamin B deficiency (e.g., B1, B12)"
    ],
    "imaging": [
      "MRI showing symmetrical lesions and necrosis of the corpus callosum",
      "T2-weighted hyperintensities in corpus callosum",
      "Possible involvement of adjacent white matter"
    ],
    "genetic": [
      "No known genetic mutations associated"
    ],
    "other": [
      "History of chronic alcohol abuse or severe malnutrition"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "multiple-sclerosis",
      "distinguishingFeatures": [
        "Disseminated CNS lesions in time and space",
        "Oligoclonal bands in CSF",
        "Relapsing-remitting course"
      ]
    },
    {
      "diseaseId": "central-pontine-myelinosis",
      "distinguishingFeatures": [
        "Lesions primarily in the central pons",
        "Often associated with rapid correction of hyponatremia",
        "Different MRI lesion location"
      ]
    },
    {
      "diseaseId": "wernicke-encephalopathy",
      "distinguishingFeatures": [
        "Triad of ophthalmoplegia, ataxia, and confusion",
        "Lesions in mammillary bodies and periaqueductal gray",
        "Rapid response to thiamine"
      ]
    }
  ],
