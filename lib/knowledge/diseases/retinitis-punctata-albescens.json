  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Retinitis Punctata Albescens",
    "criteria": [
      {
        "id": "white-punctate-spots",
        "description": "Presence of multiple white punctate spots scattered throughout the retina",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-night-blindness",
        "description": "Progressive nyctalopia (night blindness) starting in childhood or early adulthood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroretinogram-abnormalities",
        "description": "Electroretinogram (ERG) showing reduced rod and cone responses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "fundus-autofluorescence",
        "description": "Characteristic fundus autofluorescence pattern with hypoautofluorescent spots",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of white punctate retinal spots, progressive night blindness, and abnormal ERG findings",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory"
  },
