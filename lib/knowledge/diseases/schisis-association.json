  "diagnosticCriteria": {
    "formalCriteriaName": "Schisis Association Diagnostic Criteria",
    "criteria": [
      {
        "id": "midline-facial-schisis",
        "description": "Presence of midline facial clefts or schisis involving the lip, nose, or palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-midline-defects",
        "description": "Midline brain malformations such as corpus callosum agenesis or interhemispheric cysts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-coloboma",
        "description": "Presence of ocular coloboma affecting iris, retina, or optic nerve",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Additional craniofacial anomalies including hypertelorism or micrognathia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (midline facial schisis and brain midline defects) with or without minor criteria",
    "notes": "Diagnosis is clinical and supported by neuroimaging and ophthalmological examination."
  },
