        "requiredForDiagnosis": false
      },
      {
        "id": "lactate-elevation",
        "description": "Elevated lactate levels in blood or cerebrospinal fluid",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multisystemic clinical features plus biochemical evidence of combined respiratory chain defects and genetic confirmation of pathogenic variants",
    "notes": "Diagnosis requires integration of clinical, biochemical, and genetic data due to phenotypic heterogeneity."
