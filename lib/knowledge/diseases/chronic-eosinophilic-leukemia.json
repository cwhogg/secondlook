  "diagnosticCriteria": {
    "formalCriteriaName": "WHO 2016 Diagnostic Criteria for Chronic Eosinophilic Leukemia",
    "criteria": [
      {
        "id": "persistent-eosinophilia",
        "description": "Persistent eosinophilia with absolute eosinophil count >1.5 x 10^9/L for more than 6 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clonal-proliferation",
        "description": "Evidence of clonal eosinophilic proliferation by cytogenetic or molecular abnormalities (e.g., PDGFRA, PDGFRB, FGFR1 rearrangements)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-hypercellularity",
        "description": "Bone marrow hypercellularity with increased eosinophilic precursors and blasts <20%",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-reactive-causes",
        "description": "Exclusion of secondary/reactive causes of eosinophilia (e.g., parasitic infections, allergies)",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "organ-dysfunction",
        "description": "Presence of organ dysfunction attributable to eosinophilic infiltration",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent eosinophilia >1.5 x 10^9/L for >6 months, evidence of clonal proliferation, and bone marrow findings consistent with CEL after exclusion of reactive causes",
    "notes": "Molecular testing for PDGFRA, PDGFRB, FGFR1, and other rearrangements is critical for diagnosis and treatment planning."
  },
