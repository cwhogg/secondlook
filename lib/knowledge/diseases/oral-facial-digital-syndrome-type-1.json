  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 5,
      "peak": 1
    },
    "sexPredilection": "female",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for OFD1",
    "criteria": [
      {
        "id": "oral-malformations",
        "description": "Presence of oral cavity malformations including lobulated tongue, tongue hamartomas, cleft or pseudocleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features such as hypertelorism, broad nasal bridge, and cleft lip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digital-anomalies",
        "description": "Digital malformations including brachydactyly, syndactyly, clinodactyly, or polydactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "polycystic-kidney-disease",
        "description": "Evidence of polycystic kidney disease or renal cystic changes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "X-linked dominant inheritance pattern or family history consistent with OFD1",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (oral malformations, facial dysmorphism, and digital anomalies) with or without supportive findings",
    "notes": "Molecular genetic testing of OFD1 gene mutations can confirm diagnosis"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Lobulated tongue with hamartomas",
        "frequency": 0.85,
        "bodySystem": "otolaryngological",
        "notes": "Characteristic tongue malformations including nodules or clefts"
      },
      {
        "symptomName": "Digital malformations (brachydactyly, syndactyly, clinodactyly)",
        "frequency": 0.9,
        "bodySystem": "musculoskeletal",
        "notes": "Typical finger and toe anomalies"
      },
      {
        "symptomName": "Cleft or pseudocleft palate",
        "frequency": 0.75,
        "bodySystem": "otolaryngological",
        "notes": "Midline oral clefts common in affected individuals"
      }
    ],
    "common": [
      {
        "symptomName": "Hypertelorism",
        "frequency": 0.7,
        "bodySystem": "ophthalmological",
        "notes": "Increased distance between the eyes"
      },
      {
        "symptomName": "Broad nasal bridge",
        "frequency": 0.65,
        "bodySystem": "constitutional",
        "notes": "Characteristic facial dysmorphism"
      },
      {
        "symptomName": "Polycystic kidney disease",
        "frequency": 0.6,
        "bodySystem": "renal",
        "notes": "Renal cysts often develop in childhood or adolescence"
      },
      {
        "symptomName": "Nasal alar hypoplasia",
        "frequency": 0.55,
        "bodySystem": "constitutional",
        "notes": "Underdevelopment of nasal alae"
      },
      {
        "symptomName": "Dental anomalies (missing teeth, enamel hypoplasia)",
        "frequency": 0.58,
        "bodySystem": "otolaryngological",
        "notes": "Common dental abnormalities"
      }
    ],
    "occasional": [
      {
        "symptomName": "Hirsutism",
        "frequency": 0.3,
        "bodySystem": "dermatological",
        "notes": "Excessive hair growth in females"
      },
      {
        "symptomName": "Renal insufficiency",
        "frequency": 0.25,
        "bodySystem": "renal",
        "notes": "Progressive kidney dysfunction in some cases"
      },
      {
        "symptomName": "Hearing loss",
        "frequency": 0.15,
        "bodySystem": "otolaryngological",
        "notes": "Sensorineural or conductive hearing impairment"
      },
      {
        "symptomName": "Nasal speech",
        "frequency": 0.4,
        "bodySystem": "otolaryngological",
        "notes": "Due to palatal abnormalities"
      },
      {
        "symptomName": "Mild intellectual disability",
        "frequency": 0.12,
        "bodySystem": "neurological",
        "notes": "Reported in a minority of cases"
      }
    ],
    "rare": [
      {
        "symptomName": "Brain malformations (e.g., agenesis of corpus callosum)",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Occasional CNS structural anomalies"
      },
      {
        "symptomName": "Cardiac defects",
        "frequency": 0.03,
        "bodySystem": "cardiovascular",
        "notes": "Rare congenital heart anomalies reported"
      },
      {
        "symptomName": "Polydactyly",
        "frequency": 0.07,
        "bodySystem": "musculoskeletal",
        "notes": "Extra digits less common than other digital anomalies"
      }
    ]
  },
