  "diagnosticCriteria": {
    "formalCriteriaName": "SCID Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in IL7R gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphocyte-subset-analysis",
        "description": "Severe T-cell lymphopenia with normal or elevated B-cell counts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Recurrent severe infections presenting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunoglobulin-levels",
        "description": "Normal or low immunoglobulin levels with absent T-cell function",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic IL7R mutations plus severe T-cell lymphopenia with clinical features of SCID",
    "notes": "Diagnosis is confirmed by genetic testing and immunophenotyping; newborn screening may detect T-cell lymphopenia early."
  },
