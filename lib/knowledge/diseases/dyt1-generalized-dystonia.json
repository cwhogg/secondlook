  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Brain MRI typically normal or may show subtle basal ganglia abnormalities",
      "Functional imaging (PET/SPECT) may show altered basal ganglia activity"
    ],
    "genetic": [
      "Pathogenic ΔGAG deletion mutation in the TOR1A gene on chromosome 9q34"
    ],
    "other": [
      "Electromyography (EMG) may show co-contraction of antagonist muscles during dystonic movements"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dyt6-dystonia",
      "distinguishingFeatures": [
        "Later age of onset",
        "Mutations in the THAP1 gene",
        "More frequent cranial involvement early in disease"
      ]
    },
    {
      "diseaseId": "dopa-responsive-dystonia",
      "distinguishingFeatures": [
        "Marked improvement with levodopa therapy",
        "Usually presents with diurnal fluctuation",
        "GCH1 gene mutations"
      ]
    },
    {
      "diseaseId": "secondary-dystonia",
      "distinguishingFeatures": [
        "History of drug exposure or brain injury",
        "Imaging evidence of structural lesions",
        "Absence of TOR1A mutation"
      ]
    }
  ],
  "redFlags": [
