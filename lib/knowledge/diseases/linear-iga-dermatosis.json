  "diagnosticCriteria": {
    "formalCriteriaName": "Linear IgA Dermatosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "linear-iga-deposition",
        "description": "Linear deposition of IgA at the basement membrane zone on direct immunofluorescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "subepidermal-blister",
        "description": "Presence of subepidermal blister with neutrophilic infiltrate on histopathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Characteristic tense vesicles and bullae arranged in annular or grouped patterns",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "negative-bp180-bp230",
        "description": "Negative or low titers of BP180 and BP230 antibodies to exclude bullous pemphigoid",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (linear IgA deposition, subepidermal blister with neutrophils, and characteristic clinical presentation) must be met",
    "notes": "Direct immunofluorescence is essential for diagnosis; differentiation from other autoimmune blistering diseases is critical"
  },
