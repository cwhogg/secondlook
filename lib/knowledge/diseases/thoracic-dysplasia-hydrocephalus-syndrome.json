  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Thoracic Dysplasia-Hydrocephalus Syndrome",
    "criteria": [
      {
        "id": "short-rib-dysplasia",
        "description": "Presence of markedly shortened ribs causing a narrow thorax",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hydrocephalus",
        "description": "Ventriculomegaly or hydrocephalus detected clinically or by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "polydactyly",
        "description": "Postaxial polydactyly of hands and/or feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-limbs",
        "description": "Micromelia or shortening of long bones",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-cystic-disease",
        "description": "Presence of cystic renal dysplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: short ribs with narrow thorax, hydrocephalus, and polydactyly",
    "notes": "Diagnosis is primarily clinical supported by radiological findings; genetic testing may assist but is not always definitive."
  },
