  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for CPT I Deficiency",
    "criteria": [
      {
        "id": "hypoketotic-hypoglycemia",
        "description": "Episodes of hypoketotic hypoglycemia during fasting or illness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-free-carnitine",
        "description": "Elevated plasma free carnitine with low acylcarnitine species on tandem mass spectrometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cpt1a-genetic-testing",
        "description": "Identification of pathogenic variants in the CPT1A gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-dysfunction",
        "description": "Evidence of liver dysfunction or hepatomegaly during metabolic crises",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "enzyme-activity-assay",
        "description": "Reduced CPT I enzyme activity in liver or fibroblast assays",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypoketotic hypoglycemia episodes plus either confirmatory biochemical profile or pathogenic CPT1A gene variants",
    "notes": "Genetic testing is considered the gold standard for definitive diagnosis."
  },
