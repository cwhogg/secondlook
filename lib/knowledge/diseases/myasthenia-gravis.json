  "diagnosticCriteria": {
    "formalCriteriaName": "MGFA Clinical Classification",
    "criteria": [
      {
        "id": "mg-1",
        "description": "Fluctuating weakness of voluntary muscles that worsens with activity and improves with rest",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mg-2",
        "description": "Positive acetylcholine receptor (AChR) antibodies",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "mg-3",
        "description": "Positive muscle-specific kinase (MuSK) antibodies",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "mg-4",
        "description": "Decremental response (>10%) on repetitive nerve stimulation at 2-3 Hz",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "mg-5",
        "description": "Increased jitter on single-fiber EMG",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "mg-6",
        "description": "Positive response to acetylcholinesterase inhibitor (edrophonium/ice pack test)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical picture of fatigable weakness plus at least one confirmatory test (antibodies, RNS, or SFEMG)",
    "notes": "Seronegative MG (~10-15%) lacks AChR and MuSK antibodies but has compatible clinical and electrophysiological findings. LRP4 antibodies may be present in some seronegative patients."
  },
