  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific biochemical markers"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter abnormalities or cortical dysplasia",
      "Echocardiogram to identify congenital heart defects"
    ],
    "genetic": [
      "Heterozygous microdeletion at chromosome 16p13.11 detected by chromosomal microarray analysis or FISH",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Neuropsychological testing revealing cognitive impairment or developmental delays"
    ]
  },
