  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Autosomal Recessive Dopa-Responsive Dystonia",
    "criteria": [
      {
        "id": "early-onset-dystonia",
        "description": "Onset of dystonia symptoms typically in childhood or early adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dramatic-dopa-response",
        "description": "Marked and sustained clinical improvement with low-dose levodopa therapy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biallelic-gch1-or-tyrosine-hydroxylase-mutation",
        "description": "Identification of pathogenic biallelic mutations in GCH1 or tyrosine hydroxylase genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-parkinsonism",
        "description": "Lack of typical parkinsonian features such as resting tremor or bradykinesia in early disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-neuroimaging",
        "description": "Brain MRI typically normal or nonspecific",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset dystonia with dramatic response to levodopa and confirmation of biallelic pathogenic mutations",
    "notes": "Genetic testing is essential to confirm diagnosis; levodopa responsiveness is a key clinical hallmark."
  },
