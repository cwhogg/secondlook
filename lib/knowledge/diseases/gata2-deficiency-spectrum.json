  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for GATA2 Deficiency",
    "criteria": [
      {
        "id": "heterozygous-gata2-mutation",
        "description": "Identification of a heterozygous pathogenic or likely pathogenic variant in the GATA2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "monocytopenia",
        "description": "Persistent peripheral blood monocytopenia (<0.2 x10^9/L)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of at least one characteristic clinical feature such as recurrent infections, lymphedema, or myelodysplastic syndrome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of GATA2 deficiency or related hematological/immunological disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "bone-marrow-abnormalities",
        "description": "Bone marrow dysplasia or hypocellularity consistent with GATA2 deficiency",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of a heterozygous pathogenic GATA2 variant plus either persistent monocytopenia or characteristic clinical features",
    "notes": "Diagnosis is confirmed by genetic testing; clinical and laboratory findings support diagnosis and guide management."
  },
