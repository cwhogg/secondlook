  "diagnosticCriteria": {
    "formalCriteriaName": "Nijmegen Breakage Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Congenital microcephaly with progressive growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Combined immunodeficiency with low T and B lymphocyte counts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chromosomal-instability",
        "description": "Increased chromosomal breakage and rearrangements on cytogenetic analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent nose, receding mandible, and sloping forehead",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "NBN-mutation",
        "description": "Biallelic pathogenic variants in the NBN gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of congenital microcephaly, immunodeficiency, chromosomal instability, and biallelic NBN mutations",
    "notes": "Diagnosis is confirmed by molecular genetic testing and cytogenetic studies demonstrating chromosomal instability."
  },
