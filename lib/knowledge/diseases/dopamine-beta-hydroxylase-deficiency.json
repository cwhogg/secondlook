  "diagnosticCriteria": {
    "formalCriteriaName": "No formal named criteria",
    "criteria": [
      {
        "id": "biochemical-profile",
        "description": "Elevated plasma dopamine with low or undetectable norepinephrine and epinephrine levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of severe orthostatic hypotension and ptosis from infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the DBH gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-treatment",
        "description": "Improvement of symptoms with L-threo-3,4-dihydroxyphenylserine (L-DOPS) therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic biochemical profile plus clinical features and confirmation by genetic testing",
    "notes": "Diagnosis relies heavily on biochemical and genetic confirmation due to overlap with other autonomic disorders."
  },
