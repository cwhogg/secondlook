  "keyFindings": {
    "laboratory": [
      "Normal routine labs; no specific biochemical markers"
    ],
    "imaging": [
      "Skeletal X-rays showing limb abnormalities",
      "Brain MRI may show structural abnormalities"
    ],
    "genetic": [
      "Pathogenic variants in NIPBL, SMC1A, SMC3, RAD21, HDAC8 genes"
    ],
    "other": [
      "Prenatal ultrasound may detect limb abnormalities and growth retardation"
    ]
  },
  "differentialDiagnoses": [
