        "Absent or severely reduced lymphocytes"
      ]
    },
    {
      "diseaseId": "leukocyte-adhesion-deficiency",
      "distinguishingFeatures": [
        "Delayed umbilical cord separation",
        "Marked leukocytosis without pus formation",
        "Defective leukocyte migration"
      ]
    }
  ],
  "redFlags": [
