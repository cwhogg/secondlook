  "keyFindings": {
    "laboratory": [
      "Peripheral blood smear showing stomatocytes",
      "Elevated reticulocyte count",
      "Elevated lactate dehydrogenase (LDH)",
      "Decreased haptoglobin",
      "Elevated indirect bilirubin"
    ],
    "imaging": [
      "Ultrasound showing splenomegaly",
      "Ultrasound or CT showing gallstones"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Increased RBC membrane permeability to Na+ and K+ ions demonstrated by specialized ion flux assays"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hereditary-spherocytosis",
      "distinguishingFeatures": [
        "Presence of spherocytes instead of stomatocytes on blood smear",
        "Negative ion permeability abnormalities",
        "Different genetic mutations (ANK1, SPTB, SPTA1)"
      ]
    },
    {
      "diseaseId": "hereditary-elliptocytosis",
      "distinguishingFeatures": [
        "Elliptical or oval-shaped erythrocytes on blood smear",
        "Usually no increased membrane permeability",
        "Different clinical presentation and genetic mutations"
      ]
    }
  ],
  "redFlags": [
    "Severe anemia requiring transfusions",
    "Splenic sequestration crisis",
    "Thrombotic events especially post-splenectomy"
  ],
