  "diagnosticCriteria": {
    "formalCriteriaName": "ALPS Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-lymphadenopathy",
        "description": "Chronic (>6 months), nonmalignant lymphadenopathy and/or splenomegaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-dnt-cells",
        "description": "Elevated peripheral blood double-negative T cells (CD3+ TCRαβ+ CD4- CD8-)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "defective-lymphocyte-apoptosis",
        "description": "Defective lymphocyte apoptosis demonstrated by in vitro assays",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoimmune-cytopenias",
        "description": "Presence of autoimmune cytopenias (e.g., autoimmune hemolytic anemia, thrombocytopenia)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history of ALPS or related lymphoproliferative disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria or two major criteria plus one minor criterion",
    "notes": "Genetic testing for FAS, FASLG, or CASP10 mutations supports diagnosis but is not mandatory."
  },
