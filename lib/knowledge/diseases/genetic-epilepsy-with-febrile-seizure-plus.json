  "diagnosticCriteria": {
    "formalCriteriaName": "GEFS+ Diagnostic Criteria",
    "criteria": [
      {
        "id": "febrile-seizures",
        "description": "Presence of febrile seizures persisting beyond typical age or with atypical features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "afebrile-seizures",
        "description": "Occurrence of afebrile generalized or focal seizures in affected family members",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of febrile seizures or epilepsy consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes such as SCN1A, SCN1B, or GABRG2",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of febrile seizures plus afebrile seizures in the patient or family members with supportive family history",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory; clinical presentation and family history are key."
  },
