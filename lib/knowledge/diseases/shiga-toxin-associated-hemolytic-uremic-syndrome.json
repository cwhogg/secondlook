  "keyFindings": {
    "laboratory": [
      "Schistocytes on peripheral blood smear",
      "Elevated lactate dehydrogenase (LDH)",
      "Reduced haptoglobin",
      "Elevated serum creatinine and blood urea nitrogen (BUN)",
      "Thrombocytopenia",
      "Positive stool culture or PCR for Shiga toxin-producing E. coli"
    ],
    "imaging": [
      "Renal ultrasound showing normal or enlarged kidneys",
      "Brain MRI or CT in cases with neurological symptoms to exclude other causes"
    ],
    "genetic": [
      "No primary genetic mutations associated; primarily acquired condition"
    ],
    "other": [
      "Urinalysis showing hematuria and proteinuria",
      "Elevated blood pressure readings"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "atypical-hemolytic-uremic-syndrome",
      "distinguishingFeatures": [
        "Lack of preceding diarrheal illness",
        "Complement system dysregulation",
        "Poor response to supportive care alone"
      ]
    },
    {
      "diseaseId": "thrombotic-thrombocytopenic-purpura",
      "distinguishingFeatures": [
        "Severe ADAMTS13 deficiency",
        "Prominent neurological symptoms early",
        "Less severe renal impairment compared to HUS"
      ]
    }
  ],
