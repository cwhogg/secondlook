        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurodevelopmental-impairment",
        "description": "Presence of global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "movement-disorders",
        "description": "Presence of movement abnormalities such as ataxia, dystonia, or tremor",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "abnormal-eeg",
        "description": "Electroencephalogram showing epileptiform activity or hypsarrhythmia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic STXBP1 mutation plus early-onset epilepsy and neurodevelopmental impairment",
    "notes": "Diagnosis requires genetic confirmation; clinical features support diagnosis and guide management."
