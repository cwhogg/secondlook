  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Müllerian Aplasia with Hyperandrogenism",
    "criteria": [
      {
        "id": "absent-uterus-vagina",
        "description": "Congenital absence or severe hypoplasia of the uterus and upper two-thirds of the vagina confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-hyperandrogenism",
        "description": "Clinical signs of hyperandrogenism including hirsutism, acne, or androgenic alopecia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-serum-androgens",
        "description": "Biochemical evidence of elevated serum androgens such as testosterone or DHEAS",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-46xx-karyotype",
        "description": "Normal female karyotype (46,XX) excluding chromosomal abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-ovarian-pathology",
        "description": "No evidence of ovarian tumors or adrenal pathology causing androgen excess",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital absence of uterus and upper vagina plus clinical and biochemical evidence of hyperandrogenism in a 46,XX female",
    "notes": "Diagnosis requires exclusion of androgen-secreting tumors and chromosomal abnormalities."
  },
