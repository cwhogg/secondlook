    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of pathogenic germline mutation in SDHB, SDHC, SDHD, or other SDHx genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multiple-tumors",
        "description": "Presence of multiple paragangliomas and/or pheochromocytomas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "First-degree relative with paraganglioma or pheochromocytoma",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "early-onset",
        "description": "Diagnosis of paraganglioma or pheochromocytoma before age 40",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic SDHx mutation plus at least one paraganglioma or pheochromocytoma tumor",
    "notes": "Genetic testing is critical for confirmation; clinical presentation may vary depending on specific SDHx mutation."
