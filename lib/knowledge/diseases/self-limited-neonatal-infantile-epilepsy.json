  "diagnosticCriteria": {
    "formalCriteriaName": "Self-limited Neonatal-Infantile Epilepsy Diagnostic Criteria",
    "criteria": [
      {
        "id": "age-onset",
        "description": "Seizure onset within the neonatal or early infantile period (0-12 months)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizure-type",
        "description": "Presence of focal or generalized seizures with characteristic electroclinical features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-development",
        "description": "Normal neurodevelopmental status prior to and following seizure remission",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroencephalogram",
        "description": "EEG showing age-appropriate background with epileptiform discharges during seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizure-remission",
        "description": "Spontaneous remission of seizures typically within the first year of life",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Seizure onset in neonatal or early infantile period with characteristic seizure types and normal neurodevelopment, supported by EEG findings and spontaneous remission.",
    "notes": "Diagnosis is clinical and supported by EEG; genetic testing may be informative but is not required."
  },
