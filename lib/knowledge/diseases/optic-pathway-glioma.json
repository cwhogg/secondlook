  "keyFindings": {
    "laboratory": [
      "No specific laboratory biomarkers; CSF analysis typically non-diagnostic"
    ],
    "imaging": [
      "MRI showing fusiform enlargement of optic nerve with T1 hypointensity and T2 hyperintensity",
      "Contrast enhancement of optic pathway lesions",
      "Possible involvement of optic chiasm and hypothalamus"
    ],
    "genetic": [
      "Association with NF1 gene mutations in Neurofibromatosis type 1 patients"
    ],
    "other": [
      "Visual evoked potentials may show delayed conduction",
      "Fundoscopic examination revealing optic disc pallor or swelling"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "optic-neuritis",
      "distinguishingFeatures": [
        "Acute onset with pain on eye movement",
        "Typically unilateral",
        "MRI shows optic nerve inflammation without mass lesion"
      ]
    },
    {
      "diseaseId": "optic-nerve-menigioma",
      "distinguishingFeatures": [
        "Usually occurs in middle-aged adults",
        "MRI shows dural-based enhancing mass",
        "Slower progression and different histology"
      ]
    },
    {
      "diseaseId": "leukemic-infiltration-of-optic-nerve",
      "distinguishingFeatures": [
        "History of leukemia",
        "CSF abnormalities",
        "Diffuse optic nerve swelling without discrete mass"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive vision loss",
    "New onset endocrine abnormalities (e.g., precocious puberty, hypothyroidism)",
    "Signs of increased intracranial pressure such as persistent headache and vomiting"
  ],
