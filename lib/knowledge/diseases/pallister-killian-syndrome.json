  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible hypothyroidism on thyroid function tests"
    ],
    "imaging": [
      "Chest X-ray may reveal diaphragmatic hernia",
      "Brain MRI may show delayed myelination and cerebral atrophy",
      "Echocardiogram may detect cardiac defects"
    ],
    "genetic": [
      "Mosaic tetrasomy 12p detected by karyotyping or FISH",
      "Array CGH or SNP microarray may identify extra 12p material",
      "Skin fibroblast analysis often required due to low mosaicism in blood"
    ],
    "other": [
      "Characteristic facial features on clinical examination",
      "Hypotonia and developmental delay on neurological assessment"
    ]
  },
