  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria established",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of kaposiform spindle cell proliferation with lymphatic endothelial markers on biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Characteristic multifocal infiltrative lymphatic anomalies involving thoracic and/or abdominal structures on MRI or CT",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive respiratory symptoms with chylous effusions and coagulopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "coagulopathy",
        "description": "Laboratory evidence of consumptive coagulopathy (e.g., thrombocytopenia, hypofibrinogenemia)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation plus characteristic imaging findings and compatible clinical presentation",
    "notes": "Diagnosis often requires multidisciplinary evaluation including pathology, radiology, and clinical correlation."
  },
