  "diagnosticCriteria": {
    "formalCriteriaName": "Atypical Werner Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "progeroid-appearance",
        "description": "Characteristic premature aging phenotype including scleroderma-like skin changes and loss of subcutaneous fat",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in LMNA or POLD1 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset-cataracts",
        "description": "Bilateral cataracts developing before age 40",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "metabolic-abnormalities",
        "description": "Presence of insulin resistance or type 2 diabetes mellitus",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-classic-Werner-features",
        "description": "Lack of WRN gene mutations differentiating from classical Werner syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progeroid phenotype plus genetic confirmation of LMNA or POLD1 mutation",
    "notes": "Diagnosis requires exclusion of classical Werner syndrome and other progeroid syndromes"
  },
