  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Congenital Myasthenic Syndromes",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of fatigable muscle weakness with onset in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electrophysiological evidence of impaired neuromuscular transmission including decremental response on repetitive nerve stimulation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in postsynaptic neuromuscular junction genes (e.g., CHRNE, RAPSN)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-treatment",
        "description": "Improvement of symptoms with acetylcholinesterase inhibitors or other targeted therapies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-autoimmune",
        "description": "Absence of autoantibodies against acetylcholine receptor or muscle-specific kinase",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus electrophysiological evidence and pathogenic genetic variant in a postsynaptic CMS gene",
    "notes": "Genetic confirmation is critical for definitive diagnosis and treatment guidance."
  },
