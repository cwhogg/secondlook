  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Congenital Muscular Dystrophy with Cerebellar Involvement",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early onset hypotonia and muscle weakness with delayed motor milestones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-abnormalities",
        "description": "Neuroimaging evidence of cerebellar hypoplasia or cerebellar vermis abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes consistent with congenital muscular dystrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with CMD and cerebellar involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "EMG findings consistent with myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early onset hypotonia and muscle weakness, cerebellar abnormalities on neuroimaging, and dystrophic muscle biopsy findings",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if clinical and pathological criteria are met."
  },
