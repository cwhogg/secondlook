  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Esophageal Atresia",
    "criteria": [
      {
        "id": "polyhydramnios",
        "description": "Prenatal ultrasound showing polyhydramnios and absent or small stomach bubble",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "inability-to-pass-nasogastric-tube",
        "description": "Inability to pass a nasogastric tube into the stomach shortly after birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chest-xray-confirmation",
        "description": "Chest and abdominal X-ray showing coiling of nasogastric tube in the upper esophageal pouch",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Clinical signs such as excessive salivation, choking, coughing, and cyanosis during feeding",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of inability to pass nasogastric tube combined with radiological confirmation of esophageal discontinuity",
    "notes": "Diagnosis is often confirmed shortly after birth; prenatal suspicion may arise from ultrasound findings."
  },
