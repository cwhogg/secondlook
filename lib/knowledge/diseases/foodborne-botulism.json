  "differentialDiagnoses": [
    {
      "diseaseId": "guillain-barre-syndrome",
      "distinguishingFeatures": [
        "Ascending paralysis rather than descending",
        "Presence of sensory symptoms",
        "Elevated cerebrospinal fluid protein with normal cell count"
      ]
    },
    {
      "diseaseId": "myasthenia-gravis",
      "distinguishingFeatures": [
        "Fluctuating muscle weakness worsened by activity",
        "Presence of acetylcholine receptor antibodies",
        "Improvement with acetylcholinesterase inhibitors"
      ]
    },
