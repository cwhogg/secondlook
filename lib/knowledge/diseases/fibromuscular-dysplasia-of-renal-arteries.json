  "keyFindings": {
    "laboratory": [
      "Elevated plasma renin activity",
      "Secondary hyperaldosteronism",
      "Normal inflammatory markers"
    ],
    "imaging": [
      "Catheter-based renal angiography showing 'string of beads' pattern",
      "CT angiography or MR angiography demonstrating multifocal stenosis",
      "Duplex Doppler ultrasound showing elevated renal artery velocities"
    ],
    "genetic": [
      "No definitive genetic mutation identified; familial cases reported but rare"
    ],
    "other": [
      "Absence of atherosclerotic plaques on imaging",
      "Possible association with other fibromuscular dysplasia in carotid or vertebral arteries"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "atherosclerotic-renal-artery-stenosis",
      "distinguishingFeatures": [
        "Older age at onset",
        "Presence of atherosclerotic risk factors",
        "Plaque formation on imaging rather than 'string of beads'"
      ]
    },
    {
      "diseaseId": "vasculitis-of-renal-arteries",
      "distinguishingFeatures": [
        "Elevated inflammatory markers",
        "Systemic symptoms such as fever and weight loss",
        "Histological evidence of vessel inflammation"
      ]
    },
    {
      "diseaseId": "renal-artery-embolism",
      "distinguishingFeatures": [
        "Sudden onset flank pain",
        "Imaging showing abrupt vessel occlusion",
        "Underlying embolic source such as atrial fibrillation"
      ]
    }
  ],
  "redFlags": [
    "Severe or resistant hypertension in young patient",
    "Sudden onset of flank pain with hematuria",
    "Flash pulmonary edema without cardiac cause"
  ],
