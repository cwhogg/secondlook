  "diagnosticCriteria": {
    "formalCriteriaName": "Metachromatic Leukodystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of arylsulfatase A enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive psychomotor regression with onset before 3 years of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "Characteristic symmetric demyelination of cerebral white matter on MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the ARSA gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus enzyme deficiency and characteristic neuroimaging findings",
    "notes": "Genetic testing supports diagnosis but is not mandatory if enzyme assay and clinical features are conclusive."
  },
