  "diagnosticCriteria": {
    "formalCriteriaName": "Naxos Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "arrhythmogenic-right-ventricular-dysplasia",
        "description": "Presence of arrhythmogenic right ventricular dysplasia confirmed by imaging or histology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "palmoplantar-keratoderma",
        "description": "Diffuse palmoplantar keratoderma manifesting in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "woolly-hair",
        "description": "Congenital woolly hair present from birth or early infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of Naxos disease or sudden cardiac death",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "electrocardiographic-abnormalities",
        "description": "ECG abnormalities consistent with ARVD such as epsilon waves or T wave inversions in right precordial leads",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: arrhythmogenic right ventricular dysplasia, palmoplantar keratoderma, and woolly hair",
    "notes": "Genetic testing for plakoglobin mutations can support diagnosis"
  },
