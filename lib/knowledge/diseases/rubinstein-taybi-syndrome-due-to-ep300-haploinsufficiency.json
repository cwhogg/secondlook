  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Rubinstein-Taybi Syndrome",
    "criteria": [
      {
        "id": "broad-thumb-hallux",
        "description": "Presence of broad and angulated thumbs and halluces",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial features including downslanting palpebral fissures, prominent nasal bridge, and grimacing smile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variant or haploinsufficiency in EP300 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cryptorchidism",
        "description": "Cryptorchidism in males",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical diagnosis requires presence of broad thumbs/halluces, characteristic facial features, intellectual disability, and confirmation of EP300 haploinsufficiency by genetic testing.",
    "notes": "EP300-related Rubinstein-Taybi syndrome may present with milder phenotype compared to CREBBP-related cases."
  },
