        "Absence of telangiectasias",
        "Later onset of symptoms",
        "Different genetic mutation (FXN gene)"
      ]
    },
    {
      "diseaseId": "ataxia-ocular-apraxia-type-1",
      "distinguishingFeatures": [
        "Presence of ocular apraxia without telangiectasias",
        "Normal immunological profile",
        "Different genetic cause (APTX gene)"
      ]
    }
  ],
