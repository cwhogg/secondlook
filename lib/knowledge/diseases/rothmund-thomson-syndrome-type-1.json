  "diagnosticCriteria": {
    "formalCriteriaName": "Rothmund-Thomson syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "poikiloderma",
        "description": "Early-onset poikiloderma with facial erythema and telangiectasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal abnormalities including radial ray defects and absent or hypoplastic thumbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "juvenile-cataracts",
        "description": "Juvenile cataracts or other ophthalmological abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Growth retardation and short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Pathogenic variants in RECQL4 gene (type 2) absent in type 1; diagnosis of type 1 based on clinical features and exclusion of RECQL4 mutations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset poikiloderma plus at least one major skeletal abnormality",
    "notes": "Genetic testing differentiates type 1 from type 2; type 1 lacks RECQL4 mutations."
  },
