  "differentialDiagnoses": [
    {
      "diseaseId": "gitelman-syndrome",
      "distinguishingFeatures": [
        "Hypomagnesemia with hypocalciuria (not hypercalciuria)",
        "Metabolic alkalosis with hypokalemia",
        "No nephrocalcinosis"
      ]
    },
    {
      "diseaseId": "bartter-syndrome",
      "distinguishingFeatures": [
        "Hypokalemia and metabolic alkalosis",
        "Normal or low magnesium levels",
        "No significant nephrocalcinosis"
      ]
    },
    {
      "diseaseId": "primary-hyperparathyroidism",
      "distinguishingFeatures": [
        "Hypercalcemia with hypercalciuria",
        "Elevated parathyroid hormone levels",
        "No hypomagnesemia"
      ]
    }
  ],
