  "differentialDiagnoses": [
    {
      "diseaseId": "semilobar-holoprosencephaly",
      "distinguishingFeatures": [
        "Partial separation of cerebral hemispheres",
        "Less severe facial anomalies",
        "Presence of some interhemispheric fissure"
      ]
    },
    {
      "diseaseId": "lobar-holoprosencephaly",
      "distinguishingFeatures": [
        "Nearly complete separation of hemispheres",
        "Milder facial anomalies",
        "Presence of corpus callosum"
      ]
    },
    {
      "diseaseId": "hydranencephaly",
      "distinguishingFeatures": [
        "Absence of cerebral hemispheres replaced by CSF",
        "Preserved falx cerebri",
        "No midline facial anomalies typical of HPE"
      ]
    }
  ],
