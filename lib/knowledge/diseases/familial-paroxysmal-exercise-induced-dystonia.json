  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible low cerebrospinal fluid glucose during episodes"
    ],
    "imaging": [
      "Normal brain MRI",
      "No structural abnormalities detected"
    ],
    "genetic": [
      "SALL4 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Normal interictal neurological examination",
      "Electromyography during episodes may show dystonic muscle activity"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "paroxysmal-kinesigenic-dyskinesia",
      "distinguishingFeatures": [
        "Episodes triggered by sudden movement rather than prolonged exercise",
        "Shorter duration of attacks (seconds to minutes)",
        "Responds well to anticonvulsants like carbamazepine"
      ]
    },
    {
      "diseaseId": "dopa-responsive-dystonia",
      "distinguishingFeatures": [
        "Improvement with low-dose levodopa",
        "Onset in childhood with diurnal fluctuation",
        "Not exclusively triggered by exercise"
      ]
    }
  ],
  "redFlags": [
    "Progressive neurological deficits between episodes",
    "Seizure activity during dystonic episodes",
    "Lack of family history in suspected cases"
  ],
