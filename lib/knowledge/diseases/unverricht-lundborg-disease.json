      },
      {
        "symptomName": "Generalized tonic-clonic seizures",
        "frequency": 0.85,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Progressive action myoclonus",
        "frequency": 0.75,
        "bodySystem": "neurological",
        "notes": "Worsens with voluntary movement"
      }
    ],
    "common": [
