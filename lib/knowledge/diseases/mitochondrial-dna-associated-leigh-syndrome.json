  "diagnosticCriteria": {
    "formalCriteriaName": "Leigh Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-neurological",
        "description": "Progressive neurological deterioration with motor and cognitive regression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Bilateral symmetric lesions in basal ganglia and/or brainstem on MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mitochondrial DNA mutations associated with Leigh syndrome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-lactate",
        "description": "Elevated lactate levels in blood and/or cerebrospinal fluid",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Necrotizing lesions in brain tissue biopsy consistent with Leigh syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive neurological symptoms plus characteristic MRI findings and confirmation of pathogenic mitochondrial DNA mutation",
    "notes": "Diagnosis is supported by biochemical and histopathological findings but primarily relies on clinical, imaging, and genetic data."
  },
