  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Epidermolysis Bullosa Simplex with Circinate Migratory Erythema",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of recurrent blistering on the palms and soles with circinate migratory erythematous plaques",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing intraepidermal cleavage with basal keratinocyte cytolysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in KRT5 or KRT14 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Immunofluorescence showing reduced or altered keratin 5/14 expression",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus either histopathology or genetic testing confirming mutation",
    "notes": "Diagnosis is confirmed by genetic testing; histopathology and immunofluorescence are supportive."
  },
