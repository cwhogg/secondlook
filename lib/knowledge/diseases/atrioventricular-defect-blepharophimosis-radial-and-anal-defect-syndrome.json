        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "blepharophimosis",
        "description": "Bilateral blepharophimosis characterized by narrowed horizontal palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radial-defects",
        "description": "Radial ray anomalies including hypoplasia or aplasia of the radius or thumb abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anal-defects",
        "description": "Anorectal malformations such as anal stenosis or imperforate anus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Additional facial features including telecanthus and ptosis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of atrioventricular septal defect, blepharophimosis, radial ray anomaly, and anal malformation",
    "notes": "Diagnosis is clinical and supported by cardiac imaging and physical examination"
  },
