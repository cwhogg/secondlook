  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Adult-onset Nemaline Myopathy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness with onset in adulthood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Presence of nemaline rods on muscle biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Myopathic changes on electromyography",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in genes associated with nemaline myopathy (e.g., NEB, ACTA1)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive adult-onset proximal muscle weakness plus demonstration of nemaline rods on muscle biopsy",
    "notes": "Genetic testing can support diagnosis but is not mandatory; electromyography findings are supportive."
  },
