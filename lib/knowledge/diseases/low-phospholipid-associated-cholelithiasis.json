  "keyFindings": {
    "laboratory": [
      "Mildly elevated liver transaminases (ALT, AST)",
      "Elevated alkaline phosphatase and gamma-glutamyl transferase (GGT)",
      "Normal or mildly elevated bilirubin unless obstruction present"
    ],
    "imaging": [
      "Ultrasound showing intrahepatic biliary sludge or microlithiasis",
      "Magnetic resonance cholangiopancreatography (MRCP) revealing intrahepatic stones",
      "Absence of gallbladder stones post-cholecystectomy with persistent symptoms"
    ],
    "genetic": [
      "ABCB4 (causative, loss-of-function)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Response to ursodeoxycholic acid therapy",
      "Family history of gallstone disease"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "common-cholelithiasis",
      "distinguishingFeatures": [
        "Gallstones primarily in gallbladder rather than intrahepatic bile ducts",
