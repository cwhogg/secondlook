  "diagnosticCriteria": {
    "formalCriteriaName": "No formalized diagnostic criteria established",
    "criteria": [
      {
        "id": "imaging-confirmation",
        "description": "Demonstration of anomalous origin of right or left pulmonary artery arising directly from the ascending aorta on echocardiography, CT angiography, or cardiac MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of signs of pulmonary overcirculation or heart failure in neonate or infant",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-cardiac-anomalies",
        "description": "Exclusion of other complex congenital heart defects that could explain pulmonary artery abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Imaging confirmation of anomalous pulmonary artery origin plus clinical signs consistent with pulmonary overcirculation or heart failure",
    "notes": "Diagnosis is primarily based on imaging modalities; early detection is critical for management."
  },
