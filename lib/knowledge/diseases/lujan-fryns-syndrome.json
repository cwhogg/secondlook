  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Lujan-Fryns Syndrome",
    "criteria": [
      {
        "id": "marfanoid-habitus",
        "description": "Presence of marfanoid habitus including tall stature, long limbs, and arachnodactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including long narrow face, prominent nasal bridge, and high nasal root",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-problems",
        "description": "Behavioral abnormalities such as hyperactivity and autistic-like features",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-abnormalities",
        "description": "Presence of cardiac anomalies such as mitral valve prolapse",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of marfanoid habitus, intellectual disability, and characteristic facial dysmorphism",
    "notes": "Genetic testing for MED12 mutations can support diagnosis but is not always conclusive."
  },
