  "diagnosticCriteria": {
    "formalCriteriaName": "Comprehensive Diagnostic Criteria for IgG4-Related Disease",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of characteristic retro-orbital mass or swelling with symptoms of orbital inflammation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serum-igg4-levels",
        "description": "Elevated serum IgG4 concentration (>135 mg/dL)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Biopsy showing dense lymphoplasmacytic infiltrate rich in IgG4-positive plasma cells, storiform fibrosis, and obliterative phlebitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Imaging (MRI or CT) demonstrating retro-orbital soft tissue mass or fibrosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-steroids",
        "description": "Clinical improvement following corticosteroid therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical presentation, elevated serum IgG4, and characteristic histopathology) must be met for definitive diagnosis",
    "notes": "Exclusion of malignancy and other inflammatory conditions is essential"
  },
