  "keyFindings": {
    "laboratory": [
      "Elevated liver transaminases (AST, ALT)",
      "Increased bilirubin levels",
      "Prolonged prothrombin time",
      "Thrombocytopenia"
    ],
    "imaging": [
      "Doppler ultrasound showing hepatic vein thrombosis or absent flow",
      "CT or MRI demonstrating hepatic vein or IVC obstruction",
      "Venography confirming venous outflow obstruction"
    ],
    "genetic": [
      "MYH11 (candidate)"
    ],
    "other": [
      "Liver biopsy showing centrilobular congestion and fibrosis",
      "Evidence of underlying myeloproliferative disorders or hypercoagulable states"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "portal-vein-thrombosis",
      "distinguishingFeatures": [
        "Thrombosis localized to portal vein rather than hepatic veins",
        "Less prominent hepatomegaly",
        "Different imaging findings on Doppler ultrasound"
      ]
    },
    {
      "diseaseId": "congestive-hepatopathy",
      "distinguishingFeatures": [
        "Secondary to right heart failure",
        "No hepatic vein thrombosis",
        "Clinical signs of cardiac dysfunction"
      ]
    }
  ],
  "redFlags": [
