        "description": "Presence of neurological symptoms such as developmental delay or seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes involved in kynurenine pathway enzymes",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated urinary 3-hydroxykynurenine levels plus exclusion of other metabolic disorders",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory"
