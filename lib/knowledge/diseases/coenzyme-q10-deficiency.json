  "diagnosticCriteria": {
    "formalCriteriaName": "Coenzyme Q10 Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of muscle weakness, encephalopathy, or nephrotic syndrome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-assay",
        "description": "Reduced Coenzyme Q10 levels in muscle tissue or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in CoQ10 biosynthesis genes (e.g., COQ2, PDSS1)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-supplementation",
        "description": "Clinical improvement following CoQ10 supplementation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical symptoms plus reduced CoQ10 levels in tissue or fibroblasts",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory; response to supplementation is supportive."
  },
