  "diagnosticCriteria": {
    "formalCriteriaName": "Endocrine Society Clinical Practice Guideline for Primary Adrenal Insufficiency",
    "criteria": [
      {
        "id": "ad-1",
        "description": "Low morning serum cortisol (<3 mcg/dL strongly suggestive; 3-15 mcg/dL requires further testing)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ad-2",
        "description": "Elevated ACTH (>2x upper limit of normal)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ad-3",
        "description": "Subnormal cortisol response to ACTH stimulation test (peak cortisol <18 mcg/dL after 250 mcg cosyntropin)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ad-4",
        "description": "Positive 21-hydroxylase antibodies (anti-adrenal antibodies)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ad-5",
        "description": "Low serum aldosterone with elevated plasma renin activity (mineralocorticoid deficiency)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ad-6",
        "description": "Low DHEA-S",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biochemical confirmation: low cortisol (morning or stimulated) with elevated ACTH. 21-hydroxylase antibodies confirm autoimmune etiology.",
    "notes": "Autoimmune adrenalitis is the most common cause in developed countries (~80%). Must exclude infectious (TB, HIV), infiltrative, hemorrhagic, and metastatic causes."
  },
