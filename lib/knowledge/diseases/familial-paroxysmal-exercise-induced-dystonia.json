  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Familial Paroxysmal Exercise-Induced Dystonia",
    "criteria": [
      {
        "id": "exercise-triggered-dystonia",
        "description": "Recurrent episodes of dystonia triggered specifically by prolonged exercise",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-interictal-exam",
        "description": "Normal neurological examination between dystonic episodes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-causes",
        "description": "Exclusion of secondary causes of dystonia and other paroxysmal movement disorders",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent exercise-induced dystonia episodes plus positive family history and exclusion of secondary causes",
    "notes": "Genetic testing for mutations in the SLC2A1 gene may support diagnosis but is not mandatory."
  },
