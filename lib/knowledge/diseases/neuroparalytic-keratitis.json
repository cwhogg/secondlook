  "diagnosticCriteria": {
    "formalCriteriaName": "Neuroparalytic Keratitis Diagnostic Criteria",
    "criteria": [
      {
        "id": "corneal-anesthesia",
        "description": "Presence of corneal anesthesia or hypoesthesia confirmed by esthesiometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "corneal-ulceration",
        "description": "Non-healing corneal epithelial defects or ulceration without infectious etiology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "trigeminal-nerve-dysfunction",
        "description": "Evidence of trigeminal nerve dysfunction or damage by clinical history or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-infection",
        "description": "Exclusion of infectious keratitis by microbiological studies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-treatment",
        "description": "Poor response to conventional ulcer treatment and improvement with neurotrophic therapies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (corneal anesthesia, corneal ulceration without infection, and trigeminal nerve dysfunction) must be met",
    "notes": "Diagnosis requires exclusion of infectious and other causes of corneal ulceration."
  },
