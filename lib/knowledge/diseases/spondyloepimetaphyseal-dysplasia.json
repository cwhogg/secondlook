  "keyFindings": {
    "laboratory": [
      "Normal routine laboratory tests; no specific biochemical markers"
    ],
    "imaging": [
      "Platyspondyly with flattened vertebral bodies",
      "Irregular epiphyseal and metaphyseal ossification",
      "Coxa vara and other femoral deformities on X-ray"
    ],
    "genetic": [
      "Pathogenic variants in COL2A1 gene (most common)",
      "Other gene mutations related to collagen type II biosynthesis"
    ],
    "other": [
      "Clinical assessment of disproportionate short stature and joint laxity"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "achondroplasia",
      "distinguishingFeatures": [
        "Short limb dwarfism rather than short trunk",
        "Characteristic FGFR3 mutations",
        "Different radiographic features (e.g., narrowed interpedicular distances)"
      ]
    },
    {
      "diseaseId": "spondyloepiphyseal-dysplasia-congenita",
      "distinguishingFeatures": [
        "More severe spinal involvement",
        "Earlier onset with respiratory complications",
        "Distinct genetic mutations in COL2A1"
      ]
    },
    {
      "diseaseId": "metaphyseal-dysplasia",
      "distinguishingFeatures": [
        "Predominant metaphyseal abnormalities without significant spinal involvement",
        "Different radiographic patterns",
        "Usually normal stature or mild short stature"
      ]
    }
  ],
  "redFlags": [
    "Progressive neurological deficits due to spinal cord compression",
    "Severe respiratory compromise from thoracic deformity",
    "Rapidly worsening scoliosis or spinal instability"
  ],
