  "diagnosticCriteria": {
    "formalCriteriaName": "Radiologic and Clinical Diagnostic Criteria for Caroli Disease",
    "criteria": [
      {
        "id": "intrahepatic-bile-duct-dilatation",
        "description": "Segmental, saccular or fusiform dilatation of intrahepatic bile ducts demonstrated by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "central-dot-sign",
        "description": "Presence of the 'central dot sign' on imaging representing portal vein radicles within dilated ducts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Recurrent cholangitis, abdominal pain, or jaundice consistent with bile duct pathology",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic segmental intrahepatic bile duct dilatation on imaging plus either the central dot sign or compatible clinical features",
    "notes": "Diagnosis is primarily radiologic; liver biopsy may be used to exclude other conditions."
  },
