  "keyFindings": {
    "laboratory": [
      "Non-specific inflammatory markers may be mildly elevated",
      "Normal autoimmune and coagulation profiles"
    ],
    "imaging": [
      "Angiography showing segmental occlusions and corkscrew collaterals in distal arteries",
      "Doppler ultrasound demonstrating reduced blood flow in affected vessels"
    ],
    "genetic": [
      "No definitive genetic markers identified"
    ],
    "other": [
      "Strong association with tobacco use",
      "Histopathology shows segmental inflammation and thrombosis of small and medium arteries and veins"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "atherosclerosis",
      "distinguishingFeatures": [
        "Older age at onset",
        "Presence of traditional cardiovascular risk factors (hypertension, hyperlipidemia, diabetes)",
        "Diffuse arterial involvement rather than segmental"
      ]
    },
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "Positive autoimmune serologies (ANA, anti-dsDNA)",
        "Multisystem involvement including renal and hematologic",
        "Lack of strong association with tobacco use"
      ]
    },
    {
      "diseaseId": "raynaud-phenomenon",
      "distinguishingFeatures": [
        "Vasospastic episodes without occlusive arterial disease",
        "Usually no tissue necrosis or ulcerations",
        "Often associated with connective tissue diseases"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression to digital gangrene",
    "Severe rest pain refractory to analgesics",
    "Signs of critical limb ischemia (pallor, coldness, absent pulses)"
  ],
  "specialistType": [
    "Vascular Surgeon",
    "Rheumatologist",
    "Cardiologist"
  ],
