  "diagnosticCriteria": {
    "formalCriteriaName": "Hunter Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "iduronate-2-sulfatase-deficiency",
        "description": "Deficiency of iduronate-2-sulfatase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gags-urinary-excretion",
        "description": "Elevated urinary glycosaminoglycans (GAGs), particularly dermatan sulfate and heparan sulfate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pathogenic-ids-variant",
        "description": "Identification of pathogenic variant(s) in the IDS gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features including coarse facial features, hepatosplenomegaly, and joint stiffness",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of iduronate-2-sulfatase enzyme activity or identification of pathogenic IDS gene variant plus clinical features consistent with MPS II",
    "notes": "Molecular genetic testing is confirmatory and important for carrier detection and prenatal diagnosis."
  },
