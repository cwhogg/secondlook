  "keyFindings": {
    "laboratory": [
      "Normal or mildly elevated alkaline phosphatase",
      "Normal calcium and phosphate levels",
      "Mild anemia in some cases"
    ],
    "imaging": [
      "Bilateral symmetric cortical thickening of diaphyses on X-ray",
      "Endosteal and periosteal bone formation",
      "Possible cranial hyperostosis on skull imaging"
    ],
    "genetic": [
      "Pathogenic mutations in TGFB1 gene (autosomal dominant inheritance)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Electromyography may show myopathic changes",
      "Muscle biopsy may show nonspecific atrophy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ribbing-disease",
      "distinguishingFeatures": [
        "Ribbing disease typically presents with asymmetric diaphyseal involvement",
        "Usually adult onset",
        "No associated muscle weakness"
      ]
    },
    {
      "diseaseId": "osteopetrosis",
      "distinguishingFeatures": [
        "Generalized increased bone density including metaphyses and epiphyses",
        "Frequent fractures and hematological abnormalities",
        "Different genetic mutations involved"
      ]
    },
    {
      "diseaseId": "hyperostosis-frontalis-interna",
      "distinguishingFeatures": [
        "Localized thickening of the frontal bone only",
        "Usually asymptomatic and incidental finding",
        "No systemic symptoms or muscle weakness"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive neurological deficits",
    "Severe bone pain unresponsive to analgesics",
    "Signs of increased intracranial pressure"
  ],
