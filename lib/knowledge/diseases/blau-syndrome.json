  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (ESR, CRP)",
      "Noncaseating granulomas on biopsy",
      "Normal autoantibodies (e.g., ANA, RF negative)"
    ],
    "imaging": [
      "Joint X-rays showing synovitis and tenosynovitis",
      "Chest imaging may show granulomatous lesions"
    ],
    "genetic": [
      "Mutations in NOD2/CARD15 gene"
    ],
    "other": [
      "Histopathology revealing noncaseating granulomas in affected tissues"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "juvenile-rheumatoid-arthritis",
