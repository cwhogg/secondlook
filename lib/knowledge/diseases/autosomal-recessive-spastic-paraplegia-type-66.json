        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "corticospinal-tract-signs",
        "description": "Presence of corticospinal tract signs including hyperreflexia and extensor plantar responses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biallelic-cYP2U1-mutations",
        "description": "Identification of biallelic pathogenic variants in the CYP2U1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-other-neurological-disorders",
        "description": "Exclusion of other causes of spastic paraplegia by clinical and laboratory evaluation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive lower limb spasticity with corticospinal tract signs plus identification of biallelic pathogenic CYP2U1 mutations",
    "notes": "Genetic testing is essential for definitive diagnosis; neuroimaging may support but is not diagnostic."
  },
