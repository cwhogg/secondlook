  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Postorgasmic Illness Syndrome",
    "criteria": [
      {
        "id": "symptom-onset",
        "description": "Onset of flu-like and cognitive symptoms within hours after ejaculation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "symptom-duration",
        "description": "Symptoms lasting from 2 to 7 days post-ejaculation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "symptom-reproducibility",
        "description": "Symptoms reproducible after nearly every ejaculation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-diseases",
        "description": "Exclusion of other medical or psychiatric conditions explaining symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-immunologic-findings",
        "description": "Presence of elevated inflammatory markers or positive skin test to autologous semen",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All major criteria must be met including symptom onset within hours post-ejaculation, symptom duration of 2-7 days, reproducibility after ejaculation, and exclusion of other causes.",
    "notes": "Diagnostic criteria are primarily clinical; laboratory and immunologic tests may support diagnosis but are not definitive."
  },
