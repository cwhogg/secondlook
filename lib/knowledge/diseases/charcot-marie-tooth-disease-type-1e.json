  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for CMT1E",
    "criteria": [
      {
        "id": "demyelinating-neuropathy",
        "description": "Electrophysiological evidence of demyelinating peripheral neuropathy with reduced nerve conduction velocities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mpz-gene-mutation",
        "description": "Identification of pathogenic mutations in the MPZ gene associated with CMT1E",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Symmetric distal muscle weakness and atrophy predominantly affecting lower limbs with sensory loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Nerve biopsy showing demyelination and onion bulb formations (if performed)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of demyelinating neuropathy on electrophysiology, pathogenic MPZ gene mutation, and characteristic clinical features",
    "notes": "Genetic testing is essential for definitive diagnosis; nerve biopsy is rarely required."
  },
