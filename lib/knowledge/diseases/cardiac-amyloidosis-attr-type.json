  "keyFindings": {
    "laboratory": [
      "Normal or mildly elevated cardiac biomarkers (troponin, NT-proBNP)",
      "Absence of monoclonal protein in serum and urine",
      "Elevated serum transthyretin in hereditary cases"
    ],
    "imaging": [
      "Echocardiogram showing increased left ventricular wall thickness with granular sparkling appearance",
      "Cardiac MRI with late gadolinium enhancement and abnormal T1 mapping",
      "99mTc-PYP or DPD bone scintigraphy showing myocardial uptake"
    ],
    "genetic": [
      "ATP7A (causative, loss-of-function)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Endomyocardial biopsy with Congo red staining showing apple-green birefringence under polarized light",
      "Electrocardiogram showing low voltage QRS complexes and conduction abnormalities"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "light-chain-amyloidosis-al-type",
      "distinguishingFeatures": [
        "Presence of monoclonal light chains in serum or urine",
        "More frequent involvement of kidneys and soft tissues",
        "More rapid progression"
      ]
    },
    {
      "diseaseId": "hypertrophic-cardiomyopathy",
      "distinguishingFeatures": [
        "Asymmetric septal hypertrophy",
        "Absence of amyloid deposits",
        "Family history of sarcomeric gene mutations"
      ]
    },
    {
      "diseaseId": "senile-wild-type-amyloidosis",
      "distinguishingFeatures": [
        "No TTR gene mutation",
        "Typically affects older males >70 years",
        "Slower progression"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive heart failure with preserved ejection fraction",
    "Unexplained increased ventricular wall thickness with low ECG voltage",
    "History of bilateral carpal tunnel syndrome preceding cardiac symptoms"
  ],
  "specialistType": [
