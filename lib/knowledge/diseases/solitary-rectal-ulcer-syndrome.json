  "differentialDiagnoses": [
    {
      "diseaseId": "inflammatory-bowel-disease",
      "distinguishingFeatures": [
        "Presence of systemic inflammation",
        "Histology showing chronic active inflammation with crypt abscesses",
        "Multiple segmental lesions rather than solitary ulcer"
      ]
    },
    {
      "diseaseId": "rectal-carcinoma",
      "distinguishingFeatures": [
        "Malignant cells on biopsy",
        "Irregular mass lesion on endoscopy",
        "Rapid progression and weight loss"
      ]
    },
    {
      "diseaseId": "ischemic-colitis",
      "distinguishingFeatures": [
        "Acute onset with abdominal pain",
        "Ischemic changes on histology",
        "Typically affects elderly or patients with vascular disease"
      ]
    }
  ],
