  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Mucolipidosis III",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of deficient activity of UDP-N-acetylglucosamine-1-phosphotransferase enzyme in fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of progressive joint stiffness and skeletal deformities resembling mucopolysaccharidoses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in GNPTAB or GNPTG genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-findings",
        "description": "Radiographic evidence of dysostosis multiplex with mild skeletal abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "urinary-glycosaminoglycans",
        "description": "Normal or mildly elevated urinary glycosaminoglycans (distinguishing from mucopolysaccharidoses)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient enzyme activity plus compatible clinical features and/or pathogenic variants in GNPTAB or GNPTG genes",
    "notes": "Diagnosis requires biochemical confirmation; clinical presentation is milder than mucopolysaccharidoses."
  },
