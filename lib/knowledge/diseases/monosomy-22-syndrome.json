      "Lymphopenia due to T-cell deficiency"
    ],
    "imaging": [
      "Echocardiography showing conotruncal cardiac defects",
      "CT or MRI revealing thymic hypoplasia or aplasia",
      "Renal ultrasound showing structural anomalies"
    ],
    "genetic": [
      "Fluorescence in situ hybridization (FISH) or microarray confirming 22q11.2 deletion"
    ],
    "other": [
      "Speech evaluation demonstrating velopharyngeal insufficiency",
      "Immunophenotyping showing T-cell subset abnormalities"
    ]
  },
