  "commonPitfalls": [
    "Frequently misdiagnosed as simple obesity due to fat accumulation in face and neck.",
    "Loss of subcutaneous fat in limbs may be overlooked in overweight or muscular individuals.",
    "Hyperandrogenism in women may be mistaken for polycystic ovary syndrome (PCOS)."
  ],
  "extendedDiscriminators": [
    {
      "vsCondition": "generalized-lipodystrophy",
      "feature": "FPLD2 shows partial (not generalized) loss of subcutaneous fat, sparing the face and neck."
    },
    {
      "vsCondition": "mandibuloacral-dysplasia",
      "feature": "FPLD2 lacks skeletal abnormalities such as mandibular hypoplasia and acro-osteolysis seen in mandibuloacral dysplasia."
    },
    {
      "vsCondition": "polycystic ovary syndrome (PCOS)",
      "feature": "FPLD2 presents with characteristic fat redistribution and metabolic syndrome, not seen in PCOS."
    }
  ],
  "ruleOutCriteria": [
    "Absence of partial loss of subcutaneous fat from limbs and trunk after puberty.",
    "Presence of generalized (not partial) lipodystrophy.",
    "Presence of significant skeletal abnormalities (e.g., mandibular hypoplasia, acro-osteolysis)."
  ],
