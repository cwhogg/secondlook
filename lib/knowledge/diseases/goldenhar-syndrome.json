  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Goldenhar Syndrome",
    "criteria": [
      {
        "id": "facial-asymmetry",
        "description": "Unilateral facial microsomia or asymmetry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ear-anomalies",
        "description": "Preauricular skin tags, microtia, or anotia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vertebral-defects",
        "description": "Vertebral anomalies such as hemivertebrae or scoliosis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-anomalies",
        "description": "Epibulbar dermoids or limbal dermoids",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-anomalies",
        "description": "Congenital heart defects such as ventricular septal defect",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least two major criteria including facial asymmetry and ear anomalies",
    "notes": "Diagnosis is primarily clinical; genetic testing is not definitive due to heterogeneity."
  },
