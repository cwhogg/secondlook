      {
        "id": "col7a1-mutation",
        "description": "Identification of heterozygous pathogenic variants in COL7A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Reduced or absent type VII collagen staining at the dermal-epidermal junction",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of generalized blistering with subepidermal cleft on biopsy plus identification of pathogenic COL7A1 variant or immunofluorescence showing reduced type VII collagen",
    "notes": "Genetic testing is confirmatory; clinical presentation and biopsy findings guide initial diagnosis."
