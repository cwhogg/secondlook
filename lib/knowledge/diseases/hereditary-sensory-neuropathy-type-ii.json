  "keyFindings": {
    "laboratory": [
      "Nerve conduction studies showing absent or reduced sensory nerve action potentials",
      "Normal or mildly reduced motor nerve conduction velocities"
    ],
    "imaging": [
      "X-rays showing bone resorption or Charcot arthropathy in distal limbs"
    ],
    "genetic": [
      "Pathogenic variants in WNK1/HSN2 gene",
      "Mutations in other genes associated with hereditary sensory neuropathies"
    ],
    "other": [
      "Skin biopsy showing loss of small myelinated and unmyelinated fibers"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hereditary-sensory-neuropathy-type-i",
      "distinguishingFeatures": [
        "Earlier onset in childhood",
        "Prominent motor involvement",
        "Different genetic mutations (e.g., SPTLC1)"
      ]
    },
    {
      "diseaseId": "leprosy",
      "distinguishingFeatures": [
        "Infectious etiology",
        "Skin lesions with sensory loss",
        "Positive acid-fast bacilli staining"
      ]
    },
