  "diagnosticCriteria": {
    "formalCriteriaName": "No formal criteria established",
    "criteria": [
      {
        "id": "biochemical-elevation",
        "description": "Elevated levels of D-2-hydroxyglutaric acid in urine and plasma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-metaphyseal-changes",
        "description": "Radiographic evidence of metaphyseal chondromatosis with irregular metaphyseal widening and flaring",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the D2HGDH gene or related genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of developmental delay and mild skeletal deformities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated D-2-hydroxyglutaric aciduria and characteristic metaphyseal chondromatosis on imaging",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory"
