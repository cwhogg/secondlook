  "diagnosticCriteria": {
    "formalCriteriaName": "Recombinant 8 Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "chromosomal-abnormality",
        "description": "Presence of recombinant chromosome 8 confirmed by cytogenetic analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including micrognathia, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defect",
        "description": "Structural congenital heart defects such as ventricular septal defect or atrial septal defect",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation with short stature",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recombinant chromosome 8 confirmed by cytogenetic analysis plus at least two major clinical features",
    "notes": "Diagnosis relies heavily on cytogenetic confirmation due to phenotypic variability"
  },
