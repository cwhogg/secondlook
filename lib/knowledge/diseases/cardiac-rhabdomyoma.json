  "keyFindings": {
    "laboratory": [
      "Genetic testing positive for TSC1 or TSC2 mutations",
      "Normal routine blood tests unless heart failure present"
    ],
    "imaging": [
      "Echocardiography showing multiple hyperechoic masses in ventricles",
      "Cardiac MRI confirming tumor size and location",
      "Prenatal ultrasound may detect cardiac masses"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology showing spider cells and glycogen-rich myocytes",
      "Dermatological signs of tuberous sclerosis (e.g., hypomelanotic macules)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cardiac-teratoma",
      "distinguishingFeatures": [
        "Presence of multiple tissue types on histology",
        "Usually solitary mass",
        "Less commonly associated with tuberous sclerosis"
      ]
    },
    {
      "diseaseId": "fibroma-of-the-heart",
      "distinguishingFeatures": [
        "Typically solitary, firm mass",
        "Histology shows fibroblasts and collagen",
        "Not associated with tuberous sclerosis"
      ]
    },
    {
      "diseaseId": "myxoma",
      "distinguishingFeatures": [
        "Usually located in atria",
        "Histology shows myxoid stroma",
        "More common in adults"
      ]
    }
  ],
  "redFlags": [
    "Severe heart failure symptoms in infant",
    "Life-threatening arrhythmias",
    "Rapid tumor growth causing obstruction"
  ],
