  "keyFindings": {
    "laboratory": [
      "ADAMTS13 activity <10% (severely deficient)",
      "ADAMTS13 inhibitor (autoantibody) positive in acquired TTP",
      "Schistocytes on peripheral blood smear",
      "Markedly elevated LDH",
      "Low or absent haptoglobin",
      "Severe thrombocytopenia (often <30,000/µL)",
      "Elevated indirect bilirubin",
      "Negative direct antiglobulin test",
      "Normal or mildly elevated creatinine",
      "Normal coagulation studies (PT/INR, PTT) - distinguishes from DIC"
    ],
    "imaging": [
      "Brain MRI may show ischemic changes in neurological involvement",
      "CT head to exclude hemorrhage in patients with altered mental status"
    ],
    "genetic": [
      "ADAMTS13 gene mutations in congenital TTP (Upshaw-Schulman syndrome)",
      "Autosomal recessive inheritance for congenital form",
      "Acquired form is autoimmune (anti-ADAMTS13 antibodies)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "PLASMIC score to predict likelihood of severe ADAMTS13 deficiency",
      "Gingival biopsy or skin biopsy may show microthrombi (rarely performed)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hemolytic-uremic-syndrome",
      "distinguishingFeatures": [
        "HUS has predominant renal failure (severe)",
        "Often preceded by diarrheal illness (Shiga toxin)",
        "ADAMTS13 activity typically normal in HUS",
        "More common in children"
      ]
    },
    {
      "diseaseId": "disseminated-intravascular-coagulation",
      "distinguishingFeatures": [
        "DIC has prolonged PT/INR and PTT",
        "Low fibrinogen and elevated D-dimer",
        "Usually associated with sepsis, malignancy, or obstetric emergencies",
        "Schistocytes less prominent than in TTP"
      ]
    },
    {
      "diseaseId": "hellp-syndrome",
      "distinguishingFeatures": [
        "Occurs in pregnancy (third trimester or postpartum)",
        "Hemolysis, elevated liver enzymes, low platelets",
        "Resolves with delivery"
      ]
    },
    {
      "diseaseId": "evans-syndrome",
      "distinguishingFeatures": [
        "Autoimmune hemolytic anemia plus immune thrombocytopenia",
        "Positive direct antiglobulin test",
        "No schistocytes",
        "ADAMTS13 normal"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive neurological symptoms (stroke, seizures, coma)",
    "Severe thrombocytopenia with active bleeding",
    "Cardiac ischemia or troponin elevation",
    "Relapsing episodes (up to 30-50% relapse rate in acquired TTP)",
    "Delay in initiating plasma exchange is life-threatening"
  ],
