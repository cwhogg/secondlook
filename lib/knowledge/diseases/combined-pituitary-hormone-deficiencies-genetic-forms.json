  "keyFindings": {
    "laboratory": [
      "Low serum levels of anterior pituitary hormones (GH, TSH, ACTH, LH, FSH, prolactin)",
      "Low target gland hormones (cortisol, free T4, sex steroids)",
      "Hypoglycemia and hyponatremia in acute phases"
    ],
    "imaging": [
      "MRI showing pituitary hypoplasia or aplasia",
      "Ectopic posterior pituitary bright spot",
      "Pituitary stalk abnormalities"
    ],
    "genetic": [
      "FOXA2 (causative)",
      "POU1F1 (causative)",
      "PROP1 (causative)",
      "HESX1 (causative)",
      "OTX2 (causative)",
      "LHX4 (causative, loss-of-function)",
      "GLI2 (causative)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Delayed bone age on radiographs",
      "Midline craniofacial anomalies"
    ]
  },
