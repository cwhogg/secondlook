  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness and hypotonia in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the TK2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing mitochondrial DNA depletion and ragged-red fibers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "respiratory-failure",
        "description": "Evidence of respiratory insufficiency requiring ventilatory support",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-lactate",
        "description": "Elevated serum or CSF lactate levels indicating mitochondrial dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive muscle weakness with genetic confirmation of TK2 mutations and muscle biopsy consistent with mitochondrial DNA depletion",
    "notes": "Diagnosis is confirmed by genetic testing; muscle biopsy supports diagnosis and excludes other myopathies."
  },
