  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of metabolic and acquired causes of ataxia"
    ],
    "imaging": [
      "MRI showing cerebellar atrophy predominantly affecting the vermis and hemispheres",
      "No significant supratentorial abnormalities"
    ],
    "genetic": [
      "TPP1 (causative)",
      "Biallelic pathogenic variants in genes associated with autosomal recessive spinocerebellar ataxia (e.g., SYNE1, SACS)"
    ],
    "other": [
      "Electromyography may show mild sensory-motor peripheral neuropathy",
      "Nerve conduction studies consistent with axonal neuropathy in some cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "friedreich-ataxia",
      "distinguishingFeatures": [
        "Onset usually before 25 years but often earlier",
        "Presence of cardiomyopathy and diabetes mellitus",
        "GAA trinucleotide repeat expansion in FXN gene"
      ]
    },
    {
      "diseaseId": "ataxia-telangiectasia",
      "distinguishingFeatures": [
        "Presence of telangiectasias especially conjunctival",
        "Immunodeficiency and elevated alpha-fetoprotein",
        "ATM gene mutations"
      ]
    }
  ],
  "redFlags": [
    "Rapid neurological deterioration inconsistent with slow progression",
    "Presence of systemic features such as immunodeficiency or cardiomyopathy",
    "Early onset seizures or encephalopathy"
  ],
