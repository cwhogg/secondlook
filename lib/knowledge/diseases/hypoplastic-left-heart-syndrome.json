        "requiredForDiagnosis": true
      },
      {
        "id": "systemic-circulation-dependence",
        "description": "Systemic circulation dependent on right ventricle via patent ductus arteriosus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "echocardiographic-findings",
        "description": "Echocardiographic evidence of aortic arch hypoplasia or coarctation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Neonatal cyanosis and signs of congestive heart failure",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe hypoplasia of left heart structures with systemic circulation dependent on right ventricle confirmed by echocardiography",
    "notes": "Diagnosis is typically confirmed prenatally or shortly after birth using echocardiography."
  },
