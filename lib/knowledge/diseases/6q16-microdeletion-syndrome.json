  "diagnosticCriteria": {
    "formalCriteriaName": "Chromosomal Microdeletion Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of a heterozygous microdeletion at chromosome 6q16 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facies",
        "description": "Distinctive craniofacial dysmorphisms including broad forehead, hypertelorism, and downslanting palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Neonatal or infantile hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of genetic confirmation of 6q16 microdeletion plus at least one major clinical feature such as developmental delay or characteristic facial features",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support but are variable."
  },
