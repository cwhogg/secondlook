  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Laboratory Diagnostic Criteria for Graves Disease",
    "criteria": [
      {
        "id": "thyroid-stimulating-immunoglobulins",
        "description": "Presence of thyroid-stimulating immunoglobulins (TSI) or TSH receptor antibodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-hyperthyroidism",
        "description": "Clinical signs and symptoms of hyperthyroidism including tachycardia, weight loss, and heat intolerance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "diffuse-thyroid-enlargement",
        "description": "Diffuse, non-nodular goiter detected on physical exam or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thyroid-radioiodine-uptake",
        "description": "Increased radioactive iodine uptake on thyroid scan",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ophthalmopathy",
        "description": "Presence of Graves ophthalmopathy (exophthalmos, lid lag)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical hyperthyroidism, diffuse goiter, and positive thyroid-stimulating immunoglobulins",
    "notes": "Diagnosis is supported by elevated free T4 and suppressed TSH levels."
  },
