          "unexpected cardiac arrest"
        ]
      },
      {
        "symptomName": "Seizures",
        "frequency": 0.03,
        "bodySystem": "neurological",
        "notes": "Secondary to cerebral embolism"
      },
      {
        "symptomName": "Arthralgia",
        "frequency": 0.02,
        "bodySystem": "musculoskeletal",
        "notes": "Paraneoplastic phenomenon"
      }
    ]
