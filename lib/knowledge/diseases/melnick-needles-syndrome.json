  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and radiological diagnostic criteria for Melnick-Needles syndrome",
    "criteria": [
      {
        "id": "skeletal-dysplasia",
        "description": "Characteristic skeletal dysplasia including bowed long bones and cortical thickening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features such as prominent supraorbital ridges, exophthalmos, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the FLNA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-findings",
        "description": "Radiographic evidence of ribbon-like ribs and flared metaphyses",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic skeletal dysplasia and facial dysmorphism with confirmation of FLNA mutation",
    "notes": "Diagnosis is primarily clinical supported by radiological and genetic findings."
  },
