  "keyFindings": {
    "laboratory": [
      "Normal to mildly elevated alkaline phosphatase",
      "Possible mild anemia"
    ],
    "imaging": [
      "Generalized osteopenia on skeletal radiographs",
      "Possible delayed bone age"
    ],
    "genetic": [
      "No specific gene identified; suspected autosomal recessive inheritance",
      "Genetic testing may show variants of unknown significance"
    ],
    "other": [
      "Abnormal hair microscopy showing pili torti or trichorrhexis nodosa"
    ]
  },
