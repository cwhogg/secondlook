  "keyFindings": {
    "laboratory": [
      "Routine labs typically normal",
      "Catecholamines/metanephrines if pheochromocytoma suspected",
      "Complete blood count if JMML suspected in children"
    ],
    "imaging": [
      "MRI brain and orbits for optic pathway gliomas",
      "Whole-body MRI for plexiform neurofibroma surveillance",
      "PET/CT if MPNST suspected (FDG-avid compared to benign neurofibromas)",
      "MRI spine for spinal neurofibromas",
      "Skeletal radiographs for bone abnormalities"
    ],
    "genetic": [
      "NF1 gene mutations on chromosome 17q11.2 (neurofibromin)",
      "Autosomal dominant with complete penetrance but variable expressivity",
      "~50% de novo mutations",
      "Large gene with high mutation rate",
      "Mosaic NF1 (segmental NF1) in ~5-10%"
    ],
    "other": [
      "Slit-lamp examination for Lisch nodules",
      "OCT (optical coherence tomography) for choroidal abnormalities",
      "Blood pressure monitoring (annual)",
      "Developmental and educational assessment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "legius-syndrome",
      "distinguishingFeatures": [
        "SPRED1 gene mutations",
        "Cafe-au-lait macules and freckling but NO neurofibromas",
        "No Lisch nodules",
        "No optic gliomas or bone abnormalities",
        "Milder cognitive phenotype"
      ]
    },
    {
      "diseaseId": "neurofibromatosis-type-2",
      "distinguishingFeatures": [
        "NF2 has bilateral vestibular schwannomas",
        "Few or no cafe-au-lait macules",
        "NF2/SMARCB1/LZTR1 mutations",
        "Schwannomas rather than neurofibromas"
      ]
    },
    {
      "diseaseId": "mccune-albright-syndrome",
      "distinguishingFeatures": [
        "Cafe-au-lait macules with irregular 'coast of Maine' borders",
        "Polyostotic fibrous dysplasia",
        "Precocious puberty",
        "GNAS somatic mutation"
      ]
    },
    {
      "diseaseId": "constitutional-mismatch-repair-deficiency",
      "distinguishingFeatures": [
        "Cafe-au-lait macules present but associated with childhood cancers",
        "Biallelic MMR gene mutations (MLH1, MSH2, MSH6, PMS2)",
        "Higher cancer risk than NF1",
        "Brain tumors and GI cancers in childhood"
      ]
    }
  ],
  "redFlags": [
    "Rapidly growing or painful plexiform neurofibroma (concern for MPNST transformation)",
    "New-onset persistent pain or neurological deficit associated with neurofibroma",
    "Unexplained hypertension (screen for renal artery stenosis or pheochromocytoma)",
    "Progressive visual loss (optic pathway glioma expansion)",
    "Tibial bowing in infancy (risk of pseudarthrosis)"
  ],
