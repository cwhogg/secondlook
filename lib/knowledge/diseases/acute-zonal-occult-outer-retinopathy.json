  "diagnosticCriteria": {
    "formalCriteriaName": "AZOOR Diagnostic Criteria",
    "criteria": [
      {
        "id": "visual-field-defect",
        "description": "Presence of acute zonal visual field defects corresponding to outer retinal dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "photopsia",
        "description": "Subjective photopsia (flashing lights) reported by the patient",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroretinography-abnormality",
        "description": "Electroretinogram (ERG) showing reduced amplitude in affected retinal zones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fundus-autofluorescence-changes",
        "description": "Fundus autofluorescence demonstrating zonal areas of hypo- or hyperautofluorescence",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-inflammatory-signs",
        "description": "Lack of significant intraocular inflammation or vitritis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acute zonal visual field defects, photopsia, and corresponding ERG abnormalities",
    "notes": "Diagnosis is clinical and supported by multimodal imaging and electrophysiology; exclusion of other white dot syndromes is essential."
  },
