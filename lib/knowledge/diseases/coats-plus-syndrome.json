  "diagnosticCriteria": {
    "formalCriteriaName": "Coats Plus Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "retinal-telangiectasia",
        "description": "Presence of retinal telangiectasia and exudative retinopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-calcifications",
        "description": "Bilateral intracranial calcifications on neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-failure",
        "description": "Evidence of bone marrow failure or cytopenias",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "telomere-length",
        "description": "Shortened telomere length on genetic testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "CTC1-mutation",
        "description": "Pathogenic variants in the CTC1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: retinal telangiectasia, brain calcifications, and bone marrow failure",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory"
  },
