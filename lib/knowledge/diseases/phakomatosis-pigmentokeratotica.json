  "diagnosticCriteria": {
    "formalCriteriaName": "Happle's Diagnostic Criteria for Phakomatosis Pigmentokeratotica",
    "criteria": [
      {
        "id": "epidermal-nevus",
        "description": "Presence of linear sebaceous nevus or epidermal nevus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "speckled-lentiginous-nevus",
        "description": "Coexistence of speckled lentiginous nevus (nevus spilus) in a checkerboard or Blaschkoid pattern",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurologic-anomalies",
        "description": "Neurologic abnormalities such as hemiparesis, seizures, or developmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-anomalies",
        "description": "Skeletal abnormalities including scoliosis or limb asymmetry",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both a sebaceous or epidermal nevus and a speckled lentiginous nevus with or without associated neurologic or skeletal anomalies",
    "notes": "Diagnosis is clinical and based on the characteristic combination of cutaneous nevi and associated systemic findings."
  },
