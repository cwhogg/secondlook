    "formalCriteriaName": "ALD Adult Cerebral Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive neurological deterioration with cerebral demyelination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-evidence",
        "description": "Elevated very long chain fatty acids (VLCFA) in plasma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic mutation in ABCD1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "adrenal-insufficiency",
        "description": "Clinical or biochemical evidence of adrenal insufficiency",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "brain-mri",
        "description": "Characteristic cerebral white matter changes on MRI",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of progressive neurological symptoms with elevated VLCFA and ABCD1 mutation confirmed",
    "notes": "Adrenal insufficiency supports diagnosis but is not mandatory"
  },
