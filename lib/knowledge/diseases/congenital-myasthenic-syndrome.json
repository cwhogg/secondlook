  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Elevated serum creatine kinase is typically absent or mild"
    ],
    "imaging": [
      "Muscle MRI may show selective muscle involvement",
      "Chest imaging may reveal atelectasis or pneumonia secondary to respiratory weakness"
    ],
    "genetic": [
      "Pathogenic variants in genes such as CHRNE, RAPSN, COLQ, DOK7, and others",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electrophysiological studies showing decremental response on repetitive nerve stimulation",
      "Single-fiber electromyography demonstrating increased jitter"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "myasthenia-gravis",
      "distinguishingFeatures": [
        "Autoimmune etiology with presence of autoantibodies",
        "Later onset compared to CMS",
        "Response to immunosuppressive therapy"
      ]
    },
    {
      "diseaseId": "mitochondrial-myopathy",
      "distinguishingFeatures": [
        "Multisystem involvement including CNS and cardiac",
        "Elevated lactate levels",
        "Muscle biopsy showing ragged red fibers"
      ]
    },
    {
      "diseaseId": "spinal-muscular-atrophy",
      "distinguishingFeatures": [
        "Progressive lower motor neuron degeneration",
        "Genetic testing for SMN1 gene deletion",
        "Absence of neuromuscular junction transmission defect"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive respiratory failure",
    "Severe bulbar weakness with aspiration risk",
    "Failure to thrive in infancy"
  ],
