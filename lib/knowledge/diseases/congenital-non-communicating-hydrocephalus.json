      },
      {
        "id": "absence-of-communicating-hydrocephalus",
        "description": "Exclusion of communicating hydrocephalus by imaging and CSF flow studies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All major criteria including ventricular dilation, evidence of obstruction, and clinical signs of increased intracranial pressure must be present.",
