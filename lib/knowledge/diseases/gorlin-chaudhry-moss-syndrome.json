  "diagnosticCriteria": {
    "formalCriteriaName": "No formal diagnostic criteria established",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of cranial sutures leading to abnormal skull shape",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypertrichosis",
        "description": "Excessive hair growth over the body including face and limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Postnatal growth retardation resulting in short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "dental-anomalies",
        "description": "Abnormalities such as delayed tooth eruption and malocclusion",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis, hypertrichosis, and characteristic facial dysmorphism",
    "notes": "Diagnosis is primarily clinical supported by genetic testing when available"
  },
