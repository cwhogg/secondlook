  "keyFindings": {
    "laboratory": [
      "Hypocalcemia with serum calcium below normal range",
      "Low or undetectable serum parathyroid hormone (PTH)",
      "Hyperphosphatemia",
      "Presence of anti-parathyroid or anti-calcium sensing receptor autoantibodies"
    ],
    "imaging": [
      "Basal ganglia calcifications on brain CT or MRI",
      "Possible dental abnormalities on dental X-rays"
    ],
    "genetic": [
      "Mutations in AIRE gene in autoimmune polyglandular syndrome type 1 associated cases"
    ],
    "other": [
      "Coexisting autoimmune endocrinopathies such as adrenal insufficiency or thyroiditis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "post-surgical-hypoparathyroidism",
