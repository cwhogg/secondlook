  "diagnosticCriteria": {
    "formalCriteriaName": "Stormorken Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "thrombocytopenia",
        "description": "Persistent thrombocytopenia with bleeding tendency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-weakness",
        "description": "Progressive proximal muscle weakness and myopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "miosis",
        "description": "Congenital or early onset miosis (persistent constricted pupils)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "asplenia",
        "description": "Functional or anatomical asplenia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ichthyosis",
        "description": "Mild ichthyosis or skin scaling",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypocalcemia",
        "description": "Episodes of hypocalcemia and related symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (thrombocytopenia, muscle weakness, and miosis) with supportive clinical and laboratory findings",
    "notes": "Genetic testing for mutations in the STIM1 gene can confirm diagnosis."
  },
