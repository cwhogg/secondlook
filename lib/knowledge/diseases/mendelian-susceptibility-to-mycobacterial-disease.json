  "keyFindings": {
    "laboratory": [
      "Impaired IFN-γ production or response in functional assays",
      "Normal or mildly decreased lymphocyte counts",
      "Elevated inflammatory markers during infection"
    ],
    "imaging": [
      "Lymphadenopathy on ultrasound or CT",
      "Pulmonary infiltrates or nodules on chest imaging",
      "Bone lesions consistent with osteomyelitis"
    ],
    "genetic": [
      "Pathogenic variants in IFNGR1, IFNGR2, STAT1, IL12B, IL12RB1, or related genes"
    ],
    "other": [
      "Poor response to standard antimycobacterial therapy without adjunctive IFN-γ",
      "History of BCG vaccination complications"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "chronic-granulomatous-disease",
      "distinguishingFeatures": [
        "Defect in NADPH oxidase leading to impaired oxidative burst",
        "Recurrent bacterial and fungal infections rather than primarily mycobacterial"
      ]
    },
    {
      "diseaseId": "severe-combined-immunodeficiency",
      "distinguishingFeatures": [
        "Profound T and B cell deficiency",
        "Early onset severe infections with broad range of pathogens"
      ]
    },
    {
      "diseaseId": "common-variable-immunodeficiency",
      "distinguishingFeatures": [
        "Hypogammaglobulinemia with recurrent bacterial infections",
        "Less specific susceptibility to mycobacteria"
      ]
    }
  ],
  "redFlags": [
    "Disseminated infection following BCG vaccination",
    "Recurrent or persistent infections with weakly virulent mycobacteria",
    "Poor response to conventional antimycobacterial therapy"
  ],
