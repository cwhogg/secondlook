  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Ataxia with oculomotor apraxia type 2",
    "criteria": [
      {
        "id": "progressive-cerebellar-ataxia",
        "description": "Progressive cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oculomotor-apraxia",
        "description": "Presence of oculomotor apraxia characterized by impaired voluntary horizontal eye movements",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-serum-alpha-fetoprotein",
        "description": "Elevated serum alpha-fetoprotein (AFP) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ataxia-phenotype-genetic-confirmation",
        "description": "Identification of pathogenic mutations in the SETX gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "absent-or-mild-chorea",
        "description": "Absent or mild chorea differentiating from other ataxias",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia, oculomotor apraxia, and elevated serum alpha-fetoprotein",
    "notes": "Genetic testing for SETX mutations supports diagnosis but is not mandatory if clinical criteria are met."
  },
