  "diagnosticCriteria": {
    "formalCriteriaName": "LAD II Diagnostic Criteria",
    "criteria": [
      {
        "id": "defective-selectin-ligand-synthesis",
        "description": "Demonstration of defective fucosylation of selectin ligands on leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-bacterial-infections",
        "description": "History of recurrent severe bacterial infections without pus formation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "persistent-neutrophilia",
        "description": "Elevated peripheral blood neutrophil count during infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-sialyl-lewis-x",
        "description": "Flow cytometry showing absence or severe reduction of sialyl-Lewis X on leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in the SLC35C1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of defective selectin ligand synthesis plus recurrent bacterial infections and persistent neutrophilia",
    "notes": "Genetic confirmation is supportive but not mandatory if clinical and laboratory criteria are met"
  },
