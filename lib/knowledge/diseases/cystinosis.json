  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Nephropathic Cystinosis",
    "criteria": [
      {
        "id": "corneal-crystals",
        "description": "Presence of cystine crystals in corneal epithelium detected by slit-lamp examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "leukocyte-cystine-level",
        "description": "Elevated cystine levels in peripheral blood leukocytes above diagnostic threshold",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ctns-gene-mutation",
        "description": "Identification of pathogenic mutations in the CTNS gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-fanconi-syndrome",
        "description": "Clinical evidence of proximal renal tubular dysfunction (Fanconi syndrome)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated leukocyte cystine levels and/or CTNS gene mutation plus clinical features such as corneal cystine crystals or renal Fanconi syndrome",
    "notes": "Genetic testing is confirmatory; corneal crystals may be absent in very early infancy."
  },
