  "keyFindings": {
    "laboratory": [
      "Histopathological biopsy showing absence of enteric ganglion cells in distal colon",
      "Nerve conduction studies demonstrating demyelinating neuropathy"
    ],
    "imaging": [
      "Brain MRI showing diffuse central white matter dysmyelination",
      "Abdominal imaging showing megacolon or bowel dilation"
    ],
    "genetic": [
      "SOX10 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Audiometric testing confirming sensorineural hearing loss",
      "Ophthalmologic evaluation revealing iris heterochromia and pigmentary abnormalities"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "charcot-marie-tooth-disease-type-1",
      "distinguishingFeatures": [
        "Primarily peripheral demyelinating neuropathy without central leukodystrophy or Hirschsprung disease",
        "Lacks Waardenburg syndrome pigmentary and auditory features"
      ]
    },
    {
      "diseaseId": "waardenburg-syndrome-type-4",
      "distinguishingFeatures": [
        "Waardenburg syndrome with Hirschsprung disease but without central leukodystrophy or peripheral demyelinating neuropathy",
        "Genetic mutations primarily in EDNRB, EDN3, or SOX10"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of motor weakness with respiratory compromise",
    "Severe congenital sensorineural deafness with vestibular dysfunction",
    "Signs of bowel obstruction or enterocolitis in neonate or infant"
  ],
