  "diagnosticCriteria": {
    "formalCriteriaName": "Fredrickson Classification Type III Diagnostic Criteria",
    "criteria": [
      {
        "id": "apoE-genotype",
        "description": "Presence of homozygous apoE2/E2 genotype",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lipid-profile",
        "description": "Elevated plasma cholesterol and triglycerides with a cholesterol to triglyceride ratio approximately 1:1",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lipoprotein-electrophoresis",
        "description": "Broad beta band on lipoprotein electrophoresis indicating accumulation of remnant lipoproteins",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of palmar xanthomas and tuberous xanthomas",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Homozygous apoE2 genotype plus characteristic lipid profile and lipoprotein electrophoresis findings",
    "notes": "Diagnosis is supported by genetic testing and exclusion of secondary causes of dyslipidemia"
  },
