  "diagnosticCriteria": {
    "formalCriteriaName": "Xq25 Microduplication Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of microduplication at Xq25 region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Presence of characteristic facial dysmorphic features including hypertelorism and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Infantile hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "Recurrent seizures or epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of genetic confirmation of Xq25 microduplication plus at least one major clinical feature (developmental delay or intellectual disability).",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support but are variable."
  },
