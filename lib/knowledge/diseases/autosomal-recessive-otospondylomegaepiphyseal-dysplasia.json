  "diagnosticCriteria": {
    "formalCriteriaName": "OSMED Diagnostic Criteria",
    "criteria": [
      {
        "id": "otosclerosis",
        "description": "Congenital progressive conductive hearing loss due to otosclerosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-dysmorphism",
        "description": "Characteristic skeletal abnormalities including short stature, broad long bones, and epiphyseal dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-features",
        "description": "Distinctive facial features such as midface hypoplasia and flat nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the COL11A2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of congenital conductive hearing loss with characteristic skeletal abnormalities and confirmation by genetic testing",
    "notes": "Diagnosis is primarily clinical supported by radiographic and genetic findings."
  },
