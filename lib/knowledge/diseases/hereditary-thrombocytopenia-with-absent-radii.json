  "diagnosticCriteria": {
    "formalCriteriaName": "TAR Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "bilateral-absent-radii",
        "description": "Bilateral absence of the radius bones confirmed by radiographic imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thrombocytopenia",
        "description": "Persistent thrombocytopenia with platelet counts typically below 50,000/µL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-thumb-presence",
        "description": "Presence of both thumbs despite absent radii",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of compound heterozygous mutations in RBM8A gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other syndromes causing radial aplasia and thrombocytopenia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral absent radii, thrombocytopenia, and normal thumbs",
    "notes": "Genetic testing for RBM8A mutations can support diagnosis but is not mandatory."
  },
