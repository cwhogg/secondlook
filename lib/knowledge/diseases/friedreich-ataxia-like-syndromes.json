  "keyFindings": {
    "laboratory": [
      "Elevated serum cardiac biomarkers (e.g. troponin, BNP)",
      "Abnormal glucose tolerance tests in diabetic cases"
    ],
    "imaging": [
      "Cardiac MRI showing hypertrophic or dilated cardiomyopathy",
      "Brain MRI demonstrating cerebellar atrophy"
    ],
    "genetic": [
      "Pathogenic variants in genes such as SACS, POLG, or other FA-like syndrome genes",
      "Negative FXN gene GAA repeat expansion testing"
    ],
    "other": [
      "Electrophysiological studies showing sensory neuropathy",
      "ECG abnormalities including arrhythmias and conduction defects"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "friedreich-ataxia",
