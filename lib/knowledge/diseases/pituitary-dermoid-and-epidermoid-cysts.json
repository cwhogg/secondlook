  "diagnosticCriteria": {
    "formalCriteriaName": "No formal diagnostic criteria established",
    "criteria": [
      {
        "id": "imaging-characteristics",
        "description": "MRI or CT showing well-demarcated cystic lesion in the sellar or suprasellar region with characteristic signal intensities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathological-confirmation",
        "description": "Histopathological identification of keratinized squamous epithelium with or without dermal appendages",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Symptoms consistent with mass effect on pituitary or adjacent structures such as visual field defects or hypopituitarism",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Imaging consistent with cystic sellar lesion plus histopathological confirmation",
    "notes": "Diagnosis is primarily confirmed by histopathology following surgical resection or biopsy."
  },
