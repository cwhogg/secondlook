  "keyFindings": {
    "laboratory": [
      "Low sulfur content in hair shaft analysis",
      "Abnormal nucleotide excision repair assay in fibroblasts (in photosensitive cases)"
    ],
    "imaging": [
      "Brain MRI may show cerebral atrophy or hypomyelination",
      "Skeletal X-rays may reveal joint contractures or bone abnormalities"
    ],
    "genetic": [
      "MPLKIP (causative)",
      "ERCC2 (causative)",
      "GTF2H5 (causative)",
      "ERCC3 (causative)",
      "RNF113A (causative)",
      "GTF2E2 (causative)",
      "TARS1 (causative)",
      "CARS1 (causative)",
      "AARS1 (causative)",
      "Autosomal recessive inheritance",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Polarized light microscopy of hair showing alternating light and dark 'tiger tail' banding pattern"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "xeroderma-pigmentosum",
      "distinguishingFeatures": [
        "Severe photosensitivity with early skin cancers",
        "Lack of sulfur-deficient brittle hair",
        "Predominant neurological degeneration without ichthyosis"
      ]
    },
    {
      "diseaseId": "cockayne-syndrome",
      "distinguishingFeatures": [
        "Progressive neurological degeneration",
        "Photosensitivity without brittle hair",
        "Characteristic facial features and growth failure"
      ]
    },
    {
      "diseaseId": "netherton-syndrome",
      "distinguishingFeatures": [
        "Ichthyosis linearis circumflexa",
        "Hair shaft abnormalities different from tiger tail banding",
        "Atopic diathesis and immune dysregulation"
      ]
    }
  ],
  "redFlags": [
    "Brittle hair with tiger tail banding on polarized light microscopy",
    "Early onset photosensitivity with skin abnormalities",
    "Developmental delay or intellectual disability in context of dermatological signs"
  ],
