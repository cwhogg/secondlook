  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Ocular Motor Apraxia, Cogan Type",
    "criteria": [
      {
        "id": "impaired-voluntary-horizontal-saccades",
        "description": "Marked impairment or absence of voluntary horizontal saccadic eye movements",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "compensatory-head-thrusts",
        "description": "Presence of compensatory head thrusts or head thrusting movements to initiate gaze shifts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-vertical-saccades",
        "description": "Preservation of vertical saccadic eye movements",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-progressive-neurological-decline",
        "description": "No evidence of progressive neurological deterioration or neurodegenerative disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-brain-imaging",
        "description": "Normal or non-specific findings on brain MRI excluding other causes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of impaired voluntary horizontal saccades and compensatory head thrusts with preservation of vertical saccades and exclusion of progressive neurological disorders",
    "notes": "Diagnosis is clinical and supported by neuro-ophthalmological examination and imaging to exclude other causes."
  },
