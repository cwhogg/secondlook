  "diagnosticCriteria": {
    "formalCriteriaName": "Hypomandibular Faciocranial Dysostosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "mandibular-hypoplasia",
        "description": "Congenital hypoplasia of the mandible with reduced mandibular length and volume",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cranial-bone-abnormalities",
        "description": "Abnormalities of cranial bones including delayed ossification and dysmorphic cranial sutures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia and abnormal zygomatic arches",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-impairment",
        "description": "Conductive or mixed hearing loss due to ossicular chain malformations",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "dental-anomalies",
        "description": "Malocclusion and dental crowding secondary to mandibular hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: mandibular hypoplasia, cranial bone abnormalities, and facial dysmorphism",
    "notes": "Diagnosis is clinical and supported by imaging; genetic testing may aid but no specific gene identified"
  },
