  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Severe X-linked Mitochondrial Encephalomyopathy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early onset progressive encephalopathy with developmental regression and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing mitochondrial abnormalities including ragged-red fibers and cytochrome c oxidase deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Pathogenic mutation in nuclear gene encoding mitochondrial protein on X chromosome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing symmetric basal ganglia and brainstem signal abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "lactate-levels",
        "description": "Elevated blood or CSF lactate levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: clinical presentation, muscle biopsy findings, and genetic confirmation",
    "notes": "Neuroimaging and biochemical markers support diagnosis but are not mandatory."
  },
