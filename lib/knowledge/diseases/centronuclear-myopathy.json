  "diagnosticCriteria": {
    "formalCriteriaName": "Centronuclear Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "central-nuclei",
        "description": "Presence of centrally located nuclei in >25% of muscle fibers on muscle biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-weakness",
        "description": "Clinical evidence of generalized muscle weakness predominantly affecting proximal muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic variants in genes associated with CNM (e.g., MTM1, DNM2, BIN1)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyography showing myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of centrally located nuclei in muscle biopsy plus clinical muscle weakness; genetic confirmation supports diagnosis",
    "notes": "Muscle biopsy remains the gold standard; genetic testing aids in subtype classification"
  },
