  "diagnosticCriteria": {
    "formalCriteriaName": "Holoprosencephaly Diagnostic Criteria",
    "criteria": [
      {
        "id": "single-ventricle",
        "description": "Presence of a single, monoventricle without interhemispheric fissure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-corpus-callosum",
        "description": "Complete or near-complete absence of the corpus callosum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-midline-anomalies",
        "description": "Severe midline facial anomalies such as cyclopia, proboscis, or cebocephaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with holoprosencephaly (e.g., SHH, ZIC2, SIX3)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of single monoventricle with absence of corpus callosum and characteristic midline facial anomalies",
    "notes": "Diagnosis is primarily based on neuroimaging and clinical facial features; genetic testing supports but is not mandatory."
  },
