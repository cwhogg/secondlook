    "formalCriteriaName": "Clinical Diagnostic Criteria for Aniridia-Intellectual Disability Syndrome",
    "criteria": [
      {
        "id": "aniridia",
        "description": "Congenital absence or severe hypoplasia of the iris",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability confirmed by neuropsychological testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ptosis",
        "description": "Bilateral or unilateral eyelid ptosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "brain-malformations",
        "description": "Structural brain abnormalities detected by neuroimaging",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of PAX6 gene mutation or deletion",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of congenital aniridia, intellectual disability, and genetic confirmation of PAX6 mutation or deletion",
    "notes": "Diagnosis may be supported by neuroimaging findings and ocular abnormalities such as ptosis."
  },
