  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Spondylocostal Dysostosis",
    "criteria": [
      {
        "id": "vertebral-malformations",
        "description": "Presence of multiple vertebral segmentation defects including hemivertebrae and fused vertebrae",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rib-abnormalities",
        "description": "Abnormal rib segmentation and fusion resulting in a short trunk and thoracic insufficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in genes associated with autosomal recessive spondylocostal dysostosis (e.g., DLL3, MESP2, LFNG, HES7)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-presentation",
        "description": "Short trunk dwarfism with normal limb length and characteristic chest wall deformities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of vertebral segmentation defects and rib abnormalities with or without genetic confirmation",
    "notes": "Genetic testing is recommended to confirm diagnosis and differentiate from other spondylocostal dysostoses."
  },
