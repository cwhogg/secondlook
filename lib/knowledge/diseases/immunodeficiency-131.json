    "formalCriteriaName": "Clinical and Genetic Criteria for IMD131 (APDS2)",
    "criteria": [
      {
        "id": "recurrent-sinopulmonary-infections",
        "description": "History of recurrent sinopulmonary infections (e.g., otitis media, sinusitis, pneumonia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphoproliferation",
        "description": "Evidence of lymphoproliferation (e.g., lymphadenopathy, splenomegaly)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic gain-of-function variant in PIK3R1 identified by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "susceptibility-to-herpesviruses",
        "description": "Susceptibility to herpesvirus infections (e.g., EBV, HSV)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "immunoglobulin-abnormalities",
        "description": "Immunoglobulin abnormalities (e.g., elevated IgM, low IgG/IgA)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria are required for diagnosis.",
    "notes": "Diagnosis is confirmed by identification of a pathogenic PIK3R1 variant in the clinical context."
