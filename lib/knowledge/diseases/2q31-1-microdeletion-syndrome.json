  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for 2q31.1 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "molecular-confirmation",
        "description": "Detection of a heterozygous microdeletion at chromosome 2q31.1 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Presence of upper limb malformations including syndactyly, camptodactyly, or radial ray defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features such as hypertelorism, broad nasal bridge, and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of 2q31.1 microdeletion plus presence of at least two major clinical features including limb malformations and developmental delay",
    "notes": "Diagnosis relies heavily on molecular genetic testing due to phenotypic variability."
  },
