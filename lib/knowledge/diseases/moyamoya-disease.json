  "diagnosticCriteria": {
    "formalCriteriaName": "Research Committee on Moyamoya Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "bilateral-stenosis",
        "description": "Bilateral stenosis or occlusion of the terminal portion of the internal carotid arteries and proximal portions of the anterior and middle cerebral arteries",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "moyamoya-vessels",
        "description": "Presence of abnormal vascular networks (moyamoya vessels) near the stenotic areas on angiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-secondary",
        "description": "Exclusion of other causes of similar vascular changes such as atherosclerosis, autoimmune disease, or Down syndrome",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Bilateral stenosis or occlusion of the distal internal carotid arteries with presence of moyamoya vessels on angiography and exclusion of secondary causes",
    "notes": "Unilateral involvement may be considered probable Moyamoya disease but requires follow-up for confirmation."
  },
