  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "CSF analysis typically unremarkable"
    ],
    "imaging": [
      "Brain MRI may show nonspecific mild cerebral atrophy or be normal",
      "DAT-SPECT imaging may show reduced striatal dopamine transporter uptake"
    ],
    "genetic": [
      "NR4A2 (phenotype modifier)",
      "TBR1 (candidate)"
    ],
    "other": [
      "Marked clinical improvement with levodopa therapy",
      "Electrophysiological studies generally normal"
    ]
  },
