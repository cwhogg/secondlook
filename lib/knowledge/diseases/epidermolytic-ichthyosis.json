  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Diagnostic Criteria for Epidermolytic Ichthyosis",
    "criteria": [
      {
        "id": "clinical-blistering",
        "description": "Presence of widespread blistering and erythroderma at or shortly after birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological evidence of epidermolytic hyperkeratosis with vacuolar degeneration of the suprabasal keratinocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in KRT1 or KRT10 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-hyperkeratosis",
        "description": "Development of thickened, hyperkeratotic plaques with a verrucous appearance in childhood",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical blistering and erythroderma at birth plus histopathological confirmation or genetic mutation identification",
    "notes": "Genetic testing is confirmatory but not always available; diagnosis often relies on clinical and histopathological findings."
  },
