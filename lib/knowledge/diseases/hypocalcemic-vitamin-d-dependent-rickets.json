  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for Vitamin D-Dependent Rickets Type 1",
    "criteria": [
      {
        "id": "hypocalcemia",
        "description": "Persistent hypocalcemia with low serum calcium levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-alkaline-phosphatase",
        "description": "Elevated serum alkaline phosphatase indicating increased bone turnover",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-1-25-dihydroxyvitamin-d",
        "description": "Low or undetectable serum 1,25-dihydroxyvitamin D despite normal or elevated 25-hydroxyvitamin D",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-rickets",
        "description": "Radiographic evidence of rickets including metaphyseal cupping and fraying",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in the CYP27B1 gene encoding 1-alpha-hydroxylase",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypocalcemia, elevated alkaline phosphatase, and low 1,25-dihydroxyvitamin D levels with radiographic evidence of rickets; genetic confirmation supports diagnosis",
    "notes": "Differentiation from nutritional rickets and other forms of vitamin D-dependent rickets is essential"
  },
