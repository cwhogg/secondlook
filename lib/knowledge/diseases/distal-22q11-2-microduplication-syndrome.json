  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible immunological abnormalities in some cases"
    ],
    "imaging": [
      "Echocardiogram revealing congenital heart defects",
      "Brain MRI may show nonspecific white matter changes"
    ],
    "genetic": [
      "Microduplication at distal 22q11.2 region confirmed by chromosomal microarray or FISH",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Developmental and neuropsychological assessments indicating delay"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "22q11-2-deletion-syndrome",
      "distinguishingFeatures": [
        "Microdeletion rather than microduplication at 22q11.2",
        "More severe congenital heart defects",
        "Characteristic immunodeficiency and hypocalcemia"
      ]
    },
    {
      "diseaseId": "cat-eye-syndrome",
      "distinguishingFeatures": [
        "Partial tetrasomy of chromosome 22",
        "Presence of coloboma and anal atresia",
        "Distinctive facial features different from distal 22q11.2 microduplication"
      ]
    }
  ],
