  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Autosomal Recessive Myogenic Arthrogryposis Multiplex Congenita",
    "criteria": [
      {
        "id": "congenital-joint-contractures",
        "description": "Presence of multiple congenital joint contractures affecting at least two different body regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-hypoplasia",
        "description": "Evidence of muscle hypoplasia or atrophy on muscle biopsy or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in genes associated with myogenic AMC",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-central-nervous-system",
        "description": "Absence of primary central nervous system abnormalities on neurological examination and imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyography showing myopathic changes consistent with muscle involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital joint contractures in multiple regions, muscle hypoplasia confirmed by biopsy or imaging, and biallelic pathogenic variants in relevant genes",
    "notes": "Diagnosis requires exclusion of neurogenic causes of arthrogryposis."
  },
