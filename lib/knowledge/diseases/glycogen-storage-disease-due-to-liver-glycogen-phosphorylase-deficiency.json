  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Glycogen Storage Disease Type VI",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of deficient liver glycogen phosphorylase enzyme activity in liver biopsy or cultured fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the PYGL gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of hepatomegaly with mild hypoglycemia and elevated liver transaminases",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "biochemical-findings",
        "description": "Elevated blood lactate and triglycerides during fasting",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient liver glycogen phosphorylase enzyme activity or pathogenic PYGL variants plus compatible clinical features",
    "notes": "Liver biopsy is less commonly performed due to availability of genetic testing."
  },
