  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for 22q11 Deletion Syndrome",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of hemizygous deletion of chromosome 22q11.2 by FISH, MLPA, or microarray",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-anomaly",
        "description": "Presence of conotruncal cardiac defects such as tetralogy of Fallot or interrupted aortic arch",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "palatal-abnormalities",
        "description": "Velopharyngeal insufficiency, cleft palate, or submucosal cleft palate",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hooded eyelids, bulbous nasal tip, and small chin",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "immune-deficiency",
        "description": "Hypocalcemia and T-cell immunodeficiency due to thymic hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 22q11.2 deletion plus at least one major clinical feature such as cardiac anomaly or palatal abnormality",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support diagnosis and management."
  },
