  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria established",
    "criteria": [
      {
        "id": "ataxia",
        "description": "Progressive cerebellar ataxia confirmed by neurological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pancytopenia",
        "description": "Peripheral blood pancytopenia with reduced red cells, white cells, and platelets",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-failure",
        "description": "Bone marrow hypoplasia or aplasia demonstrated by biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "telomere-length",
        "description": "Shortened telomere length in leukocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the SAMD9L gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia plus pancytopenia and bone marrow failure",
    "notes": "Genetic testing and telomere length analysis support diagnosis but are not mandatory"
  },
