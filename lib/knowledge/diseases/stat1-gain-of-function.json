  "diagnosticCriteria": {
    "formalCriteriaName": "STAT1 Gain-of-Function Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-mucocutaneous-candidiasis",
        "description": "Recurrent or persistent mucocutaneous candidiasis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoimmune-manifestations",
        "description": "Presence of autoimmune phenomena such as thyroiditis or type 1 diabetes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of heterozygous gain-of-function mutation in STAT1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunological-abnormalities",
        "description": "Laboratory evidence of impaired IL-17 immunity or elevated STAT1 phosphorylation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic mucocutaneous candidiasis plus genetic confirmation of STAT1 gain-of-function mutation",
    "notes": "Autoimmune manifestations and immunological abnormalities support diagnosis but are not mandatory."
  },
