  "keyFindings": {
    "laboratory": [
      "Inappropriately elevated insulin levels during hypoglycemia",
      "Low plasma ketone bodies and free fatty acids during hypoglycemia",
      "Normal or low growth hormone and cortisol levels during hypoglycemia"
    ],
    "imaging": [
      "Pancreatic imaging typically normal; may show beta-cell hyperplasia in rare cases"
    ],
    "genetic": [
      "HNF4A (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Family history of hyperinsulinism or MODY1 diabetes",
      "Response to diazoxide therapy in some cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-hyperinsulinism-due-to-ABCC8-mutation",
      "distinguishingFeatures": [
        "Mutations in ABCC8 gene instead of HNF4A",
        "Often more severe hypoglycemia",
        "Variable response to diazoxide"
      ]
    },
    {
      "diseaseId": "nesidioblastosis",
      "distinguishingFeatures": [
        "Diffuse beta-cell hyperplasia without identifiable genetic mutation",
        "Histopathological diagnosis",
        "Usually presents with persistent hypoglycemia in neonates"
      ]
    }
  ],
  "redFlags": [
    "Recurrent severe hypoglycemia unresponsive to glucose supplementation",
