  "diagnosticCriteria": {
    "formalCriteriaName": "Arterial Tortuosity Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "arterial-tortuosity",
        "description": "Marked tortuosity and elongation of large and medium-sized arteries demonstrated by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-hyperextensibility",
        "description": "Skin hyperextensibility and soft, velvety skin",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "joint-hypermobility",
        "description": "Generalized joint hypermobility with recurrent dislocations",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the SLC2A10 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of arterial tortuosity on imaging plus biallelic pathogenic variants in SLC2A10 gene; supportive clinical features such as skin hyperextensibility and joint hypermobility strengthen diagnosis",
    "notes": "Genetic testing is essential for confirmation; imaging modalities include CT angiography or MR angiography"
  },
