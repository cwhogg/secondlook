  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Systemic Capillary Leak Syndrome (Clarkson Disease)",
    "criteria": [
      {
        "id": "hypotension",
        "description": "Recurrent episodes of unexplained hypotension or shock",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemoconcentration",
        "description": "Elevated hematocrit during acute episodes indicating hemoconcentration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypoalbuminemia",
        "description": "Hypoalbuminemia without albuminuria during acute attacks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "monoclonal-gammopathy",
        "description": "Presence of monoclonal gammopathy (usually IgG kappa) in serum",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of shock and edema such as sepsis, anaphylaxis, or nephrotic syndrome",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "All three major criteria (hypotension, hemoconcentration, hypoalbuminemia) plus exclusion of other causes",
    "notes": "Monoclonal gammopathy is common but not mandatory for diagnosis"
  },
