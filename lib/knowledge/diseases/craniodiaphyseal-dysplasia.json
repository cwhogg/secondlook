  "differentialDiagnoses": [
    {
      "diseaseId": "craniometaphyseal-dysplasia",
      "distinguishingFeatures": [
        "Less severe craniofacial hyperostosis",
        "Metaphyseal abnormalities rather than diaphyseal sclerosis",
        "Later onset and milder progression"
      ]
    },
    {
      "diseaseId": "osteopetrosis",
      "distinguishingFeatures": [
        "Generalized increased bone density including metaphyses and epiphyses",
        "Frequent hematological abnormalities such as anemia",
        "Bone marrow failure common"
      ]
    }
  ],
  "redFlags": [
    "Progressive cranial nerve deficits (e.g., vision or hearing loss)",
    "Signs of increased intracranial pressure (headache, vomiting)",
    "Severe airway obstruction due to nasal and facial bone overgrowth"
