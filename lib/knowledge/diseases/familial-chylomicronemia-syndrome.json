  "keyFindings": {
    "laboratory": [
      "Markedly elevated fasting triglycerides >2000 mg/dL",
      "Presence of chylomicrons in plasma after 12-hour fast",
      "Low or absent lipoprotein lipase activity"
    ],
    "imaging": [
      "Ultrasound may show hepatosplenomegaly",
      "Fundoscopic exam revealing lipemia retinalis"
    ],
    "genetic": [
      "Biallelic pathogenic variants in LPL gene or related genes (APOC2, APOA5, GPIHBP1, LMF1)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Milky appearance of plasma on blood draw",
      "Elevated serum pancreatic enzymes during pancreatitis episodes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "multifactorial-hypertriglyceridemia",
      "distinguishingFeatures": [
        "Milder triglyceride elevation",
        "Presence of secondary factors (obesity, diabetes)",
        "No genetic lipoprotein lipase deficiency"
      ]
    },
    {
      "diseaseId": "familial-hypercholesterolemia",
      "distinguishingFeatures": [
        "Elevated LDL cholesterol rather than triglycerides",
        "Presence of tendon xanthomas instead of eruptive xanthomas",
        "Different genetic mutations (LDLR, APOB, PCSK9)"
      ]
    }
  ],
  "redFlags": [
    "Severe abdominal pain suggestive of acute pancreatitis",
    "Triglyceride levels persistently >2000 mg/dL despite fasting",
    "Recurrent episodes of pancreatitis in a young patient"
  ],
