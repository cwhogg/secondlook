    "formalCriteriaName": "Clinical and Radiographic Diagnostic Criteria for Metaphyseal Anadysplasia",
    "criteria": [
      {
        "id": "radiographic-metaphyseal-irregularities",
        "description": "Presence of irregular, flared, and sclerotic metaphyses predominantly in long bones on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-childhood-onset",
        "description": "Clinical onset of skeletal abnormalities in infancy or early childhood with spontaneous improvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-intelligence-and-growth",
        "description": "Normal cognitive development and eventual normalization of growth parameters after early childhood",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-extra-skeletal-manifestations",
        "description": "Lack of systemic involvement such as neurological or cardiovascular abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic metaphyseal radiographic abnormalities plus early childhood onset with spontaneous clinical and radiographic improvement",
    "notes": "Genetic testing for MMP13 mutations may support diagnosis but is not mandatory."
  },
