  "diagnosticCriteria": {
    "formalCriteriaName": "Isotretinoin Embryopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "prenatal-exposure",
        "description": "Confirmed maternal isotretinoin exposure during the first trimester of pregnancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-malformations",
        "description": "Presence of characteristic craniofacial anomalies such as microtia, anotia, or micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-defects",
        "description": "Congenital heart defects including conotruncal abnormalities",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "central-nervous-system-anomalies",
        "description": "Structural brain abnormalities or developmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-anomalies",
        "description": "Microphthalmia or other eye malformations",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed prenatal isotretinoin exposure plus at least two major criteria or one major and two minor criteria",
    "notes": "Diagnosis is clinical and supported by maternal drug history and characteristic malformations."
  },
