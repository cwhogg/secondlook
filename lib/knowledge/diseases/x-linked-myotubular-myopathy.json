{
  "id": "x-linked-myotubular-myopathy",
  "name": "X-linked Myotubular Myopathy",
  "aliases": [
    "Myotubular Myopathy",
    "Centronuclear Myopathy, X-linked"
  ],
  "icd10Codes": [
    "G71.2"
