  "keyFindings": {
    "laboratory": [
      "Elevated urinary glycosaminoglycans with atypical electrophoretic pattern",
      "Pancytopenia on complete blood count",
      "Abnormal lysosomal enzyme activity assays"
    ],
    "imaging": [
      "Echocardiography showing valvular thickening and septal defects",
      "Skeletal X-rays demonstrating dysostosis multiplex",
      "Brain MRI may show ventriculomegaly or hydrocephalus"
    ],
    "genetic": [
      "VPS33A (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Bone marrow biopsy showing dysplastic changes",
      "Urine mucopolysaccharide screening positive but atypical"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "mucopolysaccharidosis-type-vi",
      "distinguishingFeatures": [
        "Definitive enzyme deficiency in arylsulfatase B",
        "Typical MPS biochemical profile",
        "Less prominent hematopoietic abnormalities"
      ]
    },
    {
      "diseaseId": "vps33a-related-mucopolysaccharidosis-plus-syndrome",
      "distinguishingFeatures": [
        "Similar genetic cause but more severe neurodegeneration",
        "Earlier onset with profound developmental delay",
        "More prominent immunological defects"
      ]
    }
  ],
