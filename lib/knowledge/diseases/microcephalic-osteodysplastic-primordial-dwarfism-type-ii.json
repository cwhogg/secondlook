  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for MOPD II",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Severe congenital microcephaly with head circumference significantly below the 3rd percentile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "primordial-dwarfism",
        "description": "Severe prenatal and postnatal growth retardation resulting in extreme short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-dysplasia",
        "description": "Radiological evidence of osteodysplasia including metaphyseal abnormalities and delayed bone age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-features",
        "description": "Characteristic facial dysmorphism including prominent nose, narrow forehead, and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-impairment",
        "description": "Mild to moderate developmental delay and intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe congenital microcephaly, primordial dwarfism, and radiological osteodysplasia",
    "notes": "Genetic testing for PCNT mutations can confirm diagnosis"
  },
