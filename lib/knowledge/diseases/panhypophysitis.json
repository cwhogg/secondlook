  "differentialDiagnoses": [
    {
      "diseaseId": "pituitary-adenoma",
      "distinguishingFeatures": [
        "Focal pituitary mass rather than diffuse enlargement",
        "Usually preserved pituitary function or isolated hormone hypersecretion",
        "Lack of inflammatory infiltrate"
      ]
    },
    {
      "diseaseId": "lymphocytic-hypophysitis",
      "distinguishingFeatures": [
        "Usually limited to anterior pituitary rather than panhypophyseal involvement",
        "More common in peripartum women",
        "May have spontaneous resolution"
      ]
    },
    {
      "diseaseId": "sarcoidosis-of-pituitary",
      "distinguishingFeatures": [
        "Systemic sarcoidosis features",
        "Noncaseating granulomas on biopsy",
        "Other organ involvement"
      ]
    }
  ],
  "redFlags": [
    "Acute adrenal crisis symptoms (hypotension, shock)",
    "Rapid visual loss or severe visual field defects",
    "Severe hyponatremia or hypernatremia indicating pituitary dysfunction"
