  "diagnosticCriteria": {
    "formalCriteriaName": "Dubowitz syndrome clinical diagnostic criteria",
    "criteria": [
      {
        "id": "growth-retardation",
        "description": "Pre- and postnatal growth retardation with short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including microcephaly, triangular face, ptosis, and telecanthus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eczema",
        "description": "Eczematous skin changes or atopic dermatitis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "immunodeficiency",
        "description": "Variable immunological abnormalities including recurrent infections",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (growth retardation, characteristic facial dysmorphism, intellectual disability) with supportive minor criteria",
    "notes": "Diagnosis is clinical; genetic cause remains unknown but autosomal recessive inheritance is suspected."
  },
