  "keyFindings": {
    "laboratory": [
      "Persistent neutropenia, anemia, and thrombocytopenia on CBC",
      "Low serum levels of pancreatic enzymes (e.g., lipase, amylase)",
      "Elevated fecal fat indicating steatorrhea"
    ],
    "imaging": [
      "Radiographs showing metaphyseal dysostosis and rib cage abnormalities",
      "Bone age delay on skeletal survey"
    ],
    "genetic": [
      "Biallelic pathogenic variants in the SBDS gene detected by molecular testing"
    ],
    "other": [
      "Bone marrow biopsy showing hypocellularity or dysplasia",
      "Abnormal pancreatic function tests"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cystic-fibrosis",
      "distinguishingFeatures": [
        "Pulmonary involvement with bronchiectasis",
        "Sweat chloride test positive",
        "CFTR gene mutations"
      ]
    },
    {
      "diseaseId": "diamond-blackfan-anemia",
      "distinguishingFeatures": [
        "Pure red cell aplasia without neutropenia",
        "Congenital anomalies including craniofacial abnormalities",
        "No pancreatic insufficiency"
      ]
    }
  ],
  "redFlags": [
    "Severe neutropenia with recurrent life-threatening infections",
    "Development of myelodysplastic syndrome or acute leukemia",
    "Failure to thrive with persistent steatorrhea"
  ],
