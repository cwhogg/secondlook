  "keyFindings": {
    "laboratory": [
      "Normal serum and urine immunofixation electrophoresis (to exclude AL amyloidosis)",
      "Elevated NT-proBNP and troponin in cardiac involvement"
    ],
    "imaging": [
      "Cardiac MRI showing late gadolinium enhancement with characteristic amyloid pattern",
      "99mTc-PYP scintigraphy demonstrating myocardial transthyretin amyloid deposition"
    ],
    "genetic": [
      "TTR (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Endomyocardial biopsy with Congo red staining showing apple-green birefringence under polarized light"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "al-amyloidosis",
