        "description": "Hypoplasia or aplasia of distal phalanges",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent nose and micrognathia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital anonychia, microcephaly, and intellectual disability",
