  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and biochemical diagnosis of cystinuria",
    "criteria": [
      {
        "id": "urinary-cystine-crystals",
        "description": "Presence of hexagonal cystine crystals in urine microscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-urinary-cystine",
        "description": "Elevated cystine concentration in 24-hour urine (>250 mg/L)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-kidney-stones",
        "description": "History of recurrent cystine kidney stones confirmed by stone analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in SLC3A1 or SLC7A9 genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent cystine kidney stones with either hexagonal cystine crystals in urine or elevated urinary cystine concentration",
    "notes": "Genetic testing supports diagnosis but is not mandatory"
  },
