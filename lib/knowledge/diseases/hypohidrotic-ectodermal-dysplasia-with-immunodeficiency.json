  "keyFindings": {
    "laboratory": [
      "Low serum immunoglobulin levels (IgG, IgA, IgM)",
      "Impaired T-cell and B-cell function assays",
      "Abnormal sweat test indicating hypohidrosis"
    ],
    "imaging": [
      "Chest X-ray may show recurrent pneumonia or bronchiectasis"
    ],
    "genetic": [
      "IKBKG (causative)",
      "NFKBIA (causative)",
      "Autosomal dominant inheritance",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Dental radiographs showing hypodontia and abnormal tooth morphology"
    ]
  },
  "differentialDiagnoses": [
