  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Diagnosis of Recurrent Respiratory Papillomatosis",
    "criteria": [
      {
        "id": "clinical-papillomas",
        "description": "Presence of multiple exophytic papillomatous lesions in the respiratory tract, especially the larynx",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology-confirmation",
        "description": "Histopathological confirmation of benign squamous papillomas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hpv-detection",
        "description": "Detection of HPV DNA, typically types 6 or 11, in lesion tissue",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "recurrent-lesions",
        "description": "Recurrent growth of papillomas after surgical removal",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent papillomatous lesions in the respiratory tract with histopathological confirmation of benign squamous papillomas",
    "notes": "HPV typing supports diagnosis but is not mandatory"
  },
