  "keyFindings": {
    "laboratory": [
      "Low molecular weight proteinuria detected by urine analysis",
      "Normal to mildly elevated serum creatinine"
    ],
    "imaging": [
      "Brain MRI may show ventriculomegaly",
      "Chest X-ray or ultrasound revealing congenital diaphragmatic hernia",
      "Renal ultrasound typically normal or mild structural anomalies"
    ],
    "genetic": [
      "LRP2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Audiometric testing confirming bilateral sensorineural hearing loss",
      "Ophthalmologic exam showing high myopia and other ocular anomalies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "goldenhar-syndrome",
      "distinguishingFeatures": [
        "Unilateral facial asymmetry",
        "Ear and eye anomalies without renal involvement",
        "No LRP2 mutations"
      ]
    },
    {
      "diseaseId": "donohue-syndrome",
      "distinguishingFeatures": [
        "Severe insulin resistance",
        "Distinct facial features different from Donnai-Barrow",
        "No sensorineural hearing loss or proteinuria"
      ]
    },
    {
      "diseaseId": "branchio-oto-renal-syndrome",
      "distinguishingFeatures": [
        "Branchial cleft cysts or fistulas",
        "Renal anomalies with hearing loss",
        "Mutations in EYA1, SIX1, or SIX5 genes"
      ]
    }
  ],
  "redFlags": [
    "Severe bilateral sensorineural hearing loss in infancy",
    "Congenital diaphragmatic hernia with respiratory distress",
    "Low molecular weight proteinuria indicating renal tubular dysfunction"
  ],
