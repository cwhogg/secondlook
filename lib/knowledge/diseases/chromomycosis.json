  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Mycological Diagnostic Criteria for Chromomycosis",
    "criteria": [
      {
        "id": "clinical-lesions",
        "description": "Presence of verrucous, nodular, or plaque-like cutaneous lesions predominantly on lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microscopic-fungal-elements",
        "description": "Identification of characteristic pigmented muriform (sclerotic) cells in tissue biopsy or direct microscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "culture-identification",
        "description": "Isolation of dematiaceous fungi such as Fonsecaea pedrosoi or Cladophialophora carrionii from lesion samples",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histopathological evidence of granulomatous inflammation with fungal elements",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical lesions plus identification of muriform cells on microscopy or histopathology",
    "notes": "Culture confirmation is important for species identification and treatment guidance."
  },
