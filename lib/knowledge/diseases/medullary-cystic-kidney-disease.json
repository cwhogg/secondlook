  "keyFindings": {
    "laboratory": [
      "Elevated serum creatinine and blood urea nitrogen indicating renal failure",
      "Anemia of chronic disease",
      "Electrolyte abnormalities such as hyperkalemia and metabolic acidosis"
    ],
    "imaging": [
      "Ultrasound or MRI showing multiple small cysts confined to the renal medulla",
      "Normal or small kidney size without cortical cysts"
    ],
    "genetic": [
      "Mutations in MUC1 gene",
      "Mutations in UMOD gene"
    ],
    "other": [
      "Renal biopsy showing tubulointerstitial fibrosis and tubular atrophy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autosomal-dominant-polycystic-kidney-disease",
      "distinguishingFeatures": [
        "Enlarged kidneys with cysts throughout cortex and medulla",
        "Hypertension and hematuria more common early",
        "Mutations in PKD1 or PKD2 genes"
      ]
    },
    {
      "diseaseId": "nephronophthisis",
      "distinguishingFeatures": [
        "Autosomal recessive inheritance",
        "Onset in childhood or adolescence",
        "Medullary cysts with more prominent tubular basement membrane disruption"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression to end-stage renal disease",
    "Family history of early-onset renal failure",
    "Severe electrolyte disturbances refractory to treatment"
  ],
