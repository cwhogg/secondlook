  "diagnosticCriteria": {
    "formalCriteriaName": "Zechi-Ceide Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including midface hypoplasia and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-limb-malformations",
        "description": "Congenital limb anomalies such as syndactyly or brachydactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiovascular-anomalies",
        "description": "Presence of congenital heart defects including septal defects",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the associated gene(s)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (craniofacial dysmorphism and congenital limb malformations) with or without developmental delay",
    "notes": "Genetic testing can support diagnosis but is not mandatory."
  },
