  "keyFindings": {
    "laboratory": [
      "Markedly decreased serum C3 levels with normal C4",
      "Elevated inflammatory markers during infections",
      "Positive immune complex deposition on renal biopsy"
    ],
    "imaging": [
      "Chest X-ray showing recurrent pneumonia or bronchiectasis",
      "Renal ultrasound may show changes consistent with glomerulonephritis"
    ],
    "genetic": [
      "Mutations in the C3 gene identified by molecular genetic testing"
    ],
    "other": [
      "Reduced total hemolytic complement activity (CH50)",
      "Normal alternative pathway hemolytic activity (AH50) may be reduced"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "c2-deficiency",
