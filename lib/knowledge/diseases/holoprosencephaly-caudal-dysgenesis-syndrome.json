  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; metabolic screening may reveal hypoglycemia",
      "Genetic testing identifying mutations in SHH, ZIC2, or other midline developmental genes"
    ],
    "imaging": [
      "Brain MRI showing alobar or semilobar holoprosencephaly",
      "Spinal X-ray or MRI demonstrating sacral agenesis or caudal regression",
      "Ultrasound or MRI revealing renal anomalies"
    ],
    "genetic": [
      "Pathogenic variants in SHH (Sonic Hedgehog) gene",
      "Mutations in ZIC2 or SIX3 genes associated with holoprosencephaly spectrum"
    ],
    "other": [
      "Characteristic craniofacial anomalies on clinical examination",
      "Developmental assessments confirming neurocognitive impairment"
    ]
  },
  "differentialDiagnoses": [
