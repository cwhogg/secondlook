  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for SYNGAP1-related Encephalopathy",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic or likely pathogenic variant in SYNGAP1 gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability evident in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epilepsy",
        "description": "Presence of epileptic seizures, often early onset and refractory",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-features",
        "description": "Presence of autistic features or behavioral abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electroencephalogram-abnormalities",
        "description": "EEG abnormalities consistent with epileptic encephalopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic SYNGAP1 variant plus developmental delay and epilepsy",
    "notes": "Diagnosis relies primarily on genetic confirmation combined with clinical features."
