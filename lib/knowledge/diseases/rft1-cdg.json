  "keyFindings": {
    "laboratory": [
      "Type I transferrin isoform pattern on serum isoelectric focusing",
      "Elevated liver transaminases",
      "Coagulation factor deficiencies (e.g. factor XI, antithrombin III)"
    ],
    "imaging": [
      "Brain MRI may show cerebral atrophy or delayed myelination",
      "Echocardiogram may reveal cardiomyopathy"
    ],
    "genetic": [
      "RFT1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Abnormal glycosylation of serum glycoproteins detected by mass spectrometry"
    ]
  },
