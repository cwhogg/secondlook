  "diagnosticCriteria": {
    "formalCriteriaName": "Townes-Brocks Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "anal-malformation",
        "description": "Presence of anal atresia or imperforate anus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ear-anomaly",
        "description": "Characteristic ear anomalies including preauricular tags, pits, or malformed ears",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thumb-malformation",
        "description": "Triphalangeal or hypoplastic thumbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-anomaly",
        "description": "Renal malformations such as hypoplasia, dysplasia, or cystic changes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural or conductive hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least two major criteria (anal malformation, ear anomalies, thumb malformations) or one major plus two minor/supportive criteria",
    "notes": "Genetic testing for SALL1 mutations can confirm diagnosis"
  },
