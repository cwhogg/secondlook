  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Congenital Myasthenic Syndromes",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of fatigable muscle weakness with onset in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electromyography showing decremental response on repetitive nerve stimulation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes involved in glycosylation pathways affecting neuromuscular transmission",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy demonstrating abnormal glycosylation patterns or endplate abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of fatigable muscle weakness with electrophysiological evidence plus pathogenic genetic variants in glycosylation-related genes",
    "notes": "Diagnosis requires integration of clinical, electrophysiological, and genetic data."
  },
