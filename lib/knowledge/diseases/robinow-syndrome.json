  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Robinow Syndrome",
    "criteria": [
      {
        "id": "mesomelic-shortening",
        "description": "Mesomelic shortening of the limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fetal-face",
        "description": "Characteristic fetal facies including hypertelorism, broad nasal bridge, and midface hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genital-hypoplasia",
        "description": "Hypoplastic external genitalia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vertebral-anomalies",
        "description": "Vertebral segmentation defects and hemivertebrae",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "dental-abnormalities",
        "description": "Dental anomalies including gingival hypertrophy and abnormal tooth eruption",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-anomalies",
        "description": "Congenital heart defects such as pulmonary stenosis or septal defects",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (mesomelic limb shortening, fetal facies, and genital hypoplasia) with supportive findings",
    "notes": "Genetic testing for mutations in ROR2 or WNT5A genes can confirm diagnosis."
  },
