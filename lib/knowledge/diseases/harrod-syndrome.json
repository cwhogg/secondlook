  "diagnosticCriteria": {
    "formalCriteriaName": "Harrod Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "congenital-musculoskeletal-malformations",
        "description": "Presence of congenital musculoskeletal malformations including joint contractures and limb deformities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-neurological-deterioration",
        "description": "Progressive neurological deterioration manifesting as developmental delay and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-dysmorphism",
        "description": "Characteristic facial dysmorphism including micrognathia and hypertelorism",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiological-bone-abnormalities",
        "description": "Radiological evidence of bone abnormalities such as metaphyseal dysplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (congenital musculoskeletal malformations and progressive neurological deterioration) with supportive radiological findings",
    "notes": "Diagnosis is clinical supported by imaging; genetic testing may be inconclusive due to limited data."
  },
