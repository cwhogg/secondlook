  "diagnosticCriteria": {
    "formalCriteriaName": "Cor Triatriatum Diagnostic Criteria",
    "criteria": [
      {
        "id": "fibromuscular-membrane",
        "description": "Presence of a fibromuscular membrane dividing the left or right atrium",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "atrial-obstruction",
        "description": "Obstruction to blood flow within the atrium demonstrated by Doppler echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-confirmation",
        "description": "Confirmation of atrial membrane and chamber division by cardiac MRI or CT",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-symptoms",
        "description": "Symptoms consistent with atrial obstruction such as dyspnea or pulmonary congestion",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Identification of fibromuscular membrane causing atrial division with evidence of obstruction on imaging",
    "notes": "Echocardiography is the primary diagnostic modality; cardiac MRI or CT can be used for further anatomical detail."
  },
