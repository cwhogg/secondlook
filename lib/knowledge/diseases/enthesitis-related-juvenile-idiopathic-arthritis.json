  "diagnosticCriteria": {
    "formalCriteriaName": "ILAR classification criteria for juvenile idiopathic arthritis - Enthesitis-related arthritis category",
    "criteria": [
      {
        "id": "arthritis",
        "description": "Arthritis and enthesitis, or arthritis or enthesitis with at least two of the following: sacroiliac joint tenderness and/or inflammatory lumbosacral pain, HLA-B27 positivity, onset of arthritis in a male over 6 years of age, acute anterior uveitis, history of ankylosing spondylitis, ERA, sacroiliitis with inflammatory bowel disease in a first-degree relative",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion",
        "description": "Exclusion of other forms of juvenile idiopathic arthritis, psoriasis, or systemic arthritis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "uveitis",
        "description": "Presence of acute anterior uveitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Arthritis and enthesitis, or arthritis or enthesitis plus at least two supportive features including HLA-B27 positivity, male onset >6 years, sacroiliac tenderness or inflammatory back pain, acute anterior uveitis, or family history of HLA-B27 associated disease",
    "notes": "Diagnosis requires exclusion of other juvenile idiopathic arthritis categories and related conditions."
  },
