{
  "id": "ataxia-with-oculomotor-apraxia-type-1",
  "name": "Ataxia with oculomotor apraxia type 1",
  "aliases": [
    "AOA1",
    "Ataxia with oculomotor apraxia type I"
  ],
  "icd10Codes": [
    "G11.89"
  ],
  "omimId": "208920",
