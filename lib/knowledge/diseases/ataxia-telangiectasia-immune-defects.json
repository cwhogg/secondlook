      "Lymphopenia with reduced T and B cell counts",
      "Chromosomal breakage and radiosensitivity assays"
    ],
    "imaging": [
      "Cerebellar atrophy on brain MRI",
      "Pulmonary fibrosis on chest CT in advanced cases"
    ],
    "genetic": [
      "Biallelic pathogenic variants in the ATM gene"
    ],
    "other": [
      "Abnormal radiosensitivity in fibroblast cultures",
      "Delayed motor milestones and progressive neurological decline"
    ]
  },
