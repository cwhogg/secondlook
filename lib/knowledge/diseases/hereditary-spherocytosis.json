  "keyFindings": {
    "laboratory": [
      "Spherocytes on peripheral blood smear",
      "Elevated reticulocyte count",
      "Elevated MCHC (>36 g/dL)",
      "Elevated indirect bilirubin",
      "Elevated LDH, decreased haptoglobin",
      "Negative direct antiglobulin test (Coombs test)",
      "Decreased EMA binding on flow cytometry",
      "Increased incubated osmotic fragility"
    ],
    "imaging": [
      "Abdominal ultrasound showing splenomegaly",
      "Gallbladder ultrasound may show pigmented gallstones"
    ],
    "genetic": [
      "SLC4A1 (causative)",
      "SPTA1 (causative)",
      "SPTB (causative)",
      "ANK1 (causative)",
      "EPB42 (causative)",
      "Autosomal dominant in ~75% of cases; recessive in ~25%",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "SDS-PAGE analysis of red cell membrane proteins",
      "Cryohemolysis test",
      "Acidified glycerol lysis test"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autoimmune-hemolytic-anemia",
      "distinguishingFeatures": [
        "Positive direct antiglobulin test (Coombs test)",
        "No family history of hemolysis",
        "Often associated with autoimmune conditions or lymphoma"
      ]
    },
    {
      "diseaseId": "hereditary-elliptocytosis",
      "distinguishingFeatures": [
        "Elliptocytes rather than spherocytes on smear",
        "Often milder hemolysis",
        "Different membrane protein deficiencies"
      ]
    },
    {
      "diseaseId": "glucose-6-phosphate-dehydrogenase-deficiency",
      "distinguishingFeatures": [
        "Episodic hemolysis triggered by oxidative stress",
        "Heinz bodies and bite cells on smear",
        "X-linked inheritance",
        "G6PD enzyme assay abnormal"
      ]
    }
  ],
  "redFlags": [
    "Sudden severe anemia (aplastic crisis from parvovirus B19)",
    "Severe neonatal hyperbilirubinemia requiring exchange transfusion",
    "Progressive splenomegaly with hypersplenism",
    "Biliary colic or acute cholecystitis from pigmented gallstones",
    "Post-splenectomy sepsis (overwhelming post-splenectomy infection)"
  ],
