  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Pancreatic Cancer Diagnostic Criteria",
    "criteria": [
      {
        "id": "family-history",
        "description": "Presence of pancreatic cancer in two or more first-degree relatives",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset",
        "description": "Pancreatic cancer diagnosed before age 50 in family members",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic germline mutation in known pancreatic cancer susceptibility genes (e.g., BRCA2, PALB2, CDKN2A)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "multiple-cancers",
        "description": "Family history of multiple related cancers (melanoma, breast, ovarian) in addition to pancreatic cancer",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "At least two first-degree relatives with pancreatic cancer or one first-degree relative with pancreatic cancer plus a known pathogenic germline mutation",
    "notes": "Genetic counseling and testing recommended for at-risk individuals"
  },
