  "diagnosticCriteria": {
    "formalCriteriaName": "Norrie Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "congenital-blindness",
        "description": "Bilateral congenital blindness due to retinal malformation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-sensorineural-hearing-loss",
        "description": "Progressive sensorineural hearing loss developing in childhood or adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "norrie-gene-mutation",
        "description": "Pathogenic mutation in the NDP gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "psychomotor-delays",
        "description": "Psychomotor developmental delays or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-fibrovascular-membrane",
        "description": "Presence of fibrovascular retinal membranes or retinal detachment",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral congenital blindness and progressive sensorineural hearing loss with confirmed NDP gene mutation",
    "notes": "Genetic testing is essential for confirmation; clinical presentation may vary."
  },
