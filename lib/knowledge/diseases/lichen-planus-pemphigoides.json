  "diagnosticCriteria": {
    "formalCriteriaName": "No standardized formal criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of lichenoid papules and plaques with subsequent development of tense bullae",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing features of lichen planus with subepidermal blister formation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence",
        "description": "Direct immunofluorescence demonstrating linear IgG and/or C3 deposits along the basement membrane zone",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serology",
        "description": "Presence of circulating autoantibodies against BP180 or BP230 by ELISA or immunoblotting",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical presentation with lichenoid lesions and bullae plus histopathological confirmation and positive direct immunofluorescence",
    "notes": "Diagnosis requires correlation of clinical, histological, and immunopathological findings."
  },
