  "diagnosticCriteria": {
    "formalCriteriaName": "Emery-Dreifuss Muscular Dystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "emdm1-genetic-confirmation",
        "description": "Identification of pathogenic mutation in the EMD gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "emdm1-contractures",
        "description": "Early-onset contractures of the elbows, Achilles tendons, and posterior cervical muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "emdm1-cardiomyopathy",
        "description": "Cardiac conduction defects or cardiomyopathy, including arrhythmias and atrioventricular block",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "emdm1-muscle-weakness",
        "description": "Progressive humeroperoneal muscle weakness and wasting",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic EMD mutation plus at least two major clinical features including contractures and cardiac involvement",
    "notes": "Genetic testing is essential for definitive diagnosis; cardiac evaluation is critical due to risk of sudden cardiac death."
  },
