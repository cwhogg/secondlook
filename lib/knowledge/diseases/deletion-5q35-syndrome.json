  "diagnosticCriteria": {
    "formalCriteriaName": "Sotos Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "macrocephaly",
        "description": "Macrocephaly with a head circumference >2 SD above mean for age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facial-features",
        "description": "Distinctive facial gestalt including prominent forehead, dolichocephaly, and downslanting palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "overgrowth",
        "description": "Pre- and postnatal overgrowth with height and/or weight >2 SD above mean",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "NSD1-mutation",
        "description": "Pathogenic variant or deletion involving NSD1 gene at 5q35",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of macrocephaly, characteristic facial features, and overgrowth; genetic confirmation supports diagnosis",
    "notes": "Genetic testing for NSD1 mutations or deletions is confirmatory but not always necessary if clinical criteria are met"
  },
