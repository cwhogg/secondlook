  "keyFindings": {
    "laboratory": [
      "Elevated ghrelin levels",
      "Growth hormone deficiency on stimulation testing",
      "Hypogonadotropic hypogonadism hormone profile"
    ],
    "imaging": [
      "Brain MRI typically normal or nonspecific",
      "Scoliosis evident on spinal X-rays"
    ],
    "genetic": [
      "SNRPN (phenotype modifier)"
    ],
    "other": [
      "Polysomnography showing obstructive sleep apnea",
      "Neonatal feeding assessments demonstrating poor suck"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "angelman-syndrome",
      "distinguishingFeatures": [
        "Severe intellectual disability with ataxia",
        "Happy demeanor and frequent laughter",
        "Maternal deletion or mutation of 15q11-q13"
      ]
    },
    {
      "diseaseId": "morbid-obesity-syndrome",
      "distinguishingFeatures": [
        "Obesity without neonatal hypotonia",
        "No characteristic facial features",
        "No genetic abnormalities in 15q11-q13"
      ]
    },
    {
      "diseaseId": "smith-magenis-syndrome",
      "distinguishingFeatures": [
        "Distinct facial features different from PWS",
        "Self-injurious behavior with sleep disturbances",
        "Deletion of 17p11.2 region"
      ]
    }
  ],
