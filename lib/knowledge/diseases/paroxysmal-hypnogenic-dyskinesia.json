        "description": "Normal brain MRI and EEG findings outside of episodes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-epilepsy",
        "description": "Exclusion of epileptic seizures by EEG and clinical evaluation",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent nocturnal dystonic or choreiform movements with preserved consciousness and exclusion of epilepsy",
    "notes": "Diagnosis is clinical and supported by video-polysomnography and EEG studies"
  },
