  "diagnosticCriteria": {
    "formalCriteriaName": "Neutral Lipid Storage Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "lipid-droplet-accumulation",
        "description": "Presence of lipid droplets in leukocytes (Jordan anomaly) on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "myopathy-clinical",
        "description": "Progressive proximal muscle weakness with elevated serum creatine kinase",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the PNPLA2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing lipid storage within myocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ichthyosis",
        "description": "Presence of non-bullous congenital ichthyosiform erythroderma (in some cases)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (lipid droplets in leukocytes, clinical myopathy, and pathogenic PNPLA2 mutation) are required for definitive diagnosis.",
    "notes": "Genetic confirmation is essential to differentiate from other lipid storage myopathies."
  },
