  "diagnosticCriteria": {
    "formalCriteriaName": "Crigler-Najjar Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "unconjugated-hyperbilirubinemia",
        "description": "Persistent severe unconjugated hyperbilirubinemia not explained by hemolysis or liver dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "udp-glucuronosyltransferase-deficiency",
        "description": "Demonstration of absent or severely reduced UDP-glucuronosyltransferase (UGT1A1) enzyme activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the UGT1A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of unconjugated hyperbilirubinemia such as hemolytic anemia or Gilbert syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent unconjugated hyperbilirubinemia with absent or severely reduced UGT1A1 enzyme activity and pathogenic UGT1A1 mutations",
    "notes": "Diagnosis requires exclusion of hemolytic and hepatic causes of jaundice."
  },
