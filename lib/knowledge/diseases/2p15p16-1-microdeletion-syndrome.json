  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for 2p15p16.1 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "molecular-confirmation",
        "description": "Identification of a heterozygous microdeletion at chromosome 2p15p16.1 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including hypertelorism, prominent nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "brain-malformations",
        "description": "Structural brain abnormalities detected by neuroimaging",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of 2p15p16.1 microdeletion plus presence of at least two major clinical features including developmental delay and craniofacial dysmorphism",
    "notes": "Diagnosis relies heavily on molecular genetic testing combined with clinical phenotype."
  },
