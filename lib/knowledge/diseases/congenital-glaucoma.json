        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "corneal-clouding",
        "description": "Corneal edema or clouding with increased corneal diameter",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "optic-nerve-cupping",
        "description": "Optic disc cupping consistent with glaucomatous damage",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "haab-striae",
        "description": "Presence of Haab's striae (breaks in Descemet's membrane)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "photophobia",
        "description": "Photophobia and excessive tearing in infant",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated intraocular pressure plus either corneal clouding or optic nerve cupping",
    "notes": "Diagnosis is clinical and supported by tonometry, slit-lamp exam, and optic nerve assessment"
  },
