  "diagnosticCriteria": {
    "formalCriteriaName": "Kapur-Toriello Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cleft-lip-palate",
        "description": "Presence of cleft lip and/or cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "coloboma",
        "description": "Ocular coloboma affecting iris, retina, or optic nerve",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogonadism",
        "description": "Hypogonadism or genital anomalies such as micropenis or cryptorchidism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Distinctive craniofacial features including broad nasal bridge and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: cleft lip/palate, ocular coloboma, and hypogonadism/genital anomalies",
    "notes": "Diagnosis is clinical; genetic testing may support but no definitive gene identified yet."
  },
