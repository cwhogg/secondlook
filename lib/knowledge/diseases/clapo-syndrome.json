  "diagnosticCriteria": {
    "formalCriteriaName": "CLAPO Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "capillary-malformation-lower-lip",
        "description": "Presence of a congenital capillary malformation localized to the lower lip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphatic-malformation-face-neck",
        "description": "Lymphatic malformations affecting the face and/or neck region",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "asymmetry-overgrowth",
        "description": "Asymmetry or partial/generalized overgrowth of soft tissues or bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-syndromes",
        "description": "Exclusion of other overgrowth syndromes such as CLOVES or Klippel-Trenaunay syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (capillary malformation of the lower lip, lymphatic malformation of the face/neck, and asymmetry/overgrowth) must be present for diagnosis",
    "notes": "Genetic testing may support diagnosis but no single causative gene has been definitively identified."
  },
