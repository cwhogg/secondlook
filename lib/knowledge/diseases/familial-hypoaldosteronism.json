  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Hypoaldosteronism Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypoaldosteronemia",
        "description": "Low serum aldosterone levels confirmed by biochemical testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyperkalemia",
        "description": "Persistent hyperkalemia not explained by renal failure or medication",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of hypoaldosteronism or related electrolyte disturbances",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in genes regulating aldosterone synthesis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renin-levels",
        "description": "Elevated plasma renin activity consistent with aldosterone deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of low serum aldosterone and hyperkalemia with either positive genetic testing or family history",
    "notes": "Diagnosis requires exclusion of secondary causes of hypoaldosteronism."
  },
