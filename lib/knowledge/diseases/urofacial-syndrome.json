  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Urofacial Syndrome",
    "criteria": [
      {
        "id": "facial-expression-abnormality",
        "description": "Inverted or abnormal facial expression when smiling or crying",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurogenic-bladder-dysfunction",
        "description": "Detrusor-sphincter dyssynergia causing urinary retention and recurrent infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in HPSE2 or LRIG2 genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hydronephrosis",
        "description": "Presence of upper urinary tract dilation on imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "constipation",
        "description": "Chronic constipation or bowel dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of abnormal facial expression and neurogenic bladder dysfunction; genetic confirmation supports diagnosis",
    "notes": "Diagnosis is primarily clinical supported by urodynamic studies and genetic testing."
  },
