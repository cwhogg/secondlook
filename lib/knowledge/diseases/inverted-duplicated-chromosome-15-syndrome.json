        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability presenting in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Infantile hypotonia observed clinically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epilepsy",
        "description": "Presence of seizures or epilepsy, often refractory",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-features",
        "description": "Autistic-like behaviors or social communication deficits",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of genetic confirmation plus at least two major clinical features (developmental delay and hypotonia)",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support diagnosis and management."
