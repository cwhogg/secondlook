  "keyFindings": {
    "laboratory": [
      "Elevated serum and CSF lactate",
      "Elevated creatine kinase (mild to moderate)",
      "Mitochondrial DNA depletion in muscle tissue"
    ],
    "imaging": [
      "Muscle MRI showing fatty infiltration and atrophy",
      "Chest X-ray or fluoroscopy showing diaphragmatic weakness"
    ],
    "genetic": [
      "TK2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy with ragged-red fibers and decreased mitochondrial DNA content",
      "Electromyography showing myopathic changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "mitochondrial-dna-depletion-syndrome-rrm2b-deficiency",
      "distinguishingFeatures": [
        "RRM2B mutations instead of TK2",
        "More prominent multisystem involvement including renal and neurological",
        "Later onset in some cases"
      ]
    },
    {
      "diseaseId": "spinal-muscular-atrophy",
      "distinguishingFeatures": [
        "SMN1 gene mutations",
        "Predominantly lower motor neuron signs without mitochondrial DNA depletion",
        "Absence of elevated lactate"
      ]
    }
  ],
