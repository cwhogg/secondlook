  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Acrofacial Dysostosis, Catania Type",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphism including malar hypoplasia and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Preaxial limb anomalies such as hypoplasia or absence of thumbs and radial defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ear-anomalies",
        "description": "Malformed or low-set ears with possible hearing impairment",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cleft-palate",
        "description": "Presence of cleft palate or other orofacial clefts",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiological-findings",
        "description": "Radiographic evidence of radial ray defects and facial bone hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (facial dysmorphism and limb malformations) with supportive clinical and radiological findings",
    "notes": "Genetic testing may assist but is not definitive due to limited known mutations."
  },
