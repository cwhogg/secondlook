        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or skeletal abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 8q12 microduplication plus at least one major clinical feature such as developmental delay or characteristic craniofacial dysmorphism",
    "notes": "Diagnosis relies primarily on molecular genetic testing; clinical features are variable and nonspecific."
