  "keyFindings": {
    "laboratory": [
      "Elevated serum TSH",
      "Low free T4 and T3 levels",
      "Elevated serum creatine kinase (CK) in some cases"
    ],
    "imaging": [
      "Muscle ultrasound or MRI showing muscle hypertrophy with increased echogenicity",
      "Echocardiography may reveal pericardial effusion"
    ],
    "genetic": [
      "No specific genetic mutation identified; secondary to hypothyroidism"
    ],
    "other": [
      "Electromyography consistent with myopathic changes",
      "Muscle biopsy showing fiber hypertrophy and mucopolysaccharide infiltration"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "duchenne-muscular-dystrophy",
      "distinguishingFeatures": [
        "Progressive muscle weakness without hypothyroidism",
        "Genetic testing positive for dystrophin mutations",
        "Elevated CK levels much higher than in hypothyroid myopathy"
      ]
    },
    {
      "diseaseId": "hypothyroid-myopathy-without-pseudohypertrophy",
      "distinguishingFeatures": [
        "Absence of muscular pseudohypertrophy",
        "Muscle weakness and cramps without calf enlargement",
        "Improvement with thyroid hormone replacement"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive muscle weakness",
    "Respiratory compromise due to muscle involvement",
    "Cardiac tamponade secondary to pericardial effusion"
  ],
