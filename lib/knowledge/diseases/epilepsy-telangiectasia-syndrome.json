  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Ataxia-telangiectasia with epilepsy",
    "criteria": [
      {
        "id": "progressive-cerebellar-ataxia",
        "description": "Progressive cerebellar ataxia manifesting in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-telangiectasia",
        "description": "Presence of conjunctival and cutaneous telangiectasia, especially on bulbar conjunctiva",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epileptic-seizures",
        "description": "Recurrent epileptic seizures of various types including generalized tonic-clonic and myoclonic seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-alpha-fetoprotein",
        "description": "Elevated serum alpha-fetoprotein levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "atm-gene-mutation",
        "description": "Biallelic pathogenic variants in the ATM gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia, ocular telangiectasia, epilepsy, and confirmation of ATM gene mutation",
    "notes": "Diagnosis is supported by elevated alpha-fetoprotein and immunodeficiency findings."
  },
