  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Distal 3p Deletion Syndrome",
    "criteria": [
      {
        "id": "chromosomal-deletion",
        "description": "Presence of a terminal or interstitial deletion involving the distal portion of the short arm of chromosome 3 confirmed by cytogenetic or molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including microcephaly, hypertelorism, ptosis, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or limb abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed distal 3p chromosomal deletion plus at least two major clinical features including developmental delay and craniofacial dysmorphism",
    "notes": "Diagnosis relies heavily on genetic testing; clinical features support but are variable."
  },
