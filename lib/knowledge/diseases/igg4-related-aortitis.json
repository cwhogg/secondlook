  "diagnosticCriteria": {
    "formalCriteriaName": "Comprehensive Diagnostic Criteria for IgG4-related Disease (2011)",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Characteristic histopathological features including dense lymphoplasmacytic infiltrate rich in IgG4-positive plasma cells, storiform fibrosis, and obliterative phlebitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serum-igg4-elevation",
        "description": "Elevated serum IgG4 concentration (>135 mg/dL)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-aortic-involvement",
        "description": "Imaging evidence of aortic wall thickening or aneurysmal dilatation consistent with inflammatory aortitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-diseases",
        "description": "Exclusion of other causes of aortitis such as infectious or other autoimmune etiologies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic histopathology plus elevated serum IgG4 and imaging evidence of aortic involvement, with exclusion of other causes",
    "notes": "Diagnosis often requires multidisciplinary evaluation including pathology, serology, and radiology."
  },
