  "diagnosticCriteria": {
    "formalCriteriaName": "Jansson Criteria for CRMO",
    "criteria": [
      {
        "id": "multifocal-lesions",
        "description": "Presence of multifocal bone lesions on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chronic-recurrent-course",
        "description": "Recurrent episodes of bone pain and swelling lasting months to years",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "negative-bacterial-culture",
        "description": "Absence of bacterial infection confirmed by negative cultures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-inflammatory-markers",
        "description": "Elevated ESR and/or CRP during active disease",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "typical-imaging-findings",
        "description": "MRI showing bone marrow edema and osteolytic lesions",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "associated-dermatological-manifestations",
        "description": "Presence of psoriasis or palmoplantar pustulosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met for diagnosis",
    "notes": "Diagnosis is clinical and radiological; biopsy may be required to exclude malignancy or infection"
  },
