  "diagnosticCriteria": {
    "formalCriteriaName": "Urbach Type Rhizomelic Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "rhizomelia",
        "description": "Presence of rhizomelic shortening of the proximal limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including midface hypoplasia and depressed nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "laryngeal-involvement",
        "description": "Laryngeal abnormalities causing hoarseness or respiratory distress",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-findings",
        "description": "Radiographic evidence of metaphyseal abnormalities and epiphyseal dysplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the gene(s) associated with Urbach type rhizomelic syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of rhizomelic shortening, characteristic craniofacial dysmorphism, and laryngeal involvement",
    "notes": "Diagnosis is primarily clinical supported by radiological and genetic findings."
  },
