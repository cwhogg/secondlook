  "diagnosticCriteria": {
    "formalCriteriaName": "Curaçao Criteria",
    "criteria": [
      {
        "id": "epistaxis",
        "description": "Spontaneous and recurrent nosebleeds",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "telangiectasias",
        "description": "Multiple telangiectasias at characteristic sites including nasal mucosa",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "First-degree relative with HHT according to these criteria",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "visceral-lesions",
        "description": "Presence of arteriovenous malformations in lungs, liver, brain, or gastrointestinal tract",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Diagnosis requires at least three major criteria or two major plus two minor criteria",
    "notes": "Nasal mucosal telangiectasias are a key clinical feature contributing to recurrent epistaxis"
  },
