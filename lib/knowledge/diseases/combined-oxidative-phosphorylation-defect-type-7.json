  "diagnosticCriteria": {
    "formalCriteriaName": "Mitochondrial Disease Diagnostic Criteria (MDC)",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of multisystemic clinical features consistent with mitochondrial dysfunction including neurological and muscular symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-evidence",
        "description": "Deficient activity of multiple mitochondrial respiratory chain complexes in muscle or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in nuclear genes associated with combined oxidative phosphorylation defects (e.g., mutations in genes encoding mitochondrial translation factors or assembly proteins)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Muscle biopsy showing ragged-red fibers or cytochrome c oxidase (COX) deficient fibers",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "lactate-elevation",
        "description": "Elevated blood or CSF lactate levels indicating mitochondrial dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multisystemic clinical features plus biochemical evidence of combined respiratory chain deficiency and genetic confirmation of pathogenic variants",
    "notes": "Diagnosis often requires integration of clinical, biochemical, histological, and genetic data."
  },
