  "diagnosticCriteria": {
    "formalCriteriaName": "No formal named criteria",
    "criteria": [
      {
        "id": "radiologic-sclerosis",
        "description": "Diffuse increased bone density with 'bone within bone' appearance on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-failure",
        "description": "Evidence of pancytopenia due to bone marrow failure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cranial-nerve-compression",
        "description": "Clinical or radiologic evidence of cranial nerve palsies secondary to foraminal narrowing",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in osteoclast-related genes (e.g., TCIRG1, CLCN7)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hepatosplenomegaly",
        "description": "Presence of hepatosplenomegaly due to extramedullary hematopoiesis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Diffuse osteosclerosis on imaging plus clinical evidence of bone marrow failure (pancytopenia) with or without genetic confirmation",
    "notes": "Genetic testing is confirmatory but diagnosis can be made based on clinical and radiological findings."
  },
