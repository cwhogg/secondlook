  "keyFindings": {
    "laboratory": [
      "Low serum calcium and elevated phosphorus (hypoparathyroidism)",
      "Low intact PTH level",
      "Low T-cell counts (especially CD4+ naive T cells)",
      "Absent or reduced T-cell receptor excision circles (TRECs) on newborn screening",
      "Low absolute lymphocyte count in neonates"
    ],
    "imaging": [
      "Echocardiography showing conotruncal cardiac defects",
      "Renal ultrasound may show structural anomalies",
      "Chest X-ray may show absent thymic shadow in neonates",
      "Brain MRI may show polymicrogyria or white matter abnormalities"
    ],
    "genetic": [
      "TBX1 (causative)",
      "TBX1 (phenotype modifier)",
      "ARVCF (phenotype modifier)",
      "GP1BB (phenotype modifier)",
      "UFD1 (phenotype modifier)",
      "HIRA (phenotype modifier)",
      "COMT (phenotype modifier)",
      "JMJD1C (modifier)",
      "RREB1 (modifier)",
      "SEC24C (modifier)",
      "~90-95% de novo; ~5-10% inherited (autosomal dominant)"
    ],
    "other": [
      "Formal speech and language assessment",
      "Neuropsychological testing",
      "Immune function panel (lymphocyte subsets, mitogen stimulation)",
      "Parathyroid hormone and calcium monitoring"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "charge-syndrome",
      "distinguishingFeatures": [
        "CHARGE has coloboma and choanal atresia",
        "CHD7 gene mutations",
        "Different facial features",
        "Semicircular canal hypoplasia"
      ]
    },
    {
      "diseaseId": "smith-magenis-syndrome",
      "distinguishingFeatures": [
        "17p11.2 deletion (RAI1 gene)",
        "Different behavioral phenotype (self-hugging, sleep disturbance)",
        "Different facial features",
        "Less cardiac involvement"
      ]
    },
    {
      "diseaseId": "alagille-syndrome",
      "distinguishingFeatures": [
        "Bile duct paucity with cholestasis",
        "JAG1 mutations",
        "Peripheral pulmonary stenosis rather than conotruncal defects",
        "Butterfly vertebrae"
      ]
    }
  ],
  "redFlags": [
    "Neonatal hypocalcemic seizures",
    "Severe T-cell immunodeficiency (complete DiGeorge - medical emergency)",
    "Complex congenital heart disease requiring surgical repair",
    "Development of psychotic symptoms in adolescence/young adulthood",
    "Recurrent infections suggesting immune compromise"
  ],
  "specialistType": [
    "Medical Geneticist",
