  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of acquired neuropathies (e.g., diabetes, vitamin deficiencies)"
    ],
    "imaging": [
      "MRI may show muscle atrophy in distal limbs",
      "Spinal imaging to assess scoliosis if present"
    ],
    "genetic": [
      "Pathogenic mutation in CMTX3 locus on X chromosome identified by molecular genetic testing",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Nerve conduction studies showing intermediate slowing of motor and sensory nerve conduction velocities",
      "Electromyography demonstrating chronic denervation and reinnervation"
    ]
  },
