  "diagnosticCriteria": {
    "formalCriteriaName": "Petty Progeroid Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "growth-retardation",
        "description": "Severe postnatal growth retardation with failure to thrive",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facies",
        "description": "Distinctive facial features including prominent eyes, beaked nose, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-changes",
        "description": "Sclerodermatous skin changes with tight, thin skin and loss of subcutaneous fat",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Osteolysis and joint contractures",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiovascular-involvement",
        "description": "Early onset cardiovascular abnormalities such as valvular defects",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with progeroid syndromes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (growth retardation, characteristic facies, and cutaneous changes) with supportive genetic testing if available",
    "notes": "Diagnosis is clinical but genetic testing can aid confirmation. Differential diagnosis with other progeroid syndromes is essential."
  },
