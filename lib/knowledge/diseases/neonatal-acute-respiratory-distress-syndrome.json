  "diagnosticCriteria": {
    "formalCriteriaName": "Montreux Definition for Neonatal ARDS",
    "criteria": [
      {
        "id": "acute-onset",
        "description": "Acute onset of respiratory distress within 7 days of a known clinical insult",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Bilateral opacities on chest radiograph not fully explained by effusions, lobar/lung collapse, or nodules",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oxygenation-impairment",
        "description": "Impaired oxygenation defined by oxygenation index or oxygen saturation index thresholds",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-cardiac",
        "description": "Respiratory failure not fully explained by cardiac failure or fluid overload",
        "category": "minor",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "All major criteria including acute onset, bilateral radiographic opacities, and oxygenation impairment plus exclusion of cardiac failure",
    "notes": "Diagnosis requires exclusion of other causes of respiratory distress such as congenital malformations or infections."
  },
