  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Tumors of Soft Tissue and Bone",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Small round blue cell tumor morphology with uniform round nuclei and scant cytoplasm",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Strong membranous CD99 (MIC2) positivity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic",
        "description": "Presence of EWSR1 gene rearrangement detected by FISH or RT-PCR",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic",
        "description": "Imaging showing aggressive soft tissue mass often involving bone",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathologic confirmation of small round blue cell tumor with CD99 positivity and detection of EWSR1 gene rearrangement",
    "notes": "Molecular confirmation is essential to differentiate from other small round cell tumors."
  },
