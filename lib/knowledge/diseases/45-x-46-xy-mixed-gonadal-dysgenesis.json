  "keyFindings": {
    "laboratory": [
      "Abnormal sex steroid hormone levels (low testosterone, elevated LH/FSH)",
      "Elevated tumor markers in gonadoblastoma (e.g., AFP, β-hCG)"
    ],
    "imaging": [
      "Ultrasound or MRI showing asymmetric gonads or streak gonad",
      "Echocardiogram for cardiovascular anomalies"
    ],
    "genetic": [
      "SRY (candidate)"
    ],
    "other": [
      "Histopathology of gonadal tissue showing dysgenetic gonads or gonadoblastoma"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "turner-syndrome",
      "distinguishingFeatures": [
        "Typically 45,X karyotype without Y chromosome mosaicism",
        "Absence of ambiguous genitalia",
        "Bilateral streak gonads"
      ]
    },
    {
      "diseaseId": "androgen-insensitivity-syndrome",
      "distinguishingFeatures": [
        "46,XY karyotype with female external genitalia",
        "Normal testes present but androgen receptor defect",
        "No mosaicism"
      ]
    },
    {
      "diseaseId": "pure-gonadal-dysgenesis-46xy",
      "distinguishingFeatures": [
        "46,XY karyotype without mosaicism",
        "Bilateral streak gonads",
        "Female external genitalia"
      ]
    }
  ],
  "redFlags": [
    "Ambiguous genitalia at birth requiring urgent evaluation",
    "Rapidly enlarging gonadal mass suggestive of gonadoblastoma",
    "Severe cardiovascular anomalies (e.g., coarctation of the aorta)"
  ],
