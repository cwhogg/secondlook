  "diagnosticCriteria": {
    "formalCriteriaName": "PRDM8-related Progressive Myoclonus Epilepsy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-myoclonus",
        "description": "Presence of progressive cortical myoclonus with action and stimulus sensitivity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "generalized-epileptic-seizures",
        "description": "Recurrent generalized tonic-clonic seizures with progressive worsening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "prdm8-genetic-confirmation",
        "description": "Identification of pathogenic or likely pathogenic variants in the PRDM8 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cognitive-decline",
        "description": "Progressive cognitive impairment and neuropsychological decline",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "electroencephalogram-findings",
        "description": "EEG showing generalized spike-wave discharges and cortical myoclonus correlates",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cortical myoclonus, generalized epileptic seizures, and confirmed pathogenic PRDM8 mutation",
    "notes": "Diagnosis requires exclusion of other causes of progressive myoclonus epilepsy."
  },
