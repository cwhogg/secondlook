    "Luzzatto L, Ally M, Notaro R. Glucose-6-phosphate dehydrogenase deficiency. Blood. 2020;136(11):1225-1240.",
    "World Health Organization. Glucose-6-phosphate dehydrogenase deficiency. WHO Working Group. Bull World Health Organ. 1989;67(6):601-611."
  ],
  "confidenceInData": "medium"
}