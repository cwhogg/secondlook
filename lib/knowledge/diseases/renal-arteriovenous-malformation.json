  "diagnosticCriteria": {
    "formalCriteriaName": "Renal AVM Diagnostic Criteria",
    "criteria": [
      {
        "id": "imaging-confirmation",
        "description": "Visualization of abnormal direct communication between renal artery and vein on angiography or contrast-enhanced imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-hematuria",
        "description": "Presence of gross or microscopic hematuria unexplained by other causes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypertension",
        "description": "New onset or refractory hypertension associated with renal AVM",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "bruit-over-kidney",
        "description": "Audible renal bruit on physical examination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of imaging confirmation plus at least one major clinical criterion (e.g., hematuria)",
    "notes": "Diagnosis relies heavily on imaging studies; clinical features support suspicion."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Gross hematuria",
        "frequency": 0.85,
        "bodySystem": "renal",
        "notes": "Often intermittent and painless"
      },
      {
        "symptomName": "Renal bruit",
        "frequency": 0.75,
        "bodySystem": "renal",
        "notes": "Audible bruit over affected kidney"
      }
    ],
    "common": [
      {
        "symptomName": "Hypertension",
        "frequency": 0.65,
        "bodySystem": "cardiovascular",
        "notes": "May be refractory or new onset"
      },
      {
        "symptomName": "Flank pain",
        "frequency": 0.6,
        "bodySystem": "renal",
        "notes": "Usually mild to moderate"
      },
      {
        "symptomName": "Microscopic hematuria",
        "frequency": 0.55,
        "bodySystem": "renal",
        "notes": "Detected on urinalysis"
      },
      {
        "symptomName": "Palpable abdominal mass",
        "frequency": 0.5,
        "bodySystem": "renal",
        "notes": "Rarely present in large AVMs",
        "searchTerms": [
          "lump in abdomen",
          "palpable belly mass",
          "abdominal swelling felt by hand"
        ]
      }
    ],
    "occasional": [
      {
        "symptomName": "High-output cardiac failure",
        "frequency": 0.3,
        "bodySystem": "cardiovascular",
        "notes": "Due to large AV shunting",
        "searchTerms": [
          "heart failure with high blood flow",
          "excessive blood flow heart failure",
          "high-output heart failure symptoms"
        ]
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.25,
        "bodySystem": "constitutional",
        "notes": "Non-specific symptom"
      },
      {
        "symptomName": "Abdominal bruit",
        "frequency": 0.2,
        "bodySystem": "cardiovascular",
        "notes": "Heard on auscultation"
      },
      {
        "symptomName": "Proteinuria",
        "frequency": 0.15,
        "bodySystem": "renal",
        "notes": "Mild and intermittent"
      }
    ],
    "rare": [
      {
        "symptomName": "Renal vein thrombosis",
        "frequency": 0.08,
        "bodySystem": "hematological",
        "notes": "Complication of altered flow dynamics",
        "searchTerms": [
          "blood clot in kidney vein",
          "renal vein blockage",
          "kidney blood vessel clot"
        ]
      },
      {
        "symptomName": "Pulmonary embolism",
        "frequency": 0.05,
        "bodySystem": "respiratory",
        "notes": "Secondary to venous thromboembolism"
      },
      {
        "symptomName": "Hemodynamic instability",
        "frequency": 0.03,
        "bodySystem": "cardiovascular",
        "notes": "In cases of rupture or massive shunting"
      }
    ]
  },
  "systemsAffected": [
