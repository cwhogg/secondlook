  "diagnosticCriteria": {
    "formalCriteriaName": "NIH Hyper-IgE Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-ige",
        "description": "Serum IgE concentration > 2000 IU/mL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-staphylococcal-infections",
        "description": "Recurrent skin abscesses and pneumonias often caused by Staphylococcus aureus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facial-features",
        "description": "Coarse facial features including broad nasal bridge and prominent forehead",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "eczema",
        "description": "Chronic eczematous dermatitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Scoliosis, pathological fractures, and hyperextensible joints",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated serum IgE > 2000 IU/mL plus recurrent staphylococcal infections and eczema",
    "notes": "Genetic testing for STAT3 mutations can confirm diagnosis in autosomal dominant form."
  },
