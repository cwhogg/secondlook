  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for Hyperphosphatasia-Intellectual Disability Syndrome",
    "criteria": [
      {
        "id": "elevated-alkaline-phosphatase",
        "description": "Persistently elevated serum alkaline phosphatase levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Characteristic facial dysmorphism including hypertelorism and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "Presence of seizures or epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes such as PGAP2, PGAP3, or PIGV",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of elevated alkaline phosphatase, intellectual disability, and pathogenic variants in associated genes",
    "notes": "Diagnosis is supported by clinical features and confirmed by genetic testing."
  },
