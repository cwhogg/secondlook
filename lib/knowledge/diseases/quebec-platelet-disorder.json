  "diagnosticCriteria": {
    "formalCriteriaName": "Quebec Platelet Disorder Diagnostic Criteria",
    "criteria": [
      {
        "id": "increased-fibrinolysis",
        "description": "Marked increase in fibrinolytic activity in platelets demonstrated by elevated urokinase-type plasminogen activator (uPA)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "platelet-dysfunction",
        "description": "Platelet dysfunction evidenced by abnormal platelet aggregation and secretion studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bleeding-history",
        "description": "Clinical history of delayed bleeding following trauma or surgery",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of PLAU gene duplication or overexpression",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of increased fibrinolysis in platelets, platelet dysfunction, and compatible family history",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical and laboratory criteria are met."
  },
