  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible hypothyroidism on thyroid panel"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter abnormalities",
      "Echocardiogram revealing congenital heart defects"
    ],
    "genetic": [
      "Chromosomal microarray or karyotype showing inverted duplication and terminal deletion on chromosome 8p"
    ],
    "other": [
      "Developmental and neuropsychological assessments confirming intellectual disability and developmental delay"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "8p23-microdeletion-syndrome",
      "distinguishingFeatures": [
        "Pure deletion without inverted duplication",
        "More frequent congenital heart defects",
        "Different facial dysmorphisms"
      ]
    },
    {
      "diseaseId": "cri-du-chat-syndrome",
      "distinguishingFeatures": [
        "Deletion on chromosome 5p rather than 8p",
        "Characteristic high-pitched cat-like cry",
        "Distinctive facial features"
      ]
    }
  ],
  "redFlags": [
    "Severe global developmental delay in infancy",
    "Congenital heart defects requiring early intervention",
    "Presence of seizures or neurological regression"
  ],
