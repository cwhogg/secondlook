  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for POR deficiency CAH",
    "criteria": [
      {
        "id": "biochemical-abnormalities",
        "description": "Elevated serum 17-hydroxyprogesterone and abnormal steroid profile consistent with impaired steroidogenesis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the POR gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of ambiguous genitalia and skeletal malformations such as craniosynostosis or radiohumeral synostosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Radiological evidence of skeletal dysplasia and adrenal hyperplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical features plus biochemical abnormalities and genetic confirmation of POR mutations",
    "notes": "Diagnosis requires integration of clinical, biochemical, and genetic data due to phenotypic variability."
  },
