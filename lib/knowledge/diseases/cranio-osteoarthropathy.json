  "keyFindings": {
    "laboratory": [
      "Normal inflammatory markers (ESR, CRP)",
      "Mild anemia in some cases"
    ],
    "imaging": [
      "Periosteal new bone formation on X-rays of long bones",
      "Thickening of cortical bone",
      "Delayed cranial suture closure on skull X-ray"
    ],
    "genetic": [
      "HPGD (causative)",
      "Mutations in SLCO2A1 gene associated with autosomal recessive forms"
    ],
    "other": [
      "Skin biopsy showing dermal thickening and mucin deposition",
      "Exclusion of secondary causes of hypertrophic osteoarthropathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "secondary-hypertrophic-osteoarthropathy",
