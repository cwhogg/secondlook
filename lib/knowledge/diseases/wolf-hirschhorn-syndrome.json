  "diagnosticCriteria": {
    "formalCriteriaName": "Wolf-Hirschhorn Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "chromosomal-deletion-4p16.3",
        "description": "Confirmed deletion of the short arm of chromosome 4 at region 4p16.3 by cytogenetic or molecular analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic craniofacial features including 'Greek warrior helmet' appearance of the nose, hypertelorism, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-delay",
        "description": "Prenatal and postnatal growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "Onset of seizures typically in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay and intellectual disability of variable severity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of a 4p16.3 deletion confirmed by genetic testing plus characteristic facial features and growth delay",
    "notes": "Seizures and developmental delay support diagnosis but are not mandatory"
  },
