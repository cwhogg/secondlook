  "differentialDiagnoses": [
    {
      "diseaseId": "bullous-pemphigoid",
      "distinguishingFeatures": [
        "Autoantibodies target BP180 and BP230, not type VII collagen",
        "More common in elderly patients",
        "Less scarring and milia formation"
      ]
    },
    {
      "diseaseId": "porphyria-cutanea-tarda",
      "distinguishingFeatures": [
        "Photosensitivity with blistering on sun-exposed areas",
        "Elevated porphyrin levels in urine and plasma",
        "No autoantibodies against type VII collagen"
      ]
    }
