  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Microphthalmia with Limb Anomalies",
    "criteria": [
      {
        "id": "microphthalmia",
        "description": "Presence of unilateral or bilateral microphthalmia confirmed by ophthalmological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-anomalies",
        "description": "Congenital limb malformations including hypoplasia, aplasia, or syndactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features such as micrognathia or cleft palate",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiologic-confirmation",
        "description": "Radiographic evidence of limb bone abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microphthalmia plus at least one congenital limb anomaly",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
