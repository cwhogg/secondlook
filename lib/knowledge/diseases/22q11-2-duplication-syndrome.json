  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; immunological workup may reveal mild immunodeficiency"
    ],
    "imaging": [
      "Echocardiogram showing congenital heart defects",
      "Brain MRI may show nonspecific findings or be normal"
    ],
    "genetic": [
      "TBX1 (phenotype modifier)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Neurodevelopmental assessments revealing cognitive and speech delays"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "22q11-2-deletion-syndrome",
      "distinguishingFeatures": [
        "22q11.2 deletion rather than duplication",
        "More severe congenital heart defects",
        "Characteristic facial dysmorphism"
      ]
    },
    {
      "diseaseId": "velocardiofacial-syndrome",
      "distinguishingFeatures": [
        "Overlaps with 22q11.2 deletion syndrome",
        "More frequent palatal abnormalities and immunodeficiency",
        "Typically deletion rather than duplication"
      ]
    }
  ],
