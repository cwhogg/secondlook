  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed criteria for Anti-MDA5 Dermatomyositis",
    "criteria": [
      {
        "id": "anti-mda5-antibody",
        "description": "Presence of anti-MDA5 autoantibodies detected by immunoassay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-manifestations",
        "description": "Characteristic skin findings including Gottron papules, heliotrope rash, and palmar papules",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "interstitial-lung-disease",
        "description": "Evidence of rapidly progressive interstitial lung disease on imaging and pulmonary function tests",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-involvement",
        "description": "Clinically amyopathic or mild muscle weakness with normal or mildly elevated muscle enzymes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "nailfold-capillaroscopy",
        "description": "Abnormal nailfold capillary changes consistent with dermatomyositis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of anti-MDA5 antibodies plus characteristic cutaneous manifestations and evidence of interstitial lung disease",
    "notes": "Muscle involvement may be absent or mild, distinguishing it from classic dermatomyositis"
  },
