        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of signs and symptoms consistent with increased intracranial pressure or hydrocephalus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
