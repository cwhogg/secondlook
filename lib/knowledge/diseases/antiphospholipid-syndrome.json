  "keyFindings": {
    "laboratory": [
      "Lupus anticoagulant positive (most predictive of thrombosis)",
      "Anticardiolipin antibodies IgG/IgM (moderate-high titer)",
      "Anti-beta2-glycoprotein I antibodies IgG/IgM",
      "Triple aPL positivity (highest thrombotic risk)",
      "Prolonged aPTT (due to lupus anticoagulant)",
      "Thrombocytopenia",
      "Direct Coombs test positive",
      "False positive VDRL/RPR"
    ],
    "imaging": [
      "Doppler ultrasound: venous thrombosis",
      "CT angiography: pulmonary embolism or arterial thrombosis",
      "MRI brain: cerebral infarcts in young patients",
      "Echocardiography: valve thickening, vegetations (Libman-Sacks)",
      "Renal biopsy: thrombotic microangiopathy"
    ],
    "genetic": [
      "HTT (causative, gain-of-function)",
      "SLC2A3 (modifier)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Skin biopsy: non-inflammatory thrombotic vasculopathy",
      "Placental pathology: infarction, decidual vasculopathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "Multi-organ autoimmune inflammation",
        "ANA and anti-dsDNA positive",
        "Can coexist (secondary APS)"
      ]
    },
    {
      "diseaseId": "heparin-induced-thrombocytopenia",
      "distinguishingFeatures": [
        "Temporal relationship with heparin",
        "Anti-PF4 antibodies",
        "No aPL positivity"
      ]
    },
    {
      "diseaseId": "thrombotic-thrombocytopenic-purpura",
      "distinguishingFeatures": [
        "ADAMTS13 deficiency",
        "Schistocytes on smear",
        "Fever, neurologic changes, renal failure"
      ]
    },
    {
      "diseaseId": "factor-v-leiden",
      "distinguishingFeatures": [
        "Genetic thrombophilia",
        "No autoantibodies",
        "Family history of VTE"
      ]
    }
  ],
  "redFlags": [
    "Multi-organ thrombosis developing over days (catastrophic APS)",
