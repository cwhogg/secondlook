  "diagnosticCriteria": {
    "formalCriteriaName": "Gardner Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "intestinal-polyposis",
        "description": "Presence of multiple colorectal adenomatous polyps",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "osteomas",
        "description": "Presence of osteomas, especially of the skull and jaw",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "soft-tissue-tumors",
        "description": "Presence of soft tissue tumors such as epidermoid cysts or fibromas",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of Gardner syndrome or familial adenomatous polyposis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "APC-mutation",
        "description": "Identification of pathogenic APC gene mutation",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple colorectal adenomatous polyps and osteomas, or identification of pathogenic APC gene mutation with clinical features",
    "notes": "Genetic testing for APC mutations is highly recommended for confirmation."
  },
