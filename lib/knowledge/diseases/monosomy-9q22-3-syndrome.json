  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Monosomy 9q22.3 Syndrome",
    "criteria": [
      {
        "id": "chromosomal-deletion",
        "description": "Confirmed deletion involving the 9q22.3 chromosomal region by cytogenetic or molecular analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial features including microcephaly, frontal bossing, and midface hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Presence of skeletal anomalies such as clinodactyly or short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-malformations",
        "description": "Associated congenital malformations including cardiac or renal anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed 9q22.3 deletion plus at least two major clinical features including craniofacial dysmorphism and developmental delay",
    "notes": "Diagnosis requires molecular confirmation due to phenotypic overlap with other chromosomal deletion syndromes."
  },
