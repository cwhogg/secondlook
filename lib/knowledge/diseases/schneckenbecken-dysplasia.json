  "diagnosticCriteria": {
    "formalCriteriaName": "Schneckenbecken Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "pelvic-malformation",
        "description": "Characteristic snail-shaped pelvis with hypoplastic iliac wings",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-rhizomelic-dwarfism",
        "description": "Severe shortening of proximal limbs (rhizomelia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "micromelic-limb-shortening",
        "description": "Micromelic limb shortening with bowed long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "narrow-thorax",
        "description": "Narrow thoracic cage with short ribs",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-distress",
        "description": "Respiratory insufficiency due to thoracic hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic pelvic malformation plus severe rhizomelic dwarfism and micromelic limb shortening",
    "notes": "Diagnosis is primarily radiological and clinical; genetic testing may support diagnosis."
  },
