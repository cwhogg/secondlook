  "diagnosticCriteria": {
    "formalCriteriaName": "SCA36 Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with gait disturbance and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Presence of GGCCTG hexanucleotide repeat expansion in the NOP56 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected family members",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electrophysiology",
        "description": "Electromyography showing motor neuron involvement",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia plus confirmed NOP56 gene hexanucleotide repeat expansion",
    "notes": "Genetic testing is definitive; clinical features support diagnosis"
  },
