  "diagnosticCriteria": {
    "formalCriteriaName": "Marshall-Smith Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent eyes, exophthalmos, and a small upturned nose",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "advanced-bone-age",
        "description": "Radiological evidence of advanced bone age with abnormal vertebral and long bone morphology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "respiratory-difficulties",
        "description": "Severe respiratory complications including laryngomalacia and tracheomalacia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "failure-to-thrive",
        "description": "Failure to thrive and feeding difficulties in infancy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay and intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: characteristic facial dysmorphism, advanced bone age with skeletal abnormalities, and severe respiratory difficulties",
    "notes": "Genetic confirmation of NFIX mutation supports diagnosis but is not mandatory"
  },
