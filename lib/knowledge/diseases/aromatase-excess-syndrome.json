  "diagnosticCriteria": {
    "formalCriteriaName": "Aromatase Excess Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-estrogen-excess",
        "description": "Clinical signs of estrogen excess such as gynecomastia in males or precocious puberty in females",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-estrogen-levels",
        "description": "Elevated serum estradiol levels disproportionate to age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of CYP19A1 gene duplication or gain-of-function mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "suppressed-gonadotropins",
        "description": "Low or suppressed luteinizing hormone (LH) and follicle-stimulating hormone (FSH) levels due to negative feedback",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "bone-age-advanced",
        "description": "Advanced bone age on radiographic assessment",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical estrogen excess signs plus elevated estradiol levels and genetic confirmation of CYP19A1 alteration",
    "notes": "Diagnosis requires exclusion of exogenous estrogen exposure and other causes of estrogen excess."
  },
