  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Unverricht-Lundborg Disease",
    "criteria": [
      {
        "id": "clinical-seizures",
        "description": "Presence of stimulus-sensitive myoclonic seizures and generalized tonic-clonic seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-onset",
        "description": "Onset of seizures typically between 6 and 18 years of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the CSTB gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eeg-findings",
        "description": "EEG showing generalized spike-wave and polyspike-wave discharges with background slowing",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-progression",
        "description": "Progressive worsening of myoclonus and seizures over years",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of typical clinical seizures with onset in childhood plus pathogenic CSTB mutation or characteristic EEG findings",
    "notes": "Genetic confirmation is considered gold standard; EEG and clinical features support diagnosis."
  },
  "symptoms": {
