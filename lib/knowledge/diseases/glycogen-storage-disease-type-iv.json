  "diagnosticCriteria": {
    "formalCriteriaName": "Glycogen Storage Disease Type IV Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of glycogen branching enzyme activity in liver or muscle tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Presence of abnormal amylopectin-like glycogen deposits in liver biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the GBE1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive hepatosplenomegaly with liver dysfunction and cirrhosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of enzyme deficiency or pathogenic GBE1 mutations plus compatible clinical and histopathological findings",
    "notes": "Genetic testing is confirmatory; liver biopsy remains important for diagnosis."
  },
