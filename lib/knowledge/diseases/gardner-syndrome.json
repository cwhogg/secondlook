  "keyFindings": {
    "laboratory": [
      "Genetic testing revealing pathogenic APC gene mutation",
      "Elevated carcinoembryonic antigen (CEA) in colorectal cancer"
    ],
    "imaging": [
      "CT or MRI showing multiple osteomas in skull and jaw",
      "Colonoscopy revealing numerous colorectal adenomatous polyps",
      "Ultrasound or MRI detecting desmoid tumors"
    ],
    "genetic": [
      "Germline mutation in APC gene on chromosome 5q21-q22"
    ],
    "other": [
      "Family history consistent with autosomal dominant inheritance",
      "Histopathology of polyps showing adenomatous changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "familial-adenomatous-polyposis",
      "distinguishingFeatures": [
        "Presence of multiple colorectal adenomatous polyps without extracolonic manifestations such as osteomas or soft tissue tumors"
      ]
    },
    {
      "diseaseId": "peutz-jeghers-syndrome",
      "distinguishingFeatures": [
        "Hamartomatous polyps rather than adenomatous polyps",
        "Mucocutaneous pigmentation",
        "Different genetic mutation (STK11)"
      ]
    }
  ],
  "redFlags": [
    "Development of colorectal cancer at young age",
    "Rapid growth of desmoid tumors causing organ compression",
    "Multiple osteomas causing facial deformities or functional impairment"
  ],
