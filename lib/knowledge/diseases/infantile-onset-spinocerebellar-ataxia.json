    "formalCriteriaName": "Infantile-onset Spinocerebellar Ataxia Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with onset in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-atrophy",
        "description": "Neuroimaging evidence of cerebellar atrophy on MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with infantile-onset spinocerebellar ataxia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-ataxias",
        "description": "Exclusion of other causes of early-onset ataxia through metabolic and infectious workup",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia with onset in infancy, cerebellar atrophy on MRI, and pathogenic genetic variant confirmation",
    "notes": "Diagnosis requires integration of clinical, imaging, and genetic data; exclusion of other etiologies is important."
