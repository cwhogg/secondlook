  "diagnosticCriteria": {
    "formalCriteriaName": "X Small Rings Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "ring-chromosome-detection",
        "description": "Identification of ring chromosome via karyotyping or FISH analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microcephaly",
        "description": "Presence of microcephaly defined as head circumference below the 3rd percentile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation with height and weight below the 5th percentile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay affecting motor and cognitive milestones",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of ring chromosome confirmed by cytogenetic analysis plus at least two major clinical features (microcephaly and growth retardation)",
    "notes": "Molecular genetic testing may assist in confirming diagnosis; phenotypic variability is common."
  },
