  "keyFindings": {
    "laboratory": [
      "Markedly elevated methylmalonic acid in plasma and urine",
      "Metabolic acidosis with elevated anion gap",
      "Hyperammonemia during metabolic crises",
      "Normal or low vitamin B12 levels despite supplementation"
    ],
    "imaging": [
      "Brain MRI may show basal ganglia abnormalities",
      "Renal ultrasound may reveal nephrocalcinosis or atrophy"
    ],
    "genetic": [
      "MMUT (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Absent methylmalonyl-CoA mutase enzyme activity in fibroblast or liver assays"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "vitamin-b12-responsive-methylmalonic-acidemia-mut-",
      "distinguishingFeatures": [
        "Partial residual enzyme activity",
        "Improvement with vitamin B12 supplementation",
        "Less severe metabolic crises"
      ]
    },
    {
      "diseaseId": "propionic-acidemia",
      "distinguishingFeatures": [
        "Elevated propionic acid rather than methylmalonic acid",
        "Different genetic mutations (PCCA or PCCB genes)",
        "Similar metabolic crises but distinct biochemical profile"
      ]
    }
  ],
