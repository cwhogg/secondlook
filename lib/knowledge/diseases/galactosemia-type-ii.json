  "diagnosticCriteria": {
    "formalCriteriaName": "Galactokinase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced or absent galactokinase enzyme activity in erythrocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "galactitol-accumulation",
        "description": "Elevated galactitol levels in blood or urine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-cataracts",
        "description": "Presence of bilateral cataracts in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the GALK1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced galactokinase enzyme activity plus clinical cataracts and elevated galactitol levels",
    "notes": "Genetic testing supports diagnosis but is not mandatory if enzyme assay and clinical features are definitive."
  },
  "symptoms": {
    "pathognomonic": [
      {
