  "keyFindings": {
    "laboratory": [
      "Elevated NT-proBNP and troponin levels indicating cardiac involvement",
      "Normal serum and urine immunofixation to exclude AL amyloidosis"
    ],
    "imaging": [
      "Echocardiogram showing increased ventricular wall thickness with normal ejection fraction",
      "Cardiac MRI demonstrating late gadolinium enhancement consistent with amyloid infiltration",
      "99mTc-PYP scintigraphy showing myocardial uptake characteristic of ATTR amyloidosis"
    ],
    "genetic": [
      "Absence of pathogenic mutations in the TTR gene confirmed by sequencing"
    ],
    "other": [
      "Biopsy of affected tissue (e.g., abdominal fat pad, endomyocardial) with Congo red staining",
      "Mass spectrometry or immunohistochemistry confirming transthyretin amyloid fibrils"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hereditary-attr-amyloidosis",
      "distinguishingFeatures": [
        "Presence of pathogenic TTR gene mutations",
        "Earlier age of onset",
        "Family history of amyloidosis"
      ]
    },
    {
      "diseaseId": "light-chain-amyloidosis",
      "distinguishingFeatures": [
        "Presence of monoclonal gammopathy",
        "Rapidly progressive organ dysfunction",
        "Positive serum or urine immunofixation for light chains"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive heart failure in elderly male without hypertension",
    "Bilateral carpal tunnel syndrome preceding cardiac symptoms",
    "Unexplained thickened ventricular walls with low voltage on ECG"
  ],
