  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Diagnostic Criteria for Tufted Angioma",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of slowly enlarging, erythematous to violaceous plaques or nodules typically on the neck, upper trunk, or proximal limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Characteristic 'cannonball' tufts of capillaries in the dermis with lobular architecture on biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Positive staining for endothelial markers such as CD31 and CD34 confirming vascular origin",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-kaposiform-features",
        "description": "Exclusion of kaposiform hemangioendothelioma by lack of spindle cell proliferation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of typical clinical presentation plus confirmatory histopathology",
    "notes": "Diagnosis is primarily clinical supported by biopsy; immunohistochemistry aids confirmation"
  },
