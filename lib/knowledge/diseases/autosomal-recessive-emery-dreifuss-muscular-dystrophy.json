  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate elevation)"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle atrophy and fatty infiltration",
      "Echocardiogram demonstrating conduction system abnormalities and possible cardiomyopathy"
    ],
    "genetic": [
      "LMNA (causative)",
      "Biallelic pathogenic variants in EMD, SYNE1, or related genes associated with autosomal recessive inheritance"
    ],
    "other": [
      "Electrocardiogram (ECG) showing atrioventricular block and arrhythmias",
      "Electromyography (EMG) consistent with myopathic changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "x-linked-emery-dreifuss-muscular-dystrophy",
      "distinguishingFeatures": [
        "X-linked inheritance pattern",
        "Mutations in EMD gene only",
        "Predominantly affects males"
      ]
    },
    {
      "diseaseId": "limb-girdle-muscular-dystrophy",
      "distinguishingFeatures": [
        "Predominantly proximal muscle weakness without early contractures",
        "Variable cardiac involvement",
        "Different genetic mutations (e.g., CAPN3, SGCA)"
      ]
    }
  ],
  "redFlags": [
    "Early-onset joint contractures with progressive muscle weakness",
    "Cardiac conduction defects leading to syncope or sudden cardiac death",
    "Family history consistent with autosomal recessive inheritance"
  ],
