  "diagnosticCriteria": {
    "formalCriteriaName": "Mu-heavy chain disease diagnostic criteria",
    "criteria": [
      {
        "id": "monoclonal-mu-heavy-chain",
        "description": "Detection of monoclonal truncated mu-heavy chains in serum or urine by immunofixation electrophoresis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphoplasmacytic-infiltrate",
        "description": "Presence of lymphoplasmacytic infiltration in bone marrow or lymphoid tissue biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Clinical features including lymphadenopathy, hepatosplenomegaly, and constitutional symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of monoclonal truncated mu-heavy chains plus lymphoplasmacytic infiltration in tissue biopsy",
    "notes": "Diagnosis requires exclusion of other heavy chain diseases and plasma cell dyscrasias."
  },
