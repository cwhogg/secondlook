  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Autosomal Dominant Optic Atrophy",
    "criteria": [
      {
        "id": "optic-nerve-atrophy",
        "description": "Bilateral optic nerve pallor and atrophy observed on fundoscopic examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "visual-acuity-reduction",
        "description": "Progressive bilateral reduction in visual acuity typically starting in childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variant in OPA1 gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "color-vision-defect",
        "description": "Dyschromatopsia, especially tritanopia or blue-yellow color vision defects",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "visual-field-defects",
        "description": "Central or cecocentral scotomas on visual field testing",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral optic nerve atrophy and progressive visual acuity loss plus pathogenic OPA1 variant",
    "notes": "Diagnosis is supported by family history and exclusion of other optic neuropathies."
  },
