  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Congenital Myotonic Dystrophy",
    "criteria": [
      {
        "id": "neonatal-hypotonia",
        "description": "Severe neonatal hypotonia with poor spontaneous movements",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ctg-repeat-expansion",
        "description": "Presence of expanded CTG trinucleotide repeat in the DMPK gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including tented upper lip and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-insufficiency",
        "description": "Respiratory distress or failure in the neonatal period",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of myotonic dystrophy type 1",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of neonatal hypotonia and respiratory insufficiency combined with genetic confirmation of CTG repeat expansion in DMPK gene",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical features may overlap with other congenital myopathies."
  },
