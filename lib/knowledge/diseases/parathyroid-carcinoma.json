  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological and Clinical Diagnostic Criteria for Parathyroid Carcinoma",
    "criteria": [
      {
        "id": "local-invasion",
        "description": "Evidence of local invasion into surrounding tissues on histopathology or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vascular-invasion",
        "description": "Histological demonstration of vascular invasion by tumor cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metastasis",
        "description": "Presence of regional lymph node or distant metastases",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "severe-hypercalcemia",
        "description": "Marked hypercalcemia with serum calcium >14 mg/dL",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "palpable-neck-mass",
        "description": "Palpable neck mass corresponding to parathyroid tumor",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of local or vascular invasion with clinical or biochemical evidence of malignancy",
    "notes": "Diagnosis is primarily histopathological; clinical and biochemical features support suspicion."
