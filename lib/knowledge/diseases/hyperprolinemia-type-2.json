        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pyrroline-5-carboxylate-dehydrogenase-deficiency",
        "description": "Demonstration of deficient pyrroline-5-carboxylate dehydrogenase enzyme activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biallelic-aldh4a1-mutations",
        "description": "Identification of pathogenic biallelic mutations in the ALDH4A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-symptoms",
        "description": "Presence of neurological manifestations such as seizures or developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated plasma proline, deficient enzyme activity, and biallelic pathogenic ALDH4A1 mutations",
    "notes": "Diagnosis is confirmed by biochemical and genetic testing; clinical presentation may vary."
