  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Imaging Diagnosis of Dextrocardia",
    "criteria": [
      {
        "id": "cardiac-position",
        "description": "Heart apex located on the right side of the thorax",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chest-xray",
        "description": "Chest radiograph demonstrating right-sided cardiac silhouette",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "echocardiography",
        "description": "Echocardiographic confirmation of cardiac chamber orientation consistent with dextrocardia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "associated-anomalies",
        "description": "Presence or absence of associated congenital heart defects or situs inversus",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of right-sided cardiac apex confirmed by imaging (chest X-ray and echocardiography)",
    "notes": "Differentiation from cardiac dextroposition due to extracardiac causes is essential."
  },
