  "diagnosticCriteria": {
    "formalCriteriaName": "Touraine-Solente-Golé diagnostic criteria",
    "criteria": [
      {
        "id": "digital-clubbing",
        "description": "Presence of digital clubbing (enlargement of distal phalanges)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "periostosis",
        "description": "Radiographic evidence of periostosis involving long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pachydermia",
        "description": "Thickening and furrowing of facial skin (pachydermia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant or recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "arthralgia",
        "description": "Chronic joint pain and swelling",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: digital clubbing, periostosis on imaging, and pachydermia",
    "notes": "Diagnosis is clinical supported by radiographic findings; genetic testing may confirm mutations in HPGD or SLCO2A1 genes."
  },
