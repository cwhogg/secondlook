  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Weill-Marchesani Syndrome",
    "criteria": [
      {
        "id": "short-stature",
        "description": "Short stature below the 3rd percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microspherophakia",
        "description": "Presence of microspherophakia (small, spherical lens)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lens-dislocation",
        "description": "Ectopia lentis or lens dislocation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brachydactyly",
        "description": "Short fingers and toes (brachydactyly)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "joint-stiffness",
        "description": "Limited joint mobility or stiffness",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: short stature, microspherophakia, and lens dislocation",
    "notes": "Genetic testing may support diagnosis but is not mandatory."
  },
