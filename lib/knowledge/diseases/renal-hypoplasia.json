  "keyFindings": {
    "laboratory": [
      "Elevated serum creatinine and blood urea nitrogen",
      "Proteinuria on urinalysis",
      "Anemia of chronic disease"
    ],
    "imaging": [
      "Ultrasound showing small kidney(s) with normal echogenicity",
      "MRI confirming reduced renal volume",
      "Absence of cystic changes or dysplastic features"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology showing reduced nephron number without dysplasia"
    ]
  },
