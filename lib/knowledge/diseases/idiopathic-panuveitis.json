  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnosis of Idiopathic Panuveitis",
    "criteria": [
      {
        "id": "uveal-inflammation",
        "description": "Diffuse inflammation involving anterior chamber, vitreous, and retina/choroid without identifiable infectious or systemic cause",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-infectious-causes",
        "description": "Exclusion of infectious etiologies by laboratory and clinical evaluation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-systemic-disease",
        "description": "Absence of systemic autoimmune or granulomatous diseases associated with panuveitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-symptoms",
        "description": "Presence of ocular symptoms such as blurred vision, photophobia, and floaters",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Diffuse uveal inflammation involving anterior chamber, vitreous, and retina/choroid with exclusion of infectious and systemic causes",
    "notes": "Diagnosis is primarily clinical and by exclusion; no specific laboratory test confirms idiopathic panuveitis."
  },
