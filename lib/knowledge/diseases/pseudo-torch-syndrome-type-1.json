  "keyFindings": {
    "laboratory": [
      "Negative TORCH serology and PCR for infectious agents",
      "Mild anemia and thrombocytopenia in some cases"
    ],
    "imaging": [
      "CT or MRI showing intracranial calcifications and progressive cerebral atrophy",
      "Possible hydrocephalus on neuroimaging"
    ],
    "genetic": [
      "OCLN (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Normal or mildly elevated inflammatory markers",
      "Absence of infectious etiology despite clinical TORCH-like presentation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-toxoplasmosis",
