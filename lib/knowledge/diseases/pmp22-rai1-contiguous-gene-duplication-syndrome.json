  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible elevated creatine kinase in some cases"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter changes",
      "Spinal imaging may reveal scoliosis"
    ],
    "genetic": [
      "RAI1 (phenotype modifier)"
    ],
    "other": [
      "Electrophysiological studies demonstrating demyelinating peripheral neuropathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "charcot-marie-tooth-disease-type-1a",
      "distinguishingFeatures": [
        "Isolated PMP22 duplication without RAI1 involvement",
        "Predominantly peripheral neuropathy without intellectual disability"
      ]
    },
    {
      "diseaseId": "smith-magenis-syndrome",
      "distinguishingFeatures": [
        "Deletion involving RAI1 rather than duplication",
        "Distinct behavioral phenotype with self-injurious behavior"
      ]
    }
