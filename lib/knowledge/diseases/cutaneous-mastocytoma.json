  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Criteria for Cutaneous Mastocytoma",
    "criteria": [
      {
        "id": "solitary-lesion",
        "description": "Presence of a solitary, well-demarcated, yellow-brown to reddish-brown cutaneous nodule or plaque",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "darier-sign",
        "description": "Positive Darier's sign: urtication and erythema upon rubbing the lesion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological confirmation showing dense dermal infiltrate of mast cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tryptase-levels",
        "description": "Normal or mildly elevated serum tryptase levels",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of a solitary lesion with positive Darier's sign and histopathological confirmation of mast cell infiltrate",
    "notes": "Diagnosis is primarily clinical supported by histopathology; systemic involvement is rare in isolated cutaneous mastocytoma."
  },
