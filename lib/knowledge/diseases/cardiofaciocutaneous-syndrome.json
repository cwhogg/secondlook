  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible elevated liver enzymes in some cases"
    ],
    "imaging": [
      "Echocardiography showing pulmonic stenosis or hypertrophic cardiomyopathy",
      "Brain MRI may show nonspecific white matter changes"
    ],
    "genetic": [
      "Pathogenic variants in BRAF gene (~75% of cases)",
      "Pathogenic variants in MEK1 (MAP2K1) or MEK2 (MAP2K2) genes"
    ],
    "other": [
      "Characteristic facial photographs aid clinical diagnosis",
      "Skin biopsy rarely required"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "noonan-syndrome",
      "distinguishingFeatures": [
        "Less severe skin abnormalities",
        "Higher frequency of short stature",
        "Different mutation spectrum (PTPN11, SOS1)"
      ]
    },
    {
      "diseaseId": "costello-syndrome",
      "distinguishingFeatures": [
        "More pronounced coarse facial features",
        "Higher risk of malignancies",
        "HRAS gene mutations"
      ]
    }
  ],
  "redFlags": [
    "Severe congenital heart defects requiring early intervention",
    "Refractory seizures or epileptic encephalopathy",
    "Rapidly progressive hypertrophic cardiomyopathy"
  ],
