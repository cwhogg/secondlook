  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate elevation)",
      "Normal metabolic panel"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle involvement and fatty infiltration",
      "Chest X-ray showing diaphragmatic elevation"
    ],
    "genetic": [
      "MTM1 (causative, loss-of-function)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Muscle biopsy demonstrating central nuclei in >50% of fibers with type 1 fiber predominance",
      "Electromyography showing myopathic motor unit potentials"
    ]
  },
  "differentialDiagnoses": [
