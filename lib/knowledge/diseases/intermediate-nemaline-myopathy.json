  "diagnosticCriteria": {
    "formalCriteriaName": "Nemaline Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of muscle weakness with onset in infancy or childhood, intermediate severity between severe congenital and mild adult forms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Muscle biopsy showing nemaline rods in muscle fibers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with nemaline myopathy (e.g., NEB, ACTA1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Electromyographic evidence of myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-course",
        "description": "Progressive or non-progressive muscle weakness with variable respiratory involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical muscle weakness with supportive muscle biopsy showing nemaline rods and/or pathogenic genetic variants in nemaline myopathy-associated genes",
    "notes": "Diagnosis requires integration of clinical, histopathological, and genetic findings."
  },
