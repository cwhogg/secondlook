  "diagnosticCriteria": {
    "formalCriteriaName": "Beighton et al. 1998 Diagnostic Criteria for EDS Kyphoscoliotic Type",
    "criteria": [
      {
        "id": "congenital-muscle-hypotonia",
        "description": "Congenital muscle hypotonia present at birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-kyphoscoliosis",
        "description": "Progressive kyphoscoliosis apparent in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-laxity",
        "description": "Generalized joint hypermobility with joint laxity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pyridinoline-excretion",
        "description": "Elevated urinary lysyl pyridinoline to hydroxylysyl pyridinoline ratio",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "plod1-mutation",
        "description": "Identification of biallelic pathogenic variants in PLOD1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of congenital muscle hypotonia, progressive kyphoscoliosis, generalized joint laxity, and biallelic PLOD1 mutations or elevated urinary pyridinoline ratio",
    "notes": "Molecular genetic testing is confirmatory; biochemical testing of urinary pyridinoline crosslinks supports diagnosis."
  },
