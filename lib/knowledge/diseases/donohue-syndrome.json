  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnosis criteria for Donohue Syndrome",
    "criteria": [
      {
        "id": "severe-insulin-resistance",
        "description": "Severe insulin resistance with hyperinsulinemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facial-features",
        "description": "Distinctive facial dysmorphism including elfin facies, thick lips, and large ears",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Intrauterine and postnatal growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the INSR gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-abnormalities",
        "description": "Acanthosis nigricans and skin thickening",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe insulin resistance, characteristic facial features, growth retardation, and confirmed biallelic INSR mutations",
    "notes": "Genetic testing is essential for definitive diagnosis"
  },
