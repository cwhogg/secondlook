    "formalCriteriaName": "Nemaline Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Congenital hypotonia with muscle weakness predominantly affecting proximal muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Presence of nemaline rods on muscle biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the TNNT1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Myopathic changes on electromyography",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or affected siblings in an autosomal recessive pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital hypotonia and muscle weakness, nemaline rods on muscle biopsy, and pathogenic TNNT1 mutation",
    "notes": "Diagnosis is confirmed by genetic testing and muscle biopsy findings in the appropriate clinical context."
  },
