  "keyFindings": {
    "laboratory": [
      "Elevated parathyroid hormone levels with hypocalcemia indicating PTH resistance",
      "Elevated TSH with normal or low thyroid hormone levels indicating TSH resistance"
    ],
    "imaging": [
      "X-rays showing brachydactyly with cone-shaped epiphyses and shortened metacarpals/metatarsals",
      "Facial bone hypoplasia on craniofacial imaging"
    ],
    "genetic": [
      "PDE4D (causative)",
      "PRKAR1A (causative, gain-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Hormonal assays demonstrating multi-hormone resistance",
      "Neurodevelopmental assessment for intellectual disability"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pseudohypoparathyroidism",
