  "diagnosticCriteria": {
    "formalCriteriaName": "Becker Muscular Dystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness with onset typically in childhood or adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes with reduced or abnormal dystrophin protein expression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of in-frame mutations in the DMD gene leading to partially functional dystrophin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-ck",
        "description": "Elevated serum creatine kinase (CK) levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal muscle weakness plus either muscle biopsy findings or genetic confirmation of DMD gene mutation",
    "notes": "Diagnosis is confirmed by genetic testing; muscle biopsy is supportive when genetic testing is inconclusive."
  },
