  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Neurodevelopmental Delay-Seizures-Ophthalmic Anomalies-Osteopenia-Cerebellar Atrophy Syndrome",
    "criteria": [
      {
        "id": "neurodevelopmental-delay",
        "description": "Global developmental delay or intellectual disability evident in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "Recurrent seizures including generalized tonic-clonic or focal seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ophthalmic-anomalies",
        "description": "Congenital ophthalmic anomalies such as optic nerve hypoplasia, coloboma, or strabismus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "osteopenia",
        "description": "Radiologically confirmed decreased bone mineral density consistent with osteopenia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cerebellar-atrophy",
        "description": "MRI evidence of cerebellar atrophy or hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-features",
        "description": "Additional features such as hypotonia, feeding difficulties, or growth retardation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all four major criteria: neurodevelopmental delay, seizures, ophthalmic anomalies, and cerebellar atrophy",
    "notes": "Osteopenia is supportive but not mandatory; genetic testing may aid confirmation"
  },
