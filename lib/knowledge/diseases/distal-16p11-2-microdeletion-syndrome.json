  "diagnosticCriteria": {
    "formalCriteriaName": "Distal 16p11.2 Microdeletion Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of a heterozygous microdeletion at distal 16p11.2 confirmed by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurobehavioral-features",
        "description": "Presence of neurobehavioral abnormalities including autism spectrum disorder or speech delay",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "dysmorphic-features",
        "description": "Mild craniofacial dysmorphisms such as broad forehead or hypertelorism",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of distal 16p11.2 microdeletion plus at least one major clinical feature (developmental delay or neurobehavioral abnormalities)",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features are variable and may be subtle."
  },
