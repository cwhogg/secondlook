  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Merosin-deficient Congenital Muscular Dystrophy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early onset hypotonia and muscle weakness presenting at birth or within the first 6 months of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing absence or severe reduction of merosin (laminin α2) on immunohistochemistry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the LAMA2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-mri",
        "description": "Brain MRI demonstrating white matter abnormalities consistent with merosin deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "Electromyography showing myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early onset hypotonia and muscle weakness plus either muscle biopsy confirming merosin deficiency or pathogenic LAMA2 mutations",
    "notes": "Brain MRI and electromyography findings support diagnosis but are not mandatory."
  },
