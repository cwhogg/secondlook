  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "CSF analysis typically unremarkable"
    ],
    "imaging": [
      "Radiographs showing bilateral cystic bone lesions with sclerotic margins",
      "Brain MRI demonstrating diffuse white matter abnormalities consistent with sclerosing leukoencephalopathy"
    ],
    "genetic": [
      "TREM2 (causative, loss-of-function)",
      "TYROBP (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology of bone lesions showing lipomembranous osteodysplasia"
    ]
  },
