  "keyFindings": {
    "laboratory": [
      "Low serum C3 with normal C4",
      "Proteinuria and hematuria on urinalysis",
      "Elevated serum creatinine in advanced disease"
    ],
    "imaging": [
      "Renal ultrasound may show normal or increased echogenicity",
      "Ophthalmologic exam may reveal drusen"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Renal biopsy with electron microscopy demonstrating dense deposits",
      "Complement factor H autoantibodies in some cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "c3-glomerulopathy",
      "distinguishingFeatures": [
        "Presence of C3 dominant deposits but lacking dense intramembranous deposits",
        "Variable complement abnormalities"
      ]
    },
    {
      "diseaseId": "immune-complex-glomerulonephritis",
      "distinguishingFeatures": [
        "Presence of immunoglobulin deposits on immunofluorescence",
        "Different electron microscopy findings"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive renal failure",
    "Severe nephrotic syndrome with hypoalbuminemia",
    "Refractory hypertension"
  ],
