  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible immunological abnormalities in some cases"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter changes or delayed myelination",
      "Echocardiogram to identify congenital heart defects"
    ],
    "genetic": [
      "PUF60 (phenotype modifier)"
    ],
    "other": [
      "Neurodevelopmental assessments confirming developmental delay",
      "Audiological evaluation for hearing impairment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "1p36-deletion-syndrome",
      "distinguishingFeatures": [
        "Deletion at chromosome 1p36 rather than 8q24.3",
        "More prominent seizures and cardiomyopathy",
        "Distinct facial features including straight eyebrows and deep-set eyes"
      ]
    },
    {
      "diseaseId": "22q11-2-deletion-syndrome",
      "distinguishingFeatures": [
        "Deletion at chromosome 22q11.2",
        "Characteristic cardiac defects such as tetralogy of Fallot",
        "Immunodeficiency and palatal abnormalities"
      ]
    }
  ],
  "redFlags": [
    "Severe global developmental delay with unknown cause",
    "Presence of multiple congenital anomalies including craniofacial dysmorphism",
    "Unexplained hypotonia and feeding difficulties in infancy"
  ],
