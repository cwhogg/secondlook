  "keyFindings": {
    "laboratory": [
      "Normal or mildly elevated immunoglobulin levels with impaired antibody responses",
      "Lymphopenia or other immune cell abnormalities in some cases"
    ],
    "imaging": [
      "Brain MRI may show nonspecific cerebral atrophy or delayed myelination",
      "Spinal imaging may reveal scoliosis"
    ],
    "genetic": [
      "Duplication of the MECP2 gene on Xq28 detected by array CGH or MLPA",
      "Additional duplications involving IRAK1 and other adjacent genes may be present"
    ],
    "other": [
      "Electroencephalogram (EEG) abnormalities consistent with epilepsy",
      "Developmental assessment confirming intellectual disability"
    ]
  },
