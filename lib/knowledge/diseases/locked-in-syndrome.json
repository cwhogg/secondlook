  "diagnosticCriteria": {
    "formalCriteriaName": "Locked-in Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "quadriplegia",
        "description": "Complete paralysis of all voluntary muscles except for vertical eye movements and blinking",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "preserved-consciousness",
        "description": "Preserved cognitive function and awareness despite paralysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "communication-via-eye-movements",
        "description": "Ability to communicate through vertical eye movements or blinking",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-confirmation",
        "description": "Neuroimaging evidence of ventral pontine lesion",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of quadriplegia with preserved consciousness and ability to communicate via vertical eye movements or blinking",
    "notes": "Diagnosis is clinical and supported by neuroimaging; exclusion of coma or vegetative state is essential"
  },
