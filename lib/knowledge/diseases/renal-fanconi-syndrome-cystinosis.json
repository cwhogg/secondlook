      },
      {
        "symptomName": "Generalized proximal tubular dysfunction",
        "frequency": 0.95,
        "bodySystem": "renal"
      },
      {
        "symptomName": "Fanconi syndrome with aminoaciduria and glucosuria",
        "frequency": 0.9,
        "bodySystem": "renal"
      }
    ],
    "common": [
