  "diagnosticCriteria": {
    "formalCriteriaName": "RegiSCAR criteria",
    "criteria": [
      {
        "id": "fever",
        "description": "Fever above 38.5°C",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eosinophilia",
        "description": "Blood eosinophilia >700/µL or atypical lymphocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rash",
        "description": "Acute skin rash with facial edema",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphadenopathy",
        "description": "Enlarged lymph nodes at two or more sites",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "organInvolvement",
        "description": "Involvement of at least one internal organ (e.g., liver, kidney, lung)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "resolutionAfterDrugWithdrawal",
        "description": "Improvement after discontinuation of the suspected drug",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least three major criteria including fever, eosinophilia, rash, and organ involvement",
    "notes": "Diagnosis requires exclusion of other causes such as infections and autoimmune diseases"
