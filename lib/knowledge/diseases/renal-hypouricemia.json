  "diagnosticCriteria": {
    "formalCriteriaName": "Renal Hypouricemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "low-serum-uric-acid",
        "description": "Serum uric acid concentration below 2.0 mg/dL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "increased-renal-uric-acid-excretion",
        "description": "Elevated fractional excretion of uric acid (>10%) indicating renal urate wasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exercise-induced-acute-kidney-injury",
        "description": "History of exercise-induced acute kidney injury or renal colic",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in SLC22A12 (URAT1) or SLC2A9 genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of low serum uric acid and increased renal uric acid excretion; genetic confirmation or clinical history supportive",
    "notes": "Genetic testing is confirmatory but not mandatory for diagnosis."
  },
