  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (CRP, ESR)",
      "Electrolyte disturbances (hyponatremia, hypokalemia)",
      "Negative autoimmune serology (ANA, anti-desmoglein antibodies)"
    ],
    "imaging": [
      "Chest X-ray may show secondary pneumonia in respiratory involvement"
    ],
    "genetic": [
      "DSP (causative)",
      "JUP (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology showing suprabasal acantholysis with erosive epidermal loss",
      "Negative direct immunofluorescence differentiating from autoimmune blistering diseases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pemphigus-vulgaris",
      "distinguishingFeatures": [
        "Positive direct immunofluorescence with intercellular IgG deposits",
        "Presence of circulating anti-desmoglein antibodies",
        "Less fulminant erosive progression"
      ]
    },
    {
      "diseaseId": "hailey-hailey-disease",
      "distinguishingFeatures": [
        "Chronic recurrent vesiculopustular lesions localized to flexural areas",
        "Histopathology showing suprabasal acantholysis without extensive erosions",
        "Family history of benign familial chronic pemphigus"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive widespread skin erosions with systemic symptoms",
    "Failure to respond to standard immunosuppressive therapy",
    "Signs of sepsis or multiorgan dysfunction"
  ],
