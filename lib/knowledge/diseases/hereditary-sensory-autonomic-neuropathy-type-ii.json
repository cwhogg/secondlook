  "diagnosticCriteria": {
    "formalCriteriaName": "HSAN Diagnostic Criteria",
    "criteria": [
      {
        "id": "sensory-loss",
        "description": "Congenital or early onset loss of pain and temperature sensation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autonomic-dysfunction",
        "description": "Evidence of autonomic nervous system dysfunction such as anhidrosis or orthostatic hypotension",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in relevant genes (e.g., WNK1/HSN2)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-motor-neuropathy",
        "description": "Lack of significant motor neuropathy or muscle weakness",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Nerve biopsy showing loss of small myelinated and unmyelinated fibers",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital or early onset loss of pain and temperature sensation plus autonomic dysfunction with genetic confirmation",
    "notes": "Diagnosis is supported by clinical features and confirmed by genetic testing; nerve biopsy is supportive but not mandatory."
  },
