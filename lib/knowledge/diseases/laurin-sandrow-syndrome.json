  "diagnosticCriteria": {
    "formalCriteriaName": "Laurin-Sandrow Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "polysyndactyly",
        "description": "Presence of postaxial polysyndactyly involving hands and/or feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mirror-image-digits",
        "description": "Mirror-image duplication of digits in hands or feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-nasal-hypoplasia",
        "description": "Hypoplasia or aplasia of the nasal alae and nasal cartilage abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including broad nasal bridge and hypertelorism",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: polysyndactyly, mirror-image digits, and congenital nasal hypoplasia",
    "notes": "Genetic testing may support diagnosis but is not mandatory; clinical presentation is key."
  },
