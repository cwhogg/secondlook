  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed diagnostic criteria for MPS-like syndrome with congenital heart defects and hematopoietic disorders",
    "criteria": [
      {
        "id": "cardiac-defects",
        "description": "Presence of congenital heart defects including valvular abnormalities and septal defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hematopoietic-abnormalities",
        "description": "Hematopoietic disorders such as anemia, thrombocytopenia, or bone marrow dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mucopolysaccharidosis-like-features",
        "description": "Clinical features resembling mucopolysaccharidosis including coarse facial features and skeletal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-glycosaminoglycan-excretion",
        "description": "Elevated urinary glycosaminoglycans with atypical pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with lysosomal or hematopoietic function",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: congenital heart defects, hematopoietic abnormalities, and mucopolysaccharidosis-like clinical features",
    "notes": "Diagnosis is supported by biochemical and genetic testing but primarily clinical."
  },
