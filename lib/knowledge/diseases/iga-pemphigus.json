  "diagnosticCriteria": {
    "formalCriteriaName": "IgA Pemphigus Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of vesiculopustular skin lesions with annular or circinate configuration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "direct-immunofluorescence",
        "description": "Intercellular IgA deposition in the epidermis demonstrated by direct immunofluorescence microscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Intraepidermal neutrophilic pustules with acantholysis on skin biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serology",
        "description": "Presence of circulating IgA autoantibodies targeting desmocollins or desmogleins",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical presentation, direct immunofluorescence showing intercellular IgA, and characteristic histopathology) must be met for diagnosis.",
    "notes": "Serologic testing for circulating IgA autoantibodies supports diagnosis but is not mandatory."
  },
