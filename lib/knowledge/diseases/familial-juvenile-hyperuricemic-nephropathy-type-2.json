  "keyFindings": {
    "laboratory": [
      "Elevated serum uric acid",
      "Mild proteinuria",
      "Elevated serum creatinine with progressive decline in renal function",
      "Mild normocytic anemia"
    ],
    "imaging": [
      "Renal ultrasound showing normal or small kidneys with increased echogenicity",
      "Absence of significant structural abnormalities early in disease"
    ],
    "genetic": [
      "Pathogenic mutations in UMOD gene (uromodulin)"
    ],
    "other": [
      "Family history consistent with autosomal dominant inheritance",
      "Renal biopsy showing tubulointerstitial fibrosis and tubular atrophy"
    ]
  },
