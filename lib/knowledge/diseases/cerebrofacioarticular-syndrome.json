  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for Cerebrofacioarticular Syndrome",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability with developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-hypermobility",
        "description": "Generalized joint hypermobility and contractures affecting multiple joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic variants in TMCO1 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-neuroimaging",
        "description": "Brain MRI showing nonspecific white matter abnormalities or mild ventriculomegaly",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical criteria plus confirmation of TMCO1 pathogenic variant",
    "notes": "Diagnosis relies heavily on molecular genetic confirmation due to phenotypic overlap with other syndromes."
  },
