  "keyFindings": {
    "laboratory": [
      "IgM monoclonal protein on serum protein electrophoresis and immunofixation",
      "Elevated serum viscosity (if symptomatic hyperviscosity)",
      "Anemia (dilutional and/or from marrow infiltration)",
      "Elevated beta-2 microglobulin",
      "Cold agglutinins may be present",
      "Cryoglobulins may be present"
    ],
    "imaging": [
      "CT showing lymphadenopathy, hepatosplenomegaly",
      "PET/CT may show mild FDG uptake (lower than aggressive lymphoma)",
      "Fundoscopic exam showing dilated retinal veins, hemorrhages (hyperviscosity)"
    ],
    "genetic": [
      "MYD88 (somatic)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Bone marrow biopsy showing lymphoplasmacytic infiltration",
      "Flow cytometry: CD19+, CD20+, CD22+, surface IgM+; CD5-, CD10-, CD23 variable",
      "Serum viscosity measurement (normal <1.8 cP; symptomatic usually >4 cP)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "igm-mgus",
      "distinguishingFeatures": [
        "IgM MGUS has no bone marrow infiltration",
        "IgM <3 g/dL",
        "No symptoms related to IgM",
        "Annual monitoring recommended"
      ]
    },
    {
      "diseaseId": "marginal-zone-lymphoma",
      "distinguishingFeatures": [
        "MZL is typically MYD88 wild-type",
        "Different immunophenotype",
        "May secrete IgM but usually lower levels"
      ]
    },
    {
      "diseaseId": "multiple-myeloma-igm",
      "distinguishingFeatures": [
        "IgM myeloma is extremely rare",
        "Lytic bone lesions present",
        "CD138+ plasma cells predominate",
        "MYD88 typically wild-type"
      ]
    },
    {
      "diseaseId": "chronic-lymphocytic-leukemia",
      "distinguishingFeatures": [
        "CLL is CD5+ and CD23+",
        "Lymphocytosis in peripheral blood",
        "Different morphology (small mature lymphocytes)",
        "IgM paraprotein uncommon"
      ]
    }
  ],
  "redFlags": [
    "Symptomatic hyperviscosity (visual changes, confusion, bleeding) - medical emergency requiring plasmapheresis",
    "Severe cold agglutinin hemolytic anemia",
    "Bing-Neel syndrome (CNS infiltration)",
    "Rapid rise in IgM level suggesting disease transformation",
    "Transformation to diffuse large B-cell lymphoma (Richter-like)"
  ],
  "specialistType": [
