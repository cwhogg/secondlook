  "diagnosticCriteria": {
    "formalCriteriaName": "Neurotrophic Keratopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "corneal-anesthesia",
        "description": "Reduced or absent corneal sensitivity confirmed by esthesiometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "corneal-epithelial-defects",
        "description": "Persistent corneal epithelial defects or ulcers refractory to conventional treatment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-infection",
        "description": "Exclusion of infectious keratitis and other causes of corneal ulceration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "history-neuropathy",
        "description": "History of trigeminal nerve injury or disease affecting corneal innervation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of corneal anesthesia and persistent epithelial defects with exclusion of infectious causes",
    "notes": "Diagnosis is clinical and supported by corneal sensitivity testing and exclusion of other etiologies."
  },
