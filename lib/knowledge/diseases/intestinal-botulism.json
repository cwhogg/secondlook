  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Laboratory Diagnostic Criteria for Intestinal Botulism",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive symmetrical cranial nerve palsies followed by descending flaccid paralysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "toxin-detection",
        "description": "Detection of botulinum neurotoxin in serum, stool, or intestinal contents",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of wound or foodborne botulism and other neuromuscular disorders",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electrophysiological studies showing characteristic decremental response on repetitive nerve stimulation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cranial nerve palsies with descending paralysis plus detection of botulinum toxin in biological samples and exclusion of other botulism forms",
    "notes": "Diagnosis is often clinical supported by toxin assays; intestinal colonization confirmed by stool culture or toxin detection."
  },
