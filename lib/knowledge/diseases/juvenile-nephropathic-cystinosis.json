  "diagnosticCriteria": {
    "formalCriteriaName": "Juvenile Nephropathic Cystinosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "cystine-crystal-detection",
        "description": "Detection of cystine crystals in leukocytes or corneal epithelium",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ctns-gene-mutation",
        "description": "Identification of pathogenic mutations in the CTNS gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-fanconi-syndrome",
        "description": "Presence of renal Fanconi syndrome with proximal tubular dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "corneal-photophobia",
        "description": "Clinical evidence of photophobia due to corneal cystine crystal accumulation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of cystine crystal accumulation plus either CTNS gene mutation or clinical evidence of renal Fanconi syndrome",
    "notes": "Diagnosis is confirmed by biochemical cystine measurement and genetic testing."
  },
