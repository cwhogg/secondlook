  "diagnosticCriteria": {
    "formalCriteriaName": "Aicardi-Goutières syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "intracranial-calcifications",
        "description": "Presence of intracranial calcifications predominantly in basal ganglia and white matter on neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chronic-csf-lymphocytosis",
        "description": "Chronic lymphocytosis in cerebrospinal fluid with elevated interferon-alpha levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "leukodystrophy",
        "description": "Progressive white matter abnormalities consistent with leukodystrophy on MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in AGS-associated genes (e.g., TREX1, RNASEH2A-D, SAMHD1, ADAR1, IFIH1)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Early onset encephalopathy with developmental delay, spasticity, and microcephaly",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of intracranial calcifications, chronic CSF lymphocytosis, and leukodystrophy on MRI, with or without genetic confirmation",
    "notes": "Genetic testing supports diagnosis but is not mandatory if clinical and radiological criteria are met."
  },
