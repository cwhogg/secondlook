  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Toriello-Carey syndrome",
    "criteria": [
      {
        "id": "cleft-palate",
        "description": "Presence of cleft lip and/or cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia with developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial dysmorphism including broad nasal bridge, micrognathia, and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-malformations",
        "description": "Structural brain abnormalities such as agenesis of corpus callosum or ventriculomegaly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: cleft lip/palate, neonatal hypotonia with developmental delay, and distinctive facial features",
    "notes": "Genetic testing may support diagnosis but no single gene mutation has been definitively identified."
  },
