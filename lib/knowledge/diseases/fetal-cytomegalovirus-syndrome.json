  "keyFindings": {
    "laboratory": [
      "Detection of CMV DNA by PCR in urine, saliva, or blood",
      "Thrombocytopenia on complete blood count",
      "Elevated liver enzymes"
    ],
    "imaging": [
      "Periventricular intracranial calcifications on cranial ultrasound or CT",
      "Ventriculomegaly and white matter abnormalities on MRI",
      "Chorioretinitis on ophthalmologic exam"
    ],
    "genetic": [
      "No specific genetic mutations; diagnosis based on viral detection"
    ],
    "other": [
      "Sensorineural hearing loss confirmed by audiometry",
      "Clinical signs such as petechiae, jaundice, and hepatosplenomegaly"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "toxoplasmosis-congenital",
      "distinguishingFeatures": [
        "Presence of intracranial calcifications but typically diffuse rather than periventricular",
        "Positive Toxoplasma gondii serology"
      ]
    },
    {
      "diseaseId": "rubella-congenital-syndrome",
      "distinguishingFeatures": [
        "Cardiac defects such as patent ductus arteriosus",
        "Cataracts and sensorineural deafness with maternal rubella infection history"
      ]
    }
  ],
  "redFlags": [
