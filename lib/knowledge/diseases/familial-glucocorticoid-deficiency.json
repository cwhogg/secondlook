  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Glucocorticoid Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "low-cortisol-high-acth",
        "description": "Low serum cortisol levels with markedly elevated plasma ACTH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-mineralocorticoids",
        "description": "Normal aldosterone and electrolyte levels indicating isolated glucocorticoid deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in MC2R or MRAP genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-adrenal-autoantibodies",
        "description": "Negative adrenal autoantibodies excluding autoimmune adrenalitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of low cortisol with elevated ACTH and normal mineralocorticoid function",
    "notes": "Genetic testing supports diagnosis but is not mandatory"
  },
