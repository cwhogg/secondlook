  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Criteria for Caudal Regression Syndrome",
    "criteria": [
      {
        "id": "sacral-agenesis",
        "description": "Partial or complete agenesis of the sacrum and lower lumbar vertebrae",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lower-limb-malformations",
        "description": "Lower limb deformities including clubfoot, hypoplasia, or contractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-deficits",
        "description": "Neurological impairment affecting lower extremities and bladder/bowel function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "associated-anomalies",
        "description": "Presence of associated genitourinary or gastrointestinal malformations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of sacral agenesis with at least one lower limb malformation and neurological deficit consistent with caudal spinal cord involvement",
    "notes": "Diagnosis is primarily clinical supported by imaging studies such as spinal radiographs and MRI."
  },
