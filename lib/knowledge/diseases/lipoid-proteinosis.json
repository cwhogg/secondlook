        "Systemic involvement common",
        "Different histopathological staining"
      ]
    },
    {
      "diseaseId": "mucopolysaccharidoses",
      "distinguishingFeatures": [
        "Presence of systemic skeletal abnormalities",
        "Different genetic mutations",
        "Absence of characteristic eyelid papules"
      ]
    }
  ],
