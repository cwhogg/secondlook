  "diagnosticCriteria": {
    "formalCriteriaName": "Eiken Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "delayed-endochondral-ossification",
        "description": "Radiographic evidence of markedly delayed endochondral ossification with normal membranous ossification",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-dysmorphism",
        "description": "Presence of characteristic skeletal abnormalities including metaphyseal widening and platyspondyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Clinical features such as short stature and delayed motor milestones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in the PTHR1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development despite skeletal abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: delayed endochondral ossification on imaging, characteristic skeletal dysmorphism, and clinical presentation of short stature/delayed milestones",
    "notes": "Genetic testing for PTHR1 mutations supports diagnosis but is not mandatory."
  },
