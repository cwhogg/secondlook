  "keyFindings": {
    "laboratory": [
      "Thrombocytopenia with abnormal platelet aggregation",
      "Prolonged bleeding time",
      "Variable immunoglobulin levels"
    ],
    "imaging": [
      "Echocardiogram showing congenital heart defects",
      "Renal ultrasound revealing structural anomalies",
      "Brain MRI may show nonspecific findings"
    ],
    "genetic": [
      "Fluorescence in situ hybridization (FISH) or microarray confirming terminal 11q deletion",
      "Karyotyping showing deletion of chromosome 11q"
    ],
