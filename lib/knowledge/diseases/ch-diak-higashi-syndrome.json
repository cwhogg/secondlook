  "keyFindings": {
    "laboratory": [
      "Peripheral blood smear showing giant azurophilic granules in neutrophils and other leukocytes",
      "Neutropenia and thrombocytopenia",
      "Impaired neutrophil oxidative burst and natural killer cell function"
    ],
    "imaging": [
      "MRI brain may show cerebral and cerebellar atrophy in advanced stages",
      "Chest X-ray may reveal recurrent pneumonia or pulmonary infiltrates"
    ],
    "genetic": [
      "LYST (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Bone marrow examination may show hemophagocytosis during accelerated phase",
      "Hair microscopy revealing large melanin granules"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "griscelli-syndrome",
      "distinguishingFeatures": [
        "Absence of giant lysosomal granules in leukocytes",
        "Different genetic mutations (MYO5A, RAB27A)",
        "More severe neurological involvement early on"
      ]
    },
    {
      "diseaseId": "hereditary-hemophagocytic-lymphohistiocytosis",
      "distinguishingFeatures": [
        "Lack of oculocutaneous albinism",
        "Different genetic causes (PRF1, UNC13D, STX11)",
        "Predominantly immune dysregulation without pigmentary abnormalities"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset of hemophagocytic lymphohistiocytosis (accelerated phase)",
    "Severe recurrent bacterial infections in infancy",
    "Progressive neurological deterioration with ataxia and seizures"
  ],
