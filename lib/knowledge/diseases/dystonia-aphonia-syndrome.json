  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Dystonia-Aphonia Syndrome",
    "criteria": [
      {
        "id": "laryngeal-dystonia",
        "description": "Presence of sustained or intermittent involuntary muscle contractions causing abnormal laryngeal postures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aphonia",
        "description": "Complete or near-complete loss of voice due to laryngeal muscle dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of structural, neoplastic, infectious, or neurodegenerative causes of aphonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-botulinum-toxin",
        "description": "Improvement of symptoms following botulinum toxin injection into laryngeal muscles",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-neurological-comorbidities",
        "description": "No evidence of other neurological disorders causing dystonia or aphonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of laryngeal dystonia and aphonia with exclusion of other causes",
    "notes": "Diagnosis is primarily clinical supported by laryngoscopic examination and response to treatment"
  },
