  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of metabolic causes of myoclonus and seizures"
    ],
    "imaging": [
      "Brain MRI typically normal or nonspecific cortical atrophy in advanced cases"
    ],
    "genetic": [
      "Pathogenic pentanucleotide repeat expansions in SAMD12, STARD7, MARCH6, or YEATS2 genes"
    ],
    "other": [
      "EEG showing cortical reflex myoclonus and generalized epileptiform discharges",
      "Electromyography (EMG) demonstrating cortical myoclonus"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "juvenile-myoclonic-epilepsy",
      "distinguishingFeatures": [
        "Earlier onset in adolescence",
        "Characteristic 4-6 Hz polyspike and wave EEG pattern",
        "No autosomal dominant inheritance pattern"
      ]
    },
    {
      "diseaseId": "essential-tremor",
      "distinguishingFeatures": [
        "Absence of epileptic seizures",
        "Tremor without cortical myoclonus",
        "No family history of epilepsy"
      ]
    },
    {
      "diseaseId": "progressive-myoclonic-epilepsies",
      "distinguishingFeatures": [
        "Progressive neurological deterioration",
        "Early onset in childhood or adolescence",
        "Additional systemic involvement"
      ]
    }
  ],
  "redFlags": [
    "Onset before age 18",
    "Rapid neurological deterioration",
    "Status epilepticus or refractory seizures"
  ],
