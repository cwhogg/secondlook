  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Radiologic and Histopathologic Criteria for PPFE",
    "criteria": [
      {
        "id": "pleural-thickening",
        "description": "Bilateral upper lobe pleural thickening predominantly involving the visceral pleura",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "subpleural-fibrosis",
        "description": "Subpleural fibroelastosis with dense elastotic fibrosis in the upper lobes on histopathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "restrictive-physiology",
        "description": "Restrictive ventilatory defect on pulmonary function testing",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-ILD",
        "description": "Exclusion of other known interstitial lung diseases",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral upper lobe pleural thickening and subpleural fibroelastosis on histopathology with exclusion of other ILDs",
    "notes": "Diagnosis often requires multidisciplinary discussion including radiology, pathology, and clinical correlation."
  },
