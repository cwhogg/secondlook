  "diagnosticCriteria": {
    "formalCriteriaName": "Fanconi Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "generalized-proximal-tubule-dysfunction",
        "description": "Evidence of generalized proximal tubular dysfunction including aminoaciduria, glycosuria, and phosphaturia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypophosphatemia",
        "description": "Persistent hypophosphatemia due to renal phosphate wasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-tubular-acidosis",
        "description": "Presence of proximal (type 2) renal tubular acidosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with proximal tubule function",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized proximal tubular dysfunction with at least two major criteria (aminoaciduria, glycosuria, phosphaturia) plus hypophosphatemia and renal tubular acidosis",
    "notes": "Diagnosis is supported by genetic testing and family history but primarily based on biochemical and clinical findings."
  },
