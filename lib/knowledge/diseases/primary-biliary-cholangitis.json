  "keyFindings": {
    "laboratory": [
      "AMA positive (>95%; anti-M2 component most specific)",
      "Elevated ALP (cholestatic pattern)",
      "Elevated GGT",
      "Elevated IgM (polyclonal)",
      "Elevated total cholesterol (especially with advanced cholestasis)",
      "ALT/AST mildly elevated",
      "Bilirubin elevated in advanced disease (prognostic marker)",
      "PBC-specific ANA: anti-sp100 (nuclear dots), anti-gp210 (nuclear membrane)"
    ],
    "imaging": [
      "Ultrasound: normal or hepatomegaly; excludes biliary obstruction",
      "MRCP: normal intrahepatic and extrahepatic bile ducts (distinguishes from PSC)",
      "Transient elastography: liver stiffness for fibrosis staging",
      "DEXA scan: osteoporosis screening"
    ],
    "genetic": [
      "IL12RB1 (susceptibility)",
      "SPIB (susceptibility)",
      "IL12A (susceptibility)",
      "IRF5 (susceptibility)",
      "TNPO3 (susceptibility)",
      "MMEL1 (susceptibility)",
      "POU2AF1 (susceptibility)",
      "TNFSF15 (susceptibility)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Liver biopsy: florid duct lesion (granulomatous cholangitis), portal inflammation, ductopenia, fibrosis staging (Ludwig stages I-IV or Scheuer stages)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "primary-sclerosing-cholangitis",
      "distinguishingFeatures": [
        "Characteristic bile duct changes on MRCP (beading/strictures)",
        "IBD association",
        "Male predominance",
        "AMA negative"
      ]
    },
    {
      "diseaseId": "autoimmune-hepatitis",
      "distinguishingFeatures": [
        "Hepatocellular enzyme pattern",
        "ANA/SMA positive",
        "Interface hepatitis on biopsy",
        "Can overlap with PBC"
      ]
    },
    {
      "diseaseId": "drug-induced-cholestasis",
      "distinguishingFeatures": [
        "Temporal drug relationship",
        "AMA negative",
        "Resolution after drug withdrawal"
      ]
    },
    {
      "diseaseId": "sarcoidosis",
      "distinguishingFeatures": [
        "Non-caseating granulomas",
        "Bilateral hilar lymphadenopathy",
        "Multi-organ involvement",
        "Elevated ACE"
      ]
    }
  ],
  "redFlags": [
    "Rising bilirubin (indicates progressive disease/need for transplant evaluation)",
    "Development of portal hypertension/variceal bleeding",
    "Intractable pruritus unresponsive to therapy",
    "Inadequate response to UDCA (ALP >1.67x ULN after 12 months of therapy)",
    "Overlap features with autoimmune hepatitis (elevated ALT, high IgG)"
  ],
