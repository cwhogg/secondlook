  "diagnosticCriteria": {
    "formalCriteriaName": "Solar Urticaria Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Development of urticarial wheals and pruritus within minutes of sun exposure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "phototesting",
        "description": "Positive phototesting reproducing urticarial lesions at specific wavelengths and minimal erythema dose",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-photosensitivity",
        "description": "Exclusion of other photosensitive disorders such as polymorphic light eruption or lupus erythematosus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-antihistamines",
        "description": "Improvement of symptoms with antihistamine therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic urticarial lesions within minutes of sun exposure plus positive phototesting and exclusion of other photosensitive dermatoses",
    "notes": "Phototesting is essential to confirm diagnosis and identify triggering wavelengths."
  },
