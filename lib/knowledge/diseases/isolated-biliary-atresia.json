      "Elevated gamma-glutamyl transferase (GGT)",
      "Prolonged prothrombin time due to vitamin K deficiency"
    ],
    "imaging": [
      "Absent or abnormal gallbladder on ultrasound",
      "Triangular cord sign on ultrasound",
      "Absent extrahepatic bile ducts on cholangiography"
    ],
    "genetic": [
      "No consistent genetic mutation identified; mostly sporadic",
      "Multigenic/multifactorial inheritance"
    ],
