  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Machado-Joseph Disease",
    "criteria": [
      {
        "id": "ataxia",
        "description": "Progressive cerebellar ataxia with gait disturbance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ophthalmoplegia",
        "description": "External ophthalmoplegia and diplopia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Presence of expanded CAG trinucleotide repeats in the ATXN3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pyramidal-signs",
        "description": "Spasticity and hyperreflexia indicating pyramidal tract involvement",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "peripheral-neuropathy",
        "description": "Electrophysiological evidence of peripheral neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive cerebellar ataxia plus genetic confirmation of ATXN3 CAG repeat expansion",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical features may vary among patients."
  },
