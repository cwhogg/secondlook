  "diagnosticCriteria": {
    "formalCriteriaName": "FNAIT Diagnostic Criteria",
    "criteria": [
      {
        "id": "maternal-alloantibodies",
        "description": "Detection of maternal platelet-specific alloantibodies against fetal platelet antigens",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neonatal-thrombocytopenia",
        "description": "Severe thrombocytopenia in the neonate (platelet count <50 x10^9/L) at birth or within first days of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of neonatal thrombocytopenia such as infections or genetic thrombocytopenias",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "history-previous-affected-sibling",
        "description": "History of previous sibling affected by thrombocytopenia or bleeding",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-ivig",
        "description": "Improvement in platelet counts following maternal intravenous immunoglobulin therapy during pregnancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of neonatal thrombocytopenia with detection of maternal platelet-specific alloantibodies and exclusion of other causes",
    "notes": "Diagnosis is confirmed by serological testing and clinical presentation; prenatal diagnosis may be considered in at-risk pregnancies."
  },
