  "diagnosticCriteria": {
    "formalCriteriaName": "STAT3 Gain-of-Function Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of heterozygous gain-of-function mutation in STAT3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoimmune-manifestations",
        "description": "Clinical evidence of autoimmune disease such as autoimmune cytopenias or endocrinopathies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphoproliferation",
        "description": "Lymphadenopathy, hepatosplenomegaly, or lymphoid hyperplasia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "recurrent-infections",
        "description": "History of recurrent or severe infections, particularly bacterial or viral",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "immunologic-abnormalities",
        "description": "Laboratory evidence of immune dysregulation including hypogammaglobulinemia or altered lymphocyte subsets",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of a pathogenic STAT3 gain-of-function mutation plus at least one major clinical criterion (autoimmunity or lymphoproliferation)",
    "notes": "Genetic testing is essential for confirmation; clinical presentation is variable."
  },
