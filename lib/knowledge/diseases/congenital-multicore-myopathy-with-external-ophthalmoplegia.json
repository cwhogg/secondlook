  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate elevation)",
      "Normal or mildly elevated lactate"
    ],
    "imaging": [
      "Muscle MRI showing selective involvement of axial and proximal muscles",
      "Chest X-ray or fluoroscopy showing diaphragmatic elevation"
    ],
    "genetic": [
      "RYR1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy with multiple cores on oxidative enzyme stains (NADH-TR, SDH)",
      "Electromyography showing myopathic changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "central-core-disease",
      "distinguishingFeatures": [
        "Single large core lesions on muscle biopsy",
        "Usually no external ophthalmoplegia"
      ]
    },
    {
      "diseaseId": "nemaline-myopathy",
      "distinguishingFeatures": [
        "Presence of nemaline rods on muscle biopsy",
        "Less frequent ophthalmoplegia"
      ]
    },
    {
      "diseaseId": "mitochondrial-myopathy",
      "distinguishingFeatures": [
        "Ragged red fibers on muscle biopsy",
        "Systemic mitochondrial involvement"
      ]
    }
  ],
