  "differentialDiagnoses": [
    {
      "diseaseId": "split-hand-foot-malformation",
      "distinguishingFeatures": [
        "Isolated limb malformations without ectodermal or clefting anomalies",
        "No TP63 mutations"
      ]
    },
    {
      "diseaseId": "ankyloblepharon-ectodermal-dysplasia-clefting-syndrome",
      "distinguishingFeatures": [
        "Presence of ankyloblepharon (eyelid fusion)",
        "Different TP63 mutation spectrum",
        "Distinct facial features"
      ]
    },
    {
      "diseaseId": "rapp-hodgkin-syndrome",
      "distinguishingFeatures": [
        "Ectodermal dysplasia with cleft lip/palate but no ectrodactyly",
        "Different genetic mutations"
      ]
    }
  ],
