  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Pontocerebellar Hypoplasia Type 2",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Severe neonatal or early infantile onset of progressive microcephaly and profound developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing hypoplasia and atrophy of the cerebellum and pons with characteristic 'dragonfly' or 'butterfly' shaped cerebellar hemispheres",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the TSEN54 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-signs",
        "description": "Presence of extrapyramidal movement disorders such as dystonia and choreoathetosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "electrophysiology",
        "description": "Abnormal EEG with epileptiform activity or seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus characteristic neuroimaging findings and confirmation by genetic testing",
    "notes": "Genetic confirmation is considered definitive; neuroimaging is essential for supporting diagnosis."
  },
