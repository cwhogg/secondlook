  "diagnosticCriteria": {
    "formalCriteriaName": "Prenatal and postnatal diagnostic criteria for bilateral renal agenesis",
    "criteria": [
      {
        "id": "absent-kidneys-imaging",
        "description": "Absence of both kidneys confirmed by prenatal ultrasound or postnatal imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oligohydramnios",
        "description": "Severe oligohydramnios or anhydramnios detected prenatally",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-hypoplasia",
        "description": "Evidence of pulmonary hypoplasia secondary to oligohydramnios",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-urinary-bladder",
        "description": "Non-visualization of urinary bladder on prenatal ultrasound",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Absence of both kidneys on imaging plus severe oligohydramnios or absent urinary bladder visualization",
    "notes": "Diagnosis is often made prenatally via ultrasound; postnatal confirmation is rare due to perinatal lethality."
  },
