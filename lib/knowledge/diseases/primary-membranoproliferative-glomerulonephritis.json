  "keyFindings": {
    "laboratory": [
      "Low serum complement C3 levels",
      "Proteinuria >3.5 g/day",
      "Microscopic hematuria with dysmorphic red blood cells",
      "Elevated serum creatinine and blood urea nitrogen"
    ],
    "imaging": [
      "Renal ultrasound showing normal or increased kidney size in early disease",
      "Possible signs of renal parenchymal changes in advanced disease"
    ],
    "genetic": [
      "No specific genetic mutation identified for primary MPGN; familial cases rare"
    ],
    "other": [
      "Renal biopsy with light microscopy showing mesangial hypercellularity and basement membrane duplication",
      "Immunofluorescence positive for C3 and IgG deposits"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "secondary-membranoproliferative-glomerulonephritis",
      "distinguishingFeatures": [
        "Presence of underlying systemic disease such as hepatitis C, autoimmune disorders, or monoclonal gammopathy",
        "Serologic markers positive for secondary causes",
        "Different immunofluorescence patterns"
      ]
    },
    {
      "diseaseId": "dense-deposit-disease",
      "distinguishingFeatures": [
        "Electron microscopy showing dense intramembranous deposits",
        "More profound complement dysregulation",
        "Usually low C3 with normal C4 levels"
      ]
    }
  ],
  "redFlags": [
