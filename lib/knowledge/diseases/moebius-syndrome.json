  "keyFindings": {
    "laboratory": [
      "No specific laboratory abnormalities; used to exclude other conditions"
    ],
    "imaging": [
      "MRI may show hypoplasia or absence of facial and abducens cranial nerve nuclei",
      "Brainstem abnormalities on MRI"
    ],
    "genetic": [
      "Mutations in PLXND1 and REV3L genes reported in some cases",
      "Mostly sporadic with rare familial cases"
    ],
    "other": [
      "Electromyography shows denervation of facial muscles",
      "Clinical diagnosis based on cranial nerve palsies"
    ]
