  "diagnosticCriteria": {
    "formalCriteriaName": "No standardized formal criteria",
    "criteria": [
      {
        "id": "dynamic-airway-collapse",
        "description": "Dynamic collapse of the tracheal walls during expiration demonstrated by bronchoscopy or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-respiratory-symptoms",
        "description": "Presence of characteristic respiratory symptoms such as stridor, barking cough, or recurrent respiratory infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-secondary-causes",
        "description": "Exclusion of acquired or secondary causes of tracheomalacia such as prolonged intubation or external compression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-confirmation",
        "description": "Imaging evidence (CT or MRI) supporting tracheal wall weakness or malacia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of dynamic airway collapse on bronchoscopy or imaging plus characteristic respiratory symptoms, with exclusion of secondary causes",
    "notes": "Diagnosis is primarily clinical supported by bronchoscopy; no universally accepted diagnostic criteria exist."
  },
