  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (ESR, CRP)",
      "Positive anti-type II collagen antibodies (variable)",
      "Normocytic anemia"
    ],
    "imaging": [
      "CT/MRI showing airway cartilage inflammation and thickening",
      "Echocardiography demonstrating aortic root dilation or valvular abnormalities",
      "MRI brain for neurological involvement"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Biopsy of affected cartilage showing inflammatory infiltrates with cartilage destruction"
    ]
  },
