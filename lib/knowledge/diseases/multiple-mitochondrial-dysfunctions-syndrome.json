  "diagnosticCriteria": {
    "formalCriteriaName": "MMDS Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early onset progressive encephalopathy with developmental delay and regression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-evidence",
        "description": "Deficient activity of multiple mitochondrial respiratory chain complexes in muscle or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in genes encoding mitochondrial Fe-S cluster assembly proteins (e.g., NFU1, BOLA3, IBA57, ISCA2)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging-findings",
        "description": "Brain MRI showing leukoencephalopathy with cavitating lesions",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "lactic-acidosis",
        "description": "Elevated blood or CSF lactate levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early onset progressive encephalopathy, biochemical evidence of multiple respiratory chain deficiencies, and genetic confirmation of pathogenic variants in mitochondrial Fe-S cluster assembly genes",
    "notes": "Diagnosis requires integration of clinical, biochemical, and genetic data due to phenotypic overlap with other mitochondrial disorders."
  },
