  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnosis of Triploidy Syndrome",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Presence of a triploid karyotype (69 chromosomes) confirmed by cytogenetic analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Severe intrauterine growth restriction detected prenatally or at birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial abnormalities including micrognathia, cleft lip/palate, and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "limb-malformations",
        "description": "Presence of syndactyly or other limb anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-anomalies",
        "description": "Congenital renal malformations such as cystic kidneys",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of triploidy plus at least one major clinical feature",
    "notes": "Prenatal diagnosis is often made via ultrasound and confirmed by karyotyping or molecular genetic testing."
  },
