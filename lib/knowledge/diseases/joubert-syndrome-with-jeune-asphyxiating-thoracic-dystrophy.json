  "diagnosticCriteria": {
    "formalCriteriaName": "Combined Diagnostic Criteria for Joubert Syndrome and Jeune Asphyxiating Thoracic Dystrophy",
    "criteria": [
      {
        "id": "molar-tooth-sign",
        "description": "Presence of the molar tooth sign on brain MRI indicating cerebellar vermis hypoplasia/dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "narrow-thorax",
        "description": "Radiographic evidence of a narrow, bell-shaped thorax consistent with Jeune asphyxiating thoracic dystrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "respiratory-distress",
        "description": "Neonatal or early infancy respiratory distress due to thoracic insufficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Central hypotonia in infancy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-dysplasia",
        "description": "Evidence of renal cystic dysplasia or nephronophthisis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "polydactyly",
        "description": "Postaxial polydactyly",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of molar tooth sign on MRI plus radiographic evidence of narrow thorax and clinical respiratory distress in infancy",
    "notes": "Genetic testing can support diagnosis but is not mandatory; multidisciplinary evaluation recommended."
  },
