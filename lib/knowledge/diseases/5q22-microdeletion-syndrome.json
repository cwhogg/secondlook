  "diagnosticCriteria": {
    "formalCriteriaName": "Chromosomal Microdeletion Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of a microdeletion involving the 5q22 chromosomal region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Presence of global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-malformations",
        "description": "Presence of congenital anomalies such as craniofacial dysmorphism or skeletal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurobehavioral-features",
        "description": "Neurobehavioral abnormalities including hypotonia and autistic features",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 5q22 microdeletion plus presence of at least two major clinical features including developmental delay and congenital malformations",
    "notes": "Diagnosis relies heavily on genetic testing due to phenotypic variability."
  },
