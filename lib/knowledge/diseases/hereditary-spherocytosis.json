{
  "id": "hereditary-spherocytosis",
  "name": "Hereditary Spherocytosis",
  "aliases": [
    "HS",
    "Minkowski-Chauffard Disease",
    "Congenital Spherocytic Anemia",
    "Spherocytic Hemolytic Anemia"
  ],
  "icd10Codes": ["D58.0"],
  "omimId": "182900",
  "orphanetId": "822",
  "prevalence": {
    "estimate": "1 in 2,000 to 1 in 5,000 in Northern European populations",
    "range": "0.02%-0.05%",
    "classification": "uncommon"
  },
  "demographics": {
    "typicalOnsetAge": { "min": 0, "max": 30, "peak": 5 },
    "sexPredilection": "equal",
    "ethnicAssociations": [
      "Northern European",
      "Japanese (recessive forms)"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "British Committee for Standards in Haematology (BCSH) Guidelines",
    "criteria": [
      {
        "id": "hs-c1",
        "description": "Family history of spherocytosis or compatible symptoms",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hs-c2",
        "description": "Spherocytes on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hs-c3",
        "description": "Positive direct antiglobulin test (DAT/Coombs) is NEGATIVE (excludes autoimmune)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hs-c4",
        "description": "Positive eosin-5-maleimide (EMA) binding test (decreased fluorescence)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hs-c5",
        "description": "Increased osmotic fragility (incubated)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hs-c6",
        "description": "Elevated MCHC (>36 g/dL)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hs-c7",
        "description": "Elevated reticulocyte count",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical hemolytic anemia with spherocytes on smear, negative DAT, and positive EMA binding test or osmotic fragility; family history supports but is not always present (de novo mutations ~25%)",
    "notes": "Severity ranges from asymptomatic carrier to severe transfusion-dependent hemolytic anemia. SDS-PAGE of red cell membrane proteins can identify specific protein deficiencies."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Spherocytes on peripheral blood smear",
        "snomedCode": "30800001",
        "frequency": 0.95,
        "bodySystem": "hematologic",
        "notes": "Dense round RBCs lacking central pallor"
      }
    ],
    "common": [
      {
        "symptomName": "Jaundice (intermittent or chronic)",
        "snomedCode": "18165001",
        "frequency": 0.8,
        "bodySystem": "hepatic"
      },
      {
        "symptomName": "Anemia",
        "snomedCode": "271737000",
        "frequency": 0.75,
        "bodySystem": "hematologic"
      },
      {
        "symptomName": "Splenomegaly",
        "snomedCode": "16294009",
        "frequency": 0.75,
        "bodySystem": "hematologic"
      },
      {
        "symptomName": "Fatigue",
        "snomedCode": "84229001",
        "frequency": 0.7,
        "bodySystem": "constitutional"
      },
      {
        "symptomName": "Dark urine (bilirubinuria)",
        "snomedCode": "720451001",
        "frequency": 0.5,
        "bodySystem": "renal"
      }
    ],
    "occasional": [
      {
        "symptomName": "Gallstones (pigmented bilirubin stones)",
        "snomedCode": "235919008",
        "frequency": 0.4,
        "bodySystem": "gastrointestinal",
        "notes": "Can present in childhood; occur in up to 50% by adulthood"
      },
      {
        "symptomName": "Aplastic crisis (from parvovirus B19)",
        "snomedCode": "191245005",
        "frequency": 0.25,
        "bodySystem": "hematologic",
        "notes": "Acute severe anemia from transient red cell aplasia"
      },
      {
        "symptomName": "Neonatal hyperbilirubinemia",
        "snomedCode": "387712008",
        "frequency": 0.3,
        "bodySystem": "hepatic",
        "notes": "May require phototherapy or exchange transfusion"
      },
      {
        "symptomName": "Exercise intolerance",
        "snomedCode": "413839001",
        "frequency": 0.35,
        "bodySystem": "constitutional"
      }
    ],
    "rare": [
      {
        "symptomName": "Hemolytic crisis",
        "snomedCode": "55602000",
        "frequency": 0.1,
        "bodySystem": "hematologic",
        "notes": "Triggered by infections"
      },
      {
        "symptomName": "Extramedullary hematopoiesis",
        "snomedCode": "30380007",
        "frequency": 0.05,
        "bodySystem": "hematologic",
        "notes": "In severe untreated cases"
      },
      {
        "symptomName": "Leg ulcers",
        "snomedCode": "95345008",
        "frequency": 0.03,
        "bodySystem": "integumentary"
      }
    ]
  },
  "systemsAffected": [
    "hematologic",
    "hepatic",
    "gastrointestinal",
    "constitutional"
  ],
  "keyFindings": {
    "laboratory": [
      "Spherocytes on peripheral blood smear",
      "Elevated reticulocyte count",
      "Elevated MCHC (>36 g/dL)",
      "Elevated indirect bilirubin",
      "Elevated LDH, decreased haptoglobin",
      "Negative direct antiglobulin test (Coombs test)",
      "Decreased EMA binding on flow cytometry",
      "Increased incubated osmotic fragility"
    ],
    "imaging": [
      "Abdominal ultrasound showing splenomegaly",
      "Gallbladder ultrasound may show pigmented gallstones"
    ],
    "genetic": [
      "ANK1 mutations (ankyrin-1 deficiency) most common (~40-65%)",
      "SLC4A1 mutations (band 3 deficiency)",
      "SPTB mutations (beta-spectrin deficiency)",
      "EPB41 mutations (protein 4.1 deficiency)",
      "EPB42 mutations (protein 4.2 deficiency)",
      "Autosomal dominant in ~75% of cases; recessive in ~25%"
    ],
    "other": [
      "SDS-PAGE analysis of red cell membrane proteins",
      "Cryohemolysis test",
      "Acidified glycerol lysis test"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autoimmune-hemolytic-anemia",
      "distinguishingFeatures": [
        "Positive direct antiglobulin test (Coombs test)",
        "No family history of hemolysis",
        "Often associated with autoimmune conditions or lymphoma"
      ]
    },
    {
      "diseaseId": "hereditary-elliptocytosis",
      "distinguishingFeatures": [
        "Elliptocytes rather than spherocytes on smear",
        "Often milder hemolysis",
        "Different membrane protein deficiencies"
      ]
    },
    {
      "diseaseId": "glucose-6-phosphate-dehydrogenase-deficiency",
      "distinguishingFeatures": [
        "Episodic hemolysis triggered by oxidative stress",
        "Heinz bodies and bite cells on smear",
        "X-linked inheritance",
        "G6PD enzyme assay abnormal"
      ]
    }
  ],
  "redFlags": [
    "Sudden severe anemia (aplastic crisis from parvovirus B19)",
    "Severe neonatal hyperbilirubinemia requiring exchange transfusion",
    "Progressive splenomegaly with hypersplenism",
    "Biliary colic or acute cholecystitis from pigmented gallstones",
    "Post-splenectomy sepsis (overwhelming post-splenectomy infection)"
  ],
  "specialistType": [
    "Hematologist",
    "Pediatric Hematologist",
    "General Surgeon (for splenectomy consideration)",
    "Medical Geneticist"
  ],
  "lastUpdated": "2026-02-17",
  "references": [
