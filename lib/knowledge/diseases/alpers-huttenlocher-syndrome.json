  "keyFindings": {
    "laboratory": [
      "Elevated serum transaminases and ammonia",
      "Lactic acidosis in blood and CSF",
      "Decreased mitochondrial DNA copy number in liver or muscle biopsy"
    ],
    "imaging": [
      "Cortical and subcortical atrophy on brain MRI",
      "Signal abnormalities in cerebral gray matter",
      "Liver imaging showing hepatomegaly or cirrhosis"
    ],
    "genetic": [
      "DBH (causative)",
      "Mitochondrial DNA depletion in affected tissues",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy showing mitochondrial abnormalities",
      "EEG demonstrating epileptiform activity"
    ]
  },
