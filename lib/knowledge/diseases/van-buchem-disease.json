  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "No specific biochemical markers"
    ],
    "imaging": [
      "Skull and mandibular hyperostosis on X-ray and CT",
      "Increased bone density on radiographs",
      "Possible narrowing of cranial foramina on CT"
    ],
    "genetic": [
      "Biallelic mutations or deletions in the SOST gene on chromosome 17q12-q21"
    ],
    "other": [
      "Family history consistent with autosomal recessive inheritance"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sclerosteosis",
      "distinguishingFeatures": [
        "More severe bone overgrowth",
        "Presence of syndactyly",
        "Autosomal recessive inheritance with SOST mutations but distinct phenotype"
      ]
    },
    {
      "diseaseId": "craniometaphyseal-dysplasia",
      "distinguishingFeatures": [
        "Metaphyseal abnormalities of long bones",
        "Cranial hyperostosis with different radiographic pattern",
        "Autosomal dominant or recessive inheritance"
      ]
    }
  ],
  "redFlags": [
