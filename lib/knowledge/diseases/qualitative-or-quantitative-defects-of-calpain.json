  "diagnosticCriteria": {
    "formalCriteriaName": "Calpainopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness predominantly affecting the pelvic and shoulder girdles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes with reduced or absent calpain-3 protein expression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the CAPN3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Electromyographic evidence of myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "serum-creatine-kinase",
        "description": "Elevated serum creatine kinase levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal muscle weakness plus either muscle biopsy findings or genetic confirmation of CAPN3 mutations",
    "notes": "Diagnosis requires exclusion of other muscular dystrophies and correlation with clinical and laboratory findings."
