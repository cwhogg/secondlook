  "diagnosticCriteria": {
    "formalCriteriaName": "Pyruvate Dehydrogenase Complex Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced pyruvate dehydrogenase complex enzyme activity in fibroblasts or muscle tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in PDHA1 or other PDC-related genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lactic-acidosis",
        "description": "Persistent lactic acidosis with elevated lactate-to-pyruvate ratio in blood or CSF",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Neurological manifestations including developmental delay and hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Reduced enzyme activity or pathogenic genetic variant plus compatible clinical features",
    "notes": "Diagnosis often requires combination of biochemical, genetic, and clinical findings."
