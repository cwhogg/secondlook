  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP",
      "Negative blood and bone cultures",
      "Mild anemia of chronic disease"
    ],
    "imaging": [
      "MRI showing multifocal bone marrow edema and osteolytic/sclerotic lesions",
      "X-rays with metaphyseal lytic or sclerotic changes",
      "Bone scintigraphy demonstrating multifocal uptake"
    ],
    "genetic": [
      "No definitive causative gene identified; possible association with autoinflammatory gene variants (e.g., LPIN2, FBLIM1)"
    ],
    "other": [
      "Bone biopsy showing sterile chronic inflammation without microorganisms"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "infectious-osteomyelitis",
