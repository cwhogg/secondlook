  "diagnosticCriteria": {
    "formalCriteriaName": "Cutis Laxa Diagnostic Criteria",
    "criteria": [
      {
        "id": "loose-skin",
        "description": "Presence of loose, inelastic, pendulous skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elastic-fiber-defect",
        "description": "Histopathological evidence of fragmented or decreased elastic fibers in dermis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "systemic-involvement",
        "description": "Presence of systemic manifestations such as pulmonary emphysema, arterial tortuosity, or hernias",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant, recessive, or X-linked inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Loose, inelastic skin plus histopathological confirmation of elastic fiber abnormalities",
    "notes": "Genetic testing can confirm diagnosis in many cases; systemic involvement varies by subtype."
  },
