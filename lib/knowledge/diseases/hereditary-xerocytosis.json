  "keyFindings": {
    "laboratory": [
      "Peripheral blood smear showing stomatocytes and dehydrated erythrocytes",
      "Elevated reticulocyte count",
      "Elevated lactate dehydrogenase (LDH)",
      "Low haptoglobin",
      "Elevated indirect bilirubin"
    ],
    "imaging": [
      "Ultrasound showing gallstones",
      "Splenic enlargement on abdominal imaging"
    ],
    "genetic": [
      "Mutations in PIEZO1 gene",
      "Mutations in KCNN4 gene"
    ],
    "other": [
      "Abnormal red blood cell cation permeability assays",
      "Osmotic gradient ektacytometry showing decreased RBC deformability"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hereditary-spherocytosis",
      "distinguishingFeatures": [
        "Presence of spherocytes instead of stomatocytes",
        "Increased osmotic fragility rather than decreased",
        "Different genetic mutations (ANK1, SPTB, SPTA1)"
      ]
    },
    {
      "diseaseId": "hereditary-elliptocytosis",
      "distinguishingFeatures": [
        "Elliptical-shaped erythrocytes on smear",
        "Normal or increased osmotic fragility",
        "Different membrane protein defects"
      ]
    },
    {
      "diseaseId": "paroxysmal nocturnal hemoglobinuria",
      "distinguishingFeatures": [
        "Complement-mediated intravascular hemolysis",
        "Flow cytometry showing CD55/CD59 deficiency",
        "No stomatocytes on smear"
      ]
    }
  ],
  "redFlags": [
    "Severe anemia requiring transfusions",
    "Acute splenic sequestration or infarction",
    "Signs of iron overload (e.g., hepatomegaly, elevated ferritin)"
  ],
