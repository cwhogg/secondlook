        "Different genetic mutations (AGXT, GRHPR, HOGA1)"
      ]
    },
    {
      "diseaseId": "cystinuria",
      "distinguishingFeatures": [
        "Cystine stones with characteristic hexagonal crystals",
        "Positive cyanide-nitroprusside test",
        "Different inheritance pattern"
      ]
    }
  ],
