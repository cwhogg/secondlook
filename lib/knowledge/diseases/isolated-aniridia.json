        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of iris hypoplasia (partial or complete absence) with exclusion of syndromic causes; genetic confirmation supports diagnosis",
    "notes": "Genetic testing for PAX6 mutations is recommended but not mandatory if clinical features are definitive"
  },
