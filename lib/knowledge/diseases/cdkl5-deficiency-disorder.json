  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible metabolic screening to exclude other causes"
    ],
    "imaging": [
      "Brain MRI often normal or shows cerebral atrophy and delayed myelination"
    ],
    "genetic": [
      "CDKL5 (causative)",
      "X-linked dominant inheritance"
    ],
    "other": [
      "EEG showing early-onset epileptic encephalopathy with multifocal and generalized epileptiform discharges"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "rett-syndrome",
      "distinguishingFeatures": [
        "MECP2 mutations instead of CDKL5",
        "Typical regression after normal early development",
        "Characteristic hand-wringing movements"
      ]
    },
    {
      "diseaseId": "early-infantile-epileptic-encephalopathy-1",
      "distinguishingFeatures": [
        "Mutations in STXBP1 gene",
        "Similar early-onset seizures but different genetic cause",
        "Less severe developmental impairment in some cases"
      ]
    }
  ],
  "redFlags": [
    "Seizure onset within first 3 months of life",
    "Severe developmental delay with absent speech and motor milestones",
    "Refractory epilepsy not responsive to standard antiepileptic drugs"
  ],
