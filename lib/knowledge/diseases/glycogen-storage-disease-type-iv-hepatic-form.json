  "diagnosticCriteria": {
    "formalCriteriaName": "No standardized formal criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of deficient or absent glycogen branching enzyme (GBE) activity in liver or muscle biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Liver biopsy showing abnormal glycogen with fewer branch points and amylopectin-like inclusions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the GBE1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive hepatosplenomegaly and liver dysfunction in early childhood",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of deficient GBE enzyme activity or pathogenic GBE1 mutations plus compatible liver histopathology",
    "notes": "Diagnosis is confirmed by a combination of biochemical, histological, and genetic findings."
  },
