  "keyFindings": {
    "laboratory": [
      "Metabolic acidosis with normal anion gap",
      "Hypokalemia and hyperchloremia",
      "Elevated serum alkaline phosphatase",
      "Anemia with leukoerythroblastic blood picture"
    ],
    "imaging": [
      "Diffuse osteosclerosis with 'bone within bone' appearance on X-rays",
      "Erlenmeyer flask deformity of long bones",
      "Narrowing of cranial nerve foramina on CT"
    ],
    "genetic": [
      "CA2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Bone marrow biopsy showing reduced marrow space and fibrosis",
      "Urinary acidification tests confirming renal tubular acidosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "infantile-malignant-osteopetrosis",
