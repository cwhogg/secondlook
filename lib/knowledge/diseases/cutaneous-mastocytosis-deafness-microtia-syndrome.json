  "keyFindings": {
    "laboratory": [
      "Elevated serum tryptase levels indicating mast cell activation",
      "Histopathology of skin biopsy showing dense mast cell infiltration"
    ],
    "imaging": [
      "CT or MRI showing external ear malformations and middle ear anomalies",
      "Audiometric testing confirming sensorineural hearing loss"
    ],
    "genetic": [
      "No specific gene identified; possible sporadic or familial inheritance patterns",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Positive Darier’s sign on physical examination",
      "Exclusion of other mastocytosis syndromes and ear malformation disorders"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "mastocytosis",
      "distinguishingFeatures": [
        "Absence of congenital ear malformations",
        "Variable hearing loss not typically congenital"
      ]
    },
    {
      "diseaseId": "auriculocondylar-syndrome",
      "distinguishingFeatures": [
        "Microtia with mandibular hypoplasia",
        "No mastocytosis or mast cell-related skin lesions"
      ]
    },
    {
      "diseaseId": "goldenhar-syndrome",
      "distinguishingFeatures": [
        "Microtia with hemifacial microsomia",
        "No mast cell proliferation or cutaneous mastocytosis"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of hearing loss in infancy",
    "Severe anaphylactic reactions or systemic mast cell activation",
    "Presence of extensive cutaneous lesions with blistering"
  ],
