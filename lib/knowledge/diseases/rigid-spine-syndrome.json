  "diagnosticCriteria": {
    "formalCriteriaName": "Rigid Spine Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "rigid-spine",
        "description": "Progressive rigidity and limited flexion of the thoracolumbar spine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-weakness",
        "description": "Proximal muscle weakness predominantly affecting axial muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing myopathic changes with fibrosis and variable fiber size",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "emg-findings",
        "description": "Electromyography demonstrating myopathic pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in genes associated with rigid spine syndrome (e.g., SEPN1)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive rigid spine with proximal axial muscle weakness plus either characteristic muscle biopsy findings or supportive EMG/genetic testing",
    "notes": "Diagnosis is clinical supported by histopathology and genetic confirmation when available."
  },
