  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Intellectual Disability-Spasticity-Ectrodactyly Syndrome",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of global developmental delay or intellectual disability confirmed by standardized cognitive testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "spasticity",
        "description": "Bilateral spasticity predominantly affecting lower limbs, demonstrated clinically and/or by neurological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ectrodactyly",
        "description": "Split hand/foot malformation (ectrodactyly) confirmed by clinical and radiological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-alternative-diagnosis",
        "description": "Exclusion of other syndromes causing intellectual disability with limb malformations",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history consistent with autosomal recessive or sporadic inheritance",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: intellectual disability, spasticity, and ectrodactyly, with exclusion of alternative diagnoses",
    "notes": "Genetic testing may assist but no specific gene mutation has been definitively associated."
  },
