  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiographic Diagnostic Criteria for Craniometaphyseal Dysplasia",
    "criteria": [
      {
        "id": "cranial-bone-thickening",
        "description": "Progressive abnormal thickening of craniofacial bones detected clinically and radiographically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metaphyseal-widening",
        "description": "Metaphyseal flaring and widening of long bones on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-nerve-palsy",
        "description": "Presence of cranial nerve compression symptoms such as facial nerve palsy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant or recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniofacial bone thickening and metaphyseal widening on imaging",
    "notes": "Genetic testing for ANKH mutations can support diagnosis but is not mandatory"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Craniofacial bone hyperostosis",
        "frequency": 0.95,
        "bodySystem": "musculoskeletal",
        "notes": "Leads to characteristic facial deformities"
      },
      {
        "symptomName": "Metaphyseal widening of long bones",
        "frequency": 0.9,
        "bodySystem": "musculoskeletal",
        "notes": "Visible on radiographs, hallmark of disease"
      },
      {
        "symptomName": "Progressive cranial nerve compression symptoms",
        "frequency": 0.75,
        "bodySystem": "neurological",
        "notes": "Includes facial nerve palsy and hearing loss"
      }
    ],
    "common": [
      {
        "symptomName": "Facial dysmorphism with broad nasal bridge",
        "frequency": 0.85,
        "bodySystem": "constitutional",
        "notes": "Characteristic facial appearance"
      },
      {
        "symptomName": "Hearing impairment",
        "frequency": 0.7,
        "bodySystem": "otolaryngological",
        "notes": "Due to foraminal narrowing"
      },
      {
        "symptomName": "Nasal obstruction",
        "frequency": 0.65,
        "bodySystem": "otolaryngological",
        "notes": "From nasal cavity narrowing"
      },
      {
        "symptomName": "Dental malocclusion",
        "frequency": 0.6,
        "bodySystem": "musculoskeletal",
        "notes": "Due to abnormal jaw bone growth"
      },
      {
        "symptomName": "Headache",
        "frequency": 0.55,
        "bodySystem": "neurological",
        "notes": "Secondary to increased cranial pressure"
      }
    ],
    "occasional": [
      {
        "symptomName": "Visual disturbances",
        "frequency": 0.4,
        "bodySystem": "ophthalmological",
        "notes": "Due to optic nerve compression"
      },
      {
        "symptomName": "Trigeminal neuralgia",
        "frequency": 0.3,
        "bodySystem": "neurological",
        "notes": "From trigeminal nerve involvement"
      },
      {
        "symptomName": "Delayed motor milestones",
        "frequency": 0.25,
        "bodySystem": "neurological",
        "notes": "In severe cases"
      },
      {
        "symptomName": "Recurrent sinus infections",
        "frequency": 0.2,
        "bodySystem": "respiratory",
        "notes": "Due to nasal obstruction"
      },
      {
        "symptomName": "Jaw pain",
        "frequency": 0.15,
        "bodySystem": "musculoskeletal",
        "notes": "Related to bone overgrowth"
      }
    ],
    "rare": [
      {
        "symptomName": "Seizures",
        "frequency": 0.08,
