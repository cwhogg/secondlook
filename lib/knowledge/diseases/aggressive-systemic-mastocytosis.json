  "diagnosticCriteria": {
    "formalCriteriaName": "WHO 2016 Diagnostic Criteria for Systemic Mastocytosis",
    "criteria": [
      {
        "id": "major",
        "description": "Multifocal, dense infiltrates of mast cells (≥15 mast cells in aggregates) detected in bone marrow biopsies and/or other extracutaneous organs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "minor-1",
        "description": "More than 25% of mast cells in infiltrates are spindle-shaped or have atypical morphology",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "minor-2",
        "description": "Detection of KIT codon 816 mutation in bone marrow or other extracutaneous organs",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "minor-3",
        "description": "Mast cells expressing CD2 and/or CD25 in addition to normal mast cell markers",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "minor-4",
        "description": "Serum total tryptase persistently >20 ng/mL (unless associated with an associated clonal myeloid disorder)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of the major criterion and at least one minor criterion, or at least three minor criteria",
    "notes": "Aggressive systemic mastocytosis is diagnosed when systemic mastocytosis criteria are met along with evidence of organ damage due to mast cell infiltration."
  },
