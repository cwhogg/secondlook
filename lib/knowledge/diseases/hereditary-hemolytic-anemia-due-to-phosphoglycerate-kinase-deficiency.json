  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced phosphoglycerate kinase enzyme activity in erythrocytes or muscle tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemolytic-anemia",
        "description": "Presence of chronic hemolytic anemia with reticulocytosis and indirect hyperbilirubinemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the PGK1 gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-symptoms",
        "description": "Presence of neurological manifestations such as seizures or developmental delay (supportive)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Reduced PGK enzyme activity plus either chronic hemolytic anemia or pathogenic PGK1 gene variant",
    "notes": "Neurological symptoms are variable and not required for diagnosis."
  },
