  "diagnosticCriteria": {
    "formalCriteriaName": "Welander Distal Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Late adult onset distal muscle weakness predominantly affecting the hands and forearms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing rimmed vacuoles and myopathic changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the TIA1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography-findings",
        "description": "EMG demonstrating myopathic changes with fibrillations and positive sharp waves",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected family members",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of typical clinical presentation plus muscle biopsy findings and/or genetic confirmation",
    "notes": "Genetic testing for TIA1 mutations is confirmatory; muscle biopsy is essential if genetic testing is inconclusive."
  },
