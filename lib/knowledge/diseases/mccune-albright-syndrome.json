  "keyFindings": {
    "laboratory": [
      "Elevated serum alkaline phosphatase",
      "Hyperthyroidism labs (elevated T3/T4, suppressed TSH)",
      "Elevated growth hormone and IGF-1 levels",
      "Hypophosphatemia with renal phosphate wasting"
    ],
    "imaging": [
      "Radiographs showing ground-glass appearance of fibrous dysplasia lesions",
      "CT/MRI demonstrating craniofacial bone involvement",
      "Bone scintigraphy showing polyostotic lesions"
    ],
    "genetic": [
      "Somatic activating mutations in GNAS gene (codon 201)"
    ],
    "other": [
      "Skin biopsy showing increased melanin in basal layer without increased melanocytes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "neurofibromatosis-type-1",
      "distinguishingFeatures": [
        "Café-au-lait spots with smooth 'coast of California' borders",
        "Presence of neurofibromas",
        "Lisch nodules in the iris"
      ]
    },
    {
      "diseaseId": "fibrous-dysplasia-isolated",
      "distinguishingFeatures": [
        "Fibrous dysplasia without endocrine abnormalities or skin pigmentation",
        "No GNAS mutation mosaicism affecting endocrine tissues"
      ]
    },
    {
      "diseaseId": "precocious-puberty-central",
      "distinguishingFeatures": [
        "Central activation of hypothalamic-pituitary-gonadal axis",
        "Absence of fibrous dysplasia and café-au-lait spots"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive bone deformities or fractures",
    "Signs of vision loss or cranial nerve deficits",
    "Severe endocrinopathies causing systemic complications"
  ],
