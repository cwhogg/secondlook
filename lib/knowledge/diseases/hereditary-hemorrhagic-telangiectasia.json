  "diagnosticCriteria": {
    "formalCriteriaName": "Curaçao Criteria",
    "criteria": [
      {
        "id": "epistaxis",
        "description": "Spontaneous and recurrent nosebleeds",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "telangiectasias",
        "description": "Multiple telangiectasias at characteristic sites including lips, oral cavity, fingers, and nose",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "avms",
        "description": "Visceral arteriovenous malformations (pulmonary, hepatic, cerebral, spinal)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "First-degree relative with HHT according to these criteria",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Diagnosis is definite if 3 or more criteria are present; possible or suspected if 2 criteria are present; unlikely if fewer than 2 criteria are present",
    "notes": "The Curaçao criteria are widely used for clinical diagnosis of HHT."
  },
