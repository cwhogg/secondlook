  "keyFindings": {
    "laboratory": [
      "Persistent absolute neutrophil count (ANC) <1500/µL",
      "Normal platelet and red blood cell counts",
      "Negative autoimmune markers (ANA, anti-neutrophil antibodies usually absent)",
      "Normal or mildly decreased myeloid precursors on bone marrow biopsy"
    ],
    "imaging": [
      "Chest X-ray may show infiltrates during infections",
      "Ultrasound may reveal mild hepatosplenomegaly"
    ],
    "genetic": [
      "No known pathogenic mutations identified",
      "Cytogenetic analysis negative for clonal abnormalities"
    ],
    "other": [
      "Exclusion of drug-induced neutropenia",
      "Negative infectious disease workup (HIV, hepatitis, etc.)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autoimmune-neutropenia",
      "distinguishingFeatures": [
        "Presence of anti-neutrophil antibodies",
        "Often associated with other autoimmune diseases",
        "Variable bone marrow findings with immune-mediated destruction"
      ]
    },
    {
      "diseaseId": "congenital-neutropenia",
      "distinguishingFeatures": [
        "Onset in infancy or childhood",
        "Genetic mutations identified (e.g., ELANE gene)",
        "Severe neutropenia with maturation arrest in bone marrow"
      ]
    },
    {
      "diseaseId": "drug-induced-neutropenia",
      "distinguishingFeatures": [
        "Temporal relationship with drug exposure",
        "Resolution after drug withdrawal",
        "No chronicity if drug is discontinued"
      ]
    }
  ],
  "redFlags": [
    "ANC persistently below 500/µL",
    "Development of unexplained fever or sepsis",
    "Rapid progression of neutropenia or pancytopenia"
  ],
