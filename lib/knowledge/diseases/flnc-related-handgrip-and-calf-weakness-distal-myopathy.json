  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed FLNC-related Distal Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive distal muscle weakness predominantly affecting handgrip and calf muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing myopathic changes with rimmed vacuoles and filamentous inclusions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the FLNC gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "EMG demonstrating myopathic motor unit potentials with occasional fibrillations",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal handgrip and calf muscle weakness, muscle biopsy findings consistent with distal myopathy, and pathogenic FLNC gene variant",
    "notes": "Diagnosis requires integration of clinical, histopathological, and genetic data; EMG and family history support diagnosis but are not mandatory."
  },
