      {
        "id": "histopathology",
        "description": "Presence of angiocentric and angiodestructive lymphoid infiltrate with necrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotyping",
        "description": "Expression of NK-cell markers (CD56+) and cytotoxic molecules (granzyme B, TIA-1)",
