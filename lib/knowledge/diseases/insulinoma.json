  "diagnosticCriteria": {
    "formalCriteriaName": "Whipple's Triad",
    "criteria": [
      {
        "id": "hypoglycemia",
        "description": "Documented hypoglycemia with plasma glucose <50 mg/dL (2.8 mmol/L)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "symptoms_of_hypoglycemia",
        "description": "Presence of neuroglycopenic and adrenergic symptoms during hypoglycemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "relief_with_glucose",
        "description": "Relief of symptoms after administration of glucose",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "inappropriately_high_insulin",
        "description": "Inappropriately elevated insulin levels during hypoglycemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging_localization",
        "description": "Localization of tumor by imaging modalities (e.g., endoscopic ultrasound, MRI)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three components of Whipple's Triad must be present; supportive biochemical and imaging findings aid confirmation",
    "notes": "Diagnosis often requires supervised 72-hour fast test to document hypoglycemia and insulin levels"
  },
