  "diagnosticCriteria": {
    "formalCriteriaName": "Proteus Syndrome Diagnostic Criteria (adapted for Proteus-like Syndrome)",
    "criteria": [
      {
        "id": "mosaic-overgrowth",
        "description": "Progressive, mosaic, asymmetric overgrowth of multiple tissues",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "connective-tissue-dysplasia",
        "description": "Connective tissue nevi or dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vascular-malformations",
        "description": "Presence of vascular malformations such as capillary or venous anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal abnormalities including scoliosis or limb asymmetry",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-PTEN-mutation",
        "description": "Lack of PTEN gene mutation differentiating from PTEN hamartoma tumor syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least two major criteria including mosaic asymmetric overgrowth plus one minor or supportive criterion",
    "notes": "Diagnosis is clinical and genetic testing may help exclude overlapping syndromes."
  },
