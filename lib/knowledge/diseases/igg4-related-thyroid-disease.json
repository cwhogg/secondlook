  "keyFindings": {
    "laboratory": [
      "Elevated serum IgG4 concentration (>135 mg/dL)",
      "Elevated anti-thyroid peroxidase (anti-TPO) antibodies",
      "Elevated TSH with low free T4 in hypothyroid cases"
    ],
    "imaging": [
      "Thyroid ultrasound showing diffuse hypoechoic areas and heterogeneous echotexture",
      "CT scan demonstrating diffuse thyroid enlargement without nodules"
    ],
