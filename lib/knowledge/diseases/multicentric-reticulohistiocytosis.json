  "diagnosticCriteria": {
    "formalCriteriaName": "Multicentric Reticulohistiocytosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "skin-lesions",
        "description": "Presence of characteristic papulonodular skin lesions, often on hands and face",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "erosive-arthritis",
        "description": "Severe, symmetric, erosive polyarthritis involving distal interphalangeal joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin or synovial biopsy showing multinucleated giant cells and histiocytes with ground-glass cytoplasm",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "negative-rheumatoid-factor",
        "description": "Negative rheumatoid factor and anti-CCP antibodies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "systemic-involvement",
        "description": "Presence of systemic symptoms such as fever, weight loss, or internal organ involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (characteristic skin lesions, erosive arthritis, and confirmatory histopathology)",
    "notes": "Diagnosis is clinical and histopathological; exclusion of other histiocytic disorders is essential."
  },
