  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Microcephaly-brachydactyly-kyphoscoliosis syndrome",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Presence of congenital microcephaly with head circumference significantly below the mean for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brachydactyly",
        "description": "Shortening of the fingers and toes (brachydactyly) confirmed by clinical and radiological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "kyphoscoliosis",
        "description": "Development of kyphoscoliosis deformity of the spine, typically progressive",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Variable intellectual disability or developmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent nasal bridge and micrognathia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: congenital microcephaly, brachydactyly, and kyphoscoliosis",
    "notes": "Diagnosis is clinical; genetic testing may assist but causative gene not yet identified."
  },
