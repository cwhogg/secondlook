  "diagnosticCriteria": {
    "formalCriteriaName": "KLHL9-Related Distal Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive distal muscle weakness and atrophy with early onset in adolescence or early adulthood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the KLHL9 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing myopathic changes with rimmed vacuoles and fiber size variability",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "EMG demonstrating myopathic motor unit potentials predominantly in distal muscles",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history consistent with autosomal dominant inheritance of distal myopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal muscle weakness with genetic confirmation of KLHL9 pathogenic variant",
    "notes": "Muscle biopsy and EMG findings support diagnosis but are not mandatory if genetic testing is conclusive."
  },
