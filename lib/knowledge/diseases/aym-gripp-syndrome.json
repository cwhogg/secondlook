  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild elevation of alkaline phosphatase"
    ],
    "imaging": [
      "Radiographs showing brachydactyly and vertebral anomalies",
      "MRI may show nonspecific brain abnormalities"
    ],
    "genetic": [
      "MAF (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Developmental assessments confirming intellectual disability",
      "Audiometric testing confirming hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "achondroplasia",
      "distinguishingFeatures": [
        "More severe disproportionate short stature",
        "Characteristic radiographic features distinct from Aymé-Gripp",
        "No intellectual disability"
      ]
    },
    {
      "diseaseId": "noonan-syndrome",
      "distinguishingFeatures": [
        "Distinct facial features including webbed neck",
        "Cardiac defects more common and severe",
        "Normal intelligence or mild learning difficulties"
      ]
    }
  ],
  "redFlags": [
    "Severe developmental delay beyond mild to moderate intellectual disability",
    "Progressive neurological deterioration",
    "Presence of seizures or unexplained neurological symptoms"
  ],
