  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed diagnostic criteria for SLC39A13-related spondylodysplastic EDS",
    "criteria": [
      {
        "id": "connective-tissue-fragility",
        "description": "Generalized connective tissue fragility with skin hyperextensibility and atrophic scarring",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature-and-skeletal-abnormalities",
        "description": "Short stature with characteristic skeletal dysplasia including platyspondyly and metaphyseal changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-hypermobility",
        "description": "Congenital or early-onset joint hypermobility with recurrent dislocations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facies",
        "description": "Distinctive facial features including midface hypoplasia and prominent eyes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in SLC39A13 confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical criteria plus molecular confirmation of biallelic SLC39A13 pathogenic variants",
    "notes": "Diagnosis relies heavily on genetic testing due to phenotypic overlap with other EDS subtypes."
  },
