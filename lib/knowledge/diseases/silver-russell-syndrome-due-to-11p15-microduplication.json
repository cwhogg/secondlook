  "differentialDiagnoses": [
    {
      "diseaseId": "classic-silver-russell-syndrome",
      "distinguishingFeatures": [
        "Usually caused by 11p15 hypomethylation or maternal uniparental disomy of chromosome 7",
        "Absence of 11p15 microduplication",
        "Similar clinical features but different molecular etiology"
      ]
    },
    {
      "diseaseId": "beckwith-wiedemann-syndrome",
