  "keyFindings": {
    "laboratory": [
      "Elevated maternal serum alpha-fetoprotein and beta-hCG in prenatal screening",
      "Abnormal karyotype showing triploidy (69 chromosomes)"
    ],
    "imaging": [
      "Prenatal ultrasound showing severe intrauterine growth restriction, structural anomalies including limb malformations and craniofacial defects",
      "Placental abnormalities such as partial molar changes"
    ],
    "genetic": [
      "Triploid karyotype (69,XXX; 69,XXY; or 69,XYY)",
      "Parental origin of extra haploid set (diandric or digynic) influencing phenotype"
    ],
    "other": [
      "Characteristic dysmorphic features at birth",
      "High perinatal mortality"
    ]
  },
