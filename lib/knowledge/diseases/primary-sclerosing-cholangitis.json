  "keyFindings": {
    "laboratory": [
      "Elevated ALP and GGT (cholestatic pattern)",
      "Elevated bilirubin in advanced disease",
      "pANCA (atypical) positive (~70%, non-specific)",
      "AMA negative (distinguishes from PBC)",
      "Mildly elevated ALT/AST",
      "Elevated IgG4 in ~10% (does not necessarily mean IgG4-related disease)",
      "CA 19-9 elevated (raises concern for cholangiocarcinoma if markedly elevated)"
    ],
    "imaging": [
      "MRCP: multifocal strictures and dilatations of bile ducts (beaded appearance); gold standard imaging",
      "ERCP: similar findings; allows for therapeutic intervention (balloon dilation, stenting, brushings)",
      "Ultrasound: bile duct wall thickening, gallbladder polyps",
      "CT: periportal lymphadenopathy, heterogeneous liver enhancement"
    ],
    "genetic": [
      "SEMA4D (causative)",
      "GPR35 (susceptibility)",
      "MST1 (susceptibility)",
      "TCF4 (susceptibility)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Liver biopsy: periductal concentric fibrosis (onion-skin fibrosis), bile duct proliferation, ductopenia",
      "Colonoscopy: screening for IBD (recommended in all PSC patients even without GI symptoms)",
      "FISH for polysomy/aneuploidy on biliary brushings: screening for cholangiocarcinoma"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "primary-biliary-cholangitis",
      "distinguishingFeatures": [
        "AMA positive",
        "Female predominance",
        "Normal cholangiogram",
        "Granulomatous bile duct destruction"
      ]
    },
    {
      "diseaseId": "igg4-related-disease",
      "distinguishingFeatures": [
        "Elevated serum IgG4 >2x ULN",
        "Pancreatic involvement (autoimmune pancreatitis)",
        "Responds to corticosteroids",
        "Dense IgG4+ plasma cell infiltrate on biopsy"
      ]
    },
    {
      "diseaseId": "autoimmune-hepatitis",
      "distinguishingFeatures": [
        "Hepatocellular enzyme pattern",
        "ANA/SMA positive",
        "Interface hepatitis",
        "Can overlap with PSC"
      ]
    },
    {
      "diseaseId": "cholangiocarcinoma",
      "distinguishingFeatures": [
        "Malignant stricture on ERCP",
        "CA 19-9 markedly elevated",
        "Mass lesion on imaging",
        "Positive cytology/FISH"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive jaundice (concern for dominant stricture or cholangiocarcinoma)",
    "Markedly elevated CA 19-9 (>129 U/mL suggests cholangiocarcinoma)",
    "New mass lesion on imaging",
    "Recurrent bacterial cholangitis",
    "Progressive portal hypertension/decompensation (transplant evaluation)",
    "Colorectal dysplasia on surveillance colonoscopy"
  ],
