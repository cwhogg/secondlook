  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Genetic testing identifying pathogenic variants in MYH3 gene"
    ],
    "imaging": [
      "X-rays showing joint contractures and bone deformities",
      "Ultrasound or MRI may reveal muscle hypoplasia"
    ],
    "genetic": [
      "NALCN (causative)",
      "MYH3 (causative)",
      "Autosomal dominant mutations in MYH3 gene",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography may show myopathic changes",
      "Clinical observation of characteristic facial and limb features"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "arthrogryposis-multiplex-congenita",
      "distinguishingFeatures": [
        "Absence of characteristic whistling face",
