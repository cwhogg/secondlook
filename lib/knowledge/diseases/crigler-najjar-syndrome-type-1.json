  "diagnosticCriteria": {
    "formalCriteriaName": "Crigler-Najjar Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "unconjugated-hyperbilirubinemia",
        "description": "Persistent severe unconjugated hyperbilirubinemia (>20 mg/dL) unresponsive to phenobarbital",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-ugt1a1-activity",
        "description": "Complete or near complete absence of UDP-glucuronosyltransferase 1A1 (UGT1A1) enzyme activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the UGT1A1 gene consistent with type 1 phenotype",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of hemolysis and other causes of unconjugated hyperbilirubinemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent severe unconjugated hyperbilirubinemia unresponsive to phenobarbital, absent UGT1A1 activity, and pathogenic UGT1A1 mutations",
    "notes": "Phenobarbital responsiveness distinguishes type 2 from type 1; type 1 shows no response."
  },
