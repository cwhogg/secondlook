  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Syndromic Recessive X-linked Ichthyosis",
    "criteria": [
      {
        "id": "ichthyosis",
        "description": "Presence of generalized scaling skin consistent with ichthyosis, typically appearing in the neonatal period",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "steroid-sulfatase-deficiency",
        "description": "Biochemical evidence of steroid sulfatase enzyme deficiency in leukocytes or skin fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants or deletions in the STS gene on the X chromosome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "syndromic-features",
        "description": "Presence of associated syndromic features such as cryptorchidism, corneal opacities, or neurodevelopmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical ichthyosis, steroid sulfatase deficiency, and genetic confirmation) must be met for diagnosis.",
    "notes": "Syndromic features may vary and are supportive but not required for diagnosis."
  },
