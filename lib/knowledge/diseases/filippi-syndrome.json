  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Filippi syndrome",
    "criteria": [
      {
        "id": "syndactyly",
        "description": "Syndactyly of fingers and/or toes, typically involving the second and third digits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microcephaly",
        "description": "Congenital microcephaly with variable intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Pre- and postnatal growth retardation resulting in short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent nasal bridge, micrognathia, and hypertelorism",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of syndactyly, microcephaly, and growth retardation is required for diagnosis",
    "notes": "Genetic testing for mutations in the CKAP2L gene can confirm diagnosis"
  },
