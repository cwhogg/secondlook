  "diagnosticCriteria": {
    "formalCriteriaName": "Hinman Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "non-neurogenic-bladder-dysfunction",
        "description": "Presence of bladder dysfunction without neurological cause",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "detrusor-sphincter-dyssynergia",
        "description": "Urodynamic evidence of detrusor-sphincter dyssynergia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-urinary-tract-infections",
        "description": "History of recurrent urinary tract infections",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "upper-urinary-tract-damage",
        "description": "Radiological evidence of upper urinary tract damage (hydronephrosis, reflux)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-neurological-lesion",
        "description": "No neurological lesion on clinical and imaging evaluation",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of bladder dysfunction with detrusor-sphincter dyssynergia and upper urinary tract damage in the absence of neurological lesions",
    "notes": "Diagnosis requires exclusion of neurological causes and confirmation by urodynamic studies"
  },
