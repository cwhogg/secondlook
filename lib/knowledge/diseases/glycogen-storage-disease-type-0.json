  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for GSD Type 0",
    "criteria": [
      {
        "id": "fasting-hypoglycemia",
        "description": "Documented fasting hypoglycemia with low or absent ketones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "postprandial-hyperglycemia",
        "description": "Postprandial hyperglycemia and hyperlactatemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the GYS2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-biopsy",
        "description": "Reduced or absent glycogen synthase activity on liver biopsy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-presentation",
        "description": "Symptoms of fasting intolerance such as lethargy and seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of fasting hypoglycemia and postprandial hyperglycemia with confirmatory genetic testing identifying pathogenic GYS2 variants",
    "notes": "Liver biopsy is rarely required if genetic testing is conclusive."
  },
