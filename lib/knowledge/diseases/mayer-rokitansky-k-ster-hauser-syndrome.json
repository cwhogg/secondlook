  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and imaging criteria for MRKH syndrome",
    "criteria": [
      {
        "id": "agenesis-uterus-vagina",
        "description": "Congenital absence or hypoplasia of the uterus and upper two-thirds of the vagina",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-secondary-sexual-characteristics",
        "description": "Normal development of secondary sexual characteristics (breast development and pubic hair)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "46xx-karyotype",
        "description": "Normal female 46,XX karyotype without chromosomal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-anomalies",
        "description": "Presence of renal tract malformations (e.g., unilateral renal agenesis or ectopic kidney)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-anomalies",
        "description": "Associated skeletal abnormalities such as vertebral anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Congenital absence or hypoplasia of the uterus and upper vagina with normal secondary sexual characteristics and 46,XX karyotype",
    "notes": "Diagnosis is supported by imaging (MRI or ultrasound) and exclusion of other causes of primary amenorrhea."
  },
