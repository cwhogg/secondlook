  "keyFindings": {
    "laboratory": [
      "Routine blood tests typically normal",
      "No specific biomarkers identified"
    ],
    "imaging": [
      "MRI showing lesion or infarct in dominant parietal lobe, especially angular gyrus",
      "CT scan may reveal ischemic changes in relevant cortical areas"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Rare familial cases reported; possible autosomal dominant inheritance in some",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Neuropsychological testing confirms deficits in calculation, writing, finger recognition, and left-right orientation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "alexia-with-agraphia",
      "distinguishingFeatures": [
        "Presence of alexia (reading impairment) alongside agraphia",
        "Lesions typically involve left angular gyrus but with additional language deficits"
      ]
    },
    {
      "diseaseId": "balints-syndrome",
      "distinguishingFeatures": [
        "Optic ataxia, oculomotor apraxia, and simultanagnosia",
        "Bilateral parietal-occipital lesions rather than unilateral"
      ]
    },
    {
      "diseaseId": "stroke-parietal-lobe",
      "distinguishingFeatures": [
        "Broader neurological deficits including hemiparesis",
        "Sudden onset and imaging consistent with vascular event"
      ]
    }
  ],
  "redFlags": [
    "Sudden onset of symptoms suggesting stroke",
    "Progressive worsening indicating neurodegenerative process",
    "Presence of seizures or hemiparesis"
  ],
