  "keyFindings": {
    "laboratory": [
      "Routine labs typically normal",
      "Renal function tests for monitoring kidney involvement",
      "VEGF-D levels (biomarker for LAM in women)"
    ],
    "imaging": [
      "Brain MRI: cortical tubers, subependymal nodules, white matter radial migration lines, SEGA",
      "Renal MRI or ultrasound: angiomyolipomas, renal cysts",
      "Echocardiography: cardiac rhabdomyomas (especially in infants)",
      "Chest CT (HRCT): LAM in adult women",
      "Abdominal MRI preferred over CT for lifelong renal surveillance (radiation avoidance)"
    ],
    "genetic": [
      "IFNG (modifier)",
      "TSC1 (causative)",
      "TSC2 (causative)",
      "~65-75% of cases are de novo; ~25-35% inherited (autosomal dominant)"
    ],
    "other": [
      "Wood lamp examination for hypomelanotic macules",
      "Ophthalmologic examination for retinal hamartomas",
      "EEG for seizure assessment",
      "Dental examination for enamel pits and gingival fibromas",
      "Neuropsychological assessment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "neurofibromatosis-type-1",
      "distinguishingFeatures": [
        "NF1 has cafe-au-lait macules (hyperpigmented, not hypopigmented)",
        "NF1 has neurofibromas rather than angiofibromas",
        "Lisch nodules in NF1",
        "NF1 gene mutations"
      ]
    },
    {
      "diseaseId": "focal-cortical-dysplasia",
      "distinguishingFeatures": [
        "Isolated cortical malformation without systemic features",
        "No skin findings",
        "No renal or cardiac involvement"
      ]
    },
    {
      "diseaseId": "birt-hogg-dube-syndrome",
      "distinguishingFeatures": [
        "FLCN mutations",
        "Skin fibrofolliculomas (different from angiofibromas)",
        "Renal tumors (chromophobe, oncocytic) rather than AML",
        "Lung cysts and pneumothorax"
      ]
    }
  ],
  "redFlags": [
    "Growing SEGA with risk of obstructive hydrocephalus (neurosurgical emergency)",
    "Large renal AML (>4 cm) with hemorrhage risk",
    "Refractory epilepsy (consider epilepsy surgery evaluation)",
    "Progressive pulmonary decline in women (LAM)",
    "Cardiac rhabdomyoma causing arrhythmia or outflow obstruction in neonates"
  ],
