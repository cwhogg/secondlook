  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria; diagnosis based on clinical features plus genetic confirmation",
    "criteria": [
      {
        "id": "lds-c1",
        "description": "Arterial tortuosity and/or aneurysm (especially aortic root)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "lds-c2",
        "description": "Hypertelorism (widely spaced eyes)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "lds-c3",
        "description": "Bifid uvula or cleft palate",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "lds-c4",
        "description": "Pathogenic variant in TGFBR1, TGFBR2, SMAD3, TGFB2, or TGFB3",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lds-m1",
        "description": "Craniosynostosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "lds-m2",
        "description": "Generalized arterial tortuosity",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "lds-m3",
        "description": "Cervical spine instability or anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "lds-m4",
        "description": "Thin translucent skin with visible veins",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "lds-m5",
        "description": "Easy bruising and poor wound healing",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "lds-m6",
        "description": "Joint hypermobility",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "lds-m7",
        "description": "Talipes equinovarus (clubfoot)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "lds-m8",
        "description": "Allergic/atopic disease (eosinophilic GI disease, asthma, food allergy)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of a pathogenic variant in a TGF-beta signaling pathway gene (TGFBR1, TGFBR2, SMAD3, TGFB2, TGFB3) plus compatible clinical features.",
    "notes": "Five subtypes based on causative gene (LDS Types 1-5). Aortic events can occur at smaller diameters than in Marfan syndrome."
  },
