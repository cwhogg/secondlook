  "keyFindings": {
    "laboratory": [
      "Hypogammaglobulinemia with elevated IgM",
      "Lymphopenia, especially reduced CD4+ T cells",
      "Impaired specific antibody responses to vaccines",
      "Elevated serum IgG and IgA may be present in some cases"
    ],
    "imaging": [
      "Chest CT showing bronchiectasis and/or lymphadenopathy",
      "Abdominal ultrasound or CT revealing splenomegaly or hepatomegaly"
    ],
    "genetic": [
      "Heterozygous gain-of-function mutations in PIK3CD gene",
      "Rare mutations in PIK3R1 gene causing similar phenotype (APDS2)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology of lymph nodes showing reactive or atypical lymphoproliferation",
      "Flow cytometry demonstrating altered B and T cell subsets"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "common-variable-immunodeficiency",
