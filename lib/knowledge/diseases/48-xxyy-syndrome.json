  "keyFindings": {
    "laboratory": [
      "Elevated serum gonadotropins (LH and FSH) with low testosterone levels",
      "Normal to mildly elevated creatine kinase"
    ],
    "imaging": [
      "Radiographs showing radioulnar synostosis",
      "Brain MRI may show nonspecific white matter changes"
    ],
    "genetic": [
      "Karyotype analysis demonstrating 48,XXYY chromosomal pattern"
    ],
    "other": [
      "Neuropsychological testing revealing intellectual disability and executive function deficits"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "klinefelter-syndrome",
      "distinguishingFeatures": [
        "47,XXY karyotype instead of 48,XXYY",
        "Typically milder neurodevelopmental impairment",
        "Less frequent radioulnar synostosis"
      ]
    },
    {
      "diseaseId": "47,xxyy-syndrome",
      "distinguishingFeatures": [
        "48,XXYY has two extra sex chromosomes vs. 47,XXY",
        "More severe intellectual disability and behavioral problems",
        "Presence of skeletal anomalies like radioulnar synostosis"
      ]
    }
  ],
