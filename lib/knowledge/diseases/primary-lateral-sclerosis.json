  "diagnosticCriteria": {
    "formalCriteriaName": "Pringle Criteria",
    "criteria": [
      {
        "id": "upper-motor-neuron-signs",
        "description": "Presence of progressive upper motor neuron signs in multiple regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-lower-motor-neuron-signs",
        "description": "No clinical or electrophysiological evidence of lower motor neuron involvement for at least 3-4 years",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-spasticity",
        "description": "Progressive spasticity and stiffness without significant muscle atrophy",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-electromyography",
        "description": "Electromyography (EMG) showing no denervation or fasciculations",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of upper motor neuron signs such as multiple sclerosis or structural lesions",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Progressive upper motor neuron signs in multiple regions with absence of lower motor neuron signs clinically and on EMG for at least 3 years, and exclusion of other causes",
    "notes": "Diagnosis is clinical and requires longitudinal observation to exclude ALS and other mimics."
  },
