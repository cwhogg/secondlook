  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnosis of adrenal crisis",
    "criteria": [
      {
        "id": "hypotension",
        "description": "Systolic blood pressure <100 mmHg or orthostatic hypotension",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyponatremia",
        "description": "Serum sodium concentration below normal reference range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypoglycemia",
        "description": "Blood glucose level below 70 mg/dL (3.9 mmol/L)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinicalFeatures",
        "description": "Presence of acute severe fatigue, abdominal pain, vomiting, or altered mental status",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "low-cortisol",
        "description": "Low serum cortisol levels during crisis",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of hypotension and hyponatremia with low serum cortisol levels, plus clinical features consistent with adrenal crisis",
    "notes": "Diagnosis is clinical and biochemical; rapid treatment should not be delayed for confirmatory tests"
  },
