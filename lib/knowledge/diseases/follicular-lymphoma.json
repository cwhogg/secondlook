  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Tumors of Haematopoietic and Lymphoid Tissues",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of neoplastic follicles composed predominantly of centrocytes with a follicular growth pattern on lymph node biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotyping",
        "description": "Expression of B-cell markers CD20, CD10, BCL2 positivity within follicles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-translocation",
        "description": "Detection of t(14;18)(q32;q21) translocation involving BCL2 gene by FISH or PCR",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Painless lymphadenopathy with or without systemic symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of follicular growth pattern with immunophenotypic evidence of B-cell markers and BCL2 positivity; genetic confirmation of t(14;18) translocation supports diagnosis",
    "notes": "Diagnosis requires integration of morphology, immunophenotype, and genetic studies."
  },
