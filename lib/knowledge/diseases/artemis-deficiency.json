  "keyFindings": {
    "laboratory": [
      "Severe T-cell lymphopenia with low or absent TRECs",
      "Hypogammaglobulinemia",
      "Elevated alpha-fetoprotein (AFP) in some cases"
    ],
    "imaging": [
      "Chest X-ray showing recurrent pneumonia or interstitial lung disease",
      "CT scan may reveal lymphoid tissue hypoplasia"
    ],
    "genetic": [
      "Biallelic pathogenic variants in DCLRE1C gene"
    ],
    "other": [
      "In vitro radiosensitivity assays showing increased chromosomal breakage"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "rag1-deficiency",
      "distinguishingFeatures": [
        "Mutations in RAG1 gene",
        "Absent B and T cells but normal radiosensitivity"
      ]
    },
    {
      "diseaseId": "dna-ligase-iv-deficiency",
      "distinguishingFeatures": [
        "Mutations in LIG4 gene",
        "Radiosensitivity present but with microcephaly and developmental delay"
      ]
    }
  ],
  "redFlags": [
    "Severe, recurrent infections in infancy",
    "Failure to thrive despite adequate nutrition",
    "Marked lymphopenia on immunophenotyping"
  ],
