  "diagnosticCriteria": {
    "formalCriteriaName": "McGillivray Familial Scaphocephaly Diagnostic Criteria",
    "criteria": [
      {
        "id": "sagittal-suture-fusion",
        "description": "Premature fusion of the sagittal suture confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of sagittal craniosynostosis consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dolichocephaly",
        "description": "Characteristic elongated head shape (dolichocephaly) with scaphocephalic skull morphology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development without intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-syndromic-features",
        "description": "Lack of additional syndromic anomalies such as limb abnormalities or facial dysmorphism",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of premature sagittal suture fusion, characteristic skull shape, and positive family history",
    "notes": "Diagnosis is primarily clinical supported by imaging and family history; genetic testing may be inconclusive."
  },
