  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific biochemical markers"
    ],
    "imaging": [
      "CT or MRI showing craniosynostosis and cloverleaf skull deformity",
      "Echocardiography demonstrating congenital cardiac defects",
      "Brain MRI may reveal hydrocephalus or structural anomalies"
    ],
    "genetic": [
      "Mutations in FGFR2 gene reported in some cases",
      "Genetic testing can confirm diagnosis but is not always definitive",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Clinical evaluation of craniofacial and cardiac anomalies is critical",
      "Developmental assessment for cognitive impairment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pfeiffer-syndrome",
      "distinguishingFeatures": [
        "More prominent limb abnormalities",
        "Absence of significant congenital heart defects",
        "Different FGFR2 mutation spectrum"
      ]
    },
    {
      "diseaseId": "carpenter-syndrome",
      "distinguishingFeatures": [
        "Polysyndactyly rather than broad thumbs",
        "Obesity and hypogenitalism common",
        "Distinct craniosynostosis pattern"
      ]
    }
  ],
  "redFlags": [
    "Severe congenital heart defects causing cyanosis or heart failure",
    "Progressive hydrocephalus with increased intracranial pressure",
    "Respiratory distress due to midface hypoplasia and airway obstruction"
  ],
