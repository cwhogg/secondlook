  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Hemidystonia-Hemiatrophy Syndrome",
    "criteria": [
      {
        "id": "unilateral-dystonia",
        "description": "Presence of dystonia affecting one side of the body",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "contralateral-hemiatrophy",
        "description": "Atrophy of muscles and soft tissues on the side opposite to dystonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other neurological or systemic causes of hemidystonia and hemiatrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-support",
        "description": "Neuroimaging evidence of basal ganglia or cortical abnormalities ipsilateral to dystonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "early-onset",
        "description": "Onset of symptoms typically in childhood or adolescence",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of unilateral dystonia and contralateral hemiatrophy with exclusion of other causes",
    "notes": "Diagnosis is clinical and supported by neuroimaging; genetic testing may be considered to exclude other dystonia syndromes."
  },
