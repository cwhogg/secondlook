  "diagnosticCriteria": {
    "formalCriteriaName": "CFEOM Diagnostic Criteria",
    "criteria": [
      {
        "id": "congenital-onset",
        "description": "Onset of extraocular muscle fibrosis and ophthalmoplegia present at birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "restricted-eye-movement",
        "description": "Bilateral or unilateral restrictive ophthalmoplegia predominantly affecting vertical gaze",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fibrosis-on-imaging",
        "description": "Evidence of fibrosis and hypoplasia of extraocular muscles on orbital MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ptosis",
        "description": "Congenital ptosis with poor levator function",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant or recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital restrictive ophthalmoplegia with fibrosis confirmed by imaging and congenital ptosis",
    "notes": "Genetic testing for KIF21A, PHOX2A, or TUBB3 mutations can support diagnosis"
  },
