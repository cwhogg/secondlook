  "keyFindings": {
    "laboratory": [
      "Hypoglycemia in neonatal period",
      "Elevated alpha-fetoprotein (AFP) levels during tumor surveillance"
    ],
    "imaging": [
      "Ultrasound showing organomegaly",
      "Abdominal wall defect visualization (omphalocele)",
      "Renal ultrasound for Wilms tumor screening"
    ],
    "genetic": [
      "Abnormalities in 11p15 imprinting center",
      "Loss of methylation at IC2 or gain of methylation at IC1",
      "Paternal uniparental disomy of chromosome 11p15"
    ],
    "other": [
      "Clinical diagnosis supported by physical exam findings",
      "Tumor surveillance protocols recommended"
    ]
  },
