      },
      {
        "id": "tubulointerstitial-nephritis",
        "description": "Histological evidence of tubulointerstitial fibrosis and tubular atrophy on biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of autosomal dominant family history, medullary cysts on imaging, and progressive renal failure",
    "notes": "Genetic testing for mutations in MUC1 or UMOD genes can support diagnosis"
