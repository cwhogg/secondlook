  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific biomarkers",
      "Electromyography showing chronic denervation and reinnervation"
    ],
    "imaging": [
      "MRI may show muscle atrophy and fatty infiltration",
      "Chest imaging to assess respiratory muscle involvement"
    ],
    "genetic": [],
    "other": [
      "Electrophysiological studies demonstrating motor unit loss",
      "Pulmonary function tests showing restrictive pattern if respiratory muscles involved"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "amyotrophic-lateral-sclerosis",
      "distinguishingFeatures": [
        "Progressive weakness without prior poliomyelitis",
        "Upper and lower motor neuron signs",
        "Rapid progression compared to postpoliomyelitis syndrome"
      ]
    },
    {
      "diseaseId": "myasthenia-gravis",
      "distinguishingFeatures": [
        "Fluctuating weakness with fatigability",
        "Presence of autoantibodies",
        "Improvement with acetylcholinesterase inhibitors"
      ]
    },
    {
      "diseaseId": "chronic-fatigue-syndrome",
      "distinguishingFeatures": [
        "Absence of focal muscle weakness",
        "Predominant fatigue and cognitive symptoms",
        "No history of poliomyelitis"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive weakness suggesting alternative diagnosis",
    "New onset bulbar symptoms (dysphagia, dysarthria) worsening rapidly",
    "Respiratory failure or severe respiratory muscle weakness"
  ],
