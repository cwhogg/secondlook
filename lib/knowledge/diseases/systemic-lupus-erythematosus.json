  "diagnosticCriteria": {
    "formalCriteriaName": "2019 EULAR/ACR Classification Criteria for SLE",
    "criteria": [
      {
        "id": "sle-1",
        "description": "Positive ANA (antinuclear antibody) at titer >= 1:80 on HEp-2 cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sle-2",
        "description": "Anti-dsDNA antibody positivity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "sle-3",
        "description": "Anti-Smith antibody positivity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "sle-4",
        "description": "Low complement (C3 and/or C4)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "sle-5",
        "description": "Direct Coombs test positive in absence of hemolytic anemia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sle-6",
        "description": "Acute cutaneous lupus (malar rash, photosensitivity, bullous lupus, maculopapular rash)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "sle-7",
        "description": "Chronic cutaneous lupus (discoid rash, lupus panniculitis)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sle-8",
        "description": "Oral or nasal ulcers",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sle-9",
        "description": "Non-scarring alopecia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sle-10",
        "description": "Joint involvement (synovitis or tenderness in >=2 joints with morning stiffness >=30 min)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sle-11",
        "description": "Serositis (pleuritis or pericarditis)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sle-12",
        "description": "Renal involvement (proteinuria >0.5 g/24h or Class II-V lupus nephritis on biopsy)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "sle-13",
        "description": "Neuropsychiatric involvement (seizures, psychosis, delirium)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "sle-14",
        "description": "Hemolytic anemia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sle-15",
        "description": "Leukopenia (<4000/mm3) or lymphopenia (<1000/mm3)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sle-16",
        "description": "Thrombocytopenia (<100,000/mm3)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Positive ANA entry criterion plus total score >= 10 from clinical and immunological domains",
    "notes": "The 2019 EULAR/ACR criteria use a weighted scoring system across 7 clinical and 3 immunological domains. ANA >= 1:80 is the entry criterion."
  },
