  "diagnosticCriteria": {
    "formalCriteriaName": "MONA Diagnostic Criteria",
    "criteria": [
      {
        "id": "multicentric-osteolysis",
        "description": "Radiological evidence of progressive multicentric osteolysis predominantly affecting carpal and tarsal bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "subcutaneous-nodules",
        "description": "Presence of characteristic subcutaneous nodules, especially on hands and feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-arthropathy",
        "description": "Progressive non-inflammatory arthropathy with joint contractures and deformities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the MMP2 or MMP14 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-osteolytic-disorders",
        "description": "Exclusion of other causes of osteolysis such as juvenile idiopathic arthritis or neoplastic processes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (multicentric osteolysis, subcutaneous nodules, and progressive arthropathy) with supportive genetic or exclusion criteria",
    "notes": "Genetic testing aids confirmation but is not mandatory if clinical and radiological features are definitive."
  },
