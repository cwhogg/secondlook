  "keyFindings": {
    "laboratory": [
      "Low cerebrospinal fluid glucose concentration (hypoglycorrhachia) with normal blood glucose",
      "Normal or mildly elevated CSF lactate"
    ],
    "imaging": [
      "Normal brain MRI in most cases",
      "Occasional mild cerebral atrophy or delayed myelination"
    ],
    "genetic": [
      "SLC2A1 (causative, loss-of-function)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Clinical improvement with ketogenic diet therapy"
    ]
  },
