  "keyFindings": {
    "laboratory": [
      "Normal or mildly elevated catecholamine metabolites in rare secretory tumors"
    ],
    "imaging": [
      "MRI: well-defined, homogeneous mass with low T1 and high T2 signal intensity",
      "CT: well-circumscribed mass without calcifications or necrosis",
      "No aggressive invasion or metastasis"
    ],
    "genetic": [
      "ALK (susceptibility)"
    ],
    "other": [
      "Histopathology showing mature ganglion cells and Schwannian stroma without immature neuroblasts"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "neuroblastoma",
      "distinguishingFeatures": [
        "Presence of immature neuroblasts on histology",
        "More aggressive clinical course",
        "Elevated catecholamine metabolites commonly present"
      ]
    },
    {
      "diseaseId": "ganglioneuroblastoma",
      "distinguishingFeatures": [
        "Mixed mature and immature neural elements on biopsy",
        "Intermediate malignancy between ganglioneuroma and neuroblastoma",
        "More rapid growth and possible metastasis"
      ]
    },
    {
      "diseaseId": "schwannoma",
      "distinguishingFeatures": [
        "Absence of ganglion cells on histology",
        "Typically arises from Schwann cells only",
        "Different imaging characteristics"
      ]
    }
  ],
  "redFlags": [
    "Rapid tumor growth",
    "Neurological deficits worsening progressively",
    "Signs of catecholamine crisis (severe hypertension, tachycardia)"
  ],
