  "diagnosticCriteria": {
    "formalCriteriaName": "NICCD Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the SLC25A13 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cholestasis-onset",
        "description": "Onset of intrahepatic cholestasis within the neonatal period (first 3 months of life)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "laboratory-abnormalities",
        "description": "Elevated serum bile acids, direct hyperbilirubinemia, and abnormal liver function tests",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of failure to thrive, hepatomegaly, and hypoglycemia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of neonatal cholestasis such as biliary atresia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of neonatal cholestasis with biallelic SLC25A13 mutations and characteristic laboratory abnormalities",
    "notes": "Genetic testing is essential for definitive diagnosis; liver biopsy may support diagnosis but is not mandatory."
  },
