  "diagnosticCriteria": {
    "formalCriteriaName": "McKusick-Kaufman Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "hydrometrocolpos",
        "description": "Presence of hydrometrocolpos (distended vagina and uterus due to fluid accumulation)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "postaxial-polydactyly",
        "description": "Postaxial polydactyly (extra digits on the ulnar or fibular side)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defect",
        "description": "Congenital heart defects such as atrioventricular septal defect or ventricular septal defect",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the MKKS gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hydrometrocolpos and postaxial polydactyly with or without congenital heart defects",
    "notes": "Genetic testing for MKKS mutations supports diagnosis but is not mandatory."
  },
