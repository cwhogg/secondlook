        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial anomalies including micrognathia and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Intrauterine and postnatal growth retardation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-impairment",
        "description": "Developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital malformations such as cardiac defects or limb abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of mosaic trisomy 3 plus at least one major clinical feature",
    "notes": "Diagnosis relies primarily on cytogenetic analysis due to phenotypic variability."
