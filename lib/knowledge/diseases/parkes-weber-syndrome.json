  "diagnosticCriteria": {
    "formalCriteriaName": "Parkes Weber Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "avm-presence",
        "description": "Presence of multiple high-flow arteriovenous malformations in affected limb",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-overgrowth",
        "description": "Congenital limb hypertrophy or overgrowth, typically affecting one lower extremity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "high-output-cardiac-failure",
        "description": "Clinical or echocardiographic evidence of high-output cardiac failure secondary to AV shunting",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "capillary-malformations",
        "description": "Presence of cutaneous capillary malformations (port-wine stains) overlying affected limb",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic RASA1 gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital limb overgrowth with multiple high-flow arteriovenous malformations",
    "notes": "Genetic testing for RASA1 mutations supports diagnosis but is not mandatory."
  },
