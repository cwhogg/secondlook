  "diagnosticCriteria": {
    "formalCriteriaName": "Chromosomal Microdeletion Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of a heterozygous microdeletion involving the 6q25.2q25.3 chromosomal region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including micrognathia and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defect",
        "description": "Presence of congenital heart defects such as atrial or ventricular septal defects",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 6q25.2q25.3 microdeletion plus presence of developmental delay and at least one characteristic craniofacial feature",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support diagnosis and guide management."
  },
