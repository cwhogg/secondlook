  "diagnosticCriteria": {
    "formalCriteriaName": "Jackson-Weiss syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of cranial sutures, especially coronal sutures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "foot-malformations",
        "description": "Midfoot and metatarsal abnormalities including broad and medially deviated great toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism, midface hypoplasia, and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "FGFR2-mutation",
        "description": "Presence of pathogenic FGFR2 gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis and foot malformations with or without FGFR2 mutation confirmation",
    "notes": "Genetic testing for FGFR2 mutations supports diagnosis but is not mandatory if clinical criteria are met."
  },
