  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Congenital Myasthenic Syndromes",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of fatigable muscle weakness with onset in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electrophysiological evidence of neuromuscular transmission defect (e.g., decremental response on repetitive nerve stimulation)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in known CMS-associated genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-treatment",
        "description": "Improvement of symptoms with acetylcholinesterase inhibitors or other CMS-specific therapies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing specific ultrastructural abnormalities at the neuromuscular junction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of fatigable muscle weakness with electrophysiological evidence of neuromuscular transmission defect and identification of pathogenic variants in CMS-associated genes",
    "notes": "Genetic testing is critical for confirmation and subclassification of CMS."
  },
