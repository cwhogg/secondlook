  "diagnosticCriteria": {
    "formalCriteriaName": "Craniopharyngioma Diagnostic Criteria",
    "criteria": [
      {
        "id": "imaging",
        "description": "Presence of a cystic and/or solid suprasellar mass on MRI or CT with calcifications",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological confirmation showing adamantinomatous or papillary features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Symptoms related to hypothalamic-pituitary axis dysfunction and/or increased intracranial pressure",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Radiological evidence of characteristic suprasellar mass plus histopathological confirmation",
    "notes": "Diagnosis often requires integration of imaging, clinical presentation, and histopathology."
  },
