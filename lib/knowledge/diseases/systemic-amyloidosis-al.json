  "keyFindings": {
    "laboratory": [
      "Monoclonal protein on serum/urine immunofixation",
      "Abnormal serum free light chain ratio",
      "Elevated NT-proBNP and troponin (cardiac involvement)",
      "Proteinuria (often nephrotic range >3.5 g/day)",
      "Elevated alkaline phosphatase (hepatic involvement)",
      "Elevated serum creatinine (renal involvement)"
    ],
    "imaging": [
      "Echocardiography showing increased wall thickness, diastolic dysfunction, granular sparkling myocardium",
      "Cardiac MRI with late gadolinium enhancement (subendocardial diffuse pattern) and elevated native T1",
      "Nuclear scintigraphy (99mTc-PYP) typically negative or mildly positive (unlike ATTR amyloidosis)",
      "Abdominal imaging may show hepatomegaly"
    ],
    "genetic": [
      "Germline testing to exclude hereditary (ATTR, AFib, ALys, AApoAI) amyloidosis",
      "No causative germline mutation in AL amyloidosis (it is an acquired clonal disorder)"
    ],
    "other": [
      "Fat pad aspiration with Congo red stain (~80% sensitivity)",
      "Organ biopsy (kidney, heart, liver) with Congo red showing apple-green birefringence",
      "Mass spectrometry-based amyloid typing (gold standard)",
      "Bone marrow biopsy showing clonal plasma cells (usually <10%)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "attr-amyloidosis",
      "distinguishingFeatures": [
        "ATTR is transthyretin-derived, not light chain",
        "Strongly positive 99mTc-PYP scintigraphy",
        "TTR gene mutation in hereditary form; wild-type in senile",
        "Different treatment approach"
      ]
    },
    {
      "diseaseId": "multiple-myeloma",
      "distinguishingFeatures": [
        "Myeloma has >10% clonal plasma cells and CRAB criteria",
        "Can coexist with AL amyloidosis",
        "Lytic bone lesions in myeloma",
        "Higher paraprotein levels typically"
      ]
    },
    {
      "diseaseId": "hypertrophic-cardiomyopathy",
      "distinguishingFeatures": [
        "HCM has asymmetric septal hypertrophy",
        "Sarcomeric gene mutations",
        "No systemic amyloid features",
        "Different cardiac MRI pattern"
      ]
    },
    {
      "diseaseId": "diabetic-nephropathy",
      "distinguishingFeatures": [
        "History of diabetes mellitus",
        "No monoclonal protein",
        "Kidney biopsy shows diabetic changes, not amyloid"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive heart failure with concentric wall thickening (cardiac amyloidosis)",
    "Unexplained nephrotic syndrome with monoclonal protein",
    "Periorbital purpura or macroglossia (nearly diagnostic)",
    "Multi-organ dysfunction in setting of plasma cell dyscrasia",
    "Bilateral carpal tunnel syndrome preceding cardiac or renal symptoms"
  ],
