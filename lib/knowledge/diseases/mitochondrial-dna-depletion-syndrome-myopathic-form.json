  "keyFindings": {
    "laboratory": [
      "Decreased mitochondrial DNA copy number in muscle tissue",
      "Elevated serum creatine kinase",
      "Lactic acidosis in blood and CSF"
    ],
    "imaging": [
      "Muscle MRI showing fatty infiltration and muscle atrophy",
      "Echocardiogram showing cardiomyopathy in some cases"
    ],
    "genetic": [
      "TK2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy demonstrating ragged red fibers and mitochondrial abnormalities"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "nemaline-myopathy",
      "distinguishingFeatures": [
