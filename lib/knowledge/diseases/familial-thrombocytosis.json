  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Thrombocytosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "persistent-thrombocytosis",
        "description": "Sustained elevated platelet count above 450 x10^9/L in at least two separate measurements",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Presence of thrombocytosis in at least one first-degree relative",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-secondary-causes",
        "description": "Exclusion of reactive or secondary causes of thrombocytosis such as infection, inflammation, iron deficiency, or malignancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of germline mutations in thrombopoietin receptor (MPL) or thrombopoietin (THPO) genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent thrombocytosis with positive family history and exclusion of secondary causes",
    "notes": "Genetic testing can support diagnosis but is not mandatory"
  },
