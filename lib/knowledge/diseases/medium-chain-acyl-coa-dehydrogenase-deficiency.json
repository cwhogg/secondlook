  "diagnosticCriteria": {
    "formalCriteriaName": "MCAD Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the ACADM gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acylcarnitine-profile",
        "description": "Elevated plasma medium-chain acylcarnitines (notably C8) on tandem mass spectrometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Episodes of hypoketotic hypoglycemia and metabolic crisis triggered by fasting or illness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-assay",
        "description": "Reduced MCAD enzyme activity in fibroblasts or lymphocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic ACADM gene variants plus characteristic biochemical abnormalities and clinical presentation",
    "notes": "Newborn screening programs often identify affected individuals before clinical symptoms develop."
  },
