  "diagnosticCriteria": {
    "formalCriteriaName": "Glanzmann Thrombasthenia Diagnostic Criteria",
    "criteria": [
      {
        "id": "platelet-aggregation-defect",
        "description": "Absent or severely reduced platelet aggregation in response to ADP, collagen, and epinephrine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-platelet-count",
        "description": "Normal platelet count and morphology on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in ITGA2B or ITGB3 genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "bleeding-history",
        "description": "History of mucocutaneous bleeding such as epistaxis, gingival bleeding, or menorrhagia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of absent platelet aggregation with normal platelet count and morphology, plus clinical bleeding history",
    "notes": "Genetic testing supports diagnosis but is not mandatory if functional platelet studies are conclusive."
  },
