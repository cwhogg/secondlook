  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for X-linked Retinoschisis",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Bilateral foveal schisis with characteristic spoke-wheel pattern on fundus examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroretinogram",
        "description": "Reduced b-wave amplitude with normal a-wave on electroretinography (ERG)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic RS1 gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical findings plus either compatible ERG findings or confirmed RS1 gene mutation",
    "notes": "Genetic testing is confirmatory; ERG helps differentiate from other retinal dystrophies."
  },
