  "diagnosticCriteria": {
    "formalCriteriaName": "Modified UK Brain Bank Criteria for Juvenile Parkinsonism",
    "criteria": [
      {
        "id": "parkinsonism",
        "description": "Presence of bradykinesia plus at least one of rigidity, resting tremor, or postural instability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset",
        "description": "Onset of parkinsonian symptoms before age 30",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "poor-levodopa-response",
        "description": "Suboptimal or atypical response to levodopa therapy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "atypical-features",
        "description": "Presence of additional neurological signs such as dystonia, pyramidal signs, or cognitive impairment",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-secondary-causes",
        "description": "Exclusion of secondary causes of parkinsonism including drug-induced and metabolic etiologies",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of parkinsonism with onset before age 30, exclusion of secondary causes, and at least one atypical feature or poor levodopa response",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
