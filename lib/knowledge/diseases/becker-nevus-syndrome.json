  "diagnosticCriteria": {
    "formalCriteriaName": "No formal standardized criteria",
    "criteria": [
      {
        "id": "becker-nevus",
        "description": "Presence of Becker nevus characterized by a unilateral hyperpigmented patch with hypertrichosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "musculoskeletal-anomalies",
        "description": "Associated ipsilateral musculoskeletal abnormalities such as hypoplasia or breast hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "other-cutaneous-anomalies",
        "description": "Presence of additional cutaneous anomalies including smooth muscle hamartomas or epidermal nevi",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of Becker nevus plus at least one ipsilateral musculoskeletal or cutaneous anomaly",
    "notes": "Diagnosis is clinical; histopathology may support but is not mandatory"
  },
