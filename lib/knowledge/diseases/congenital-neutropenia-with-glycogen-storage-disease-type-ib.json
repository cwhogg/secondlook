  "keyFindings": {
    "laboratory": [
      "Persistent severe neutropenia (ANC <500/µL)",
      "Hypoglycemia with fasting",
      "Elevated serum lactate, uric acid, and lipids",
      "Elevated liver enzymes",
      "Metabolic acidosis"
    ],
    "imaging": [
      "Hepatomegaly and nephromegaly on ultrasound or CT",
      "Possible splenomegaly"
    ],
    "genetic": [
      "Mutations in SLC37A4 gene encoding glucose-6-phosphate transporter"
    ],
    "other": [
      "Reduced neutrophil respiratory burst activity",
      "Bone marrow showing maturation arrest of myeloid lineage"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "glycogen-storage-disease-type-ia",
      "distinguishingFeatures": [
        "Absence of neutropenia",
        "Deficiency of glucose-6-phosphatase enzyme rather than transporter",
        "Different genetic mutation (G6PC gene)"
      ]
    },
    {
      "diseaseId": "severe-congenital-neutropenia",
      "distinguishingFeatures": [
        "Neutropenia without metabolic abnormalities",
        "Mutations in ELANE or other neutropenia-associated genes",
        "No hepatomegaly or hypoglycemia"
      ]
    }
  ],
  "redFlags": [
    "Severe recurrent bacterial infections in infancy",
    "Persistent severe neutropenia",
    "Hypoglycemic seizures or metabolic crises"
  ],
