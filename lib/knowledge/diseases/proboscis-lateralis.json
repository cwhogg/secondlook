  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Proboscis Lateralis",
    "criteria": [
      {
        "id": "unilateral-nasal-proboscis",
        "description": "Presence of a unilateral tubular nasal appendage (proboscis) lateral to the normal nasal structure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "associated-facial-anomalies",
        "description": "Presence of associated craniofacial anomalies such as hypoplasia or aplasia of the nasal bones or maxillary structures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-normal-nasal-structures",
        "description": "Absence or severe hypoplasia of the ipsilateral normal nasal cavity and nostril",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-confirmation",
        "description": "Radiological imaging confirming the anatomical abnormality of the nasal and adjacent facial structures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of unilateral lateral proboscis with absence or hypoplasia of ipsilateral nasal structures confirmed clinically and radiologically",
    "notes": "Diagnosis is primarily clinical supported by imaging; genetic testing is not routinely diagnostic."
  },
