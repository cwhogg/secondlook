  "keyFindings": {
    "laboratory": [
      "Genetic testing: homozygous GAA repeat expansion in FXN gene (diagnostic)",
      "Frataxin protein levels reduced (research)",
      "Fasting glucose and HbA1c for diabetes screening",
      "Normal CK levels"
    ],
    "imaging": [
      "MRI brain: cerebellar atrophy (mild; less prominent than other cerebellar ataxias)",
      "MRI spine: spinal cord atrophy (cervical cord thinning)",
      "Echocardiography: concentric hypertrophic cardiomyopathy",
      "Cardiac MRI: myocardial fibrosis, iron deposition"
    ],
    "genetic": [
      "FXN (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Nerve conduction studies: absent or severely reduced sensory nerve action potentials (axonal sensory neuropathy)",
      "Motor nerve conduction generally preserved",
      "ECG: T-wave inversions, ventricular hypertrophy",
      "Echocardiography: concentric left ventricular hypertrophy",
      "Annual cardiac monitoring recommended"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "spinocerebellar-ataxia",
      "distinguishingFeatures": [
        "SCAs are typically autosomal dominant",
        "SCAs usually have preserved or brisk reflexes",
        "SCAs do not have sensory neuropathy as prominently",
        "SCAs usually lack cardiomyopathy"
      ]
    },
    {
      "diseaseId": "hereditary-spastic-paraplegia",
      "distinguishingFeatures": [
        "HSP has spasticity as predominant feature, not ataxia",
        "HSP has hyperreflexia throughout",
        "HSP does not have sensory neuropathy or cardiomyopathy"
      ]
    },
    {
      "diseaseId": "ataxia-with-vitamin-E-deficiency",
      "distinguishingFeatures": [
        "AVED has low serum vitamin E levels",
        "AVED is treatable with vitamin E supplementation",
        "Clinically very similar to FA; must be excluded"
      ]
    }
  ],
  "redFlags": [
    "Cardiomyopathy is the leading cause of death - annual echocardiography mandatory",
    "Cardiac arrhythmias can cause sudden death; ECG monitoring recommended",
    "Omaveloxolone (Skyclarys) FDA-approved 2023 for FA age 16+; first approved therapy",
    "Diabetes screening should be performed annually",
    "Scoliosis may require surgical intervention if progressive",
    "Absence of GAA expansion should prompt testing for other ataxias (SCA, AT, AVED, AOA)"
  ],
