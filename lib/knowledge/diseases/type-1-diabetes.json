  "diagnosticCriteria": {
    "formalCriteriaName": "ADA Diagnostic Criteria for Type 1 Diabetes",
    "criteria": [
      {
        "id": "t1d-1",
        "description": "Fasting plasma glucose >= 126 mg/dL (7.0 mmol/L)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "t1d-2",
        "description": "2-hour plasma glucose >= 200 mg/dL (11.1 mmol/L) during OGTT",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "t1d-3",
        "description": "HbA1c >= 6.5%",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "t1d-4",
        "description": "Random plasma glucose >= 200 mg/dL (11.1 mmol/L) with classic hyperglycemic symptoms",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "t1d-5",
        "description": "Positive islet autoantibodies: anti-GAD65, anti-IA2, anti-ZnT8, anti-insulin (IAA), or anti-ICA",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "t1d-6",
        "description": "Low or absent C-peptide indicating absolute insulin deficiency",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Hyperglycemia meeting ADA criteria plus evidence of autoimmune beta-cell destruction (islet autoantibodies) and/or clinical presentation consistent with T1D (acute onset, ketosis-prone, insulin-dependent)",
    "notes": "ADA staging: Stage 1 (2+ autoantibodies, normoglycemia), Stage 2 (2+ autoantibodies, dysglycemia), Stage 3 (clinical diabetes). LADA (latent autoimmune diabetes in adults) presents later with slower progression."
  },
