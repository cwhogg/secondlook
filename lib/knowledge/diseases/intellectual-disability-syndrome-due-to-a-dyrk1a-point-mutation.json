  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible hypothyroidism on thyroid panel"
    ],
    "imaging": [
      "Brain MRI may show reduced brain volume and simplified gyral pattern",
      "Spinal X-rays may reveal scoliosis"
    ],
    "genetic": [
      "DYRK1A (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electroencephalogram (EEG) abnormalities consistent with epilepsy in affected individuals"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "down-syndrome",
      "distinguishingFeatures": [
        "Trisomy 21 chromosomal abnormality",
        "Characteristic facial features distinct from DYRK1A syndrome",
        "Hypotonia present but with different cognitive profile"
      ]
    },
    {
      "diseaseId": "angelman-syndrome",
      "distinguishingFeatures": [
        "Severe intellectual disability with ataxia and frequent laughter",
        "UBE3A gene involvement rather than DYRK1A",
        "Distinct EEG pattern"
      ]
    }
  ],
