  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Scalp-Ear-Nipple Syndrome",
    "criteria": [
      {
        "id": "scalp-hypoplasia",
        "description": "Congenital aplasia or hypoplasia of the scalp skin, especially at the vertex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ear-malformations",
        "description": "Characteristic malformations of the external ear including cup-shaped or low-set ears",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nipple-hypoplasia",
        "description": "Hypoplasia or aplasia of the nipples and areolae",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-anomalies",
        "description": "Presence of dental abnormalities such as hypodontia or enamel hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hair-abnormalities",
        "description": "Sparse or brittle hair",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: scalp aplasia/hypoplasia, ear malformations, and nipple hypoplasia",
    "notes": "Genetic testing for mutations in the KCTD1 gene can support diagnosis"
  },
