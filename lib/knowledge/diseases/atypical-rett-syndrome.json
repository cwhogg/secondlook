  "diagnosticCriteria": {
    "formalCriteriaName": "Revised Rett Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "loss-hand-skills",
        "description": "Partial or complete loss of purposeful hand skills",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hand-stereotypies",
        "description": "Presence of hand stereotypies such as hand wringing or clapping",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "regression",
        "description": "Regression of acquired communication and motor skills",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gait-abnormalities",
        "description": "Abnormalities in gait including apraxia or ataxia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "breathing-dysfunction",
        "description": "Episodes of hyperventilation or breath-holding",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Impaired head growth or microcephaly",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (loss of purposeful hand skills, hand stereotypies, and regression of communication/motor skills) plus supportive clinical features",
    "notes": "Atypical Rett syndrome may present with partial fulfillment of classic criteria and variable severity."
  },
