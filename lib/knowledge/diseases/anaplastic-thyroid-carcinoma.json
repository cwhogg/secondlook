  "keyFindings": {
    "laboratory": [
      "Elevated serum thyroglobulin usually absent or low",
      "Hypercalcemia in paraneoplastic syndrome",
      "Non-specific inflammatory markers elevated (e.g. ESR, CRP)"
    ],
    "imaging": [
      "Ultrasound showing large heterogeneous thyroid mass with invasion",
      "CT/MRI demonstrating local invasion into trachea, esophagus, and vessels",
      "PET-CT showing hypermetabolic thyroid lesion and distant metastases"
    ],
    "genetic": [
      "Mutations in TP53 gene common",
      "BRAF V600E mutations may be present",
      "TERT promoter mutations frequently detected"
    ],
    "other": [
      "Histopathology showing undifferentiated malignant cells with high mitotic index",
      "Immunohistochemistry negative for thyroglobulin and TTF-1"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "poorly-differentiated-thyroid-carcinoma",
      "distinguishingFeatures": [
        "Less aggressive clinical course",
        "Partial retention of thyroid differentiation markers",
        "Slower tumor growth compared to anaplastic carcinoma"
      ]
    },
    {
      "diseaseId": "thyroid-lymphoma",
      "distinguishingFeatures": [
        "Presence of lymphoid cells on biopsy",
        "Better response to chemotherapy and radiotherapy",
        "Usually associated with Hashimoto thyroiditis"
      ]
    },
    {
      "diseaseId": "medullary-thyroid-carcinoma",
      "distinguishingFeatures": [
        "Calcitonin elevation in serum",
        "Amyloid deposits on histology",
        "Originates from parafollicular C cells"
      ]
    }
  ],
  "redFlags": [
    "Rapidly enlarging neck mass with airway compromise",
    "Hoarseness indicating recurrent laryngeal nerve involvement",
    "Dysphagia or stridor suggesting local invasion",
    "Unexplained hypercalcemia in thyroid cancer patient"
  ],
