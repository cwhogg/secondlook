  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnostic criteria for Cartilage-hair hypoplasia",
    "criteria": [
      {
        "id": "short-limbs",
        "description": "Short-limbed dwarfism with metaphyseal dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hair-abnormalities",
        "description": "Fine, sparse, hypoplastic, and hypopigmented hair",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Variable T-cell immunodeficiency manifesting as recurrent infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rmrp-mutation",
        "description": "Pathogenic mutations in the RMRP gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anemia",
        "description": "Mild to moderate anemia and bone marrow dysfunction",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of short-limbed dwarfism with metaphyseal dysplasia, characteristic hair abnormalities, immunodeficiency, and confirmation of RMRP gene mutation",
    "notes": "Genetic testing is essential for definitive diagnosis; immunodeficiency severity varies widely."
  },
