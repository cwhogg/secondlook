  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for SPG63",
    "criteria": [
      {
        "id": "clinical-spasticity",
        "description": "Progressive lower limb spasticity and weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the ENTPD1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of spastic paraplegia by neuroimaging and metabolic testing",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consistent autosomal recessive inheritance pattern or consanguinity",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive lower limb spasticity and weakness plus genetic confirmation of biallelic ENTPD1 pathogenic variants, with exclusion of other causes",
    "notes": "Genetic testing is essential for definitive diagnosis due to phenotypic overlap with other hereditary spastic paraplegias."
  },
