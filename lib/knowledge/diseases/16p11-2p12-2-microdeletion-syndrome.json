  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible thyroid function abnormalities",
      "Standard metabolic screening usually unremarkable"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter changes or delayed myelination",
      "Echocardiogram may reveal congenital heart defects"
    ],
    "genetic": [
      "Chromosomal microarray analysis showing heterozygous deletion at 16p11.2p12.2",
      "FISH or MLPA confirming microdeletion"
    ],
    "other": [
      "Neurodevelopmental assessment revealing intellectual disability and developmental delay",
      "Dysmorphology evaluation identifying characteristic facial features"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "16p11-2-microdeletion-syndrome",
      "distinguishingFeatures": [
        "Deletion limited to 16p11.2 without extension to p12.2",
        "Different spectrum of neurodevelopmental and physical features"
      ]
    },
