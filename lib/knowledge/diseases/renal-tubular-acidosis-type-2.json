  "keyFindings": {
    "laboratory": [
      "Low serum bicarbonate",
      "Normal anion gap metabolic acidosis",
      "Hypokalemia",
      "Hypophosphatemia",
      "Increased urinary bicarbonate excretion",
      "Low serum phosphate",
      "Glycosuria and aminoaciduria in Fanconi syndrome"
    ],
    "imaging": [
      "Renal ultrasound showing nephrocalcinosis or nephrolithiasis",
      "Bone X-rays showing rickets or osteomalacia"
    ],
    "genetic": [
      "Mutations in SLC4A4 gene (NBCe1 transporter) in inherited forms",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Bicarbonate loading test demonstrating proximal tubular bicarbonate leak"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "renal-tubular-acidosis-type-1",
      "distinguishingFeatures": [
        "Distal tubular defect with inability to acidify urine (urine pH >5.5)",
        "Associated with nephrolithiasis and hypokalemia",
        "Different genetic mutations (e.g. ATP6V1B1)"
      ]
    },
    {
      "diseaseId": "fanconi-syndrome",
      "distinguishingFeatures": [
        "Generalized proximal tubular dysfunction including glycosuria, aminoaciduria, phosphaturia",
        "Often secondary to toxins, drugs, or inherited metabolic disorders",
        "More widespread tubular defects beyond bicarbonate reabsorption"
      ]
    }
  ],
  "redFlags": [
    "Severe hypokalemia causing cardiac arrhythmias",
    "Progressive growth failure in children",
    "Development of nephrocalcinosis or nephrolithiasis"
  ],
