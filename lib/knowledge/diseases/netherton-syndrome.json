  "keyFindings": {
    "laboratory": [
      "Elevated serum IgE levels",
      "Peripheral eosinophilia",
      "Skin biopsy showing psoriasiform hyperplasia and absent or reduced LEKTI protein"
    ],
    "imaging": [
      "Not routinely required; imaging may be used to evaluate complications such as infections"
    ],
    "genetic": [
      "Mutations in SPINK5 gene encoding LEKTI protein"
    ],
    "other": [
      "Light microscopy of hair shafts showing trichorrhexis invaginata"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ichthyosis-vulgaris",
      "distinguishingFeatures": [
        "Absence of trichorrhexis invaginata",
        "Less severe skin scaling",
        "No associated atopic diathesis with elevated IgE"
      ]
    },
    {
      "diseaseId": "atopic-dermatitis",
      "distinguishingFeatures": [
        "Lack of ichthyosis linearis circumflexa",
        "No hair shaft abnormalities",
        "Typically later onset"
      ]
    },
    {
      "diseaseId": "lamellar-ichthyosis",
      "distinguishingFeatures": [
        "Generalized scaling without migratory plaques",
        "No hair shaft defects",
        "Different genetic mutations"
      ]
    }
  ],
