  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Familial Peripheral Male-Limited Precocious Puberty",
    "criteria": [
      {
        "id": "early-pubertal-onset",
        "description": "Onset of secondary sexual characteristics before age 4 years in males",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-testosterone-with-low-gonadotropins",
        "description": "Elevated serum testosterone levels with suppressed luteinizing hormone (LH) and follicle-stimulating hormone (FSH)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gnrhr-independent-testosterone-production",
        "description": "Evidence of gonadotropin-independent testosterone production",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lhcg-receptor-gene-mutation",
        "description": "Identification of activating mutation in the luteinizing hormone/choriogonadotropin receptor (LHCGR) gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of male-limited precocious puberty",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early pubertal onset in males with elevated testosterone and suppressed gonadotropins, with or without confirmed LHCGR mutation",
    "notes": "Genetic testing for LHCGR mutations is confirmatory but not always available."
  },
