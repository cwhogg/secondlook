  "diagnosticCriteria": {
    "formalCriteriaName": "Mohr-Tranebjaerg Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "sensorineural-deafness",
        "description": "Progressive sensorineural hearing loss beginning in childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dystonia",
        "description": "Progressive dystonia and movement disorders",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "optic-atrophy",
        "description": "Optic atrophy leading to visual impairment",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "TIMM8A-mutation",
        "description": "Pathogenic mutation in the TIMM8A gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuropsychiatric-features",
        "description": "Neuropsychiatric symptoms including cognitive decline and behavioral changes",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive sensorineural hearing loss and dystonia with confirmed TIMM8A gene mutation",
    "notes": "Optic atrophy and neuropsychiatric features support diagnosis but are not mandatory."
  },
