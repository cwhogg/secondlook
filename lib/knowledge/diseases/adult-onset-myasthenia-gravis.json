    "formalCriteriaName": "Myasthenia Gravis Foundation of America (MGFA) Clinical Classification",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of fluctuating skeletal muscle weakness, typically worsening with activity and improving with rest",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoantibody-detection",
        "description": "Detection of acetylcholine receptor (AChR) antibodies or muscle-specific kinase (MuSK) antibodies in serum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiological-testing",
        "description": "Abnormal decremental response on repetitive nerve stimulation or increased jitter on single-fiber electromyography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-anticholinesterase",
        "description": "Clinical improvement after administration of anticholinesterase agents (e.g., edrophonium test)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic fluctuating muscle weakness plus either positive autoantibody testing or electrophysiological evidence of neuromuscular transmission defect",
    "notes": "Diagnosis may be supported by thymic imaging and response to therapy"
  },
