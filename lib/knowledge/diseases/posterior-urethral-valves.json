  "diagnosticCriteria": {
    "formalCriteriaName": "Posterior Urethral Valve Diagnostic Criteria",
    "criteria": [
      {
        "id": "valve-visualization",
        "description": "Endoscopic visualization of obstructive membranous folds in the posterior urethra",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "voiding-cystourethrogram",
        "description": "Radiologic evidence of dilated posterior urethra with bladder outlet obstruction on voiding cystourethrogram (VCUG)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "prenatal-ultrasound",
        "description": "Prenatal ultrasound showing bilateral hydronephrosis and thickened bladder wall",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Endoscopic visualization of valves or radiologic evidence of posterior urethral obstruction on VCUG",
    "notes": "Diagnosis is primarily confirmed by cystoscopic examination; prenatal imaging aids early suspicion."
  },
