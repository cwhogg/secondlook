  "diagnosticCriteria": {
    "formalCriteriaName": "Holm et al. Consensus Diagnostic Criteria (1993) with Genetic Confirmation",
    "criteria": [
      {
        "id": "pws-c1",
        "description": "Neonatal/infantile hypotonia with poor suck",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pws-c2",
        "description": "Feeding problems in infancy requiring special feeding techniques",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pws-c3",
        "description": "Excessive weight gain between 1-6 years with central obesity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pws-c4",
        "description": "Characteristic facial features (narrow bifrontal diameter, almond-shaped eyes, thin upper lip, down-turned mouth)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pws-c5",
        "description": "Hypogonadism (genital hypoplasia, delayed/incomplete puberty)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pws-c6",
        "description": "Developmental delay / mild to moderate intellectual disability (IQ 60-70 typical)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pws-c7",
        "description": "Hyperphagia (excessive appetite) and food-seeking behavior after age 2-4 years",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pws-c8",
        "description": "Genetic confirmation: loss of paternal expression of 15q11-q13 region",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical suspicion confirmed by DNA methylation analysis showing absence of paternally expressed 15q11-q13. Methylation testing detects >99% of cases.",
    "notes": "Three genetic mechanisms: paternal deletion (~70%), maternal uniparental disomy (~25%), imprinting center defect (~2-5%). Clinical criteria are scored (major = 1 point, minor = 0.5 point); >= 5 points in children >3 years or >= 8 points in adults triggers testing."
  },
