  "keyFindings": {
    "laboratory": [
      "Elevated conjugated bilirubin",
      "Increased serum bile acids",
      "Prolonged prothrombin time due to vitamin K deficiency"
    ],
    "imaging": [
      "Ultrasound showing hepatomegaly and normal biliary tree",
      "Lymphoscintigraphy demonstrating lymphatic obstruction in lower limbs"
    ],
    "genetic": [
      "Mutations in CCBE1 gene associated with autosomal recessive inheritance"
    ],
    "other": [
      "Liver biopsy showing bile duct paucity and portal fibrosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "biliary-atresia",
      "distinguishingFeatures": [
        "Obstruction of extrahepatic bile ducts",
        "Requires surgical intervention (Kasai procedure)",
        "Usually no lymphedema present"
      ]
    },
    {
      "diseaseId": "primary-lymphedema",
      "distinguishingFeatures": [
        "Lymphedema without cholestasis",
        "Onset may be later in childhood or adolescence",
        "No liver dysfunction or bile duct abnormalities"
      ]
    },
    {
      "diseaseId": "progressive familial intrahepatic cholestasis",
      "distinguishingFeatures": [
        "Severe cholestasis without lymphedema",
        "Mutations in different genes (e.g., ATP8B1, ABCB11)",
        "Progressive liver failure in infancy or childhood"
      ]
    }
  ],
  "redFlags": [
    "Persistent conjugated hyperbilirubinemia beyond neonatal period",
    "Early onset bilateral lower limb swelling with skin changes",
    "Recurrent cellulitis or infections in edematous limbs"
  ],
