  "keyFindings": {
    "laboratory": [
      "Reduced hyaluronidase enzyme activity in leukocytes or fibroblasts",
      "Normal urinary glycosaminoglycan excretion (unlike other MPS types)"
    ],
    "imaging": [
      "Soft tissue masses visible on MRI around joints",
      "Joint space narrowing and subchondral cysts on X-ray"
    ],
    "genetic": [
      "Mutations in HYAL1 gene confirmed by molecular genetic testing"
    ],
    "other": [
      "Histopathology showing mucopolysaccharide accumulation in connective tissue"
    ]
  },
