  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electrophysiological Diagnostic Criteria for Autosomal Recessive Axonal Neuropathy with Neuromyotonia",
    "criteria": [
      {
        "id": "clinical-neuromyotonia",
        "description": "Presence of neuromyotonia characterized by continuous muscle fiber activity and delayed muscle relaxation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "axonal-neuropathy-evidence",
        "description": "Electrophysiological evidence of axonal sensorimotor peripheral neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in causative gene(s) associated with the disorder",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-sensory-motor-symptoms",
        "description": "Symmetric distal muscle weakness and sensory loss predominantly in lower limbs",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of neuromyotonia and electrophysiological evidence of axonal neuropathy plus genetic confirmation of biallelic pathogenic variants",
    "notes": "Diagnosis requires exclusion of other causes of neuropathy and neuromyotonia."
  },
