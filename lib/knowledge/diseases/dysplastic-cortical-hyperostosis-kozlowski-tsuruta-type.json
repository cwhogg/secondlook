  "diagnosticCriteria": {
    "formalCriteriaName": "Kozlowski-Tsuruta Diagnostic Criteria for Dysplastic Cortical Hyperostosis",
    "criteria": [
      {
        "id": "cortical-hyperostosis",
        "description": "Radiological evidence of irregular cortical hyperostosis predominantly affecting long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysplastic-bone-structure",
        "description": "Histopathological confirmation of dysplastic bone remodeling with cortical thickening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-childhood-onset",
        "description": "Clinical onset of symptoms during infancy or early childhood",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-inflammatory-markers",
        "description": "Lack of systemic inflammatory markers despite bone abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (radiological cortical hyperostosis and histopathological dysplastic bone remodeling) with clinical onset in early childhood",
    "notes": "Diagnosis requires exclusion of other causes of cortical hyperostosis such as infantile cortical hyperostosis and other sclerosing bone dysplasias."
  },
