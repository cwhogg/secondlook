  "diagnosticCriteria": {
    "formalCriteriaName": "Mitochondrial Disease Diagnostic Criteria (MDC)",
    "criteria": [
      {
        "id": "biochemical-evidence",
        "description": "Demonstration of isolated deficiency of mitochondrial complex I enzyme activity in muscle or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical features consistent with mitochondrial disease including neurological and muscular symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in nuclear or mitochondrial genes encoding complex I subunits or assembly factors",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Brain MRI showing basal ganglia or brainstem abnormalities consistent with mitochondrial dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "lactate-elevation",
        "description": "Elevated blood or CSF lactate levels indicating mitochondrial respiratory chain dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biochemical evidence of isolated complex I deficiency plus compatible clinical features and either genetic confirmation or supportive imaging/laboratory findings",
    "notes": "Diagnosis requires integration of clinical, biochemical, genetic, and imaging data."
  },
