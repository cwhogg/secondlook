  "diagnosticCriteria": {
    "formalCriteriaName": "Biochemical and Genetic Diagnosis of Iminoglycinuria",
    "criteria": [
      {
        "id": "urinary-aminoacid-excretion",
        "description": "Elevated urinary excretion of glycine, proline, and hydroxyproline detected by amino acid chromatography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in SLC36A2, SLC6A20, or related transporter genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of asymptomatic or mild clinical features such as aminoaciduria without systemic illness",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated urinary excretion of iminoglycines combined with pathogenic variants in relevant transporter genes",
    "notes": "Diagnosis is primarily biochemical and genetic; clinical symptoms are often absent or mild."
  },
