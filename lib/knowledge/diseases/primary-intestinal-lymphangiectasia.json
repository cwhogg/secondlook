  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Primary Intestinal Lymphangiectasia",
    "criteria": [
      {
        "id": "intestinal-lymphatic-dilation",
        "description": "Histological evidence of dilated intestinal lymphatic vessels on biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "protein-losing-enteropathy",
        "description": "Clinical and laboratory evidence of protein-losing enteropathy (hypoalbuminemia, hypogammaglobulinemia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "edema",
        "description": "Presence of peripheral edema due to hypoproteinemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphopenia",
        "description": "Laboratory finding of lymphopenia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-lymphatic-dilation",
        "description": "Imaging evidence (e.g. lymphangiography, MRI) of intestinal lymphatic dilation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histological confirmation of dilated intestinal lymphatics plus clinical evidence of protein-losing enteropathy and edema",
    "notes": "Diagnosis is supported by exclusion of secondary causes of intestinal lymphangiectasia"
  },
