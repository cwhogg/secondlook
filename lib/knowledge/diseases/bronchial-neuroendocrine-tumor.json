  "keyFindings": {
    "laboratory": [
      "Elevated serum chromogranin A",
      "Increased urinary 5-HIAA in functional tumors",
      "Possible elevated ACTH in ectopic Cushing syndrome"
    ],
    "imaging": [
      "Chest CT showing well-defined bronchial mass",
      "Somatostatin receptor scintigraphy (Octreoscan) positive uptake",
      "MRI for local staging and metastasis evaluation"
    ],
    "genetic": [
      "No consistent germline mutations; occasional MEN1 gene mutations in familial cases"
    ],
    "other": [
      "Bronchoscopic visualization of endobronchial lesion",
      "Histopathology with neuroendocrine morphology and mitotic count assessment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "bronchogenic-carcinoma",
      "distinguishingFeatures": [
        "Higher mitotic rate and necrosis on histology",
        "Lack of neuroendocrine marker positivity",
        "More aggressive clinical course"
      ]
    },
    {
      "diseaseId": "pulmonary-adenocarcinoma",
      "distinguishingFeatures": [
        "Glandular differentiation on histology",
        "Negative neuroendocrine immunohistochemistry",
        "Different radiologic appearance"
      ]
    },
    {
      "diseaseId": "small-cell-lung-cancer",
      "distinguishingFeatures": [
        "High mitotic index and necrosis",
        "More aggressive behavior",
        "Distinct immunohistochemical profile"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive respiratory obstruction",
