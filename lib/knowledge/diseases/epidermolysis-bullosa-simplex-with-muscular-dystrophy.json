  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for EBS-MD",
    "criteria": [
      {
        "id": "skin-blistering",
        "description": "Recurrent skin blistering and fragility primarily on hands and feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-weakness",
        "description": "Progressive proximal muscle weakness consistent with limb-girdle muscular dystrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "plectin-gene-mutation",
        "description": "Identification of pathogenic mutations in the PLEC gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing intraepidermal blister formation with keratinocyte cytolysis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "Electromyographic evidence of myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent skin blistering and progressive muscle weakness with confirmed PLEC gene mutation",
    "notes": "Diagnosis is confirmed by genetic testing; skin biopsy and EMG are supportive."
  },
