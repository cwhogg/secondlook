  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Ring Chromosome 12 Syndrome",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Detection of ring chromosome 12 by karyotyping or molecular cytogenetic analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Pre- and postnatal growth retardation with short stature",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic craniofacial dysmorphisms including microcephaly, micrognathia, and hypertelorism",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital malformations such as cardiac defects or skeletal abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of ring chromosome 12 plus at least one major clinical feature such as growth retardation or developmental delay",
    "notes": "Diagnosis relies heavily on cytogenetic analysis; clinical features are variable and may overlap with other chromosomal disorders."
