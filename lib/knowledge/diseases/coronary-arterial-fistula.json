  "keyFindings": {
    "laboratory": [
      "Elevated brain natriuretic peptide (BNP) in cases with heart failure",
      "Blood cultures positive in cases complicated by endocarditis"
    ],
    "imaging": [
      "Echocardiography showing abnormal flow and chamber enlargement",
      "Coronary angiography demonstrating fistulous connection",
      "Cardiac CT or MRI delineating fistula anatomy"
    ],
    "genetic": [
      "No specific genetic mutations identified; usually sporadic"
    ],
    "other": [
      "Electrocardiogram abnormalities including arrhythmias or signs of chamber enlargement"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ventricular-septal-defect",
      "distinguishingFeatures": [
        "Shunt between ventricles rather than coronary artery",
        "Different murmur characteristics",
        "Echocardiography shows septal defect"
      ]
    },
    {
      "diseaseId": "patent-ductus-arteriosus",
      "distinguishingFeatures": [
        "Connection between aorta and pulmonary artery",
        "Continuous murmur but located at different auscultation sites",
        "Different hemodynamic consequences"
      ]
    },
    {
      "diseaseId": "coronary-artery-aneurysm",
      "distinguishingFeatures": [
        "Dilation of coronary artery without fistulous communication",
        "No continuous murmur",
        "Imaging shows aneurysmal segment"
      ]
    }
  ],
