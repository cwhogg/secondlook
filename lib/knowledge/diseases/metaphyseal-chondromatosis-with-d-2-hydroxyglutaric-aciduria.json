  "keyFindings": {
    "laboratory": [
      "Marked elevation of D-2-hydroxyglutaric acid in urine and plasma organic acid analysis",
      "Normal or mildly elevated serum lactate"
    ],
    "imaging": [
      "Radiographs showing metaphyseal chondromatosis with metaphyseal widening, flaring, and irregularity",
      "Occasional mild osteopenia"
    ],
    "genetic": [
      "IDH1 (somatic)"
    ],
    "other": [
      "Developmental assessment revealing mild to moderate delay",
      "Electroencephalogram abnormalities in patients with seizures"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "d-2-hydroxyglutaric-aciduria-type-i",
      "distinguishingFeatures": [
        "Absence of metaphyseal chondromatosis on imaging",
        "More severe neurological impairment",
        "Different genetic mutations (IDH2 gene)"
      ]
    },
    {
      "diseaseId": "metaphyseal-chondrodysplasia-type-spahr",
      "distinguishingFeatures": [
        "Lack of elevated D-2-hydroxyglutaric aciduria",
        "Different radiographic metaphyseal changes",
        "No associated metabolic abnormalities"
      ]
    }
  ],
  "redFlags": [
    "Progressive neurological deterioration",
    "Severe skeletal deformities causing functional impairment",
    "Onset of seizures or status epilepticus"
  ],
