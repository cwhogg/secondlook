        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-diseases",
        "description": "Exclusion of other causes such as Sjögren syndrome and lymphoma",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical swelling, elevated serum IgG4, and confirmatory histopathology with exclusion of other diseases",
    "notes": "Diagnosis requires integration of clinical, serological, and histopathological findings."
