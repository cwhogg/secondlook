  "diagnosticCriteria": {
    "formalCriteriaName": "Fanconi Anemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "chromosomal-breakage-test",
        "description": "Increased chromosomal breakage in peripheral blood lymphocytes after exposure to DNA cross-linking agents (e.g., diepoxybutane or mitomycin C)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-failure",
        "description": "Evidence of bone marrow failure including aplastic anemia or pancytopenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-abnormalities",
        "description": "Presence of characteristic congenital malformations such as radial ray defects, short stature, or skin pigmentation abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of increased chromosomal breakage on testing plus bone marrow failure; congenital abnormalities support diagnosis but are not mandatory",
    "notes": "Genetic testing for pathogenic variants in FA genes can confirm diagnosis"
  },
