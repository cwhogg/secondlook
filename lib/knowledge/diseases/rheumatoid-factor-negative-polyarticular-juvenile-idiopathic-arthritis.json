  "diagnosticCriteria": {
    "formalCriteriaName": "International League of Associations for Rheumatology (ILAR) criteria for juvenile idiopathic arthritis",
    "criteria": [
      {
        "id": "arthritis-duration",
        "description": "Arthritis affecting five or more joints during the first six months of disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rf-negative",
        "description": "Negative rheumatoid factor on at least two occasions at least three months apart",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-onset",
        "description": "Onset of arthritis before the age of 16 years",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-conditions",
        "description": "Exclusion of other forms of juvenile idiopathic arthritis and other causes of arthritis",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-systemic-features",
        "description": "Absence of systemic features such as fever, rash, or serositis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Arthritis affecting five or more joints for at least six weeks, onset before age 16, negative rheumatoid factor on two occasions, and exclusion of other JIA subtypes and conditions",
    "notes": "Diagnosis requires careful exclusion of other JIA categories and infectious or autoimmune mimics."
  },
