  "diagnosticCriteria": {
    "formalCriteriaName": "Polymicrogyria Diagnostic Criteria",
    "criteria": [
      {
        "id": "imaging",
        "description": "MRI demonstrating bilateral and widespread polymicrogyria involving multiple lobes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical",
        "description": "Presence of developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological",
        "description": "Epilepsy or seizure disorder consistent with cortical malformation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic",
        "description": "Identification of pathogenic variants in genes associated with polymicrogyria (e.g., PIK3R2, WDR62)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "MRI evidence of bilateral generalized polymicrogyria plus clinical features of developmental delay and seizures",
    "notes": "Genetic testing can support diagnosis but is not mandatory."
  },
