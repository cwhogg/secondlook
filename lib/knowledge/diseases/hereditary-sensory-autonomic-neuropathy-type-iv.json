  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Elevated inflammatory markers during infections"
    ],
    "imaging": [
      "X-rays showing bone fractures and osteomyelitis",
      "MRI may show peripheral nerve abnormalities"
    ],
    "genetic": [
      "Pathogenic mutations in NTRK1 gene (neurotrophic tyrosine kinase receptor type 1)"
    ],
    "other": [
      "Nerve biopsy showing loss of small myelinated and unmyelinated fibers",
      "Sweat test demonstrating anhidrosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hereditary-sensory-autonomic-neuropathy-type-iii",
      "distinguishingFeatures": [
        "Presence of prominent autonomic dysfunction with normal pain sensation",
        "Mutations in IKBKAP gene",
        "Characteristic facial features and developmental delay"
      ]
    },
    {
      "diseaseId": "congenital-insensitivity-to-pain-with-anhidrosis-type-v",
      "distinguishingFeatures": [
        "Similar pain insensitivity but with preserved sweating",
        "Mutations in different genes (e.g., SCN9A)",
        "Less severe autonomic dysfunction"
      ]
    }
  ],
  "redFlags": [
    "Recurrent unexplained hyperpyrexia in infancy",
    "Self-inflicted injuries without pain response",
    "Non-healing wounds and osteomyelitis"
  ],
