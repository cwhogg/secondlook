  "keyFindings": {
    "laboratory": [
      "Skin fibroblast culture showing abnormal type III collagen (historical method)",
      "Normal coagulation studies despite bruising"
    ],
    "imaging": [
      "CT angiography for vascular surveillance (non-invasive preferred)",
      "MR angiography as alternative to CTA",
      "Avoid invasive catheter-based angiography due to arterial fragility"
    ],
    "genetic": [
      "COL3A1 (causative)",
      "Autosomal dominant inheritance; ~50% de novo",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy with electron microscopy may show collagen fibril abnormalities",
      "Non-invasive vascular assessment recommended over invasive procedures"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ehlers-danlos-classical",
      "distinguishingFeatures": [
        "cEDS has marked skin hyperextensibility (vEDS skin is thin, not hyperextensible)",
        "cEDS has atrophic scars (vEDS bruising predominates)",
        "cEDS confirmed by COL5A1/COL5A2, not COL3A1"
      ]
    },
    {
      "diseaseId": "loeys-dietz-syndrome",
      "distinguishingFeatures": [
        "LDS has aortic root aneurysm and tortuous arteries",
        "LDS features bifid uvula or cleft palate",
        "LDS has hypertelorism",
        "LDS caused by TGFBR1/TGFBR2 mutations"
      ]
    },
    {
      "diseaseId": "marfan-syndrome",
      "distinguishingFeatures": [
        "Marfan has tall stature and arachnodactyly",
        "Marfan has ectopia lentis",
        "Marfan has aortic root dilation; vEDS affects medium arteries",
        "FBN1 mutation in Marfan"
      ]
    }
  ],
  "redFlags": [
    "Sudden severe abdominal or chest pain (suspect arterial rupture or bowel perforation)",
    "Unexplained drop in hemoglobin (internal hemorrhage)",
    "Pregnancy in confirmed vEDS (high maternal mortality risk)",
    "Any planned invasive or surgical procedure (high complication risk)",
    "Family history of unexplained sudden death at young age"
  ],
  "specialistType": [
