  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for CMT2B1",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of distal muscle weakness and atrophy predominantly in lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electrophysiological evidence of axonal sensorimotor neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the RAB7A gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal recessive inheritance pattern or positive family history consistent with CMT2B1",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "sensory-loss",
        "description": "Distal sensory loss and impaired proprioception",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of distal sensorimotor neuropathy confirmed by electrophysiology plus identification of pathogenic RAB7A mutation",
    "notes": "Genetic testing is essential for definitive diagnosis due to phenotypic overlap with other CMT subtypes."
  },
