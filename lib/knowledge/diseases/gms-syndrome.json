  "diagnosticCriteria": {
    "formalCriteriaName": "GMS Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including micrognathia and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Radiological evidence of multiple skeletal abnormalities such as vertebral segmentation defects and limb malformations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the GMS gene or related loci",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-anomalies",
        "description": "Presence of congenital heart defects such as septal defects",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (craniofacial dysmorphism and skeletal abnormalities) with or without genetic confirmation",
    "notes": "Genetic testing is supportive but not mandatory for diagnosis; clinical presentation is primary."
  },
