  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Microform Holoprosencephaly",
    "criteria": [
      {
        "id": "facial-midline-defects",
        "description": "Presence of characteristic midline facial anomalies such as hypotelorism, single central maxillary incisor, or midline cleft lip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-imaging-abnormalities",
        "description": "Neuroimaging evidence of incomplete separation of the cerebral hemispheres or midline brain structure abnormalities consistent with holoprosencephaly spectrum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with holoprosencephaly (e.g., SHH, ZIC2, SIX3)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least one major facial midline anomaly and corresponding brain imaging abnormalities",
    "notes": "Genetic testing supports diagnosis but is not mandatory; clinical presentation can be subtle."
  },
