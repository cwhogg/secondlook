  "diagnosticCriteria": {
    "formalCriteriaName": "Connor et al. Antisynthetase Syndrome Criteria",
    "criteria": [
      {
        "id": "antisynthetase-antibodies",
        "description": "Presence of antisynthetase autoantibodies (e.g., anti-Jo-1, anti-PL-7, anti-PL-12)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "interstitial-lung-disease",
        "description": "Evidence of interstitial lung disease confirmed by imaging or pulmonary function tests",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "myositis",
        "description": "Clinical or laboratory evidence of inflammatory myopathy (elevated CK, muscle weakness, EMG abnormalities)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "mechanic-hands",
        "description": "Characteristic hyperkeratotic fissuring of the lateral and palmar aspects of the fingers (‘mechanic’s hands’)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "arthritis",
        "description": "Non-erosive arthritis involving small joints",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of antisynthetase antibodies plus either interstitial lung disease or myositis",
    "notes": "Diagnosis relies heavily on serologic testing combined with clinical features; not all patients have all manifestations."
  },
