  "diagnosticCriteria": {
    "formalCriteriaName": "Cold Agglutinin Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "cold-agglutinin-titer",
        "description": "Presence of cold agglutinin antibodies with a titer ≥1:64 at 4°C",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemolytic-anemia",
        "description": "Evidence of hemolytic anemia including elevated LDH, low haptoglobin, and reticulocytosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "direct-antiglobulin-test",
        "description": "Positive direct antiglobulin test (DAT) for complement (C3d) only",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Symptoms exacerbated by cold exposure such as acrocyanosis or Raynaud phenomenon",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (cold agglutinin titer ≥1:64, hemolytic anemia, and positive DAT for complement) must be met",
    "notes": "Exclusion of secondary causes such as infections or lymphoproliferative disorders is recommended"
  },
