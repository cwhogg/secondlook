  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnosis of Mal de Meleda",
    "criteria": [
      {
        "id": "palmoplantar-keratoderma",
        "description": "Diffuse transgredient palmoplantar keratoderma with erythema and hyperkeratosis extending beyond palms and soles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "perioral-erythema",
        "description": "Characteristic perioral erythema and scaling",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the SLURP1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nail-dystrophy",
        "description": "Nail abnormalities including dystrophy and subungual hyperkeratosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "digital-constriction",
        "description": "Digital constriction and pseudoainhum formation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of diffuse transgredient palmoplantar keratoderma plus either perioral erythema or confirmed SLURP1 mutation",
    "notes": "Genetic testing is confirmatory; clinical features are essential for initial suspicion."
  },
