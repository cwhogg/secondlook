  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Adult-Onset Ataxia Diagnostic Criteria",
    "criteria": [
      {
        "id": "progressive-ataxia",
        "description": "Progressive cerebellar ataxia manifesting as gait instability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of ataxia consistent with autosomal dominant or recessive inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of acquired causes of ataxia (e.g., vitamin deficiencies, toxins, autoimmune)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-genetic-testing",
        "description": "Identification of pathogenic mutation in known ataxia-related gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cerebellar-atrophy-imaging",
        "description": "MRI evidence of cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia with positive family history and exclusion of acquired causes",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical criteria are met."
  },
