  "diagnosticCriteria": {
    "formalCriteriaName": "Idiopathic Subglottic Stenosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "stenosis-location",
        "description": "Narrowing localized to the subglottic region of the airway",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-known-causes",
        "description": "Exclusion of other known causes such as trauma, intubation, autoimmune disease, or infection",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "symptoms-of-airway-obstruction",
        "description": "Presence of symptoms consistent with airway obstruction such as dyspnea and stridor",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-confirmation",
        "description": "Imaging or endoscopic confirmation of subglottic narrowing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All major criteria must be met including subglottic narrowing, exclusion of other causes, and clinical symptoms of airway obstruction",
    "notes": "Diagnosis is primarily clinical supported by imaging and exclusion of other etiologies."
  },
