  "diagnosticCriteria": {
    "formalCriteriaName": "Netherton Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "ichthyosis-linearis-circumflexa",
        "description": "Presence of ichthyosis linearis circumflexa characterized by migratory serpiginous erythematous plaques with double-edged scale",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "trichorrhexis-invaginata",
        "description": "Hair shaft abnormality known as trichorrhexis invaginata (bamboo hair) identified by light microscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "atopic-disease",
        "description": "Atopic diathesis including eczema, elevated serum IgE, and recurrent allergies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "spink5-mutation",
        "description": "Identification of pathogenic mutations in the SPINK5 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of ichthyosis linearis circumflexa, trichorrhexis invaginata, and atopic diathesis",
    "notes": "Genetic testing for SPINK5 mutations can confirm diagnosis but is not mandatory if clinical criteria are met"
  },
