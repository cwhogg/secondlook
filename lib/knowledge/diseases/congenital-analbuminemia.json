  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for congenital analbuminemia",
    "criteria": [
      {
        "id": "hypoalbuminemia",
        "description": "Severe hypoalbuminemia with serum albumin levels typically below 1 g/dL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of secondary causes of hypoalbuminemia such as liver disease, nephrotic syndrome, or malnutrition",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the ALB gene via molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of mild edema, hyperlipidemia, or fatigue consistent with albumin deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Severe hypoalbuminemia with exclusion of secondary causes plus confirmation by genetic testing",
    "notes": "Serum protein electrophoresis may show absence or near absence of albumin band."
  },
