  "diagnosticCriteria": {
    "formalCriteriaName": "Neonatal Atrial Flutter Diagnostic Criteria",
    "criteria": [
      {
        "id": "atrial-flutter-waves",
        "description": "Presence of rapid, regular atrial flutter waves on electrocardiogram (ECG) typically at 240-300 beats per minute",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-structural-heart-disease",
        "description": "No evidence of structural congenital heart disease on echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neonatal-onset",
        "description": "Onset of atrial flutter within the neonatal period (first 28 days of life)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-therapy",
        "description": "Termination or control of atrial flutter with pharmacologic or electrical cardioversion",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of rapid atrial flutter waves on ECG in a neonate without structural heart disease",
    "notes": "Diagnosis requires exclusion of secondary causes such as congenital heart defects or metabolic disturbances."
  },
