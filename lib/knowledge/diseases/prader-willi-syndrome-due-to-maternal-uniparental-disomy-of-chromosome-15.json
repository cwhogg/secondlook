  "keyFindings": {
    "laboratory": [
      "Growth hormone deficiency on stimulation testing",
      "Hypogonadotropic hypogonadism hormone profile",
      "Elevated fasting insulin and glucose in obese patients"
    ],
    "imaging": [
      "Brain MRI usually normal but may show mild cortical atrophy",
      "Skeletal X-rays may reveal scoliosis or osteoporosis"
    ],
    "genetic": [
      "SNRPN (phenotype modifier)",
      "MAGEL2 (phenotype modifier)",
      "NDN (phenotype modifier)",
      "OCA2 (phenotype modifier)"
    ],
    "other": [
      "Polysomnography demonstrating sleep apnea",
      "Neuropsychological testing showing cognitive impairment"
    ]
  },
