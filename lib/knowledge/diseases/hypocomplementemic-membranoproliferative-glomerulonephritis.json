  "keyFindings": {
    "laboratory": [
      "Low serum complement levels (C3, sometimes C4)",
      "Proteinuria and hematuria on urinalysis",
      "Elevated serum creatinine in progressive disease"
    ],
    "imaging": [
      "Renal ultrasound may show normal or enlarged kidneys",
      "Electron microscopy demonstrating dense deposits"
    ],
    "genetic": [
      "Mutations in complement regulatory proteins (e.g., CFH, CFI) in some cases"
    ],
    "other": [
      "Renal biopsy showing membranoproliferative pattern with mesangial hypercellularity and thickened capillary walls"
    ]
  },
