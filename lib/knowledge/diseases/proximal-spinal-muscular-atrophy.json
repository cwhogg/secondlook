  "keyFindings": {
    "laboratory": [
      "Normal sensory nerve conduction studies",
      "Elevated creatine kinase (mildly elevated or normal)"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle atrophy",
      "Chest X-ray may show bell-shaped chest due to respiratory muscle weakness"
    ],
    "genetic": [
      "Homozygous deletion or mutation in SMN1 gene",
      "SMN2 copy number modifies disease severity",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography showing denervation and chronic reinnervation",
      "Muscle biopsy demonstrating grouped atrophy of anterior horn cells"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-myopathies",
      "distinguishingFeatures": [
        "Normal sensory exam",
        "Muscle biopsy shows structural abnormalities rather than neurogenic atrophy",
        "No SMN1 gene mutation"
      ]
    },
    {
      "diseaseId": "congenital-muscular-dystrophy",
      "distinguishingFeatures": [
        "Elevated creatine kinase levels",
        "Muscle biopsy shows dystrophic changes",
        "No anterior horn cell involvement"
      ]
    },
    {
      "diseaseId": "juvenile-onset-motor-neuron-disease",
      "distinguishingFeatures": [
        "Later onset than SMA type 1",
        "Slower progression",
        "Different genetic mutations"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive respiratory failure",
    "Severe feeding difficulties with risk of aspiration",
    "Marked hypotonia with absent reflexes in infancy"
  ],
