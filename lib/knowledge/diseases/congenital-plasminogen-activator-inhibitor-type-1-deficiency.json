  "diagnosticCriteria": {
    "formalCriteriaName": "PAI-1 Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "low-pai1-activity",
        "description": "Markedly reduced or absent plasma PAI-1 activity levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-bleeding-history",
        "description": "History of mucocutaneous bleeding including epistaxis and menorrhagia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the SERPINE1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-coagulation-tests",
        "description": "Normal prothrombin time (PT) and activated partial thromboplastin time (aPTT)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history of similar bleeding phenotype or confirmed PAI-1 deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of markedly reduced plasma PAI-1 activity, clinical bleeding symptoms, and identification of pathogenic SERPINE1 mutations",
    "notes": "Diagnosis requires exclusion of other bleeding disorders and confirmation by genetic testing."
  },
