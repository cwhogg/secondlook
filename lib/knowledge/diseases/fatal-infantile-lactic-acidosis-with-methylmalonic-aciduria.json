  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Fatal Infantile Lactic Acidosis with Methylmalonic Aciduria",
    "criteria": [
      {
        "id": "elevated-methylmalonic-acid",
        "description": "Markedly elevated methylmalonic acid levels in urine and plasma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-lactic-acidosis",
        "description": "Severe metabolic lactic acidosis with elevated blood lactate concentrations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset-neurological-deterioration",
        "description": "Rapid neurological deterioration within the first year of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in genes associated with methylmalonic aciduria (e.g., MUT gene)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "metabolic-acidosis-with-normal-anion-gap",
        "description": "Metabolic acidosis with elevated anion gap and normal ketone bodies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated methylmalonic aciduria and severe lactic acidosis combined with early-onset neurological deterioration",
    "notes": "Genetic testing is recommended for confirmation but not mandatory for initial diagnosis."
  },
