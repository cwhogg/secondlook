  "keyFindings": {
    "laboratory": [
      "Persistent severe neutropenia (ANC <0.5 x10^9/L)",
      "Bone marrow biopsy showing maturation arrest at promyelocyte/myelocyte stage",
      "Elevated inflammatory markers during infections"
    ],
    "imaging": [
      "Chest X-ray may show pneumonia during infections",
      "Ultrasound may reveal hepatosplenomegaly"
    ],
    "genetic": [
      "TCIRG1 (causative)",
      "ELANE (causative)",
      "GFI1 (causative)",
      "CLPB (causative, loss-of-function)",
      "SRP19 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Clinical history of recurrent severe bacterial infections starting in infancy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autosomal-recessive-severe-congenital-neutropenia",
      "distinguishingFeatures": [
        "Inheritance pattern is autosomal recessive",
        "Mutations in HAX1 or other genes instead of ELANE",
        "May have neurological involvement in some subtypes"
      ]
    },
    {
      "diseaseId": "cyclic-neutropenia",
      "distinguishingFeatures": [
        "Periodic oscillations of neutrophil counts every 21 days",
        "Less severe infections",
        "Also associated with ELANE mutations but with cyclic pattern"
      ]
    }
  ],
