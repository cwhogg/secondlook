  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria established",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Demonstration of reduced adenylate kinase enzyme activity in erythrocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chronic-hemolytic-anemia",
        "description": "Presence of chronic hemolytic anemia with reticulocytosis and indirect hyperbilirubinemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the AK1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other enzymopathies and hemoglobinopathies causing hemolytic anemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Reduced erythrocyte adenylate kinase activity plus chronic hemolytic anemia and confirmation of AK1 gene mutation",
    "notes": "Diagnosis relies heavily on enzymatic assay and molecular genetic testing due to rarity and nonspecific clinical features."
  },
