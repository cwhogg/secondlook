  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Cutaneous Mastocytosis-Deafness-Microtia Syndrome",
    "criteria": [
      {
        "id": "cutaneous-mastocytosis",
        "description": "Presence of cutaneous mastocytosis confirmed by skin biopsy showing mast cell infiltration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-deafness",
        "description": "Bilateral sensorineural hearing loss confirmed by audiometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microtia",
        "description": "Congenital malformation of the external ear (microtia) documented clinically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-syndromes",
        "description": "Exclusion of other syndromes causing mastocytosis or ear malformations",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history of similar phenotype or genetic confirmation if available",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (cutaneous mastocytosis, sensorineural deafness, and microtia) must be present",
    "notes": "Diagnosis is clinical and histopathological; genetic testing may aid but no specific gene identified"
  },
