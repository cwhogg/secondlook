  "diagnosticCriteria": {
    "formalCriteriaName": "Antisynthetase Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "anti-pl-7-antibody",
        "description": "Presence of anti-PL-7 (anti-threonyl-tRNA synthetase) antibodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "myositis",
        "description": "Clinical or laboratory evidence of inflammatory myopathy (elevated CK, muscle weakness, or biopsy)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "interstitial-lung-disease",
        "description": "Radiologic or histopathologic evidence of interstitial lung disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "arthritis",
        "description": "Non-erosive arthritis involving small and/or large joints",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "mechanic-hands",
        "description": "Characteristic hyperkeratotic skin changes on the lateral and palmar aspects of the fingers",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of anti-PL-7 antibodies plus at least two major criteria (myositis and/or interstitial lung disease) or one major and one minor/supportive criterion",
    "notes": "Diagnosis requires exclusion of other causes of myositis and interstitial lung disease."
  },
