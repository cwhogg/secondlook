  "diagnosticCriteria": {
    "formalCriteriaName": "Kagami-Ogata syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "polyhydramnios",
        "description": "Prenatal polyhydramnios detected by ultrasound",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bell-shaped-thorax",
        "description": "Characteristic small bell-shaped thorax with coat-hanger ribs on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features including full cheeks, protruding philtrum, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-distress",
        "description": "Neonatal respiratory distress requiring intervention",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Confirmation of paternal uniparental disomy of chromosome 14 by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of major clinical features (bell-shaped thorax, characteristic facial dysmorphism) plus confirmation of paternal uniparental disomy of chromosome 14 by genetic testing",
    "notes": "Diagnosis is primarily clinical supported by genetic confirmation; prenatal findings may aid early diagnosis."
  },
