  "diagnosticCriteria": {
    "formalCriteriaName": "Baraitser-Winter Cerebrofrontofacial Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "distinctive-facial-features",
        "description": "Presence of characteristic facial dysmorphisms including hypertelorism, ptosis, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-malformations",
        "description": "Neuroradiological evidence of brain malformations such as pachygyria or lissencephaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in ACTB or ACTG1 genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-anomalies",
        "description": "Presence of ocular coloboma or other ophthalmological abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical features (distinctive facial features, brain malformations, intellectual disability) with or without genetic confirmation",
    "notes": "Genetic testing for ACTB and ACTG1 mutations is strongly recommended to confirm diagnosis."
  },
