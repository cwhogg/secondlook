  "keyFindings": {
    "laboratory": [
      "Negative systemic amyloidosis markers (normal serum and urine protein electrophoresis)",
      "Normal inflammatory markers"
    ],
    "imaging": [
      "Laryngoscopy showing submucosal nodules or plaques",
      "CT or MRI may show localized laryngeal thickening or masses"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology with Congo red staining demonstrating amyloid deposits",
      "Apple-green birefringence under polarized light microscopy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "laryngeal-squamous-cell-carcinoma",
      "distinguishingFeatures": [
        "Malignant histology on biopsy",
        "Rapid progression and ulceration",
        "Presence of risk factors such as smoking and alcohol use"
      ]
    },
    {
      "diseaseId": "laryngeal-granulomatosis-with-polyangiitis",
      "distinguishingFeatures": [
        "Systemic vasculitis symptoms",
        "Positive ANCA serology",
        "Granulomatous inflammation on biopsy rather than amyloid"
      ]
    },
    {
      "diseaseId": "sarcoidosis-of-the-larynx",
      "distinguishingFeatures": [
        "Non-caseating granulomas on biopsy",
        "Systemic involvement including lungs and lymph nodes",
        "Elevated serum ACE levels"
      ]
    }
  ],
  "redFlags": [
    "Rapidly worsening airway obstruction",
    "Presence of systemic amyloidosis signs (e.g., nephrotic syndrome, cardiomyopathy)",
    "Unexplained weight loss or systemic symptoms"
  ],
