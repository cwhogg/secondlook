  "diagnosticCriteria": {
    "formalCriteriaName": "MPS I Diagnostic Criteria",
    "criteria": [
      {
        "id": "alpha-l-iduronidase-deficiency",
        "description": "Deficiency of alpha-L-iduronidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-gags-elevation",
        "description": "Elevated urinary glycosaminoglycans (dermatan sulfate and heparan sulfate)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features including coarse facial features, hepatosplenomegaly, and skeletal dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the IDUA gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of alpha-L-iduronidase enzyme activity plus elevated urinary glycosaminoglycans and characteristic clinical features",
    "notes": "Genetic testing supports diagnosis but is not mandatory if enzyme assay and clinical features are conclusive."
  },
