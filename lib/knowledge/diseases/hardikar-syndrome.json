  "diagnosticCriteria": {
    "formalCriteriaName": "Hardikar Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "biliary-tract-anomalies",
        "description": "Presence of biliary tract anomalies including biliary hypoplasia or atresia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features such as cleft lip and palate, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-malformations",
        "description": "Congenital cardiac defects including atrial septal defect or ventricular septal defect",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-anomalies",
        "description": "Ocular abnormalities such as microphthalmia or coloboma",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal anomalies including limb malformations or vertebral defects",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both biliary tract anomalies and characteristic craniofacial dysmorphism",
    "notes": "Diagnosis is clinical and supported by imaging and genetic testing when available."
  },
