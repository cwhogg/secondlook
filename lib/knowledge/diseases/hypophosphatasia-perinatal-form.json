  "diagnosticCriteria": {
    "formalCriteriaName": "Hypophosphatasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "skeletal-hypomineralization",
        "description": "Radiographic evidence of profound skeletal hypomineralization",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-alkaline-phosphatase",
        "description": "Markedly decreased serum alkaline phosphatase activity for age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "respiratory-failure",
        "description": "Respiratory insufficiency due to chest deformities and hypoplastic lungs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the ALPL gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of profound skeletal hypomineralization and low serum alkaline phosphatase activity with respiratory failure in the neonatal period",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if clinical and biochemical criteria are met."
  },
