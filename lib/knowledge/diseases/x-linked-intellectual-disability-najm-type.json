  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild metabolic abnormalities secondary to feeding difficulties"
    ],
    "imaging": [
      "Brain MRI may show nonspecific cerebral atrophy or delayed myelination",
      "Skeletal X-rays may reveal scoliosis"
    ],
    "genetic": [
      "CASK (causative)",
      "X-linked inheritance pattern confirmed by family studies",
      "X-linked dominant inheritance"
    ],
    "other": [
      "Electroencephalogram (EEG) abnormalities consistent with epilepsy",
      "Developmental assessments confirming intellectual disability"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "fragile-x-syndrome",
      "distinguishingFeatures": [
        "Presence of CGG repeat expansion in FMR1 gene",
        "Distinctive macroorchidism in post-pubertal males",
        "More prominent behavioral phenotype including autism spectrum features"
      ]
    },
    {
      "diseaseId": "rett-syndrome",
      "distinguishingFeatures": [
        "Primarily affects females",
        "Characteristic regression after normal early development",
        "Hand stereotypies and breathing irregularities"
      ]
    }
  ],
