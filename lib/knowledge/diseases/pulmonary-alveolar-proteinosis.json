  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Pulmonary Alveolar Proteinosis",
    "criteria": [
      {
        "id": "bronchoalveolar-lavage",
        "description": "Characteristic milky appearance of bronchoalveolar lavage fluid with periodic acid–Schiff (PAS) positive lipoproteinaceous material",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "high-resolution-ct",
        "description": "High-resolution CT showing bilateral, symmetric ground-glass opacities with interlobular septal thickening ('crazy paving' pattern)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lung-biopsy",
        "description": "Lung biopsy demonstrating alveolar filling with granular eosinophilic material positive for PAS stain",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gm-csf-antibodies",
        "description": "Presence of anti-GM-CSF autoantibodies in serum (for autoimmune PAP)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic bronchoalveolar lavage findings and compatible high-resolution CT imaging",
    "notes": "Lung biopsy is reserved for uncertain cases; anti-GM-CSF antibody testing supports autoimmune etiology"
  },
