  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Congenital Hyperinsulinism",
    "criteria": [
      {
        "id": "persistent-hypoglycemia",
        "description": "Persistent hypoglycemia with inappropriate insulin secretion during hypoglycemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hnf4a-pathogenic-variant",
        "description": "Identification of pathogenic or likely pathogenic variant in the HNF4A gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-ketone-levels",
        "description": "Low plasma ketone bodies during hypoglycemia indicating hyperinsulinemic state",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history of hyperinsulinism or maturity-onset diabetes of the young type 1 (MODY1)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent hypoglycemia with inappropriate insulin secretion plus identification of a pathogenic HNF4A variant",
    "notes": "Genetic testing is essential for definitive diagnosis; biochemical testing supports clinical suspicion."
  },
