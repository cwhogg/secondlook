  "diagnosticCriteria": {
    "formalCriteriaName": "ATS/ERS/WASOG Statement on Sarcoidosis (2020 Update)",
    "criteria": [
      {
        "id": "sarc-maj1",
        "description": "Compatible clinical and radiographic presentation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sarc-maj2",
        "description": "Histological demonstration of non-caseating granulomas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sarc-maj3",
        "description": "Exclusion of other causes of granulomatous disease (infections, malignancy, drug reactions)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sarc-min1",
        "description": "Lofgren syndrome: bilateral hilar lymphadenopathy, erythema nodosum, fever, polyarthralgia (clinical diagnosis without biopsy)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sarc-min2",
        "description": "Heerfordt syndrome: parotid enlargement, uveitis, facial nerve palsy, fever",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Compatible clinical/radiographic presentation plus histological evidence of non-caseating granulomas plus exclusion of alternative diagnoses. Lofgren and Heerfordt syndromes may be diagnosed clinically.",
    "notes": "Pulmonary involvement in >90% of cases. Staging: Stage 0 (normal CXR), I (bilateral hilar lymphadenopathy), II (BHL + pulmonary infiltrates), III (pulmonary infiltrates without BHL), IV (pulmonary fibrosis)."
  },
