    "renal",
    "reproductive",
    "respiratory"
  ],
  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP",
      "Mild anemia of chronic disease",
      "Normal ANCA (usually negative)"
    ],
    "imaging": [
      "Angiography showing aneurysms or stenoses of medium-sized arteries",
      "MRI or CT angiography for vessel assessment"
    ],
    "genetic": [
      "No specific genetic markers identified"
    ],
    "other": [
      "Biopsy of affected tissue showing necrotizing arteritis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "kawasaki-disease",
      "distinguishingFeatures": [
        "Predominantly affects children under 5 years",
        "Mucocutaneous lymph node syndrome features",
        "Coronary artery aneurysms without systemic necrotizing vasculitis"
      ]
    },
    {
      "diseaseId": "microscopic-polyangiitis",
      "distinguishingFeatures": [
        "Small vessel vasculitis with ANCA positivity",
        "Glomerulonephritis common",
        "Pulmonary capillaritis frequent"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset of hypertension with renal impairment",
    "Severe abdominal pain suggesting mesenteric ischemia",
    "Mononeuritis multiplex causing progressive neurological deficits"
  ],
  "specialistType": [
    "Pediatric Rheumatologist",
    "Pediatric Nephrologist",
    "Vascular Medicine Specialist"
  ],
  "lastUpdated": "2026-02-17",
  "references": [
