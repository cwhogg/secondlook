  "diagnosticCriteria": {
    "formalCriteriaName": "LIPE-related Familial Partial Lipodystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "partial-lipodystrophy",
        "description": "Presence of partial loss of subcutaneous adipose tissue predominantly affecting the limbs and trunk with relative preservation or accumulation in the face and neck",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lipe-pathogenic-variant",
        "description": "Identification of pathogenic or likely pathogenic variants in the LIPE gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-abnormalities",
        "description": "Presence of metabolic complications including insulin resistance, diabetes mellitus, hypertriglyceridemia, and hepatic steatosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history consistent with autosomal dominant inheritance of partial lipodystrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-pseudohypertrophy",
        "description": "Clinical or imaging evidence of muscle pseudohypertrophy due to fat loss",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of partial lipodystrophy phenotype plus identification of a pathogenic LIPE variant and at least one metabolic abnormality",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical features may overlap with other lipodystrophies."
  },
