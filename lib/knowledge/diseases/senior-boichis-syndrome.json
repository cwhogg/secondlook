  "keyFindings": {
    "laboratory": [
      "Elevated liver transaminases",
      "Anemia due to hypersplenism",
      "Renal function abnormalities (elevated creatinine, electrolyte imbalances)"
    ],
    "imaging": [
      "Ultrasound or MRI showing congenital hepatic fibrosis and renal cystic disease",
      "Doppler ultrasound demonstrating portal hypertension",
      "Splenomegaly on abdominal imaging"
    ],
    "genetic": [
      "DCDC2 (causative)",
      "TMEM67 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Liver biopsy confirming periportal fibrosis",
      "Endoscopy revealing esophageal varices"
    ]
  },
