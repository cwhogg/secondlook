  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific biomarkers identified"
    ],
    "imaging": [
      "MRI or CT showing near-total absence of cerebral hemispheres replaced by CSF",
      "Preserved brainstem and cerebellar structures"
    ],
    "genetic": [
      "NDE1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Prenatal ultrasound may show absent cerebral hemispheres or fluid-filled cranial cavity"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "severe-hydrocephalus",
      "distinguishingFeatures": [
        "Presence of enlarged ventricles with preserved cerebral cortex",
        "Different neuroimaging pattern with ventricular dilation rather than absence of hemispheres"
      ]
    },
    {
      "diseaseId": "porencephaly",
      "distinguishingFeatures": [
        "Presence of cystic cavities within cerebral hemispheres rather than complete absence",
        "Partial preservation of cerebral tissue"
      ]
    },
    {
      "diseaseId": "alobar-holoprosencephaly",
      "distinguishingFeatures": [
        "Fusion of cerebral hemispheres rather than absence",
        "Facial anomalies often present"
      ]
    }
  ],
