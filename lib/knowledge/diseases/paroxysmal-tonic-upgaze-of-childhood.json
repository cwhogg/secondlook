  "diagnosticCriteria": {
    "formalCriteriaName": "Paroxysmal Tonic Upgaze Diagnostic Criteria",
    "criteria": [
      {
        "id": "intermittent-upward-gaze",
        "description": "Intermittent sustained upward deviation of the eyes lasting seconds to minutes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ataxia",
        "description": "Presence of ataxia or unsteady gait during episodes or interictally",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-neuroimaging",
        "description": "Normal brain MRI excluding structural lesions",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "onset-in-infancy-or-early-childhood",
        "description": "Onset typically in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-epilepsy",
        "description": "No evidence of epileptic seizures or epileptiform EEG abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of intermittent upward gaze deviation with ataxia and onset in infancy or early childhood",
    "notes": "Diagnosis is clinical and supported by exclusion of other neurological disorders"
  },
