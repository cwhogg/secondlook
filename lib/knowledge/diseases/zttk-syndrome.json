  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and molecular diagnosis of ZTTK syndrome",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including high forehead, broad nasal bridge, and downslanting palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "son-gene-mutation",
        "description": "Pathogenic heterozygous mutation in the SON gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as brain malformations or cardiac defects",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "feeding-difficulties",
        "description": "Early feeding difficulties and failure to thrive",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of global developmental delay or intellectual disability, characteristic craniofacial features, and a pathogenic SON gene mutation",
    "notes": "Diagnosis is confirmed by molecular genetic testing identifying a pathogenic variant in SON."
  },
