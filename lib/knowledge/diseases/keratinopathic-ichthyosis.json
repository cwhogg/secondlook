  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Diagnostic Criteria for Keratinopathic Ichthyosis",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of widespread blistering and erythroderma at birth or early infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Epidermolytic hyperkeratosis on skin biopsy showing vacuolar degeneration of the suprabasal keratinocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in keratin genes KRT1, KRT2, or KRT10",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus histopathological confirmation or genetic testing identifying pathogenic keratin gene variants",
    "notes": "Genetic testing is considered the gold standard for definitive diagnosis."
  },
