        "description": "Fasting hypoglycemia with lactic acidosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-involvement",
        "description": "Evidence of nephromegaly and renal dysfunction due to glycogen accumulation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of hepatomegaly, hyperuricemia, and hyperlipidemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of enzyme deficiency or pathogenic G6PC mutation plus clinical evidence of renal involvement and metabolic abnormalities",
    "notes": "Genetic testing and enzymatic assay are gold standards; renal biopsy may confirm glycogen accumulation."
  },
