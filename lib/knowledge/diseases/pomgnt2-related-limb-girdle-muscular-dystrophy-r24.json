    "formalCriteriaName": "Diagnostic Criteria for POMGNT2-related Limb-Girdle Muscular Dystrophy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness predominantly affecting limb-girdle muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes with reduced or absent alpha-dystroglycan glycosylation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the POMGNT2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Electromyography demonstrating myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-assessment",
        "description": "Assessment to exclude cardiomyopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal muscle weakness with confirmatory muscle biopsy findings and identification of pathogenic POMGNT2 variants",
    "notes": "Diagnosis requires integration of clinical, pathological, and genetic data."
  },
