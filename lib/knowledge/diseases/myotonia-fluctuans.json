  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electromyographic Diagnostic Criteria for Myotonia Fluctuans",
    "criteria": [
      {
        "id": "clinical-myotonia",
        "description": "Presence of fluctuating muscle stiffness and delayed relaxation after voluntary contraction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "emg-myotonic-discharge",
        "description": "Electromyography demonstrating myotonic discharges with waxing and waning frequency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in CLCN1 or SCN4A genes associated with myotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-muscle-weakness",
        "description": "Lack of progressive muscle weakness differentiating from other myopathies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical myotonia with characteristic EMG findings; genetic testing supportive but not mandatory",
    "notes": "Diagnosis relies heavily on clinical and electrophysiological correlation; genetic heterogeneity exists."
  },
