  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Intermediate Osteopetrosis",
    "criteria": [
      {
        "id": "radiologic-bone-density",
        "description": "Generalized increased bone density with characteristic 'bone within bone' appearance on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of mild to moderate hematological abnormalities such as anemia or thrombocytopenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in osteoclast-related genes (e.g., CLCN7, TCIRG1) consistent with autosomal recessive inheritance",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-assessment",
        "description": "Absence or mild presence of cranial nerve compression symptoms differentiating from severe infantile osteopetrosis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Generalized increased bone density on imaging plus at least one hematological abnormality; genetic confirmation supportive but not mandatory",
    "notes": "Diagnosis requires exclusion of other osteosclerotic conditions and correlation with clinical presentation."
  },
