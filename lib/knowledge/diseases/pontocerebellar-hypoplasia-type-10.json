  "diagnosticCriteria": {
    "formalCriteriaName": "Pontocerebellar Hypoplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Severe neurodevelopmental delay with early onset hypotonia and progressive microcephaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "MRI showing hypoplasia or atrophy of the pons and cerebellum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the CLP1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Abnormal nerve conduction studies or electromyography consistent with motor neuron involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus characteristic MRI findings and genetic confirmation of CLP1 mutations",
    "notes": "Diagnosis requires integration of clinical, radiological, and genetic data."
  },
