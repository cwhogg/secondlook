  "keyFindings": {
    "laboratory": [
      "Low growth hormone levels and/or IGF-1",
      "Hypogonadotropic and hypergonadotropic hypogonadism (mixed)",
      "Elevated ghrelin levels (paradoxically elevated despite obesity)",
      "Central hypothyroidism in some patients",
      "Elevated HbA1c / glucose if diabetes develops"
    ],
    "imaging": [
      "DEXA scan showing reduced bone mineral density",
      "Spine imaging for scoliosis assessment",
      "Brain MRI may show pituitary hypoplasia",
      "Sleep study (polysomnography) for sleep-disordered breathing"
    ],
    "genetic": [
      "DNA methylation analysis at 15q11-q13 (detects >99% of cases; first-line test)",
      "Paternal deletion (~70%) detected by FISH, MLPA, or chromosomal microarray",
      "Maternal uniparental disomy 15 (~25%)",
      "Imprinting center defects (~2-5%)",
      "Balanced translocations involving 15q11 (very rare)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Developmental assessment",
      "Behavioral assessment including food-related behaviors",
      "Endocrine evaluation (GH stimulation testing, gonadotropins)",
      "Dietary and weight management assessment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "angelman-syndrome",
      "distinguishingFeatures": [
        "Angelman affects maternal 15q11-q13 (not paternal)",
        "Severe intellectual disability with absent speech",
        "Happy demeanor with frequent laughing",
        "Seizures common; obesity not characteristic"
      ]
    },
    {
      "diseaseId": "bardet-biedl-syndrome",
      "distinguishingFeatures": [
        "Retinitis pigmentosa as key feature",
        "Polydactyly",
        "Renal anomalies",
        "BBS gene mutations (ciliopathy)"
      ]
    },
    {
      "diseaseId": "spinal-muscular-atrophy",
      "distinguishingFeatures": [
        "Progressive weakness (not static hypotonia)",
        "Areflexia",
        "SMN1 gene mutation",
        "No hyperphagia or obesity"
      ]
    },
    {
      "diseaseId": "congenital-myotonic-dystrophy",
      "distinguishingFeatures": [
        "Maternal history of myotonic dystrophy",
        "Myotonia develops later in childhood",
        "DMPK CTG repeat expansion"
      ]
    }
  ],
  "redFlags": [
    "Acute gastric dilation from binge eating (can be fatal; high pain threshold delays recognition)",
    "Severe obesity-related complications (type 2 diabetes, sleep apnea, cor pulmonale)",
    "Unexplained sudden death (possibly related to adrenal insufficiency or respiratory failure)",
    "Psychotic episodes requiring psychiatric intervention",
    "Water intoxication from excessive fluid intake"
  ],
