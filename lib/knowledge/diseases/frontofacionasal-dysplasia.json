  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Frontofacionasal Dysplasia",
    "criteria": [
      {
        "id": "median-facial-cleft",
        "description": "Presence of a median facial cleft or broad nasal root",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypertelorism",
        "description": "Hypertelorism (increased distance between the eyes)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "frontal-hairline-abnormality",
        "description": "Abnormal frontal hairline with widow's peak or triangular shape",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "nasal-tip-deformity",
        "description": "Broad or bifid nasal tip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midline-supraorbital-hypertrophy",
        "description": "Midline supraorbital ridge prominence",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least two major criteria including median facial cleft or broad nasal root and hypertelorism",
    "notes": "Diagnosis is primarily clinical; genetic testing may assist in differential diagnosis."
  },
