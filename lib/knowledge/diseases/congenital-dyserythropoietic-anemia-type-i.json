  "keyFindings": {
    "laboratory": [
      "Anemia with low reticulocyte count",
      "Elevated serum lactate dehydrogenase (LDH)",
      "Indirect hyperbilirubinemia",
      "Elevated serum ferritin and transferrin saturation"
    ],
    "imaging": [
      "Bone marrow biopsy showing binucleated erythroblasts and chromatin bridges",
      "Ultrasound evidence of splenomegaly and hepatomegaly",
      "MRI for iron overload quantification in liver and heart"
    ],
    "genetic": [
      "Mutations in CDAN1 gene (most common)",
      "Mutations in C15orf41 gene"
    ],
    "other": [
      "Peripheral blood smear showing anisopoikilocytosis",
      "Elevated erythropoietin levels"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "thalassemia-major",
      "distinguishingFeatures": [
        "Presence of beta-globin gene mutations",
        "More severe hemolysis",
        "Different bone marrow morphology without binucleated erythroblasts"
      ]
    },
    {
      "diseaseId": "hereditary-spherocytosis",
      "distinguishingFeatures": [
        "Spherocytes on peripheral smear",
        "Positive osmotic fragility test",
        "No characteristic bone marrow dyserythropoiesis"
      ]
    },
    {
      "diseaseId": "other-congenital-dyserythropoietic-anemias",
      "distinguishingFeatures": [
        "Different genetic mutations (e.g., CDA II with SEC23B mutations)",
        "Distinct bone marrow morphology",
        "Variable clinical severity"
      ]
    }
  ],
  "redFlags": [
    "Severe anemia refractory to standard treatment",
    "Progressive iron overload despite chelation",
    "Development of cardiac or endocrine complications"
  ],
