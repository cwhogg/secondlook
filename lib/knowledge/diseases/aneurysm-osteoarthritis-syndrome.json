  "diagnosticCriteria": {
    "formalCriteriaName": "Aneurysm-Osteoarthritis Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "vascular-aneurysm",
        "description": "Presence of arterial aneurysms or dissections, especially in medium to large arteries",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset-osteoarthritis",
        "description": "Early-onset osteoarthritis with joint degeneration before age 50",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "smad3-mutation",
        "description": "Identification of pathogenic SMAD3 gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Presence of skeletal abnormalities such as joint hypermobility or pectus deformities",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history of aneurysms or early osteoarthritis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of arterial aneurysm or dissection plus early-onset osteoarthritis and identification of a pathogenic SMAD3 mutation",
    "notes": "Genetic testing for SMAD3 mutations is critical for confirmation."
  },
