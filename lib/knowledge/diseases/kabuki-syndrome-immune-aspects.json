  "diagnosticCriteria": {
    "formalCriteriaName": "Kabuki Syndrome Diagnostic Criteria (2019 update)",
    "criteria": [
      {
        "id": "facial-features",
        "description": "Characteristic facial features including long palpebral fissures with eversion of the lateral third of the lower eyelid",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Presence of immunodeficiency manifesting as hypogammaglobulinemia or recurrent infections",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic variant in KMT2D or KDM6A genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoimmune-manifestations",
        "description": "Autoimmune phenomena such as autoimmune cytopenias",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-anomalies",
        "description": "Skeletal abnormalities including brachydactyly and scoliosis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic facial features plus either genetic confirmation or immunodeficiency with recurrent infections",
    "notes": "Genetic testing is recommended to confirm diagnosis; immunological evaluation is essential for management."
  },
