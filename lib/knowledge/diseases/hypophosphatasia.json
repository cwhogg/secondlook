  "diagnosticCriteria": {
    "formalCriteriaName": "Hypophosphatasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "low-serum-alkaline-phosphatase",
        "description": "Persistently low serum alkaline phosphatase activity below age- and sex-adjusted reference ranges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-plasma-pyridoxal-5-phosphate",
        "description": "Elevated plasma levels of pyridoxal-5'-phosphate (vitamin B6)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pathogenic-alpl-mutation",
        "description": "Identification of pathogenic mutations in the ALPL gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-bone-abnormalities",
        "description": "Radiographic evidence of defective bone mineralization such as metaphyseal abnormalities or osteopenia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical features consistent with hypophosphatasia such as premature loss of deciduous teeth or bone pain",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of low serum alkaline phosphatase and either pathogenic ALPL mutation or elevated plasma pyridoxal-5'-phosphate",
    "notes": "Diagnosis requires integration of biochemical, genetic, and clinical findings."
  },
