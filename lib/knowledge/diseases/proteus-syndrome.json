  "diagnosticCriteria": {
    "formalCriteriaName": "Biesecker Criteria for Proteus Syndrome",
    "criteria": [
      {
        "id": "mosaic-overgrowth",
        "description": "Mosaic distribution of lesions with asymmetric and disproportionate overgrowth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "connective-tissue-nevus",
        "description": "Presence of cerebriform connective tissue nevi",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "specific-tumors",
        "description": "Presence of specific tumors such as ovarian cystadenomas or parotid monomorphic adenomas",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "dysregulated-bone-growth",
        "description": "Disproportionate, asymmetric skeletal overgrowth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of somatic activating mutation in AKT1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of mosaic, asymmetric overgrowth plus cerebriform connective tissue nevus and/or disproportionate skeletal overgrowth",
    "notes": "Genetic testing for AKT1 mutation supports diagnosis but is not mandatory"
  },
