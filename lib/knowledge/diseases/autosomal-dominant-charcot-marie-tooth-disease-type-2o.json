  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for CMT2O",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of distal muscle weakness and atrophy predominantly in lower limbs with sensory loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electrophysiological evidence of axonal neuropathy with normal or mildly reduced nerve conduction velocities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic heterozygous mutations in the AARS1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing neurogenic atrophy (if performed)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of distal neuropathy symptoms with electrophysiological confirmation of axonal neuropathy and identification of pathogenic AARS1 mutation",
    "notes": "Genetic confirmation is essential for definitive diagnosis due to phenotypic overlap with other CMT subtypes."
  },
