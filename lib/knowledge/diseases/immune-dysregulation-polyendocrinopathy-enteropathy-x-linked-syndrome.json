  "diagnosticCriteria": {
    "formalCriteriaName": "IPEX Diagnostic Criteria",
    "criteria": [
      {
        "id": "early-onset-severe-diarrhea",
        "description": "Early-onset severe enteropathy with intractable diarrhea",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "polyendocrinopathy",
        "description": "Autoimmune endocrinopathies such as type 1 diabetes mellitus or thyroiditis",
