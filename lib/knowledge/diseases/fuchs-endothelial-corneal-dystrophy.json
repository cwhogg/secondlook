  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Fuchs Endothelial Corneal Dystrophy",
    "criteria": [
      {
        "id": "guttae",
        "description": "Presence of corneal endothelial guttae visible on slit-lamp examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "corneal-edema",
        "description": "Central corneal stromal and epithelial edema causing thickening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "visual-impairment",
        "description": "Progressive decrease in visual acuity, especially in the morning",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "specular-microscopy",
        "description": "Reduced endothelial cell density and abnormal morphology on specular microscopy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of corneal endothelial guttae and corneal edema with compatible clinical findings",
    "notes": "Diagnosis is primarily clinical supported by imaging; genetic testing is not routinely performed."
  },
