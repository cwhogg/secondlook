  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate elevation)",
      "Normal metabolic panel"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle involvement",
      "Chest X-ray may show atelectasis or hypoventilation changes"
    ],
    "genetic": [
      "Pathogenic mutations in MTM1 gene on X chromosome"
    ],
    "other": [
      "Muscle biopsy demonstrating centrally located nuclei in >50% of fibers",
      "Electromyography showing myopathic changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "centronuclear-myopathy-autosomal-dominant",
      "distinguishingFeatures": [
        "Autosomal dominant inheritance",
