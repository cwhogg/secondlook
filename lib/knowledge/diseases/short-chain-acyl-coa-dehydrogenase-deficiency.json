        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "scad-gene-mutation",
        "description": "Identification of pathogenic variants in the ACADS gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-ethylmalonic-aciduria",
        "description": "Increased urinary excretion of ethylmalonic acid detected by organic acid analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical symptoms consistent with SCAD deficiency such as hypotonia or developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated plasma butyrylcarnitine and ethylmalonic aciduria plus identification of pathogenic ACADS variants",
    "notes": "Some individuals may be asymptomatic despite biochemical abnormalities."
