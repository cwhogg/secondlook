        "requiredForDiagnosis": true
      },
      {
        "id": "lmna-pathogenic-variant",
        "description": "Identification of pathogenic or likely pathogenic LMNA gene mutation by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of dilated cardiomyopathy or sudden cardiac death",
