  "diagnosticCriteria": {
    "formalCriteriaName": "Renal Ciliopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "renal-cysts",
        "description": "Presence of bilateral renal cystic disease on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic mutation in cilia-related genes (e.g., PKD1, PKD2, NPHP genes)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "extrarenal-manifestations",
        "description": "Presence of extrarenal features such as retinal degeneration, hepatic fibrosis, or polydactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive or dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Bilateral renal cystic disease plus identification of pathogenic mutation in cilia-related gene or typical extrarenal manifestations with family history",
    "notes": "Genetic testing is critical for confirmation; clinical heterogeneity is common."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Bilateral renal cystic disease",
        "frequency": 0.95,
        "bodySystem": "renal",
        "notes": "Characteristic cyst formation in kidneys",
        "searchTerms": [
          "cysts in both kidneys",
          "bilateral kidney cyst disease",
          "multiple kidney cysts on both sides"
