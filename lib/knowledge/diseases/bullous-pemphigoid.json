        "symptomName": "Tense subepidermal blisters",
        "frequency": 0.95,
        "bodySystem": "dermatological"
      },
      {
        "symptomName": "Pruritus",
        "frequency": 0.85,
        "bodySystem": "dermatological"
      },
      {
        "symptomName": "Linear IgG and C3 deposition at basement membrane zone",
