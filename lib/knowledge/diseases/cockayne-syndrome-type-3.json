  "diagnosticCriteria": {
    "formalCriteriaName": "Cockayne Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "growth-retardation",
        "description": "Postnatal growth failure with short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "photosensitivity",
        "description": "Photosensitivity with abnormal DNA repair",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-deterioration",
        "description": "Progressive neurological dysfunction including sensorineural hearing loss and cognitive decline",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facies",
        "description": "Characteristic facial features including sunken eyes, thin nose, and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in ERCC6 or ERCC8 genes",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of growth retardation, photosensitivity, progressive neurological deterioration, and genetic confirmation of ERCC6 or ERCC8 mutation",
    "notes": "Diagnosis may be supported by skin biopsy showing defective nucleotide excision repair"
  },
