  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Congenital Chloride Diarrhea",
    "criteria": [
      {
        "id": "chloride-rich-diarrhea",
        "description": "Presence of lifelong watery diarrhea with high fecal chloride concentration (>90 mmol/L)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypochloremic-metabolic-alkalosis",
        "description": "Laboratory evidence of hypochloremic metabolic alkalosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "SLC26A3-mutation",
        "description": "Identification of pathogenic mutations in the SLC26A3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "prenatal-polyhydramnios",
        "description": "History of prenatal polyhydramnios and dilated bowel loops on ultrasound",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or family history of similar symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chloride-rich diarrhea with hypochloremic metabolic alkalosis plus identification of pathogenic SLC26A3 mutation",
    "notes": "Diagnosis can be supported by prenatal findings and family history but requires biochemical and genetic confirmation."
  },
