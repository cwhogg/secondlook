  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Haddad Syndrome",
    "criteria": [
      {
        "id": "central-hypoventilation",
        "description": "Congenital central hypoventilation characterized by alveolar hypoventilation during sleep",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aganglionic-megacolon",
        "description": "Presence of Hirschsprung disease confirmed by histopathology showing aganglionosis of the distal colon",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "phox2b-mutation",
        "description": "Identification of pathogenic mutations in the PHOX2B gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autonomic-dysfunction",
        "description": "Evidence of autonomic nervous system dysfunction including impaired pupillary light reflex or cardiac arrhythmias",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital central hypoventilation and Hirschsprung disease with confirmation of PHOX2B mutation",
    "notes": "Diagnosis is clinical and genetic; exclusion of other causes of hypoventilation and intestinal dysmotility is necessary."
  },
