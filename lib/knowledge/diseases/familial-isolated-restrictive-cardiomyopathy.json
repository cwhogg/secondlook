  "diagnosticCriteria": {
    "formalCriteriaName": "Restrictive Cardiomyopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "diastolic-dysfunction",
        "description": "Evidence of restrictive diastolic dysfunction on echocardiography or cardiac MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-left-ventricular-size",
        "description": "Normal or mildly increased left ventricular size with biatrial enlargement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-cardiac-disease",
        "description": "Exclusion of other causes of restrictive physiology such as infiltrative or storage diseases",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of restrictive cardiomyopathy or sudden cardiac death",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic mutation in sarcomeric or cytoskeletal genes associated with restrictive cardiomyopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of restrictive diastolic dysfunction with normal or mildly increased left ventricular size and exclusion of other cardiac diseases",
    "notes": "Genetic testing and family history support diagnosis but are not mandatory."
  },
