  "differentialDiagnoses": [
    {
      "diseaseId": "schizophrenia",
      "distinguishingFeatures": [
        "Lack of neurological signs such as vertical gaze palsy",
        "No biochemical or genetic abnormalities in NPC genes"
      ]
    },
    {
      "diseaseId": "frontotemporal dementia",
      "distinguishingFeatures": [
        "Earlier prominent behavioral changes",
        "Absence of lysosomal storage markers",
        "No splenomegaly or hepatomegaly"
      ]
    },
    {
      "diseaseId": "Wilson-disease",
      "distinguishingFeatures": [
        "Presence of Kayser-Fleischer rings",
        "Abnormal copper metabolism",
        "Different genetic mutations (ATP7B gene)"
      ]
    }
  ],
