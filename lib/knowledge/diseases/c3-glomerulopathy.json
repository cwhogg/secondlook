  "diagnosticCriteria": {
    "formalCriteriaName": "C3 Glomerulopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "c3-dominant-deposits",
        "description": "Dominant C3 complement deposits on immunofluorescence microscopy with minimal or absent immunoglobulin deposits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electron-dense-deposits",
        "description": "Presence of electron-dense deposits in the glomerular basement membrane or mesangium on electron microscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Clinical evidence of glomerulonephritis such as hematuria, proteinuria, or renal impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "complement-abnormalities",
        "description": "Evidence of alternative complement pathway dysregulation (e.g., low serum C3 levels or genetic mutations)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of dominant C3 deposits on immunofluorescence and electron-dense deposits on electron microscopy along with clinical features of glomerulonephritis",
    "notes": "Diagnosis requires exclusion of other causes of C3 deposition such as post-infectious glomerulonephritis."
  },
