  "prevalence": {
    "estimate": "1 in 500,000",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 5,
      "peak": 1
    },
    "sexPredilection": "equal",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Glycogen Storage Disease Type Ib",
    "criteria": [
      {
        "id": "neutropenia",
        "description": "Chronic neutropenia with absolute neutrophil count persistently below 500 cells/µL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glucose-6-phosphate-transporter-deficiency",
        "description": "Demonstration of glucose-6-phosphate transporter deficiency by enzymatic assay or genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-abnormalities",
        "description": "Presence of metabolic abnormalities including hypoglycemia, lactic acidosis, hyperuricemia, and hyperlipidemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepato-nephromegaly",
        "description": "Hepatomegaly and/or nephromegaly detected clinically or by imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "recurrent-infections",
        "description": "Recurrent bacterial infections due to neutropenia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic neutropenia, metabolic abnormalities consistent with GSD Ib, and confirmation of glucose-6-phosphate transporter deficiency by genetic or enzymatic testing",
    "notes": "Genetic testing for SLC37A4 mutations is confirmatory."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Chronic severe neutropenia",
        "frequency": 0.95,
        "bodySystem": "hematological",
        "notes": "Absolute neutrophil count typically below 500/µL"
      },
      {
        "symptomName": "Hepatomegaly",
        "frequency": 0.85,
        "bodySystem": "gastrointestinal",
        "notes": "Enlarged liver due to glycogen accumulation"
      },
      {
        "symptomName": "Recurrent bacterial infections",
        "frequency": 0.9,
        "bodySystem": "immunological",
        "notes": "Primarily affecting skin, respiratory tract, and oral mucosa"
      }
    ],
    "common": [
      {
        "symptomName": "Hypoglycemia",
        "frequency": 0.75,
        "bodySystem": "endocrine",
        "notes": "Episodes especially during fasting"
      },
      {
        "symptomName": "Oral mucosal ulcers",
        "frequency": 0.7,
        "bodySystem": "otolaryngological",
        "notes": "Painful aphthous ulcers"
      },
      {
        "symptomName": "Lactic acidosis",
        "frequency": 0.65,
        "bodySystem": "constitutional",
        "notes": "Elevated serum lactate levels"
      },
      {
        "symptomName": "Hyperuricemia",
        "frequency": 0.6,
        "bodySystem": "renal",
        "notes": "Elevated serum uric acid levels"
      },
      {
        "symptomName": "Hyperlipidemia",
        "frequency": 0.55,
        "bodySystem": "endocrine",
        "notes": "Elevated triglycerides and cholesterol"
      }
    ],
    "occasional": [
      {
        "symptomName": "Neutrophil functional defects",
        "frequency": 0.4,
        "bodySystem": "immunological",
        "notes": "Impaired chemotaxis and phagocytosis"
      },
      {
        "symptomName": "Nephromegaly",
        "frequency": 0.3,
        "bodySystem": "renal",
        "notes": "Kidney enlargement due to glycogen accumulation"
      },
      {
        "symptomName": "Growth retardation",
        "frequency": 0.25,
        "bodySystem": "constitutional",
        "notes": "Delayed growth and development"
      },
      {
        "symptomName": "Splenomegaly",
        "frequency": 0.15,
        "bodySystem": "hematological",
        "notes": "Enlarged spleen in some cases"
      },
      {
        "symptomName": "Diarrhea",
        "frequency": 0.2,
        "bodySystem": "gastrointestinal",
        "notes": "Intermittent episodes"
      }
    ],
    "rare": [
      {
        "symptomName": "Neurocognitive impairment",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Mild intellectual disability reported rarely"
      },
      {
        "symptomName": "Arthralgia",
        "frequency": 0.07,
        "bodySystem": "musculoskeletal",
        "notes": "Joint pain without inflammation"
      },
      {
        "symptomName": "Skin infections with abscess formation",
        "frequency": 0.06,
        "bodySystem": "dermatological",
        "notes": "Due to neutropenia and impaired immunity"
      }
    ]
  },
  "systemsAffected": [
