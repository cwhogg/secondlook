  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for RAPADILINO syndrome",
    "criteria": [
      {
        "id": "palmar-plantar-syndactyly",
        "description": "Presence of palmar and plantar syndactyly (fusion of fingers and toes)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radial-ray-defects",
        "description": "Radial ray abnormalities including hypoplastic or absent thumbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Severe pre- and postnatal growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-features",
        "description": "Characteristic craniofacial features including cleft or high-arched palate and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the RECQL4 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of palmar-plantar syndactyly, radial ray defects, growth retardation, and confirmation of pathogenic RECQL4 variants",
    "notes": "Genetic testing is essential for definitive diagnosis due to phenotypic overlap with related syndromes."
  },
