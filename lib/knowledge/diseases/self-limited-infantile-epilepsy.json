  "diagnosticCriteria": {
    "formalCriteriaName": "ILAE Diagnostic Criteria for Self-limited Infantile Epilepsy",
    "criteria": [
      {
        "id": "age-onset",
        "description": "Seizure onset between 3 and 12 months of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizure-type",
        "description": "Focal seizures with or without secondary generalization",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-development",
        "description": "Normal neurodevelopment before, during, and after seizure episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-neuroimaging",
        "description": "Normal brain MRI findings",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-interictal-eeg",
        "description": "Normal or mildly abnormal interictal EEG without epileptiform discharges",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of focal seizures onset between 3-12 months in a developmentally normal infant with normal neuroimaging and no other identifiable cause",
    "notes": "Diagnosis is clinical and supported by EEG and imaging; seizures typically remit within 1-2 years without treatment."
  },
