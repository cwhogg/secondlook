  "diagnosticCriteria": {
    "formalCriteriaName": "No formal diagnostic criteria established",
    "criteria": [
      {
        "id": "skin-fragility",
        "description": "Marked skin fragility with blistering and erosions on minimal trauma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ectodermal-abnormalities",
        "description": "Presence of ectodermal dysplasia features including hypotrichosis, nail dystrophy, and dental anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pyloric-stenosis",
        "description": "Congenital pyloric atresia or stenosis in some cases",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic mutations in the PKP1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of skin fragility with ectodermal dysplasia features plus genetic confirmation or clinical diagnosis supported by typical features",
    "notes": "Diagnosis is primarily clinical supported by genetic testing; pyloric atresia is variable."
  },
