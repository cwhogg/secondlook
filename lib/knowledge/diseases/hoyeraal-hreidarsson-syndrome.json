  "diagnosticCriteria": {
    "formalCriteriaName": "Hoyeraal-Hreidarsson Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cerebellar-hypoplasia",
        "description": "Presence of cerebellar hypoplasia confirmed by neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Evidence of combined immunodeficiency with lymphopenia and recurrent infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mucocutaneous-features",
        "description": "Mucocutaneous features consistent with dyskeratosis congenita (nail dystrophy, skin pigmentation abnormalities, oral leukoplakia)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "telomere-length",
        "description": "Significantly shortened telomere length in peripheral blood leukocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of cerebellar hypoplasia, immunodeficiency, and developmental delay",
    "notes": "Genetic testing for mutations in telomere maintenance genes supports diagnosis"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Cerebellar hypoplasia",
        "frequency": 0.85,
        "bodySystem": "neurological",
        "notes": "Confirmed by MRI imaging"
      },
      {
        "symptomName": "Severe combined immunodeficiency",
        "frequency": 0.8,
        "bodySystem": "immunological",
        "notes": "Recurrent severe infections common",
        "searchTerms": [
          "severe immune deficiency",
          "combined T and B cell immune failure",
          "profound immune system weakness"
        ]
      },
      {
        "symptomName": "Developmental delay",
        "frequency": 0.75,
        "bodySystem": "neurological",
        "notes": "Global cognitive and motor delay"
      }
    ],
    "common": [
      {
        "symptomName": "Nail dystrophy",
        "frequency": 0.7,
        "bodySystem": "dermatological",
        "notes": "Thickened, ridged, or absent nails"
      },
      {
        "symptomName": "Skin hyperpigmentation",
        "frequency": 0.65,
        "bodySystem": "dermatological",
        "notes": "Reticulated or mottled pigmentation"
      },
      {
        "symptomName": "Oral leukoplakia",
        "frequency": 0.6,
        "bodySystem": "gastrointestinal",
        "notes": "White patches on oral mucosa"
      },
      {
        "symptomName": "Bone marrow failure",
        "frequency": 0.55,
        "bodySystem": "hematological",
        "notes": "Pancytopenia or aplastic anemia",
        "searchTerms": [
          "bone marrow not making enough cells",
          "marrow failure causing low blood counts",
          "insufficient blood cell production"
        ]
      },
      {
        "symptomName": "Microcephaly",
        "frequency": 0.5,
        "bodySystem": "neurological",
        "notes": "Head circumference below 3rd percentile"
      }
    ],
    "occasional": [
      {
        "symptomName": "Esophageal strictures",
        "frequency": 0.4,
        "bodySystem": "gastrointestinal",
        "notes": "Dysphagia due to fibrosis"
      },
      {
        "symptomName": "Pulmonary fibrosis",
        "frequency": 0.3,
        "bodySystem": "respiratory",
        "notes": "Progressive lung scarring"
      },
      {
        "symptomName": "Epiphora (excessive tearing)",
        "frequency": 0.25,
        "bodySystem": "ophthalmological",
        "notes": "Due to lacrimal duct abnormalities",
        "searchTerms": [
          "excessive tearing",
          "watery eyes",
          "epiphora"
        ]
      },
      {
        "symptomName": "Growth retardation",
        "frequency": 0.2,
        "bodySystem": "constitutional",
        "notes": "Failure to thrive"
      },
      {
        "symptomName": "Thrombocytopenia",
        "frequency": 0.15,
        "bodySystem": "hematological",
        "notes": "Low platelet count"
      }
    ],
    "rare": [
