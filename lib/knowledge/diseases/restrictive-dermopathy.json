  "keyFindings": {
    "laboratory": [
      "Skin biopsy showing thin dermis with dense collagen bundles and absence of elastic fibers",
      "Normal routine blood tests except possible anemia"
    ],
    "imaging": [
      "Radiographs showing hypoplastic clavicles and delayed bone maturation",
      "Chest X-ray demonstrating restrictive thoracic cage"
    ],
    "genetic": [
      "ZMPSTE24 (causative)",
      "LMNA (causative)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Prenatal ultrasound may show decreased fetal movements and joint contractures"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "restrictive-cardiomyopathy",
      "distinguishingFeatures": [
        "Primarily cardiac involvement without skin rigidity",
        "Later onset compared to restrictive dermopathy"
      ]
    },
    {
      "diseaseId": "congenital-contractural-arachnodactyly",
      "distinguishingFeatures": [
        "Marfanoid habitus with arachnodactyly",
        "Absence of taut, rigid skin and characteristic facial dysmorphism"
      ]
    },
    {
      "diseaseId": "harlequin-ichthyosis",
      "distinguishingFeatures": [
        "Thickened, plate-like scales rather than taut translucent skin",
        "Distinctive ectropion and eclabium"
      ]
    }
  ],
  "redFlags": [
    "Severe respiratory insufficiency at birth",
    "Marked joint contractures with inability to move limbs",
    "Characteristic taut, rigid skin with translucent appearance"
  ],
