  "keyFindings": {
    "laboratory": [
      "Elevated CSF protein with normal cell count (albuminocytologic dissociation)",
      "Normal routine blood tests excluding metabolic causes"
    ],
    "imaging": [
      "MRI may show nerve root or plexus hypertrophy and enhancement"
    ],
    "genetic": [
      "No known genetic mutations associated; diagnosis is clinical and electrophysiological"
    ],
    "other": [
      "Nerve conduction studies showing demyelination features",
      "Nerve biopsy demonstrating segmental demyelination and inflammatory infiltrates"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "guillain-barre-syndrome",
      "distinguishingFeatures": [
        "Acute onset with rapid progression (days to 4 weeks)",
        "Often preceded by infection",
        "CSF protein elevation appears after 1 week",
        "Usually monophasic"
      ]
    },
    {
      "diseaseId": "hereditary-demyelinating-neuropathy",
      "distinguishingFeatures": [
        "Family history positive",
        "Chronic slowly progressive course",
        "No inflammatory markers on biopsy",
        "Electrophysiology consistent with hereditary pattern"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of weakness over days",
    "Respiratory failure or bulbar weakness",
    "Severe autonomic instability"
  ],
