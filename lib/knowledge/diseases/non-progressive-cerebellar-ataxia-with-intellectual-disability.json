        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Documented intellectual disability ranging from mild to moderate severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "non-progressive-course",
        "description": "Stable neurological symptoms without clinical or radiological progression over time",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of acquired, metabolic, degenerative, or progressive genetic causes of ataxia",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing cerebellar hypoplasia or mild cerebellar atrophy without other brain abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of cerebellar ataxia and intellectual disability with a non-progressive clinical course and exclusion of other causes",
    "notes": "Diagnosis relies on clinical stability and neuroimaging findings; genetic testing may assist in identifying underlying etiology."
