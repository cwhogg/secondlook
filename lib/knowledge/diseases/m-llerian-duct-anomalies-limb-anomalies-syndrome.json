  "diagnosticCriteria": {
    "formalCriteriaName": "No formal diagnostic criteria established",
    "criteria": [
      {
        "id": "mullerian-duct-anomaly",
        "description": "Presence of congenital malformations of the Müllerian ducts including uterine hypoplasia or agenesis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Congenital limb anomalies such as hypoplasia, aplasia, or syndactyly affecting upper and/or lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-syndromic-features",
        "description": "Exclusion of other syndromes with overlapping features such as Mayer-Rokitansky-Küster-Hauser syndrome or VACTERL association",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both Müllerian duct anomalies and limb malformations with exclusion of other syndromes",
    "notes": "Diagnosis is primarily clinical supported by imaging and genetic testing to exclude differential diagnoses."
  },
