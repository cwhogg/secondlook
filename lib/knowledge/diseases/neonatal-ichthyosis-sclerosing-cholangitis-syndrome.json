  "keyFindings": {
    "laboratory": [
      "Elevated serum transaminases (ALT, AST)",
      "Elevated serum bile acids and alkaline phosphatase",
      "Prolonged prothrombin time due to liver dysfunction"
    ],
    "imaging": [
      "Cholangiography showing multifocal strictures and beading of intrahepatic bile ducts",
      "Ultrasound evidence of hepatomegaly and possible splenomegaly"
    ],
    "genetic": [
      "CLDN1 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Liver biopsy demonstrating periductal fibrosis and bile duct proliferation consistent with sclerosing cholangitis"
    ]
  },
