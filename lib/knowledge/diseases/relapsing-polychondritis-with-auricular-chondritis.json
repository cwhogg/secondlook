  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP indicating systemic inflammation",
      "Positive anti-type II collagen antibodies in some cases",
      "Normocytic anemia of chronic disease"
    ],
    "imaging": [
      "CT or MRI showing cartilage inflammation and airway narrowing",
      "Chest X-ray may reveal tracheal calcification or stenosis",
      "Echocardiography for aortic root assessment"
    ],
    "genetic": [
      "No specific genetic markers identified; possible HLA-DR4 association"
    ],
    "other": [
      "Biopsy of affected cartilage showing inflammatory infiltrate and cartilage destruction"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "granulomatosis-with-polyangiitis",
      "distinguishingFeatures": [
        "Presence of necrotizing granulomas",
        "Positive ANCA antibodies",
        "More prominent renal involvement"
      ]
    },
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "Multisystem autoimmune disease with positive ANA",
        "Skin rash and renal involvement more common",
        "Non-cartilage specific inflammation"
      ]
    },
    {
      "diseaseId": "ankylosing-spondylitis",
      "distinguishingFeatures": [
        "Predominant axial skeleton involvement",
        "HLA-B27 positivity",
        "Lack of auricular chondritis"
      ]
    }
  ],
  "redFlags": [
    "Progressive airway obstruction or stridor",
    "Sudden onset of chest pain with suspicion of aortic aneurysm",
    "Rapidly worsening hearing loss or vision changes"
  ],
