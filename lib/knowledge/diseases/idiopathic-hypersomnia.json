  "diagnosticCriteria": {
    "formalCriteriaName": "International Classification of Sleep Disorders, 3rd Edition (ICSD-3)",
    "criteria": [
      {
        "id": "excessive-daytime-sleepiness",
        "description": "Excessive daytime sleepiness lasting at least 3 months without other causes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sleep-onset-latency",
        "description": "Mean sleep latency ≤ 8 minutes on Multiple Sleep Latency Test (MSLT)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sleep-inertia",
        "description": "Prolonged and severe sleep inertia or difficulty waking after long sleep periods",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-cataplexy",
        "description": "No cataplexy or other narcolepsy type 1 features",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-nocturnal-sleep",
        "description": "Normal or prolonged nocturnal sleep duration without fragmentation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of excessive daytime sleepiness for at least 3 months, mean sleep latency ≤ 8 minutes on MSLT, and prolonged sleep inertia without cataplexy",
    "notes": "Diagnosis requires exclusion of other causes of hypersomnia including narcolepsy, sleep apnea, and medication effects."
  },
