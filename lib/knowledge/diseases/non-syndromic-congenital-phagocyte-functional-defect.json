        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-bacterial-infections",
        "description": "History of recurrent, severe bacterial and fungal infections beginning in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-phagocyte-count",
        "description": "Normal absolute neutrophil count with impaired phagocytic function",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes affecting phagocyte function (e.g., CYBB, NCF1, NCF2)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of impaired oxidative burst activity and history of recurrent severe infections",
    "notes": "Genetic testing supports diagnosis but is not mandatory if functional assays are conclusive."
