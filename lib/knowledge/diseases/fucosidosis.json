  "diagnosticCriteria": {
    "formalCriteriaName": "Fucosidosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of alpha-L-fucosidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of progressive neurodegeneration with developmental delay and regression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-abnormalities",
        "description": "Characteristic angiokeratoma corporis diffusum or other skin lesions",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the FUCA1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-findings",
        "description": "MRI showing cerebral and cerebellar atrophy with white matter changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of alpha-L-fucosidase enzyme activity plus clinical features of progressive neurodegeneration",
    "notes": "Genetic confirmation and skin findings support diagnosis but are not mandatory"
  },
