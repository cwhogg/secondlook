  "keyFindings": {
    "laboratory": [
      "Pancytopenia due to bone marrow failure",
      "Elevated serum alkaline phosphatase",
      "Hypocalcemia or normocalcemia"
    ],
    "imaging": [
      "Diffuse osteosclerosis with 'bone within bone' appearance",
      "Erlenmeyer flask deformity of long bones",
      "Narrowed cranial foramina on skull X-ray"
    ],
    "genetic": [
      "Pathogenic mutations in TCIRG1, CLCN7, or other osteoclast-related genes"
    ],
    "other": [
      "Bone biopsy showing defective osteoclast resorption"
    ]
  },
