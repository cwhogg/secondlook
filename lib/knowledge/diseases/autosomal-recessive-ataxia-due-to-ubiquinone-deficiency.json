  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-ubiquinone-deficiency",
        "description": "Demonstration of reduced ubiquinone (CoQ10) levels in muscle or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in genes involved in ubiquinone biosynthesis (e.g., COQ genes)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-coq10-supplementation",
        "description": "Clinical improvement or stabilization with CoQ10 supplementation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia plus biochemical evidence of ubiquinone deficiency and/or biallelic pathogenic variants in ubiquinone biosynthesis genes",
    "notes": "Diagnosis may be supported by clinical response to CoQ10 supplementation."
  },
