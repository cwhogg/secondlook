        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electrophysiological evidence of motor axonal neuropathy with normal sensory nerve conduction studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in genes associated with autosomal recessive distal hereditary motor neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consistent autosomal recessive inheritance pattern or consanguinity",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-sensory-symptoms",
        "description": "Lack of significant sensory involvement on clinical and electrophysiological examination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal motor weakness and atrophy with electrophysiological evidence of motor axonal neuropathy and genetic confirmation of biallelic pathogenic variants",
    "notes": "Diagnosis requires exclusion of other motor neuropathies and neurodegenerative disorders."
