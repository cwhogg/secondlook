  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria established",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in TMEM70 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of neonatal or early infancy onset encephalopathy with cardiomyopathy and myopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-evidence",
        "description": "Deficient mitochondrial ATP synthase (complex V) activity in muscle biopsy or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Brain MRI showing basal ganglia and white matter abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "lactic-acidosis",
        "description": "Elevated blood or CSF lactate levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biallelic TMEM70 pathogenic variants plus clinical features of encephalo-cardio-myopathy and biochemical evidence of complex V deficiency",
    "notes": "Diagnosis is confirmed by genetic testing combined with clinical and biochemical findings."
  },
