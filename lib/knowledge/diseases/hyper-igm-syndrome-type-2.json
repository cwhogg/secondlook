  "keyFindings": {
    "laboratory": [
      "Elevated serum IgM with low or absent IgG, IgA, and IgE",
      "Normal or increased B cell numbers with defective class switching",
      "Normal T cell counts and function"
    ],
    "imaging": [
      "Chest X-ray showing recurrent pneumonia or bronchiectasis",
      "Abdominal ultrasound may show hepatosplenomegaly"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Impaired in vitro class switch recombination assays",
      "Increased susceptibility to opportunistic infections"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hyper-igm-syndrome-type-1",
      "distinguishingFeatures": [
        "X-linked inheritance",
        "Mutations in CD40L gene",
        "T-cell defects present"
      ]
    },
    {
      "diseaseId": "common-variable-immunodeficiency",
      "distinguishingFeatures": [
        "Variable IgG and IgA deficiency with normal or low IgM",
        "Later onset in adolescence or adulthood",
        "No AID gene mutations"
      ]
    }
  ],
  "redFlags": [
    "Severe recurrent bacterial infections in early childhood",
