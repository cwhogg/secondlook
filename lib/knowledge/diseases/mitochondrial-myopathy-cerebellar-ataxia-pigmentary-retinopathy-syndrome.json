  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria established",
    "criteria": [
      {
        "id": "clinical-triad",
        "description": "Presence of mitochondrial myopathy, cerebellar ataxia, and pigmentary retinopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing ragged-red fibers or mitochondrial abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mitochondrial DNA or nuclear gene mutations associated with mitochondrial dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI evidence of cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electrophysiology",
        "description": "Electromyography showing myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of the clinical triad plus either muscle biopsy findings or genetic confirmation",
    "notes": "Diagnosis is primarily clinical supported by histological and genetic evidence; no standardized diagnostic criteria exist."
  },
