  "keyFindings": {
    "laboratory": [
      "Typically normal laboratory studies; no specific biomarkers"
    ],
    "imaging": [
      "Radiographs showing characteristic flowing hyperostosis resembling 'dripping candle wax' along cortex of long bones",
      "CT and MRI may show cortical thickening and soft tissue involvement"
    ],
    "genetic": [
      "Somatic mutations in MAP2K1 gene identified in some cases, but not universally present"
    ],
    "other": [
      "Histopathology reveals dense, sclerotic cortical bone with irregular remodeling"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "osteopathia-striata",
      "distinguishingFeatures": [
        "Linear striations in metaphyseal regions on radiographs",
        "Usually asymptomatic",
        "No flowing hyperostosis"
      ]
    },
    {
      "diseaseId": "osteopoikilosis",
      "distinguishingFeatures": [
        "Multiple small, round or ovoid sclerotic foci scattered in epiphyses and metaphyses",
        "Typically asymptomatic",
        "No limb deformity or flowing hyperostosis"
      ]
    },
    {
      "diseaseId": "myositis-ossificans",
      "distinguishingFeatures": [
        "Heterotopic ossification in soft tissues",
        "History of trauma",
        "No cortical bone involvement"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive limb deformity",
    "Severe, unremitting bone pain",
    "Neurological deficits due to nerve compression"
  ],
  "specialistType": [
    "Orthopedic surgeon",
    "Radiologist",
