  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for SMA-PME",
    "criteria": [
      {
        "id": "clinical-spinal-muscular-atrophy",
        "description": "Progressive muscle weakness and atrophy predominantly affecting proximal muscles consistent with spinal muscular atrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-myoclonic-epilepsy",
        "description": "Presence of progressive myoclonic epilepsy characterized by myoclonic seizures and generalized tonic-clonic seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the ASAH1 gene or other associated genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiological-findings",
        "description": "Electromyography showing denervation consistent with anterior horn cell disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-etiologies",
        "description": "Exclusion of other causes of myoclonic epilepsy and motor neuron disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive spinal muscular atrophy phenotype plus progressive myoclonic epilepsy and confirmation by genetic testing",
    "notes": "Diagnosis requires multidisciplinary evaluation including neurology, genetics, and electrophysiology."
  },
