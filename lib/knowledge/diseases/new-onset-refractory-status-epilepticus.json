  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (e.g., CRP, ESR)",
      "CSF pleocytosis or elevated protein in some cases",
      "Hyponatremia"
    ],
    "imaging": [
      "MRI brain often normal or shows nonspecific changes",
      "No acute structural lesions explaining seizures"
    ],
    "genetic": [
      "No consistent genetic mutations identified; some cases linked to autoimmune or paraneoplastic etiologies"
    ],
    "other": [
      "EEG showing continuous or near-continuous epileptiform discharges refractory to treatment",
      "Autoimmune antibody panels may be positive in some cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autoimmune-encephalitis",
      "distinguishingFeatures": [
        "Presence of specific neuronal antibodies",
        "Subacute onset with psychiatric symptoms",
        "Response to immunotherapy"
      ]
    },
    {
      "diseaseId": "infectious-encephalitis",
      "distinguishingFeatures": [
        "Positive CSF cultures or PCR for pathogens",
        "Fever and systemic signs of infection",
        "MRI showing focal inflammatory lesions"
      ]
    },
    {
      "diseaseId": "febrile-infection-related-epilepsy-syndrome",
      "distinguishingFeatures": [
        "Typically affects children",
        "Follows febrile illness with prolonged seizures",
        "Distinct clinical course and prognosis"
      ]
    }
  ],
  "redFlags": [
    "Failure to respond to first- and second-line antiepileptic drugs",
    "Rapid neurological deterioration with altered consciousness",
    "Development of autonomic instability or multiorgan failure"
  ],
