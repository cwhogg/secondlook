  "diagnosticCriteria": {
    "formalCriteriaName": "Blau Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "granulomatous-arthritis",
        "description": "Chronic granulomatous arthritis involving multiple joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "uveitis",
        "description": "Granulomatous uveitis (ocular inflammation)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rash",
        "description": "Erythematous maculopapular or scaly skin rash with granulomatous histology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nucleotide-binding-oligomerization-domain-containing-protein-2-mutation",
        "description": "Presence of NOD2/CARD15 gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of the triad of granulomatous arthritis, uveitis, and characteristic skin rash, supported by genetic testing if available",
    "notes": "Diagnosis is clinical and genetic confirmation supports diagnosis; biopsy of affected tissue showing noncaseating granulomas is helpful"
  },
