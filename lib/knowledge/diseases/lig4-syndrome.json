  "keyFindings": {
    "laboratory": [
      "Lymphopenia with low CD3+ and CD19+ cells",
      "Hypogammaglobulinemia (low IgG, IgA, IgM)",
      "Increased chromosomal breakage on radiation exposure",
      "Bone marrow hypoplasia or aplasia"
    ],
    "imaging": [
      "Brain MRI may show microcephaly-related structural abnormalities",
      "Chest imaging may reveal recurrent infections or fibrosis"
    ],
    "genetic": [
      "XRCC4 (candidate)",
      "LIG4 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Radiosensitivity assays demonstrating increased cellular sensitivity to ionizing radiation"
    ]
  },
