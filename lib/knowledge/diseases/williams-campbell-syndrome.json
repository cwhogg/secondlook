  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible hypoxemia on arterial blood gas during infections"
    ],
    "imaging": [
      "High-resolution CT showing diffuse bronchiectasis predominantly in subsegmental bronchi",
      "Bronchography demonstrating bronchial cartilage deficiency",
      "Chest X-ray with hyperinflation and bronchiectatic changes"
    ],
    "genetic": [
      "No specific genetic mutation identified; considered congenital but genetic basis unclear"
    ],
    "other": [
      "Bronchoscopy revealing absence or deficiency of cartilage rings in subsegmental bronchi"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cystic-fibrosis",
      "distinguishingFeatures": [
        "Positive sweat chloride test",
        "Multisystem involvement including pancreatic insufficiency",
        "Genetic mutations in CFTR gene"
      ]
    },
    {
      "diseaseId": "primary-ciliary-dyskinesia",
      "distinguishingFeatures": [
        "Defective ciliary motility",
        "Chronic sinusitis and otitis media",
        "Situs inversus in ~50% of cases"
      ]
    },
    {
      "diseaseId": "post-infectious-bronchiectasis",
      "distinguishingFeatures": [
        "History of severe pulmonary infections",
        "Bronchiectasis distribution varies",
        "No cartilage deficiency on bronchoscopy"
      ]
    }
  ],
