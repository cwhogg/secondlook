        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-bone-abnormalities",
        "description": "Presence of characteristic radiographic bone abnormalities including metaphyseal irregularities and defective mineralization",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes encoding sulfotransferase enzymes or related sulfation pathway components",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Clinical presentation with skeletal deformities and growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biochemical sulfation deficit, characteristic radiologic bone abnormalities, and genetic confirmation of pathogenic variants",
    "notes": "Diagnosis requires integration of biochemical, radiologic, and genetic data due to phenotypic overlap with other metabolic bone diseases."
  },
