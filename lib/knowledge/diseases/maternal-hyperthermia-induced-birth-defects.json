  "diagnosticCriteria": {
    "formalCriteriaName": "Maternal Hyperthermia Teratogenicity Diagnostic Criteria",
    "criteria": [
      {
        "id": "maternal-fever-history",
        "description": "Documented maternal hyperthermia (≥38.5°C) during the critical period of organogenesis (first trimester)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "presence-of-congenital-anomalies",
        "description": "Presence of characteristic congenital anomalies consistent with hyperthermia teratogenic effects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-teratogens",
        "description": "Exclusion of other known teratogenic exposures or genetic syndromes",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-confirmation",
        "description": "Prenatal or postnatal imaging confirming structural anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Documented maternal hyperthermia during first trimester plus presence of characteristic congenital anomalies with exclusion of other teratogens",
    "notes": "Diagnosis is primarily clinical and supported by maternal history and exclusion of alternative causes."
  },
