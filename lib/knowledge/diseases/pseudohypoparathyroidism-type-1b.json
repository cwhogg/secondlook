  "keyFindings": {
    "laboratory": [
      "Hypocalcemia with elevated serum parathyroid hormone (PTH)",
      "Hyperphosphatemia",
      "Normal or low 25-hydroxyvitamin D levels",
      "Normal magnesium levels"
    ],
    "imaging": [
      "Basal ganglia calcifications on brain CT or MRI",
      "Absence of skeletal abnormalities typical of AHO"
    ],
    "genetic": [
      "GNAS (causative)",
      "STX16 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Normal renal function tests aside from phosphate handling abnormalities"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pseudohypoparathyroidism-type-1a",
