  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for 1p36 Deletion Syndrome",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chromosome-1p36-deletion",
        "description": "Confirmed deletion involving the terminal region of chromosome 1p36 by molecular cytogenetic testing (FISH, microarray)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facial-features",
        "description": "Presence of typical craniofacial dysmorphisms including straight eyebrows, deep-set eyes, flat nasal bridge, and pointed chin",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "History of seizures or epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Neonatal or infantile hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed 1p36 terminal deletion by molecular testing plus developmental delay or intellectual disability",
    "notes": "Diagnosis relies primarily on genetic confirmation; clinical features support but are not sufficient alone."
  },
