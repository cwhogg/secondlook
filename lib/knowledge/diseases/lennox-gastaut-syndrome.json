  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; metabolic screening may reveal underlying cause in some cases"
    ],
    "imaging": [
      "Brain MRI may show cortical malformations, atrophy, or be normal"
    ],
    "genetic": [
      "Mutations in genes such as CHD2, GABRB3, SCN1A identified in some patients"
    ],
    "other": [
      "EEG showing slow spike-and-wave pattern is diagnostic hallmark"
    ]
  },
  "differentialDiagnoses": [
