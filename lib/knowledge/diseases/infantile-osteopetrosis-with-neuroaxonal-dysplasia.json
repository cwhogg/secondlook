  "keyFindings": {
    "laboratory": [
      "Pancytopenia with anemia and thrombocytopenia",
      "Elevated serum alkaline phosphatase",
      "Hypocalcemia and secondary hyperparathyroidism"
    ],
    "imaging": [
      "Diffuse osteosclerosis with 'bone within bone' and 'Erlenmeyer flask' deformity on X-rays",
      "MRI showing neuroaxonal spheroids and brainstem involvement",
      "CT demonstrating foraminal narrowing causing cranial nerve compression"
    ],
    "genetic": [
      "OSTM1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathological identification of neuroaxonal spheroids in nerve biopsies",
      "Bone marrow biopsy showing failure and fibrosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "infantile-malignant-osteopetrosis",
      "distinguishingFeatures": [
        "Absence of neuroaxonal spheroids",
        "Less prominent neurological degeneration",
        "Different genetic mutations (e.g., TCIRG1 alone)"
      ]
    },
    {
      "diseaseId": "neuroaxonal-dystrophy",
      "distinguishingFeatures": [
        "Lack of osteosclerosis or bone abnormalities",
        "Primarily neurological symptoms without bone marrow failure",
        "Distinct genetic causes"
      ]
    },
    {
      "diseaseId": "pyknodysostosis",
      "distinguishingFeatures": [
        "Short stature with osteosclerosis but normal neuroaxonal histology",
        "Characteristic acro-osteolysis of distal phalanges",
        "No pancytopenia"
      ]
    }
  ],
