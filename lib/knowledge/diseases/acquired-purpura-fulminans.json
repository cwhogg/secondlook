  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Laboratory Diagnostic Criteria for Acquired Purpura Fulminans",
    "criteria": [
      {
        "id": "acute-skin-necrosis",
        "description": "Rapid onset of symmetric purpuric skin lesions progressing to necrosis and gangrene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "disseminated-intravascular-coagulation",
        "description": "Laboratory evidence of disseminated intravascular coagulation (DIC) including thrombocytopenia, prolonged PT/PTT, elevated D-dimers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "underlying-infection",
        "description": "Presence of severe bacterial infection, often Neisseria meningitidis or Streptococcus pneumoniae",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "protein-c-deficiency",
        "description": "Reduced protein C activity or acquired deficiency",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing dermal vascular thrombosis with minimal inflammation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acute purpuric skin necrosis with laboratory evidence of DIC in the context of severe infection",
    "notes": "Diagnosis is clinical supported by laboratory and histopathology; exclusion of congenital causes is important."
  },
