  "keyFindings": {
    "laboratory": [
      "Elevated urinary amino acids, glucose, phosphate, and bicarbonate indicating proximal tubular dysfunction",
      "Metabolic acidosis",
      "Hypophosphatemia"
    ],
    "imaging": [
      "Brain MRI showing cerebral atrophy or delayed myelination",
      "Renal ultrasound may show nephrocalcinosis"
    ],
    "genetic": [
      "Pathogenic variants in OCRL1 gene on X chromosome"
    ],
    "other": [
      "Slit-lamp examination confirming congenital cataracts",
      "Electroretinogram abnormalities"
    ]
  },
