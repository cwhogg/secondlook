  "diagnosticCriteria": {
    "formalCriteriaName": "Localized Scleroderma Diagnostic Criteria",
    "criteria": [
      {
        "id": "linear-skin-thickening",
        "description": "Presence of linear bands of skin thickening and induration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-systemic-involvement",
        "description": "No evidence of systemic sclerosis or systemic involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology-consistent",
        "description": "Skin biopsy showing dermal fibrosis with thickened collagen bundles",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "autoantibodies",
        "description": "Presence of antinuclear antibodies (ANA) in some cases",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of linear skin thickening with absence of systemic sclerosis; biopsy supportive but not mandatory",
    "notes": "Diagnosis is primarily clinical supported by histopathology; systemic involvement exclusion is essential"
  },
