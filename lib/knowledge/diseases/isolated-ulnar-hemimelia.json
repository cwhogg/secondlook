  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Ulnar Hemimelia",
    "criteria": [
      {
        "id": "ulnar-absence",
        "description": "Partial or complete absence of the ulna bone confirmed by radiographic imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hand-malformations",
        "description": "Presence of hand anomalies such as absent or hypoplastic ulnar digits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "isolated-presentation",
        "description": "Absence of associated syndromic features or other limb deficiencies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of partial or complete ulnar absence with corresponding hand malformations, without other syndromic abnormalities",
    "notes": "Diagnosis is primarily clinical supported by radiographic imaging; genetic testing may be used to exclude syndromic causes."
  },
