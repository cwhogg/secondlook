  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Fibrochondrogenesis",
    "criteria": [
      {
        "id": "short-limbs",
        "description": "Severe micromelic dwarfism with markedly shortened limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rib-abnormalities",
        "description": "Broad, short ribs with flared anterior ends and metaphyseal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vertebral-changes",
        "description": "Platyspondyly with irregular vertebral bodies and delayed ossification",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the COL11A1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-features",
        "description": "Characteristic facial dysmorphism including midface hypoplasia and cleft palate",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (severe micromelic dwarfism, rib abnormalities, vertebral changes) with or without genetic confirmation",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical and radiological features are definitive."
  },
