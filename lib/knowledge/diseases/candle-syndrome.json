      "MAPK10 (candidate)",
      "CHD2 (causative)",
      "DNM1 (causative)",
      "GABRB3 (causative)",
      "CACNA1A (causative, gain-of-function)",
      "CACNA1A (causative, loss-of-function)",
      "Autosomal dominant inheritance",
      "Multigenic/multifactorial inheritance"
    ],
