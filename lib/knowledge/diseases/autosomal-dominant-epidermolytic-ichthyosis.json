  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Diagnostic Criteria for Epidermolytic Ichthyosis",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of widespread blistering and erythroderma at or shortly after birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing epidermolytic hyperkeratosis with vacuolar degeneration of the upper epidermis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in KRT1 or KRT10 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus either histopathological confirmation or identification of pathogenic KRT1/KRT10 variants",
    "notes": "Genetic testing is confirmatory but not always available; clinical and histopathological findings are critical."
  },
