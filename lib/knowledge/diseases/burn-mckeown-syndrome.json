  "diagnosticCriteria": {
    "formalCriteriaName": "Burn-McKeown Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-malformations",
        "description": "Presence of characteristic craniofacial anomalies including choanal atresia and prominent nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "upper-lip-clefting",
        "description": "Cleft upper lip or cleft lip/palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nasal-passage-obstruction",
        "description": "Bilateral choanal atresia or stenosis confirmed by imaging or endoscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eyelid-malformations",
        "description": "Eyelid colobomas or hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal anomalies such as short stature or limb abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: craniofacial malformations including choanal atresia, cleft upper lip, and nasal passage obstruction",
    "notes": "Genetic testing for TXNL4A mutations can support diagnosis but is not mandatory"
  },
