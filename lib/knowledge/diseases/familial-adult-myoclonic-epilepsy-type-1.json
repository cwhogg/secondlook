      {
        "symptomName": "Cortical myoclonus",
        "frequency": 0.95,
        "bodySystem": "neurological",
        "notes": "Stimulus-sensitive, arrhythmic jerks predominantly affecting distal limbs"
      },
      {
        "symptomName": "Adult-onset generalized tonic-clonic seizures",
        "frequency": 0.85,
        "bodySystem": "neurological",
        "searchTerms": [
          "adult onset generalized seizures",
