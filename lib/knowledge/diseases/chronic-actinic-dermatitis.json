  "diagnosticCriteria": {
    "formalCriteriaName": "Chronic Actinic Dermatitis Diagnostic Criteria",
    "criteria": [
      {
        "id": "photosensitivity",
        "description": "Persistent eczematous dermatitis in sun-exposed areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "phototesting",
        "description": "Abnormal photosensitivity demonstrated by phototesting (reduced minimal erythema dose to UVB and/or UVA)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing chronic eczematous changes with lymphocytic infiltrate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-photosensitivity",
        "description": "Exclusion of other causes of photosensitivity such as lupus erythematosus or phototoxic drug reactions",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent eczematous dermatitis in sun-exposed areas plus abnormal phototesting and supportive histopathology findings",
    "notes": "Diagnosis requires exclusion of other photosensitive dermatoses."
  },
