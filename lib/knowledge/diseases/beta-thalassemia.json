  "diagnosticCriteria": {
    "formalCriteriaName": "Beta-thalassemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "microcytic-anemia",
        "description": "Presence of microcytic hypochromic anemia with low mean corpuscular volume (MCV) and mean corpuscular hemoglobin (MCH)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemoglobin-electrophoresis",
        "description": "Hemoglobin electrophoresis showing elevated HbA2 and/or HbF with decreased or absent HbA",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the HBB gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of beta-thalassemia or related hemoglobinopathies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Clinical features such as pallor, jaundice, and hepatosplenomegaly",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microcytic anemia plus abnormal hemoglobin electrophoresis or confirmed HBB gene mutation",
    "notes": "Diagnosis may require combination of hematological, electrophoretic, and genetic testing."
  },
