  "diagnosticCriteria": {
    "formalCriteriaName": "Idiopathic Eosinophilic Enteritis Diagnostic Criteria",
    "criteria": [
      {
        "id": "histologic-eosinophilia",
        "description": "Eosinophilic infiltration of the small intestinal mucosa exceeding 20 eosinophils per high-power field",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-symptoms",
        "description": "Presence of gastrointestinal symptoms including abdominal pain and malabsorption",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of secondary causes of eosinophilic infiltration such as parasitic infection, drug reaction, or systemic eosinophilic disorders",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Imaging evidence of small bowel wall thickening or edema",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-steroids",
        "description": "Clinical improvement with corticosteroid therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met: histologic eosinophilia, clinical symptoms, and exclusion of other causes",
    "notes": "Diagnosis requires biopsy confirmation and exclusion of secondary eosinophilic enteritis etiologies"
  },
