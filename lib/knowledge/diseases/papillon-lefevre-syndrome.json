  "keyFindings": {
    "laboratory": [
      "Elevated neutrophil elastase activity",
      "Normal routine blood counts",
      "Possible mild liver enzyme elevation"
    ],
    "imaging": [
      "Alveolar bone loss on dental X-rays",
      "Occasional intracranial calcifications on CT scan"
    ],
    "genetic": [
      "Biallelic pathogenic variants in CTSC gene"
    ],
    "other": [
      "Histopathology of skin shows hyperkeratosis and acanthosis",
      "Periodontal biopsy shows severe inflammation and bone resorption"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hajdu-cheney-syndrome",
      "distinguishingFeatures": [
        "Acroosteolysis",
        "Distinct craniofacial features",
        "No palmoplantar keratoderma"
      ]
    },
    {
      "diseaseId": "pachyonychia-congenita",
      "distinguishingFeatures": [
        "Nail thickening and dystrophy",
        "Palmoplantar keratoderma without severe periodontitis",
        "Mutations in keratin genes"
      ]
    },
    {
      "diseaseId": "hypophosphatasia",
      "distinguishingFeatures": [
        "Defective bone mineralization",
        "Low serum alkaline phosphatase",
        "Dental abnormalities without palmoplantar keratoderma"
      ]
    }
  ],
