  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Nerve conduction studies showing reduced amplitude with normal or mildly reduced conduction velocity"
    ],
    "imaging": [
      "MRI may show muscle atrophy in distal limbs",
      "Spine X-ray may reveal scoliosis in some cases"
    ],
    "genetic": [
      "MORC2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography demonstrating chronic denervation and reinnervation",
      "Family history consistent with autosomal dominant inheritance"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autosomal-dominant-charcot-marie-tooth-disease-type-2a",
      "distinguishingFeatures": [
        "MFN2 gene mutations",
        "Earlier onset in some cases",
        "More prominent motor involvement"
      ]
    },
    {
      "diseaseId": "hereditary-sensory-and-motor-neuropathy-type-1",
      "distinguishingFeatures": [
        "Demyelinating neuropathy pattern on nerve conduction studies",
        "PMP22 gene duplication or mutation",
        "Slower progression"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of weakness over weeks to months",
    "Respiratory insufficiency or dyspnea",
    "Bulbar symptoms such as dysphagia or dysarthria"
  ],
