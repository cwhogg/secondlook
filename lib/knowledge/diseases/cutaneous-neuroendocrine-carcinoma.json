  "keyFindings": {
    "laboratory": [
      "Elevated serum neuron-specific enolase (NSE)",
      "Positive immunohistochemical markers: cytokeratin 20 (CK20), chromogranin A, synaptophysin"
    ],
    "imaging": [
      "PET/CT showing hypermetabolic cutaneous lesion and regional lymph node involvement",
      "MRI or CT for staging and detection of metastases"
    ],
    "genetic": [
      "Association with Merkel cell polyomavirus (MCPyV) in majority of cases"
    ],
    "other": [
      "Histopathology showing small round blue cells with scant cytoplasm and high mitotic rate"
    ]
  },
