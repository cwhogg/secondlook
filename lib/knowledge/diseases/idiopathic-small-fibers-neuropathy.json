  "diagnosticCriteria": {
    "formalCriteriaName": "Small Fiber Neuropathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-symptoms",
        "description": "Presence of distal, symmetric neuropathic pain or dysesthesia predominantly affecting small fibers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-biopsy",
        "description": "Reduced intraepidermal nerve fiber density on skin biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-nerve-conduction",
        "description": "Normal nerve conduction studies excluding large fiber neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "quantitative-sensory-testing",
        "description": "Abnormal thermal threshold testing consistent with small fiber dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "autonomic-testing",
        "description": "Evidence of autonomic small fiber involvement on autonomic function testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of typical clinical symptoms plus reduced intraepidermal nerve fiber density on skin biopsy and normal nerve conduction studies",
    "notes": "Diagnosis requires exclusion of secondary causes of small fiber neuropathy."
  },
