  "diagnosticCriteria": {
    "formalCriteriaName": "ICCS/ISLH Consensus Guidelines for PNH Flow Cytometry",
    "criteria": [
      {
        "id": "pnh-c1",
        "description": "Flow cytometry demonstrating GPI-anchored protein deficiency on granulocytes and/or monocytes (CD55, CD59, FLAER)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pnh-c2",
        "description": "Evidence of intravascular hemolysis (elevated LDH)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pnh-c3",
        "description": "PIGA gene somatic mutation in hematopoietic stem cells",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "pnh-c4",
        "description": "Hemoglobinuria (dark or red-brown urine)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "pnh-c5",
        "description": "History of thrombosis at unusual sites",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Flow cytometry showing a discrete population of GPI-anchor-deficient cells on at least two cell lineages",
    "notes": "PNH clone size varies; subclinical PNH clones are found in aplastic anemia and MDS. Classical PNH, PNH with bone marrow failure, and subclinical PNH are recognized subtypes."
  },
