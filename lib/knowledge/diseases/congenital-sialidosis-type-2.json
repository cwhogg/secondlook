  "keyFindings": {
    "laboratory": [
      "Deficient alpha-neuraminidase enzyme activity in leukocytes or fibroblasts",
      "Elevated urinary bound sialic acid-containing oligosaccharides"
    ],
    "imaging": [
      "Skeletal X-rays showing dysostosis multiplex",
      "Brain MRI may show cerebral atrophy in advanced cases"
    ],
    "genetic": [
      "NEU1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Presence of cherry-red macular spots on ophthalmologic examination"
    ]
  },
  "differentialDiagnoses": [
