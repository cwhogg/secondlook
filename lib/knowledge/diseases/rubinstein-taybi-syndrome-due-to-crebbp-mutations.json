  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Rubinstein-Taybi Syndrome",
    "criteria": [
      {
        "id": "broad-thumb-hallux",
        "description": "Presence of broad and angulated thumbs and halluces",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including downslanting palpebral fissures, beaked nose, and grimacing smile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic CREBBP mutation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation and short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-anomalies",
        "description": "Ocular abnormalities such as strabismus and ptosis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of broad thumbs/halluces and characteristic facial features with intellectual disability; genetic confirmation supports diagnosis",
    "notes": "Genetic testing for CREBBP mutations is confirmatory but not always necessary if clinical features are classic."
  },
