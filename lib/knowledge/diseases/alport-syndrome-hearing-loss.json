  "diagnosticCriteria": {
    "formalCriteriaName": "Alport Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "family-history",
        "description": "Positive family history of hematuria, renal failure, or sensorineural hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss, typically progressive and affecting high frequencies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-involvement",
        "description": "Persistent microscopic hematuria and progressive renal impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-abnormalities",
        "description": "Presence of anterior lenticonus or other characteristic ocular findings",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in COL4A3, COL4A4, or COL4A5 genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of sensorineural hearing loss plus renal involvement and either family history or genetic confirmation",
    "notes": "Diagnosis is often clinical but supported by genetic testing and renal biopsy findings."
  },
