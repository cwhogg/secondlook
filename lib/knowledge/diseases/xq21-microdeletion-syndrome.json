  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible elevated serum creatinine if renal involvement"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter changes",
      "Ophthalmologic imaging confirms chorioretinal atrophy",
      "Echocardiogram to assess congenital heart defects"
    ],
    "genetic": [
      "POU3F4 (causative)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Audiometric testing confirms sensorineural hearing loss",
      "Neuropsychological assessment confirms intellectual disability"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "choroideremia",
      "distinguishingFeatures": [
        "Isolated progressive chorioretinal degeneration without intellectual disability or hearing loss",
        "X-linked inheritance pattern"
      ]
    },
    {
      "diseaseId": "pou3f4-related-deafness",
      "distinguishingFeatures": [
        "Sensorineural hearing loss with inner ear malformations",
        "No associated intellectual disability or chorioretinal degeneration"
      ]
    },
    {
      "diseaseId": "x-linked-intellectual-disability-syndromes",
      "distinguishingFeatures": [
        "Intellectual disability with variable additional features",
        "No contiguous gene deletion involving Xq21 region"
      ]
    }
  ],
