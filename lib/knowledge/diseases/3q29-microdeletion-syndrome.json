  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for 3q29 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of heterozygous deletion at chromosome 3q29 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-features",
        "description": "Characteristic craniofacial dysmorphisms including long narrow face, high nasal bridge, and prominent forehead",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "psychiatric-manifestations",
        "description": "Presence of neuropsychiatric disorders such as autism spectrum disorder or schizophrenia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 3q29 deletion plus presence of developmental delay or intellectual disability",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support but are variable."
  },
