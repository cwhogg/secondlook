      },
      {
        "id": "parkinsonism",
        "description": "Parkinsonism characterized by bradykinesia, rigidity, and postural instability with poor levodopa response",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "postural-instability",
        "description": "Early onset postural instability with unexplained falls within the first year",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cognitive-dysfunction",
        "description": "Frontal cognitive dysfunction including executive dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "axial-rigidity",
        "description": "Axial rigidity greater than limb rigidity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of vertical supranuclear gaze palsy or slowing of vertical saccades plus parkinsonism with poor levodopa response and early postural instability with falls",
    "notes": "Diagnosis is clinical; imaging and exclusion of other causes support diagnosis"
  },
