  "diagnosticCriteria": {
    "formalCriteriaName": "Richieri Costa-da Silva Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "mandibular-hypoplasia",
        "description": "Severe mandibular hypoplasia with micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cleft-palate",
        "description": "Cleft palate, often complete",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Limb anomalies including short stature of limbs, clinodactyly, and syndactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism and prominent nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: mandibular hypoplasia, cleft palate, and limb malformations",
    "notes": "Diagnosis is clinical and supported by genetic testing when available"
  },
