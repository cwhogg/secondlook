  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus diagnostic criteria for congenital muscular dystrophies",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early-onset hypotonia and muscle weakness presenting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy-merosin-deficiency",
        "description": "Muscle biopsy showing absence or severe reduction of laminin alpha-2 (merosin) staining",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the LAMA2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-mri",
        "description": "Brain MRI showing white matter abnormalities without significant cortical malformations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset hypotonia and muscle weakness plus either muscle biopsy showing merosin deficiency or pathogenic LAMA2 variants",
    "notes": "Genetic confirmation is considered the gold standard; brain MRI findings support diagnosis but are not definitive."
  },
