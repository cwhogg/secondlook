  "keyFindings": {
    "laboratory": [
      "Histopathology showing PAS-positive hyaline deposits in dermis and mucosa"
    ],
    "imaging": [
      "CT or MRI showing bilateral calcifications in medial temporal lobes (amygdala)"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Laryngoscopy revealing thickened vocal cords with hyaline infiltration"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "amyloidosis",
      "distinguishingFeatures": [
