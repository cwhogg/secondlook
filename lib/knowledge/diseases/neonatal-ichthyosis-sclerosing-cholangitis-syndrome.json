  "diagnosticCriteria": {
    "formalCriteriaName": "NISCH Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "ichthyosis",
        "description": "Congenital ichthyosis presenting in the neonatal period",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sclerosing-cholangitis",
        "description": "Evidence of sclerosing cholangitis on cholangiography or liver biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the CLDN1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alopecia",
        "description": "Congenital alopecia or hypotrichosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-liver-enzymes",
        "description": "Persistent elevation of serum liver transaminases and cholestatic markers",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital ichthyosis and sclerosing cholangitis confirmed by imaging or biopsy plus pathogenic CLDN1 mutation",
    "notes": "Genetic testing is critical for confirmation; liver biopsy may be required if imaging is inconclusive."
  },
