  "keyFindings": {
    "laboratory": [
      "Elevated serum calcium and parathyroid hormone levels",
      "Elevated prolactin or other pituitary hormone abnormalities",
      "Abnormal cortisol or adrenal hormone levels if adrenal tumors present"
    ],
    "imaging": [
      "Parathyroid adenomas on ultrasound or sestamibi scan",
      "Pituitary adenomas on MRI",
      "Adrenal masses on CT or MRI"
    ],
    "genetic": [
      "Pathogenic germline mutations in CDKN1B gene"
    ],
    "other": [
      "Family history consistent with MEN4 phenotype"
    ]
  },
