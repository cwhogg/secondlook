  "diagnosticCriteria": {
    "formalCriteriaName": "Marshall et al. Diagnostic Criteria for Alström Syndrome",
    "criteria": [
      {
        "id": "cone-rod-dystrophy",
        "description": "Progressive cone-rod dystrophy leading to vision loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiomyopathy",
        "description": "Dilated cardiomyopathy or restrictive cardiomyopathy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "metabolic-dysfunction",
        "description": "Insulin resistance, type 2 diabetes mellitus, or obesity",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hepatic-renal-dysfunction",
        "description": "Progressive hepatic fibrosis and/or renal impairment",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in ALMS1 gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of cone-rod dystrophy and sensorineural hearing loss plus either cardiomyopathy or metabolic dysfunction, or genetic confirmation of ALMS1 mutations",
    "notes": "Diagnosis is clinical but supported by genetic testing; multisystem involvement is typical."
  },
