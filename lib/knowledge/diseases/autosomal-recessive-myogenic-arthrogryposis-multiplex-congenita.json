  "keyFindings": {
    "laboratory": [
      "Normal creatine kinase levels or mildly elevated",
      "Normal metabolic panel"
    ],
    "imaging": [
      "Muscle MRI showing muscle hypoplasia and fatty infiltration",
      "X-rays demonstrating joint contractures and spinal deformities"
    ],
    "genetic": [
      "SYNE1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy showing myopathic changes with fiber size variability and fibrosis",
      "Electromyography consistent with myopathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "neurogenic-arthrogryposis-multiplex-congenita",
      "distinguishingFeatures": [
        "Primary central or peripheral nervous system involvement",
        "Abnormal reflexes and sensory deficits",
        "Neurogenic changes on electromyography"
      ]
    },
    {
      "diseaseId": "distal-arthrogryposis-type-1",
      "distinguishingFeatures": [
        "Predominantly distal joint involvement",
        "Autosomal dominant inheritance",
        "Less severe muscle hypoplasia"
      ]
    }
  ],
