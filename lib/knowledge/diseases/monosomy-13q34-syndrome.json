  "diagnosticCriteria": {
    "formalCriteriaName": "Chromosomal Microdeletion Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of deletion involving 13q34 region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Presence of global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-features",
        "description": "Characteristic craniofacial dysmorphisms including microcephaly and facial asymmetry",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or renal malformations",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-signs",
        "description": "Neurological abnormalities including hypotonia and seizures",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 13q34 deletion plus at least one major clinical feature (developmental delay or craniofacial features)",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support but are variable."
  },
