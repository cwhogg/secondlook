  "diagnosticCriteria": {
    "formalCriteriaName": "Gastroparesis Diagnostic Criteria",
    "criteria": [
      {
        "id": "symptom-duration",
        "description": "Presence of chronic symptoms of delayed gastric emptying such as nausea, vomiting, early satiety, and postprandial fullness for at least 3 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gastric-emptying-study",
        "description": "Demonstration of delayed gastric emptying on scintigraphic gastric emptying study (gastric retention >10% at 4 hours)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-mechanical-obstruction",
        "description": "Exclusion of mechanical gastric outlet obstruction by upper endoscopy or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-secondary-causes",
        "description": "No identifiable secondary causes such as diabetes mellitus, postsurgical status, or medications known to delay gastric emptying",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (chronic symptoms, delayed gastric emptying on scintigraphy, exclusion of mechanical obstruction) must be met",
    "notes": "Idiopathic gastroparesis is a diagnosis of exclusion after ruling out secondary causes."
  },
