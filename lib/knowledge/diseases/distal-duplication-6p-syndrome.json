  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests unless secondary complications",
      "Possible thyroid function abnormalities in congenital hypothyroidism"
    ],
    "imaging": [
      "Echocardiography revealing septal defects or other congenital heart malformations",
      "Brain MRI may show nonspecific findings related to developmental delay",
      "Renal ultrasound detecting structural anomalies"
    ],
    "genetic": [
      "Array CGH or karyotype showing duplication of distal 6p region",
      "FISH or MLPA confirming duplication breakpoints"
    ],
    "other": [
      "Developmental assessments confirming intellectual disability",
      "Audiological testing for hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "trisomy-6p-syndrome",
      "distinguishingFeatures": [
        "Larger duplicated region including proximal 6p",
        "More severe congenital anomalies",
        "Distinct facial gestalt"
      ]
    },
    {
      "diseaseId": "wolf-hirschhorn-syndrome",
      "distinguishingFeatures": [
        "Deletion of 4p instead of duplication 6p",
        "Characteristic 'Greek warrior helmet' facial appearance",
        "Severe growth retardation and seizures"
      ]
    }
  ],
  "redFlags": [
