  "keyFindings": {
    "laboratory": [
      "Elevated muscle enzymes during spasms",
      "Autoantibodies including ANA and anti-striated muscle antibodies",
      "Malabsorption markers such as low serum albumin and vitamin deficiencies"
    ],
    "imaging": [
      "X-rays showing joint contractures and skeletal deformities",
      "Bone densitometry indicating osteoporosis"
    ],
    "genetic": [
      "No definitive genetic mutation identified; possible autoimmune etiology"
    ],
    "other": [
      "Electromyography showing continuous motor unit activity during spasms",
      "Muscle biopsy demonstrating nonspecific myopathic changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "stiff-person-syndrome",
      "distinguishingFeatures": [
        "Autoimmune disorder with stiffness and spasms but lacks alopecia and diarrhea",
        "Presence of anti-GAD antibodies"
      ]
    },
    {
      "diseaseId": "juvenile-onset-polymyositis",
      "distinguishingFeatures": [
        "Inflammatory myopathy with muscle weakness but no alopecia or gastrointestinal symptoms",
        "Elevated muscle enzymes and characteristic biopsy findings"
      ]
    },
    {
      "diseaseId": "malabsorption-syndromes",
      "distinguishingFeatures": [
        "Chronic diarrhea and weight loss without muscle spasms or alopecia",
        "Specific causes such as celiac disease or inflammatory bowel disease"
      ]
    }
