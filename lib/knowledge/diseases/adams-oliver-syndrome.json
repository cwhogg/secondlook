  "diagnosticCriteria": {
    "formalCriteriaName": "Adams-Oliver Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "scalp-defect",
        "description": "Congenital aplasia cutis congenita of the scalp",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "terminal-limb-defects",
        "description": "Terminal transverse limb defects including hypoplastic or absent digits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vascular-anomalies",
        "description": "Presence of vascular malformations such as cutis marmorata telangiectatica congenita",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-anomalies",
        "description": "Congenital heart defects including ventricular septal defects or pulmonary hypertension",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant or recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (scalp aplasia cutis and terminal limb defects) with or without minor criteria",
    "notes": "Genetic testing can support diagnosis but is not mandatory; phenotypic variability is common."
  },
