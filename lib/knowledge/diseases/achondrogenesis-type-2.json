  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Achondrogenesis Type 2",
    "criteria": [
      {
        "id": "prenatal-lethal",
        "description": "Prenatal or perinatal lethality with severe short-limbed dwarfism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-features",
        "description": "Radiographic evidence of absent or severely reduced ossification of vertebral bodies and skull base",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the COL2A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Clinical features including macrocephaly, short neck, and narrow thorax",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic radiological features plus identification of pathogenic COL2A1 variant or consistent clinical and radiological findings in a lethal perinatal presentation",
    "notes": "Genetic testing is confirmatory; prenatal ultrasound findings are critical for early diagnosis."
  },
