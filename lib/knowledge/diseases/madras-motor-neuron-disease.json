  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Clinical Diagnostic Criteria for Madras Motor Neuron Disease",
    "criteria": [
      {
        "id": "progressive-bulbar-palsy",
        "description": "Progressive lower motor neuron involvement of the bulbar muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-weakness",
        "description": "Distal limb muscle weakness and wasting predominantly in lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss documented by audiometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-upper-motor-neuron-signs",
        "description": "Lack of upper motor neuron signs such as spasticity or hyperreflexia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electrophysiological-evidence",
        "description": "Electromyography showing denervation and chronic reinnervation changes",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of progressive bulbar lower motor neuron signs, distal limb weakness with wasting, sensorineural hearing loss, and supportive electrophysiological evidence in the absence of upper motor neuron signs",
    "notes": "Diagnosis is clinical supported by electrophysiology and audiometry; genetic testing currently not definitive."
  },
