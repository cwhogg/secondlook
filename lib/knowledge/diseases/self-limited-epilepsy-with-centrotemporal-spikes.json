  "diagnosticCriteria": {
    "formalCriteriaName": "ILAE 2017 Classification Criteria for Self-limited Epilepsy with Centrotemporal Spikes",
    "criteria": [
      {
        "id": "clinical-seizures",
        "description": "Focal seizures characterized by hemifacial sensorimotor symptoms, often with oropharyngeal involvement and preserved awareness or impaired awareness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eeg-centrotemporal-spikes",
        "description": "Interictal EEG showing centrotemporal spikes, typically activated during sleep",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-onset",
        "description": "Age of onset between 3 and 13 years with spontaneous remission by adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-neurodevelopment",
        "description": "Normal neurological examination and neurodevelopmental status",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-etiologies",
        "description": "No evidence of structural brain abnormalities or metabolic causes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of typical focal seizures with centrotemporal spikes on EEG in a child aged 3-13 years with normal neurodevelopment and no other identifiable cause",
    "notes": "Diagnosis is clinical and electroencephalographic; neuroimaging is typically normal and reserved for atypical presentations."
  },
