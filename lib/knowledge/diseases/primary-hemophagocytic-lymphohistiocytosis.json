  "diagnosticCriteria": {
    "formalCriteriaName": "HLH-2004 Diagnostic Criteria",
    "criteria": [
      {
        "id": "fever",
        "description": "Persistent fever ≥38.5°C",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "splenomegaly",
        "description": "Enlarged spleen",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cytopenias",
        "description": "Cytopenias affecting ≥2 of 3 lineages in peripheral blood (hemoglobin <9 g/dL, platelets <100,000/mm³, neutrophils <1,000/mm³)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypertriglyceridemia_hypofibrinogenemia",
        "description": "Hypertriglyceridemia (fasting triglycerides ≥265 mg/dL) and/or hypofibrinogenemia (fibrinogen ≤150 mg/dL)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hemophagocytosis",
        "description": "Hemophagocytosis in bone marrow, spleen, or lymph nodes without evidence of malignancy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "low_nk_cell_activity",
        "description": "Low or absent natural killer (NK) cell cytotoxicity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ferritin",
        "description": "Elevated ferritin ≥500 ng/mL",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "soluble_cd25",
        "description": "Elevated soluble CD25 (soluble IL-2 receptor alpha) ≥2,400 U/mL",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic_mutation",
        "description": "Identification of pathogenic mutations in HLH-associated genes (e.g., PRF1, UNC13D, STX11, STXBP2)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular diagnosis consistent with HLH or fulfillment of 5 out of 8 clinical and laboratory criteria",
    "notes": "Diagnosis requires exclusion of secondary causes and consideration of clinical context."
  },
