  "diagnosticCriteria": {
    "formalCriteriaName": "European Neuromuscular Centre (ENMC) 2018 Criteria for Dermatomyositis",
    "criteria": [
      {
        "id": "autoantibody",
        "description": "Presence of anti-TIF1 gamma autoantibodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscleWeakness",
        "description": "Symmetric proximal muscle weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skinManifestations",
        "description": "Characteristic dermatomyositis skin rash (heliotrope rash, Gottron’s papules)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscleBiopsy",
        "description": "Muscle biopsy showing perifascicular atrophy and inflammation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cancerScreening",
        "description": "Evidence of underlying malignancy within 3 years of diagnosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of anti-TIF1 gamma autoantibodies plus characteristic skin rash and proximal muscle weakness",
    "notes": "Cancer screening is critical due to strong association with malignancy."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Heliotrope rash",
        "frequency": 0.85,
        "bodySystem": "dermatological",
        "notes": "Violaceous discoloration of eyelids"
      },
      {
        "symptomName": "Gottron’s papules",
        "frequency": 0.8,
        "bodySystem": "dermatological",
        "notes": "Scaly erythematous papules over extensor surfaces of joints"
      },
      {
        "symptomName": "Anti-TIF1 gamma autoantibodies positivity",
        "frequency": 0.9,
        "bodySystem": "immunological",
        "notes": "Serologic hallmark of this subtype",
        "searchTerms": [
          "autoimmune antibody linked to muscle inflammation",
          "specific immune marker causing skin and muscle symptoms",
          "immune protein associated with dermatomyositis"
        ]
      }
    ],
    "common": [
      {
        "symptomName": "Symmetric proximal muscle weakness",
        "frequency": 0.75,
        "bodySystem": "musculoskeletal",
        "notes": "Typically affects shoulder and hip girdle muscles",
        "searchTerms": [
          "equal muscle weakness on both sides",
          "symmetrical proximal weakness"
        ]
      },
      {
        "symptomName": "Photosensitive poikiloderma",
        "frequency": 0.7,
        "bodySystem": "dermatological",
        "notes": "Skin changes with hypopigmentation, hyperpigmentation, and telangiectasia"
      },
      {
        "symptomName": "Dysphagia",
        "frequency": 0.6,
        "bodySystem": "gastrointestinal",
        "notes": "Due to involvement of oropharyngeal muscles"
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.65,
        "bodySystem": "constitutional",
        "notes": "Common systemic symptom"
      },
      {
        "symptomName": "Arthralgia",
        "frequency": 0.55,
        "bodySystem": "musculoskeletal",
        "notes": "Joint pain without frank arthritis"
      }
    ],
    "occasional": [
      {
        "symptomName": "Interstitial lung disease",
        "frequency": 0.3,
        "bodySystem": "respiratory",
        "notes": "Less frequent than in other dermatomyositis subtypes",
        "searchTerms": [
          "lung tissue scarring",
          "interstitial lung inflammation",
          "thickened lung tissue"
        ]
      },
      {
        "symptomName": "Calcinosis cutis",
        "frequency": 0.2,
        "bodySystem": "dermatological",
        "notes": "Calcium deposits in skin and soft tissue"
      },
      {
        "symptomName": "Raynaud phenomenon",
        "frequency": 0.15,
        "bodySystem": "cardiovascular",
        "notes": "Vasospasm of digital arteries"
      },
      {
        "symptomName": "Mild peripheral edema",
        "frequency": 0.1,
        "bodySystem": "cardiovascular",
        "notes": "Due to inflammation or hypoalbuminemia",
        "searchTerms": [
