  "diagnosticCriteria": {
    "formalCriteriaName": "Polyendocrine-Polyneuropathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "polyneuropathy",
        "description": "Presence of a chronic, symmetrical sensorimotor polyneuropathy confirmed by nerve conduction studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multiple-endocrinopathies",
        "description": "Evidence of two or more endocrine gland dysfunctions (e.g., thyroid, adrenal, pancreatic)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoimmune-markers",
        "description": "Presence of circulating autoantibodies associated with endocrine autoimmunity",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Nerve biopsy showing inflammatory or demyelinating features consistent with autoimmune neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic symmetrical sensorimotor polyneuropathy plus at least two endocrine gland dysfunctions",
    "notes": "Autoimmune etiology is strongly suspected; exclusion of other causes of polyneuropathy is essential."
  },
