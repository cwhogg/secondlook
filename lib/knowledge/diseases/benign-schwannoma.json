  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological and radiological diagnostic criteria for benign schwannoma",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of Antoni A and Antoni B areas with Verocay bodies on histopathological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "MRI showing well-circumscribed, encapsulated mass with iso- to hypointense signal on T1 and hyperintense on T2-weighted images",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Strong and diffuse S-100 protein positivity in tumor cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Slow-growing, painless mass along peripheral nerve distribution",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation with characteristic Antoni A and B areas plus S-100 positivity, supported by compatible imaging findings",
    "notes": "Definitive diagnosis requires histopathological examination; imaging and clinical features support diagnosis."
  },
