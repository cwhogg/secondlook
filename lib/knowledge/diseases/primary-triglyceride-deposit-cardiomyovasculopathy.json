  "diagnosticCriteria": {
    "formalCriteriaName": "TGCV Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of massive triglyceride deposits in myocardial tissue confirmed by biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-imaging",
        "description": "Evidence of diffuse myocardial dysfunction with fatty infiltration on cardiac MRI or CT",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in PNPLA2 gene or related lipase genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-presentation",
        "description": "Symptoms of heart failure with preserved ejection fraction and arrhythmias",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation plus cardiac imaging evidence; genetic testing supportive but not mandatory",
    "notes": "Diagnosis often requires integration of clinical, imaging, histological, and genetic data."
  },
