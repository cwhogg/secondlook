  "differentialDiagnoses": [
    {
      "diseaseId": "wolfram-syndrome",
      "distinguishingFeatures": [
        "Wolfram syndrome typically caused by WFS1 mutations",
        "More frequent diabetes insipidus and optic atrophy",
        "Earlier onset and more severe neurodegeneration"
      ]
    },
    {
      "diseaseId": "mitochondrial-disease",
      "distinguishingFeatures": [
        "Multisystem involvement with mitochondrial DNA mutations",
        "Variable onset and presentation",
        "Lactic acidosis and muscle biopsy abnormalities"
      ]
    }
  ],
