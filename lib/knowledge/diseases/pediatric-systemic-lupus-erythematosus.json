  "diagnosticCriteria": {
    "formalCriteriaName": "2019 EULAR/ACR Classification Criteria for SLE",
    "criteria": [
      {
        "id": "antinuclear-antibody",
        "description": "Positive antinuclear antibody (ANA) test at a titer of ≥1:80",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acute-cutaneous-lupus",
        "description": "Presence of acute cutaneous lupus manifestations such as malar rash",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-involvement",
        "description": "Biopsy-proven lupus nephritis compatible with SLE",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hematologic-abnormalities",
        "description": "Hemolytic anemia, leukopenia, lymphopenia, or thrombocytopenia attributable to SLE",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuropsychiatric-symptoms",
        "description": "Seizures or psychosis not explained by other causes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "immunologic-markers",
        "description": "Anti-dsDNA, anti-Sm antibodies, or antiphospholipid antibodies positivity",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Positive ANA plus a total of ≥10 points from clinical and immunologic criteria according to 2019 EULAR/ACR guidelines",
    "notes": "Diagnosis requires exclusion of other mimicking conditions and consideration of pediatric-specific manifestations."
  },
