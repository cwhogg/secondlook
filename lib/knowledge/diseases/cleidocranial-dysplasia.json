  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "No specific biochemical markers"
    ],
    "imaging": [
      "X-ray showing hypoplastic or absent clavicles",
      "Delayed closure of cranial sutures on skull radiographs",
      "Multiple impacted and supernumerary teeth on dental panoramic imaging",
      "Delayed ossification of pelvic bones"
    ],
    "genetic": [
      "Pathogenic mutations in RUNX2 gene (heterozygous)",
      "Autosomal dominant inheritance pattern"
    ],
    "other": [
      "Family history consistent with autosomal dominant inheritance",
      "Physical exam revealing ability to approximate shoulders anteriorly due to clavicular hypoplasia"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pyknodysostosis",
      "distinguishingFeatures": [
        "Increased bone density",
        "Short stature with acro-osteolysis",
        "Delayed closure of cranial sutures but normal clavicles"
      ]
    },
    {
      "diseaseId": "osterogenesis-imperfecta",
      "distinguishingFeatures": [
        "Bone fragility with frequent fractures",
        "Blue sclerae",
        "Normal clavicles"
      ]
    },
    {
      "diseaseId": "hypophosphatasia",
      "distinguishingFeatures": [
        "Low serum alkaline phosphatase",
        "Premature loss of teeth without root resorption",
        "Skeletal hypomineralization"
      ]
    }
  ],
