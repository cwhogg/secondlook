  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Kufor-Rakeb Syndrome",
    "criteria": [
      {
        "id": "parkinsonism",
        "description": "Early-onset parkinsonism with bradykinesia, rigidity, and tremor",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pyramidal-signs",
        "description": "Presence of pyramidal tract signs such as spasticity and hyperreflexia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "atp13a2-mutation",
        "description": "Pathogenic mutation in the ATP13A2 gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cognitive-impairment",
        "description": "Cognitive decline or dementia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "supranuclear-gaze-palsy",
        "description": "Vertical supranuclear gaze palsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset parkinsonism with pyramidal signs plus confirmed ATP13A2 gene mutation",
    "notes": "Diagnosis is supported by clinical features and confirmed by molecular genetic testing."
  },
