  "diagnosticCriteria": {
    "formalCriteriaName": "ICCA Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "infantile-seizures",
        "description": "History of infantile seizures occurring within the first year of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "paroxysmal-dyskinesia",
        "description": "Onset of paroxysmal dyskinesias (dystonia, chorea, or athetosis) in later childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the PRRT2 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-neuroimaging",
        "description": "Normal brain MRI excluding structural causes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of infantile seizures followed by paroxysmal dyskinesia episodes in childhood, with or without genetic confirmation",
    "notes": "Genetic testing for PRRT2 mutations strongly supports diagnosis but is not mandatory."
  },
