        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-manifestations",
        "description": "Presence of progressive neurodegenerative symptoms including developmental delay and dystonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with 3-methylglutaconic aciduria type 4 (e.g., DNAJC19)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiomyopathy",
        "description": "Evidence of hypertrophic or dilated cardiomyopathy on cardiac evaluation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consistent family history of autosomal recessive inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated urinary 3-methylglutaconic acid, compatible neurological symptoms, and genetic confirmation of pathogenic variants",
    "notes": "Diagnosis requires exclusion of other types of 3-methylglutaconic aciduria and related metabolic disorders."
