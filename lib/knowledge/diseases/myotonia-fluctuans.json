  "keyFindings": {
    "laboratory": [
      "Normal serum creatine kinase levels or mildly elevated",
      "Electrolyte levels typically normal"
    ],
    "imaging": [
      "Muscle MRI may show mild hypertrophy without fatty infiltration"
    ],
    "genetic": [
      "SCN4A (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography showing characteristic myotonic discharges with waxing and waning frequency"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "myotonic-dystrophy-type-1",
      "distinguishingFeatures": [
        "Progressive muscle weakness and wasting",
        "Multisystem involvement including cataracts and cardiac conduction defects",
        "CTG repeat expansion in DMPK gene"
      ]
    },
    {
      "diseaseId": "paramyotonia-congenita",
      "distinguishingFeatures": [
        "Myotonia worsens with repeated activity and cold exposure",
        "SCN4A gene mutations with paradoxical myotonia",
        "More prominent facial and neck muscle involvement"
      ]
    }
  ],
