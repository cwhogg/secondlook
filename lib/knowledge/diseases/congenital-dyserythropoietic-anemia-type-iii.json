  "keyFindings": {
    "laboratory": [
      "Macrocytic anemia with low reticulocyte count",
      "Elevated LDH and indirect bilirubin",
      "Normal to low serum iron and ferritin unless transfused"
    ],
    "imaging": [
      "Splenomegaly on abdominal ultrasound",
      "Possible gallstones on abdominal imaging"
    ],
    "genetic": [
      "Pathogenic mutations in KIF23 gene"
    ],
    "other": [
      "Bone marrow biopsy showing giant multinucleated erythroblasts and ineffective erythropoiesis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-dyserythropoietic-anemia-type-i",
      "distinguishingFeatures": [
        "Presence of binucleated erythroblasts rather than giant multinucleated forms",
        "Mutations in CDAN1 or C15orf41 genes",
        "Different bone marrow morphology"
      ]
    },
    {
      "diseaseId": "congenital-dyserythropoietic-anemia-type-ii",
      "distinguishingFeatures": [
        "Presence of erythroblasts with double membranes and spongy heterochromatin",
        "Mutations in SEC23B gene",
        "Positive acidified serum test (Ham test)"
      ]
    }
  ],
  "redFlags": [
    "Severe anemia refractory to standard treatment",
    "Progressive splenomegaly with hypersplenism",
    "Evidence of iron overload despite no transfusions"
  ],
