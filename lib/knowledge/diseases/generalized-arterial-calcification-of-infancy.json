  "diagnosticCriteria": {
    "formalCriteriaName": "No standardized formal criteria established",
    "criteria": [
      {
        "id": "arterial-calcification-imaging",
        "description": "Radiologic evidence of diffuse arterial calcification on imaging studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathologic-confirmation",
        "description": "Histopathological confirmation of calcification and intimal proliferation in arterial walls",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in ENPP1 or ABCC6 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Early infancy onset of cardiovascular symptoms such as heart failure or hypertension",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of radiologic arterial calcifications plus either genetic confirmation or histopathologic evidence",
    "notes": "Genetic testing is increasingly used to confirm diagnosis; biopsy is less commonly performed due to invasiveness."
  },
