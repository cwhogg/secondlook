  "diagnosticCriteria": {
    "formalCriteriaName": "Carrington Criteria",
    "criteria": [
      {
        "id": "eosinophilia",
        "description": "Peripheral blood eosinophilia > 1000 cells/µL or bronchoalveolar lavage eosinophilia > 40%",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-infiltrates",
        "description": "Characteristic peripheral or upper lobe predominant pulmonary infiltrates on chest imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of eosinophilic lung disease such as infections, drugs, or malignancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Subacute onset of respiratory symptoms lasting more than 2 weeks",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-steroids",
        "description": "Rapid clinical and radiological improvement with corticosteroid therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: eosinophilia, characteristic pulmonary infiltrates, and exclusion of other causes",
    "notes": "Bronchoalveolar lavage eosinophilia is often more sensitive than peripheral blood eosinophilia."
  },
