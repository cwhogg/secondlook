  "keyFindings": {
    "laboratory": [
      "Persistent proteinuria (often nephrotic range)",
      "Hypoalbuminemia",
      "Elevated serum creatinine and urea",
      "Mild normocytic anemia"
    ],
    "imaging": [
      "Renal ultrasound showing normal or reduced kidney size in advanced disease",
      "Echocardiography to exclude cardiac amyloidosis"
    ],
    "genetic": [
      "Mutations in fibrinogen A alpha-chain gene (FGA)",
      "Other amyloidogenic gene mutations (e.g., apolipoprotein A1)"
    ],
    "other": [
      "Renal biopsy with Congo red staining showing apple-green birefringence under polarized light",
      "Electron microscopy demonstrating amyloid fibrils"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "primary-amyloidosis",
      "distinguishingFeatures": [
        "Usually involves multiple organs including heart and nerves",
        "No family history",
        "Presence of monoclonal gammopathy"
      ]
    },
    {
      "diseaseId": "secondary-amyloidosis",
      "distinguishingFeatures": [
        "Associated with chronic inflammatory diseases",
        "Systemic involvement with elevated inflammatory markers",
        "No genetic mutations"
      ]
    },
    {
      "diseaseId": "other-hereditary-amyloidosis",
      "distinguishingFeatures": [
        "Different gene mutations (e.g., transthyretin)",
        "Predominant cardiac or neurological involvement",
        "Different age of onset"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive proteinuria",
    "Family history of early-onset renal failure",
    "Unexplained nephrotic syndrome with negative secondary workup"
  ],
