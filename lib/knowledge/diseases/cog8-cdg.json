    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the COG8 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-glycosylation",
        "description": "Demonstration of abnormal N- and O-linked glycosylation patterns on serum transferrin and other glycoproteins",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features including developmental delay, hypotonia, and microcephaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-lab-findings",
        "description": "Additional laboratory abnormalities such as elevated liver enzymes and coagulation defects",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biallelic pathogenic variants in COG8 plus abnormal glycosylation and compatible clinical features",
    "notes": "Diagnosis requires integration of genetic, biochemical, and clinical data."
  },
