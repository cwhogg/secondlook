  "diagnosticCriteria": {
    "formalCriteriaName": "APDS2 Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of heterozygous pathogenic variants in PIK3R1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Recurrent sinopulmonary infections with hypogammaglobulinemia or impaired antibody responses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphoproliferation",
        "description": "Presence of benign lymphadenopathy, splenomegaly, or hepatomegaly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "autoimmune-manifestations",
        "description": "Autoimmune cytopenias or other autoimmune phenomena",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-pi3k-activity",
        "description": "Increased PI3K-delta pathway activity in functional assays",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic PIK3R1 variant plus clinical immunodeficiency features",
    "notes": "Diagnosis is confirmed by genetic testing combined with clinical and immunological findings."
  },
