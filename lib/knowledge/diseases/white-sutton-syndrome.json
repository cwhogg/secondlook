  "diagnosticCriteria": {
    "formalCriteriaName": "White-Sutton Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pogz-pathogenic-variant",
        "description": "Presence of pathogenic or likely pathogenic variant in the POGZ gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial dysmorphisms including broad forehead, hypertelorism, and midface hypoplasia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-issues",
        "description": "Behavioral abnormalities such as autism spectrum disorder or attention deficit hyperactivity disorder",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Neonatal or infantile hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of global developmental delay or intellectual disability plus a pathogenic POGZ gene variant",
    "notes": "Diagnosis is confirmed by molecular genetic testing identifying a pathogenic variant in POGZ."
  },
