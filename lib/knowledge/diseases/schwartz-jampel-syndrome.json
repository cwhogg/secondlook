  "diagnosticCriteria": {
    "formalCriteriaName": "Schwartz-Jampel Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "myotonia",
        "description": "Persistent myotonia evidenced by electromyography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including blepharophimosis, micrognathia, and pursed lips",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal abnormalities such as short stature, joint contractures, and chondrodysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the HSPG2 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent myotonia plus characteristic facial dysmorphism and skeletal abnormalities",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory"
  },
