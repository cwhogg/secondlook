  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Congenital Unilateral Hypoplasia of Depressor Anguli Oris",
    "criteria": [
      {
        "id": "facial-asymmetry",
        "description": "Presence of unilateral lower lip asymmetry due to hypoplasia of depressor anguli oris muscle",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-muscle-involvement",
        "description": "No involvement of other facial muscles such as orbicularis oris or zygomaticus major",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "onset-at-birth",
        "description": "Facial asymmetry present since birth without progressive worsening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-neurological-exam",
        "description": "Normal cranial nerve function excluding facial nerve palsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-trauma-history",
        "description": "No history of birth trauma or facial nerve injury",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of unilateral lower lip asymmetry due to depressor anguli oris hypoplasia at birth with no involvement of other facial muscles and no history of trauma",
    "notes": "Diagnosis is primarily clinical; imaging and electrophysiological studies may be used to exclude other causes"
  },
