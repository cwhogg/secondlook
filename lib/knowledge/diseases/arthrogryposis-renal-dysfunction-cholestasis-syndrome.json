  "keyFindings": {
    "laboratory": [
      "Elevated conjugated bilirubin and serum bile acids",
      "Evidence of renal tubular dysfunction: aminoaciduria, glucosuria, phosphaturia",
      "Platelet aggregation and secretion defects on platelet function tests"
    ],
    "imaging": [
      "Joint contractures visible on prenatal or postnatal ultrasound",
      "Renal ultrasound may show nephrocalcinosis or structural abnormalities",
      "Liver ultrasound may show cholestasis-related changes"
    ],
    "genetic": [
      "VPS33B (causative)",
      "VIPAS39 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy showing ichthyosis",
      "Bleeding diathesis with normal platelet count but abnormal function"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "arthrogryposis-multiplex-congenita",
      "distinguishingFeatures": [
        "Absence of renal tubular dysfunction and cholestasis",
        "Genetic heterogeneity without VPS33B or VIPAS39 mutations"
      ]
    },
    {
      "diseaseId": "biliary-atresia",
      "distinguishingFeatures": [
        "Obstructive cholestasis without arthrogryposis or renal dysfunction",
        "Surgical findings of extrahepatic bile duct obliteration"
      ]
    },
    {
      "diseaseId": "fanconi-syndrome",
      "distinguishingFeatures": [
        "Renal tubular dysfunction without arthrogryposis or cholestasis",
        "Different genetic causes and clinical presentation"
      ]
    }
  ],
  "redFlags": [
    "Neonatal onset of multiple joint contractures",
    "Progressive cholestasis with conjugated hyperbilirubinemia",
    "Severe bleeding tendency despite normal platelet count"
  ],
