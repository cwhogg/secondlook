  "keyFindings": {
    "laboratory": [
      "Detection of botulinum neurotoxin in serum, stool, or intestinal contents by mouse bioassay or immunoassay",
      "Isolation of Clostridium botulinum from stool samples",
      "Normal routine blood tests"
    ],
    "imaging": [
      "Usually normal brain and spinal cord imaging",
      "Chest X-ray may show atelectasis or aspiration pneumonia secondary to bulbar weakness"
    ],
    "genetic": [
      "No known genetic mutations associated"
    ],
    "other": [
      "Electrophysiological studies showing incremental response to high-frequency repetitive nerve stimulation",
      "Clinical exclusion of other causes of neuromuscular paralysis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "wound-botulism",
      "distinguishingFeatures": [
        "History of wound contamination",
        "Local wound infection signs",
        "Absence of intestinal colonization"
      ]
    },
    {
      "diseaseId": "foodborne-botulism",
      "distinguishingFeatures": [
        "History of ingestion of contaminated food",
        "No evidence of intestinal colonization",
        "Rapid onset after food exposure"
      ]
    },
    {
      "diseaseId": "myasthenia-gravis",
      "distinguishingFeatures": [
        "Fluctuating muscle weakness",
        "Positive acetylcholine receptor antibodies",
        "Improvement with anticholinesterase agents"
      ]
    }
  ],
