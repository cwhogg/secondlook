  "diagnosticCriteria": {
    "formalCriteriaName": "DSM-5 Catatonia Criteria",
    "criteria": [
      {
        "id": "mutism",
        "description": "Marked reduction in verbal response or complete absence of speech",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "stupor",
        "description": "No psychomotor activity; not actively relating to environment",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "posturing",
        "description": "Spontaneous and active maintenance of a posture against gravity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "catalepsy",
        "description": "Passive induction of a posture held against gravity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "waxy-flexibility",
        "description": "Slight, even resistance to positioning by examiner",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "negativism",
        "description": "Opposition or no response to instructions or external stimuli",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "echolalia",
        "description": "Mimicking another's speech",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "echopraxia",
        "description": "Mimicking another's movements",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least three of the specified catatonic signs in the absence of an identifiable medical or psychiatric cause",
    "notes": "Diagnosis requires exclusion of secondary causes such as neurological, metabolic, or psychiatric disorders."
  },
