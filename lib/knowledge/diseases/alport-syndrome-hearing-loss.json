  "keyFindings": {
    "laboratory": [
      "Persistent microscopic hematuria on urinalysis",
      "Proteinuria",
      "Elevated serum creatinine in progressive renal failure"
    ],
    "imaging": [
      "Renal ultrasound showing normal or small echogenic kidneys in advanced disease",
      "Ocular slit-lamp examination revealing anterior lenticonus"
    ],
    "genetic": [
      "Pathogenic variants in COL4A3, COL4A4, or COL4A5 genes"
    ],
    "other": [
      "Renal biopsy showing irregular thickening and splitting of the glomerular basement membrane"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "thin-basement-membrane-nephropathy",
      "distinguishingFeatures": [
        "Isolated microscopic hematuria without progressive renal failure",
        "Absence of hearing loss and ocular abnormalities"
      ]
    },
    {
      "diseaseId": "benign-familial-hematuria",
      "distinguishingFeatures": [
        "Non-progressive hematuria",
        "No sensorineural hearing loss or ocular findings"
      ]
    },
    {
      "diseaseId": "bardet-biedl-syndrome",
      "distinguishingFeatures": [
        "Multisystem involvement with obesity, polydactyly, and retinal dystrophy",
        "Hearing loss less common and renal disease differs in pathology"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive renal failure in young patient",
    "Early onset bilateral sensorineural hearing loss",
    "Presence of anterior lenticonus on ocular examination"
  ],
