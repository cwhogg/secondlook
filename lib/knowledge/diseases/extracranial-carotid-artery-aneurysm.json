  "diagnosticCriteria": {
    "formalCriteriaName": "Extracranial Carotid Artery Aneurysm Diagnostic Criteria",
    "criteria": [
      {
        "id": "imaging-confirmation",
        "description": "Radiological evidence of aneurysmal dilation of the extracranial carotid artery on ultrasound, CT angiography, or MR angiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of a pulsatile neck mass or bruit in the carotid region",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-symptoms",
        "description": "Transient ischemic attacks or ischemic stroke symptoms attributable to embolism from the aneurysm",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-etiologies",
        "description": "Exclusion of other causes of carotid artery dilation such as dissection or vasculitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of imaging-confirmed extracranial carotid artery aneurysm plus either clinical presentation with pulsatile neck mass or neurological symptoms",
    "notes": "Diagnosis relies heavily on imaging modalities; clinical suspicion is raised by neck mass or neurological events."
  },
