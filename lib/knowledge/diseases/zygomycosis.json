  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Diagnostic Criteria for Zygomycosis",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Identification of broad, non-septate hyphae with right-angle branching on tissue biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "culture",
        "description": "Isolation of Zygomycetes species from sterile site cultures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of rapidly progressive necrotic lesions in typical anatomical sites (e.g., rhinocerebral, pulmonary, cutaneous)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Radiological evidence of tissue invasion and infarction consistent with fungal angioinvasion",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation or positive culture combined with compatible clinical presentation",
    "notes": "Early diagnosis is critical due to rapid progression and high mortality."
  },
