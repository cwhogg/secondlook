  "keyFindings": {
    "laboratory": [
      "Low serum immunoglobulin levels (IgG, IgA, IgM)",
      "Presence of hair follicle-specific autoantibodies",
      "Lymphocyte subset analysis showing normal T-cell counts with impaired B-cell function"
    ],
    "imaging": [
      "Chest X-ray or CT showing recurrent or chronic pulmonary infections",
      "Ultrasound showing lymphadenopathy or splenomegaly"
    ],
    "genetic": [
      "Mutations in genes related to B-cell development or function (e.g., BTK, ICOS) may be identified"
    ],
    "other": [
      "Histopathology of scalp biopsy showing perifollicular lymphocytic infiltrate without scarring"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "alopecia-areata",
      "distinguishingFeatures": [
        "Absence of systemic immunodeficiency",
        "No hypogammaglobulinemia",
        "Typically isolated hair loss without recurrent infections"
      ]
    },
    {
      "diseaseId": "common-variable-immunodeficiency",
      "distinguishingFeatures": [
        "More generalized immunodeficiency with broader clinical manifestations",
        "May lack prominent alopecia",
        "Different genetic and immunological profiles"
      ]
    },
    {
      "diseaseId": "secondary-immunodeficiency",
      "distinguishingFeatures": [
        "History of immunosuppressive therapy or HIV infection",
        "Reversible immunodeficiency upon treatment",
        "No primary hair follicle autoantibodies"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of alopecia with systemic infections",
    "Severe hypogammaglobulinemia with recurrent sepsis",
    "Development of autoimmune endocrinopathies"
  ],
