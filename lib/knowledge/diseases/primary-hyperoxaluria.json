      "Histological evidence of oxalate crystal deposition in tissues"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "secondary-hyperoxaluria",
      "distinguishingFeatures": [
        "History of increased dietary oxalate or intestinal malabsorption",
        "Absence of pathogenic mutations in PH genes",
        "Normal or mildly elevated urinary oxalate excretion"
      ]
    },
    {
      "diseaseId": "cystinuria",
      "distinguishingFeatures": [
