      "Positive family history of hemolytic anemia",
      "Response to hemolysis management strategies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "beta-thalassemia",
      "distinguishingFeatures": [
        "Reduced or absent beta globin production rather than unstable variants",
        "Microcytic hypochromic anemia",
        "Different genetic mutations in HBB gene"
      ]
    },
    {
      "diseaseId": "hereditary-spherocytosis",
      "distinguishingFeatures": [
        "Spherocytes on peripheral smear instead of bite cells",
        "Defects in red cell membrane proteins",
        "Negative for unstable hemoglobin variants"
      ]
    },
    {
      "diseaseId": "glucose-6-phosphate-dehydrogenase-deficiency",
      "distinguishingFeatures": [
        "Enzyme deficiency causing hemolysis triggered by oxidative stress",
        "No unstable hemoglobin variants detected",
        "Episodes often acute and triggered"
      ]
    }
  ],
