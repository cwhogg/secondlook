  "diagnosticCriteria": {
    "formalCriteriaName": "No formal diagnostic criteria established",
    "criteria": [
      {
        "id": "hypergonadotropic-hypogonadism",
        "description": "Elevated gonadotropin levels (LH and FSH) with low sex steroid levels indicating primary gonadal failure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "partial-alopecia",
        "description": "Presence of partial alopecia characterized by patchy hair loss primarily affecting scalp regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "delayed-pubertal-development",
        "description": "Delayed or incomplete pubertal development including absent or sparse secondary sexual characteristics",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-karyotype",
        "description": "Normal 46,XX or 46,XY karyotype excluding chromosomal abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of hypogonadism and alopecia such as autoimmune or infectious etiologies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypergonadotropic hypogonadism, partial alopecia, and delayed pubertal development",
    "notes": "Diagnosis is clinical supported by hormonal assays and exclusion of other etiologies"
  },
