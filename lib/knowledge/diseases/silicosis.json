  "keyFindings": {
    "laboratory": [
      "Normal or mild hypoxemia on arterial blood gas",
      "Elevated inflammatory markers are uncommon"
    ],
    "imaging": [
      "Chest X-ray showing small rounded opacities predominantly in upper lobes",
      "High-resolution CT scan demonstrating nodules, conglomerate masses, and progressive massive fibrosis"
    ],
