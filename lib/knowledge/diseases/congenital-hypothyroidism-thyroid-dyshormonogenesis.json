  "diagnosticCriteria": {
    "formalCriteriaName": "Congenital Hypothyroidism Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-tsh",
        "description": "Elevated serum thyroid-stimulating hormone (TSH) levels at newborn screening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-thyroid-hormones",
        "description": "Low serum free thyroxine (FT4) and triiodothyronine (T3) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-thyroid-imaging",
        "description": "Normal or enlarged thyroid gland on ultrasound or radionuclide scan indicating dyshormonogenesis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes involved in thyroid hormone synthesis (e.g., TPO, DUOX2)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical features consistent with hypothyroidism in neonate",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated TSH and low thyroid hormone levels with normal or enlarged thyroid gland on imaging",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory for initial diagnosis."
  },
