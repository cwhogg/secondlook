  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnosis of Choanal Atresia",
    "criteria": [
      {
        "id": "bilateral-nasal-obstruction",
        "description": "Presence of bilateral nasal airway obstruction in a neonate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nasal-endoscopy",
        "description": "Visualization of bony or membranous obstruction of the posterior nasal choanae by nasal endoscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ct-scan-confirmation",
        "description": "Computed tomography (CT) scan demonstrating choanal atresia with bony or membranous obstruction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "associated-anomalies",
        "description": "Presence of associated craniofacial or syndromic anomalies (e.g., CHARGE syndrome)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Bilateral nasal airway obstruction with confirmation by nasal endoscopy and CT imaging",
    "notes": "Diagnosis is primarily clinical supported by imaging; unilateral cases may present later and less severely."
  },
