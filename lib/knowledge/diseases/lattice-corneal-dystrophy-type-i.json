  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Diagnostic Criteria for Lattice Corneal Dystrophy Type I",
    "criteria": [
      {
        "id": "clinical-lattice-opacities",
        "description": "Presence of characteristic branching refractile lattice lines in the corneal stroma observed by slit-lamp examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the TGFBI gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Amyloid deposits in corneal stroma confirmed by Congo red staining",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic lattice lines on slit-lamp examination plus either a positive family history or identification of a pathogenic TGFBI mutation",
    "notes": "Histopathological confirmation is supportive but not mandatory if clinical and genetic criteria are met."
  },
