  "keyFindings": {
    "laboratory": [
      "Iron deficiency anemia on CBC",
      "Normal coagulation profile"
    ],
    "imaging": [
      "Nasal endoscopy showing mucosal telangiectasias",
      "CT angiography for AVMs in other organs"
    ],
    "genetic": [
      "Mutations in ENG, ACVRL1, or SMAD4 genes"
    ],
    "other": [
      "Positive family history",
      "Visible telangiectasias on nasal mucosa and skin"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "idiopathic-epistaxis",
      "distinguishingFeatures": [
        "Absence of mucocutaneous telangiectasias",
        "No family history of vascular malformations",
        "No visceral AVMs"
      ]
    },
    {
      "diseaseId": "juvenile-nasopharyngeal-angioma",
      "distinguishingFeatures": [
        "Localized vascular tumor rather than diffuse telangiectasias",
        "Usually unilateral nasal obstruction",
        "No systemic involvement"
      ]
    }
  ],
  "redFlags": [
    "Severe recurrent epistaxis causing hemodynamic instability",
    "Evidence of pulmonary or cerebral arteriovenous malformations",
    "Progressive anemia refractory to iron supplementation"
  ],
