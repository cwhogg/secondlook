        "requiredForDiagnosis": true
      },
      {
        "id": "rib-abnormalities",
        "description": "Abnormal rib formation such as fused, missing, or bifurcated ribs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the DLL3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of vertebral malformations and rib abnormalities with either a positive family history or pathogenic DLL3 gene mutation",
    "notes": "Genetic testing is recommended to confirm diagnosis and differentiate from autosomal recessive forms."
  },
