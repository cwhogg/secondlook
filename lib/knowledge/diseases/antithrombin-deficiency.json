  "diagnosticCriteria": {
    "formalCriteriaName": "Antithrombin Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "low-antithrombin-activity",
        "description": "Reduced functional antithrombin activity in plasma (<70% of normal)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "personal-history-thrombosis",
        "description": "Personal history of venous thromboembolism, especially at a young age or recurrent",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history-thrombophilia",
        "description": "Family history of confirmed antithrombin deficiency or early venous thrombosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic SERPINC1 gene mutation",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Reduced antithrombin activity plus personal history of venous thrombosis or positive genetic testing",
    "notes": "Functional assays preferred; antigenic assays may be normal in type II deficiency."
  },
