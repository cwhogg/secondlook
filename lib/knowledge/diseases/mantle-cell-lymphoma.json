  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Tumors of Hematopoietic and Lymphoid Tissues",
    "criteria": [
      {
        "id": "cyclin-d1-overexpression",
        "description": "Overexpression of cyclin D1 protein detected by immunohistochemistry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "t11-14-translocation",
        "description": "Presence of t(11;14)(q13;q32) translocation detected by FISH or PCR",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "morphology",
        "description": "Morphologic features consistent with small to medium-sized lymphoid cells with irregular nuclei",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotype",
        "description": "Expression of B-cell markers CD20, CD5 positive, CD23 negative",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic morphology plus cyclin D1 overexpression or t(11;14) translocation",
    "notes": "Diagnosis requires integration of morphology, immunophenotyping, and genetic studies."
  },
