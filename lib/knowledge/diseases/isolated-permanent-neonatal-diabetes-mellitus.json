  "keyFindings": {
    "laboratory": [
      "Elevated fasting and random blood glucose levels",
      "Low or absent C-peptide levels indicating insulin deficiency",
      "Negative pancreatic autoantibodies (GAD65, IA-2)",
      "Metabolic acidosis in ketoacidosis episodes"
    ],
    "imaging": [
      "Pancreatic imaging may show hypoplasia or normal anatomy"
    ],
    "genetic": [
      "STAT3 (causative, gain-of-function)",
      "GCK (causative)",
      "KCNJ11 (causative)",
      "PDX1 (causative)",
      "INS (causative)",
      "ABCC8 (causative)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Response to sulfonylurea therapy in some mutation-positive cases"
    ]
  },
