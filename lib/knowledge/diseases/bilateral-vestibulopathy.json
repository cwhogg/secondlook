  "diagnosticCriteria": {
    "formalCriteriaName": "Barany Society Diagnostic Criteria for Bilateral Vestibulopathy",
    "criteria": [
      {
        "id": "bilateral-vestibular-loss",
        "description": "Bilateral reduced or absent vestibular function documented by caloric testing, video head impulse test (vHIT), or rotary chair testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chronic-imbalance",
        "description": "Chronic imbalance and unsteadiness worsened in darkness or on uneven ground",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oscillopsia",
        "description": "Oscillopsia during head movements",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-central-cause",
        "description": "Exclusion of central nervous system causes by clinical and imaging evaluation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral vestibular hypofunction on vestibular testing plus chronic imbalance and oscillopsia",
    "notes": "Diagnosis requires objective vestibular testing confirming bilateral loss and characteristic clinical symptoms."
  },
