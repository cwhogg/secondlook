  "keyFindings": {
    "laboratory": [
      "Pancytopenia with progressive decline in blood cell lines",
      "Low serum immunoglobulin levels (IgG, IgA, IgM)",
      "Reduced or absent circulating B lymphocytes"
    ],
    "imaging": [
      "Radiographs showing metaphyseal dysplasia and skeletal deformities",
      "Delayed bone age on hand/wrist X-rays"
    ],
    "genetic": [
      "MYSM1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Bone marrow biopsy showing hypocellularity without malignant infiltration"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "fanconi-anemia",
      "distinguishingFeatures": [
        "Presence of chromosomal breakage on diepoxybutane test",
        "Characteristic skin pigmentation abnormalities",
        "Higher risk of malignancies"
      ]
    },
    {
      "diseaseId": "dyskeratosis-congenita",
      "distinguishingFeatures": [
        "Mucocutaneous triad (nail dystrophy, leukoplakia, skin pigmentation)",
        "Telomere shortening on genetic testing",
        "Pulmonary fibrosis in later stages"
      ]
    }
  ],
