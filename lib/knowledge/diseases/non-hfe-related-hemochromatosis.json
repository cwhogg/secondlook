  "keyFindings": {
    "laboratory": [
      "Elevated serum ferritin",
      "Increased transferrin saturation (>45%)",
      "Normal or absent HFE gene mutations",
      "Elevated liver transaminases"
    ],
    "imaging": [
      "MRI showing hepatic and cardiac iron deposition",
      "Liver ultrasound indicating hepatomegaly or cirrhosis"
    ],
    "genetic": [
      "HFE (causative)",
      "BMP6 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Liver biopsy confirming iron overload and fibrosis",
      "Exclusion of secondary iron overload causes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hfe-related-hemochromatosis",
      "distinguishingFeatures": [
        "Presence of HFE gene mutations (C282Y homozygosity)",
        "Later onset typically after 40 years",
        "Less frequent severe juvenile presentations"
      ]
    },
    {
      "diseaseId": "secondary-iron-overload",
      "distinguishingFeatures": [
        "History of multiple blood transfusions",
        "Underlying chronic liver disease or hematologic disorders",
        "Absence of pathogenic non-HFE gene mutations"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression to liver cirrhosis",
    "Early onset cardiomyopathy",
    "Severe hypogonadism or endocrine failure"
  ],
