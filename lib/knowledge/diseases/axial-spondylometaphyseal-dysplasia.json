  "diagnosticCriteria": {
    "formalCriteriaName": "Axial Spondylometaphyseal Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "axial-skeletal-abnormalities",
        "description": "Presence of axial skeletal abnormalities including platyspondyly and irregular vertebral endplates",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metaphyseal-dysplasia",
        "description": "Metaphyseal irregularities and cupping predominantly affecting long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Short stature with disproportionate shortening of the trunk",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-pattern",
        "description": "Characteristic radiographic pattern involving axial skeleton and metaphyses",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the gene associated with axial SMD (e.g., TRPV4 mutations)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (axial skeletal abnormalities, metaphyseal dysplasia, and clinical features of disproportionate short stature)",
    "notes": "Genetic testing can support diagnosis but is not mandatory."
  },
