  "diagnosticCriteria": {
    "formalCriteriaName": "Congenital Pulmonary Alveolar Proteinosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Neonatal onset of respiratory distress with hypoxemia and progressive respiratory failure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bronchoalveolar-lavage",
        "description": "Bronchoalveolar lavage fluid showing milky appearance with abundant periodic acid–Schiff (PAS)-positive lipoproteinaceous material",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in surfactant metabolism genes (e.g., SFTPB, SFTPC, ABCA3)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "High-resolution CT showing diffuse ground-glass opacities with interlobular septal thickening (crazy paving pattern)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of neonatal respiratory distress with characteristic bronchoalveolar lavage findings and confirmatory genetic mutation",
    "notes": "Lung biopsy may be performed if diagnosis remains uncertain."
  },
