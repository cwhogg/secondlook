  "diagnosticCriteria": {
    "formalCriteriaName": "International Classification of Headache Disorders (ICHD-3) Criteria for Paroxysmal Hemicrania",
    "criteria": [
      {
        "id": "attack-frequency",
        "description": "At least 20 attacks of severe unilateral orbital, supraorbital and/or temporal pain lasting 2 to 30 minutes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autonomic-features",
        "description": "Ipsilateral autonomic symptoms such as conjunctival injection, lacrimation, nasal congestion, rhinorrhea, eyelid edema, forehead and facial sweating, miosis, or ptosis during attacks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "indomethacin-response",
        "description": "Complete response to therapeutic doses of indomethacin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "attack-frequency-minimum",
        "description": "Attack frequency greater than 5 per day for more than half of the time",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-disorders",
        "description": "Exclusion of other causes of headache and trigeminal autonomic cephalalgias",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "At least 20 attacks of unilateral severe orbital/supraorbital/temporal pain lasting 2-30 minutes with ipsilateral autonomic symptoms and complete response to indomethacin",
    "notes": "Diagnosis requires careful exclusion of other trigeminal autonomic cephalalgias and secondary causes."
  },
