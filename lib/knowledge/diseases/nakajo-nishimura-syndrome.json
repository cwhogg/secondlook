  "diagnosticCriteria": {
    "formalCriteriaName": "Nakajo-Nishimura Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-fever",
        "description": "Recurrent or chronic low-grade fever",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nodular-skin-lesions",
        "description": "Presence of erythematous nodular skin lesions, especially on extremities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-lipodystrophy",
        "description": "Progressive loss of subcutaneous fat (lipodystrophy) primarily affecting the face and upper body",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "psmb8-mutation",
        "description": "Identification of biallelic mutations in the PSMB8 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-inflammatory-markers",
        "description": "Elevated serum inflammatory markers such as CRP and ESR",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (chronic fever, nodular skin lesions, and progressive lipodystrophy) with or without genetic confirmation",
    "notes": "Genetic testing for PSMB8 mutations strongly supports diagnosis but is not mandatory if clinical criteria are met."
  },
