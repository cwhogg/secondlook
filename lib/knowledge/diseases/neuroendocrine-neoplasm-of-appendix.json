  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Neuroendocrine Neoplasms",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histological confirmation of neuroendocrine tumor cells in appendix tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Positive immunohistochemical staining for neuroendocrine markers such as chromogranin A and synaptophysin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tumor-grading",
        "description": "Tumor grading based on mitotic count and Ki-67 proliferation index according to WHO criteria",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Imaging evidence of appendiceal mass or metastasis via CT or MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation with positive neuroendocrine markers and tumor grading",
    "notes": "Diagnosis requires tissue biopsy; imaging supports staging and extent evaluation"
  },
