  "keyFindings": {
    "laboratory": [
      "Elevated serum VEGF-D levels",
      "Mild hypoxemia on arterial blood gas",
      "Possible mild anemia"
    ],
    "imaging": [
      "High-resolution CT showing diffuse, thin-walled lung cysts",
      "Renal ultrasound or CT showing angiomyolipomas",
      "Lymphatic abnormalities on MRI or lymphangiography"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology showing proliferation of abnormal smooth muscle-like LAM cells",
      "Immunohistochemical staining positive for HMB-45"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pulmonary-emphysema",
      "distinguishingFeatures": [
        "Older age group",
        "History of smoking",
        "Absence of cystic lung lesions typical of LAM"
      ]
    },
    {
      "diseaseId": "pulmonary-langerhans-cell-histiocytosis",
      "distinguishingFeatures": [
        "Predominantly affects young adult smokers",
        "Nodular and cystic lung lesions with upper lobe predominance",
        "Presence of Langerhans cells on biopsy"
      ]
    },
    {
      "diseaseId": "lymphocytic-interstitial-pneumonia",
      "distinguishingFeatures": [
        "Associated with autoimmune diseases",
        "Diffuse ground-glass opacities rather than cysts",
        "Lymphocytic infiltration on biopsy"
      ]
    }
  ],
  "redFlags": [
    "Recurrent spontaneous pneumothorax",
    "Rapidly progressive dyspnea and hypoxemia",
    "Development of chylous pleural effusions"
  ],
