  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for SCA31",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with gait disturbance and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Presence of expanded TGGAA repeat insertion in the BEAN/TK2 gene region",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected family members",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cerebellar-atrophy-imaging",
        "description": "MRI evidence of cerebellar cortical atrophy predominantly in the vermis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia plus genetic confirmation of TGGAA repeat expansion",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical presentation may overlap with other SCAs."
  },
