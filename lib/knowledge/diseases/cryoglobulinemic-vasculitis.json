        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cv-4",
        "description": "Membranoproliferative glomerulonephritis on biopsy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cv-5",
        "description": "Peripheral neuropathy (sensorimotor)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cv-6",
        "description": "Skin ulcers",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cv-7",
        "description": "Positive rheumatoid factor",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cv-8",
        "description": "Hepatitis C virus infection",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Positive serum cryoglobulins plus clinical evidence of vasculitis (purpura, nephritis, neuropathy, or skin ulcers)",
    "notes": "Type I is monoclonal (associated with lymphoproliferative disorders). Types II and III (mixed) are most commonly associated with HCV infection. Type II has both monoclonal and polyclonal components."
  },
