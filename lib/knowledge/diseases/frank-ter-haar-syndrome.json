  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Frank-Ter Haar Syndrome",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial features including brachycephaly, hypertelorism, and prominent forehead",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Generalized skeletal dysplasia with brachydactyly, wide tubular bones, and joint contractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-malformations",
        "description": "Congenital heart defects such as patent ductus arteriosus, mitral valve prolapse, or septal defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-features",
        "description": "Presence of prominent corneal arcus or megalocornea",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the SH3PXD2B gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (craniofacial dysmorphism, skeletal abnormalities, and cardiac malformations) or genetic confirmation with compatible clinical features",
    "notes": "Genetic testing for SH3PXD2B mutations is confirmatory but not always available; diagnosis is primarily clinical."
  },
