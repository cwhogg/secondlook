        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serum-potassium-abnormalities",
        "description": "Documented hypo- or hyperkalemia during paralytic attacks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of similar episodic paralysis consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in CACNA1S, SCN4A, or KCNJ2 genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "Electrophysiological evidence of muscle membrane excitability abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent episodic flaccid paralysis with documented potassium abnormalities and positive family history; genetic confirmation supports diagnosis",
    "notes": "Genetic testing is recommended but not mandatory for diagnosis."
  },
