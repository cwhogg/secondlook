  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible electrolyte imbalances due to vomiting",
      "No specific serum biomarkers identified"
    ],
    "imaging": [
      "Abdominal X-ray or CT showing dilated bowel loops without mechanical obstruction",
      "Contrast studies demonstrating delayed intestinal transit"
    ],
    "genetic": [
      "ACTG2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology of visceral muscle showing smooth muscle degeneration, fibrosis, and vacuolization"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "chronic-intestinal-pseudo-obstruction",
      "distinguishingFeatures": [
        "May be sporadic or secondary to other systemic diseases",
        "Lacks familial inheritance pattern in many cases",
        "Histopathology may show neuropathic rather than myopathic changes"
      ]
    },
    {
      "diseaseId": "hirschsprung-disease",
      "distinguishingFeatures": [
        "Congenital absence of enteric ganglion cells",
        "Usually presents in neonates or infants",
        "Histology shows aganglionosis rather than smooth muscle degeneration"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of gastrointestinal dysmotility with signs of bowel ischemia",
    "Severe abdominal distension with signs of perforation",
    "Recurrent urinary retention with renal impairment"
  ],
