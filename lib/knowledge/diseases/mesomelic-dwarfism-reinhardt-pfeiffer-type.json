  "diagnosticCriteria": {
    "formalCriteriaName": "Reinhardt-Pfeiffer Diagnostic Criteria for Mesomelic Dwarfism",
    "criteria": [
      {
        "id": "mesomelic-shortening",
        "description": "Mesomelic shortening of the limbs predominantly affecting the forearms and lower legs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-bowing",
        "description": "Radiological evidence of bowing and shortening of the radius and ulna with hypoplastic or absent ulna",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia and prominent forehead",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development and intelligence",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of mesomelic limb shortening with characteristic radiological findings",
    "notes": "Diagnosis is primarily clinical supported by radiographic imaging; genetic testing may assist but is not always available."
  },
