  "keyFindings": {
    "laboratory": [
      "Elevated brain natriuretic peptide (BNP) levels",
      "Mild anemia on complete blood count",
      "Possible hypothyroidism on thyroid function tests"
    ],
    "imaging": [
      "Echocardiography showing dilated or hypertrophic cardiomyopathy",
      "Brain MRI demonstrating reduced brain volume consistent with microcephaly",
      "Abdominal ultrasound may reveal hepatomegaly or renal anomalies"
    ],
    "genetic": [
      "Pathogenic variants in PRDM16 gene or other genes implicated in combined microcephaly and cardiomyopathy",
      "Autosomal recessive or dominant inheritance patterns reported"
    ],
    "other": [
      "Electrocardiogram abnormalities including arrhythmias",
      "Developmental assessment confirming global developmental delay"
    ]
  },
