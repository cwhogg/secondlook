        "description": "Pain triggered by swallowing, coughing, talking, or yawning",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pain-duration",
        "description": "Pain lasting from a few seconds up to 2 minutes per episode",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes such as tumors or infections by imaging",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "All major criteria must be met with exclusion of other causes",
    "notes": "Diagnosis is clinical but supported by imaging to exclude secondary causes"
