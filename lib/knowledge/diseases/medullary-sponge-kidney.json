  "diagnosticCriteria": {
    "formalCriteriaName": "Radiologic Diagnostic Criteria for Medullary Sponge Kidney",
    "criteria": [
      {
        "id": "cystic-dilatation",
        "description": "Presence of cystic dilatation of the medullary and papillary collecting ducts on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nephrocalcinosis",
        "description": "Evidence of nephrocalcinosis or medullary nephrolithiasis on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-tract-infections",
        "description": "Recurrent urinary tract infections associated with the cystic changes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hematuria",
        "description": "Microscopic or gross hematuria",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of cystic dilatation of collecting ducts plus nephrocalcinosis or medullary nephrolithiasis on imaging",
    "notes": "Diagnosis is primarily radiologic; genetic testing is not routinely performed."
  },
