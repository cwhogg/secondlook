  "diagnosticCriteria": {
    "formalCriteriaName": "Severe Congenital Neutropenia Diagnostic Criteria",
    "criteria": [
      {
        "id": "profound-neutropenia",
        "description": "Absolute neutrophil count (ANC) consistently below 500 cells/µL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset-bacterial-infections",
        "description": "Recurrent severe bacterial infections starting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-maturation-arrest",
        "description": "Bone marrow examination showing maturation arrest at the promyelocyte/myelocyte stage",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in ELANE or related genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of profound neutropenia (ANC <500/µL), recurrent severe bacterial infections from infancy, and bone marrow maturation arrest",
    "notes": "Genetic testing supports diagnosis but is not mandatory"
  },
