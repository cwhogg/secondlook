  "diagnosticCriteria": {
    "formalCriteriaName": "Methylmalonic Acidemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-methylmalonic-acid",
        "description": "Markedly elevated methylmalonic acid levels in plasma and urine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mut0-enzyme-activity",
        "description": "Complete or near-complete deficiency of methylmalonyl-CoA mutase enzyme activity in fibroblasts or liver tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic MUT gene mutations consistent with Mut0 phenotype",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Early onset metabolic crises with acidosis, hyperammonemia, and failure to thrive",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated methylmalonic acid plus either confirmed Mut0 enzyme deficiency or biallelic MUT gene mutations",
    "notes": "Diagnosis is confirmed by biochemical and genetic testing; clinical presentation supports diagnosis."
  },
