  "keyFindings": {
    "laboratory": [
      "Hypoproteinemia and hypoalbuminemia",
      "Anemia (often iron deficiency or anemia of chronic disease)",
      "Electrolyte imbalances including hypocalcemia"
    ],
    "imaging": [
      "Endoscopic visualization of diffuse GI polyposis predominantly in stomach, small intestine, and colon",
      "Radiologic studies may show thickened bowel walls"
    ],
    "genetic": [
      "No known genetic mutations; considered nonhereditary"
    ],
    "other": [
      "Histopathology of polyps shows hamartomatous features with cystic gland dilation and inflammatory infiltrates"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "juvenile-polyposis-syndrome",
      "distinguishingFeatures": [
        "Hereditary pattern",
        "Polyps predominantly juvenile type",
        "Lack of ectodermal abnormalities"
      ]
    },
    {
      "diseaseId": "peutz-jeghers-syndrome",
      "distinguishingFeatures": [
        "Mucocutaneous pigmentation (perioral, buccal mucosa)",
        "Autosomal dominant inheritance",
        "Distinctive hamartomatous polyps with arborizing smooth muscle"
      ]
    },
    {
      "diseaseId": "familial-adenomatous-polyposis",
      "distinguishingFeatures": [
        "Numerous adenomatous polyps",
        "High risk of colorectal cancer",
        "Genetic mutation in APC gene"
      ]
    }
  ],
  "redFlags": [
    "Severe protein-losing enteropathy leading to edema and malnutrition",
    "Rapid weight loss with chronic diarrhea",
    "Signs of gastrointestinal bleeding or anemia"
  ],
