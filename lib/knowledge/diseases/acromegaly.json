  "diagnosticCriteria": {
    "formalCriteriaName": "Endocrine Society Clinical Practice Guidelines for Acromegaly",
    "criteria": [
      {
        "id": "acro-c1",
        "description": "Elevated serum insulin-like growth factor 1 (IGF-1) above age- and sex-adjusted normal range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acro-c2",
        "description": "Failure of GH suppression to <1 ng/mL (or <0.4 ng/mL with sensitive assay) during 75g oral glucose tolerance test (OGTT)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acro-c3",
        "description": "Pituitary adenoma identified on MRI",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "acro-c4",
        "description": "Characteristic clinical features (acral enlargement, coarsened facial features, soft tissue swelling)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "acro-c5",
        "description": "Random GH >1 ng/mL (screening, not diagnostic alone)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated IGF-1 plus failure of GH suppression on OGTT. If IGF-1 elevated and clinical features obvious, OGTT may be omitted in some guidelines.",
    "notes": "Average diagnostic delay is 7-10 years from symptom onset. Over 95% of cases are caused by a GH-secreting pituitary adenoma (somatotropinoma)."
  },
