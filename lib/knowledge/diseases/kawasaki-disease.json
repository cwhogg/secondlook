  "diagnosticCriteria": {
    "formalCriteriaName": "American Heart Association Diagnostic Criteria for Kawasaki Disease",
    "criteria": [
      {
        "id": "fever",
        "description": "Fever persisting for at least 5 days",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "conjunctivitis",
        "description": "Bilateral non-exudative conjunctival injection",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "oral-mucosal-changes",
        "description": "Changes in lips and oral cavity such as cracked lips, strawberry tongue, and erythema",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "rash",
        "description": "Polymorphous rash",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "extremity-changes",
        "description": "Erythema and edema of hands and feet, later desquamation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cervical-lymphadenopathy",
        "description": "Cervical lymph node enlargement >1.5 cm diameter",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Fever for at least 5 days plus at least 4 of the 5 principal clinical features",
    "notes": "Incomplete Kawasaki disease may be diagnosed with fewer criteria supported by laboratory and echocardiographic findings."
  },
