  "keyFindings": {
    "laboratory": [
      "Elevated serum creatinine in progressive disease",
      "Microscopic hematuria with dysmorphic red blood cells",
      "Subnephrotic proteinuria",
      "Mesangial IgA deposits on immunofluorescence"
    ],
    "imaging": [
      "Renal ultrasound typically normal or shows mild renal enlargement",
      "Occasional findings of renal scarring in advanced disease"
    ],
    "genetic": [
      "Polymorphisms in genes related to immune regulation (e.g., HLA-DQ, CFHR1-3 deletions) associated with susceptibility"
    ],
    "other": [
      "Renal biopsy demonstrating mesangial proliferation and IgA deposition is diagnostic"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "thin-basement-membrane-nephropathy",
      "distinguishingFeatures": [
        "Persistent microscopic hematuria without significant proteinuria",
        "Normal renal function",
        "Absence of mesangial IgA deposits on biopsy"
      ]
    },
    {
      "diseaseId": "alport-syndrome",
      "distinguishingFeatures": [
        "Family history of progressive renal failure and hearing loss",
        "Basement membrane abnormalities on electron microscopy",
        "No predominant IgA deposits"
      ]
    },
    {
      "diseaseId": "henoch-schonlein-purpura-nephritis",
      "distinguishingFeatures": [
        "Systemic vasculitis with palpable purpura",
        "IgA deposition but with systemic symptoms",
        "More common in children"
      ]
    }
  ],
  "redFlags": [
