  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological diagnosis of gangliocytoma",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of large, mature ganglion cells with abnormal clustering on histopathological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "MRI or CT showing well-circumscribed, non-enhancing or mildly enhancing mass typically in the temporal lobe or hypothalamic region",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Neurological symptoms consistent with tumor location such as seizures or focal neurological deficits",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of ganglion cells with compatible imaging findings",
    "notes": "Diagnosis requires tissue biopsy; imaging and clinical features support but are not definitive alone."
  },
