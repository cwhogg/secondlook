      "Isolated decreased complex II enzyme activity in muscle or fibroblast assays"
    ],
    "imaging": [
      "Brain MRI showing cerebral atrophy and basal ganglia abnormalities",
      "Cardiac echocardiography indicating cardiomyopathy in some cases"
    ],
    "genetic": [
      "SDHA (causative)",
      "SDHB (causative)",
      "SDHD (causative, loss-of-function)",
      "SDHAF1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy demonstrating mitochondrial abnormalities such as ragged-red fibers"
    ]
  },
