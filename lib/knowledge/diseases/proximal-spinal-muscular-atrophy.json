  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Spinal Muscular Atrophy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Symmetric proximal muscle weakness and atrophy with onset in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Electromyographic evidence of denervation and chronic reinnervation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Homozygous deletion or mutation of SMN1 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-deep-tendon-reflexes",
        "description": "Absent or markedly reduced deep tendon reflexes in affected limbs",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-sensory-exam",
        "description": "Preserved sensory function on neurological examination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical presentation plus confirmatory genetic testing or electromyography findings",
    "notes": "Genetic testing is considered the gold standard for diagnosis."
  },
