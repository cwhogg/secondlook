  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnostic criteria for Donnai-Barrow syndrome",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism, broad nasal bridge, and prominent forehead",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "High myopia, congenital diaphragmatic hernia, or other ocular malformations",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "proteinuria",
        "description": "Low molecular weight proteinuria indicating renal tubular dysfunction",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "LRP2-gene-mutation",
        "description": "Pathogenic variants in the LRP2 gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic facial dysmorphism, sensorineural hearing loss, and pathogenic LRP2 mutation",
    "notes": "Diagnosis is confirmed by genetic testing; clinical features may vary in severity."
  },
