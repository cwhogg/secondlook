  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests unless secondary complications",
      "Possible hypothyroidism markers in rare cases"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter changes",
      "Echocardiogram revealing congenital heart defects",
      "Renal ultrasound showing hypoplastic or dysplastic kidneys",
      "Ophthalmologic imaging demonstrating anterior segment anomalies"
    ],
    "genetic": [
      "Terminal deletion of chromosome 6p25 region confirmed by chromosomal microarray or FISH",
      "Deletion size variable but typically involves distal 6p"
    ],
    "other": [
      "Audiological testing confirming sensorineural hearing loss",
      "Developmental assessments documenting delay"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "wolf-hirschhorn-syndrome",
      "distinguishingFeatures": [
        "Deletion on chromosome 4p rather than 6p",
        "Distinctive 'Greek warrior helmet' facial appearance",
        "More severe growth retardation"
      ]
    },
    {
      "diseaseId": "pfeiffer-syndrome",
      "distinguishingFeatures": [
        "Craniosynostosis with broad thumbs and toes",
        "FGFR gene mutations rather than chromosomal deletion",
        "Midface hypoplasia without distal 6p deletion"
      ]
    }
  ],
  "redFlags": [
    "Severe congenital heart defects requiring urgent intervention",
    "Progressive visual impairment due to anterior segment dysgenesis",
    "Significant developmental delay impacting feeding and respiratory function"
  ],
