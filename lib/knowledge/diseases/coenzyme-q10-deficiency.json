  "keyFindings": {
    "laboratory": [
      "Low Coenzyme Q10 levels in muscle biopsy or cultured fibroblasts",
      "Elevated serum creatine kinase (CK) in some cases",
      "Proteinuria consistent with nephrotic syndrome"
    ],
    "imaging": [
      "Brain MRI may show cerebral atrophy or leukoencephalopathy",
      "Muscle MRI may reveal fatty infiltration"
    ],
    "genetic": [
      "Pathogenic variants in COQ2, PDSS1, PDSS2, COQ9, or other CoQ10 biosynthesis genes"
    ],
    "other": [
      "Improvement of symptoms after CoQ10 supplementation"
    ]
  },
