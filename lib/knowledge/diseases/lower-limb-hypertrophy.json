  "diagnosticCriteria": {
    "formalCriteriaName": "Lower Limb Hypertrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "limb-size-discrepancy",
        "description": "Clinically measurable increase in circumference or volume of one or both lower limbs compared to contralateral side or normative data",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-confirmation",
        "description": "Imaging evidence (MRI or ultrasound) demonstrating hypertrophy of muscle, subcutaneous tissue, or bone in the affected lower limb(s)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of limb enlargement such as vascular malformations, tumors, or lymphedema",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-history",
        "description": "History of progressive or congenital limb enlargement without systemic involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of measurable limb hypertrophy confirmed by imaging with exclusion of other causes",
    "notes": "Diagnosis is primarily clinical supported by imaging; genetic testing may be considered if syndromic features present"
  },
