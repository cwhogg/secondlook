        "More frequent palatal abnormalities and immune deficiency"
      ]
    },
    {
      "diseaseId": "cri-du-chat-syndrome",
      "distinguishingFeatures": [
        "Deletion on chromosome 5p",
        "Distinctive high-pitched cat-like cry in infancy",
        "Microcephaly and severe intellectual disability"
      ]
    }
  ],
