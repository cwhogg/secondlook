  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Macrocephaly-Intellectual Disability-Left Ventricular Non-Compaction Syndrome",
    "criteria": [
      {
        "id": "macrocephaly",
        "description": "Head circumference > 2 standard deviations above the mean for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability confirmed by standardized cognitive testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lvnc",
        "description": "Echocardiographic or cardiac MRI evidence of left ventricular non-compaction cardiomyopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Presence of subtle facial dysmorphic features such as broad forehead or hypertelorism",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of similar phenotype or cardiomyopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: macrocephaly, intellectual disability, and left ventricular non-compaction",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
