  "diagnosticCriteria": {
    "formalCriteriaName": "ROHHAD Diagnostic Criteria",
    "criteria": [
      {
        "id": "rapid-onset-obesity",
        "description": "Rapid-onset obesity typically occurring between ages 1.5 and 7 years",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypothalamic-dysfunction",
        "description": "Evidence of hypothalamic dysfunction including endocrine abnormalities such as central hypothyroidism, hyperprolactinemia, or growth hormone deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypoventilation",
        "description": "Central hypoventilation manifesting as alveolar hypoventilation, especially during sleep",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autonomic-dysregulation",
        "description": "Signs of autonomic nervous system dysregulation including temperature instability, altered pain perception, and abnormal pupillary responses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other genetic or acquired causes of obesity, hypoventilation, and hypothalamic dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of rapid-onset obesity plus hypothalamic dysfunction, central hypoventilation, and autonomic dysregulation after exclusion of other causes",
    "notes": "Diagnosis is clinical; genetic testing currently does not identify causative mutations."
  },
