  "diagnosticCriteria": {
    "formalCriteriaName": "Endocrine Society Guidelines for Pituitary Tumors",
    "criteria": [
      {
        "id": "imaging",
        "description": "Presence of pituitary mass on MRI without evidence of hormone hypersecretion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hormonal-assessment",
        "description": "Normal or low pituitary hormone secretion with no clinical signs of hormone excess",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological confirmation of adenoma with negative immunohistochemical staining for pituitary hormones",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Radiological evidence of pituitary adenoma without clinical or biochemical evidence of hormone hypersecretion",
    "notes": "Diagnosis often requires exclusion of functioning pituitary adenomas and other sellar masses."
  },
