  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild elevation of alkaline phosphatase"
    ],
    "imaging": [
      "Radiographs showing diffuse osteosclerosis",
      "CT or MRI confirming craniosynostosis",
      "Brain imaging may show hydrocephalus"
    ],
    "genetic": [
      "LRP5 (causative, gain-of-function)",
      "No specific gene identified; suspected autosomal recessive inheritance",
      "Autosomal dominant inheritance"
    ],
