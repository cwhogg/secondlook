  "diagnosticCriteria": {
    "formalCriteriaName": "Night Blindness-Skeletal Anomalies-Dysmorphism Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "night-blindness",
        "description": "Congenital or early-onset night blindness confirmed by ophthalmological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-anomalies",
        "description": "Presence of multiple skeletal anomalies including short stature, brachydactyly, and vertebral abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic craniofacial dysmorphic features such as midface hypoplasia, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroretinography",
        "description": "Electroretinography showing rod photoreceptor dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consistent family history suggestive of autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: congenital night blindness, skeletal anomalies, and characteristic facial dysmorphism",
    "notes": "Genetic testing may support diagnosis but is not mandatory."
  },
