  "diagnosticCriteria": {
    "formalCriteriaName": "Hyper-IgM Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-igm",
        "description": "Elevated serum IgM levels with low or absent IgG, IgA, and IgE",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aid-gene-mutation",
        "description": "Identification of biallelic pathogenic mutations in the AID (AICDA) gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-class-switching",
        "description": "Demonstration of defective immunoglobulin class switch recombination in B cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-infections",
        "description": "History of recurrent bacterial infections, especially respiratory and gastrointestinal",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-tcell-function",
        "description": "Normal T-cell numbers and function",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated IgM with low IgG/IgA, confirmed AID gene mutation, and impaired class switch recombination",
    "notes": "Genetic testing is essential for definitive diagnosis."
  },
