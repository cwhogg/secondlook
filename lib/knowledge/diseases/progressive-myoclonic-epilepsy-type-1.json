  "diagnosticCriteria": {
    "formalCriteriaName": "Unverricht-Lundborg Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-myoclonus",
        "description": "Presence of stimulus-sensitive, action myoclonus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "generalized-tonic-clonic-seizures",
        "description": "Generalized tonic-clonic seizures typically beginning in adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cystatin-b-gene-mutation",
        "description": "Identification of pathogenic mutations in the CSTB gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-brain-imaging",
        "description": "Normal brain MRI or mild cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "eeg-findings",
        "description": "EEG showing generalized spike-wave and polyspike-wave discharges",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical myoclonus and generalized tonic-clonic seizures with confirmed CSTB gene mutation",
    "notes": "Diagnosis is supported by typical EEG findings and exclusion of other causes."
  },
