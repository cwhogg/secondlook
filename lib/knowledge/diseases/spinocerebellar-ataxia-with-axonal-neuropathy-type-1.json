    "laboratory": [
      "Nerve conduction studies showing reduced amplitude of sensory and motor action potentials consistent with axonal neuropathy",
      "Normal routine blood tests excluding metabolic causes"
    ],
    "imaging": [
      "MRI brain demonstrating cerebellar atrophy predominantly involving the vermis and hemispheres"
    ],
    "genetic": [
      "TDP1 (causative)",
      "Pathogenic mutation in the gene associated with SCAAN1 (specific gene currently under research but linked to autosomal dominant inheritance)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography confirming chronic denervation and reinnervation patterns",
      "Family pedigree analysis consistent with autosomal dominant transmission"
    ]
  },
