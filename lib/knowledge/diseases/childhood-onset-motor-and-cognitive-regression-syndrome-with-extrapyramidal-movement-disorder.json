  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Criteria for Childhood-onset Motor and Cognitive Regression Syndrome with Extrapyramidal Movement Disorder",
    "criteria": [
      {
        "id": "motor-regression",
        "description": "Progressive loss of previously acquired motor milestones during early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cognitive-decline",
        "description": "Documented cognitive regression or developmental plateau followed by decline",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "extrapyramidal-movement-disorder",
        "description": "Presence of extrapyramidal signs including dystonia, rigidity, or choreoathetosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging-abnormalities",
        "description": "MRI showing basal ganglia abnormalities or cerebral atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in associated genes if available",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (motor regression, cognitive decline, and extrapyramidal movement disorder) must be present.",
    "notes": "Diagnosis is clinical and supported by neuroimaging and genetic testing when available."
  },
