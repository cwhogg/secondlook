  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Congenital Myasthenic Syndromes",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of fatigable muscle weakness from birth or early infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Abnormal neuromuscular transmission demonstrated by decremental response on repetitive nerve stimulation or single-fiber EMG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in known CMS-associated genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-treatment",
        "description": "Improvement of symptoms with acetylcholinesterase inhibitors or other targeted therapies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-autoimmune-myasthenia",
        "description": "Negative acetylcholine receptor and MuSK antibodies to exclude autoimmune myasthenia gravis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical fatigable weakness plus electrophysiological evidence of neuromuscular transmission defect and/or pathogenic genetic variant",
    "notes": "Genetic confirmation is increasingly considered essential for definitive diagnosis."
  },
