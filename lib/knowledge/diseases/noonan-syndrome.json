  "keyFindings": {
    "laboratory": [
      "Coagulation studies may show Factor XI deficiency or partial thromboplastin time prolongation",
      "Platelet function studies may be abnormal",
      "Growth hormone levels usually normal (GH insensitivity in some)",
      "IGF-1 may be low despite normal GH"
    ],
    "imaging": [
      "Echocardiography showing pulmonary valve stenosis or hypertrophic cardiomyopathy",
      "Renal ultrasound for structural anomalies",
      "Skeletal radiographs may show pectus deformity, scoliosis"
    ],
    "genetic": [
      "RRAS (candidate)",
      "MRAS (causative)",
      "SPRED2 (causative)",
      "RRAS2 (causative)",
      "PTPN11 (causative)",
      "CBL (causative)",
      "SOS1 (causative, gain-of-function)",
      "KRAS (causative)",
      "RAF1 (causative, gain-of-function)",
      "NRAS (causative)",
      "RIT1 (causative, gain-of-function)",
      "LZTR1 (causative)",
      "RASA2 (causative, loss-of-function)",
      "SOS2 (causative)",
      "BRAF (causative)",
      "Autosomal dominant inheritance; ~50-70% de novo",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Clinical scoring by van der Burgt criteria",
      "Developmental assessment in childhood",
      "Audiometry screening"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "turner-syndrome",
      "distinguishingFeatures": [
        "Turner syndrome only affects females",
        "45,X or variant karyotype",
        "Ovarian failure rather than testicular issues",
        "Left-sided heart defects (coarctation, bicuspid aortic valve)"
      ]
    },
    {
      "diseaseId": "cardiofaciocutaneous-syndrome",
      "distinguishingFeatures": [
        "CFC syndrome has more severe intellectual disability",
        "Sparse, curly hair and absent eyebrows",
        "BRAF, MAP2K1, MAP2K2, KRAS mutations",
        "Ichthyosis or keratosis pilaris"
      ]
    },
    {
      "diseaseId": "costello-syndrome",
      "distinguishingFeatures": [
        "HRAS mutations",
        "More severe intellectual disability",
        "Papillomata around nose and mouth",
        "Higher malignancy risk (rhabdomyosarcoma, neuroblastoma)"
      ]
    },
    {
      "diseaseId": "fetal-alcohol-syndrome",
      "distinguishingFeatures": [
        "History of prenatal alcohol exposure",
        "Smooth philtrum, thin upper lip, short palpebral fissures",
        "Different cardiac defects pattern",
        "No genetic mutation"
      ]
    }
  ],
  "redFlags": [
    "Hypertrophic cardiomyopathy with outflow tract obstruction",
    "Development of JMML or other myeloproliferative disorder",
    "Chylothorax or severe lymphatic dysfunction in neonates",
    "Significant bleeding during surgical procedures",
    "Severe feeding difficulties with failure to thrive in infancy"
  ],
