  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for CPT II Deficiency",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Recurrent episodes of rhabdomyolysis triggered by prolonged exercise, fasting, or illness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-assay",
        "description": "Reduced CPT II enzyme activity in muscle biopsy or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the CPT2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-creatine-kinase",
        "description": "Elevated serum creatine kinase (CK) during episodes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "acylcarnitine-profile",
        "description": "Abnormal acylcarnitine profile showing elevated long-chain acylcarnitines",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus either reduced enzyme activity or pathogenic CPT2 gene variants",
    "notes": "Diagnosis is confirmed by genetic testing and/or enzyme assay combined with clinical features."
  },
