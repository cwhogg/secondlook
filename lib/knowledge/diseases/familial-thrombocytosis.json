  "keyFindings": {
    "laboratory": [
      "Persistent platelet count >450 x10^9/L",
      "Normal or elevated megakaryocytes on bone marrow biopsy",
      "Normal inflammatory markers excluding reactive causes"
    ],
    "imaging": [
      "Ultrasound showing mild splenomegaly",
      "Doppler studies to exclude thrombosis if clinically indicated"
    ],
    "genetic": [
      "THPO (causative, gain-of-function)",
      "JAK2 (causative, gain-of-function)",
      "MPL (causative)",
      "Autosomal dominant inheritance",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Family pedigree analysis showing autosomal dominant inheritance"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "essential-thrombocythemia",
      "distinguishingFeatures": [
        "Somatic mutations (JAK2, CALR, MPL) rather than germline",
        "Older age at onset",
        "Potential progression to myelofibrosis or leukemia"
      ]
    },
    {
      "diseaseId": "reactive-thrombocytosis",
      "distinguishingFeatures": [
        "Secondary to infection, inflammation, iron deficiency, or malignancy",
        "Platelet count normalizes after treating underlying cause",
        "No family history"
      ]
    }
  ],
  "redFlags": [
    "Sudden onset of thrombotic events",
