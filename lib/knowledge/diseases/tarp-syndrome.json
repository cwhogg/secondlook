        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "robin-sequence",
        "description": "Robin sequence characterized by micrognathia, glossoptosis, and cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "persistent-left-superior-vena-cava",
        "description": "Presence of persistent left superior vena cava on imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in RBM10 gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of talipes equinovarus, atrial septal defect, and Robin sequence features; genetic confirmation supports diagnosis",
