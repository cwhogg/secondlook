  "diagnosticCriteria": {
    "formalCriteriaName": "Rabson-Mendenhall syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "severe-insulin-resistance",
        "description": "Severe insulin resistance with hyperinsulinemia despite normal or elevated insulin levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facies",
        "description": "Coarse facial features including prognathism, large ears, and dental abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acanthosis-nigricans",
        "description": "Presence of acanthosis nigricans in flexural areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-abnormalities",
        "description": "Dental abnormalities such as premature tooth eruption and dysplastic teeth",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic mutations in the INSR gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of severe insulin resistance with characteristic facies and acanthosis nigricans plus genetic confirmation of INSR mutations",
    "notes": "Diagnosis is supported by clinical features and confirmed by molecular genetic testing."
  },
