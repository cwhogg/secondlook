  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed diagnostic criteria for ATLD",
    "criteria": [
      {
        "id": "ataxia",
        "description": "Progressive cerebellar ataxia manifesting in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "telangiectasia-absence",
        "description": "Absence of oculocutaneous telangiectasia differentiating from classical ataxia-telangiectasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dna-repair-defect",
        "description": "Cellular radiosensitivity and defective DNA double-strand break repair",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "atm-gene-negative",
        "description": "No pathogenic variants in ATM gene (differentiates from ataxia-telangiectasia)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mre11-mutation",
        "description": "Biallelic pathogenic variants in MRE11 gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia, absence of telangiectasia, cellular radiosensitivity, and biallelic MRE11 mutations",
    "notes": "Diagnosis requires exclusion of classical ataxia-telangiectasia and confirmation by genetic testing."
  },
