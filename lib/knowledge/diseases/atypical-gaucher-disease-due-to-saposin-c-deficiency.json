  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Atypical Gaucher Disease due to Saposin C Deficiency",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of deficient glucocerebrosidase activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "psap-mutation",
        "description": "Identification of pathogenic mutations in the PSAP gene encoding saposin C",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical features consistent with Gaucher disease but atypical phenotype including neurological involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Bone marrow or tissue biopsy showing Gaucher cells with characteristic lipid-laden macrophages",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-findings",
        "description": "MRI or CT evidence of hepatosplenomegaly or bone marrow infiltration",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of deficient glucocerebrosidase activity, pathogenic PSAP gene mutations, and compatible clinical features",
    "notes": "Diagnosis requires exclusion of classic GBA gene mutations causing Gaucher disease."
  },
