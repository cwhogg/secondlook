  "differentialDiagnoses": [
    {
      "diseaseId": "fanconi-anemia",
      "distinguishingFeatures": [
        "Pancytopenia rather than isolated red cell aplasia",
        "Chromosomal breakage test positive",
        "More prominent congenital anomalies including skin pigmentation"
      ]
    },
    {
      "diseaseId": "transient-erythroblastopenia-of-childhood",
      "distinguishingFeatures": [
        "Acquired and transient anemia",
        "No congenital anomalies",
        "Normal erythrocyte adenosine deaminase activity"
      ]
    }
  ],
