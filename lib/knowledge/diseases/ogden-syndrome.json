  "diagnosticCriteria": {
    "formalCriteriaName": "NAA10-related Ogden syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "pathogenic-naa10-variant",
        "description": "Presence of a pathogenic variant in the NAA10 gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-dysmorphism",
        "description": "Characteristic craniofacial features including prominent forehead, large anterior fontanelle, and downslanting palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-developmental-delay",
        "description": "Profound global developmental delay and intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-anomalies",
        "description": "Congenital cardiac defects such as arrhythmias or structural heart disease",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "failure-to-thrive",
        "description": "Severe failure to thrive in infancy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic NAA10 variant plus presence of characteristic facial dysmorphism and severe developmental delay",
    "notes": "Diagnosis is confirmed by molecular genetic testing; clinical features support diagnosis."
  },
