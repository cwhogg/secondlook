  "diagnosticCriteria": {
    "formalCriteriaName": "HLRCC Diagnostic Criteria",
    "criteria": [
      {
        "id": "cutaneous-leiomyomas",
        "description": "Presence of multiple cutaneous piloleiomyomas confirmed by histopathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-cell-carcinoma",
        "description": "Diagnosis of type 2 papillary renal cell carcinoma or other aggressive renal cell carcinoma subtype",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fh-gene-mutation",
        "description": "Identification of pathogenic germline mutation in FH gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "uterine-leiomyomas",
        "description": "Early onset multiple uterine leiomyomas in females",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic FH gene mutation or both multiple cutaneous leiomyomas and renal cell carcinoma",
    "notes": "Genetic testing for FH mutations is confirmatory; histopathological confirmation of skin lesions is recommended."
  },
