  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Coagulation studies typically normal despite easy bruising"
    ],
    "imaging": [
      "Echocardiogram may show mild mitral valve prolapse or aortic root dilation",
      "Musculoskeletal imaging may reveal joint laxity without structural damage"
    ],
    "genetic": [
      "TNXB (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy showing decreased or absent tenascin-X protein",
      "Clinical assessment using Beighton score for joint hypermobility"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "classical-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Presence of COL5A1 or COL5A2 mutations",
        "More prominent atrophic scarring and skin fragility",
        "Higher frequency of joint dislocations"
      ]
    },
    {
      "diseaseId": "vascular-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Arterial rupture and severe vascular complications",
        "Mutations in COL3A1 gene",
        "Thin translucent skin with visible veins"
      ]
    }
  ],
  "redFlags": [
    "Spontaneous arterial rupture or aneurysm",
    "Severe joint dislocations causing functional impairment",
    "Progressive aortic root dilation"
  ],
