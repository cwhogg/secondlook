  "diagnosticCriteria": {
    "formalCriteriaName": "Achromatopsia Diagnostic Criteria",
    "criteria": [
      {
        "id": "complete-color-blindness",
        "description": "Congenital absence of color discrimination confirmed by color vision testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "photophobia",
        "description": "Marked light sensitivity causing discomfort in bright environments",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "reduced-visual-acuity",
        "description": "Reduced central visual acuity typically ranging from 20/60 to 20/200",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nystagmus",
        "description": "Presence of involuntary eye movements (nystagmus)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electroretinogram-findings",
        "description": "Absent or severely reduced cone responses on electroretinography",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of congenital complete color blindness, photophobia, reduced visual acuity, and characteristic electroretinogram findings",
    "notes": "Genetic testing for mutations in CNGA3, CNGB3, GNAT2, PDE6C, or PDE6H genes can support diagnosis"
  },
