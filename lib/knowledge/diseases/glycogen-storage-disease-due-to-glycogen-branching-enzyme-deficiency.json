  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Glycogen Storage Disease Type IV",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Demonstration of deficient glycogen branching enzyme activity in liver or muscle tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Liver biopsy showing accumulation of abnormal amylopectin-like glycogen deposits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the GBE1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive hepatosplenomegaly with failure to thrive and hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient glycogen branching enzyme activity plus either characteristic liver biopsy findings or pathogenic GBE1 mutations",
    "notes": "Genetic testing is increasingly used to confirm diagnosis and for family counseling."
  },
