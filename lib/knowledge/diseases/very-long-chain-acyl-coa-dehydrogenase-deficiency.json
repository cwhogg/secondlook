  "keyFindings": {
    "laboratory": [
      "Elevated plasma long-chain acylcarnitines (especially C14:1)",
      "Hypoketotic hypoglycemia during fasting or illness",
      "Elevated creatine kinase during rhabdomyolysis episodes"
    ],
    "imaging": [
      "Echocardiography showing dilated or hypertrophic cardiomyopathy",
      "Muscle MRI may show edema during rhabdomyolysis"
    ],
    "genetic": [
      "ACADVL (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Reduced VLCAD enzyme activity in cultured fibroblasts or lymphocytes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "medium-chain-acyl-coa-dehydrogenase-deficiency",
      "distinguishingFeatures": [
        "Elevated medium-chain acylcarnitines (C6-C10) instead of long-chain",
        "Typically presents with hypoketotic hypoglycemia without cardiomyopathy"
      ]
    },
    {
      "diseaseId": "carnitine-palmitoyltransferase-2-deficiency",
      "distinguishingFeatures": [
        "Similar rhabdomyolysis episodes but normal VLCAD enzyme activity",
        "Different acylcarnitine profile with elevated long-chain acylcarnitines but distinct pattern"
      ]
    }
  ],
  "redFlags": [
    "Hypoketotic hypoglycemia in infancy or childhood",
    "Cardiomyopathy presenting in early life",
    "Recurrent rhabdomyolysis triggered by fasting or exercise"
  ],
