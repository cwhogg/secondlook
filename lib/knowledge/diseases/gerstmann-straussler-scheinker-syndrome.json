  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Gerstmann-Sträussler-Scheinker Syndrome",
    "criteria": [
      {
        "id": "family-history",
        "description": "Positive family history of prion disease or autosomal dominant inheritance pattern",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Progressive cerebellar ataxia with cognitive decline and dementia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "prnp-mutation",
        "description": "Identification of pathogenic PRNP gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eeg-mri",
        "description": "Supportive findings on EEG or MRI including spongiform changes or cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuropathology",
        "description": "Postmortem confirmation of amyloid plaques and spongiform degeneration",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia and dementia with a pathogenic PRNP mutation and positive family history",
    "notes": "Definitive diagnosis requires genetic testing; neuropathology is confirmatory postmortem."
  },
