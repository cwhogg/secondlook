  "keyFindings": {
    "laboratory": [
      "Elevated serum ferritin (>500 µg/L, often >3000 µg/L)",
      "Cytopenias (anemia, thrombocytopenia, neutropenia)",
      "Hypertriglyceridemia and hypofibrinogenemia",
      "Elevated liver enzymes",
      "High soluble CD25 (sIL-2 receptor) levels",
      "Decreased NK cell activity"
    ],
    "imaging": [
      "Splenomegaly and hepatomegaly on ultrasound or CT",
      "Lymphadenopathy on imaging",
      "Pulmonary infiltrates on chest X-ray or CT in rare cases"
    ],
    "genetic": [
      "No primary genetic mutations typical of familial HLH",
      "Genetic testing negative for primary HLH-associated mutations"
    ],
    "other": [
      "Bone marrow biopsy showing hemophagocytosis without malignant infiltration",
      "Association with underlying malignant disease (e.g., lymphoma, leukemia)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "primary-hemophagocytic-lymphohistiocytosis",
      "distinguishingFeatures": [
        "Genetic mutations in HLH-associated genes",
        "Usually presents in infancy or early childhood",
        "Family history positive"
      ]
    },
    {
      "diseaseId": "sepsis-associated-multiorgan-dysfunction",
      "distinguishingFeatures": [
        "Positive blood cultures or infectious source",
        "Lack of hemophagocytosis on bone marrow biopsy",
        "Response to antimicrobial therapy"
      ]
    },
    {
      "diseaseId": "malignancy-with-bone-marrow-infiltration",
      "distinguishingFeatures": [
        "Presence of malignant cells in bone marrow biopsy",
        "Absence of hemophagocytosis or secondary HLH features",
        "Different clinical course"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive cytopenias refractory to standard treatment",
    "Unremitting high fever with splenomegaly",
    "Evidence of hemophagocytosis on bone marrow biopsy",
    "Marked hyperferritinemia (>3000 µg/L)",
    "Neurological deterioration including seizures or coma"
  ],
