  "diagnosticCriteria": {
    "formalCriteriaName": "Panhypophysitis Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-panhypopituitarism",
        "description": "Clinical evidence of multiple anterior and posterior pituitary hormone deficiencies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pituitary-inflammation-imaging",
        "description": "MRI showing diffuse pituitary enlargement with homogeneous enhancement and stalk thickening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of hypopituitarism such as tumors, infections, or infiltrative diseases",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histopathological confirmation of lymphocytic or granulomatous inflammation if biopsy performed",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "autoimmune-markers",
        "description": "Presence of pituitary autoantibodies or other autoimmune markers",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical panhypopituitarism, characteristic MRI findings, and exclusion of other causes",
    "notes": "Biopsy is rarely performed due to invasiveness; diagnosis often clinical and radiological"
  },
