  "diagnosticCriteria": {
    "formalCriteriaName": "Distal Limb Deficiencies-Micrognathia Diagnostic Criteria",
    "criteria": [
      {
        "id": "micrognathia",
        "description": "Presence of micrognathia (undersized jaw)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distal-limb-deficiency",
        "description": "Congenital absence or hypoplasia of distal limb elements (digits or metacarpals/metatarsals)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Additional facial dysmorphic features such as cleft palate or low-set ears",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Prenatal or postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiologic-confirmation",
        "description": "Radiologic evidence of distal limb bone deficiencies",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of micrognathia and radiologically confirmed distal limb deficiencies",
    "notes": "Diagnosis is primarily clinical supported by imaging; genetic testing may be inconclusive."
  },
