  ],
  "omimId": "187360",
  "orphanetId": "397",
  "prevalence": {
    "estimate": "15-30 per 100,000 in population over 50",
    "range": "15-30 per 100,000 (age >50)",
    "classification": "uncommon"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 50,
      "max": 85,
      "peak": 72
    },
    "sexPredilection": "female",
    "ethnicAssociations": [
      "Northern European/Scandinavian descent",
      "Caucasian"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "2022 ACR/EULAR Classification Criteria for Giant Cell Arteritis",
    "criteria": [
      {
        "id": "gca-1",
        "description": "Age at disease onset >= 50 years",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gca-2",
        "description": "New onset localized headache",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "gca-3",
        "description": "Temporal artery abnormality (tenderness, decreased pulsation)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "gca-4",
        "description": "ESR >= 50 mm/h",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "gca-5",
        "description": "Temporal artery biopsy showing vasculitis with mononuclear cell infiltration or granulomatous inflammation with multinucleated giant cells",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gca-6",
        "description": "Jaw or tongue claudication",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gca-7",
        "description": "Sudden visual loss or visual disturbance",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gca-8",
        "description": "Morning stiffness in shoulders and/or hips (polymyalgia rheumatica overlap)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "gca-9",
        "description": "Positive temporal artery halo sign on ultrasound",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gca-10",
        "description": "Large vessel involvement on imaging (aortitis, large artery stenosis)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Age >= 50 years plus total weighted score >= 6 from the classification criteria",
    "notes": "Temporal artery biopsy remains the gold standard. Ultrasound halo sign is increasingly used as first-line diagnostic test. Large-vessel GCA (aortitis) can occur without cranial symptoms."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Jaw claudication",
        "snomedCode": "274730004",
        "frequency": 0.4,
        "bodySystem": "constitutional",
        "notes": "Pain with chewing due to maxillary artery vasculitis; highly specific for GCA"
      },
      {
        "symptomName": "Scalp tenderness over temporal artery",
        "snomedCode": "162301005",
        "frequency": 0.5,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Temporal artery thickening/nodularity with absent pulse",
        "frequency": 0.3,
        "bodySystem": "cardiovascular"
      }
    ],
    "common": [
      {
        "symptomName": "New-onset headache (temporal)",
        "snomedCode": "25064002",
        "frequency": 0.7,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Polymyalgia rheumatica symptoms (shoulder/hip girdle stiffness)",
        "snomedCode": "65323003",
        "frequency": 0.5,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Constitutional symptoms (fatigue, weight loss, fever)",
        "snomedCode": "386661006",
        "frequency": 0.5,
        "bodySystem": "constitutional"
      },
      {
        "symptomName": "Visual disturbances (amaurosis fugax, diplopia)",
        "snomedCode": "314921000",
        "frequency": 0.3,
        "bodySystem": "ophthalmological"
      },
      {
        "symptomName": "Elevated ESR/CRP",
        "frequency": 0.95,
        "bodySystem": "constitutional"
      }
    ],
    "occasional": [
      {
        "symptomName": "Anterior ischemic optic neuropathy (AION)",
        "snomedCode": "230509001",
        "frequency": 0.15,
        "bodySystem": "ophthalmological",
        "notes": "Most common cause of permanent vision loss; ophthalmologic emergency"
      },
      {
        "symptomName": "Tongue claudication",
        "frequency": 0.1,
        "bodySystem": "constitutional"
      },
      {
        "symptomName": "Upper limb claudication",
        "snomedCode": "63491006",
        "frequency": 0.1,
        "bodySystem": "cardiovascular",
        "notes": "From subclavian/axillary involvement in large-vessel GCA"
      },
      {
        "symptomName": "Aortic aneurysm",
        "snomedCode": "67362008",
        "frequency": 0.1,
        "bodySystem": "cardiovascular",
        "notes": "Thoracic aorta most common; risk persists after treatment"
      },
      {
        "symptomName": "Cough or sore throat",
        "snomedCode": "49727002",
        "frequency": 0.1,
        "bodySystem": "constitutional"
      }
    ],
    "rare": [
      {
        "symptomName": "Aortic dissection",
        "snomedCode": "308546005",
        "frequency": 0.03,
        "bodySystem": "cardiovascular"
      },
      {
        "symptomName": "Stroke (vertebrobasilar or carotid)",
        "snomedCode": "230690007",
        "frequency": 0.05,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Scalp necrosis",
        "frequency": 0.02,
        "bodySystem": "dermatological"
      },
      {
        "symptomName": "Tongue necrosis",
        "frequency": 0.01,
        "bodySystem": "constitutional"
      }
    ]
  },
  "systemsAffected": [
    "cardiovascular",
    "ophthalmological",
    "musculoskeletal",
    "neurological"
  ],
  "keyFindings": {
    "laboratory": [
      "ESR markedly elevated (often >50, frequently >100 mm/h)",
      "CRP markedly elevated",
      "Normocytic anemia",
      "Thrombocytosis",
      "Elevated alkaline phosphatase",
      "Elevated fibrinogen",
      "IL-6 elevated"
    ],
    "imaging": [
      "Temporal artery ultrasound: halo sign (dark hypoechoic ring)",
      "CTA/MRA: mural thickening and enhancement of aorta and branches",
      "PET-CT: FDG uptake in large vessels (aortitis)",
      "MRI of temporal arteries: mural enhancement and thickening"
    ],
    "genetic": [
      "HLA-DRB1*04 association",
      "HLA-DRB1*0401 (particularly strong)"
    ],
    "other": [
      "Temporal artery biopsy: transmural granulomatous inflammation with giant cells, intimal hyperplasia, fragmentation of internal elastic lamina",
      "Biopsy should be >= 1 cm, bilateral if initial is negative (skip lesions occur)"
    ]
  },
  "differentialDiagnoses": [
