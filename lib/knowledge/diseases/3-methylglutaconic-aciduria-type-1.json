      "Abnormal mitochondrial enzyme activities in muscle biopsy"
    ],
    "imaging": [
      "Brain MRI showing cerebral and cerebellar atrophy",
      "White matter abnormalities",
      "Basal ganglia signal changes"
    ],
    "genetic": [
      "IL2RG (causative)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Muscle biopsy may show mitochondrial abnormalities",
      "Electromyography may reveal neuropathic changes"
    ]
  },
