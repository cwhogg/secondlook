  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Postaxial Acrofacial Dysostosis",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including malar hypoplasia, micrognathia, and cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "postaxial-polydactyly",
        "description": "Presence of postaxial polydactyly affecting hands and/or feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Radial ray anomalies and limb shortening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Pre- and postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Conductive or sensorineural hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: characteristic facial dysmorphism, postaxial polydactyly, and limb malformations",
    "notes": "Genetic testing for mutations in the EFTUD2 gene can support diagnosis"
  },
