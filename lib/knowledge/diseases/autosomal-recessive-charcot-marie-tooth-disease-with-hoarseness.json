  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Autosomal Recessive Charcot-Marie-Tooth Disease with Hoarseness",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of distal muscle weakness and atrophy predominantly in lower limbs with sensory loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hoarseness-vocal-cord",
        "description": "Persistent hoarseness due to vocal cord paresis or paralysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies showing demyelinating or axonal peripheral neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in genes associated with autosomal recessive CMT",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consistent autosomal recessive inheritance pattern or consanguinity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of distal neuropathy with hoarseness plus either electrophysiological evidence or genetic confirmation",
    "notes": "Genetic testing is recommended to confirm diagnosis and exclude other CMT subtypes."
  },
