  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "No specific biochemical markers identified"
    ],
    "imaging": [
      "Brain MRI: nonspecific white matter changes, mild ventriculomegaly",
      "Skeletal X-rays: joint contractures and possible scoliosis"
    ],
    "genetic": [
      "DCHS1 (causative)",
      "FAT4 (causative)",
      "Pathogenic variants in TMCO1 gene (autosomal recessive inheritance)"
    ],
    "other": [
      "Neurodevelopmental assessment confirming intellectual disability",
      "Clinical examination revealing characteristic facial features and joint hypermobility"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "tmco1-syndrome",
      "distinguishingFeatures": [
        "Overlaps genetically but TMCO1 syndrome is synonymous with cerebrofacioarticular syndrome"
      ]
    },
    {
      "diseaseId": "loeys-dietz-syndrome",
      "distinguishingFeatures": [
        "More prominent vascular involvement",
        "Distinct craniofacial features including bifid uvula",
        "Presence of arterial aneurysms"
      ]
    },
    {
      "diseaseId": "ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "More severe skin hyperextensibility",
        "Different genetic mutations",
        "Absence of intellectual disability"
      ]
    }
  ],
