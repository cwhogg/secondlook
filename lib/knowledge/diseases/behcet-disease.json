    "range": "0.3-420 per 100,000 depending on geography",
    "classification": "rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 20,
      "max": 40,
      "peak": 30
    },
    "sexPredilection": "equal",
    "ethnicAssociations": [
      "Turkish",
      "Middle Eastern",
      "East Asian (Japanese, Korean)",
      "Silk Road populations"
    ]
