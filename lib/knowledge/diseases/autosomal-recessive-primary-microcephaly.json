        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Non-progressive intellectual disability with developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-brain-malformations",
        "description": "No evidence of other brain malformations on neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consanguinity or affected siblings consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic biallelic variants in MCPH-associated genes",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital microcephaly with intellectual disability and absence of other brain malformations; genetic confirmation supports diagnosis",
    "notes": "Diagnosis requires exclusion of secondary causes of microcephaly and other syndromic conditions"
  },
