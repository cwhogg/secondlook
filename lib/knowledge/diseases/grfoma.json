  "keyFindings": {
    "laboratory": [
      "Anemia with leukoerythroblastic blood picture",
      "Elevated serum lactate dehydrogenase (LDH)",
      "Thrombocytopenia and variable leukocyte counts"
    ],
    "imaging": [
      "X-ray showing osteosclerosis and cortical thickening",
      "MRI demonstrating bone marrow fibrosis and granulomatous lesions",
      "Ultrasound confirming splenomegaly and hepatomegaly"
    ],
    "genetic": [
      "No consistent genetic mutation identified; negative for JAK2, CALR, MPL mutations"
    ],
    "other": [
      "Bone marrow biopsy with granulomatous fibro-osseous changes and reticulin fibrosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "primary-myelofibrosis",
      "distinguishingFeatures": [
        "Absence of granulomatous fibro-osseous lesions",
        "Presence of JAK2 or CALR mutations in majority",
        "More pronounced splenomegaly and constitutional symptoms"
      ]
    },
    {
      "diseaseId": "sarcoidosis",
      "distinguishingFeatures": [
        "Systemic non-caseating granulomas without bone marrow fibrosis",
        "Pulmonary and lymph node involvement predominant",
        "No osteosclerosis or myelofibrosis on biopsy"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of anemia with transfusion dependence",
    "Development of neurological deficits indicating extramedullary hematopoiesis",
    "Signs of organ failure such as renal impairment or pulmonary hypertension"
  ],
