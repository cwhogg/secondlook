        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metaphyseal-irregularities",
        "description": "Irregular metaphyseal changes with flaring and cupping of long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-short-trunk-dwarfism",
        "description": "Clinical presentation of short-trunk dwarfism with disproportionate short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mild-facial-dysmorphism",
        "description": "Presence of mild facial dysmorphic features such as midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development and intelligence",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic radiological spinal and metaphyseal abnormalities combined with clinical short-trunk dwarfism",
    "notes": "Genetic testing may support diagnosis but is not always available."
  },
