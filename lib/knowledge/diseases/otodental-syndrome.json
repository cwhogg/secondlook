  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiographic Diagnostic Criteria for Otodental Syndrome",
    "criteria": [
      {
        "id": "globodontia",
        "description": "Presence of globodontia characterized by enlarged, bulbous molar teeth with globe-shaped crowns",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss typically affecting mid to high frequencies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "Presence of ocular coloboma or other ocular defects such as iris or chorioretinal coloboma",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiographic-dental-features",
        "description": "Radiographic evidence of enlarged pulp chambers and abnormal root morphology in molars",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of globodontia and sensorineural hearing loss with or without ocular anomalies",
    "notes": "Genetic testing may support diagnosis but is not mandatory; diagnosis is primarily clinical and radiographic."
  },
