  "diagnosticCriteria": {
    "formalCriteriaName": "Majeed Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-multifocal-osteomyelitis",
        "description": "Presence of chronic recurrent multifocal osteomyelitis confirmed by imaging and clinical course",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-dyserythropoietic-anemia",
        "description": "Evidence of congenital dyserythropoietic anemia with characteristic bone marrow findings",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neutrophilic-dermatosis",
        "description": "Neutrophilic dermatosis such as Sweet syndrome or pustulosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lpin2-mutation",
        "description": "Identification of biallelic pathogenic variants in the LPIN2 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (chronic multifocal osteomyelitis, congenital dyserythropoietic anemia, and neutrophilic dermatosis) with or without genetic confirmation",
    "notes": "Genetic testing for LPIN2 mutations strongly supports diagnosis but is not mandatory if clinical criteria are met."
  },
