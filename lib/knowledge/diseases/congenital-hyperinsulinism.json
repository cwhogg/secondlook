  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Congenital Hyperinsulinism",
    "criteria": [
      {
        "id": "persistent-hypoglycemia",
        "description": "Persistent hypoglycemia with plasma glucose <50 mg/dL in neonates or infants",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "inappropriately-elevated-insulin",
        "description": "Inappropriately elevated plasma insulin levels during hypoglycemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "suppressed-ketones-and-fatty-acids",
        "description": "Suppressed plasma ketone bodies and free fatty acids during hypoglycemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in genes associated with hyperinsulinism (e.g., ABCC8, KCNJ11)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-glucagon",
        "description": "Increase in blood glucose following glucagon administration during hypoglycemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent hypoglycemia with inappropriately elevated insulin during hypoglycemia and suppressed ketones/fatty acids",
    "notes": "Genetic testing and response to glucagon are supportive but not mandatory for diagnosis."
  },
