  "diagnosticCriteria": {
    "formalCriteriaName": "Best Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "vitelliform-lesion",
        "description": "Presence of characteristic yellowish vitelliform lesions in the macula",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrooculogram-light-peak-ratio",
        "description": "Reduced Arden ratio on electrooculogram (EOG)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the BEST1 gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic vitelliform lesions and reduced Arden ratio on EOG",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Yellowish vitelliform macular lesion",
        "frequency": 0.95,
        "bodySystem": "ophthalmological",
        "notes": "Typically egg-yolk like lesion at the macula"
      },
      {
        "symptomName": "Reduced Arden ratio on electrooculogram",
        "frequency": 0.85,
        "bodySystem": "ophthalmological",
        "notes": "Indicative of retinal pigment epithelium dysfunction"
      }
    ],
    "common": [
      {
        "symptomName": "Progressive central vision loss",
        "frequency": 0.75,
        "bodySystem": "ophthalmological",
        "notes": "Usually bilateral but asymmetric"
      },
      {
        "symptomName": "Metamorphopsia",
        "frequency": 0.65,
        "bodySystem": "ophthalmological",
        "notes": "Visual distortion affecting central vision"
      },
      {
        "symptomName": "Decreased visual acuity",
        "frequency": 0.7,
        "bodySystem": "ophthalmological",
        "notes": "Variable severity depending on stage"
      },
      {
        "symptomName": "Normal full-field electroretinogram (ERG)",
        "frequency": 0.6,
        "bodySystem": "ophthalmological",
        "notes": "Helps differentiate from other retinal dystrophies"
      }
    ],
    "occasional": [
      {
        "symptomName": "Photophobia",
        "frequency": 0.3,
        "bodySystem": "ophthalmological",
        "notes": "Light sensitivity reported in some patients"
      },
      {
        "symptomName": "Mild color vision abnormalities",
        "frequency": 0.25,
        "bodySystem": "ophthalmological",
        "notes": "Subtle color discrimination defects"
      },
      {
        "symptomName": "Central scotoma",
        "frequency": 0.4,
        "bodySystem": "ophthalmological",
        "notes": "Central blind spot in visual field"
      },
      {
        "symptomName": "Fluctuating vision",
        "frequency": 0.15,
        "bodySystem": "ophthalmological",
        "notes": "Intermittent changes in visual clarity"
      }
    ],
    "rare": [
      {
        "symptomName": "Retinal neovascularization",
        "frequency": 0.05,
        "bodySystem": "ophthalmological",
        "notes": "Rare complication leading to hemorrhage"
      },
      {
        "symptomName": "Choroidal neovascular membrane formation",
        "frequency": 0.07,
        "bodySystem": "ophthalmological",
        "notes": "May cause sudden vision loss"
      },
      {
        "symptomName": "Peripheral retinal abnormalities",
        "frequency": 0.02,
        "bodySystem": "ophthalmological",
        "notes": "Uncommon involvement outside macula"
      }
    ]
  },
