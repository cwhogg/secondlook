  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild metabolic abnormalities secondary to feeding difficulties"
    ],
    "imaging": [
      "Brain MRI may show nonspecific delayed myelination or mild cerebral atrophy"
    ],
    "genetic": [
      "KCNK9 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography may show decreased muscle tone",
      "Polysomnography for sleep apnea evaluation"
    ]
  },
