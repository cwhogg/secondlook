  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of acquired causes of ataxia (e.g., vitamin E deficiency, thyroid dysfunction)"
    ],
    "imaging": [
      "MRI showing cerebellar atrophy, predominantly involving the vermis and hemispheres"
    ],
    "genetic": [
      "ATXN8 (causative)",
      "ATXN8OS (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography may show mild peripheral neuropathy",
      "Neurophysiology studies typically normal or mildly abnormal"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "spinocerebellar-ataxia-type-1",
      "distinguishingFeatures": [
        "Earlier onset in some cases",
        "Presence of pyramidal signs and ophthalmoplegia",
        "Different genetic mutation (CAG repeats in ATXN1 gene)"
      ]
    },
    {
      "diseaseId": "friedreich-ataxia",
      "distinguishingFeatures": [
        "Onset usually before 25 years",
        "Presence of cardiomyopathy and diabetes mellitus",
        "GAA repeat expansion in FXN gene"
      ]
    },
    {
      "diseaseId": "multiple-system-atrophy",
      "distinguishingFeatures": [
        "Autonomic failure prominent",
        "Parkinsonism with poor levodopa response",
        "No known genetic cause"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of ataxia over weeks to months",
    "Presence of severe autonomic dysfunction",
    "Onset before age 10 or after age 70"
  ],
