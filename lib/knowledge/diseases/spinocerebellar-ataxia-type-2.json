    "laboratory": [
      "Electromyography showing sensory-motor peripheral neuropathy",
      "Nerve conduction studies demonstrating slowed conduction velocities"
    ],
    "imaging": [
      "MRI brain showing cerebellar atrophy, especially of the vermis and hemispheres",
      "Brainstem atrophy may also be present"
    ],
    "genetic": [
      "ATXN2 (causative)",
      "Autosomal dominant inheritance"
    ],
