    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter abnormalities",
      "Echocardiogram may reveal congenital heart defects"
    ],
    "genetic": [
      "Triplication of distal 15q region detected by chromosomal microarray or FISH",
      "No known single gene mutation; chromosomal structural abnormality"
    ],
