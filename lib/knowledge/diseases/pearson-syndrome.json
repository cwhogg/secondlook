  "diagnosticCriteria": {
    "formalCriteriaName": "Pearson Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "mtDNA-deletion",
        "description": "Detection of single large-scale mitochondrial DNA deletion in blood or bone marrow",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sideroblastic-anemia",
        "description": "Presence of refractory sideroblastic anemia with ring sideroblasts on bone marrow examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pancreatic-dysfunction",
        "description": "Exocrine pancreatic insufficiency evidenced by malabsorption or pancreatic enzyme deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lactic-acidosis",
        "description": "Elevated blood lactate levels indicating mitochondrial dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "multisystem-involvement",
        "description": "Evidence of multisystem involvement including renal tubular dysfunction or endocrinopathies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of mitochondrial DNA deletion plus refractory sideroblastic anemia and pancreatic exocrine dysfunction",
    "notes": "Diagnosis is confirmed by genetic testing and clinical presentation; bone marrow biopsy is essential."
  },
