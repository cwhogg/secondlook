  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Treacher Collins Syndrome",
    "criteria": [
      {
        "id": "facial-bone-hypoplasia",
        "description": "Bilateral hypoplasia of the zygomatic complex and mandible",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "downslanting-palpebral-fissures",
        "description": "Downslanting palpebral fissures with lower eyelid coloboma or notching",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "conductive-hearing-loss",
        "description": "Conductive hearing loss due to malformations of the middle ear ossicles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cleft-palate",
        "description": "Presence of cleft palate or high-arched palate",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in TCOF1, POLR1C, or POLR1D genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral facial bone hypoplasia and at least one other major criterion (downslanting palpebral fissures or conductive hearing loss), or genetic confirmation of pathogenic variants",
    "notes": "Diagnosis is primarily clinical but can be confirmed by molecular genetic testing."
  },
