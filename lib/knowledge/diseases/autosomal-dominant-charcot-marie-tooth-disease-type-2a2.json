  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for CMT2A2",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of distal muscle weakness and atrophy predominantly in lower limbs with distal sensory loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies showing axonal neuropathy with normal or mildly reduced conduction velocities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic MFN2 gene mutation consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of similar neuropathy with autosomal dominant pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-atrophy-pattern",
        "description": "Predominant distal muscle atrophy with foot deformities such as pes cavus",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of distal neuropathy symptoms with confirmatory nerve conduction studies and identification of pathogenic MFN2 mutation",
    "notes": "Genetic testing is essential to confirm diagnosis and differentiate from other CMT subtypes."
  },
