  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Harlequin Ichthyosis",
    "criteria": [
      {
        "id": "thick-plate-like-scales",
        "description": "Presence of thick, plate-like hyperkeratotic scales covering the body",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ectropion",
        "description": "Eversion of the eyelids (ectropion)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the ABCA12 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fissured-skin",
        "description": "Deep skin fissures and cracks between hyperkeratotic plates",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-distress",
        "description": "Respiratory compromise due to restricted chest wall movement",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic thick plate-like scales with ectropion plus genetic confirmation of ABCA12 mutation",
    "notes": "Diagnosis is primarily clinical at birth, supported by genetic testing."
  },
