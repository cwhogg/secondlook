    "laboratory": [
      "Normal routine blood tests",
      "Possible mild thyroid hormone abnormalities"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter changes",
      "Echocardiogram to identify congenital heart defects",
      "Spinal X-rays for scoliosis evaluation"
    ],
