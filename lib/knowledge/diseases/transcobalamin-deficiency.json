  "diagnosticCriteria": {
    "formalCriteriaName": "No standardized formal criteria",
    "criteria": [
      {
        "id": "biochemical-evidence",
        "description": "Low serum holotranscobalamin levels with normal or low serum vitamin B12",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the TCN2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Early-onset megaloblastic anemia with failure to thrive and neurological symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-treatment",
        "description": "Improvement of hematological and neurological symptoms after parenteral vitamin B12 administration",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation consistent with transcobalamin deficiency plus biochemical evidence and confirmation by genetic testing",
    "notes": "Diagnosis is often confirmed by molecular genetic testing due to overlap with other causes of vitamin B12 deficiency."
  },
