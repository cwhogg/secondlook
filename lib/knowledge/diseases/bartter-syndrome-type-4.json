  "diagnosticCriteria": {
    "formalCriteriaName": "Bartter Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "bsnd-mutation",
        "description": "Identification of biallelic pathogenic mutations in the BSND gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-deafness",
        "description": "Presence of congenital sensorineural deafness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypokalemic-metabolic-alkalosis",
        "description": "Laboratory evidence of hypokalemic metabolic alkalosis with renal salt wasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-renin-aldosterone",
        "description": "Elevated plasma renin activity and aldosterone levels without hypertension",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "polyuria-polydipsia",
        "description": "Clinical features of polyuria and polydipsia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic BSND mutations plus congenital sensorineural deafness and hypokalemic metabolic alkalosis",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical features overlap with other Bartter syndrome types."
  },
