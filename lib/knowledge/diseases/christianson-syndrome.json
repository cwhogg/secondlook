  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnostic criteria for Christianson Syndrome",
    "criteria": [
      {
        "id": "developmental-delay",
        "description": "Severe global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epilepsy",
        "description": "Early-onset epilepsy or seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ataxia",
        "description": "Progressive ataxia and impaired motor coordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mutations-slc9a6",
        "description": "Pathogenic mutation in the SLC9A6 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microcephaly",
        "description": "Postnatal microcephaly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ophthalmoplegia",
        "description": "Ophthalmoplegia or abnormal eye movements",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe developmental delay, epilepsy, ataxia, and identification of pathogenic SLC9A6 mutation",
    "notes": "Genetic testing is essential to confirm diagnosis; clinical features overlap with Angelman syndrome."
  },
