  "diagnosticCriteria": {
    "formalCriteriaName": "EEC Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "ectrodactyly",
        "description": "Presence of split hand/foot malformation (ectrodactyly)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ectodermal-dysplasia",
        "description": "Signs of ectodermal dysplasia including abnormal hair, teeth, nails, or sweat glands",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "orofacial-clefting",
        "description": "Cleft lip and/or cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in TP63 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "additional-features",
        "description": "Presence of other ectodermal anomalies such as lacrimal duct abnormalities or hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: ectrodactyly, ectodermal dysplasia, and orofacial clefting",
    "notes": "Genetic testing for TP63 mutations supports diagnosis but is not mandatory if clinical criteria are met."
  },
