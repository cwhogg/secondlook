  "prevalence": {
    "estimate": "1 in 100,000",
    "range": "0.001%-0.002%",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 3,
      "max": 20,
      "peak": 10
    },
    "sexPredilection": "equal",
    "ethnicAssociations": [
      "Japanese",
      "Portuguese",
      "North African"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "AOA1 Diagnostic Criteria",
    "criteria": [
      {
        "id": "early-onset-ataxia",
        "description": "Progressive cerebellar ataxia with onset before age 20",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oculomotor-apraxia",
        "description": "Presence of oculomotor apraxia characterized by impaired voluntary horizontal eye movements",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peripheral-neuropathy",
        "description": "Sensorimotor peripheral neuropathy confirmed by clinical and electrophysiological studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypoalbuminemia",
        "description": "Laboratory evidence of hypoalbuminemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-serum-cholesterol",
        "description": "Elevated serum cholesterol levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "APTX-mutation",
        "description": "Identification of pathogenic mutations in the APTX gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset progressive cerebellar ataxia, oculomotor apraxia, peripheral neuropathy, and pathogenic APTX gene mutation",
    "notes": "Diagnosis is supported by laboratory abnormalities such as hypoalbuminemia and hypercholesterolemia but these are not mandatory."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Progressive cerebellar ataxia",
        "frequency": 0.95,
        "bodySystem": "neurological",
        "notes": "Early onset with gait disturbance and limb ataxia"
      },
      {
        "symptomName": "Oculomotor apraxia",
        "frequency": 0.9,
        "bodySystem": "ophthalmological",
        "notes": "Difficulty initiating voluntary horizontal saccades"
      },
      {
        "symptomName": "Sensorimotor peripheral neuropathy",
        "frequency": 0.85,
        "bodySystem": "neurological",
        "notes": "Distal muscle weakness and sensory loss"
      }
    ],
    "common": [
      {
        "symptomName": "Dysarthria",
        "frequency": 0.75,
        "bodySystem": "neurological",
        "notes": "Slurred speech due to cerebellar involvement"
      },
      {
        "symptomName": "Hypoalbuminemia",
        "frequency": 0.7,
        "bodySystem": "hematological",
        "notes": "Low serum albumin levels"
      },
      {
        "symptomName": "Hypercholesterolemia",
        "frequency": 0.65,
        "bodySystem": "endocrine",
        "notes": "Elevated serum cholesterol"
      },
      {
        "symptomName": "Axonal neuropathy on nerve conduction studies",
        "frequency": 0.6,
        "bodySystem": "neurological",
        "notes": "Electrophysiological confirmation of neuropathy"
      },
      {
        "symptomName": "Cognitive impairment",
        "frequency": 0.55,
        "bodySystem": "psychiatric",
        "notes": "Mild intellectual disability or cognitive slowing"
      }
    ],
    "occasional": [
      {
        "symptomName": "Tremor",
        "frequency": 0.4,
        "bodySystem": "neurological",
        "notes": "Postural or intention tremor"
      },
      {
        "symptomName": "Chorea",
        "frequency": 0.3,
        "bodySystem": "neurological",
        "notes": "Involuntary, irregular movements"
      },
      {
        "symptomName": "Dystonia",
        "frequency": 0.25,
        "bodySystem": "neurological",
        "notes": "Sustained muscle contractions causing abnormal postures"
      },
      {
        "symptomName": "Pes cavus",
        "frequency": 0.2,
        "bodySystem": "musculoskeletal",
        "notes": "High-arched foot deformity"
      },
      {
        "symptomName": "Skeletal deformities",
        "frequency": 0.15,
        "bodySystem": "musculoskeletal",
        "notes": "Including scoliosis"
      }
    ],
    "rare": [
      {
        "symptomName": "Oculomotor apraxia with vertical gaze involvement",
        "frequency": 0.08,
        "bodySystem": "ophthalmological",
        "notes": "Less common vertical saccade impairment"
      },
      {
        "symptomName": "Seizures",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Rare occurrence"
      },
      {
        "symptomName": "Peripheral edema",
        "frequency": 0.04,
        "bodySystem": "constitutional",
        "notes": "Possibly related to hypoalbuminemia"
      }
    ]
  },
  "systemsAffected": [
    "neurological",
