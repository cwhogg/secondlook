  "diagnosticCriteria": {
    "formalCriteriaName": "Cono-spondylar Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "vertebral-malformations",
        "description": "Presence of characteristic vertebral malformations including cone-shaped vertebral bodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-trunk-dwarfism",
        "description": "Short-trunk disproportionate dwarfism evident in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-shortening",
        "description": "Mild to moderate shortening of long bones with metaphyseal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-findings",
        "description": "Radiographic evidence of platyspondyly and irregular epiphyses",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the COL2A1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (vertebral malformations, short-trunk dwarfism, and limb shortening) confirmed by radiographic findings",
    "notes": "Genetic testing for COL2A1 mutations can support diagnosis but is not mandatory"
  },
