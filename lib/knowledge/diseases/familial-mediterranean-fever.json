  "diagnosticCriteria": {
    "formalCriteriaName": "Tel-Hashomer Criteria / Eurofever/PRINTO Classification Criteria (2019)",
    "criteria": [
      {
        "id": "fmf-maj1",
        "description": "Recurrent febrile episodes with serositis (peritonitis, pleuritis, pericarditis) lasting 1-3 days",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "fmf-maj2",
        "description": "AA amyloidosis without predisposing disease",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "fmf-maj3",
        "description": "Favorable response to colchicine",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "fmf-min1",
        "description": "Recurrent febrile episodes alone",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "fmf-min2",
        "description": "Erysipelas-like erythema",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "fmf-min3",
        "description": "FMF in a first-degree relative",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "fmf-sup1",
        "description": "Pathogenic MEFV gene mutations (especially M694V, M680I, V726A homozygous or compound heterozygous)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Tel-Hashomer: >= 2 major criteria, OR 1 major + 2 minor. Eurofever (2019): presence of confirmatory MEFV mutations plus compatible clinical features, OR clinical criteria in absence of genotyping.",
    "notes": "Autosomal recessive inheritance (MEFV gene). M694V homozygosity associated with severe disease and higher amyloidosis risk. Colchicine response strongly supports diagnosis."
  },
