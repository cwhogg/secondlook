  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Plectin-related LGMD R17",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness predominantly affecting limb-girdle muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes with reduced or absent plectin protein expression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the PLEC gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Electromyography demonstrating myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "serum-creatine-kinase",
        "description": "Elevated serum creatine kinase levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal limb-girdle muscle weakness plus either muscle biopsy showing reduced plectin expression or biallelic pathogenic PLEC variants",
    "notes": "Genetic confirmation is essential for definitive diagnosis; muscle biopsy findings support diagnosis."
  },
