  "keyFindings": {
    "laboratory": [
      "Markedly elevated urinary porphobilinogen (PBG) during attack",
      "Elevated urinary aminolevulinic acid (ALA)",
      "Reduced erythrocyte HMBS enzyme activity (~50% of normal)",
      "Hyponatremia (from SIADH)",
      "Normal fecal porphyrins (unlike HCP and VP)"
    ],
    "imaging": [
      "Abdominal imaging typically unremarkable despite severe pain",
      "MRI brain may show posterior reversible encephalopathy syndrome in severe cases",
      "Hepatic MRI or ultrasound for HCC screening in chronic patients"
    ],
    "genetic": [
      "HMBS (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Watson-Schwartz test (qualitative urine PBG screening)",
      "Urine fluorescence under Wood's lamp",
      "Nerve conduction studies showing predominantly motor axonal neuropathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hereditary-coproporphyria",
      "distinguishingFeatures": [
        "HCP has elevated fecal coproporphyrin III",
        "HCP may have cutaneous photosensitivity",
        "HCP involves CPOX gene mutation"
      ]
    },
    {
      "diseaseId": "porphyria-cutanea-tarda",
      "distinguishingFeatures": [
        "PCT presents with skin blistering, not neurovisceral attacks",
        "PCT has elevated urinary uroporphyrins, not PBG",
        "PCT does not cause abdominal pain attacks"
      ]
    },
    {
      "diseaseId": "lead-poisoning",
      "distinguishingFeatures": [
        "Lead poisoning has elevated blood lead levels",
        "ALA elevated but PBG normal in lead poisoning",
        "Basophilic stippling on blood smear in lead poisoning"
      ]
    },
    {
      "diseaseId": "acute-abdomen",
      "distinguishingFeatures": [
        "Surgical causes show peritoneal signs",
        "Imaging findings present in surgical abdomen",
        "No autonomic dysfunction in typical surgical abdomen"
      ]
    }
  ],
  "redFlags": [
    "Progressive motor weakness suggesting ascending neuropathy (risk of respiratory failure)",
    "Seizures (often indicate severe hyponatremia)",
    "Severe hyponatremia (<120 mEq/L)",
    "Bulbar weakness or respiratory compromise",
    "Inappropriate administration of porphyrinogenic drugs"
  ],
