  "diagnosticCriteria": {
    "formalCriteriaName": "Aagenaes Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cholestasis",
        "description": "Persistent neonatal or infantile intrahepatic cholestasis with elevated conjugated bilirubin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphedema",
        "description": "Chronic lower limb lymphedema developing in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consanguinity or affected siblings suggesting autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hepatic-biopsy",
        "description": "Liver biopsy showing intrahepatic bile duct hypoplasia or paucity",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent cholestasis and chronic lymphedema in infancy or early childhood",
    "notes": "Genetic testing for mutations in the gene responsible (e.g., CCBE1) may support diagnosis"
  },
