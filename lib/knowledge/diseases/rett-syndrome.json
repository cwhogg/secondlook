  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible elevated lactate in some cases"
    ],
    "imaging": [
      "MRI brain may show nonspecific cerebral atrophy or delayed myelination"
    ],
    "genetic": [
      "Mutations in MECP2 gene on X chromosome detected in >90% of classic cases"
    ],
    "other": [
      "EEG abnormalities consistent with epilepsy",
      "Polysomnography may show breathing irregularities"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "angelman-syndrome",
      "distinguishingFeatures": [
        "Happy demeanor with frequent laughter",
        "Severe intellectual disability without regression of hand skills",
        "Characteristic EEG pattern"
      ]
    },
    {
      "diseaseId": "autism-spectrum-disorder",
      "distinguishingFeatures": [
        "Lack of regression of purposeful hand skills",
        "Absence of stereotypic hand wringing",
        "No MECP2 mutations"
      ]
    },
    {
      "diseaseId": "childhood-onset-cerebral-palsy",
      "distinguishingFeatures": [
        "Non-progressive motor impairment",
        "No regression of language or hand skills",
        "No stereotypic hand movements"
      ]
    }
  ],
