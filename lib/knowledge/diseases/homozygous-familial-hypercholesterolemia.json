  "diagnosticCriteria": {
    "formalCriteriaName": "Simon Broome Criteria (adapted for HoFH)",
    "criteria": [
      {
        "id": "ldl-level",
        "description": "LDL cholesterol levels typically > 500 mg/dL (13 mmol/L) untreated",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in both alleles of LDLR, APOB, PCSK9, or LDLRAP1 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-xanthomas",
        "description": "Presence of tendon and cutaneous xanthomas before age 10",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of heterozygous familial hypercholesterolemia in both parents",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of extremely elevated LDL cholesterol levels plus either genetic confirmation of biallelic pathogenic variants or presence of tendon xanthomas in early childhood",
    "notes": "Genetic testing is critical for definitive diagnosis; clinical features alone may overlap with severe heterozygous FH."
  },
