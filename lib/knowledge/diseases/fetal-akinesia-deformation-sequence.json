  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific laboratory biomarkers"
    ],
    "imaging": [
      "Prenatal ultrasound showing decreased fetal movements and polyhydramnios",
      "Postnatal X-rays demonstrating joint contractures",
      "Chest imaging revealing pulmonary hypoplasia"
    ],
    "genetic": [
      "SLC18A3 (causative)",
      "MYOD1 (causative, loss-of-function)",
      "RAPSN (causative, loss-of-function)",
      "DOK7 (causative, loss-of-function)",
      "MUSK (causative, loss-of-function)",
      "NUP88 (causative, loss-of-function)",
      "GLDN (causative)",
      "KIF21A (causative, loss-of-function)",
      "MAGEL2 (causative)",
      "TUBA1A (causative)",
      "Genetic heterogeneity with autosomal recessive and dominant inheritance patterns"
    ],
    "other": [
      "Electromyography showing reduced fetal muscle activity (if performed postnatally)",
      "Muscle biopsy may show neurogenic atrophy"
    ]
  },
  "differentialDiagnoses": [
