  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and radiological criteria for Atelosteogenesis type I",
    "criteria": [
      {
        "id": "skeletal-dysplasia",
        "description": "Severe skeletal dysplasia with absent or severely hypoplastic long bone ossification",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia, micrognathia, and cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "respiratory-distress",
        "description": "Severe respiratory insufficiency due to thoracic hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-findings",
        "description": "Radiographic evidence of absent ossification of distal long bones and vertebral anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the FLNB gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe skeletal dysplasia with characteristic facial features and radiological findings consistent with Atelosteogenesis type I",
    "notes": "Genetic testing for FLNB mutations can confirm diagnosis but is not mandatory if clinical and radiological criteria are met."
  },
