    "laboratory": [
      "Normal routine blood tests",
      "Possible mild anemia secondary to bruising"
    ],
    "imaging": [
      "Echocardiography showing severe mitral, aortic, and tricuspid valve abnormalities",
      "MRI showing dural ectasia in some patients",
