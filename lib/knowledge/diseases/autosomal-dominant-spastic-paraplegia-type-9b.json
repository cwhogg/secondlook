  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of metabolic and infectious causes"
    ],
    "imaging": [
      "MRI brain and spinal cord typically normal or showing mild corticospinal tract atrophy"
    ],
    "genetic": [
      "ALDH18A1 (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography may show mild peripheral neuropathy",
      "Nerve conduction studies usually normal or mildly abnormal"
    ]
  },
