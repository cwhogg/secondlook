  "diagnosticCriteria": {
    "formalCriteriaName": "Bickerstaff Brainstem Encephalitis Diagnostic Criteria",
    "criteria": [
      {
        "id": "acute-ophthalmoplegia",
        "description": "Acute onset of ophthalmoplegia involving multiple cranial nerves",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ataxia",
        "description": "Cerebellar ataxia manifesting as gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "altered-consciousness",
        "description": "Impaired consciousness ranging from drowsiness to coma",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "anti-gq1b-antibodies",
        "description": "Presence of anti-GQ1b IgG antibodies in serum or CSF",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "brainstem-lesions-on-mri",
        "description": "MRI evidence of brainstem lesions consistent with inflammation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acute ophthalmoplegia and ataxia with supportive laboratory or imaging findings",
    "notes": "Altered consciousness is common but not mandatory; anti-GQ1b antibodies support diagnosis but may be absent."
  },
