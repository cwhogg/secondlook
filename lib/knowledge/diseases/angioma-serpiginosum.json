  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and histopathological diagnosis of Angioma serpiginosum",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of multiple punctate, red to purple, non-blanching macules arranged in a serpiginous or gyrate pattern",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Capillary dilation and proliferation confined to the papillary dermis without endothelial atypia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-systemic-involvement",
        "description": "No evidence of systemic vascular malformations or other angiomatous syndromes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Typical clinical presentation with confirmatory histopathology showing capillary proliferation in papillary dermis",
    "notes": "Dermoscopy and skin biopsy are essential to differentiate from other vascular lesions."
  },
