  "diagnosticCriteria": {
    "formalCriteriaName": "Japanese Ministry of Health and Welfare Diagnostic Criteria for Diffuse Panbronchiolitis",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Chronic cough, sputum production, and exertional dyspnea lasting more than 3 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Bilateral diffuse small nodular shadows and bronchiectasis predominantly in lower lung fields on chest X-ray or CT",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-function",
        "description": "Obstructive ventilatory impairment on pulmonary function tests",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sinusitis",
        "description": "Chronic paranasal sinusitis confirmed clinically or radiologically",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "pathology",
        "description": "Histopathological evidence of chronic inflammatory cell infiltration in respiratory bronchioles",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus characteristic imaging findings; supportive criteria such as sinusitis or pathology strengthen diagnosis",
    "notes": "Diagnosis is clinical and radiological; lung biopsy is rarely required"
  },
