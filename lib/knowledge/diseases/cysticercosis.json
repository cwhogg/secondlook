  "diagnosticCriteria": {
    "formalCriteriaName": "Del Brutto Diagnostic Criteria for Neurocysticercosis",
    "criteria": [
      {
        "id": "imaging",
        "description": "Neuroimaging showing cystic lesions with scolex or typical features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serology",
        "description": "Positive serum or CSF immunological tests for Taenia solium antibodies or antigens",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical",
        "description": "Clinical manifestations compatible with cysticercosis such as seizures or intracranial hypertension",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "epidemiology",
        "description": "Exposure history or residence in endemic area",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of one major neuroimaging criterion plus one minor or supportive criterion",
    "notes": "Definitive diagnosis often requires combination of clinical, imaging, and serological data."
  },
