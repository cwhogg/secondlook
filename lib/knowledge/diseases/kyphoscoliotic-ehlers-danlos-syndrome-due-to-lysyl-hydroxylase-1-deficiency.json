  "differentialDiagnoses": [
    {
      "diseaseId": "classical-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Absence of early-onset kyphoscoliosis",
        "Normal lysyl hydroxylase activity",
        "Different genetic mutations (COL5A1, COL5A2)"
      ]
    },
    {
      "diseaseId": "arthrochalasia-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Severe joint hypermobility with congenital hip dislocation",
        "No lysyl hydroxylase deficiency",
        "Mutations in COL1A1 or COL1A2 genes"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive kyphoscoliosis in infancy",
    "Ocular globe rupture or severe scleral fragility",
    "Arterial rupture or aneurysm in young patients"
  ],
