  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "neurodevelopmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Distinctive craniofacial features including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-defect",
        "description": "Congenital heart defects such as ventricular septal defect or atrial septal defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-anomalies",
        "description": "Skeletal abnormalities including clinodactyly, scoliosis, or brachydactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Detection of 9q21.3 microdeletion by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of neurodevelopmental delay, craniofacial dysmorphism, cardiac defect, and confirmation of 9q21.3 microdeletion",
    "notes": "Diagnosis relies heavily on genetic testing combined with clinical features."
  },
