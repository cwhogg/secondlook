  "keyFindings": {
    "laboratory": [
      "Normal routine prenatal laboratory tests",
      "Genetic testing revealing biallelic mutations in PTHR1 gene"
    ],
    "imaging": [
      "Prenatal and postnatal radiographs showing advanced endochondral ossification",
      "Shortened long bones with metaphyseal irregularities",
      "Narrow thorax with short ribs",
      "Hypoplastic iliac bones"
    ],
    "genetic": [
      "PTH1R (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Perinatal lethality due to respiratory insufficiency",
      "Characteristic craniofacial dysmorphism"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "thanatophoric-dysplasia",
      "distinguishingFeatures": [
        "Less advanced bone maturation",
        "Distinctive curved femurs",
        "Different genetic mutations (FGFR3 gene)"
      ]
    },
    {
      "diseaseId": "achondroplasia",
      "distinguishingFeatures": [
        "Normal or delayed bone maturation",
        "Non-lethal with survival into adulthood",
        "FGFR3 gene mutations distinct from PTHR1"
      ]
    },
    {
      "diseaseId": "hypophosphatasia",
      "distinguishingFeatures": [
        "Low serum alkaline phosphatase",
        "Defective bone mineralization rather than advanced ossification",
        "Mutations in ALPL gene"
      ]
    }
  ],
