      "diseaseId": "mitochondrial-complex-i-deficiency",
      "distinguishingFeatures": [
        "Complex I enzymatic deficiency instead of complex II",
        "Different genetic mutations (e.g., NDUFS genes)",
        "More frequent involvement of basal ganglia on imaging"
      ]
    },
