  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Ring Chromosome 11 Syndrome",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Presence of ring chromosome 11 confirmed by karyotyping or molecular cytogenetic analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Pre- and postnatal growth retardation with microcephaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including micrognathia, hypertelorism, and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital malformations such as cardiac defects or limb anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of ring chromosome 11 plus at least two major clinical features including growth retardation and developmental delay",
    "notes": "Diagnosis relies heavily on cytogenetic analysis; clinical features are supportive but variable."
  },
