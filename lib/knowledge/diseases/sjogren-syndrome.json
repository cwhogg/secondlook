  "diagnosticCriteria": {
    "formalCriteriaName": "2016 ACR/EULAR Classification Criteria for Primary Sjogren Syndrome",
    "criteria": [
      { "id": "ss-1", "description": "Labial salivary gland biopsy with focal lymphocytic sialadenitis and focus score >= 1 foci/4 mm2 (weight: 3)", "category": "major", "requiredForDiagnosis": false },
      { "id": "ss-2", "description": "Anti-SSA/Ro positive (weight: 3)", "category": "major", "requiredForDiagnosis": false },
      { "id": "ss-3", "description": "Ocular staining score >= 5 (or van Bijsterveld score >= 4) in at least one eye (weight: 1)", "category": "minor", "requiredForDiagnosis": false },
      { "id": "ss-4", "description": "Schirmer test <= 5 mm/5 min in at least one eye (weight: 1)", "category": "minor", "requiredForDiagnosis": false },
      { "id": "ss-5", "description": "Unstimulated salivary flow rate <= 0.1 mL/min (weight: 1)", "category": "minor", "requiredForDiagnosis": false }
    ],
    "minimumForDiagnosis": "Total score >= 4 from the weighted criteria items; at least one symptom of ocular or oral dryness as entry criterion",
    "notes": "Exclusions include history of head/neck radiation, active hepatitis C, AIDS, sarcoidosis, amyloidosis, graft-versus-host disease, and IgG4-related disease."
  },
  "symptoms": {
