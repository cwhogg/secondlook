        "Earlier onset and more rapid progression"
      ]
    },
    {
      "diseaseId": "mucopolysaccharidosis-type-6",
      "distinguishingFeatures": [
        "Arylsulfatase B deficiency",
        "Absence of corneal clouding in some cases",
        "Different urinary GAG profile"
      ]
    }
  ],
  "redFlags": [
    "Progressive coarse facial features with skeletal abnormalities",
    "Marked hepatosplenomegaly in infancy or early childhood",
    "Severe joint contractures limiting mobility"
  ],
