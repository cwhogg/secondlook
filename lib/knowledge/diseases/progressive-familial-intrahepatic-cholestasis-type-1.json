  "diagnosticCriteria": {
    "formalCriteriaName": "PFIC Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-cholestasis",
        "description": "Persistent cholestasis with elevated serum bile acids and normal or low gamma-glutamyl transferase (GGT)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the ATP8B1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Liver biopsy showing canalicular cholestasis with bland lobular hepatitis and absence of bile duct paucity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Onset in infancy or early childhood with pruritus, jaundice, and failure to thrive",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent cholestasis with low/normal GGT and identification of ATP8B1 pathogenic mutations",
    "notes": "Liver biopsy and clinical features support diagnosis but are not mandatory if genetic testing is confirmatory."
  },
