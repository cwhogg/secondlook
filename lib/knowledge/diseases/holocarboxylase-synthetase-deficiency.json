  "diagnosticCriteria": {
    "formalCriteriaName": "Biotin-Responsive Multiple Carboxylase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced holocarboxylase synthetase enzyme activity in cultured fibroblasts or lymphocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-markers",
        "description": "Elevated levels of 3-hydroxyisovaleric acid, 3-methylcrotonylglycine, and other organic acids in urine organic acid analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the HLCS gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-response",
        "description": "Clinical and biochemical improvement with pharmacologic doses of biotin",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced holocarboxylase synthetase enzyme activity or pathogenic HLCS gene variants plus characteristic biochemical abnormalities",
    "notes": "Early diagnosis and treatment with biotin is critical to prevent irreversible neurological damage."
  },
