        "requiredForDiagnosis": true
      },
      {
        "id": "renal-magnesium-wasting",
        "description": "Evidence of renal magnesium wasting demonstrated by increased fractional excretion of magnesium",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with magnesium transport (e.g., TRPM6)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of neuromuscular irritability symptoms such as tetany or seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent hypomagnesemia with secondary hypocalcemia and evidence of renal magnesium wasting",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if biochemical and clinical criteria are met."
  },
