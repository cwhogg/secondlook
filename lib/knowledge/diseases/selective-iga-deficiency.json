  "diagnosticCriteria": {
    "formalCriteriaName": "ESID Diagnostic Criteria for Selective IgA Deficiency",
    "criteria": [
      {
        "id": "siga-c1",
        "description": "Serum IgA level <7 mg/dL (0.07 g/L) in a patient older than 4 years",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "siga-c2",
        "description": "Normal serum levels of IgG and IgM",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "siga-c3",
        "description": "Exclusion of other causes of hypogammaglobulinemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "siga-c4",
        "description": "Normal antibody responses to vaccines",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Undetectable serum IgA (<7 mg/dL) with normal IgG and IgM in a patient >4 years old, after exclusion of secondary causes",
    "notes": "Partial IgA deficiency (IgA detectable but >2 SD below mean) is more common but less clinically significant. Most patients are asymptomatic and discovered incidentally. ~10% may progress to CVID."
  },
