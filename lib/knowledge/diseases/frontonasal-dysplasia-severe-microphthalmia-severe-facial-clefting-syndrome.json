  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Frontonasal Dysplasia-Severe Microphthalmia-Severe Facial Clefting Syndrome",
    "criteria": [
      {
        "id": "severe-facial-clefting",
        "description": "Presence of severe midline facial clefting involving the nose and upper lip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-microphthalmia",
        "description": "Bilateral severe microphthalmia or anophthalmia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "frontonasal-dysplasia-features",
        "description": "Frontonasal dysplasia characterized by hypertelorism, broad nasal root, and midline nasal cleft",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-malformations",
        "description": "Additional craniofacial anomalies such as frontal bossing and nasal cartilage hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Variable developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: severe midline facial clefting, bilateral severe microphthalmia, and frontonasal dysplasia features",
    "notes": "Diagnosis is primarily clinical; genetic testing may assist but causative genes are not well established."
  },
