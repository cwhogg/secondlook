  "diagnosticCriteria": {
    "formalCriteriaName": "Aicardi Diagnostic Criteria for Alternating Hemiplegia of Childhood",
    "criteria": [
      {
        "id": "recurrent-hemiplegia",
        "description": "Recurrent episodes of hemiplegia affecting one or both sides of the body",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "onset-before-18-months",
        "description": "Onset of symptoms before 18 months of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "paroxysmal-movements",
        "description": "Presence of paroxysmal abnormal ocular movements or dystonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "symptom-resolution-with-sleep",
        "description": "Complete or partial resolution of symptoms with sleep",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes such as stroke, epilepsy, or metabolic disorders",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent hemiplegic episodes starting before 18 months of age with paroxysmal abnormal movements and symptom resolution with sleep, after exclusion of other causes",
    "notes": "Genetic testing for ATP1A3 mutations supports diagnosis but is not mandatory"
  },
