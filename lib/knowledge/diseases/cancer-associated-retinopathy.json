  "diagnosticCriteria": {
    "formalCriteriaName": "No standardized formal criteria; diagnosis based on clinical, electrophysiological, and immunological findings",
    "criteria": [
      {
        "id": "visual-symptoms",
        "description": "Subacute onset of bilateral visual loss with photopsias and visual field defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroretinogram-abnormalities",
        "description": "Electroretinogram (ERG) showing reduced or extinguished rod and cone responses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anti-retinal-antibodies",
        "description": "Presence of circulating anti-retinal antibodies detected by immunohistochemistry or Western blot",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "underlying-malignancy",
        "description": "Identification of an associated systemic malignancy (e.g., small cell lung carcinoma, gynecologic cancers)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic visual symptoms plus ERG abnormalities and detection of anti-retinal antibodies",
    "notes": "Diagnosis is often clinical and supported by electrophysiological and immunological testing; exclusion of other causes of retinopathy is essential."
  },
