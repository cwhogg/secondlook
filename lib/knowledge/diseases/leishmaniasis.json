  "diagnosticCriteria": {
    "formalCriteriaName": "Leishmaniasis Diagnostic Criteria",
    "criteria": [
      {
        "id": "parasitological-confirmation",
        "description": "Identification of Leishmania parasites in tissue samples by microscopy or culture",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serological-evidence",
        "description": "Positive serological tests such as rK39 immunochromatographic test or direct agglutination test",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-presentation",
        "description": "Characteristic clinical features consistent with cutaneous, mucocutaneous, or visceral leishmaniasis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "molecular-detection",
        "description": "Detection of Leishmania DNA by PCR in clinical specimens",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus parasitological confirmation or positive molecular detection",
    "notes": "Serological tests support diagnosis but may not distinguish between active and past infection."
  },
