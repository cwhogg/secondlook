  "keyFindings": {
    "laboratory": [
      "Abnormal hormone levels indicating hypothalamic-pituitary axis dysfunction",
      "Genetic testing revealing mutations in SHH, ZIC2, SIX3, or TGIF genes"
    ],
    "imaging": [
      "MRI or CT showing incomplete separation of cerebral hemispheres",
      "Absence or hypoplasia of corpus callosum",
      "Midline brain structure abnormalities"
    ],
    "genetic": [
      "Pathogenic variants in SHH gene (most common)",
      "Mutations in ZIC2, SIX3, TGIF1 genes",
      "Autosomal recessive inheritance",
      "Multigenic/multifactorial inheritance",
      "Oligogenic inheritance",
      "X-linked dominant inheritance"
    ],
    "other": [
      "Characteristic midline facial anomalies on physical examination",
      "Developmental and neurological assessment abnormalities"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "septo-optic-dysplasia",
      "distinguishingFeatures": [
        "Optic nerve hypoplasia",
        "Absence of midline brain fusion seen in HPE",
        "Less severe facial anomalies"
      ]
    },
    {
      "diseaseId": "agenesis-of-corpus-callosum",
      "distinguishingFeatures": [
        "Complete or partial absence of corpus callosum without forebrain fusion",
        "No midline facial anomalies typical of HPE",
        "Different genetic causes"
      ]
    },
    {
      "diseaseId": "arhinencephaly",
      "distinguishingFeatures": [
        "Absence of olfactory bulbs and tracts",
        "No fusion of cerebral hemispheres",
        "Distinct facial features"
      ]
    }
  ],
  "redFlags": [
    "Severe midline facial malformations (e.g., cyclopia, proboscis)",
    "Failure to thrive with feeding difficulties",
    "Seizures refractory to treatment"
  ],
