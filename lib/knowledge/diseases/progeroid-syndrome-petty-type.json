  "keyFindings": {
    "laboratory": [
      "Mild anemia with normocytic normochromic profile",
      "Normal metabolic panels with occasional mild liver enzyme elevation"
    ],
    "imaging": [
      "Radiographic evidence of osteolysis in distal phalanges and clavicles",
      "Echocardiography showing valvular abnormalities"
    ],
    "genetic": [
      "SLC25A24 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Skin biopsy showing dermal fibrosis and loss of subcutaneous fat"
    ]
  },
