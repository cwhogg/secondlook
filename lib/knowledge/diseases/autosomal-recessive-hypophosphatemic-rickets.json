  "keyFindings": {
    "laboratory": [
      "Low serum phosphate due to renal phosphate wasting",
      "Normal serum calcium",
      "Elevated serum alkaline phosphatase",
      "Inappropriately normal or low 1,25-dihydroxyvitamin D levels",
      "Elevated FGF23 levels (in some cases)"
    ],
    "imaging": [
      "Radiographic evidence of rickets including metaphyseal cupping and fraying",
      "Bone deformities such as bowed legs and widened growth plates",
      "Possible craniosynostosis on skull imaging"
    ],
    "genetic": [
      "DMP1 (causative)",
      "ENPP1 (causative)",
      "Pathogenic variants in DMP1, ENPP1, or FAM20C genes confirming autosomal recessive inheritance"
    ],
    "other": [
      "Dental abnormalities including enamel hypoplasia and recurrent abscesses"
    ]
  },
