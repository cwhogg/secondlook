  "diagnosticCriteria": {
    "formalCriteriaName": "DPAGT1-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of multisystemic clinical features including developmental delay, hypotonia, and failure to thrive",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "transferrin-analysis",
        "description": "Abnormal serum transferrin isoelectric focusing pattern consistent with type I CDG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the DPAGT1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electromyography showing myopathic or neuropathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy demonstrating reduced glycosylation of alpha-dystroglycan",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus abnormal transferrin isoelectric focusing and confirmation by genetic testing of DPAGT1 mutations",
    "notes": "Diagnosis requires integration of clinical, biochemical, and molecular data."
  },
