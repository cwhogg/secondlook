  "diagnosticCriteria": {
    "formalCriteriaName": "Craniotelencephalic Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "cranial-malformation",
        "description": "Presence of characteristic cranial deformities including abnormal skull shape and size",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "telencephalic-abnormalities",
        "description": "Neuroimaging evidence of telencephalic structural abnormalities such as cortical dysplasia or agenesis of corpus callosum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability manifesting in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Presence of distinctive facial features including hypertelorism and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "Recurrent seizures or epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Diagnosis requires all three major criteria: cranial malformation, telencephalic abnormalities on imaging, and developmental delay.",
    "notes": "Genetic testing may support diagnosis but no specific gene mutation has been definitively associated."
  },
