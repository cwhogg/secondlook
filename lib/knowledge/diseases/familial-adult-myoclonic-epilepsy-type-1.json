  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of metabolic causes of myoclonus"
    ],
    "imaging": [
      "Brain MRI usually normal or nonspecific cortical atrophy in advanced cases"
    ],
    "genetic": [
      "Pentameric repeat expansions in SAMD12 gene (most common)",
      "Other loci: STARD7, MARCH6, YEATS2 gene expansions"
    ],
    "other": [
      "EEG showing cortical reflex myoclonus with giant somatosensory evoked potentials",
      "Electromyography (EMG) demonstrating cortical myoclonus"
    ]
  },
