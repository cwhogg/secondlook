  "differentialDiagnoses": [
    {
      "diseaseId": "crouzon-syndrome",
      "distinguishingFeatures": [
        "Absence of cutis gyrata",
        "Different FGFR2 mutations",
        "Less prominent skin abnormalities"
      ]
    },
    {
      "diseaseId": "pfeiffer-syndrome",
      "distinguishingFeatures": [
        "Broad thumbs and toes",
        "No cutis gyrata",
        "Different craniosynostosis pattern"
      ]
    },
    {
      "diseaseId": "saethre-chotzen-syndrome",
      "distinguishingFeatures": [
        "TWIST1 gene mutations",
        "Ptosis and low-set hairline",
        "No cutis gyrata"
      ]
    }
  ],
