  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for OPD Spectrum Disorder",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial abnormalities including cleft palate, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-dysplasia",
        "description": "Radiographic evidence of skeletal anomalies such as broad clavicles, hypoplastic or absent ribs, and digital anomalies (syndactyly, brachydactyly)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-impairment",
        "description": "Sensorineural or conductive hearing loss documented clinically or by audiometry",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "FLNA-mutation",
        "description": "Identification of pathogenic variants in the FLNA gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic craniofacial dysmorphism and skeletal anomalies plus identification of FLNA pathogenic variant or consistent family history",
    "notes": "Diagnosis is primarily clinical supported by radiological and genetic findings; molecular confirmation is recommended."
  },
