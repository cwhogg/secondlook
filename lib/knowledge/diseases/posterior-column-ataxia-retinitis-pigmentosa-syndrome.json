  "diagnosticCriteria": {
    "formalCriteriaName": "PCARP Diagnostic Criteria",
    "criteria": [
      {
        "id": "ataxia",
        "description": "Progressive sensory ataxia predominantly affecting the posterior columns",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "retinitis-pigmentosa",
        "description": "Bilateral retinitis pigmentosa confirmed by ophthalmological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the FLVCR1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Abnormal somatosensory evoked potentials indicating posterior column dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or affected siblings consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive posterior column ataxia and retinitis pigmentosa with genetic confirmation of FLVCR1 mutation",
    "notes": "Diagnosis is supported by electrophysiological studies and family history but requires genetic confirmation."
  },
