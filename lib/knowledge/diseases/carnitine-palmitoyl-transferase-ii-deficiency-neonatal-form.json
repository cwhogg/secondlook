  "diagnosticCriteria": {
    "formalCriteriaName": "Neonatal CPT II Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early onset of severe metabolic decompensation including hypoketotic hypoglycemia and cardiomyopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-activity",
        "description": "Markedly reduced CPT II enzyme activity in fibroblasts or muscle tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the CPT2 gene consistent with autosomal recessive inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acylcarnitine-profile",
        "description": "Characteristic elevation of long-chain acylcarnitines on plasma acylcarnitine analysis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Histological evidence of lipid accumulation in muscle biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus either reduced CPT II enzyme activity or pathogenic CPT2 gene variants",
    "notes": "Early diagnosis is critical due to rapid progression and high mortality in neonatal period."
  },
