        "description": "Evidence of organ involvement or dysfunction attributable to eosinophilia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of hypereosinophilia including myeloproliferative neoplasms and parasitic infections",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "serum-cytokines",
