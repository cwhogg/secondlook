  "keyFindings": {
    "laboratory": [
      "Normal systemic inflammatory markers",
      "Negative infectious and autoimmune serologies"
    ],
    "imaging": [
      "Fluorescein angiography showing retinal arterial aneurysms and peripheral ischemia",
      "Optical coherence tomography (OCT) demonstrating macular edema",
      "Fundus photography revealing optic disc swelling and peripapillary exudates"
    ],
