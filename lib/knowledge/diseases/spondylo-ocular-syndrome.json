  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild elevation of inflammatory markers during complications"
    ],
    "imaging": [
      "Radiographs showing platyspondyly and epiphyseal dysplasia",
      "Ocular ultrasound demonstrating cataracts and retinal detachment"
    ],
    "genetic": [
      "XYLT2 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Audiometry confirming sensorineural hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "stickler-syndrome",
      "distinguishingFeatures": [
        "Presence of cleft palate and midfacial hypoplasia",
        "COL2A1 or COL11A1 mutations",
        "More prominent hearing loss and vitreoretinal degeneration"
      ]
    },
    {
      "diseaseId": "mucopolysaccharidosis-type-iva",
      "distinguishingFeatures": [
        "Corneal clouding and coarse facial features",
        "Deficiency of N-acetylgalactosamine-6-sulfatase",
        "Elevated urinary glycosaminoglycans"
      ]
    }
  ],
