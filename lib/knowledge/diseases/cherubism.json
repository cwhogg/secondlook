  "diagnosticCriteria": {
    "formalCriteriaName": "Cherubism Diagnostic Criteria",
    "criteria": [
      {
        "id": "bilateral-jaw-swelling",
        "description": "Bilateral painless swelling of the mandible and/or maxilla",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-fibro-osseous-lesions",
        "description": "Multilocular radiolucent lesions in the jaw bones on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic SH3BP2 gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Fibro-osseous tissue with multinucleated giant cells on biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral jaw swelling with characteristic radiographic lesions; genetic testing or family history supportive but not mandatory",
    "notes": "Diagnosis is primarily clinical and radiographic; genetic confirmation supports diagnosis"
  },
