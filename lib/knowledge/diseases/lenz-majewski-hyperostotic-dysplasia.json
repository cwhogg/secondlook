  "diagnosticCriteria": {
    "formalCriteriaName": "Lenz-Majewski Hyperostotic Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "hyperostosis",
        "description": "Generalized hyperostosis involving cranial and long bones detected by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-hypertrichosis",
        "description": "Congenital cutaneous hypertrichosis with thickened skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including brachycephaly, hypertelorism, and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation with short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized hyperostosis, intellectual disability, and cutaneous hypertrichosis",
    "notes": "Diagnosis is supported by identification of pathogenic mutations in the PTDSS1 gene."
  },
