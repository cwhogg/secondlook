  "diagnosticCriteria": {
    "formalCriteriaName": "Toluene Embryopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "prenatal-exposure",
        "description": "Confirmed or strongly suspected prenatal exposure to toluene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphology",
        "description": "Presence of characteristic craniofacial anomalies including microcephaly, midface hypoplasia, and short palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurodevelopmental-delay",
        "description": "Global developmental delay or intellectual disability evident in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Presence of limb anomalies such as camptodactyly or joint contractures",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Pre- and postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed prenatal toluene exposure plus presence of at least two major criteria",
    "notes": "Diagnosis is clinical and relies heavily on history of maternal solvent abuse and characteristic phenotype."
  },
