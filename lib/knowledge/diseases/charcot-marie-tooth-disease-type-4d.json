  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for CMT4D",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive distal muscle weakness and atrophy with sensory loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-conduction-studies",
        "description": "Severely reduced motor and sensory nerve conduction velocities consistent with demyelinating neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the NDRG1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consistent autosomal recessive inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Onion bulb formations and demyelination on sural nerve biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal muscle weakness and sensory loss, demyelinating nerve conduction studies, and pathogenic NDRG1 mutation",
    "notes": "Genetic confirmation is essential for definitive diagnosis."
  },
