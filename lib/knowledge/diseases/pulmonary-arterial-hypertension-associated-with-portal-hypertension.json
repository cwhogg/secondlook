  "diagnosticCriteria": {
    "formalCriteriaName": "Portopulmonary Hypertension Diagnostic Criteria",
    "criteria": [
      {
        "id": "mean-pap",
        "description": "Mean pulmonary arterial pressure (mPAP) ≥ 25 mmHg at rest measured by right heart catheterization",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-capillary-wedge-pressure",
        "description": "Pulmonary capillary wedge pressure (PCWP) ≤ 15 mmHg to exclude left heart disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "portal-hypertension-evidence",
        "description": "Clinical, radiological, or histological evidence of portal hypertension",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-vascular-resistance",
        "description": "Elevated pulmonary vascular resistance (PVR) > 3 Wood units",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of pulmonary hypertension such as left heart disease, lung disease, or thromboembolic disease",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of portal hypertension plus mPAP ≥ 25 mmHg at rest with PCWP ≤ 15 mmHg and exclusion of other causes of pulmonary hypertension",
    "notes": "Right heart catheterization is the gold standard for diagnosis."
