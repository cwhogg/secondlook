        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cleft-lip",
        "description": "Unilateral or bilateral cleft lip with or without cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Additional facial dysmorphic features such as broad nasal bridge and low-set ears",
