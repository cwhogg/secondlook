  "keyFindings": {
    "laboratory": [
      "Elevated serum IgG4 (>135 mg/dL; present in 50-70%)",
      "Elevated total IgG (polyclonal hypergammaglobulinemia)",
      "Elevated IgE and peripheral eosinophilia (40-50%)",
      "Hypocomplementemia (low C3/C4; ~50%, especially with renal involvement)",
      "Elevated ESR",
      "Elevated serum IgG4:IgG ratio",
      "CA 19-9 mildly elevated (in pancreaticobiliary involvement)"
    ],
    "imaging": [
      "CT/MRI: organ enlargement with delayed enhancement (pancreas, salivary glands, kidneys)",
      "CT: sausage-shaped pancreas with capsule-like rim",
      "MRCP: biliary strictures (can mimic PSC or cholangiocarcinoma)",
      "CT: retroperitoneal soft tissue around aorta and ureters",
      "PET-CT: FDG-avid lesions in multiple organs"
    ],
    "genetic": [
      "HLA-DRB1*0405 and HLA-DQB1*0401 associations (Japanese population)",
      "No established monogenic cause",
      "CFHR1-CFHR3 deletion reported"
    ],
    "other": [
      "Tissue biopsy (gold standard): dense lymphoplasmacytic infiltrate, storiform fibrosis, obliterative phlebitis, IgG4+ plasma cells >10/HPF with IgG4:IgG ratio >40%",
      "Core needle biopsy preferred over FNA (architectural assessment needed)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sjogren-syndrome",
      "distinguishingFeatures": [
        "Anti-Ro/La antibodies",
        "Sicca symptoms predominant",
        "Lymphocytic infiltrate without storiform fibrosis",
        "No elevated IgG4"
      ]
    },
    {
      "diseaseId": "primary-sclerosing-cholangitis",
      "distinguishingFeatures": [
        "IBD association",
        "Intrahepatic duct involvement",
        "No IgG4 elevation",
        "Does not respond to steroids"
      ]
    },
    {
      "diseaseId": "granulomatosis-with-polyangiitis",
      "distinguishingFeatures": [
        "PR3-ANCA positive",
        "Necrotizing granulomas",
        "ENT destruction",
        "Pulmonary cavitating nodules"
      ]
    },
    {
      "diseaseId": "lymphoma",
      "distinguishingFeatures": [
        "Monoclonal lymphoid population",
        "Atypical cells on biopsy",
        "Flow cytometry abnormalities",
        "B symptoms more prominent"
      ]
    },
    {
      "diseaseId": "multicentric-castleman-disease",
      "distinguishingFeatures": [
        "IL-6 driven",
        "Multicentric lymphadenopathy",
        "HHV-8 association",
        "Different histology"
      ]
    }
  ],
  "redFlags": [
    "Mass lesion mimicking malignancy (must exclude cancer, especially pancreatic/biliary)",
    "Bilateral ureteral obstruction from retroperitoneal fibrosis",
    "Aortic aneurysm or periaortic disease",
    "Compressive optic neuropathy from orbital disease",
    "Failure to respond to glucocorticoids (reconsider diagnosis)",
    "Progressive renal insufficiency from tubulointerstitial nephritis"
  ],
