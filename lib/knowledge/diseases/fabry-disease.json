  "diagnosticCriteria": {
    "formalCriteriaName": "Expert consensus diagnostic criteria for Fabry disease",
    "criteria": [
      {
        "id": "fab-c1",
        "description": "Deficient alpha-galactosidase A enzyme activity in plasma or leukocytes (males: <1% of normal; diagnostic)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "fab-c2",
        "description": "Pathogenic variant identified in GLA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fab-c3",
        "description": "Elevated plasma or urinary globotriaosylsphingosine (lyso-Gb3)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "fab-c4",
        "description": "Elevated plasma or urinary globotriaosylceramide (Gb3)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "fab-c5",
        "description": "Characteristic clinical features (acroparesthesias, angiokeratomas, cornea verticillata, renal, cardiac, or cerebrovascular involvement)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "fab-c6",
        "description": "Tissue biopsy showing globotriaosylceramide inclusions (lamellar bodies on electron microscopy)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Males: deficient alpha-galactosidase A activity plus GLA mutation. Females: GLA mutation required (enzyme activity may be normal due to random X-inactivation); clinical features and elevated lyso-Gb3 are supportive.",
    "notes": "X-linked inheritance. Heterozygous females can be significantly affected. Late-onset cardiac and renal variants exist with residual enzyme activity and predominantly single-organ involvement. Newborn screening is available in some regions."
  },
