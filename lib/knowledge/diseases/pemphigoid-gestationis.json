  "diagnosticCriteria": {
    "formalCriteriaName": "Pemphigoid Gestationis Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Pruritic urticarial plaques and tense blisters appearing during pregnancy or postpartum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "direct-immunofluorescence",
        "description": "Linear deposition of complement component C3 (with or without IgG) along the basement membrane zone on direct immunofluorescence of perilesional skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serologic-testing",
        "description": "Detection of circulating IgG autoantibodies against BP180 (type XVII collagen) by ELISA or immunoblot",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Subepidermal blister with eosinophilic infiltrate on skin biopsy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus positive direct immunofluorescence findings",
    "notes": "Serologic and histopathologic findings support diagnosis but are not mandatory if clinical and DIF findings are conclusive."
  },
