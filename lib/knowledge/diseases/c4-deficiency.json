  "keyFindings": {
    "laboratory": [
      "Low or absent serum C4 complement levels",
      "Normal or low C3 complement levels",
      "Positive antinuclear antibodies (ANA) in autoimmune cases",
      "Elevated inflammatory markers during infections or autoimmune flares"
    ],
    "imaging": [
      "Renal ultrasound or biopsy findings consistent with glomerulonephritis",
      "MRI brain in cases with CNS vasculitis"
    ],
    "genetic": [
      "Mutations or deletions in C4A or C4B genes detected by molecular genetic testing",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Reduced total hemolytic complement activity (CH50)",
      "Family history of complement deficiencies or autoimmune diseases"
    ]
  },
