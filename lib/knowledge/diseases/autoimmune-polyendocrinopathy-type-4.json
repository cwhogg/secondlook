    "formalCriteriaName": "Autoimmune Polyendocrinopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "multiple-autoimmune-endocrinopathies",
        "description": "Presence of two or more autoimmune endocrine gland failures excluding those defining APS types 1 and 2",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoimmune-non-endocrine-manifestations",
        "description": "Presence of autoimmune non-endocrine manifestations such as alopecia, vitiligo, or autoimmune gastritis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-aps1-aps2",
        "description": "Exclusion of APS type 1 and type 2 by clinical and genetic criteria",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of at least two autoimmune endocrine gland failures not attributable to APS types 1 or 2, with exclusion of APS1 and APS2 by clinical and genetic evaluation",
    "notes": "APS type 4 is a diagnosis of exclusion after ruling out APS types 1 and 2."
  },
