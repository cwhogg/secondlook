  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for PIK3CA-Related Overgrowth Spectrum",
    "criteria": [
      {
        "id": "somatic-pik3ca-mutation",
        "description": "Presence of somatic activating mutation in PIK3CA gene confirmed by molecular testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "segmental-overgrowth",
        "description": "Asymmetric segmental overgrowth of soft tissue, bone, or both",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vascular-malformations",
        "description": "Presence of vascular anomalies such as capillary, venous, or lymphatic malformations",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-overgrowth-syndromes",
        "description": "Exclusion of other genetic overgrowth syndromes by clinical and molecular evaluation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of somatic activating PIK3CA mutation plus clinical evidence of segmental overgrowth",
    "notes": "Molecular confirmation is critical due to phenotypic overlap with other overgrowth syndromes."
  },
