  "keyFindings": {
    "laboratory": [
      "Low serum phosphate",
      "Elevated alkaline phosphatase",
      "Normal serum calcium",
      "Normal urinary calcium excretion (normocalciuria)",
      "Inappropriately normal or low 1,25-dihydroxyvitamin D levels"
    ],
    "imaging": [
      "Radiographic evidence of rickets (metaphyseal cupping and fraying)",
      "Bone deformities such as genu valgum",
      "Absence of nephrocalcinosis"
    ],
    "genetic": [
      "KMT2D (causative)",
      "KDM6A (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Family history consistent with autosomal dominant inheritance"
    ]
  },
