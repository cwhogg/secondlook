  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for Autosomal Recessive Cutis Laxa Type 2",
    "criteria": [
      {
        "id": "skin-laxity",
        "description": "Generalized loose, sagging, and inelastic skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Severe postnatal growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glycosylation-defect",
        "description": "Biochemical evidence of combined N- and O-linked glycosylation defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Radiological evidence of skeletal dysplasia including metaphyseal widening",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the ATP6V0A2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of generalized skin laxity, growth retardation, biochemical glycosylation defects, and confirmation of ATP6V0A2 mutation",
    "notes": "Diagnosis requires integration of clinical, biochemical, and genetic findings."
  },
