  "diagnosticCriteria": {
    "formalCriteriaName": "Juvenile Polyposis Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "multiple-juvenile-polyps",
        "description": "Presence of more than five juvenile polyps in the colorectum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "juvenile-polyps-anywhere-git",
        "description": "Multiple juvenile polyps throughout the gastrointestinal tract",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history-jps",
        "description": "Any number of juvenile polyps with a family history of juvenile polyposis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pathogenic-mutation",
        "description": "Identification of pathogenic mutation in SMAD4 or BMPR1A genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of more than five juvenile polyps in the colorectum OR any number of juvenile polyps with a family history of juvenile polyposis",
    "notes": "Genetic testing for SMAD4 and BMPR1A mutations supports diagnosis but is not mandatory."
  },
