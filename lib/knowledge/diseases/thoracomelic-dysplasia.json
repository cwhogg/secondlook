  "diagnosticCriteria": {
    "formalCriteriaName": "Thoracomelic Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "vertebral-malformations",
        "description": "Presence of severe vertebral segmentation defects including thoracic and lumbar vertebrae malformations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Postaxial polydactyly and mesomelic limb shortening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-features",
        "description": "Characteristic craniofacial dysmorphism including micrognathia and midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiographic-findings",
        "description": "Radiographic evidence of thoracic cage abnormalities and rib anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of vertebral malformations, limb malformations, and radiographic thoracic cage abnormalities",
    "notes": "Genetic testing for mutations in the HOXD13 gene may support diagnosis but is not mandatory"
  },
