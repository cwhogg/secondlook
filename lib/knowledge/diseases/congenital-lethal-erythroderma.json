        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-barrier-defect",
        "description": "Evidence of severe skin barrier dysfunction with scaling and fissuring",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fatal-neonatal-course",
        "description": "Progressive clinical deterioration leading to death in the neonatal period",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing epidermal hyperplasia with parakeratosis and inflammatory infiltrate",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with congenital erythroderma syndromes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized erythroderma at birth, severe skin barrier defect, and fatal neonatal course",
    "notes": "Diagnosis is primarily clinical; genetic testing and histopathology support but are not mandatory."
  },
