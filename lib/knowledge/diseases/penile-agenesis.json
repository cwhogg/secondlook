  "keyFindings": {
    "laboratory": [
      "Urinalysis may show signs of infection or hematuria"
    ],
    "imaging": [
      "Ultrasound of pelvis and genitourinary tract to confirm absence of penis and assess internal genitalia",
      "Voiding cystourethrogram to evaluate urethral anatomy and vesicoureteral reflux"
    ],
    "genetic": [
      "No consistent genetic mutation identified; sporadic cases predominate"
    ],
    "other": [
      "Physical examination revealing absent penile structure with normally developed scrotum"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "micropenis",
      "distinguishingFeatures": [
        "Presence of a small but identifiable penile structure",
        "Normal urethral meatus location"
      ]
    },
    {
      "diseaseId": "penile-hypoplasia",
      "distinguishingFeatures": [
        "Underdeveloped but present penis",
        "Usually normal urethral opening"
      ]
    },
    {
      "diseaseId": "bladder-exstrophy-epispadias-complex",
      "distinguishingFeatures": [
        "Exposed bladder mucosa on lower abdomen",
        "Epispadias with dorsal urethral opening"
      ]
    }
  ],
  "redFlags": [
    "Complete absence of penile tissue at birth",
    "Ectopic urethral meatus causing urinary retention or recurrent infections",
    "Associated renal anomalies or urinary tract obstruction"
  ],
