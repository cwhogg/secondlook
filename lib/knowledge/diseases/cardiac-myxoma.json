  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP due to inflammatory cytokine release",
      "Anemia of chronic disease"
    ],
    "imaging": [
      "Echocardiography showing a pedunculated mass in the left atrium",
      "Cardiac MRI demonstrating tumor size and attachment",
      "Chest X-ray may show cardiomegaly"
    ],
    "genetic": [
      "Rare familial cases associated with Carney complex (PRKAR1A gene mutations)"
    ],
    "other": [
      "Histopathology showing myxoid stroma with scattered cells"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "atrial-thrombus",
