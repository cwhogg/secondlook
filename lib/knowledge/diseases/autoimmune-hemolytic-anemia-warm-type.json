  "diagnosticCriteria": {
    "formalCriteriaName": "Warm Autoimmune Hemolytic Anemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "positive-dat",
        "description": "Positive direct antiglobulin test (DAT) with IgG antibodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "evidence-hemolysis",
        "description": "Laboratory evidence of hemolysis including elevated LDH, indirect hyperbilirubinemia, and low haptoglobin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anemia",
        "description": "Presence of anemia with reticulocytosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of hemolytic anemia such as hereditary spherocytosis or cold agglutinin disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Positive DAT with IgG antibodies plus laboratory evidence of hemolysis and anemia",
    "notes": "Diagnosis requires exclusion of cold agglutinin disease and other hemolytic anemias."
  },
