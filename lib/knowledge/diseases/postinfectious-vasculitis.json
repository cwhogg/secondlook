  "diagnosticCriteria": {
    "formalCriteriaName": "Postinfectious Vasculitis Diagnostic Criteria",
    "criteria": [
      {
        "id": "recent-infection",
        "description": "History of recent or concurrent infection preceding vasculitis onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Biopsy demonstrating necrotizing or leukocytoclastic vasculitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-vasculitis",
        "description": "Exclusion of primary systemic vasculitis and other mimicking conditions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical signs consistent with small or medium vessel vasculitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "laboratory-evidence",
        "description": "Elevated inflammatory markers and absence of autoantibodies typical for primary vasculitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Recent infection plus histopathologic confirmation of vasculitis and exclusion of primary vasculitis",
    "notes": "Diagnosis relies on temporal association with infection and exclusion of other vasculitides."
  },
