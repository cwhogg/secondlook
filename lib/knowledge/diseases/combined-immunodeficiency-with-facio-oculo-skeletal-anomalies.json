  "diagnosticCriteria": {
    "formalCriteriaName": "No formal criteria established",
    "criteria": [
      {
        "id": "immunodeficiency",
        "description": "Evidence of combined immunodeficiency with decreased T and B lymphocyte function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial anomalies including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "Presence of ocular abnormalities such as strabismus, ptosis, or coloboma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-anomalies",
        "description": "Skeletal malformations including clinodactyly, scoliosis, or joint contractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with combined immunodeficiency syndromes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of combined immunodeficiency plus at least two of the following: facial anomalies, ocular anomalies, or skeletal anomalies",
    "notes": "Diagnosis is primarily clinical supported by immunological and genetic testing."
  },
