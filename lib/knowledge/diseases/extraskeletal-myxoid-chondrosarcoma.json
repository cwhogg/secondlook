  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological and Molecular Diagnostic Criteria for Extraskeletal Myxoid Chondrosarcoma",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of multinodular architecture with abundant myxoid matrix and uniform spindle to oval cells arranged in cords or strands",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Expression of vimentin and variable expression of S-100 protein; negative for epithelial markers",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-fusion",
        "description": "Detection of characteristic NR4A3 gene rearrangement, most commonly EWSR1-NR4A3 fusion by FISH or RT-PCR",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Histopathological features consistent with EMC plus detection of NR4A3 gene rearrangement",
    "notes": "Molecular confirmation is critical due to overlap with other myxoid soft tissue tumors."
  },
