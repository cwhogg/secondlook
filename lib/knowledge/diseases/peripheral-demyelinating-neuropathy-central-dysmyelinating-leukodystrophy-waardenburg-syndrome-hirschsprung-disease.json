  "diagnosticCriteria": {
    "formalCriteriaName": "Composite Diagnostic Criteria for PDN-CDL-WS-Hirschsprung Complex",
    "criteria": [
      {
        "id": "peripheral-neuropathy",
        "description": "Clinical and electrophysiological evidence of peripheral demyelinating neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "central-leukodystrophy",
        "description": "MRI evidence of central nervous system dysmyelination consistent with leukodystrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "waardenburg-features",
        "description": "Presence of Waardenburg syndrome features including sensorineural hearing loss and pigmentary abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hirschsprung-disease",
        "description": "Histopathological confirmation of Hirschsprung disease with aganglionosis in the distal colon",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with combined neuropathy, leukodystrophy, Waardenburg syndrome, or Hirschsprung disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical and diagnostic evidence of peripheral demyelinating neuropathy, central dysmyelinating leukodystrophy on MRI, Waardenburg syndrome features, and histopathological confirmation of Hirschsprung disease",
    "notes": "Diagnosis requires multidisciplinary evaluation including neurology, genetics, otolaryngology, and gastroenterology assessments."
  },
