  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Dowling-Degos Disease",
    "criteria": [
      {
        "id": "reticulate-hyperpigmentation",
        "description": "Presence of reticulate hyperpigmentation predominantly affecting flexural areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "comedo-like-lesions",
        "description": "Comedo-like lesions and pitted scars on the face and neck",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Histopathological findings showing elongated, branching rete ridges with increased pigmentation of the basal layer",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reticulate hyperpigmentation in flexural areas plus either comedo-like lesions or supportive histopathology findings",
    "notes": "Genetic testing for KRT5 mutations can support diagnosis but is not mandatory"
  },
