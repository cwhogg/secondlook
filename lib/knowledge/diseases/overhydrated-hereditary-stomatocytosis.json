  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Overhydrated Hereditary Stomatocytosis",
    "criteria": [
      {
        "id": "hemolytic-anemia",
        "description": "Presence of chronic hemolytic anemia with reticulocytosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "stomatocytes-on-peripheral-smear",
        "description": "Identification of increased stomatocytes on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "erythrocyte-overhydration",
        "description": "Demonstration of erythrocyte overhydration by osmotic gradient ektacytometry or other specialized tests",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in PIEZO1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-hemolytic-anemias",
        "description": "Exclusion of other causes of hemolytic anemia such as hereditary spherocytosis or paroxysmal nocturnal hemoglobinuria",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic hemolytic anemia with stomatocytes on peripheral smear and evidence of erythrocyte overhydration",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory"
  },
