  "keyFindings": {
    "laboratory": [
      "Genetic testing revealing mutations in the NDP gene"
    ],
    "imaging": [
      "Ocular ultrasound or MRI showing retinal malformations and pseudoglioma",
      "Brain MRI may show associated abnormalities in some cases"
    ],
    "genetic": [
      "Pathogenic variants in the NDP gene located on chromosome Xp11.3"
    ],
    "other": [
      "Electroretinography showing absent or severely reduced retinal responses",
      "Audiometry demonstrating progressive sensorineural hearing loss"
    ]
  },
  "differentialDiagnoses": [
