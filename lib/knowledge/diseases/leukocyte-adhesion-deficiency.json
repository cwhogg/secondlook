  "diagnosticCriteria": {
    "formalCriteriaName": "Leukocyte Adhesion Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "delayed-separation-umbilical-cord",
        "description": "Delayed separation of the umbilical cord beyond 3 weeks of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-bacterial-infections",
        "description": "Recurrent severe bacterial infections without pus formation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neutrophilia",
        "description": "Marked neutrophilia in peripheral blood with impaired neutrophil migration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "flow-cytometry-cd18",
        "description": "Flow cytometry showing absent or reduced CD18 expression on leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in ITGB2 gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of delayed umbilical cord separation, recurrent severe bacterial infections without pus, neutrophilia, and demonstration of absent/reduced CD18 expression",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if clinical and laboratory criteria are met."
  },
