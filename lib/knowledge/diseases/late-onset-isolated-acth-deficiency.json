  "keyFindings": {
    "laboratory": [
      "Low plasma ACTH levels with low serum cortisol",
      "Normal levels of other pituitary hormones (TSH, LH, FSH, GH, prolactin)",
      "Hyponatremia and hypoglycemia on metabolic panel"
    ],
    "imaging": [
      "Normal pituitary MRI without mass or structural abnormalities"
    ],
    "genetic": [
      "Rare mutations in POMC or TPIT genes reported in familial cases"
    ],
    "other": [
      "Clinical improvement with glucocorticoid replacement therapy"
    ]
  },
