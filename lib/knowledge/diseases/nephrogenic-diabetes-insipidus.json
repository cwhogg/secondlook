  "diagnosticCriteria": {
    "formalCriteriaName": "Nephrogenic Diabetes Insipidus Diagnostic Criteria",
    "criteria": [
      {
        "id": "polyuria-polydipsia",
        "description": "Presence of persistent polyuria and polydipsia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "water-deprivation-test",
        "description": "Water deprivation test showing inability to concentrate urine despite dehydration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vasopressin-response",
        "description": "Lack of increase in urine osmolality after administration of exogenous vasopressin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in AVPR2 or AQP2 genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of polyuria and polydipsia with failure to concentrate urine after water deprivation and no response to vasopressin administration",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory."
  },
