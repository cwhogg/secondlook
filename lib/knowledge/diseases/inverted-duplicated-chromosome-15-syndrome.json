  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild metabolic abnormalities secondary to seizures"
    ],
    "imaging": [
      "Brain MRI may show nonspecific cerebral atrophy or delayed myelination",
      "Spinal X-rays may reveal scoliosis"
    ],
    "genetic": [
      "Presence of inverted duplicated chromosome 15 detected by karyotyping or FISH",
      "Array CGH showing duplication of 15q11-q13 region"
    ],
    "other": [
      "EEG abnormalities consistent with epilepsy",
      "Developmental assessments confirming intellectual disability"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "prader-willi-syndrome",
      "distinguishingFeatures": [
        "Hypotonia with hyperphagia and obesity in later infancy",
        "Paternal deletion or maternal uniparental disomy of 15q11-q13",
        "Distinct facial features and endocrine abnormalities"
      ]
    },
    {
      "diseaseId": "angelman-syndrome",
      "distinguishingFeatures": [
        "Severe intellectual disability with ataxia and frequent laughter",
        "Maternal deletion or mutation of UBE3A gene on 15q11-q13",
        "Characteristic EEG pattern and microcephaly"
      ]
    }
  ],
