  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate)",
      "Electromyography showing myopathic changes"
    ],
    "imaging": [
      "Muscle MRI demonstrating distal muscle atrophy and fatty replacement"
    ],
    "genetic": [
      "NOTCH2NLC (causative)",
      "LRP12 (causative)",
      "GIPC1 (causative)",
      "ABCD3 (causative)",
      "NUTM2B-AS1 (causative)",
      "RILPL1 (causative)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy with rimmed vacuoles, fiber size variation, and endomysial fibrosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "oculopharyngeal-muscular-dystrophy",
      "distinguishingFeatures": [
        "Proximal rather than distal muscle weakness predominates",
        "PABPN1 gene mutations",
        "Later onset typically after 50 years"
      ]
    },
    {
      "diseaseId": "inclusion-body-myopathy",
      "distinguishingFeatures": [
        "More prominent proximal muscle involvement",
        "Presence of inclusion bodies on muscle biopsy",
        "Associated with mutations in GNE or other genes"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of respiratory failure",
    "Severe dysphagia with aspiration pneumonia",
    "Sudden cardiac arrhythmias or conduction block"
  ],
