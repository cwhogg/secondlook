  "diagnosticCriteria": {
    "formalCriteriaName": "Schankin Criteria for Visual Snow Syndrome",
    "criteria": [
      {
        "id": "persistent-visual-snow",
        "description": "Presence of continuous tiny flickering dots throughout the visual field for more than 3 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "additional-visual-disturbances",
        "description": "At least two additional visual symptoms such as palinopsia, enhanced entoptic phenomena, photophobia, or nyctalopia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "No evidence of other neurological or ophthalmological disorders explaining the symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-neuroimaging",
        "description": "Normal brain MRI or other imaging studies excluding structural lesions",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent visual snow plus at least two additional visual symptoms and exclusion of other causes",
    "notes": "Diagnosis is clinical and requires exclusion of mimicking conditions."
  },
