  "keyFindings": {
    "laboratory": [
      "Positive blood culture for bacterial or fungal pathogens",
      "Elevated C-reactive protein (CRP) and procalcitonin levels",
      "Leukocytosis or leukopenia with left shift",
      "Thrombocytopenia"
    ],
    "imaging": [
      "Chest X-ray showing infiltrates or pneumonia",
      "Abdominal ultrasound may show bowel wall thickening or ascites"
    ],
    "genetic": [],
    "other": [
      "Clinical signs of systemic inflammatory response syndrome (SIRS)",
      "Hemodynamic instability requiring vasopressors"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "respiratory-distress-syndrome-in-premature-infants",
      "distinguishingFeatures": [
        "Primarily respiratory symptoms without systemic inflammatory signs",
        "No positive blood cultures",
        "Improvement with surfactant therapy"
      ]
    },
    {
      "diseaseId": "necrotizing-enterocolitis",
      "distinguishingFeatures": [
        "Marked abdominal distension and bloody stools",
        "Radiographic evidence of pneumatosis intestinalis",
        "Usually occurs after enteral feeding initiation"
      ]
    }
  ],
  "redFlags": [
    "Persistent apnea or bradycardia episodes",
    "Rapid progression to septic shock",
    "Poor perfusion with mottled or cyanotic skin"
  ],
