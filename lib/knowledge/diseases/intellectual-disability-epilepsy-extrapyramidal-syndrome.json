  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests excluding metabolic causes",
      "Possible mild elevation of lactate in some cases"
    ],
    "imaging": [
      "Brain MRI may show nonspecific cerebral atrophy or basal ganglia abnormalities"
    ],
    "genetic": [
      "DEAF1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "EEG demonstrating epileptiform discharges consistent with epilepsy"
    ]
  },
