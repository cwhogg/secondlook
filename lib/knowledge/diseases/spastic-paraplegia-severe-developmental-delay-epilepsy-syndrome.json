  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Spastic Paraplegia-Severe Developmental Delay-Epilepsy Syndrome",
    "criteria": [
      {
        "id": "spasticity",
        "description": "Progressive lower limb spasticity and hyperreflexia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Severe global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epilepsy",
        "description": "Early-onset epilepsy with variable seizure types",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in associated genes (e.g., SPG-related genes)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuroimaging",
        "description": "Brain MRI showing nonspecific white matter abnormalities or corpus callosum thinning",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: progressive spastic paraplegia, severe developmental delay, and epilepsy",
    "notes": "Genetic testing is recommended to confirm diagnosis and exclude phenocopies."
  },
