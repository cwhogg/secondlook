  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Schwannomatosis",
    "criteria": [
      {
        "id": "multiple-schwannomas",
        "description": "Presence of two or more non-intradermal schwannomas, at least one histologically confirmed",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-vpn-mutation",
        "description": "No evidence of NF2 gene mutation or vestibular schwannomas on MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pain-symptom",
        "description": "Chronic localized or multifocal neuropathic pain associated with schwannomas",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history consistent with schwannomatosis or known SMARCB1/LZTR1 mutation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Two or more non-intradermal schwannomas confirmed by histology, absence of NF2 mutation and vestibular schwannomas on MRI",
    "notes": "Genetic testing for SMARCB1 and LZTR1 mutations supports diagnosis but is not mandatory"
  },
