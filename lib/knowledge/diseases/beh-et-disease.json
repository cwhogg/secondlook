    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "Presence of specific autoantibodies (ANA, anti-dsDNA)",
        "Different pattern of skin rash (malar rash)",
        "Renal involvement with immune complex deposition"
      ]
    },
    {
      "diseaseId": "reactive-arthritis",
      "distinguishingFeatures": [
        "Preceding infection history",
        "Asymmetric oligoarthritis",
        "Lack of recurrent oral and genital ulcers"
      ]
    },
    {
      "diseaseId": "sarcoidosis",
      "distinguishingFeatures": [
        "Non-caseating granulomas on biopsy",
        "Pulmonary involvement with hilar lymphadenopathy",
        "Lack of recurrent mucosal ulcers"
      ]
    }
  ],
  "redFlags": [
    "Sudden vision loss or severe ocular pain",
    "Signs of central nervous system vasculitis or stroke",
    "Massive hemoptysis indicating pulmonary artery aneurysm rupture"
  ],
