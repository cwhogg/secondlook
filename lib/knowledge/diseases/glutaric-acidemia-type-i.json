  "diagnosticCriteria": {
    "formalCriteriaName": "Glutaric Acidemia Type I Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of glutaryl-CoA dehydrogenase enzyme activity in fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-markers",
        "description": "Elevated glutaric acid and 3-hydroxyglutaric acid in urine organic acid analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the GCDH gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of macrocephaly and/or acute dystonia episodes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuroimaging",
        "description": "Characteristic basal ganglia abnormalities on MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of enzyme deficiency or pathogenic GCDH variants plus elevated urinary glutaric acid metabolites",
    "notes": "Early diagnosis is critical to prevent irreversible neurological damage."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Macrocephaly",
        "frequency": 0.85,
        "bodySystem": "neurological",
        "notes": "Often present at birth or early infancy"
      },
      {
        "symptomName": "Acute dystonic crises",
        "frequency": 0.75,
        "bodySystem": "neurological",
        "notes": "Triggered by intercurrent illness or metabolic stress",
        "searchTerms": [
          "sudden muscle contractions and spasms",
          "acute dystonia episodes",
          "involuntary muscle twisting crises"
        ]
      },
      {
        "symptomName": "Characteristic basal ganglia lesions",
        "frequency": 0.7,
        "bodySystem": "neurological",
        "notes": "Visible on MRI during acute encephalopathic episodes",
        "searchTerms": [
          "typical brain lesions in basal ganglia",
          "characteristic deep brain abnormalities",
          "basal ganglia damage seen on imaging"
        ]
      }
    ],
    "common": [
