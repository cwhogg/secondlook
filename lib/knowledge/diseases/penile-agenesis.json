        "requiredForDiagnosis": true
      },
      {
        "id": "absence-other-genital-anomalies",
        "description": "No other major external genital malformations aside from penile absence",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Complete absence of the penis with presence of normally developed scrotum and testes",
    "notes": "Diagnosis is primarily clinical and confirmed by physical examination and imaging to exclude other anomalies."
