  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Metatropic Dysplasia",
    "criteria": [
      {
        "id": "short-trunk-dwarfism",
        "description": "Severe short-trunk dwarfism with disproportionate short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-spinal-kyphoscoliosis",
        "description": "Progressive kyphoscoliosis and platyspondyly evident on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "long-bones-with-flared-metaphyses",
        "description": "Long bones with characteristic flared metaphyses and dumbbell-shaped appearance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in TRPV4 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-features",
        "description": "Distinctive facial features including prominent forehead and midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe short-trunk dwarfism with characteristic radiological features (kyphoscoliosis, platyspondyly, flared metaphyses) with or without genetic confirmation",
    "notes": "Genetic testing for TRPV4 mutations can confirm diagnosis but is not mandatory if clinical and radiological features are definitive."
  },
