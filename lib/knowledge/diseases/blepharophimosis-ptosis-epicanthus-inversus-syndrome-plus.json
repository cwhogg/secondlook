  "diagnosticCriteria": {
    "formalCriteriaName": "BPES Diagnostic Criteria",
    "criteria": [
      {
        "id": "blepharophimosis",
        "description": "Horizontal narrowing of the palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ptosis",
        "description": "Congenital drooping of the upper eyelids",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epicanthus-inversus",
        "description": "Upward fold of skin of the lower eyelid near the inner corner of the eye",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "telecanthus",
        "description": "Increased distance between the medial canthi of the eyes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "additional-anomalies",
        "description": "Presence of systemic anomalies such as intellectual disability or genital malformations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major eyelid features (blepharophimosis, ptosis, epicanthus inversus) with or without additional systemic anomalies",
    "notes": "Genetic testing for FOXL2 mutations can support diagnosis, especially in BPES plus cases."
  },
