  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "CSF protein may be mildly elevated"
    ],
    "imaging": [
      "MRI may show muscle atrophy in distal limbs",
      "Nerve ultrasound may show nerve enlargement"
    ],
    "genetic": [
      "PMP22 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electrophysiological studies showing demyelinating neuropathy with slowed nerve conduction velocities",
      "Nerve biopsy showing onion bulb formations (rarely performed)"
    ]
  },
