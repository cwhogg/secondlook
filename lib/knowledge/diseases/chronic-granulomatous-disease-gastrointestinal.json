  "keyFindings": {
    "laboratory": [
      "Abnormal dihydrorhodamine (DHR) or nitroblue tetrazolium (NBT) test indicating defective neutrophil oxidative burst",
      "Elevated inflammatory markers (ESR, CRP)",
      "Leukocytosis during infections"
    ],
    "imaging": [
      "Bowel wall thickening and strictures on abdominal CT or MRI",
      "Granulomatous lesions visible on endoscopy",
      "Hepatosplenomegaly on ultrasound"
    ],
    "genetic": [
      "Pathogenic mutations in CYBB (X-linked), CYBA, NCF1, NCF2, or NCF4 genes"
    ],
    "other": [
      "Histopathology showing noncaseating granulomas in GI biopsies",
      "Recurrent infections with catalase-positive organisms"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "crohns-disease",
      "distinguishingFeatures": [
        "Absence of neutrophil oxidative burst defect",
        "No known NADPH oxidase mutations",
        "More common perianal disease and skip lesions"
      ]
    },
    {
      "diseaseId": "tuberculosis-gastrointestinal",
      "distinguishingFeatures": [
        "Caseating granulomas on biopsy",
        "Positive acid-fast bacilli staining or culture",
        "Systemic symptoms like night sweats and weight loss"
      ]
    }
  ],
  "redFlags": [
    "Severe recurrent infections with catalase-positive bacteria or fungi",
    "Intestinal obstruction requiring surgical intervention",
    "Failure to thrive in infancy or early childhood"
  ],
  "specialistType": [
    "Immunologist",
