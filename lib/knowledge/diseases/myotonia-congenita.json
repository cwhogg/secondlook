  "keyFindings": {
    "laboratory": [
      "Normal serum creatine kinase or mildly elevated",
      "Normal metabolic panel"
    ],
    "imaging": [
      "Muscle MRI may show mild hypertrophy or fatty infiltration in Becker type"
    ],
    "genetic": [
      "Pathogenic variants in CLCN1 gene (chloride channel gene)",
      "Autosomal dominant inheritance in Thomsen type",
      "Autosomal recessive inheritance in Becker type"
    ],
    "other": [
      "Electromyography showing characteristic myotonic discharges",
      "Muscle biopsy generally nonspecific"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "paramyotonia-congenita",
      "distinguishingFeatures": [
        "Symptoms worsen with cold and repeated activity",
        "SCN4A gene mutations",
        "Paralysis episodes more common"
      ]
    },
    {
      "diseaseId": "myotonic-dystrophy",
      "distinguishingFeatures": [
        "Progressive muscle weakness and wasting",
        "Multisystem involvement including cataracts and cardiac conduction defects",
        "CTG repeat expansion in DMPK gene"
      ]
    }
  ],
  "redFlags": [
    "Progressive muscle weakness beyond stiffness",
    "Respiratory difficulty or involvement",
    "Cardiac arrhythmias or conduction abnormalities"
  ],
