  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Lipodystrophy due to Peptidic Growth Factors Deficiency",
    "criteria": [
      {
        "id": "clinical-lipodystrophy",
        "description": "Generalized or partial loss of subcutaneous adipose tissue without inflammatory signs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-factor-deficiency",
        "description": "Documented deficiency or functional impairment of peptidic growth factors (e.g., IGF-1, leptin)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-dysregulation",
        "description": "Presence of insulin resistance, hypertriglyceridemia, or hepatic steatosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations or deletions affecting genes encoding peptidic growth factors or their receptors",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (clinical lipodystrophy and documented peptidic growth factor deficiency) with supportive or minor criteria strengthens diagnosis",
    "notes": "Diagnosis requires exclusion of other causes of lipodystrophy and metabolic disorders."
  },
