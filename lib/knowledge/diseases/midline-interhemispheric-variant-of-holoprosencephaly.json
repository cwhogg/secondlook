  "diagnosticCriteria": {
    "formalCriteriaName": "Holoprosencephaly Diagnostic Criteria",
    "criteria": [
      {
        "id": "midline-fusion",
        "description": "Partial fusion of the posterior frontal and parietal lobes with preserved anterior frontal lobes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "corpus-callosum-abnormality",
        "description": "Hypoplasia or dysgenesis of the corpus callosum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-facial-midline-defects",
        "description": "Lack of severe facial midline anomalies typically seen in classic holoprosencephaly",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic midline interhemispheric fusion abnormalities on neuroimaging with corpus callosum dysgenesis",
    "notes": "Diagnosis is primarily based on neuroimaging findings, especially MRI."
  },
