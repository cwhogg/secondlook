  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Epidermolysis Bullosa Simplex with Anodontia/Hypodontia",
    "criteria": [
      {
        "id": "blistering",
        "description": "Recurrent skin blistering and erosions primarily on hands and feet triggered by minor trauma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-anomalies",
        "description": "Congenital absence of some or all teeth (anodontia or hypodontia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "keratin-mutation",
        "description": "Identification of pathogenic mutations in KRT5 or KRT14 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing intraepidermal cleavage within basal keratinocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent skin blistering and dental anomalies with identification of pathogenic keratin gene mutation",
    "notes": "Genetic testing is essential to confirm diagnosis and differentiate from other EB subtypes."
  },
