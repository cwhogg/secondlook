        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-secondary-causes",
        "description": "Exclusion of secondary causes such as malignancy, infection, or drug-induced fibrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histopathological confirmation showing fibroinflammatory tissue with absence of malignancy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-inflammatory-markers",
        "description": "Elevated ESR and CRP supporting active inflammation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of retroperitoneal fibrotic mass on imaging with exclusion of secondary causes",
    "notes": "Histopathology is helpful but not always required; clinical and radiologic correlation is essential"
