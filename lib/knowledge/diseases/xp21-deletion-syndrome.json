  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase",
      "Hyperglycerolemia",
      "Electrolyte abnormalities consistent with adrenal insufficiency"
    ],
    "imaging": [
      "Muscle MRI showing fatty infiltration and muscle atrophy",
      "Cardiac MRI or echocardiogram showing cardiomyopathy"
    ],
    "genetic": [
      "Deletion involving the Xp21 region detected by array CGH or MLPA",
      "Loss of function mutations in DMD, GK, and NR0B1 genes within the deletion"
    ],
    "other": [
      "Muscle biopsy showing dystrophic changes",
      "Adrenal gland hypoplasia on imaging or histology"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "duchenne-muscular-dystrophy",
      "distinguishingFeatures": [
        "Isolated DMD gene mutation without adrenal or glycerol kinase involvement",
        "Absence of adrenal insufficiency and metabolic abnormalities"
      ]
    },
    {
      "diseaseId": "adrenal-hypoplasia-congenita",
      "distinguishingFeatures": [
        "Isolated NR0B1 gene mutation without muscular dystrophy or glycerol kinase deficiency",
        "Primarily endocrine manifestations"
      ]
    },
    {
      "diseaseId": "glycerol-kinase-deficiency",
      "distinguishingFeatures": [
        "Isolated GK gene mutation with metabolic abnormalities only",
        "No muscular dystrophy or adrenal insufficiency"
      ]
    }
  ],
  "redFlags": [
    "Progressive proximal muscle weakness in early childhood",
    "Signs of adrenal crisis such as hypoglycemia and electrolyte imbalance",
    "Metabolic acidosis with unexplained hyperglycerolemia"
  ],
