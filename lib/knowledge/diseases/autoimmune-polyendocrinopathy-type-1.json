{
  "id": "autoimmune-polyendocrinopathy-type-1",
  "name": "Autoimmune Polyendocrinopathy Type 1",
  "aliases": [
    "APECED",
    "Autoimmune Polyendocrinopathy-Candidiasis-Ectodermal Dystrophy"
  ],
  "icd10Codes": [
    "E31.0"
  ],
