  "keyFindings": {
    "laboratory": [
      "Reduced serum levels of one or more IgG subclasses (IgG1, IgG2, IgG3, IgG4)",
      "Normal or near-normal total IgG levels",
      "Impaired specific antibody responses to polysaccharide vaccines (e.g., pneumococcal vaccine)",
      "Normal or mildly reduced total immunoglobulins (IgA, IgM)"
    ],
    "imaging": [
      "Chest radiographs or CT showing bronchiectasis or recurrent pneumonia",
      "Sinus imaging showing chronic sinusitis"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Poor clinical response to standard antibiotic therapy",
      "Improvement with immunoglobulin replacement therapy in some cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "common-variable-immunodeficiency",
      "distinguishingFeatures": [
        "Low total IgG and other immunoglobulin isotypes",
        "More severe hypogammaglobulinemia",
        "More frequent autoimmune complications"
      ]
    },
    {
      "diseaseId": "selective-igg2-deficiency",
      "distinguishingFeatures": [
        "Isolated deficiency of IgG2 subclass",
        "Predominantly recurrent respiratory infections",
        "May have normal levels of other IgG subclasses"
      ]
    },
    {
      "diseaseId": "selective-igg1-deficiency",
      "distinguishingFeatures": [
        "Isolated IgG1 subclass deficiency",
        "Rare and often associated with other immunodeficiencies",
        "More severe infections"
      ]
    }
  ],
  "redFlags": [
    "Frequent severe bacterial infections requiring hospitalization",
    "Development of bronchiectasis or chronic lung disease",
    "Poor response to standard antibiotic therapy"
  ],
