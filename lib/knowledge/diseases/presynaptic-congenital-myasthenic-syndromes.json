  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Congenital Myasthenic Syndromes",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of fatigable muscle weakness with onset in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electrophysiological evidence of presynaptic neuromuscular transmission defect (e.g., decremental response on repetitive nerve stimulation, increased quantal content)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in presynaptic genes associated with CMS (e.g., CHAT, SLC5A7, SYT2)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-treatment",
        "description": "Improvement of symptoms with acetylcholinesterase inhibitors or 3,4-diaminopyridine",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-autoantibodies",
        "description": "Negative testing for acetylcholine receptor and MuSK antibodies to exclude autoimmune myasthenia gravis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of fatigable muscle weakness with electrophysiological evidence of presynaptic neuromuscular transmission defect and identification of pathogenic variants in presynaptic CMS genes",
    "notes": "Genetic confirmation is critical for definitive diagnosis and treatment guidance."
  },
