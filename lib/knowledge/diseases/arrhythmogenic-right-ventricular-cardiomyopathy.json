  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Echocardiographic evidence of right ventricular dilation and dysfunction",
      "Cardiac MRI showing fibrofatty infiltration and regional wall motion abnormalities",
      "Right ventricular aneurysms on imaging"
    ],
    "genetic": [
      "ATP7A (causative, loss-of-function)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Electrocardiogram abnormalities including epsilon waves and T wave inversions in V1-V3",
      "Endomyocardial biopsy showing fibrofatty replacement"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dilated-cardiomyopathy",
      "distinguishingFeatures": [
        "Predominant left ventricular dilation and systolic dysfunction",
        "Lack of fibrofatty replacement",
        "Different genetic mutations"
      ]
    },
    {
      "diseaseId": "right-ventricular-outflow-tract-ventricular-tachycardia",
      "distinguishingFeatures": [
        "Benign ventricular tachycardia originating from RVOT",
        "No structural heart disease or fibrofatty infiltration",
        "Normal imaging studies"
      ]
    }
  ],
