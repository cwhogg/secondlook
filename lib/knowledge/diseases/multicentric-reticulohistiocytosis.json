  "keyFindings": {
    "laboratory": [
      "Negative rheumatoid factor and anti-CCP antibodies",
      "Elevated ESR and CRP",
      "Mild anemia of chronic disease"
    ],
    "imaging": [
      "X-rays showing symmetric erosive arthritis with joint space narrowing, especially in distal interphalangeal joints",
      "MRI may show synovial hypertrophy and erosions"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin or synovial biopsy demonstrating multinucleated giant cells with eosinophilic ground-glass cytoplasm",
      "Immunohistochemistry positive for CD68 and negative for Langerhans cell markers"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "rheumatoid-arthritis",
      "distinguishingFeatures": [
        "Typically positive rheumatoid factor and anti-CCP antibodies",
        "Predominantly affects proximal interphalangeal and metacarpophalangeal joints",
        "Absence of characteristic papulonodular skin lesions"
      ]
    },
    {
      "diseaseId": "langerhans-cell-histiocytosis",
      "distinguishingFeatures": [
        "Presence of Birbeck granules on electron microscopy",
        "Positive CD1a and Langerin immunohistochemical staining",
        "Different clinical presentation with bone lesions and systemic symptoms"
      ]
    },
    {
      "diseaseId": "dermatomyositis",
      "distinguishingFeatures": [
        "Characteristic heliotrope rash and Gottron papules",
        "Muscle weakness predominant",
        "Elevated muscle enzymes and myositis-specific antibodies"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive erosive arthritis leading to joint destruction",
    "Systemic symptoms such as unexplained fever and weight loss",
    "Evidence of internal organ involvement (lung, heart, kidney)"
  ],
  "specialistType": [
    "Rheumatologist",
    "Dermatologist",
    "Pathologist"
  ],
