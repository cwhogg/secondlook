  "diagnosticCriteria": {
    "formalCriteriaName": "McAdam Criteria (Modified by Damiani and Levine)",
    "criteria": [
      {
        "id": "rp-maj1",
        "description": "Bilateral auricular chondritis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "rp-maj2",
        "description": "Non-erosive inflammatory polyarthritis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "rp-maj3",
        "description": "Nasal chondritis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "rp-maj4",
        "description": "Ocular inflammation (conjunctivitis, keratitis, scleritis, episcleritis, uveitis)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "rp-maj5",
        "description": "Respiratory tract chondritis (laryngeal and/or tracheal cartilages)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "rp-maj6",
        "description": "Cochlear and/or vestibular dysfunction (neurosensory hearing loss, tinnitus, vertigo)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "rp-sup1",
        "description": "Histological confirmation of chondritis in biopsy specimen",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "McAdam: 3 or more of the 6 clinical features. Damiani modification: 1 clinical feature + histological confirmation, OR 2 clinical features responding to steroids. Biopsy not always required.",
    "notes": "30% of patients have another autoimmune condition (vasculitis, RA, SLE, MDS). MAGIC syndrome: RP + Behcet disease. VEXAS syndrome should be excluded in males with MDS features."
  },
