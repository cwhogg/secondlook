    ],
    "imaging": [
      "Echocardiography revealing septal defects or other congenital heart anomalies",
      "Brain MRI may show nonspecific findings related to developmental delay"
    ],
    "genetic": [
      "KAT6B (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Neuropsychological testing confirming intellectual disability",
      "Ophthalmologic examination confirming blepharophimosis and ptosis"
    ]
  },
