        "description": "Neurodevelopmental delay or intellectual disability consistent with hypothyroidism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "goiter",
        "description": "Presence of fetal or neonatal goiter detected clinically or by imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital hypothyroidism with documented maternal iodine deficiency and neurodevelopmental delay",
    "notes": "Diagnosis is supported by biochemical testing and maternal history; imaging may assist in identifying goiter."
