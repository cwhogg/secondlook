  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for Craniolenticulosutural Dysplasia",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Presence of craniosynostosis, particularly involving coronal sutures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lenticular-nuclei-abnormalities",
        "description": "Characteristic lenticular nucleus abnormalities on neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-dysmorphisms",
        "description": "Skeletal abnormalities including broad clavicles, hypoplastic ribs, and delayed ossification",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features such as hypertelorism, broad nasal bridge, and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "SEC23A-mutation",
        "description": "Identification of pathogenic variants in SEC23A gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis, lenticular nucleus abnormalities, skeletal dysmorphisms, and pathogenic SEC23A mutation",
    "notes": "Molecular confirmation via SEC23A gene sequencing is critical for definitive diagnosis."
  },
