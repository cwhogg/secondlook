  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Congenital Intrinsic Factor Deficiency",
    "criteria": [
      {
        "id": "low-serum-intrinsic-factor",
        "description": "Demonstration of absent or markedly reduced intrinsic factor in gastric secretions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "megaloblastic-anemia",
        "description": "Presence of megaloblastic anemia with macrocytosis and hypersegmented neutrophils",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vitamin-b12-deficiency",
        "description": "Low serum vitamin B12 levels despite normal dietary intake",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the GIF gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-parietal-cell-function",
        "description": "Normal gastric acid secretion and parietal cell function excluding pernicious anemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of megaloblastic anemia with low serum vitamin B12 and absent intrinsic factor in gastric secretions",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory."
  },
