  "diagnosticCriteria": {
    "formalCriteriaName": "Shwachman-Diamond Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "exocrine-pancreatic-insufficiency",
        "description": "Evidence of exocrine pancreatic insufficiency (e.g., steatorrhea, low pancreatic enzyme levels)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-dysfunction",
        "description": "Bone marrow dysfunction manifesting as neutropenia, anemia, or thrombocytopenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Presence of skeletal abnormalities such as metaphyseal dysostosis or rib cage deformities",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the SBDS gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-history",
        "description": "Recurrent infections and failure to thrive in infancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of exocrine pancreatic insufficiency and bone marrow dysfunction, with or without genetic confirmation",
    "notes": "Genetic testing is confirmatory but not mandatory if clinical criteria are met."
  },
