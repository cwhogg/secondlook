  "keyFindings": {
    "laboratory": [
      "Serum hypokalemia during attacks (typically <3.5 mmol/L)",
      "Normal or low serum potassium between attacks",
      "Elevated creatine kinase in some cases"
    ],
    "imaging": [
      "Muscle MRI may show fatty replacement in chronic cases"
    ],
    "genetic": [
      "Pathogenic variants in CACNA1S gene",
      "Pathogenic variants in SCN4A gene"
    ],
    "other": [
      "Electromyography showing reduced muscle excitability during attacks",
      "Provocative testing with glucose or insulin challenge may induce weakness"
    ]
  },
