  "diagnosticCriteria": {
    "formalCriteriaName": "Noonan Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "webbed-neck",
        "description": "Presence of webbed neck or pterygium colli",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "short-stature",
        "description": "Short stature defined as height below the 3rd percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-heart-disease",
        "description": "Congenital heart defects, especially pulmonary valve stenosis or hypertrophic cardiomyopathy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism, ptosis, and low-set ears",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "chest-deformity",
        "description": "Chest deformities such as pectus excavatum or carinatum",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least two major criteria or one major and two minor criteria",
    "notes": "Genetic testing for mutations in PTPN11 or related genes supports diagnosis"
  },
