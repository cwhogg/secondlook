  "diagnosticCriteria": {
    "formalCriteriaName": "Carcinoid Heart Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "right-sided-valvular-fibrosis",
        "description": "Presence of fibrotic plaques on right-sided heart valves confirmed by echocardiography or surgery",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-urinary-5-HIAA",
        "description": "Elevated levels of 5-hydroxyindoleacetic acid (5-HIAA) in urine indicating carcinoid syndrome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "carcinoid-tumor-presence",
        "description": "Confirmed diagnosis of carcinoid tumor or carcinoid syndrome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "right-heart-failure-signs",
        "description": "Clinical or imaging evidence of right-sided heart failure",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of carcinoid tumor with elevated 5-HIAA and echocardiographic evidence of right-sided valvular fibrosis",
    "notes": "Diagnosis relies heavily on echocardiographic findings combined with biochemical and clinical evidence of carcinoid syndrome."
  },
