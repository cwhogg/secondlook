  "diagnosticCriteria": {
    "formalCriteriaName": "Echocardiographic Diagnostic Criteria for Partial AVSD",
    "criteria": [
      {
        "id": "ostium-primum-ASD",
        "description": "Presence of an ostium primum atrial septal defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cleft-mitral-valve",
        "description": "Cleft or abnormality of the anterior mitral valve leaflet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-VSD",
        "description": "Absence of a ventricular septal defect (distinguishing from complete AVSD)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "left-atrial-enlargement",
        "description": "Echocardiographic evidence of left atrial enlargement",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "left-ventricular-volume-overload",
        "description": "Signs of left ventricular volume overload on imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of an ostium primum atrial septal defect and cleft mitral valve leaflet without ventricular septal defect confirmed by echocardiography",
    "notes": "Diagnosis is primarily based on echocardiographic findings; cardiac catheterization may be used for further hemodynamic assessment."
  },
