  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for Xeroderma Pigmentosum",
    "criteria": [
      {
        "id": "uv-sensitivity",
        "description": "Extreme sensitivity to ultraviolet (UV) light with severe sunburn reactions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-skin-cancers",
        "description": "Development of multiple early-onset skin cancers including basal cell carcinoma, squamous cell carcinoma, and melanoma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dna-repair-defect",
        "description": "Deficient nucleotide excision repair demonstrated by cellular assays or genetic testing identifying pathogenic variants in XP genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-manifestations",
        "description": "Presence of photophobia, keratitis, or conjunctival abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-features",
        "description": "Progressive neurological abnormalities such as sensorineural hearing loss or cognitive decline",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of extreme UV sensitivity with early-onset skin cancers plus confirmation of DNA repair defect by molecular or cellular testing",
    "notes": "Genetic testing is confirmatory; clinical diagnosis may be suspected based on history and skin findings."
  },
