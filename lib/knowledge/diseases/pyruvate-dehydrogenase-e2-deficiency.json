  "diagnosticCriteria": {
    "formalCriteriaName": "Pyruvate Dehydrogenase Complex Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced pyruvate dehydrogenase complex enzyme activity in fibroblasts or muscle tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the DLAT gene encoding the E2 subunit",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lactic-acidosis",
        "description": "Persistent lactic acidosis with elevated blood lactate and pyruvate levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced enzyme activity and pathogenic DLAT gene variants; supportive biochemical findings strengthen diagnosis",
    "notes": "Diagnosis may require exclusion of other pyruvate dehydrogenase complex subunit deficiencies"
  },
