  "diagnosticCriteria": {
    "formalCriteriaName": "Caroli Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "intrahepatic-duct-dilatation",
        "description": "Segmental, saccular or fusiform dilatation of intrahepatic bile ducts demonstrated by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-hepatic-fibrosis",
        "description": "Histopathological evidence of congenital hepatic fibrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Recurrent cholangitis, portal hypertension, or hepatomegaly",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of intrahepatic bile duct dilatation plus congenital hepatic fibrosis confirmed by imaging and/or histopathology",
    "notes": "Genetic testing for PKHD1 mutations may support diagnosis but is not mandatory"
  },
