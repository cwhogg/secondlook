  "keyFindings": {
    "laboratory": [
      "Generalized aminoaciduria on urine amino acid analysis",
      "Glycosuria with normal blood glucose",
      "Hypophosphatemia with phosphaturia",
      "Proximal (type 2) renal tubular acidosis with metabolic acidosis",
      "Hypokalemia and hypomagnesemia",
      "Low serum uric acid"
    ],
    "imaging": [
      "Radiographic evidence of rickets or osteomalacia",
      "Nephrocalcinosis on renal ultrasound or CT"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Family history consistent with autosomal recessive inheritance",
      "Response to phosphate and bicarbonate supplementation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "acquired-fanconi-syndrome",
      "distinguishingFeatures": [
        "History of exposure to toxins, drugs, or heavy metals",
        "Onset in adulthood",
        "Potential reversibility after removal of offending agent"
      ]
    },
    {
      "diseaseId": "cystinosis",
      "distinguishingFeatures": [
        "Presence of corneal cystine crystals",
        "Progressive renal failure",
        "Elevated cystine levels in leukocytes"
      ]
    },
    {
      "diseaseId": "hereditary-renal-tubular-acidosis-type-2",
      "distinguishingFeatures": [
        "Isolated proximal renal tubular acidosis without generalized aminoaciduria",
        "Less severe phosphate wasting",
        "Different genetic mutations"
      ]
    }
  ],
  "redFlags": [
    "Severe hypophosphatemia causing bone deformities",
    "Progressive renal failure",
    "Refractory metabolic acidosis despite treatment"
  ],
