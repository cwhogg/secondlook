  "diagnosticCriteria": {
    "formalCriteriaName": "Neuroectodermal Melanolysosomal Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "lysosomal-melanin-accumulation",
        "description": "Demonstration of abnormal melanin accumulation within lysosomes on histopathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-dysfunction",
        "description": "Progressive neurological deterioration including developmental delay and seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with melanolysosomal dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-hyperpigmentation",
        "description": "Presence of characteristic hyperpigmented skin lesions",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-findings",
        "description": "MRI evidence of neurodegeneration with specific basal ganglia involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: lysosomal melanin accumulation, progressive neurological dysfunction, and genetic confirmation",
    "notes": "Diagnosis requires integration of clinical, histopathological, and genetic data."
  },
