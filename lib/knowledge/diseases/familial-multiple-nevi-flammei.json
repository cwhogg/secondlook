  "differentialDiagnoses": [
    {
      "diseaseId": "sturge-weber-syndrome",
      "distinguishingFeatures": [
        "Neurological involvement with leptomeningeal angiomas",
        "Unilateral facial port-wine stain typically following trigeminal nerve distribution",
        "Presence of seizures and glaucoma"
      ]
    },
    {
      "diseaseId": "klippel-trenaunay-syndrome",
      "distinguishingFeatures": [
        "Port-wine stains with limb hypertrophy",
        "Venous malformations and varicosities",
        "Usually involves one limb rather than multiple discrete nevi"
      ]
    }
  ],
