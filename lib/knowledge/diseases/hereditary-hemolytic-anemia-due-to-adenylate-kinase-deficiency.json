  "keyFindings": {
    "laboratory": [
      "Reduced adenylate kinase enzyme activity in erythrocytes",
      "Elevated reticulocyte count",
      "Indirect hyperbilirubinemia",
      "Elevated lactate dehydrogenase (LDH)",
      "Decreased haptoglobin"
    ],
    "imaging": [
      "Ultrasound evidence of splenomegaly",
      "Ultrasound or CT evidence of gallstones"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Peripheral blood smear showing anisopoikilocytosis and polychromasia"
    ]
  },
