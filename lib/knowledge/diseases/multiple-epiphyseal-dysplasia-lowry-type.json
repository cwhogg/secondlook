  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Multiple Epiphyseal Dysplasia",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early-onset joint pain and stiffness predominantly affecting large joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-epiphyseal-abnormalities",
        "description": "Radiographic evidence of delayed and irregular ossification of multiple epiphyses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the SLC26A2 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus radiological epiphyseal abnormalities; genetic confirmation supports diagnosis",
    "notes": "Genetic testing is recommended but not mandatory for diagnosis."
  },
