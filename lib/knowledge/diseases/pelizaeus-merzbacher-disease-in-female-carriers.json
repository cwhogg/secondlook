    "formalCriteriaName": "Pelizaeus-Merzbacher Disease Carrier Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of heterozygous mutation or duplication in the PLP1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of mild to moderate neurological symptoms such as spasticity or ataxia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-mri",
        "description": "MRI showing patchy or diffuse hypomyelination consistent with carrier state",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of Pelizaeus-Merzbacher disease in male relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of PLP1 mutation plus at least one major clinical or imaging criterion",
    "notes": "Female carriers may exhibit variable expressivity ranging from asymptomatic to mild neurological impairment."
  },
