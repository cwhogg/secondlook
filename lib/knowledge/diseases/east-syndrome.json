  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for EAST Syndrome",
    "criteria": [
      {
        "id": "epilepsy",
        "description": "Presence of early-onset epilepsy with generalized seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ataxia",
        "description": "Cerebellar ataxia manifesting as gait disturbance and coordination deficits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-deafness",
        "description": "Bilateral sensorineural hearing loss confirmed by audiometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-tubulopathy",
        "description": "Renal salt-wasting tubulopathy with hypokalemia, metabolic alkalosis, and hypomagnesemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "KCNJ10-mutation",
        "description": "Identification of biallelic pathogenic variants in the KCNJ10 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-neuroimaging",
        "description": "MRI showing cerebellar atrophy or hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of epilepsy, ataxia, sensorineural deafness, renal tubulopathy, and pathogenic KCNJ10 mutations",
    "notes": "Diagnosis is confirmed by genetic testing; clinical features may vary in severity."
  },
