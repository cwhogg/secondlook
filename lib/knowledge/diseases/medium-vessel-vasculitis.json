  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP",
      "Mild anemia of chronic disease",
      "Negative ANCA (usually)",
      "Elevated serum creatinine if renal involvement"
    ],
    "imaging": [
      "Angiography showing microaneurysms and stenoses in medium-sized arteries",
      "CT or MR angiography for vessel assessment"
    ],
    "genetic": [
      "HBB (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Biopsy of affected artery showing necrotizing inflammation with polymorphonuclear infiltration"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "small-vessel-vasculitis",
      "distinguishingFeatures": [
        "Predominant involvement of small vessels",
        "Positive ANCA in many cases",
        "Pulmonary-renal syndrome more common"
      ]
    },
    {
      "diseaseId": "giant-cell-arteritis",
      "distinguishingFeatures": [
        "Involvement of large vessels (e.g. temporal artery)",
        "Older age of onset (>50 years)",
        "Elevated ESR with headache and jaw claudication"
      ]
    }
  ],
  "redFlags": [
    "Sudden onset of severe abdominal pain indicating mesenteric ischemia",
    "Rapidly progressive renal failure",
    "Signs of aneurysm rupture such as hypotension and acute pain"
  ],
