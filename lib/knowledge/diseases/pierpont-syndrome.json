    "laboratory": [
      "Normal routine blood tests",
      "Possible hypothyroidism on thyroid function tests"
    ],
    "imaging": [
      "Brain MRI may show nonspecific delayed myelination",
      "Skeletal X-rays reveal broad distal phalanges"
    ],
    "genetic": [
      "TBL1XR1 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Developmental assessments confirming intellectual disability"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cornelia-de-lange-syndrome",
      "distinguishingFeatures": [
        "Distinctive synophrys and limb reduction defects",
        "More severe growth retardation",
        "Mutations in NIPBL or related genes"
      ]
    },
    {
      "diseaseId": "rubinstein-taybi-syndrome",
      "distinguishingFeatures": [
        "Broad thumbs and toes with angulated distal phalanges",
        "Characteristic facial features different from Pierpont syndrome",
        "CREBBP or EP300 gene mutations"
      ]
    }
  ],
