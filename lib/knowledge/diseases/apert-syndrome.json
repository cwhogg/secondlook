  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Skull X-ray or CT showing premature fusion of coronal sutures",
      "MRI brain for associated CNS anomalies or hydrocephalus",
      "Hand and foot radiographs demonstrating bony syndactyly"
    ],
    "genetic": [
      "Pathogenic mutations in FGFR2 gene, commonly S252W or P253R mutations"
    ],
    "other": [
      "Prenatal ultrasound may detect craniosynostosis and syndactyly",
      "Clinical examination revealing characteristic facial features and syndactyly"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "crouzon-syndrome",
