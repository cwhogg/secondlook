  "diagnosticCriteria": {
    "formalCriteriaName": "Abetalipoproteinemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "apoB-absence",
        "description": "Absence or severe reduction of apolipoprotein B in plasma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acanthocytosis",
        "description": "Presence of acanthocytes on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fat-malabsorption",
        "description": "Clinical evidence of fat malabsorption including steatorrhea",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-deficits",
        "description": "Neurological manifestations such as ataxia and peripheral neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic mutations in the MTTP gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of fat malabsorption, acanthocytosis, absence of apolipoprotein B, and confirmation by genetic testing or clinical criteria",
    "notes": "Genetic testing is confirmatory but diagnosis can be made clinically with biochemical and hematological findings."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Acanthocytosis",
        "frequency": 0.95,
        "bodySystem": "hematological",
        "notes": "Spiculated red blood cells on peripheral smear"
      },
      {
        "symptomName": "Absence of apolipoprotein B",
        "frequency": 0.9,
        "bodySystem": "hematological",
        "notes": "Detected by plasma protein electrophoresis or immunoassay"
      },
      {
        "symptomName": "Severe fat malabsorption with steatorrhea",
        "frequency": 0.85,
        "bodySystem": "gastrointestinal",
        "notes": "Chronic diarrhea with fatty stools"
      }
    ],
    "common": [
      {
        "symptomName": "Ataxia",
        "frequency": 0.75,
        "bodySystem": "neurological",
        "notes": "Progressive cerebellar dysfunction"
      },
      {
        "symptomName": "Peripheral neuropathy",
        "frequency": 0.7,
        "bodySystem": "neurological",
        "notes": "Sensory and motor deficits"
      },
      {
        "symptomName": "Retinitis pigmentosa",
        "frequency": 0.65,
        "bodySystem": "ophthalmological",
        "notes": "Progressive vision loss"
      },
      {
        "symptomName": "Failure to thrive",
        "frequency": 0.6,
        "bodySystem": "constitutional",
        "notes": "Poor weight gain in infancy"
      },
      {
        "symptomName": "Hypocholesterolemia",
        "frequency": 0.55,
        "bodySystem": "hematological",
        "notes": "Low plasma cholesterol levels"
      }
    ],
    "occasional": [
      {
        "symptomName": "Spinocerebellar degeneration",
        "frequency": 0.4,
        "bodySystem": "neurological",
        "notes": "Progressive loss of cerebellar neurons"
      },
      {
        "symptomName": "Vitamin E deficiency",
