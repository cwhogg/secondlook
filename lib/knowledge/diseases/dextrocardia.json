  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests unless associated syndromes present"
    ],
    "imaging": [
      "Chest X-ray showing right-sided cardiac silhouette",
      "Echocardiography confirming cardiac chamber orientation",
      "CT or MRI for detailed anatomical assessment"
    ],
    "genetic": [
      "Possible mutations associated with primary ciliary dyskinesia in Kartagener syndrome"
    ],
    "other": [
      "Situs inversus may be confirmed by abdominal ultrasound or imaging"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cardiac-dextroposition",
      "distinguishingFeatures": [
        "Heart displaced to right side due to extracardiac causes (e.g., lung collapse)",
        "Normal cardiac chamber orientation"
      ]
    },
    {
      "diseaseId": "situs-inversus",
      "distinguishingFeatures": [
        "Mirror-image reversal of thoracic and abdominal organs",
        "May or may not include dextrocardia"
      ]
    }
  ],
  "redFlags": [
    "Presence of cyanosis or heart failure symptoms in infancy",
    "Recurrent respiratory infections suggestive of Kartagener syndrome",
    "Arrhythmias or conduction abnormalities"
  ],
