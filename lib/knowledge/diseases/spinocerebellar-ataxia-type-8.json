  "diagnosticCriteria": {
    "formalCriteriaName": "SCA8 Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Detection of CTG trinucleotide repeat expansion in the ATXN8OS gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-ataxias",
        "description": "Exclusion of other spinocerebellar ataxias and acquired causes",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia plus genetic confirmation of CTG repeat expansion in ATXN8OS gene, with exclusion of other causes",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical presentation can be variable."
  },
