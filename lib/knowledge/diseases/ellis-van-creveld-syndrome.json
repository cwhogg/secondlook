  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible hypothyroidism screening abnormalities"
    ],
    "imaging": [
      "Radiographs showing short ribs, mesomelic limb shortening, and polydactyly",
      "Echocardiography revealing atrial septal defects or other congenital heart defects"
    ],
    "genetic": [
      "Pathogenic variants in EVC or EVC2 genes detected by molecular genetic testing"
    ],
    "other": [
      "Dental examination revealing natal teeth and hypodontia",
      "Nail examination showing dystrophic changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "jeune-asphyxiating-thoracic-dystrophy",
      "distinguishingFeatures": [
        "More severe thoracic constriction",
        "Absence of polydactyly",
        "Different genetic mutations (IFT80, DYNC2H1)"
      ]
    },
    {
      "diseaseId": "bardet-biedl-syndrome",
      "distinguishingFeatures": [
        "Polydactyly with retinal dystrophy",
        "Obesity and renal anomalies",
        "Cognitive impairment more common"
      ]
    }
  ],
  "redFlags": [
    "Severe respiratory distress due to thoracic constriction",
    "Congenital heart defects causing cyanosis or heart failure",
    "Neonatal feeding difficulties related to orofacial anomalies"
  ],
