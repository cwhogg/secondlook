  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Hepatoportal Sclerosis",
    "criteria": [
      {
        "id": "portal-hypertension",
        "description": "Presence of clinical or radiological evidence of portal hypertension without cirrhosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-biopsy",
        "description": "Liver biopsy showing obliterative portal venopathy with periportal fibrosis and absence of cirrhosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of portal hypertension such as cirrhosis, schistosomiasis, or thrombosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-liver-function",
        "description": "Preserved liver synthetic function despite portal hypertension",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-findings",
        "description": "Imaging evidence of portal vein irregularities or narrowing without thrombosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (portal hypertension without cirrhosis, characteristic liver biopsy findings, and exclusion of other causes) must be met",
    "notes": "Diagnosis often requires multidisciplinary evaluation including hepatology, radiology, and pathology"
  },
