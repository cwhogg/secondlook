  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Multiple Osteochondromas",
    "criteria": [
      {
        "id": "multiple-exostoses",
        "description": "Presence of two or more osteochondromas (exostoses) arising from the metaphyses of long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiological-features",
        "description": "Characteristic radiographic appearance of sessile or pedunculated bony projections with cartilage caps",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in EXT1 or EXT2 genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of two or more osteochondromas with characteristic radiological features; genetic testing and family history supportive but not mandatory",
    "notes": "Diagnosis is primarily clinical and radiological; genetic testing aids confirmation and family counseling"
  },
