  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Machado-Joseph Disease",
    "criteria": [
      {
        "id": "ataxia",
        "description": "Progressive cerebellar ataxia with gait disturbance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of expanded CAG trinucleotide repeat in the ATXN3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ophthalmoplegia",
        "description": "Presence of ophthalmoplegia or diplopia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pyramidal-signs",
        "description": "Upper motor neuron signs including spasticity and hyperreflexia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "peripheral-neuropathy",
        "description": "Electrophysiological evidence of peripheral neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia plus genetic confirmation of ATXN3 CAG repeat expansion",
    "notes": "Clinical heterogeneity exists; genetic testing is essential for definitive diagnosis."
  },
