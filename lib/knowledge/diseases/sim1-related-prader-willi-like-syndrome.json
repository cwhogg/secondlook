  "diagnosticCriteria": {
    "formalCriteriaName": "SIM1-related Prader-Willi-like syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic variant or deletion involving the SIM1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia-in-infancy",
        "description": "Neonatal or infantile hypotonia with feeding difficulties",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyperphagia-and-obesity",
        "description": "Progressive hyperphagia leading to early-onset obesity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "endocrine-abnormalities",
        "description": "Endocrine dysfunction including growth hormone deficiency or hypogonadism",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic SIM1 gene variant plus hypotonia in infancy and hyperphagia with obesity",
    "notes": "Diagnosis requires molecular genetic confirmation; clinical features overlap with classic Prader-Willi syndrome but lack 15q11-q13 abnormalities."
  },
