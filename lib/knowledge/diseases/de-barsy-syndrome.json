    "formalCriteriaName": "De Barsy Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "skin-laxity",
        "description": "Congenital skin laxity with cutis laxa",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Severe postnatal growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Neurological developmental delay and intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progeroid-facies",
        "description": "Characteristic progeroid facial features including prominent forehead and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ophthalmological-abnormalities",
        "description": "Corneal clouding or opacities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital skin laxity, growth retardation, and developmental delay",
    "notes": "Genetic testing for mutations in ALDH18A1 or PYCR1 genes can support diagnosis"
  },
