  "keyFindings": {
    "laboratory": [
      "Peripheral eosinophilia >10%",
      "Elevated ESR and CRP",
      "Positive ANCA (usually p-ANCA/MPO) in ~40% of cases"
    ],
    "imaging": [
      "Chest X-ray or CT showing transient, patchy pulmonary infiltrates",
      "Sinus CT showing mucosal thickening and polyps"
    ],
