  "diagnosticCriteria": {
    "formalCriteriaName": "Alexander Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "gfap-mutation",
        "description": "Presence of pathogenic GFAP gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "leukodystrophy-mri",
        "description": "Characteristic MRI findings showing frontal predominant white matter abnormalities with contrast enhancement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Early onset progressive macrocephaly, developmental delay, and spasticity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rosenthal-fibers",
        "description": "Histopathological identification of Rosenthal fibers in astrocytes (if biopsy performed)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic GFAP mutation plus characteristic MRI findings and compatible clinical presentation",
    "notes": "Genetic testing is the gold standard; brain biopsy rarely required."
  },
