  "diagnosticCriteria": {
    "formalCriteriaName": "International Classification of Headache Disorders (ICHD-3) Criteria for Persistent Idiopathic Facial Pain",
    "criteria": [
      {
        "id": "duration",
        "description": "Facial pain present for more than 2 hours daily and persisting for more than 3 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pain_character",
        "description": "Pain is deep, poorly localized, dull, aching or burning in quality",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence_neurological_signs",
        "description": "No clinical neurological deficit or sensory abnormalities in the affected area",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion_of_other_causes",
        "description": "Exclusion of other causes of facial pain such as trigeminal neuralgia, dental pathology, or temporomandibular joint disorders",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lack_response_analgesics",
        "description": "Poor or no response to typical analgesic or neuropathic pain medications",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All major criteria must be met including duration, pain character, absence of neurological signs, and exclusion of other causes",
    "notes": "Diagnosis is primarily clinical and requires careful exclusion of secondary causes of facial pain."
  },
