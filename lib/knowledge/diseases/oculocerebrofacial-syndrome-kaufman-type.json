  "diagnosticCriteria": {
    "formalCriteriaName": "Kaufman Oculocerebrofacial Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "ocular-anomalies",
        "description": "Presence of congenital ocular anomalies including microphthalmia and cataracts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features such as micrognathia, broad nasal bridge, and cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-impairment",
        "description": "Severe developmental delay and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-anomalies",
        "description": "Presence of skeletal abnormalities including joint contractures and short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in UBE3B gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: congenital ocular anomalies, characteristic facial dysmorphism, and neurological impairment",
    "notes": "Genetic testing for UBE3B mutations supports diagnosis but is not mandatory if clinical criteria are met"
  },
