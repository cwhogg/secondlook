  "keyFindings": {
    "laboratory": [
      "Hypogammaglobulinemia with low IgG and IgA",
      "Elevated IgM in some cases",
      "Abnormal B and T lymphocyte subsets",
      "Lymphopenia or lymphocytosis"
    ],
    "imaging": [
      "Chest CT showing bronchiectasis",
      "Lymph node enlargement on ultrasound or CT",
      "Splenomegaly on abdominal ultrasound"
    ],
    "genetic": [
      "PIK3CD (causative, gain-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology of lymph nodes showing reactive lymphoproliferation",
      "Flow cytometry abnormalities in immune cell populations"
    ]
  },
