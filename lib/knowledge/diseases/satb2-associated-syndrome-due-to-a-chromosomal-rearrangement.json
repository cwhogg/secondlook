        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of chromosomal rearrangement involving SATB2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-anomalies",
        "description": "Severe dental anomalies such as delayed tooth eruption or missing teeth",
