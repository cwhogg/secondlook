  "diagnosticCriteria": {
    "formalCriteriaName": "Evans et al. Diagnostic Criteria for Gorlin Syndrome",
    "criteria": [
      {
        "id": "major-bcc",
        "description": "Multiple basal cell carcinomas or one basal cell carcinoma under age 20",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "major-jaw-cysts",
        "description": "Odontogenic keratocysts of the jaw confirmed by histology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "major-palmoplantar-pits",
        "description": "Three or more palmar or plantar pits",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "minor-skeletal",
        "description": "Skeletal abnormalities such as bifid ribs or vertebral anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "minor-calcification",
        "description": "Calcification of the falx cerebri",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "minor-macrocephaly",
        "description": "Macrocephaly adjusted for height",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Two major criteria or one major and two minor criteria",
    "notes": "Genetic testing for PTCH1 mutations can support diagnosis but is not required."
  },
