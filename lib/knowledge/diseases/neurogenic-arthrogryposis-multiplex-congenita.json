  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Neurogenic Arthrogryposis Multiplex Congenita",
    "criteria": [
      {
        "id": "multiple-joint-contractures",
        "description": "Presence of congenital multiple joint contractures affecting two or more body areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "evidence-of-neurogenic-etiology",
        "description": "Electromyography or nerve conduction studies showing neurogenic abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-hypoplasia-or-atrophy",
        "description": "Muscle hypoplasia or atrophy demonstrated clinically or by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history suggestive of inherited neurogenic disorder",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-central-nervous-system",
        "description": "Absence of central nervous system malformations on neuroimaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple congenital joint contractures with neurogenic abnormalities on electrophysiological studies and muscle hypoplasia or atrophy",
    "notes": "Diagnosis requires exclusion of primary myopathic and connective tissue causes of arthrogryposis."
  },
