        "notes": "Detected on CT imaging"
      },
      {
        "symptomName": "Liver fibrosis",
        "frequency": 0.07,
        "bodySystem": "gastrointestinal",
        "notes": "Progressive hepatic scarring"
      },
      {
        "symptomName": "Retinal vasculopathy",
