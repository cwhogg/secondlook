  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Creatine kinase may be mildly elevated in some cases"
    ],
    "imaging": [
      "X-rays showing joint contractures and dislocations",
      "Ultrasound or MRI demonstrating muscle hypoplasia or fibrosis",
      "Prenatal ultrasound may show decreased fetal movement"
    ],
    "genetic": [
      "Mutations in genes such as MYH3, TPM2, and others depending on subtype",
      "Genetic testing useful for subclassification and counseling"
    ],
    "other": [
      "Electromyography showing decreased muscle activity",
      "Muscle biopsy revealing fibrosis and fatty replacement"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "distal-arthrogryposis",
      "distinguishingFeatures": [
        "Primarily distal joint involvement",
        "Less severe muscle hypoplasia",
        "Often autosomal dominant inheritance"
      ]
    },
    {
      "diseaseId": "amyoplasia",
      "distinguishingFeatures": [
        "Classic form of AMC with symmetric limb involvement",
        "No associated systemic abnormalities",
        "Normal intelligence"
      ]
    },
    {
      "diseaseId": "congenital myopathies",
      "distinguishingFeatures": [
        "Primary muscle weakness rather than contractures",
        "Characteristic muscle biopsy findings",
        "Variable inheritance patterns"
      ]
    }
  ],
  "redFlags": [
    "Progressive respiratory failure",
    "Severe feeding difficulties with aspiration risk",
    "Neurological deterioration or seizures"
  ],
