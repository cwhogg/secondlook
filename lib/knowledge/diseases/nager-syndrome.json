  "diagnosticCriteria": {
    "formalCriteriaName": "Nager Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "mandibulofacial-dysostosis",
        "description": "Presence of mandibulofacial dysostosis including malar hypoplasia and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "preaxial-limb-anomalies",
        "description": "Preaxial limb anomalies such as hypoplasia or aplasia of the thumbs and radii",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ear-malformations",
        "description": "External ear malformations including microtia or anotia with conductive hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cleft-palate",
        "description": "Presence of cleft palate or high-arched palate",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-compromise",
        "description": "Respiratory difficulties due to mandibular hypoplasia and airway obstruction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Mandibulofacial dysostosis plus preaxial limb anomalies and ear malformations",
    "notes": "Genetic testing for SF3B4 mutations can support diagnosis but is not mandatory"
  },
