  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnosis based on maternal diabetes and congenital anomalies",
    "criteria": [
      {
        "id": "maternal-diabetes",
        "description": "Confirmed maternal pregestational or poorly controlled gestational diabetes during early pregnancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-malformations",
        "description": "Presence of characteristic congenital malformations such as caudal regression syndrome, neural tube defects, or cardiac anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other known genetic or environmental causes for the malformations",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of maternal diabetes during early pregnancy plus at least one major characteristic congenital malformation, with exclusion of other causes",
    "notes": "Diagnosis is clinical; genetic testing may be used to exclude other syndromes."
  },
