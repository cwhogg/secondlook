  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Mixed Gonadal Dysgenesis",
    "criteria": [
      {
        "id": "karyotype-mosaicism",
        "description": "Presence of 45,X/46,XY mosaic karyotype confirmed by cytogenetic analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gonadal-asymmetry",
        "description": "Asymmetric gonadal development with one dysgenetic testis and one streak gonad",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ambiguous-genitalia",
        "description": "Presence of ambiguous external genitalia or genital anomalies at birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-gonadal-abnormalities",
        "description": "Ultrasound or MRI evidence of gonadal dysgenesis or absence",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hormonal-profile",
        "description": "Abnormal sex steroid hormone levels consistent with gonadal dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed 45,X/46,XY mosaic karyotype plus clinical evidence of gonadal dysgenesis (gonadal asymmetry or ambiguous genitalia)",
    "notes": "Diagnosis requires integration of cytogenetic, clinical, and imaging findings."
  },
