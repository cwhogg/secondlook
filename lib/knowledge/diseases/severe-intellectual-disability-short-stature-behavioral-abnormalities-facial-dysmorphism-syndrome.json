  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for SIDSS Syndrome",
    "criteria": [
      {
        "id": "intellectual-disability-severity",
        "description": "Severe intellectual disability confirmed by standardized cognitive testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Height below the 3rd percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Presence of characteristic facial features including broad nasal bridge, hypertelorism, and thin upper lip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-abnormalities",
        "description": "Documented behavioral abnormalities such as hyperactivity, aggression, or self-injurious behavior",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-features",
        "description": "Additional findings such as hypotonia, delayed motor milestones, or feeding difficulties",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all four major criteria: severe intellectual disability, short stature, characteristic facial dysmorphism, and behavioral abnormalities",
    "notes": "Diagnosis is clinical; genetic testing may assist but no specific gene identified yet."
  },
