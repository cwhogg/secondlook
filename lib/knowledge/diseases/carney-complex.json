        "description": "Spotty skin pigmentation including lentigines and blue nevi",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "endocrine-tumors",
        "description": "Endocrine tumors such as primary pigmented nodular adrenocortical disease (PPNAD) or pituitary adenomas",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
