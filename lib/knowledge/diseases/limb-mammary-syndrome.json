  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Limb-Mammary Syndrome",
    "criteria": [
      {
        "id": "limb-malformations",
        "description": "Presence of upper limb malformations including hypoplasia or aplasia of the thumbs and/or radial ray defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mammary-gland-anomalies",
        "description": "Hypoplasia or aplasia of mammary glands and nipples",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ectodermal-abnormalities",
        "description": "Presence of ectodermal abnormalities such as hypoplastic or absent hair and dental anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (limb malformations and mammary gland anomalies) with or without minor or supportive criteria",
    "notes": "Genetic testing for mutations in the TP63 gene can support diagnosis."
  },
