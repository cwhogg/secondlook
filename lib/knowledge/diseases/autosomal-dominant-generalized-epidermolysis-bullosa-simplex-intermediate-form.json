  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Epidermolysis Bullosa Simplex",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Generalized blistering of the skin induced by minor mechanical trauma, primarily on palms and soles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Intraepidermal cleavage within basal keratinocytes on skin biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic heterozygous mutations in KRT5 or KRT14 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized blistering clinically plus either histopathological confirmation or identification of pathogenic mutation in KRT5/KRT14",
    "notes": "Genetic testing is critical for confirmation and subclassification."
  },
