  "diagnosticCriteria": {
    "formalCriteriaName": "Echocardiographic Diagnostic Criteria for Cardiac Myxoma",
    "criteria": [
      {
        "id": "echocardiographic-visualization",
        "description": "Visualization of an intracardiac mass, typically in the left atrium, on echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathological-confirmation",
        "description": "Histopathological confirmation of myxoma tissue after surgical excision",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-symptoms",
        "description": "Presence of obstructive cardiac symptoms or embolic phenomena consistent with myxoma",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Echocardiographic visualization of an intracardiac mass plus histopathological confirmation",
    "notes": "Diagnosis is often confirmed post-surgically; echocardiography is the primary diagnostic tool."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Positional exertional dyspnea",
        "frequency": 0.85,
        "bodySystem": "respiratory",
        "notes": "Symptoms worsen with changes in body position due to tumor mobility",
        "searchTerms": [
          "shortness of breath when changing position",
          "positional exertional breathlessness",
          "difficulty breathing with activity and posture"
        ]
      },
      {
        "symptomName": "Tumor plop (early diastolic sound)",
        "frequency": 0.75,
        "bodySystem": "cardiovascular",
        "notes": "Characteristic auscultatory finding",
        "searchTerms": [
          "early heart sound from tumor",
          "tumor plop heart noise",
          "diastolic sound caused by cardiac tumor"
        ]
      }
    ],
    "common": [
      {
        "symptomName": "Embolic stroke or transient ischemic attack",
        "frequency": 0.65,
        "bodySystem": "neurological",
        "notes": "Due to tumor emboli",
        "searchTerms": [
          "stroke or mini-stroke from embolism",
          "embolic brain attack",
          "transient ischemic attack or stroke symptoms"
        ]
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.6,
        "bodySystem": "constitutional"
      },
      {
        "symptomName": "Palpitations",
        "frequency": 0.55,
        "bodySystem": "cardiovascular"
      },
      {
        "symptomName": "Syncope",
        "frequency": 0.5,
        "bodySystem": "neurological",
        "notes": "Due to obstruction or embolic events"
      }
    ],
    "occasional": [
      {
        "symptomName": "Fever",
        "frequency": 0.3,
        "bodySystem": "constitutional",
        "notes": "May be due to cytokine release"
      },
      {
        "symptomName": "Weight loss",
        "frequency": 0.25,
        "bodySystem": "constitutional"
      },
      {
        "symptomName": "Hemoptysis",
        "frequency": 0.2,
        "bodySystem": "respiratory"
      },
      {
        "symptomName": "Peripheral embolic phenomena (e.g., digital ischemia)",
        "frequency": 0.15,
        "bodySystem": "cardiovascular",
        "searchTerms": [
          "blood clots causing finger or limb ischemia",
          "peripheral embolism with digital ischemia",
          "clot-related poor blood flow to extremities"
        ]
      }
    ],
    "rare": [
      {
        "symptomName": "Sudden cardiac death",
        "frequency": 0.05,
        "bodySystem": "cardiovascular",
        "searchTerms": [
