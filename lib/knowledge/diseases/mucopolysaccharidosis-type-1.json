  "keyFindings": {
    "laboratory": [
      "Reduced alpha-L-iduronidase enzyme activity in leukocytes or fibroblasts",
      "Elevated urinary glycosaminoglycans (dermatan sulfate and heparan sulfate)"
    ],
    "imaging": [
      "Skeletal X-rays showing dysostosis multiplex",
      "Brain MRI may show hydrocephalus or spinal cord compression",
      "Echocardiography revealing valvular thickening or cardiomyopathy"
    ],
    "genetic": [
      "Pathogenic variants in the IDUA gene on chromosome 4p16.3",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electrodiagnostic studies may show median nerve compression in carpal tunnel syndrome"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "mucopolysaccharidosis-type-2",
      "distinguishingFeatures": [
        "X-linked inheritance (male predominance)",
        "Absence of corneal clouding",
        "Deficiency of iduronate-2-sulfatase enzyme"
      ]
    },
    {
      "diseaseId": "mucopolysaccharidosis-type-6",
      "distinguishingFeatures": [
        "Normal intelligence",
        "Deficiency of arylsulfatase B enzyme",
        "Less severe skeletal abnormalities"
      ]
    }
  ],
  "redFlags": [
