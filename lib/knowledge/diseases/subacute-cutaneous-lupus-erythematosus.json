  "diagnosticCriteria": {
    "formalCriteriaName": "No universally accepted formal criteria; diagnosis based on clinical and serological features",
    "criteria": [
      {
        "id": "cutaneous-lesions",
        "description": "Presence of characteristic non-scarring, photosensitive, annular or papulosquamous cutaneous lesions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anti-ssa-ssb-antibodies",
        "description": "Positive anti-Ro/SSA and/or anti-La/SSB autoantibodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing interface dermatitis with epidermal atrophy and basal cell degeneration",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "photosensitivity",
        "description": "Clinical photosensitivity with lesion exacerbation upon UV exposure",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-scarring",
        "description": "Lack of scarring or atrophy differentiating from discoid lupus erythematosus",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic cutaneous lesions plus positive anti-Ro/SSA and/or anti-La/SSB antibodies",
    "notes": "Diagnosis is clinical supported by serology and histopathology; exclusion of other lupus subtypes is essential"
  },
