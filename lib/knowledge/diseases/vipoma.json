  "keyFindings": {
    "laboratory": [
      "Elevated plasma vasoactive intestinal peptide (VIP) > 75 pg/mL",
      "Hypokalemia (serum potassium < 3.5 mEq/L)",
      "Metabolic acidosis or alkalosis depending on severity",
      "Low or absent gastric acid secretion"
    ],
    "imaging": [
      "Pancreatic mass detected on CT or MRI",
      "Somatostatin receptor scintigraphy (Octreoscan) showing tumor localization",
      "Endoscopic ultrasound identifying pancreatic neuroendocrine tumor"
    ],
    "genetic": [
      "Usually sporadic; rare association with MEN1 syndrome"
    ],
    "other": [
      "Positive response to somatostatin analogues (e.g., octreotide)",
      "Histopathology confirming neuroendocrine tumor secreting VIP"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "carcinoid-syndrome",
      "distinguishingFeatures": [
        "Elevated serotonin and 5-HIAA instead of VIP",
        "Flushing and bronchospasm more prominent",
        "Diarrhea less severe and not typically hypokalemic"
      ]
    },
    {
      "diseaseId": "medullary-thyroid-carcinoma",
      "distinguishingFeatures": [
        "Elevated calcitonin levels",
        "Thyroid mass present",
        "Diarrhea present but VIP normal"
      ]
    },
    {
      "diseaseId": "secretory-diarrhea-of-other-etiologies",
      "distinguishingFeatures": [
        "Normal VIP levels",
        "Other causes identified (e.g., laxative abuse, infections)",
        "No pancreatic tumor on imaging"
      ]
    }
  ],
