  "diagnosticCriteria": {
    "formalCriteriaName": "Lysosomal Acid Lipase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Deficient lysosomal acid lipase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the LIPA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of hepatomegaly and dyslipidemia consistent with LAL-D",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Lipid accumulation in liver biopsy showing microvesicular steatosis and foam cells",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient lysosomal acid lipase enzyme activity plus identification of pathogenic LIPA gene variants; clinical features support diagnosis",
    "notes": "Enzyme assay and genetic testing are gold standards; liver biopsy is supportive but not mandatory"
  },
