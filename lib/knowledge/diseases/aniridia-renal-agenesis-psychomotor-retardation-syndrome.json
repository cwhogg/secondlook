  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Aniridia-Renal Agenesis-Psychomotor Retardation Syndrome",
    "criteria": [
      {
        "id": "aniridia",
        "description": "Congenital absence or severe hypoplasia of the iris",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-agenesis",
        "description": "Unilateral or bilateral renal agenesis or severe renal hypoplasia confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "psychomotor-retardation",
        "description": "Global developmental delay with significant psychomotor retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including broad nasal bridge and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation and failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: congenital aniridia, renal agenesis/hypoplasia, and psychomotor retardation",
    "notes": "Diagnosis is clinical and supported by imaging and developmental assessments; genetic testing may assist but no specific gene identified."
  },
