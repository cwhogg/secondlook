  "diagnosticCriteria": {
    "formalCriteriaName": "Holzgreve Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "hydrops-fetalis",
        "description": "Presence of non-immune hydrops fetalis detected prenatally or at birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial abnormalities including micrognathia and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-malformations",
        "description": "Presence of skeletal anomalies such as limb contractures or hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of causative genetic mutations if available",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of non-immune hydrops fetalis plus at least two major criteria (craniofacial dysmorphism and skeletal malformations)",
    "notes": "Diagnosis is primarily clinical; genetic confirmation may be supportive but is not always available."
  },
