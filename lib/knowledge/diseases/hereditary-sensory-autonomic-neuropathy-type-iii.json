  "keyFindings": {
    "laboratory": [
      "Reduced levels of IKBKAP mRNA in leukocytes",
      "Abnormal autonomic function tests (e.g., reduced baroreflex sensitivity)"
    ],
    "imaging": [
      "Normal brain MRI; may show secondary changes due to neuropathy"
    ],
    "genetic": [
      "Biallelic mutations in the IKBKAP (ELP1) gene"
    ],
    "other": [
      "Reduced or absent flare response to histamine skin testing",
      "Decreased number of unmyelinated nerve fibers on skin biopsy"
    ]
  },
