  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for typical HUS",
    "criteria": [
      {
        "id": "microangiopathic-hemolytic-anemia",
        "description": "Presence of microangiopathic hemolytic anemia evidenced by schistocytes on blood smear and elevated LDH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thrombocytopenia",
        "description": "Thrombocytopenia with platelet count below normal reference range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acute-renal-impairment",
        "description": "Acute kidney injury characterized by elevated serum creatinine and reduced urine output",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "preceding-infection",
        "description": "History of preceding gastrointestinal infection, often with bloody diarrhea caused by Shiga toxin-producing E. coli",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microangiopathic hemolytic anemia, thrombocytopenia, and acute renal impairment",
    "notes": "Exclusion of other causes of thrombotic microangiopathy is essential"
  },
