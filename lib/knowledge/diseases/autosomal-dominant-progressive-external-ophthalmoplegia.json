  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Autosomal Dominant Progressive External Ophthalmoplegia",
    "criteria": [
      {
        "id": "clinical-ophthalmoplegia",
        "description": "Progressive bilateral external ophthalmoplegia with ptosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mitochondrial-dna-abnormalities",
        "description": "Detection of multiple mitochondrial DNA deletions or mutations in nuclear genes associated with mitochondrial maintenance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing ragged-red fibers or cytochrome c oxidase (COX) negative fibers",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-neurological-disease",
        "description": "Exclusion of other causes of ophthalmoplegia such as myasthenia gravis or brainstem lesions",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive bilateral external ophthalmoplegia with ptosis, positive family history consistent with autosomal dominant inheritance, and confirmation of mitochondrial DNA abnormalities or pathogenic nuclear gene mutations",
    "notes": "Genetic testing is essential for confirmation; muscle biopsy may aid diagnosis in uncertain cases."
  },
