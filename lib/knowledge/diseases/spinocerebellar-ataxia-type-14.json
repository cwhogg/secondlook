  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of acquired causes of ataxia"
    ],
    "imaging": [
      "MRI showing cerebellar atrophy, especially vermis and hemispheres"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electrophysiological studies may show mild peripheral neuropathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "spinocerebellar-ataxia-type-3",
      "distinguishingFeatures": [
        "More prominent pyramidal signs",
        "Ophthalmoplegia common",
        "Ataxia with earlier onset in some cases"
      ]
    },
    {
      "diseaseId": "friedreich-ataxia",
      "distinguishingFeatures": [
        "Autosomal recessive inheritance",
        "Cardiomyopathy and diabetes mellitus frequent",
        "Loss of deep tendon reflexes"
      ]
    }
  ],
  "redFlags": [
