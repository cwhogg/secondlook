  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for Proximal 16p11.2 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of a heterozygous microdeletion at proximal 16p11.2 by chromosomal microarray or equivalent molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Presence of global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "speech-language-impairment",
        "description": "Speech and language delay or impairment",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-phenotype",
        "description": "Behavioral abnormalities including autism spectrum disorder or attention deficit hyperactivity disorder",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mild-dysmorphic-features",
        "description": "Presence of mild craniofacial dysmorphic features such as macrocephaly or facial asymmetry",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of proximal 16p11.2 microdeletion plus at least one major clinical feature such as developmental delay or speech impairment",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features are variable and may be subtle."
  },
