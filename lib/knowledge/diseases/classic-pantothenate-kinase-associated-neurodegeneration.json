  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for PKAN",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive extrapyramidal symptoms including dystonia and parkinsonism with onset in childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Characteristic 'eye-of-the-tiger' sign on T2-weighted brain MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the PANK2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of neurodegeneration with brain iron accumulation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive extrapyramidal symptoms with characteristic MRI findings and confirmation of biallelic PANK2 mutations",
    "notes": "Genetic testing is essential for definitive diagnosis; MRI findings are highly suggestive but not pathognomonic alone."
  },
