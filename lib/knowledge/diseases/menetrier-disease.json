  "keyFindings": {
    "laboratory": [
      "Hypoalbuminemia",
      "Elevated gastric fluid protein loss",
      "Mild anemia in some cases"
    ],
    "imaging": [
      "Endoscopy showing enlarged gastric folds",
      "Barium swallow or upper GI series demonstrating thickened gastric mucosa"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology showing foveolar hyperplasia and glandular atrophy",
      "Negative for Helicobacter pylori in most cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "zollinger-ellison-syndrome",
      "distinguishingFeatures": [
        "Gastric fold enlargement due to acid hypersecretion",
        "Elevated serum gastrin levels",
        "Ulcer disease predominates"
      ]
    },
    {
      "diseaseId": "gastric-lymphoma",
      "distinguishingFeatures": [
        "Mass lesions or ulcerations on endoscopy",
        "Lymphoid infiltrates on biopsy",
        "Systemic B symptoms may be present"
      ]
    },
    {
      "diseaseId": "hypertrophic-gastropathy-secondary",
      "distinguishingFeatures": [
        "Associated with infections or infiltrative diseases",
        "Variable histopathology",
        "May lack protein-losing gastropathy"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset of severe hypoalbuminemia",
    "Signs of gastric malignancy such as weight loss and bleeding",
    "Persistent vomiting with signs of gastric outlet obstruction"
  ],
  "specialistType": [
    "Gastroenterologist",
    "Pathologist"
  ],
