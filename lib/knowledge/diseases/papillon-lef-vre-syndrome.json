  "diagnosticCriteria": {
    "formalCriteriaName": "Papillon-Lefèvre syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "palmoplantar-keratoderma",
        "description": "Diffuse, symmetrical palmoplantar keratoderma appearing in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset-periodontitis",
        "description": "Severe periodontitis with premature loss of primary and permanent teeth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ctsc-gene-mutation",
        "description": "Biallelic pathogenic variants in the CTSC gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consanguinity or family history of similar symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of diffuse palmoplantar keratoderma and early-onset severe periodontitis with confirmation of CTSC gene mutation",
    "notes": "Genetic testing is critical to confirm diagnosis and differentiate from other keratoderma syndromes."
  },
