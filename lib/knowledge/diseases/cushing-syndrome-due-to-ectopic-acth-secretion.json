  "differentialDiagnoses": [
    {
      "diseaseId": "pituitary-cushing-disease",
      "distinguishingFeatures": [
        "Central-to-peripheral ACTH gradient on inferior petrosal sinus sampling",
        "Partial suppression on high-dose dexamethasone test",
        "Pituitary adenoma on MRI"
      ]
    },
    {
      "diseaseId": "adrenal-cushing-syndrome",
      "distinguishingFeatures": [
        "Low or suppressed plasma ACTH",
        "Adrenal mass on imaging",
        "No response to dexamethasone suppression tests"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset of severe hypercortisolism symptoms",
    "Severe hypokalemia refractory to supplementation",
    "Presence of ectopic tumor symptoms (e.g., cough, hemoptysis)"
  ],
