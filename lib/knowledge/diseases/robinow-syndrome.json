  "differentialDiagnoses": [
    {
      "diseaseId": "achondroplasia",
      "distinguishingFeatures": [
        "Disproportionate short stature with rhizomelic shortening",
        "Frontal bossing with midface hypoplasia but absence of genital hypoplasia",
        "FGFR3 gene mutation"
      ]
    },
    {
      "diseaseId": "campomelic-dysplasia",
      "distinguishingFeatures": [
        "Severe bowing of long bones",
        "Sex reversal in some cases",
        "SOX9 gene mutation"
      ]
    },
    {
      "diseaseId": "antley-bixler-syndrome",
      "distinguishingFeatures": [
        "Craniosynostosis",
        "Radiohumeral synostosis",
        "Abnormal genitalia but with distinct craniofacial features"
      ]
    }
  ],
  "redFlags": [
    "Severe respiratory distress due to thoracic cage abnormalities",
    "Congenital heart defects causing cyanosis or heart failure",
    "Marked genital hypoplasia with ambiguous genitalia"
  ],
