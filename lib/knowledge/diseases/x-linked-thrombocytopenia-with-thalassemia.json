  "diagnosticCriteria": {
    "formalCriteriaName": "No standardized formal criteria established",
    "criteria": [
      {
        "id": "thrombocytopenia",
        "description": "Persistent thrombocytopenia with platelet counts typically below 100,000/µL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thalassemia-phenotype",
        "description": "Presence of microcytic hypochromic anemia consistent with thalassemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the GATA1 gene on the X chromosome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-findings",
        "description": "Bone marrow showing dysmegakaryopoiesis with reduced platelet production",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "X-linked inheritance pattern with affected male relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of thrombocytopenia and thalassemia phenotype with confirmed GATA1 mutation",
    "notes": "Diagnosis is supported by clinical, hematological, and genetic findings; bone marrow biopsy may aid but is not mandatory."
  },
