  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Lung Tumors",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histopathological confirmation of neuroendocrine tumor cells with typical morphology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Positive immunohistochemical staining for neuroendocrine markers (chromogranin A, synaptophysin, CD56)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Radiologic evidence of a bronchial mass on chest CT or MRI",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of symptoms consistent with bronchial obstruction or carcinoid syndrome",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation with positive neuroendocrine immunohistochemistry and imaging evidence of bronchial mass",
    "notes": "Diagnosis requires tissue biopsy; imaging and clinical features support but do not replace histopathology."
  },
