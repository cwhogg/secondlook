        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mottled-pigmentation",
        "description": "Presence of mottled hyperpigmentation and hypopigmentation on the trunk and extremities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "keratin-5-mutation",
        "description": "Identification of pathogenic mutation in the KRT5 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing intraepidermal cleavage within basal keratinocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent trauma-induced blistering with characteristic mottled pigmentation and confirmation of KRT5 gene mutation",
    "notes": "Diagnosis is confirmed by genetic testing; skin biopsy and family history support diagnosis."
