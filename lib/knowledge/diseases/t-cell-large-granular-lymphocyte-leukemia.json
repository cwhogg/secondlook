  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Diagnostic Criteria for T-cell Large Granular Lymphocyte Leukemia",
    "criteria": [
      {
        "id": "clonal-t-cell-expansion",
        "description": "Presence of clonal expansion of large granular lymphocytes with T-cell receptor gene rearrangement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "persistent-cytopenias",
        "description": "Chronic neutropenia and/or anemia persisting for more than 6 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotyping",
        "description": "Immunophenotypic profile showing CD3+, CD8+, CD57+ large granular lymphocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-infiltration",
        "description": "Bone marrow infiltration by large granular lymphocytes without significant dysplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of splenomegaly or autoimmune manifestations such as rheumatoid arthritis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clonal T-cell expansion with characteristic immunophenotype plus persistent cytopenias",
    "notes": "Diagnosis requires exclusion of reactive causes of large granular lymphocytosis"
  },
