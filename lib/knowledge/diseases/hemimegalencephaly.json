  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Hemimegalencephaly",
    "criteria": [
      {
        "id": "unilateral-cerebral-enlargement",
        "description": "Unilateral enlargement of one cerebral hemisphere confirmed by neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cortical-malformation",
        "description": "Presence of cortical malformations such as polymicrogyria or pachygyria on affected hemisphere",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intractable-epilepsy",
        "description": "Early-onset, drug-resistant focal seizures originating from the affected hemisphere",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-deficits",
        "description": "Contralateral hemiparesis or hemiplegia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of unilateral cerebral enlargement with cortical malformation on imaging plus early-onset intractable epilepsy",
    "notes": "Diagnosis is primarily based on neuroimaging and clinical seizure presentation; genetic testing may support diagnosis."
  },
