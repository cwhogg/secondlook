  "diagnosticCriteria": {
    "formalCriteriaName": "Richieri Costa-Pereira syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "mandibular-hypoplasia",
        "description": "Severe mandibular hypoplasia with micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cleft-palate",
        "description": "Median or bilateral cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Preaxial limb anomalies including hypoplasia or aplasia of thumbs and first toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism and prominent nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Conductive or mixed hearing loss",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: mandibular hypoplasia, cleft palate, and preaxial limb malformations",
    "notes": "Diagnosis is primarily clinical, supported by genetic testing when available."
  },
