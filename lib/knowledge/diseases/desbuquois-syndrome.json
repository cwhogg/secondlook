  "diagnosticCriteria": {
    "formalCriteriaName": "Desbuquois syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "joint-laxity",
        "description": "Severe joint laxity with multiple dislocations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Severe pre- and postnatal short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-features",
        "description": "Characteristic radiographic findings including advanced carpal bone ossification and 'monkey wrench' appearance of proximal femora",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features such as midface hypoplasia and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-delay",
        "description": "Delayed bone age and growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: severe joint laxity with multiple dislocations, severe short stature, and characteristic radiological features",
    "notes": "Genetic testing for mutations in CANT1 gene can support diagnosis"
  },
