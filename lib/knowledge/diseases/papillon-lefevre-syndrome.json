  "diagnosticCriteria": {
    "formalCriteriaName": "Papillon-Lefevre Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "palmoplantar-keratoderma",
        "description": "Diffuse palmoplantar keratoderma appearing in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-periodontitis",
        "description": "Severe early-onset periodontitis leading to premature loss of primary and permanent teeth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ctsc-mutation",
        "description": "Identification of biallelic pathogenic mutations in the CTSC gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consanguinity or family history of similar symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of diffuse palmoplantar keratoderma and severe early-onset periodontitis with confirmed biallelic CTSC mutations",
    "notes": "Genetic testing is confirmatory; clinical diagnosis can be made based on dermatological and dental findings in typical age group"
  },
