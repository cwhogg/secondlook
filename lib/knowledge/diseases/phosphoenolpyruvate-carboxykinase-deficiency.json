  "diagnosticCriteria": {
    "formalCriteriaName": "Phosphoenolpyruvate Carboxykinase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Markedly reduced or absent phosphoenolpyruvate carboxykinase enzyme activity in liver or kidney tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the PCK1 gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Early onset hypoglycemia with lactic acidosis and hepatomegaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-profile",
        "description": "Elevated blood lactate and alanine levels with hypoglycemia during fasting",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus either reduced enzyme activity or pathogenic PCK1 variants",
    "notes": "Liver biopsy for enzyme assay is invasive; molecular testing is preferred when available."
  },
