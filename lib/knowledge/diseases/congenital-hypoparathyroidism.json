  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Congenital Hypoparathyroidism",
    "criteria": [
      {
        "id": "hypocalcemia",
        "description": "Persistent hypocalcemia with serum calcium below normal reference range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-pth",
        "description": "Low or inappropriately normal parathyroid hormone (PTH) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset",
        "description": "Onset of symptoms in neonatal period or early infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-causes",
        "description": "Exclusion of other causes of hypoparathyroidism such as autoimmune or surgical",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in genes associated with congenital hypoparathyroidism (e.g., PTH, GCM2, CASR)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent hypocalcemia with low or inappropriately normal PTH levels and onset in neonatal period or early infancy",
    "notes": "Genetic testing can support diagnosis but is not mandatory"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Hypocalcemic seizures",
        "frequency": 0.85,
        "bodySystem": "neurological",
        "notes": "Often presenting symptom in neonates"
      },
      {
        "symptomName": "Tetany",
        "frequency": 0.8,
        "bodySystem": "musculoskeletal",
        "notes": "Carpopedal spasms and muscle cramps"
      },
      {
        "symptomName": "Positive Chvostek's sign",
        "frequency": 0.75,
        "bodySystem": "neurological",
        "notes": "Facial muscle twitching upon tapping facial nerve",
        "searchTerms": [
          "facial muscle twitch when tapped",
          "positive facial nerve twitch test",
          "Chvostek's sign indicating nerve irritability"
        ]
      }
    ],
    "common": [
      {
        "symptomName": "Paresthesias",
        "frequency": 0.7,
        "bodySystem": "neurological",
        "notes": "Numbness and tingling sensations"
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.65,
        "bodySystem": "constitutional",
        "notes": "Generalized tiredness"
      },
      {
        "symptomName": "Muscle cramps",
        "frequency": 0.6,
        "bodySystem": "musculoskeletal",
        "notes": "Painful involuntary contractions"
      },
      {
        "symptomName": "Dry skin",
        "frequency": 0.55,
        "bodySystem": "dermatological",
        "notes": "Skin xerosis"
      },
      {
        "symptomName": "Brittle nails",
        "frequency": 0.5,
        "bodySystem": "dermatological",
        "notes": "Fragile and easily broken nails"
      }
    ],
    "occasional": [
      {
        "symptomName": "Cataracts",
        "frequency": 0.3,
        "bodySystem": "ophthalmological",
        "notes": "Lens opacities developing over time"
      },
      {
        "symptomName": "Basal ganglia calcifications",
        "frequency": 0.25,
        "bodySystem": "neurological",
        "notes": "Detected on imaging, may cause movement disorders",
        "searchTerms": [
          "calcium deposits in brain's basal ganglia",
          "brain region calcifications",
          "hardening spots in deep brain areas"
        ]
      },
      {
        "symptomName": "Mood disturbances",
        "frequency": 0.2,
        "bodySystem": "psychiatric",
        "notes": "Irritability, anxiety, or depression"
      },
      {
        "symptomName": "Dental hypoplasia",
        "frequency": 0.15,
        "bodySystem": "musculoskeletal",
        "notes": "Underdeveloped tooth enamel"
      },
      {
        "symptomName": "Hoarseness",
        "frequency": 0.1,
        "bodySystem": "otolaryngological",
        "notes": "Due to laryngeal muscle involvement"
      }
    ],
    "rare": [
      {
        "symptomName": "Heart failure",
        "frequency": 0.05,
        "bodySystem": "cardiovascular",
        "notes": "Secondary to severe hypocalcemia"
      },
      {
        "symptomName": "Severe intracranial calcifications",
        "frequency": 0.04,
        "bodySystem": "neurological",
        "notes": "May cause seizures or movement disorders",
        "searchTerms": [
          "extensive brain calcifications",
          "severe calcium buildup in brain",
          "widespread intracranial calcium deposits"
        ]
      },
      {
        "symptomName": "Renal insufficiency",
        "frequency": 0.03,
        "bodySystem": "renal",
        "notes": "Due to chronic calcium and phosphate imbalance"
      },
      {
        "symptomName": "Laryngospasm",
        "frequency": 0.02,
        "bodySystem": "respiratory",
        "notes": "Potentially life-threatening airway obstruction"
      }
    ]
  },
