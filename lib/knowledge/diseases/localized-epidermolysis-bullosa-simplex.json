  "diagnosticCriteria": {
    "formalCriteriaName": "Localized Epidermolysis Bullosa Simplex Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Recurrent blistering localized to hands and feet triggered by minor mechanical trauma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Intraepidermal cleavage with basal keratinocyte cytolysis on skin biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in KRT5 or KRT14 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Immunofluorescence showing cleavage within basal keratinocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent localized blistering plus histopathological confirmation or genetic testing identifying pathogenic variants in KRT5 or KRT14",
    "notes": "Diagnosis is primarily clinical supported by histology and genetic testing; immunofluorescence and family history aid confirmation."
  },
