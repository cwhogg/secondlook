  "diagnosticCriteria": {
    "formalCriteriaName": "ESID Diagnostic Criteria for SCID",
    "criteria": [
      {
        "id": "lymphopenia",
        "description": "Profound T-cell lymphopenia with normal or elevated B-cell counts (T-B+ phenotype)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "jak3-mutation",
        "description": "Identification of pathogenic biallelic mutations in the JAK3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-lymphocyte-function",
        "description": "Absent or severely reduced T-cell proliferative response to mitogens",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Recurrent severe infections, failure to thrive, and chronic diarrhea",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of T-cell lymphopenia with normal B-cell counts, confirmed pathogenic JAK3 mutations, and impaired T-cell function",
    "notes": "Genetic confirmation is critical for definitive diagnosis and family counseling."
  },
