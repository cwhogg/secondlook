        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic mutations in the TBXAS1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-causes",
        "description": "Exclusion of other causes of anemia and bone dysplasia",
