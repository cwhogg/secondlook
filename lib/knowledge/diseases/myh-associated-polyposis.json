  "diagnosticCriteria": {
    "formalCriteriaName": "MAP Diagnostic Criteria",
    "criteria": [
      {
        "id": "biallelic-mutyh-mutations",
        "description": "Presence of biallelic pathogenic mutations in the MUTYH gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multiple-adenomatous-polyps",
        "description": "Presence of 10-100 colorectal adenomatous polyps",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history consistent with autosomal recessive inheritance or colorectal cancer",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-apc-mutation",
        "description": "No pathogenic mutations identified in the APC gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biallelic MUTYH mutations plus presence of multiple adenomatous colorectal polyps",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical presentation overlaps with attenuated familial adenomatous polyposis."
  },
