  "keyFindings": {
    "laboratory": [
      "CSF analysis typically normal or mildly elevated protein",
      "Exclusion of other metabolic leukodystrophies"
    ],
    "imaging": [
      "MRI showing frontal white matter abnormalities with contrast enhancement",
      "Atrophy of medulla and cervical spinal cord in some cases"
    ],
    "genetic": [
      "Pathogenic mutations in GFAP gene confirmed by sequencing"
    ],
    "other": [
      "Histopathology (rarely performed) shows Rosenthal fibers in astrocytes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "multiple-sclerosis",
      "distinguishingFeatures": [
        "Relapsing-remitting course",
        "Oligoclonal bands in CSF",
        "Lesions not predominantly frontal white matter with contrast enhancement"
      ]
    },
    {
      "diseaseId": "adult-onset-metachromatic-leukodystrophy",
      "distinguishingFeatures": [
        "Arylsulfatase A deficiency",
        "Peripheral neuropathy more prominent",
        "Different MRI pattern with periventricular involvement"
      ]
    },
    {
      "diseaseId": "hereditary-spastic-paraplegia",
      "distinguishingFeatures": [
        "Pure spasticity without prominent bulbar signs",
        "No characteristic MRI white matter changes",
        "Genetic mutations distinct from GFAP"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive bulbar dysfunction",
    "Early onset spasticity with frontal white matter lesions",
    "Confirmed GFAP mutation in symptomatic adult"
  ],
