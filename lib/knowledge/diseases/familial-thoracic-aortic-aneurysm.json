  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Thoracic Aortic Aneurysm Diagnostic Criteria",
    "criteria": [
      {
        "id": "family-history",
        "description": "Presence of thoracic aortic aneurysm or dissection in two or more first-degree relatives",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aortic-dilation",
        "description": "Imaging evidence of progressive dilation of the thoracic aorta exceeding normal age and body size parameters",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic mutation in genes associated with familial thoracic aortic aneurysm (e.g., TGFBR1, TGFBR2, ACTA2)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-syndromic-features",
        "description": "Lack of systemic features suggestive of syndromic aortopathies such as Marfan or Loeys-Dietz syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of thoracic aortic aneurysm in at least two first-degree relatives or aortic dilation with a pathogenic mutation in a relevant gene",
    "notes": "Diagnosis requires exclusion of syndromic causes of thoracic aortic aneurysm."
  },
