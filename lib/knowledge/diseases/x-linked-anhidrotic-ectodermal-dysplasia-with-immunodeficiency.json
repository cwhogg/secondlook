  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria established",
    "criteria": [
      {
        "id": "anhidrosis",
        "description": "Congenital absence or severe reduction of sweat gland function leading to anhidrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Combined immunodeficiency with recurrent infections and impaired antibody responses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ectodermal-dysplasia-features",
        "description": "Characteristic ectodermal abnormalities including hypotrichosis and hypodontia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-abnormalities",
        "description": "Presence of dry eye syndrome and corneal defects",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in the IKBKG (NEMO) gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (anhidrosis, immunodeficiency, and ectodermal dysplasia features) with or without genetic confirmation",
    "notes": "Genetic testing is strongly recommended to confirm diagnosis and differentiate from other ectodermal dysplasias."
  },
