  "diagnosticCriteria": {
    "formalCriteriaName": "Schmid Metaphyseal Chondrodysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "short-stature",
        "description": "Short stature with disproportionate limb shortening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metaphyseal-abnormalities",
        "description": "Radiographic metaphyseal abnormalities including irregular, flared, and cupped metaphyses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "col11a1-or-col11a2-mutation",
        "description": "Identification of pathogenic mutation in COL10A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic metaphyseal abnormalities on imaging plus pathogenic COL10A1 mutation or typical clinical phenotype with radiographic findings",
    "notes": "Genetic testing is confirmatory; clinical and radiographic features guide initial diagnosis."
  },
