  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Giant Axonal Neuropathy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive sensorimotor peripheral neuropathy with gait disturbance and muscle weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-biopsy",
        "description": "Presence of abnormally enlarged axons with accumulation of neurofilaments on nerve biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the GAN gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "Brain MRI showing white matter abnormalities supportive but not diagnostic",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive sensorimotor neuropathy plus either nerve biopsy findings or biallelic GAN gene mutations",
    "notes": "Genetic confirmation is considered definitive; nerve biopsy is invasive but highly characteristic."
  },
