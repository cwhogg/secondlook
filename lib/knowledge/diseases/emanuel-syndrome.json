  "keyFindings": {
    "laboratory": [
      "Karyotype showing supernumerary derivative chromosome 22",
      "Fluorescence in situ hybridization (FISH) confirming derivative chromosome",
      "Normal routine blood tests unless secondary complications"
    ],
    "imaging": [
      "Echocardiogram revealing congenital heart defects",
      "Renal ultrasound showing structural anomalies",
      "Brain MRI may show nonspecific findings related to developmental delay"
    ],
    "genetic": [
      "Presence of supernumerary derivative chromosome 22 from t(11;22)(q23;q11) translocation",
      "Parental balanced translocation carrier status"
    ],
    "other": [
      "Developmental assessments confirming intellectual disability",
      "Audiological evaluations for hearing impairment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cat-eye-syndrome",
      "distinguishingFeatures": [
        "Presence of coloboma of the iris",
        "Less severe intellectual disability",
        "Different chromosomal abnormality involving chromosome 22"
      ]
    },
    {
      "diseaseId": "22q11-deletion-syndrome",
      "distinguishingFeatures": [
        "Microdeletion of 22q11.2 rather than supernumerary chromosome",
        "Characteristic immunodeficiency and hypocalcemia",
        "Distinct facial features and cardiac defects"
      ]
    }
  ],
  "redFlags": [
