  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for Androgen Insensitivity Syndrome",
    "criteria": [
      {
        "id": "androgen-receptor-mutation",
        "description": "Identification of pathogenic mutation in the androgen receptor (AR) gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ambiguous-genitalia",
        "description": "Presence of ambiguous or undervirilized external genitalia in a 46,XY individual",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "androgen-resistance-evidence",
        "description": "Clinical or biochemical evidence of androgen resistance such as elevated serum testosterone with poor virilization",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-internal-mullerian-structures",
        "description": "Absence of uterus and fallopian tubes on imaging or surgery",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history of androgen insensitivity syndrome or related disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of ambiguous genitalia in a 46,XY individual plus identification of a pathogenic AR gene mutation or clinical evidence of androgen resistance",
    "notes": "Diagnosis is confirmed by molecular genetic testing of the AR gene combined with clinical and biochemical findings."
  },
