  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for CBAS1",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Neonatal or infantile cholestasis with normal or low serum bile acids",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-analysis",
        "description": "Abnormal bile acid profile with elevated atypical bile acid intermediates detected by mass spectrometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the HSD3B7 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-biopsy",
        "description": "Histological evidence of cholestasis and giant cell hepatitis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus abnormal bile acid profile and confirmation by genetic testing",
    "notes": "Early diagnosis is critical to prevent progressive liver disease."
  },
