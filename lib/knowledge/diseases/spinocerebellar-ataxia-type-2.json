  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for SCA2",
    "criteria": [
      {
        "id": "progressive-ataxia",
        "description": "Progressive cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cag-repeat-expansion",
        "description": "Pathogenic CAG trinucleotide repeat expansion in the ATXN2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "slow-saccades",
        "description": "Presence of slow horizontal saccadic eye movements",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuropathy",
        "description": "Peripheral sensory-motor neuropathy on electrophysiological studies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive cerebellar ataxia plus pathogenic CAG repeat expansion in ATXN2 gene",
    "notes": "Genetic testing is definitive; clinical features support diagnosis"
  },
