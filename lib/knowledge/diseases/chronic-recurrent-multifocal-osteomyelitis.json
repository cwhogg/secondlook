  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP during active disease",
      "Negative blood and bone biopsy cultures",
      "Mild anemia of chronic disease"
    ],
    "imaging": [
      "MRI showing multifocal bone marrow edema",
      "X-rays with lytic and sclerotic lesions",
      "Bone scintigraphy demonstrating multiple active sites"
    ],
    "genetic": [
      "Association with mutations in LPIN2, IL1RN, and other autoinflammatory genes in some cases",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology showing sterile chronic inflammation with neutrophilic and lymphocytic infiltrates"
    ]
