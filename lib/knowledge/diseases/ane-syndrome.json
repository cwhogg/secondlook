  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Acute Necrotizing Encephalopathy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Rapid onset of encephalopathy following viral febrile illness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Bilateral symmetric multifocal brain lesions involving thalami, brainstem, cerebellum, and white matter on MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-infectious",
        "description": "Exclusion of infectious encephalitis by CSF analysis and microbiological studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "laboratory-markers",
        "description": "Elevated serum aminotransferases and CSF protein without pleocytosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of RANBP2 gene mutation (familial cases)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of rapid encephalopathy onset after viral illness, characteristic bilateral symmetric brain lesions on MRI, and exclusion of infectious encephalitis",
    "notes": "Genetic testing for RANBP2 mutation supports diagnosis in familial cases but is not mandatory."
  },
