  "diagnosticCriteria": {
    "formalCriteriaName": "RFT1-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of multisystemic symptoms including developmental delay, hypotonia, and failure to thrive",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "transferrin-analysis",
        "description": "Abnormal serum transferrin glycosylation pattern consistent with type I CDG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the RFT1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-lab",
        "description": "Elevated liver enzymes and coagulation abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of abnormal transferrin glycosylation pattern plus biallelic pathogenic RFT1 variants with compatible clinical features",
    "notes": "Diagnosis requires integration of clinical, biochemical, and genetic data."
  },
