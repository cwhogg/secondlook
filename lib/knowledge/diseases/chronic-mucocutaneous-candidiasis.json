  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Chronic Mucocutaneous Candidiasis",
    "criteria": [
      {
        "id": "persistent-candida-infection",
        "description": "Recurrent or persistent Candida infections of skin, nails, and mucous membranes lasting more than 6 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immune-dysfunction",
        "description": "Evidence of impaired cell-mediated immunity against Candida species",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-immunodeficiencies",
        "description": "Exclusion of other primary or secondary immunodeficiencies causing candidiasis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in genes such as STAT1, AIRE, or CARD9 associated with CMC",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent Candida infections plus evidence of immune dysfunction and exclusion of other immunodeficiencies",
    "notes": "Diagnosis is clinical supported by immunological and genetic testing"
  },
