  "diagnosticCriteria": {
    "formalCriteriaName": "N Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including hypertelorism and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-cardiac-anomaly",
        "description": "Documented congenital cardiac defects such as ventricular septal defect or pulmonary stenosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability evident before age 5",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-pigmentary-abnormalities",
        "description": "Presence of café-au-lait spots or other pigmentary skin anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation below the 5th percentile for age",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be present for diagnosis",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
