        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-history",
        "description": "History of episodic metabolic decompensation triggered by fasting or illness",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent ketoacidotic episodes plus either enzyme assay confirmation or pathogenic OXCT1 gene variants",
