  "keyFindings": {
    "laboratory": [
      "Low serum pancreatic enzyme levels (e.g., lipase, amylase)",
      "Malabsorption markers including steatorrhea",
      "Hypothyroidism labs (elevated TSH, low free T4)"
    ],
    "imaging": [
      "Pancreatic hypoplasia or fatty replacement on abdominal ultrasound or MRI",
      "Brain MRI may show nonspecific findings related to developmental delay",
      "Cardiac echocardiography for congenital heart defects"
    ],
    "genetic": [
      "UBR1 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology of pancreas showing acinar cell hypoplasia",
      "Audiometry confirming sensorineural hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "shwachman-diamond-syndrome",
      "distinguishingFeatures": [
        "Presence of bone marrow failure and neutropenia",
        "Less prominent nasal alae hypoplasia",
        "SBDS gene mutations"
      ]
    },
    {
      "diseaseId": "pearson-syndrome",
      "distinguishingFeatures": [
        "Mitochondrial DNA deletions",
        "Severe sideroblastic anemia",
        "Pancreatic exocrine insufficiency but with distinct hematological features"
      ]
    }
  ],
  "redFlags": [
    "Failure to thrive with malabsorption in infancy",
