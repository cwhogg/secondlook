  "keyFindings": {
    "laboratory": [
      "ANCA negative (important to distinguish from MPA/GPA)",
      "Elevated ESR and CRP",
      "Leukocytosis (neutrophilia)",
      "Anemia of chronic disease",
      "Hepatitis B surface antigen positive (~10% of cases historically)",
      "Elevated creatinine (from renal artery involvement)",
      "No glomerulonephritis on urinalysis (distinguishes from ANCA vasculitis)"
    ],
    "imaging": [
      "Mesenteric/renal angiography: multiple microaneurysms and segmental stenoses",
      "CT angiography: visceral artery aneurysms and occlusions",
      "CT abdomen: renal infarcts, mesenteric ischemia"
    ],
    "genetic": [
      "DADA2 (ADA2 deficiency) in childhood-onset PAN-like disease",
      "CECR1 mutations in monogenic forms"
    ],
    "other": [
      "Medium-vessel biopsy (sural nerve, skin): fibrinoid necrotizing arteritis of muscular arteries",
      "Testicular biopsy: necrotizing vasculitis of medium arteries"
    ]
  },
