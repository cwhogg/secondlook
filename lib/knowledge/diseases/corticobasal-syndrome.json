  "diagnosticCriteria": {
    "formalCriteriaName": "Armstrong Criteria for Corticobasal Syndrome",
    "criteria": [
      {
        "id": "asymmetric-rigidity",
        "description": "Asymmetric limb rigidity or akinesia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "apraxia",
        "description": "Limb apraxia, especially ideomotor or limb-kinetic apraxia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cortical-sensory-loss",
        "description": "Cortical sensory deficits such as astereognosis or agraphesthesia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alien-limb",
        "description": "Presence of alien limb phenomenon",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cognitive-impairment",
        "description": "Cognitive dysfunction including executive dysfunction or language impairment",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of asymmetric rigidity or akinesia plus apraxia and cortical sensory loss",
    "notes": "Diagnosis is clinical and supported by exclusion of other causes; imaging and pathology may assist."
  },
