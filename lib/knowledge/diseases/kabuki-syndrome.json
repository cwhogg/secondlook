  "diagnosticCriteria": {
    "formalCriteriaName": "Niikawa-Kuroki Diagnostic Criteria",
    "criteria": [
      {
        "id": "facial-features",
        "description": "Distinctive facial features including long palpebral fissures with eversion of the lateral third of the lower eyelid, arched eyebrows with sparse lateral third, and prominent ears",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-anomalies",
        "description": "Skeletal anomalies such as brachydactyly, clinodactyly, and vertebral abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "postnatal-growth-deficiency",
        "description": "Postnatal growth deficiency or short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic mutation in KMT2D or KDM6A genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (distinctive facial features, skeletal anomalies, intellectual disability) or genetic confirmation with supportive clinical features",
    "notes": "Genetic testing is increasingly used to confirm diagnosis; clinical diagnosis remains important in resource-limited settings."
  },
