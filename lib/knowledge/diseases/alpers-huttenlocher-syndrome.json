  "diagnosticCriteria": {
    "formalCriteriaName": "Alpers-Huttenlocher Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-seizures",
        "description": "Progressive intractable seizures including epilepsia partialis continua",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepatic-dysfunction",
        "description": "Progressive liver failure without other identifiable cause",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurodegeneration",
        "description": "Progressive neurodegeneration with cortical atrophy on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mtDNA-depletion",
        "description": "Mitochondrial DNA depletion confirmed by genetic or biochemical testing",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "POLG-mutation",
        "description": "Biallelic pathogenic variants in POLG gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive intractable seizures, progressive liver failure, and neurodegeneration with supportive genetic or biochemical evidence",
    "notes": "Genetic testing for POLG mutations is critical for confirmation"
  },
