        "Elevated prolactin without elevated GH",
        "Absence of acromegalic features"
      ]
    },
    {
      "diseaseId": "somatotropinoma",
      "distinguishingFeatures": [
        "Elevated GH without elevated prolactin",
        "Acromegaly without galactorrhea or menstrual disturbances"
      ]
    }
  ],
