  "diagnosticCriteria": {
    "formalCriteriaName": "MEN4 Diagnostic Criteria",
    "criteria": [
      {
        "id": "cdkn1b-mutation",
        "description": "Presence of pathogenic germline mutation in the CDKN1B gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "endocrine-tumors",
        "description": "Development of tumors in two or more endocrine glands including parathyroid, pituitary, or adrenal glands",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of MEN4 or related endocrine tumors",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic CDKN1B mutation plus tumors in at least two endocrine glands",
    "notes": "Diagnosis requires genetic confirmation due to overlap with MEN1 and other MEN syndromes."
  },
