  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Recessive Dystrophic Epidermolysis Bullosa Inversa",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of blistering and erosions predominantly in intertriginous and flexural areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing sublamina densa cleavage with absent or reduced type VII collagen",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the COL7A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consanguinity or affected siblings consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Reduced or absent anchoring fibrils on immunofluorescence microscopy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus histopathological confirmation and genetic testing identifying biallelic COL7A1 mutations",
    "notes": "Diagnosis requires integration of clinical, histological, and molecular findings due to phenotypic overlap with other EB subtypes."
  },
