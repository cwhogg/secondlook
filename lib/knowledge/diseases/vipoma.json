  "diagnosticCriteria": {
    "formalCriteriaName": "VIPoma Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-secretory-diarrhea",
        "description": "Presence of chronic, profuse watery diarrhea persisting for weeks to months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-serum-vip",
        "description": "Elevated plasma vasoactive intestinal peptide (VIP) levels above normal reference range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-pancreatic-mass",
        "description": "Identification of pancreatic neuroendocrine tumor on imaging studies (CT, MRI, or somatostatin receptor scintigraphy)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypokalemia",
        "description": "Hypokalemia secondary to excessive VIP-induced intestinal secretion",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-somatostatin-analogues",
        "description": "Clinical improvement of diarrhea and electrolyte abnormalities with somatostatin analogue therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic secretory diarrhea, elevated serum VIP levels, and imaging evidence of pancreatic tumor",
    "notes": "Diagnosis requires exclusion of other causes of secretory diarrhea and confirmation of VIP elevation."
  },
