        "requiredForDiagnosis": true
      },
      {
        "id": "underlying-disorder",
        "description": "Identification of an associated underlying disorder known to cause acquired von Willebrand syndrome (e.g., lymphoproliferative disorders, cardiovascular disease, autoimmune diseases)",
