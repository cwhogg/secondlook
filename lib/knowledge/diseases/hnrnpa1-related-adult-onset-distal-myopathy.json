  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for HNRNPA1-related Distal Myopathy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Adult-onset distal muscle weakness predominantly affecting distal lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic HNRNPA1 gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy-findings",
        "description": "Muscle biopsy showing rimmed vacuoles and myopathic changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "EMG demonstrating myopathic motor unit potentials",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of adult-onset distal myopathy or related neuromuscular disorder",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of adult-onset distal muscle weakness with pathogenic HNRNPA1 mutation and supportive muscle biopsy findings",
    "notes": "Diagnosis requires integration of clinical, genetic, and pathological data; EMG and family history support but are not mandatory."
  },
