  "diagnosticCriteria": {
    "formalCriteriaName": "Feingold Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Presence of microcephaly (head circumference below the 3rd percentile)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digital-anomalies",
        "description": "Syndactyly or clinodactyly of the 2nd and 3rd toes or fingers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "esophageal-atresia",
        "description": "Esophageal or duodenal atresia or stenosis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "short-palpebral-fissures",
        "description": "Short palpebral fissures",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "learning-disability",
        "description": "Mild to moderate intellectual disability or learning difficulties",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microcephaly and digital anomalies with or without esophageal atresia or stenosis",
    "notes": "Genetic testing confirming MYCN gene mutation supports diagnosis"
  },
