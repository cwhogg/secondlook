        "No systemic symptoms"
      ]
    },
    {
      "diseaseId": "primary-cns-vasculitis",
      "distinguishingFeatures": [
        "Younger patients",
        "CNS symptoms predominate",
        "Normal ESR/CRP",
        "Abnormal cerebral angiography"
      ]
    }
  ],
  "redFlags": [
    "Sudden vision loss or amaurosis fugax (ophthalmologic emergency)",
    "New headache in patient over 50 with elevated ESR",
    "Jaw claudication with systemic inflammation",
    "Asymmetric blood pressure or absent pulses suggesting aortitis",
    "Chest/back pain in patient with known GCA (aortic dissection risk)"
  ],
