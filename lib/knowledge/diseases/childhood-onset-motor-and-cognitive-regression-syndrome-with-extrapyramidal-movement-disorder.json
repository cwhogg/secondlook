  "keyFindings": {
    "laboratory": [
      "Elevated cerebrospinal fluid protein in some cases",
      "Normal or mildly elevated serum lactate"
    ],
    "imaging": [
      "MRI showing basal ganglia signal abnormalities",
      "Cerebral and cerebellar atrophy on neuroimaging"
    ],
    "genetic": [
      "UBTF (causative, gain-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electroencephalogram may show nonspecific slowing or epileptiform activity"
    ]
  },
