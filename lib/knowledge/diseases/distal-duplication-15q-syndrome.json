  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible anemia in rare cases"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter abnormalities",
      "Echocardiogram to evaluate congenital heart defects"
    ],
    "genetic": [
      "Chromosomal microarray or karyotype showing duplication of distal 15q region"
    ],
    "other": [
      "Neurodevelopmental assessment confirming developmental delay",
      "EEG abnormalities in patients with seizures"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "prader-willi-syndrome",
      "distinguishingFeatures": [
        "Deletion or uniparental disomy of 15q11-q13 region",
        "Hyperphagia and obesity",
        "Hypogonadism"
      ]
    },
    {
      "diseaseId": "angelman-syndrome",
      "distinguishingFeatures": [
        "Deletion or mutation in maternal 15q11-q13",
        "Severe intellectual disability with ataxia and happy demeanor",
        "Characteristic EEG pattern"
      ]
    },
    {
      "diseaseId": "15q11-q13 duplication syndrome",
      "distinguishingFeatures": [
        "Duplication involves proximal 15q region rather than distal",
        "More prominent autism spectrum disorder features",
        "Different neurobehavioral profile"
      ]
    }
  ],
