  "diagnosticCriteria": {
    "formalCriteriaName": "Axial Mesodermal Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "axial-skeletal-malformations",
        "description": "Presence of axial skeletal malformations including vertebral segmentation defects and rib anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midline-facial-dysmorphisms",
        "description": "Midline facial dysmorphisms such as cleft palate, hypertelorism, or nasal anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-cardiac-anomalies",
        "description": "Congenital cardiac malformations including septal defects or outflow tract anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-malformations",
        "description": "Renal anomalies such as unilateral renal agenesis or hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with axial mesodermal development",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (axial skeletal malformations and midline facial dysmorphisms) with or without minor criteria",
    "notes": "Genetic testing can support diagnosis but is not mandatory; clinical presentation is key."
  },
