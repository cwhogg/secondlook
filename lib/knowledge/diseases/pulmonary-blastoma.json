        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-tumors",
        "description": "Exclusion of other primary lung malignancies or metastatic tumors",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-dicer1-mutation",
        "description": "Identification of DICER1 gene mutation supportive but not mandatory",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of biphasic tumor with epithelial and mesenchymal components plus compatible imaging findings",
    "notes": "Genetic testing for DICER1 mutations can aid diagnosis and familial counseling."
