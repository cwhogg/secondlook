  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Primary Fanconi Renotubular Syndrome",
    "criteria": [
      {
        "id": "proximal-tubular-dysfunction",
        "description": "Evidence of generalized proximal renal tubular dysfunction including aminoaciduria, glycosuria, phosphaturia, and bicarbonaturia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypophosphatemic-rickets",
        "description": "Presence of hypophosphatemic rickets or osteomalacia secondary to phosphate wasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-secondary-causes",
        "description": "Exclusion of secondary causes of Fanconi syndrome such as drug toxicity, heavy metal exposure, or systemic diseases",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with inherited renal tubular dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in genes associated with primary Fanconi syndrome (e.g., EHHADH, HNF4A)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized proximal tubular dysfunction with hypophosphatemic rickets and exclusion of secondary causes",
    "notes": "Genetic testing can support diagnosis but is not mandatory."
  },
