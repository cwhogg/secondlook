  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Renal Amyloidosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "renal-proteinuria",
        "description": "Presence of persistent proteinuria (>1g/day) without other causes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "amyloid-deposits-biopsy",
        "description": "Demonstration of amyloid deposits in renal biopsy with Congo red staining",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of amyloidosis or renal impairment",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in amyloidogenic genes (e.g., fibrinogen A alpha-chain gene)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-secondary-amyloidosis",
        "description": "Exclusion of secondary causes of amyloidosis (e.g., chronic inflammation, infection)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of proteinuria and amyloid deposits on renal biopsy plus identification of pathogenic mutation or positive family history",
    "notes": "Genetic testing is critical for confirmation and family counseling."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Nephrotic-range proteinuria",
        "frequency": 0.85,
        "bodySystem": "renal",
        "notes": "Often the earliest and most prominent manifestation"
      },
      {
        "symptomName": "Amyloid deposits in renal tissue",
        "frequency": 0.9,
        "bodySystem": "renal",
        "notes": "Confirmed by Congo red staining and electron microscopy"
      },
      {
        "symptomName": "Familial history of amyloidosis",
        "frequency": 0.75,
        "bodySystem": "constitutional",
        "notes": "Strongly suggestive in affected families"
      }
    ],
    "common": [
      {
        "symptomName": "Progressive renal impairment",
        "frequency": 0.75,
        "bodySystem": "renal",
        "notes": "Leads to chronic kidney disease and possible end-stage renal failure"
      },
      {
        "symptomName": "Edema due to hypoalbuminemia",
        "frequency": 0.7,
        "bodySystem": "renal",
        "notes": "Secondary to nephrotic syndrome"
      },
      {
        "symptomName": "Hypertension",
        "frequency": 0.6,
        "bodySystem": "cardiovascular",
        "notes": "May develop as renal function declines"
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.65,
        "bodySystem": "constitutional",
        "notes": "Common nonspecific symptom"
      },
      {
        "symptomName": "Mild anemia",
        "frequency": 0.55,
        "bodySystem": "hematological",
        "notes": "Due to chronic kidney disease"
      }
    ],
    "occasional": [
      {
        "symptomName": "Orthostatic hypotension",
        "frequency": 0.3,
        "bodySystem": "cardiovascular",
        "notes": "Due to autonomic involvement in some cases"
      },
      {
        "symptomName": "Peripheral neuropathy",
        "frequency": 0.25,
        "bodySystem": "neurological",
        "notes": "Less common but reported in some mutations"
      },
      {
        "symptomName": "Gastrointestinal disturbances",
        "frequency": 0.2,
        "bodySystem": "gastrointestinal",
        "notes": "Including diarrhea or constipation"
      },
      {
        "symptomName": "Mild hepatomegaly",
        "frequency": 0.15,
        "bodySystem": "gastrointestinal",
        "notes": "Due to amyloid infiltration"
      },
      {
        "symptomName": "Carpal tunnel syndrome",
        "frequency": 0.1,
        "bodySystem": "neurological",
        "notes": "Occasionally reported"
      }
    ],
    "rare": [
      {
        "symptomName": "Cardiac amyloidosis",
        "frequency": 0.05,
        "bodySystem": "cardiovascular",
        "notes": "Rare in familial renal amyloidosis but possible"
      },
      {
        "symptomName": "Cutaneous purpura",
        "frequency": 0.07,
        "bodySystem": "dermatological",
        "notes": "Due to vascular fragility from amyloid deposits"
      },
      {
        "symptomName": "Ocular amyloid deposits",
        "frequency": 0.03,
        "bodySystem": "ophthalmological",
        "notes": "Rare manifestation"
      }
    ]
  },
  "systemsAffected": [
    "renal",
