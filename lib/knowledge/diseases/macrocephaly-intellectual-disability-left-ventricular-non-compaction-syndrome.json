    ],
    "imaging": [
      "Echocardiography showing prominent trabeculations and deep intertrabecular recesses consistent with LVNC",
      "Cardiac MRI confirming left ventricular non-compaction",
      "Brain MRI may show nonspecific white matter changes"
    ],
    "genetic": [
      "NONO (causative, loss-of-function)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Neuropsychological testing confirming intellectual disability",
      "Electrocardiogram abnormalities including arrhythmias"
    ]
  },
