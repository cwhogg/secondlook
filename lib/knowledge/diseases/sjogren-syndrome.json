  "keyFindings": {
    "laboratory": [
      "Anti-SSA/Ro antibodies (60-75%)",
      "Anti-SSB/La antibodies (30-40%)",
      "ANA positive (80%)",
      "Rheumatoid factor positive (60-70%)",
      "Hypergammaglobulinemia (polyclonal)",
      "Elevated ESR",
      "Cytopenias (leukopenia, anemia)",
      "Low complement levels (10-20%)",
      "Cryoglobulins (5-10%)"
    ],
    "imaging": [
      "Salivary gland ultrasound: inhomogeneous parenchyma with hypoechoic areas",
      "Sialography: punctate, globular, or cavitary sialectasis",
      "Parotid MRI: heterogeneous gland with multiple cystic lesions",
      "Chest HRCT: nonspecific interstitial pneumonia, lymphocytic interstitial pneumonia patterns"
    ],
    "genetic": [
      "HLA-DR3 (DRB1*0301) association",
      "HLA-B8 association",
      "IRF5, STAT4, BLK polymorphisms"
    ],
    "other": [
      "Minor salivary gland biopsy: focal lymphocytic sialadenitis with focus score >= 1",
      "Schirmer test: <= 5 mm/5 min",
      "Ocular staining with fluorescein/lissamine green",
      "Unstimulated whole salivary flow: <= 0.1 mL/min"
    ]
  },
