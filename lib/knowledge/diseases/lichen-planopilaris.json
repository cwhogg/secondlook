  "diagnosticCriteria": {
    "formalCriteriaName": "Lichen Planopilaris Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of perifollicular erythema and scaling at the scalp margins",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Lichenoid lymphocytic infiltrate targeting hair follicles with perifollicular fibrosis on scalp biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "trichoscopy",
        "description": "Trichoscopic findings of perifollicular scaling, absence of follicular openings, and perifollicular erythema",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-course",
        "description": "Progressive scarring alopecia with permanent hair loss",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation and histopathology criteria are required; supportive criteria aid diagnosis",
    "notes": "Diagnosis is confirmed by scalp biopsy demonstrating characteristic lichenoid inflammation and scarring"
  },
