  "diagnosticCriteria": {
    "formalCriteriaName": "Merkel Cell Carcinoma Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histopathologic identification of small round blue cells with neuroendocrine features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Positive staining for cytokeratin 20 in a perinuclear dot pattern",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Rapidly growing, painless, firm, red to violaceous nodule on sun-exposed skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mcpv-detection",
        "description": "Detection of Merkel cell polyomavirus DNA in tumor tissue (supportive)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic histopathology and immunohistochemistry findings combined with compatible clinical presentation",
    "notes": "Diagnosis requires biopsy with immunohistochemical confirmation; MCPyV detection supports diagnosis but is not mandatory."
  },
