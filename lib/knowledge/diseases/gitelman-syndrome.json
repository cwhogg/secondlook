      "Elevated plasma renin and aldosterone levels"
    ],
    "imaging": [
      "Chondrocalcinosis on joint X-rays in some patients"
    ],
    "genetic": [
      "Biallelic pathogenic variants in SLC12A3 gene"
    ],
