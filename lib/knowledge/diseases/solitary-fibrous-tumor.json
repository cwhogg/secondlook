  "keyFindings": {
    "laboratory": [
      "Hypoglycemia in cases with IGF-II secretion",
      "Normal routine blood tests"
    ],
    "imaging": [
      "Well-circumscribed soft tissue mass on MRI or CT",
      "Heterogeneous enhancement on contrast imaging",
      "Possible pleural-based mass on chest imaging"
    ],
    "genetic": [
      "STAT6 (fusion gene)",
      "NAB2 (fusion gene)"
    ],
    "other": [
      "Positive STAT6 nuclear immunohistochemical staining",
      "CD34 positivity on immunohistochemistry"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "fibrosarcoma",
      "distinguishingFeatures": [
        "More aggressive histology with high mitotic rate",
        "Lack of STAT6 nuclear positivity",
        "Absence of NAB2-STAT6 fusion"
      ]
    },
    {
      "diseaseId": "hemangiopericytoma",
      "distinguishingFeatures": [
        "Historically considered synonymous but now classified under SFT",
        "Similar morphology but variable immunohistochemical profile",
        "Requires molecular testing for definitive differentiation"
      ]
    },
    {
      "diseaseId": "desmoid-type fibromatosis",
      "distinguishingFeatures": [
        "Infiltrative growth pattern",
        "Beta-catenin nuclear positivity instead of STAT6",
        "No NAB2-STAT6 fusion"
      ]
    }
  ],
  "redFlags": [
