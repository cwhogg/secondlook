  "diagnosticCriteria": {
    "formalCriteriaName": "Barraquer-Simons Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "progressive-facial-lipoatrophy",
        "description": "Progressive loss of subcutaneous fat in the face and upper body",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "complement-dysregulation",
        "description": "Evidence of complement system abnormalities, especially low C3 levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-metabolic-syndrome",
        "description": "Lack of severe insulin resistance or metabolic syndrome features typical of other lipodystrophies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "onset-in-childhood-or-adolescence",
        "description": "Typical onset during childhood or adolescence",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-family-history",
        "description": "No family history of inherited lipodystrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive facial and upper body fat loss with complement dysregulation (low C3) is required",
    "notes": "Diagnosis is clinical supported by laboratory findings; genetic testing usually negative as it is an acquired condition"
  },
