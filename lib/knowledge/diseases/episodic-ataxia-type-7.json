  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Episodic Ataxia Type 7",
    "criteria": [
      {
        "id": "episodic-ataxia",
        "description": "Recurrent episodes of cerebellar ataxia lasting minutes to hours",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in the FGF14 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "interictal-nystagmus",
        "description": "Presence of interictal gaze-evoked nystagmus or other cerebellar signs",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent episodic ataxia plus either genetic confirmation of FGF14 mutation or typical clinical features with supportive family history",
    "notes": "Genetic testing is critical due to phenotypic overlap with other episodic ataxias."
  },
