  "diagnosticCriteria": {
    "formalCriteriaName": "Schimke Immuno-Osseous Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "spondyloepiphyseal-dysplasia",
        "description": "Radiographic evidence of spondyloepiphyseal dysplasia with short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "T-cell immunodeficiency with recurrent infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-dysfunction",
        "description": "Progressive renal failure due to focal segmental glomerulosclerosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including a broad nasal bridge and epicanthal folds",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in SMARCAL1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of spondyloepiphyseal dysplasia, immunodeficiency, renal dysfunction, and pathogenic variants in SMARCAL1",
    "notes": "Diagnosis is supported by clinical, radiological, immunological findings and confirmed by genetic testing."
  },
