  "diagnosticCriteria": {
    "formalCriteriaName": "Newborn Screening and Confirmatory Diagnostic Criteria for Congenital Hypothyroidism",
    "criteria": [
      {
        "id": "elevated-tsh",
        "description": "Elevated serum thyroid-stimulating hormone (TSH) levels above neonatal reference range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-thyroxine",
        "description": "Low free thyroxine (FT4) concentration in serum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-thyroid-gland-imaging",
        "description": "Normal thyroid gland morphology and location on ultrasound or scintigraphy (excluding dysgenesis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-autoantibodies",
        "description": "No evidence of thyroid autoantibodies indicating autoimmune thyroiditis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated TSH and low FT4 with normal thyroid gland imaging confirming idiopathic etiology",
    "notes": "Diagnosis is confirmed after excluding thyroid dysgenesis and transient hypothyroidism causes."
  },
