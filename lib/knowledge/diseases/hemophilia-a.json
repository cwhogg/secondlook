  "diagnosticCriteria": {
    "formalCriteriaName": "Hemophilia A Diagnostic Criteria",
    "criteria": [
      {
        "id": "factor-viii-activity",
        "description": "Reduced factor VIII clotting activity levels (<40%)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "prolonged-aptt",
        "description": "Prolonged activated partial thromboplastin time (aPTT) with normal prothrombin time (PT)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of hemophilia A or bleeding diathesis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the F8 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Reduced factor VIII activity with prolonged aPTT and/or identification of pathogenic F8 gene mutation",
    "notes": "Diagnosis is confirmed by coagulation factor assays and genetic testing; family history supports but is not mandatory."
  },
