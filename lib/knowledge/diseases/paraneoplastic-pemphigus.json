  "diagnosticCriteria": {
    "formalCriteriaName": "Camisa and Helm criteria",
    "criteria": [
      {
        "id": "mucocutaneous-lesions",
        "description": "Severe mucositis with polymorphous skin eruptions including blisters and erosions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "underlying-neoplasm",
        "description": "Presence of an underlying neoplasm, commonly lymphoproliferative disorders",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoantibodies",
        "description": "Detection of circulating autoantibodies against plakin family proteins by immunoprecipitation or immunoblotting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological evidence of acantholysis and interface dermatitis on skin biopsy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "direct-immunofluorescence",
        "description": "Intercellular and basement membrane zone deposition of IgG and complement on direct immunofluorescence",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe mucocutaneous lesions, underlying neoplasm, and circulating autoantibodies against plakin proteins",
    "notes": "Diagnosis requires integration of clinical, histopathological, and immunological findings."
  },
