  "keyFindings": {
    "laboratory": [
      "Low acid alpha-glucosidase enzyme activity in blood or fibroblasts",
      "Elevated serum creatine kinase",
      "Elevated transaminases in some cases"
    ],
    "imaging": [
      "Echocardiogram showing hypertrophic cardiomyopathy",
      "Chest X-ray with cardiomegaly",
      "Muscle MRI showing increased glycogen deposition"
    ],
    "genetic": [
      "GAA (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy demonstrating lysosomal glycogen accumulation with PAS-positive vacuoles"
    ]
  },
  "differentialDiagnoses": [
