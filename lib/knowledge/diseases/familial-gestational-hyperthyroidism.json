  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnosis of Familial Gestational Hyperthyroidism",
    "criteria": [
      {
        "id": "clinical-hyperthyroidism",
        "description": "Clinical signs and symptoms of hyperthyroidism during pregnancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thyroid-function-tests",
        "description": "Biochemical evidence of suppressed TSH with elevated free T4 and/or free T3 during gestation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of gestational hyperthyroidism or activating TSH receptor mutations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of activating mutations in the TSH receptor gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-gtp",
        "description": "Exclusion of gestational transient thyrotoxicosis due to hCG elevation alone",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical hyperthyroidism during pregnancy with biochemical confirmation plus positive family history or genetic confirmation",
    "notes": "Genetic testing is confirmatory but not always available; diagnosis relies heavily on clinical and biochemical findings combined with family history."
  },
