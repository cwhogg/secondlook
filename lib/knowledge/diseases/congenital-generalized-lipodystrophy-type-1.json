  "keyFindings": {
    "laboratory": [
      "Severe hyperinsulinemia with insulin resistance",
      "Marked hypertriglyceridemia",
      "Elevated liver enzymes",
      "Low serum leptin levels"
    ],
    "imaging": [
      "Hepatomegaly with fatty infiltration on abdominal ultrasound or MRI",
      "Cardiac echocardiography showing cardiomyopathy in some cases"
    ],
    "genetic": [
      "TWIST2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Muscular hypertrophy with absence of fat on physical examination"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-generalized-lipodystrophy-type-2",
      "distinguishingFeatures": [
        "Mutation in BSCL2 gene instead of AGPAT2",
        "More severe neurological involvement",
        "Presence of intellectual disability"
      ]
    },
    {
      "diseaseId": "familial-partial-lipodystrophy",
      "distinguishingFeatures": [
        "Partial rather than generalized loss of adipose tissue",
        "Later onset in adolescence or adulthood",
        "Dominant inheritance pattern"
      ]
    }
  ],
