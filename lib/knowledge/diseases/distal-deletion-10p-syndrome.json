  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Distal 10p Deletion",
    "criteria": [
      {
        "id": "chromosomal-deletion",
        "description": "Presence of terminal or interstitial deletion involving the distal short arm of chromosome 10 (10p)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including microcephaly, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital heart defects such as septal defects or valve anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed distal 10p chromosomal deletion by cytogenetic or molecular analysis plus presence of characteristic craniofacial features and developmental delay",
    "notes": "Diagnosis relies heavily on genetic testing; phenotypic variability is common."
  },
