  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for OPD1",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism, broad nasal bridge, and cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Radiographic evidence of broad and hypoplastic clavicles, short tubular bones, and digital anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-impairment",
        "description": "Conductive or mixed hearing loss documented by audiometry",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the FLNA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "X-linked inheritance pattern or affected male relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic facial dysmorphism and skeletal abnormalities plus either genetic confirmation or consistent family history",
    "notes": "Diagnosis is primarily clinical supported by radiological and genetic findings."
  },
