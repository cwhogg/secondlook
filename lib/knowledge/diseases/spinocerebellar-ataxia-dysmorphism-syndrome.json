  "diagnosticCriteria": {
    "formalCriteriaName": "Spinocerebellar Ataxia-Dysmorphism Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cerebellar-ataxia",
        "description": "Progressive cerebellar ataxia evidenced by gait disturbance and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including micrognathia and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging-cerebellar-atrophy",
        "description": "MRI evidence of cerebellar atrophy predominantly affecting the vermis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with spinocerebellar ataxia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia, characteristic craniofacial dysmorphism, and MRI-confirmed cerebellar atrophy",
    "notes": "Genetic testing can support diagnosis but is not mandatory if clinical and imaging criteria are met."
  },
