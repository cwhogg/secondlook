  "diagnosticCriteria": {
    "formalCriteriaName": "Florid Cemento-Osseous Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "multifocal-radiopaque-lesions",
        "description": "Presence of multiple radiopaque lesions involving two or more quadrants of the jaws",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "asymptomatic-presentation",
        "description": "Typically asymptomatic presentation without signs of infection or systemic illness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathologic-confirmation",
        "description": "Histopathologic evidence of cemento-osseous tissue replacing normal bone",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-systemic-disease",
        "description": "No evidence of systemic metabolic bone disease or malignancy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multifocal radiopaque lesions in multiple jaw quadrants with typical asymptomatic clinical presentation, supported by imaging and exclusion of systemic bone diseases.",
    "notes": "Histopathology is supportive but not always required if clinical and radiographic features are characteristic."
  },
