        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic heterozygous variants in the BICD2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern or positive family history of similar neuromuscular symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing neurogenic atrophy (if performed)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of childhood-onset proximal muscle weakness with electrophysiological evidence of motor neuron disease and pathogenic BICD2 mutation",
    "notes": "Genetic testing is essential for definitive diagnosis; muscle biopsy is supportive but not mandatory."
  },
