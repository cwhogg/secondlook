  "diagnosticCriteria": {
    "formalCriteriaName": "Desmosterolosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-desmosterol",
        "description": "Elevated plasma and tissue desmosterol levels detected by biochemical analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cholesterol-biosynthesis-defect",
        "description": "Identification of biallelic pathogenic variants in the DHCR24 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic congenital anomalies including craniofacial dysmorphism and multiple congenital malformations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging-findings",
        "description": "Brain MRI showing hypomyelination or structural brain abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated desmosterol levels and biallelic pathogenic DHCR24 variants along with characteristic clinical features",
    "notes": "Diagnosis is confirmed by biochemical and molecular genetic testing; clinical presentation may vary."
  },
