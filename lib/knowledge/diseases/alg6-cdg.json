  "diagnosticCriteria": {
    "formalCriteriaName": "ALG6-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypoglycosylation",
        "description": "Demonstration of hypoglycosylation of serum transferrin by isoelectric focusing or mass spectrometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alg6-gene-mutation",
        "description": "Identification of pathogenic biallelic mutations in the ALG6 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of multisystem clinical features including neurological impairment and failure to thrive",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-lab",
        "description": "Abnormal glycan profiles on serum N-glycan analysis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Hypoglycosylation of serum transferrin plus identification of pathogenic biallelic ALG6 mutations with compatible clinical features",
    "notes": "Diagnosis requires integration of biochemical, genetic, and clinical data."
  },
