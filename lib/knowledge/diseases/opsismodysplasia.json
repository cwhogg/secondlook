  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild hypocalcemia"
    ],
    "imaging": [
      "Delayed ossification of carpal and tarsal bones",
      "Metaphyseal flaring and irregularity",
      "Shortened long bones with delayed epiphyseal development",
      "Narrow thorax with short ribs"
    ],
    "genetic": [
      "INPPL1 (causative)",
      "Mutations in INPPL1 gene associated with autosomal recessive inheritance"
    ],
    "other": [
      "Prenatal ultrasound may show micromelia and small thorax",
      "Histopathology shows disorganized growth plate cartilage"
    ]
  },
