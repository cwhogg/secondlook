  "keyFindings": {
    "laboratory": [
      "Hypoproteinemia and hypoalbuminemia",
      "Lymphopenia",
      "Elevated fecal alpha-1 antitrypsin indicating protein loss"
    ],
    "imaging": [
      "Lymphoscintigraphy showing lymphatic dysplasia",
      "Ultrasound or MRI demonstrating intestinal lymphangiectasia",
      "Brain MRI may show nonspecific findings related to developmental delay"
    ],
    "genetic": [
      "Pathogenic variants in CCBE1 gene (Hennekam syndrome type 1)",
      "Pathogenic variants in FAT4 gene (Hennekam syndrome type 2)"
    ],
