  "keyFindings": {
    "laboratory": [
      "Markedly reduced or absent erythrocyte GALT enzyme activity",
      "Elevated galactose-1-phosphate in erythrocytes",
      "Elevated blood galactose and galactitol levels",
      "Positive reducing substances in urine"
    ],
    "imaging": [
      "Lens opacities on slit-lamp examination (cataracts)",
      "Brain MRI may show nonspecific white matter changes in some cases"
    ],
    "genetic": [
      "GALT (causative)",
      "Autosomal recessive inheritance pattern"
    ],
    "other": [
      "Newborn screening positive for galactosemia",
      "Clinical response to galactose-restricted diet"
    ]
  },
