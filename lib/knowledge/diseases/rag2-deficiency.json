  "diagnosticCriteria": {
    "formalCriteriaName": "ESID Diagnostic Criteria for SCID",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the RAG2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphocyte-phenotype",
        "description": "Severe lymphopenia with absent or markedly reduced T and B cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "functional-assay",
        "description": "Impaired V(D)J recombination activity demonstrated by functional assays",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-presentation",
        "description": "Early onset of severe infections, failure to thrive, and absence of thymic shadow",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic RAG2 mutations plus severe T and B cell lymphopenia",
    "notes": "Functional assays and clinical presentation support diagnosis but are not mandatory if genetic confirmation is present."
  },
