  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for CMTX5",
    "criteria": [
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss onset in childhood or adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "optic-atrophy",
        "description": "Progressive optic nerve atrophy confirmed by ophthalmological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peripheral-neuropathy",
        "description": "Distal muscle weakness and atrophy with sensory loss consistent with peripheral neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gjb1-mutation",
        "description": "Pathogenic mutation in the GJB1 gene (connexin 32)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies showing intermediate slowing of motor and sensory conduction velocities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral sensorineural hearing loss, optic atrophy, peripheral neuropathy, and identification of a pathogenic GJB1 mutation",
    "notes": "Diagnosis is confirmed by genetic testing; clinical features may vary in severity."
  },
