  "diagnosticCriteria": {
    "formalCriteriaName": "Potocki-Lupski Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of a microduplication at chromosome 17p11.2 detected by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "speech-language-impairment",
        "description": "Significant speech and language delay or impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-anomalies",
        "description": "Congenital heart defects such as structural cardiac anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-features",
        "description": "Autistic features or attention deficit hyperactivity disorder (ADHD)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 17p11.2 microduplication plus presence of developmental delay and speech-language impairment",
    "notes": "Diagnosis is confirmed primarily by genetic testing; clinical features support diagnosis and guide management."
  },
