  "differentialDiagnoses": [
    {
      "diseaseId": "charcot-marie-tooth-disease-type-1a",
      "distinguishingFeatures": [
        "Progressive distal muscle weakness and atrophy without recurrent focal palsies",
        "Diffuse demyelinating neuropathy rather than focal conduction block",
        "PMP22 gene duplication rather than deletion"
      ]
    },
    {
      "diseaseId": "chronic-inflammatory-demyelinating-polyneuropathy",
      "distinguishingFeatures": [
        "Progressive or relapsing symmetric polyneuropathy",
        "Elevated CSF protein without pleocytosis",
        "Response to immunotherapy"
      ]
    }
  ],
  "redFlags": [
