  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Rubinstein-Taybi Syndrome",
    "criteria": [
      {
        "id": "broad-thumbs-hallux",
        "description": "Presence of broad and angulated thumbs and halluces",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial features including downslanting palpebral fissures, beaked nose, and grimacing smile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic variant in CREBBP or EP300 genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-delay",
        "description": "Postnatal growth retardation or short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of broad thumbs/halluces, distinctive facial features, and intellectual disability; genetic confirmation supports diagnosis",
    "notes": "Genetic testing for CREBBP or EP300 mutations is confirmatory but not always required if clinical features are definitive"
  },
