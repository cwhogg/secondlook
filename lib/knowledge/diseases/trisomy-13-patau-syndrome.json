  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Trisomy 13",
    "criteria": [
      {
        "id": "chromosomal-abnormality",
        "description": "Presence of an extra full or partial copy of chromosome 13 confirmed by karyotype or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midline-facial-defects",
        "description": "Presence of midline facial anomalies such as cleft lip and/or cleft palate",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "polydactyly",
        "description": "Postaxial polydactyly (extra fingers or toes)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-heart-defects",
        "description": "Structural congenital heart defects such as ventricular septal defect or atrial septal defect",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "holoprosencephaly",
        "description": "Brain malformation characterized by incomplete separation of the cerebral hemispheres",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed trisomy 13 by cytogenetic testing or presence of multiple major clinical features consistent with trisomy 13",
    "notes": "Diagnosis is primarily confirmed by chromosomal analysis; clinical features support diagnosis especially in prenatal or neonatal period."
  },
