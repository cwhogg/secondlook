  "diagnosticCriteria": {
    "formalCriteriaName": "Rothmund-Thomson Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "poikiloderma",
        "description": "Early-onset poikiloderma with telangiectasia and pigmentary changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bony-abnormalities",
        "description": "Radial ray defects or other skeletal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recql4-mutation",
        "description": "Pathogenic biallelic mutations in the RECQL4 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "juvenile-cataracts",
        "description": "Presence of juvenile cataracts",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset poikiloderma, skeletal abnormalities, and confirmed RECQL4 biallelic pathogenic mutations",
    "notes": "Genetic testing is essential to confirm diagnosis and differentiate from other poikiloderma syndromes."
  },
