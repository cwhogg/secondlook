  "keyFindings": {
    "laboratory": [
      "Elevated serum lactate and pyruvate levels",
      "Mitochondrial DNA mutation analysis showing POLG or related gene mutations"
    ],
    "imaging": [
      "Brain MRI may show cerebellar atrophy",
      "Muscle biopsy demonstrating ragged-red fibers"
    ],
    "genetic": [
      "POLG (causative)",
      "TWNK (candidate)",
      "Mutations in POLG gene or other mitochondrial DNA maintenance genes",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography showing sensory neuropathy",
      "Nerve conduction studies indicating axonal sensory neuropathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "mitochondrial-neurogastrointestinal-encephalopathy",
      "distinguishingFeatures": [
        "Prominent gastrointestinal dysmotility",
        "Leukoencephalopathy on MRI",
        "Different genetic mutations (TYMP gene)"
      ]
    },
    {
      "diseaseId": "chronic-progressive-external-ophthalmoplegia",
      "distinguishingFeatures": [
        "Primarily ophthalmoplegia without prominent sensory ataxia",
        "Less frequent dysarthria",
        "Different mitochondrial DNA deletions"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of ophthalmoplegia with respiratory failure",
