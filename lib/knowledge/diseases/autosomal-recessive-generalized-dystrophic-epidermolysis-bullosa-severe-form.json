  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Dystrophic Epidermolysis Bullosa",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Generalized blistering and erosions present at or shortly after birth with scarring and milia formation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing sublamina densa cleavage with scarring and fibrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the COL7A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Reduced or absent type VII collagen staining at the dermal-epidermal junction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized blistering with scarring plus either histopathological confirmation or genetic confirmation of COL7A1 mutations",
    "notes": "Diagnosis is confirmed by genetic testing; immunofluorescence mapping and clinical features support diagnosis."
  },
