  "keyFindings": {
    "laboratory": [
      "Hypokalemia with increased urinary potassium excretion",
      "Metabolic alkalosis",
      "Elevated plasma renin and aldosterone levels",
      "Hypercalciuria",
      "Normal or low blood pressure"
    ],
    "imaging": [
      "Renal ultrasound showing nephrocalcinosis or nephrolithiasis"
    ],
    "genetic": [
      "Biallelic pathogenic variants in KCNJ1 (ROMK) gene"
    ],
    "other": [
      "Normal to low blood pressure despite elevated renin-angiotensin-aldosterone system activity"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "bartter-syndrome-type-1",
      "distinguishingFeatures": [
        "Mutations in SLC12A1 gene",
        "More severe antenatal presentation",
        "Similar electrolyte abnormalities but different genetic cause"
      ]
    },
    {
      "diseaseId": "gitelman-syndrome",
      "distinguishingFeatures": [
        "Hypokalemia with hypomagnesemia",
        "Hypocalciuria instead of hypercalciuria",
        "Mutations in SLC12A3 gene"
      ]
    },
    {
      "diseaseId": "pseudo-bartter-syndrome",
      "distinguishingFeatures": [
        "Secondary causes such as cystic fibrosis or diuretic abuse",
        "No genetic mutations in ROMK or related genes",
        "Clinical context and history differentiate"
      ]
    }
  ],
  "redFlags": [
    "Severe hypokalemia causing cardiac arrhythmias",
    "Failure to thrive or severe growth retardation in infancy",
    "Recurrent dehydration episodes with electrolyte imbalance"
  ],
