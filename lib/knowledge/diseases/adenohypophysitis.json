  "differentialDiagnoses": [
    {
      "diseaseId": "pituitary-adenoma",
      "distinguishingFeatures": [
        "Usually presents with focal mass effect without inflammatory signs",
        "MRI shows heterogeneous enhancement and possible cystic changes",
        "Lack of lymphocytic infiltration on biopsy"
      ]
    },
    {
      "diseaseId": "hypophysitis-secondary",
      "distinguishingFeatures": [
        "Associated with systemic autoimmune diseases or immunotherapy",
        "May involve both anterior and posterior pituitary",
        "Clinical history of triggering factors"
      ]
    },
    {
      "diseaseId": "pituitary-metastasis",
      "distinguishingFeatures": [
        "History of known malignancy",
        "Rapid progression and heterogeneous MRI features",
        "Biopsy shows metastatic tumor cells"
      ]
    }
  ],
