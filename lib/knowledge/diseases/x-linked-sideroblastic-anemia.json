        "description": "Identification of pathogenic mutation in the ALAS2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microcytic-hypochromic-anemia",
        "description": "Microcytic, hypochromic anemia with ineffective erythropoiesis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "iron-overload",
        "description": "Evidence of systemic iron overload without transfusion history",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history consistent with X-linked inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of ringed sideroblasts in bone marrow, pathogenic ALAS2 mutation, and characteristic microcytic hypochromic anemia",
