        "requiredForDiagnosis": true
      },
      {
        "id": "renal-anomalies",
        "description": "Congenital renal abnormalities such as renal hypoplasia, dysplasia, or agenesis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "Ocular defects including microphthalmia, coloboma, or cataracts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: limb malformations, renal anomalies, and ocular anomalies",
    "notes": "Diagnosis is clinical; genetic testing may assist but no specific gene identified"
