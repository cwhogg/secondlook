  "diagnosticCriteria": {
    "formalCriteriaName": "RIN2 Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cutaneous-anomalies",
        "description": "Congenital cutis laxa with loose, redundant skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic facial features including a broad nasal bridge, anteverted nares, and prominent forehead",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiovascular-anomalies",
        "description": "Presence of congenital heart defects such as pulmonary artery stenosis or valve abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the RIN2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of congenital cutis laxa and characteristic craniofacial features plus genetic confirmation of biallelic RIN2 mutations",
    "notes": "Diagnosis is supported by clinical features and confirmed by molecular genetic testing."
  },
