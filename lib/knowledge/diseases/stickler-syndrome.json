  "diagnosticCriteria": {
    "formalCriteriaName": "No universally accepted formal criteria; diagnosis based on clinical features and molecular confirmation",
    "criteria": [
      {
        "id": "stl-c1",
        "description": "Vitreoretinal degeneration (membranous or beaded vitreous) or retinal detachment",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "stl-c2",
        "description": "High myopia (typically > -3 diopters, often congenital)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "stl-c3",
        "description": "Orofacial features: midface hypoplasia, cleft palate, micrognathia, Robin sequence",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "stl-c4",
        "description": "Sensorineural or mixed hearing loss",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "stl-c5",
        "description": "Joint hypermobility and/or early-onset degenerative arthropathy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "stl-m1",
        "description": "Spondyloepiphyseal abnormalities on skeletal survey",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "stl-m2",
        "description": "Cataracts (cortical or nuclear)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "stl-m3",
        "description": "Mitral valve prolapse",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "stl-m4",
        "description": "Flat facial profile (midface retrusion)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Diagnosis suspected when ocular, skeletal, orofacial, and auditory features co-occur. Molecular confirmation by COL2A1, COL11A1, COL11A2, or COL9A1/COL9A2/COL9A3 mutation testing.",
    "notes": "Type 1 (COL2A1) is most common. Type 2 (COL11A1) has beaded vitreous. Type 3 (COL11A2) is non-ocular (no vitreous abnormalities). Recessive forms exist (Types 4-6, COL9A genes)."
  },
