  "diagnosticCriteria": {
    "formalCriteriaName": "DOCK8 Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-ige",
        "description": "Serum IgE levels markedly elevated, typically >2000 IU/mL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eczema",
        "description": "Severe atopic dermatitis or eczema present from infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-viral-infections",
        "description": "Recurrent cutaneous viral infections including molluscum contagiosum and herpes simplex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphopenia",
        "description": "Lymphopenia affecting T and B cells",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in DOCK8 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eosinophilia",
        "description": "Peripheral blood eosinophilia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated IgE, eczema, recurrent viral infections, and biallelic DOCK8 mutations",
    "notes": "Diagnosis is confirmed by genetic testing; clinical features support suspicion."
  },
