  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Distal Renal Tubular Acidosis",
    "criteria": [
      {
        "id": "non-anion-gap-metabolic-acidosis",
        "description": "Presence of hyperchloremic non-anion gap metabolic acidosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-urinary-acidification",
        "description": "Inability to acidify urine to pH <5.5 despite systemic acidemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypokalemia",
        "description": "Serum hypokalemia often present but variable",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nephrocalcinosis-or-nephrolithiasis",
        "description": "Evidence of nephrocalcinosis or nephrolithiasis on imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hyperchloremic non-anion gap metabolic acidosis with impaired urinary acidification (urine pH >5.5) in the absence of other causes",
    "notes": "Diagnosis requires exclusion of proximal RTA and other causes of metabolic acidosis."
  },
