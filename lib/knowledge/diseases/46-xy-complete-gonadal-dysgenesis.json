  "diagnosticCriteria": {
    "formalCriteriaName": "Swyer Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "gonadal-absence",
        "description": "Presence of bilateral streak gonads without functional testicular tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "46xy-karyotype",
        "description": "46,XY karyotype confirmed by cytogenetic analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "female-phenotype",
        "description": "Phenotypic female external genitalia with normal Müllerian structures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypergonadotropic-hypogonadism",
        "description": "Elevated gonadotropins (LH and FSH) with low sex steroid levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-secondary-sex-characteristics",
        "description": "Lack of spontaneous pubertal development and secondary sexual characteristics",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of 46,XY karyotype, bilateral streak gonads, and female phenotype with absence of functional testicular tissue",
    "notes": "Genetic testing for mutations in SRY or other sex-determining genes may support diagnosis."
  },
