  "diagnosticCriteria": {
    "formalCriteriaName": "Preus Diagnostic Criteria for Oculocerebral Hypopigmentation Syndrome",
    "criteria": [
      {
        "id": "ocular-hypopigmentation",
        "description": "Congenital ocular hypopigmentation including iris translucency and retinal pigmentary abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-impairment",
        "description": "Developmental delay or intellectual disability with associated cerebral hypopigmentation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-hypopigmentation",
        "description": "Diffuse or patchy skin hypopigmentation without systemic inflammation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including microcephaly and prominent nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-immune-deficiency",
        "description": "No evidence of immunodeficiency or hematological abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: ocular hypopigmentation, neurological impairment, and cutaneous hypopigmentation",
    "notes": "Diagnosis is clinical and supported by exclusion of other hypopigmentation syndromes"
  },
