        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electromyography showing characteristic incremental response to repetitive nerve stimulation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acute bilateral cranial neuropathies with descending paralysis plus either confirmed toxin detection or documented exposure history",
    "notes": "Early diagnosis is critical due to rapid progression and respiratory failure risk."
