  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Familial Hypokalemic Periodic Paralysis with Cardiac Arrhythmia",
    "criteria": [
      {
        "id": "episodic-muscle-weakness",
        "description": "Recurrent episodes of muscle weakness or paralysis associated with low serum potassium levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "documented-hypokalemia",
        "description": "Serum potassium concentration below 3.5 mmol/L during attacks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-arrhythmia-evidence",
        "description": "Electrocardiographic evidence of cardiac arrhythmias such as ventricular tachycardia or atrioventricular block",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of similar episodes or confirmed genetic mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in CACNA1S or SCN4A genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent hypokalemic paralysis episodes with documented hypokalemia and cardiac arrhythmia evidence",
    "notes": "Genetic testing supports diagnosis but is not mandatory"
  },
