  "diagnosticCriteria": {
    "formalCriteriaName": "MYH9-related disease diagnostic criteria",
    "criteria": [
      {
        "id": "thrombocytopenia",
        "description": "Persistent thrombocytopenia with platelet counts typically between 10-100 x10^9/L",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "giant-platelets",
        "description": "Presence of giant platelets on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dohle-like-inclusions",
        "description": "Döhle-like cytoplasmic inclusions in neutrophils detected by light microscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "MYH9-mutation",
        "description": "Identification of pathogenic MYH9 gene mutation by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-impairment",
        "description": "Evidence of progressive nephropathy or proteinuria",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cataracts",
        "description": "Early-onset cataracts",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of thrombocytopenia with giant platelets and Döhle-like inclusions in neutrophils plus identification of a pathogenic MYH9 mutation",
    "notes": "Diagnosis is supported by clinical features and confirmed by genetic testing; renal, auditory, and ocular manifestations may develop later."
  },
