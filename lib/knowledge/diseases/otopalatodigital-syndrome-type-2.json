  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Otopalatodigital Syndrome Type 2",
    "criteria": [
      {
        "id": "skeletal-dysplasia",
        "description": "Severe skeletal dysplasia including short stature, bowed long bones, and broad ribs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-features",
        "description": "Characteristic craniofacial abnormalities such as hypertelorism, cleft palate, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-loss",
        "description": "Conductive or mixed hearing loss due to otic capsule malformations",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the FLNA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Presence of digital anomalies including syndactyly and broad thumbs",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic skeletal dysplasia and craniofacial features plus genetic confirmation of FLNA mutation",
    "notes": "Diagnosis is primarily clinical but confirmed by molecular genetic testing."
  },
