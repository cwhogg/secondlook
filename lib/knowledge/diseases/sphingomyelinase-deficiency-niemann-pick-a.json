  "diagnosticCriteria": {
    "formalCriteriaName": "Niemann-Pick Disease Type A Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of deficient acid sphingomyelinase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive neurodegeneration with psychomotor regression in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepatosplenomegaly",
        "description": "Presence of hepatosplenomegaly on physical examination or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in SMPD1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "bone-marrow",
        "description": "Presence of foam cells (Niemann-Pick cells) in bone marrow aspirate",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient acid sphingomyelinase enzyme activity plus clinical presentation of neurodegeneration and hepatosplenomegaly",
    "notes": "Genetic testing is confirmatory but not always required if enzyme assay and clinical features are definitive."
  },
