  "diagnosticCriteria": {
    "formalCriteriaName": "Cap Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Muscle biopsy showing characteristic cap structures on electron microscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness with early childhood or adult onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with cap myopathy (e.g., TPM2, TPM3)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "Myopathic changes on electromyography supportive of diagnosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic muscle biopsy findings plus clinical presentation; genetic confirmation supportive but not mandatory",
    "notes": "Genetic heterogeneity exists; biopsy remains gold standard for diagnosis"
  },
