  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Congenital Myopathy with Myasthenic-like Onset",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early-onset muscle weakness with fatigability and myasthenic-like symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing congenital myopathy features such as fiber size variability, type 1 fiber predominance, and absence of dystrophic changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electromyography demonstrating decremental response on repetitive nerve stimulation mimicking myasthenic syndrome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with congenital myopathy and neuromuscular junction dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-treatment",
        "description": "Partial or no response to acetylcholinesterase inhibitors differentiating from classic congenital myasthenic syndromes",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (clinical presentation, muscle biopsy, electrophysiology) with supportive genetic testing if available",
    "notes": "Differentiation from congenital myasthenic syndromes is critical due to overlapping clinical features."
  },
