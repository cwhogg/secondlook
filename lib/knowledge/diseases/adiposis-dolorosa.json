  "keyFindings": {
    "laboratory": [
      "No specific laboratory abnormalities; routine labs typically normal"
    ],
    "imaging": [
      "Ultrasound or MRI may reveal multiple lipomas in subcutaneous tissue"
    ],
    "genetic": [
      "No confirmed genetic markers; familial cases reported but inheritance pattern unclear",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology of lipomas shows mature adipose tissue with fibrosis and occasional inflammatory infiltrates"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "lipedema",
      "distinguishingFeatures": [
        "Symmetrical lower limb fat deposition without painful lipomas",
        "Predominantly affects women",
        "Pain less localized to discrete nodules"
      ]
    },
    {
      "diseaseId": "fibromyalgia",
      "distinguishingFeatures": [
        "Widespread musculoskeletal pain without lipomas",
        "Tender points rather than fatty nodules",
        "Associated fatigue and cognitive symptoms"
      ]
    },
    {
      "diseaseId": "multiple familial lipomatosis",
      "distinguishingFeatures": [
        "Multiple lipomas without associated pain",
        "Usually hereditary",
        "No systemic symptoms"
      ]
    }
  ],
  "redFlags": [
    "Rapidly enlarging lipomas",
    "Neurological deficits such as numbness or weakness",
    "Systemic symptoms suggestive of malignancy (e.g., weight loss, night sweats)"
  ],
