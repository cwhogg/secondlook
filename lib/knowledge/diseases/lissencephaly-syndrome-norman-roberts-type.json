  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild metabolic abnormalities secondary to feeding difficulties"
    ],
    "imaging": [
      "MRI showing agyria or pachygyria with smooth cerebral cortex",
      "MRI evidence of cerebellar hypoplasia",
      "Microcephaly confirmed by head circumference measurement"
    ],
    "genetic": [
      "NDE1 (causative)",
      "KATNB1 (causative)",
      "RELN (causative)",
      "Autosomal recessive inheritance"
    ],
