  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and molecular diagnostic criteria for Kagami-Ogata syndrome",
    "criteria": [
      {
        "id": "polyhydramnios",
        "description": "Prenatal polyhydramnios detected by ultrasound",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including full cheeks, protruding philtrum, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thoracic-abnormalities",
        "description": "Small bell-shaped thorax with coat-hanger ribs on radiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Detection of maternal 14q32.2 microdeletion involving imprinted region by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features (polyhydramnios, facial dysmorphism, thoracic abnormalities) plus molecular confirmation of maternal 14q32.2 microdeletion",
    "notes": "Molecular testing is essential for definitive diagnosis due to overlap with other imprinting disorders."
  },
