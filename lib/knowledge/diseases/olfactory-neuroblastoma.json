  "diagnosticCriteria": {
    "formalCriteriaName": "Hyams Histopathologic Grading System",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of small round blue cells with neurofibrillary background on histopathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Positive staining for neuronal markers such as synaptophysin, chromogranin, and NSE",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "MRI or CT showing a mass centered in the superior nasal cavity/olfactory cleft with possible extension into anterior cranial fossa",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Symptoms consistent with nasal obstruction or epistaxis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathologic confirmation with positive immunohistochemical staining and imaging consistent with tumor location",
    "notes": "Hyams grading correlates with prognosis but is not diagnostic"
  },
