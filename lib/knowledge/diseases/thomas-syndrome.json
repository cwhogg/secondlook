    "formalCriteriaName": "Thomas Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial abnormalities including midface hypoplasia and micrognathia",
