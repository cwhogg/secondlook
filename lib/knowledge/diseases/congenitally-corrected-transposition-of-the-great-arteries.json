        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "associated-cardiac-anomalies",
        "description": "Identification of associated defects such as ventricular septal defect, pulmonary stenosis, or tricuspid valve abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Demonstration of atrioventricular and ventriculoarterial discordance with morphological right ventricle supporting systemic circulation on imaging",
    "notes": "Diagnosis is primarily based on imaging modalities including echocardiography and cardiac MRI."
