  "diagnosticCriteria": {
    "formalCriteriaName": "Congenital Hypothyroidism Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-tsh",
        "description": "Elevated serum thyroid-stimulating hormone (TSH) levels in neonatal screening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-thyroid-hormones",
        "description": "Low serum free thyroxine (FT4) and triiodothyronine (T3) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-thyroid-gland-imaging",
        "description": "Normal or enlarged thyroid gland on ultrasound or radionuclide scan indicating dyshormonogenesis rather than agenesis or ectopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes encoding thyroid hormone synthesis enzymes (e.g., TPO, TG, DUOX2)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical features consistent with hypothyroidism in neonate or infant",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated TSH with low thyroid hormones plus normal thyroid gland imaging consistent with dyshormonogenesis",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory for clinical diagnosis."
  },
