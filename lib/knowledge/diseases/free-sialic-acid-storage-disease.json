  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Free Sialic Acid Storage Disease",
    "criteria": [
      {
        "id": "urinary-sialic-acid",
        "description": "Elevated free sialic acid levels in urine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the SLC17A5 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Progressive psychomotor retardation and hypotonia presenting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-mri",
        "description": "Characteristic hypomyelination and cerebral atrophy on brain MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "enzyme-assay",
        "description": "Reduced sialin transporter activity in fibroblasts (if available)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated urinary free sialic acid, pathogenic SLC17A5 mutations, and compatible clinical features",
    "notes": "Diagnosis is confirmed by biochemical and molecular genetic testing; brain imaging supports but is not diagnostic alone."
  },
