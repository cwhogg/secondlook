  "diagnosticCriteria": {
    "formalCriteriaName": "VACTERL Association Diagnostic Criteria with Hydrocephalus",
    "criteria": [
      {
        "id": "vertebral-anomalies",
        "description": "Presence of vertebral anomalies such as hemivertebrae or fused vertebrae",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "anal-atresia",
        "description": "Imperforate anus or other anorectal malformations",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-defects",
        "description": "Congenital heart defects including ventricular septal defect or tetralogy of Fallot",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tracheoesophageal-fistula",
        "description": "Tracheoesophageal fistula or esophageal atresia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-anomalies",
        "description": "Renal structural anomalies such as renal agenesis or dysplasia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "limb-defects",
        "description": "Radial ray defects or other limb abnormalities",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hydrocephalus",
        "description": "Presence of hydrocephalus confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of at least three of the VACTERL component anomalies plus confirmed hydrocephalus",
    "notes": "Diagnosis is clinical and requires exclusion of other syndromes with overlapping features."
  },
