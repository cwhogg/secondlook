  "diagnosticCriteria": {
    "formalCriteriaName": "Radiological and Clinical Diagnostic Criteria for Osteopoikilosis",
    "criteria": [
      {
        "id": "radiological-pattern",
        "description": "Presence of multiple, symmetric, well-defined sclerotic bone lesions predominantly in epiphyseal and metaphyseal regions on X-ray",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-asymptomatic",
        "description": "Asymptomatic presentation or mild musculoskeletal discomfort without systemic symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-sclerosing",
        "description": "Exclusion of other sclerosing bone dysplasias and metastatic bone disease by clinical and imaging evaluation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of osteopoikilosis or autosomal dominant inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic radiological findings plus clinical asymptomatic or mild symptoms and exclusion of other sclerosing bone disorders",
    "notes": "Genetic testing for LEMD3 mutations may support diagnosis but is not mandatory."
  },
