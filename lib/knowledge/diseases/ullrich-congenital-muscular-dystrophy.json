  "diagnosticCriteria": {
    "formalCriteriaName": "Ullrich CMD Diagnostic Criteria",
    "criteria": [
      {
        "id": "muscle-weakness",
        "description": "Congenital onset of proximal muscle weakness and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-contractures",
        "description": "Presence of distal joint hyperlaxity combined with proximal joint contractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-abnormalities",
        "description": "Characteristic skin changes including keloid formation and follicular hyperkeratosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in COL6A1, COL6A2, or COL6A3 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing reduced or absent collagen VI expression",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital proximal muscle weakness with distal joint hyperlaxity and proximal contractures plus pathogenic variants in collagen VI genes or characteristic muscle biopsy findings",
    "notes": "Genetic testing is considered confirmatory; muscle biopsy may support diagnosis if genetic testing is inconclusive."
  },
