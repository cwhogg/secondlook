  "diagnosticCriteria": {
    "formalCriteriaName": "Neuroimaging-based Polymicrogyria Diagnostic Criteria",
    "criteria": [
      {
        "id": "imaging-pattern",
        "description": "Characteristic bilateral parasagittal polymicrogyria involving parieto-occipital regions on MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-seizures",
        "description": "Presence of early-onset focal or generalized seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroencephalogram",
        "description": "EEG abnormalities consistent with cortical malformation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with cortical development (e.g., GPR56, TUBB2B)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic bilateral parasagittal parieto-occipital polymicrogyria on MRI plus at least two major clinical features (seizures and developmental delay).",
    "notes": "Diagnosis relies heavily on high-resolution MRI and clinical correlation; genetic testing may aid but is not mandatory."
  },
