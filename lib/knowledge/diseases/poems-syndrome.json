  "diagnosticCriteria": {
    "formalCriteriaName": "Dispenzieri Diagnostic Criteria for POEMS Syndrome",
    "criteria": [
      {
        "id": "polyneuropathy",
        "description": "Presence of a demyelinating peripheral polyneuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "monoclonal-plasma-cell-proliferative-disorder",
        "description": "Monoclonal plasma cell disorder (usually lambda light chain)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sclerotic-bone-lesions",
        "description": "Presence of sclerotic bone lesions",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "organomegaly",
        "description": "Enlargement of liver, spleen, or lymph nodes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "endocrinopathy",
        "description": "Endocrine abnormalities excluding diabetes or hypothyroidism alone",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skin-changes",
        "description": "Characteristic dermatological manifestations such as hyperpigmentation or hemangiomas",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "papilledema",
        "description": "Presence of papilledema",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Both major criteria (polyneuropathy and monoclonal plasma cell disorder) plus at least one minor criterion",
    "notes": "Sclerotic bone lesions are considered a major criterion but not required for diagnosis."
  },
