  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Junctional Epidermolysis Bullosa with Pyloric Atresia",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of congenital blistering and skin fragility at birth or shortly after",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pyloric-atresia-confirmation",
        "description": "Radiological or surgical confirmation of pyloric atresia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in ITGA6 or ITGB4 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Reduced or absent expression of integrin α6β4 at the dermoepidermal junction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Subepidermal blister formation on skin biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital blistering with confirmed pyloric atresia and pathogenic variants in ITGA6 or ITGB4 genes",
    "notes": "Genetic confirmation is essential for definitive diagnosis; immunofluorescence and histopathology support diagnosis."
  },
