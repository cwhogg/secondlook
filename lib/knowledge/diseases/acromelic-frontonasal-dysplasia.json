        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acromelic-limb-malformations",
        "description": "Acromelic limb anomalies including brachydactyly and camptodactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Craniofacial abnormalities such as broad nasal root and frontal bossing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-development",
        "description": "Normal to mildly delayed intellectual development",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiographic-limb-abnormalities",
        "description": "Radiographic evidence of distal limb bone hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: frontonasal midline cleft or hypertelorism, acromelic limb malformations, and craniofacial dysmorphism",
    "notes": "Genetic testing may support diagnosis but is not definitive due to limited known mutations."
