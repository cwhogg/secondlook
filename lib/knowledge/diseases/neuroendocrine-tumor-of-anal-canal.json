        "Histology showing squamous differentiation rather than neuroendocrine markers",
        "Different treatment protocols and prognosis"
      ]
    },
    {
      "diseaseId": "anal-adenocarcinoma",
      "distinguishingFeatures": [
        "Glandular histology with mucin production",
        "Lack of neuroendocrine marker expression"
      ]
    },
    {
      "diseaseId": "hemorrhoidal disease",
      "distinguishingFeatures": [
        "Absence of tumor mass on imaging and endoscopy",
        "Symptoms limited to bleeding and discomfort without mass or systemic signs"
      ]
    }
  ],
  "redFlags": [
