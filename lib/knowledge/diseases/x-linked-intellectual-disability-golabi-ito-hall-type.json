  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Golabi-Ito-Hall syndrome",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Moderate to severe intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent supraorbital ridges, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal anomalies such as joint contractures and scoliosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "X-linked-inheritance",
        "description": "X-linked inheritance pattern confirmed by family history or genetic testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mutation-in-ATP6AP2",
        "description": "Pathogenic variant in ATP6AP2 gene identified by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of moderate to severe intellectual disability, characteristic facial dysmorphism, skeletal abnormalities, and identification of pathogenic ATP6AP2 mutation or consistent X-linked inheritance pattern",
    "notes": "Diagnosis is confirmed by molecular genetic testing identifying ATP6AP2 mutations; clinical features guide initial suspicion."
  },
