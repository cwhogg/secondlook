  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electrophysiological Criteria for HMN Type V",
    "criteria": [
      {
        "id": "distal-muscle-weakness",
        "description": "Presence of distal muscle weakness predominantly affecting the upper limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "motor-nerve-conduction-velocity",
        "description": "Electrophysiological evidence of motor neuropathy with normal sensory nerve conduction studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-atrophy",
        "description": "Distal muscle wasting predominantly in the hands and forearms",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with HMN Type V (e.g., GARS gene)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of distal upper limb muscle weakness and wasting with electrophysiological evidence of motor neuropathy and compatible family history",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical and electrophysiological criteria are met."
  },
