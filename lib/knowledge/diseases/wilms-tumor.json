  "keyFindings": {
    "laboratory": [
      "Anemia on complete blood count",
      "Elevated lactate dehydrogenase (LDH)",
      "Possible microscopic hematuria"
    ],
    "imaging": [
      "Ultrasound showing solid renal mass",
      "CT/MRI demonstrating well-circumscribed renal tumor with possible necrosis or hemorrhage",
      "Chest imaging to evaluate for pulmonary metastases"
    ],
    "genetic": [
      "TWIST2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology revealing triphasic pattern (blastemal, stromal, epithelial components)",
      "Immunohistochemistry positive for WT1 protein"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "neuroblastoma",
      "distinguishingFeatures": [
        "Originates from adrenal medulla or sympathetic chain",
        "Elevated catecholamine metabolites in urine",
        "Calcifications common on imaging"
      ]
    },
    {
      "diseaseId": "renal-cell-carcinoma-pediatric",
      "distinguishingFeatures": [
        "Rare in children, typically older age group",
        "Different histopathological features",
        "No WT1 mutations"
      ]
    },
    {
      "diseaseId": "mesoblastic-nephroma",
      "distinguishingFeatures": [
        "Usually presents in neonates",
        "Benign tumor with spindle cell histology",
        "Different imaging characteristics"
      ]
    }
  ],
  "redFlags": [
    "Rapidly enlarging abdominal mass",
    "Hemodynamic instability suggesting tumor rupture",
    "Respiratory distress indicating possible metastasis"
  ],
