  "keyFindings": {
    "laboratory": [
      "Persistent microscopic hematuria and proteinuria on urinalysis",
      "Elevated serum creatinine in progressive renal failure"
    ],
    "imaging": [
      "Esophageal and tracheobronchial wall thickening on CT or MRI consistent with leiomyomatosis",
      "Renal ultrasound showing normal or reduced kidney size in advanced disease"
    ],
    "genetic": [
      "COL4A6 (phenotype modifier)",
      "COL4A5 (phenotype modifier)",
      "X-linked dominant inheritance"
    ],
    "other": [
      "Audiometry confirming bilateral sensorineural hearing loss",
      "Ophthalmologic slit-lamp examination revealing anterior lenticonus"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "x-linked-alport-syndrome",
      "distinguishingFeatures": [
        "Absence of diffuse leiomyomatosis",
        "COL4A5 mutations without COL4A6 involvement",
        "No smooth muscle tumors of esophagus or trachea"
      ]
    },
    {
      "diseaseId": "multiple-gastrointestinal-leiomyomatosis",
      "distinguishingFeatures": [
        "Leiomyomatosis without renal or hearing involvement",
        "No COL4A5/COL4A6 gene deletions",
        "Typically sporadic or autosomal dominant inheritance"
      ]
    }
  ],
  "redFlags": [
    "Early onset persistent hematuria with progressive renal impairment",
    "Presence of diffuse leiomyomatosis causing dysphagia or respiratory symptoms",
    "Family history of X-linked nephropathy with hearing loss"
  ],
