  "diagnosticCriteria": {
    "formalCriteriaName": "MEN4 Diagnostic Criteria",
    "criteria": [
      {
        "id": "cdkn1b-mutation",
        "description": "Presence of pathogenic germline mutation in the CDKN1B gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "endocrine-tumors",
        "description": "Development of tumors in two or more endocrine glands including parathyroid, pituitary, or adrenal glands",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of MEN4 or related endocrine tumors",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic CDKN1B mutation plus tumors in at least two endocrine glands",
    "notes": "Diagnosis requires genetic confirmation due to overlap with MEN1 and other MEN syndromes."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Primary hyperparathyroidism",
        "frequency": 0.85,
        "bodySystem": "endocrine",
        "notes": "Most common initial manifestation"
      },
      {
        "symptomName": "Pituitary adenomas",
        "frequency": 0.75,
        "bodySystem": "endocrine",
        "notes": "Often prolactinomas or non-functioning adenomas"
      }
    ],
    "common": [
      {
        "symptomName": "Hypercalcemia-related symptoms (fatigue, polyuria, polydipsia)",
        "frequency": 0.65,
        "bodySystem": "constitutional",
        "notes": "Due to hyperparathyroidism"
      },
      {
        "symptomName": "Adrenal tumors (non-functioning or cortisol-producing)",
        "frequency": 0.6,
        "bodySystem": "endocrine",
        "notes": "May be incidental or symptomatic"
      },
      {
        "symptomName": "Menstrual irregularities",
        "frequency": 0.55,
        "bodySystem": "reproductive",
        "notes": "Secondary to pituitary adenomas"
      },
      {
        "symptomName": "Headache",
        "frequency": 0.5,
        "bodySystem": "neurological",
        "notes": "Associated with pituitary tumors"
      }
    ],
    "occasional": [
      {
        "symptomName": "Kidney stones",
        "frequency": 0.4,
        "bodySystem": "renal",
        "notes": "Secondary to hypercalcemia"
      },
      {
        "symptomName": "Visual field defects",
        "frequency": 0.3,
        "bodySystem": "ophthalmological",
        "notes": "Due to pituitary adenoma compression"
      },
      {
        "symptomName": "Hypertension",
        "frequency": 0.25,
        "bodySystem": "cardiovascular",
        "notes": "May be related to adrenal tumors"
      },
      {
        "symptomName": "Gastroesophageal reflux",
        "frequency": 0.15,
        "bodySystem": "gastrointestinal",
        "notes": "Reported in some cases"
      }
    ],
    "rare": [
      {
        "symptomName": "Pancreatic neuroendocrine tumors",
        "frequency": 0.08,
        "bodySystem": "endocrine",
        "notes": "Less frequently reported"
      },
      {
        "symptomName": "Osteoporosis",
        "frequency": 0.05,
        "bodySystem": "musculoskeletal",
        "notes": "Secondary to chronic hyperparathyroidism"
      },
      {
        "symptomName": "Psychiatric symptoms (depression, anxiety)",
        "frequency": 0.03,
        "bodySystem": "psychiatric",
        "notes": "May be related to hormonal imbalances"
      }
    ]
  },
