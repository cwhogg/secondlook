  "keyFindings": {
    "laboratory": [
      "Markedly elevated unconjugated bilirubin levels (>20 mg/dL in type 1)",
      "Normal liver transaminases and synthetic function",
      "Normal complete blood count without hemolysis markers"
    ],
    "imaging": [
      "Brain MRI may show basal ganglia abnormalities in kernicterus"
    ],
    "genetic": [
      "Pathogenic mutations in UGT1A1 gene causing absent or severely reduced enzyme activity",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Reduced or absent UDP-glucuronosyltransferase enzyme activity on liver biopsy or fibroblast assay"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "gilbert-syndrome",
      "distinguishingFeatures": [
        "Mild unconjugated hyperbilirubinemia usually <3 mg/dL",
        "Intermittent jaundice often triggered by stress or fasting",
        "Normal or mildly reduced UGT1A1 activity"
      ]
    },
    {
      "diseaseId": "physiological-neonatal-jaundice",
      "distinguishingFeatures": [
        "Transient unconjugated hyperbilirubinemia resolving within 1-2 weeks",
        "No genetic mutations in UGT1A1",
        "Responds well to phototherapy"
      ]
    },
    {
      "diseaseId": "hemolytic-anemia",
      "distinguishingFeatures": [
        "Evidence of increased red blood cell destruction",
        "Elevated reticulocyte count and lactate dehydrogenase",
        "Presence of anemia"
      ]
    }
  ],
  "redFlags": [
    "Rapidly rising unconjugated bilirubin in neonate",
    "Signs of acute bilirubin encephalopathy (lethargy, hypotonia, seizures)",
    "Failure to respond to intensive phototherapy"
  ],
  "specialistType": [
