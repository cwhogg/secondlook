  "differentialDiagnoses": [
    {
      "diseaseId": "classical-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Autosomal dominant inheritance",
        "More prominent skin fragility and atrophic scarring",
        "Different genetic mutations (COL5A1, COL5A2)"
      ]
    },
    {
