  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of metabolic causes of ataxia"
    ],
    "imaging": [
      "MRI showing cerebellar atrophy, predominantly vermis and hemispheres"
    ],
    "genetic": [
      "PPP2R2B (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography may show mild sensory neuropathy",
      "Neurophysiology may reveal cerebellar dysfunction"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "spinocerebellar-ataxia-type-1",
      "distinguishingFeatures": [
        "Earlier onset age",
        "Presence of pyramidal signs and ophthalmoplegia",
        "Different genetic mutation (ATXN1 gene)"
      ]
    },
    {
      "diseaseId": "essential-tremor",
      "distinguishingFeatures": [
        "Isolated tremor without progressive ataxia",
        "No cerebellar atrophy on imaging",
        "No genetic CAG repeat expansion"
      ]
    },
    {
      "diseaseId": "multiple-system-atrophy",
      "distinguishingFeatures": [
        "Autonomic failure prominent",
        "Parkinsonism features more common",
        "MRI shows putaminal and brainstem changes"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of ataxia over weeks to months",
    "Early autonomic failure",
    "Presence of seizures or sudden neurological deterioration"
  ],
