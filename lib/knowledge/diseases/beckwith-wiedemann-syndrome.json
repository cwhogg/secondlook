  "diagnosticCriteria": {
    "formalCriteriaName": "Beckwith-Wiedemann Syndrome Clinical Diagnostic Criteria",
    "criteria": [
      {
        "id": "macroglossia",
        "description": "Presence of macroglossia (enlarged tongue)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "abdominal-wall-defects",
        "description": "Abdominal wall defects such as omphalocele or umbilical hernia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hemihyperplasia",
        "description": "Lateralized overgrowth (hemihyperplasia)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "neonatal-hypoglycemia",
        "description": "Neonatal hypoglycemia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ear-creases-pits",
        "description": "Ear creases or pits",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "tumor-predisposition",
        "description": "Increased risk of embryonal tumors (e.g., Wilms tumor, hepatoblastoma)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Diagnosis requires three major criteria or two major plus two minor criteria.",
    "notes": "Genetic testing for 11p15 abnormalities supports diagnosis but is not required."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Macroglossia",
        "frequency": 0.85,
        "bodySystem": "otolaryngological",
        "notes": "Often causes feeding and respiratory difficulties"
      },
      {
        "symptomName": "Abdominal wall defects (omphalocele, umbilical hernia)",
        "frequency": 0.75,
        "bodySystem": "gastrointestinal",
        "notes": "Commonly present at birth"
      },
      {
        "symptomName": "Hemihyperplasia (lateralized overgrowth)",
        "frequency": 0.7,
        "bodySystem": "musculoskeletal",
        "notes": "Asymmetric growth of limbs or body segments"
      }
    ],
    "common": [
      {
        "symptomName": "Neonatal hypoglycemia",
        "frequency": 0.6,
        "bodySystem": "endocrine",
        "notes": "Transient but may require treatment"
      },
      {
        "symptomName": "Ear creases or pits",
        "frequency": 0.55,
        "bodySystem": "dermatological",
        "notes": "Preauricular pits or creases"
      },
      {
        "symptomName": "Visceromegaly (enlargement of internal organs)",
        "frequency": 0.65,
        "bodySystem": "gastrointestinal",
        "notes": "Includes hepatomegaly, nephromegaly"
      },
      {
        "symptomName": "Polyhydramnios during pregnancy",
        "frequency": 0.5,
        "bodySystem": "constitutional",
        "notes": "May be detected prenatally"
      }
    ],
    "occasional": [
      {
        "symptomName": "Neonatal respiratory distress",
        "frequency": 0.3,
        "bodySystem": "respiratory",
        "notes": "Due to macroglossia or airway obstruction"
      },
      {
        "symptomName": "Hypotonia",
        "frequency": 0.25,
        "bodySystem": "musculoskeletal",
        "notes": "Mild muscle tone reduction"
      },
      {
        "symptomName": "Renal abnormalities",
        "frequency": 0.2,
        "bodySystem": "renal",
        "notes": "Includes nephrocalcinosis or cysts"
      },
      {
        "symptomName": "Cardiomegaly",
        "frequency": 0.15,
        "bodySystem": "cardiovascular",
        "notes": "Enlarged heart detected on imaging"
      }
    ],
    "rare": [
      {
        "symptomName": "Neurodevelopmental delay",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Mild intellectual disability in some cases"
      },
      {
        "symptomName": "Hepatoblastoma",
        "frequency": 0.07,
        "bodySystem": "gastrointestinal",
        "notes": "Malignant tumor risk"
      },
      {
        "symptomName": "Wilms tumor",
        "frequency": 0.06,
        "bodySystem": "renal",
        "notes": "Embryonal kidney tumor risk"
      }
    ]
  },
