  "diagnosticCriteria": {
    "formalCriteriaName": "Van Haelst criteria",
    "criteria": [
      {
        "id": "cryptophthalmos",
        "description": "Complete or partial cryptophthalmos (fusion of the eyelids)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "syndactyly",
        "description": "Syndactyly of fingers and/or toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genitourinary-malformations",
        "description": "Genitourinary anomalies such as ambiguous genitalia or renal agenesis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "laryngeal-anomalies",
        "description": "Laryngeal and respiratory tract malformations",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "umbilical-hernia",
        "description": "Umbilical hernia or abdominal wall defects",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least two major criteria or one major and two minor criteria",
    "notes": "Diagnosis is clinical and supported by genetic testing when available"
  },
