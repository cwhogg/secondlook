  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and enzymatic diagnostic criteria for MPS I-S",
    "criteria": [
      {
        "id": "alpha-l-iduronidase-deficiency",
        "description": "Deficiency of alpha-L-iduronidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features including mild dysostosis multiplex, corneal clouding, and cardiac valve abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-gags",
        "description": "Elevated urinary glycosaminoglycans (dermatan sulfate and heparan sulfate)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of alpha-L-iduronidase enzyme plus presence of characteristic clinical features",
    "notes": "Genetic testing of IDUA gene mutations can confirm diagnosis"
  },
