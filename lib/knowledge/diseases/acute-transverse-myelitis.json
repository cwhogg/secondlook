  "diagnosticCriteria": {
    "formalCriteriaName": "Transverse Myelitis Consortium Working Group Diagnostic Criteria",
    "criteria": [
      {
        "id": "bilateral-sensory-motor-deficit",
        "description": "Bilateral sensory, motor, or autonomic spinal cord dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "spinal-cord-inflammation",
        "description": "MRI or CSF evidence of spinal cord inflammation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of compressive, vascular, neoplastic, or infectious causes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progression-rapid",
        "description": "Progression to nadir between 4 hours and 21 days",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Bilateral spinal cord dysfunction with MRI or CSF evidence of inflammation and exclusion of other causes",
    "notes": "Diagnosis requires careful exclusion of mimics such as spinal cord compression and multiple sclerosis."
  },
