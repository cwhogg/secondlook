  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Microcephaly-Intellectual Disability-Sensorineural Hearing Loss-Epilepsy-Abnormal Muscle Tone Syndrome",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Head circumference more than 3 standard deviations below the mean for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability confirmed by standardized testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss confirmed by audiometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epilepsy",
        "description": "Recurrent unprovoked seizures documented clinically or by EEG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-muscle-tone",
        "description": "Presence of hypotonia or hypertonia detected on neurological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-features",
        "description": "Additional neurological abnormalities such as ataxia or spasticity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microcephaly, intellectual disability, sensorineural hearing loss, epilepsy, and abnormal muscle tone",
    "notes": "Diagnosis is clinical and supported by neuroimaging and genetic testing when available"
  },
