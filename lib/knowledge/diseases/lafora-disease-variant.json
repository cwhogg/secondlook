  "diagnosticCriteria": {
    "formalCriteriaName": "Lafora Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-pme",
        "description": "Progressive myoclonic epilepsy with onset in adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lafora-bodies",
        "description": "Presence of Lafora bodies on skin biopsy or brain tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in EPM2A or NHLRC1 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing cerebral and cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electroencephalography",
        "description": "EEG demonstrating generalized spike-wave and polyspike-wave discharges",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive myoclonic epilepsy onset in adolescence plus either Lafora bodies on biopsy or pathogenic mutations in EPM2A/NHLRC1",
    "notes": "Skin biopsy is less invasive and commonly used for Lafora body detection."
  },
