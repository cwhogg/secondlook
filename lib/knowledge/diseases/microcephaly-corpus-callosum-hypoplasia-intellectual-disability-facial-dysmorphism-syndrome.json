  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed diagnostic criteria for Microcephaly-corpus callosum hypoplasia-intellectual disability-facial dysmorphism syndrome",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Postnatal microcephaly with head circumference below 3rd percentile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "corpus-callosum-hypoplasia",
        "description": "Hypoplasia or agenesis of the corpus callosum confirmed by brain MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features including broad nasal bridge, hypertelorism, and thin upper lip",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "supportive-neurological-features",
        "description": "Seizures, hypotonia, or motor delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (microcephaly, corpus callosum hypoplasia, intellectual disability) with supportive facial dysmorphism",
    "notes": "Diagnosis is primarily clinical supported by neuroimaging and developmental assessment"
  },
