  "diagnosticCriteria": {
    "formalCriteriaName": "ASHA Childhood Apraxia of Speech Diagnostic Criteria",
    "criteria": [
      {
        "id": "inconsistent-errors",
        "description": "Inconsistent errors on consonants and vowels in repeated productions of syllables or words",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lengthened-transitions",
        "description": "Lengthened and disrupted coarticulatory transitions between sounds and syllables",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "inappropriate-stress",
        "description": "Inappropriate prosody, especially in the realization of lexical or phrasal stress",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "groping-movements",
        "description": "Visible or audible groping for articulatory placement",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "poor-oral-motor-control",
        "description": "Difficulty with volitional oral movements not caused by weakness or paralysis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (inconsistent errors, lengthened transitions, inappropriate stress) with exclusion of neuromuscular deficits",
    "notes": "Diagnosis requires exclusion of other speech disorders such as dysarthria or phonological delay."
  },
