  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "low-c1q-levels",
        "description": "Undetectable or severely reduced serum C1q protein levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in C1QA, C1QB, or C1QC genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of recurrent infections and/or lupus-like autoimmune manifestations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "complement-assay",
        "description": "Absent classical complement pathway activity on functional assay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biallelic pathogenic variants in C1q genes plus undetectable serum C1q levels with compatible clinical features",
    "notes": "Diagnosis relies on combination of genetic, immunological, and clinical findings."
  },
  "symptoms": {
