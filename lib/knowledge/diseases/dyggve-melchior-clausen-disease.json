  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Dyggve-Melchior-Clausen disease",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive short stature with disproportionate short trunk dwarfism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-findings",
        "description": "Characteristic radiographic features including double-humped vertebral bodies and lacy iliac crests",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the DYM gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation and characteristic radiological findings; genetic confirmation supports diagnosis",
    "notes": "Genetic testing is recommended to confirm diagnosis but is not mandatory if clinical and radiological features are definitive."
  },
