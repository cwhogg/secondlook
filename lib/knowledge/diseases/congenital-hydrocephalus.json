  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; CSF analysis may be performed to exclude infection"
    ],
    "imaging": [
      "Prenatal or postnatal ultrasound showing ventriculomegaly",
      "MRI or CT demonstrating enlarged lateral and third ventricles with or without aqueductal stenosis"
    ],
    "genetic": [
      "Mutations in L1CAM gene and other genes associated with congenital hydrocephalus"
    ],
    "other": [
      "Increased head circumference measurements over time",
      "Elevated intracranial pressure signs on clinical examination"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "aqueductal-stenosis",
      "distinguishingFeatures": [
        "Isolated aqueductal narrowing on imaging",
        "May present later in infancy or childhood",
        "Often no associated genetic mutations seen in congenital hydrocephalus"
      ]
    },
    {
      "diseaseId": "hydrocephalus-ex-vacuo",
      "distinguishingFeatures": [
        "Ventricular enlargement secondary to brain atrophy",
        "No increased intracranial pressure",
        "Associated with neurodegenerative conditions"
      ]
    }
  ],
