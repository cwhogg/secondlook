  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for RERE-related Neurodevelopmental Syndrome",
    "criteria": [
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial dysmorphisms including broad forehead, hypertelorism, and downslanting palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging-abnormalities",
        "description": "Brain MRI abnormalities such as corpus callosum hypoplasia or ventriculomegaly",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "RERE-pathogenic-variant",
        "description": "Identification of pathogenic or likely pathogenic variant in the RERE gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-issues",
        "description": "Presence of autism spectrum disorder or other behavioral abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of global developmental delay or intellectual disability, characteristic facial features, and a pathogenic variant in RERE gene",
    "notes": "Diagnosis is confirmed by molecular genetic testing identifying a pathogenic variant in RERE."
  },
