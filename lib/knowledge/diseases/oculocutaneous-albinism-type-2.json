  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for Oculocutaneous Albinism",
    "criteria": [
      {
        "id": "hypopigmentation-skin-hair-eyes",
        "description": "Congenital hypopigmentation of skin, hair, and eyes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-abnormalities",
        "description": "Presence of nystagmus, reduced visual acuity, and foveal hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biallelic-p-protein-mutations",
        "description": "Identification of pathogenic biallelic mutations in the OCA2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-tyrosinase-deficiency",
        "description": "Normal or reduced tyrosinase enzyme activity distinguishing from OCA1",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consistent autosomal recessive inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital hypopigmentation and ocular abnormalities plus identification of biallelic pathogenic OCA2 mutations",
    "notes": "Molecular genetic testing is essential for definitive diagnosis and differentiation from other types of albinism."
  },
