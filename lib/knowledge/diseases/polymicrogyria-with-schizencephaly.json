  "diagnosticCriteria": {
    "formalCriteriaName": "Neuroimaging Diagnostic Criteria for Polymicrogyria with Schizencephaly",
    "criteria": [
      {
        "id": "imaging-evidence",
        "description": "MRI demonstrating polymicrogyria characterized by excessive small gyri and schizencephalic clefts lined by polymicrogyric cortex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-epilepsy",
        "description": "Presence of epilepsy with onset in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-signs",
        "description": "Focal neurological deficits such as hemiparesis or spasticity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "MRI evidence of polymicrogyria with schizencephalic clefts plus clinical features of epilepsy and developmental delay",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
