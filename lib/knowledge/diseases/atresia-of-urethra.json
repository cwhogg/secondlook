        "requiredForDiagnosis": true
      },
      {
        "id": "retrograde-urethrography",
        "description": "Imaging showing complete urethral obstruction or absence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "prenatal-ultrasound-findings",
        "description": "Prenatal ultrasound showing oligohydramnios and enlarged bladder",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-function-assessment",
        "description": "Assessment of renal function to evaluate secondary effects",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of absent urethral meatus and imaging evidence of complete urethral obstruction",
    "notes": "Diagnosis is primarily clinical supported by imaging; prenatal diagnosis possible via ultrasound."
