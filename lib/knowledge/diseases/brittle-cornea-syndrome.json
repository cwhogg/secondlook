  "diagnosticCriteria": {
    "formalCriteriaName": "Brittle Cornea Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "corneal-thinning",
        "description": "Extreme corneal thinning with blue sclera",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "corneal-rupture",
        "description": "Spontaneous or trauma-induced corneal rupture or rupture susceptibility",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "joint-hypermobility",
        "description": "Generalized joint hypermobility",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic variants in ZNF469 or PRDM5 genes",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of extreme corneal thinning with blue sclera and either corneal rupture or genetic confirmation of pathogenic variants in ZNF469 or PRDM5",
    "notes": "Diagnosis is supported by clinical findings and confirmed by molecular genetic testing."
  },
