  "keyFindings": {
    "laboratory": [
      "Reduced acid sphingomyelinase enzyme activity in leukocytes or fibroblasts",
      "Thrombocytopenia and mild anemia on complete blood count",
      "Elevated liver transaminases and lipid abnormalities"
    ],
    "imaging": [
      "Chest X-ray or CT showing interstitial lung disease",
      "Abdominal ultrasound demonstrating hepatosplenomegaly",
      "Bone densitometry indicating osteopenia"
    ],
    "genetic": [
      "SMPD1 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Bone marrow biopsy showing foamy macrophages (Niemann-Pick cells)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "niemann-pick-disease-type-a",
      "distinguishingFeatures": [
        "Severe neurodegeneration with early onset",
        "Markedly reduced acid sphingomyelinase activity",
        "Rapidly progressive course leading to death in early childhood"
      ]
    },
    {
      "diseaseId": "gaucher-disease-type-1",
      "distinguishingFeatures": [
        "Glucocerebrosidase deficiency instead of acid sphingomyelinase",
        "Presence of Gaucher cells rather than foamy macrophages",
        "More prominent bone involvement and less pulmonary disease"
      ]
    }
  ],
  "redFlags": [
    "Progressive hepatosplenomegaly with respiratory compromise",
    "Severe thrombocytopenia with bleeding tendency",
    "Rapid decline in pulmonary function tests"
  ],
