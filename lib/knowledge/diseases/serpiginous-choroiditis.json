    "formalCriteriaName": "Clinical Diagnostic Criteria for Serpiginous Choroiditis",
    "criteria": [
      {
        "id": "geographic-atrophy",
        "description": "Presence of geographic areas of chorioretinal atrophy with serpiginous or creeping margins",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurring-inflammation",
        "description": "Recurrent episodes of active choroiditis with new lesions extending from old scars",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fundus-fluorescein-angiography",
        "description": "Characteristic findings on fluorescein angiography including early hypofluorescence and late hyperfluorescence of lesions",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-infectious-etiologies",
        "description": "Exclusion of infectious causes such as tuberculosis and syphilis",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of geographic chorioretinal atrophy with serpiginous margins and recurrent active inflammation, with exclusion of infectious causes",
    "notes": "Diagnosis is clinical supported by imaging and exclusion of infectious etiologies."
  },
