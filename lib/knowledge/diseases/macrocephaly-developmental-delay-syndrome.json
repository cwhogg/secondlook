  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible mild elevation of liver enzymes in rare cases",
      "Thyroid function tests may reveal hypothyroidism in rare cases"
    ],
    "imaging": [
      "Brain MRI may show mild ventriculomegaly or delayed myelination",
      "Echocardiogram may detect cardiac septal defects"
    ],
    "genetic": [
      "KPTN (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electroencephalogram (EEG) abnormalities consistent with seizure activity"
    ]
  },
  "differentialDiagnoses": [
