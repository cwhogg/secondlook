  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Kenny-Caffey Syndrome Type 2",
    "criteria": [
      {
        "id": "hypoparathyroidism",
        "description": "Presence of hypoparathyroidism leading to hypocalcemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Characteristic cortical thickening and medullary stenosis of long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Proportionate short stature apparent in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of heterozygous pathogenic variants in the FAM111A gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including microcephaly, deep-set eyes, and beaked nose",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypoparathyroidism, characteristic skeletal abnormalities, and identification of pathogenic FAM111A variant",
    "notes": "Genetic confirmation is essential for definitive diagnosis; clinical features guide initial suspicion."
  },
