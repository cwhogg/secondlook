  "keyFindings": {
    "laboratory": [
      "Normal blood counts; occasional mild leukocytosis if systemic involvement",
      "Histopathology showing dermal histiocytic infiltration with Touton giant cells"
    ],
    "imaging": [
      "Ultrasound or MRI may reveal systemic lesions if present",
      "Ocular ultrasound for iris nodules"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Spontaneous regression of lesions without treatment in most cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "langerhans-cell-histiocytosis",
      "distinguishingFeatures": [
        "Presence of Birbeck granules on electron microscopy",
        "CD1a and Langerin positive immunohistochemistry",
        "More aggressive clinical course"
      ]
    },
    {
      "diseaseId": "xanthoma",
      "distinguishingFeatures": [
        "Associated with lipid metabolism disorders",
        "Lesions typically lack Touton giant cells",
        "Usually occur in adults"
      ]
    },
    {
      "diseaseId": "cutaneous-mastocytosis",
      "distinguishingFeatures": [
        "Darier’s sign positive",
        "Mast cell infiltration on biopsy",
        "Different lesion morphology"
      ]
    }
  ],
  "redFlags": [
    "Rapidly enlarging or ulcerating skin lesions",
    "Neurological deficits indicating CNS involvement",
    "Systemic symptoms such as persistent fever or weight loss"
  ],
