  "confidenceInData": "medium",
  "commonPitfalls": [
    "Mild cases may be misdiagnosed as nonspecific developmental delay or autism spectrum disorder due to subtle dysmorphic features.",
    "Distinctive facial features can be overlooked in infants, especially in the absence of limb abnormalities.",
    "Growth retardation may be attributed to constitutional or familial short stature if not carefully evaluated.",
    "Upper limb reduction defects may be mistaken for amniotic band sequence."
  ],
  "extendedDiscriminators": [
    {
      "vsCondition": "fetal-alcohol-spectrum-disorder",
      "feature": "CdLS typically presents with synophrys (unibrow), long philtrum, and limb abnormalities, which are uncommon in FASD."
    },
    {
      "vsCondition": "roberts-syndrome",
      "feature": "CdLS usually has milder limb reduction and characteristic facial features (arched eyebrows, long eyelashes, thin downturned lips), while Roberts syndrome often has severe phocomelia and cleft lip/palate."
    },
    {
      "vsCondition": "Smith-Lemli-Opitz syndrome",
      "feature": "CdLS lacks the 2-3 toe syndactyly and cholesterol metabolism defects seen in Smith-Lemli-Opitz syndrome."
    }
  ],
  "ruleOutCriteria": [
    "Normal cognitive development and growth parameters essentially exclude CdLS.",
    "Absence of any facial dysmorphism (arched eyebrows, long eyelashes, synophrys, thin downturned lips) in a child with developmental delay makes CdLS highly unlikely.",
    "Presence of normal upper limbs in a patient with otherwise suggestive features argues strongly against classic CdLS."
  ],
