  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiologic Diagnostic Criteria for Renal Dysplasia",
    "criteria": [
      {
        "id": "imaging-cysts",
        "description": "Presence of multiple cysts of varying sizes within the renal parenchyma on ultrasound or MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-hypoplasia",
        "description": "Reduced renal size with abnormal renal architecture on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological evidence of immature or undifferentiated renal tissue with abnormal differentiation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-presentation",
        "description": "Unilateral or bilateral renal dysfunction presenting in infancy or early childhood",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic imaging findings of multiple renal cysts with reduced renal size plus clinical evidence of renal dysfunction",
    "notes": "Histopathological confirmation is not always required but can support diagnosis."
  },
