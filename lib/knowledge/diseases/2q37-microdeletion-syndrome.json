  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for 2q37 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "brachydactyly",
        "description": "Presence of brachydactyly type E (shortening of the 4th and 5th metacarpals/metatarsals)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including round face, prominent forehead, and flat nasal bridge",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Detection of deletion at chromosome 2q37 by molecular cytogenetic methods (FISH, microarray)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-issues",
        "description": "Behavioral abnormalities such as autism spectrum disorder or hyperactivity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of brachydactyly type E, developmental delay, and confirmed 2q37 deletion by genetic testing",
    "notes": "Diagnosis is confirmed by molecular cytogenetic analysis; clinical features support suspicion."
  },
