  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiologic Diagnosis of Urachal Cyst",
    "criteria": [
      {
        "id": "imaging-evidence",
        "description": "Identification of a midline cystic mass between the umbilicus and bladder dome on ultrasound, CT, or MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of localized suprapubic tenderness or palpable midline mass",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-urinary-tract-infection",
        "description": "Exclusion of concurrent urinary tract infection to differentiate from infected cyst or abscess",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathologic-confirmation",
        "description": "Histological confirmation of urachal remnant tissue after surgical excision",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Imaging evidence of a midline cystic mass between the umbilicus and bladder dome plus clinical presentation consistent with urachal cyst",
    "notes": "Infected or complicated cysts may require additional diagnostic workup including laboratory tests and imaging."
  },
