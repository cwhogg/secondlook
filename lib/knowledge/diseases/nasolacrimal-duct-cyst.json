  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Imaging Diagnostic Criteria for Nasolacrimal Duct Cyst",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of a bluish, cystic swelling at the medial canthus or along the nasolacrimal duct in a neonate or infant",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-confirmation",
        "description": "Imaging evidence (ultrasound or MRI) showing cystic dilation of the nasolacrimal duct",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nasolacrimal-obstruction",
        "description": "Clinical signs of nasolacrimal duct obstruction such as epiphora or mucopurulent discharge",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic cystic swelling at the medial canthus with imaging confirmation of nasolacrimal duct cyst",
    "notes": "Diagnosis is primarily clinical supported by imaging; differential diagnosis includes other medial canthal masses."
  },
