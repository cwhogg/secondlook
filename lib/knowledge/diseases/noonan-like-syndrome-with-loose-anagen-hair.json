  "diagnosticCriteria": {
    "formalCriteriaName": "Noonan-like Syndrome with Loose Anagen Hair Diagnostic Criteria",
    "criteria": [
      {
        "id": "shoc2-mutation",
        "description": "Presence of pathogenic SHOC2 gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "noonan-features",
        "description": "Clinical features consistent with Noonan syndrome including characteristic facial dysmorphisms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "loose-anagen-hair",
        "description": "Loose anagen hair characterized by easily pluckable, sparse, thin hair with abnormal hair root morphology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-anomalies",
        "description": "Presence of congenital heart defects such as pulmonic stenosis or hypertrophic cardiomyopathy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-delay",
        "description": "Postnatal growth retardation or short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic SHOC2 mutation plus presence of Noonan syndrome features and loose anagen hair",
    "notes": "Molecular genetic testing is essential for confirmation; clinical diagnosis may be suspected based on phenotype."
  },
