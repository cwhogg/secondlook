  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild anemia or thrombocytopenia in some cases"
    ],
    "imaging": [
      "Brain MRI may show nonspecific cerebral atrophy or delayed myelination",
      "Skeletal X-rays may reveal scoliosis or joint contractures"
    ],
    "genetic": [
      "CREBBP (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electroencephalogram abnormalities consistent with seizure activity",
      "Feeding assessments demonstrating swallowing dysfunction"
    ]
  },
