  "diagnosticCriteria": {
    "formalCriteriaName": "Neonatal Sepsis Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-signs",
        "description": "Presence of clinical signs consistent with sepsis such as temperature instability, respiratory distress, or lethargy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "positive-blood-culture",
        "description": "Isolation of pathogenic organism from blood culture",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "laboratory-markers",
        "description": "Elevated inflammatory markers such as C-reactive protein (CRP) or procalcitonin",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hematological-changes",
        "description": "Abnormal white blood cell count or immature to total neutrophil ratio",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "At least one major clinical sign plus either a positive blood culture or supportive laboratory markers",
    "notes": "Diagnosis is challenging due to nonspecific presentation in premature infants; clinical judgment is essential."
  },
