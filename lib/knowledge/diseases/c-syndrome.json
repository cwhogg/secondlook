  "diagnosticCriteria": {
    "formalCriteriaName": "C Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including hypertelorism and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-cardiac-defects",
        "description": "Documented congenital cardiac malformations such as ventricular septal defect or pulmonary stenosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Presence of skeletal anomalies including clinodactyly or scoliosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cutaneous-pigmentary-abnormalities",
        "description": "Hypopigmented or hyperpigmented skin lesions",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: craniofacial dysmorphism, congenital cardiac defects, and developmental delay",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
