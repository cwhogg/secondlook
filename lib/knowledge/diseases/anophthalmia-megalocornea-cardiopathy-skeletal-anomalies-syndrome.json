  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible elevated cardiac enzymes in cardiomyopathy"
    ],
    "imaging": [
      "Orbital MRI or CT showing absence of ocular globes",
      "Echocardiography demonstrating structural heart defects",
      "Skeletal X-rays revealing joint contractures and scoliosis"
    ],
    "genetic": [
      "Likely autosomal recessive inheritance pattern",
      "No single causative gene identified; possible involvement of developmental genes"
    ],
    "other": [
      "Prenatal ultrasound may detect ocular and cardiac anomalies",
      "Electrocardiogram abnormalities consistent with cardiomyopathy"
    ]
  },
