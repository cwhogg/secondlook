  "diagnosticCriteria": {
    "formalCriteriaName": "MELAS Diagnostic Criteria (Modified Hirano Criteria)",
    "criteria": [
      {
        "id": "stroke-like-episodes",
        "description": "Presence of stroke-like episodes before age 40",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lactic-acidosis",
        "description": "Elevated lactate levels in blood or cerebrospinal fluid",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mitochondrial-dna-mutation",
        "description": "Detection of pathogenic mitochondrial DNA mutation associated with MELAS",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "Recurrent seizures or epilepsy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy-findings",
        "description": "Ragged-red fibers or cytochrome c oxidase deficiency on muscle biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least two major criteria including stroke-like episodes and mitochondrial DNA mutation",
    "notes": "Variant forms may present with atypical neurological or metabolic features and may lack classic stroke-like episodes initially."
  },
