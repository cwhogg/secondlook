  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Spasmodic Dysphonia",
    "criteria": [
      {
        "id": "involuntary-vocal-cord-spasms",
        "description": "Presence of involuntary spasms of the vocal cords during speech",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "voice-breaks",
        "description": "Intermittent voice breaks or interruptions during phonation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-structural-laryngeal-lesions",
        "description": "No structural abnormalities of the larynx on examination",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "symptom-exacerbation-with-speech",
        "description": "Symptoms worsen with connected speech and improve with whispering or singing",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-botulinum-toxin",
        "description": "Improvement of symptoms following botulinum toxin injection",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of involuntary vocal cord spasms and voice breaks with absence of structural laryngeal lesions",
    "notes": "Diagnosis is primarily clinical supported by laryngoscopic examination and response to treatment"
  },
