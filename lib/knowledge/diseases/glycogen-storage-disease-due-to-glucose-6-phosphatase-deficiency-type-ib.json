  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for GSD Ib",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of deficient glucose-6-phosphatase activity in liver biopsy or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the SLC37A4 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of hepatomegaly, hypoglycemia, and neutropenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-markers",
        "description": "Elevated lactate, triglycerides, and uric acid levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of deficient glucose-6-phosphatase activity or pathogenic SLC37A4 mutations plus characteristic clinical features",
    "notes": "Genetic testing is confirmatory; enzyme assay may be invasive but definitive."
  },
