  "keyFindings": {
    "laboratory": [
      "Elevated ESR, CRP, SAA (often persistently elevated, especially in NOMID)",
      "Leukocytosis with neutrophilia",
      "Elevated ferritin",
      "CSF pleocytosis (neutrophilic) in NOMID",
      "Proteinuria if AA amyloidosis develops"
    ],
    "imaging": [
      "MRI brain: leptomeningeal enhancement, cochlear enhancement in NOMID",
      "X-rays: epiphyseal overgrowth, patellar enlargement in NOMID",
      "CT inner ear: cochlear changes in hearing loss"
    ],
    "genetic": [
      "NLRP3 (CIAS1) gene mutations on chromosome 1q44",
      "Over 200 pathogenic variants described",
      "Autosomal dominant (many de novo, especially NOMID)",
      "Somatic mosaicism in ~30% of NOMID patients (standard sequencing may miss)"
    ],
    "other": [
      "Skin biopsy of rash: neutrophilic infiltrate (neutrophilic urticaria), not mast cell-mediated",
      "Audiometry: progressive sensorineural hearing loss",
      "Ophthalmologic exam: papilledema, optic disc edema in NOMID",
      "Dramatic response to IL-1 blockade (anakinra, canakinumab, rilonacept) is virtually diagnostic"
    ]
  },
