  "keyFindings": {
    "laboratory": [
      "Low serum cortisol",
      "Elevated plasma ACTH",
      "Hyponatremia and hyperkalemia",
      "Low aldosterone and renin abnormalities",
      "Low gonadotropins (LH and FSH)"
    ],
    "imaging": [
      "Small or hypoplastic adrenal glands on ultrasound or MRI",
      "Delayed bone age on radiographs"
    ],
    "genetic": [
      "NR0B1 (causative, loss-of-function)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Family history consistent with X-linked inheritance",
      "Response to glucocorticoid and mineralocorticoid replacement therapy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-adrenal-hyperplasia",
      "distinguishingFeatures": [
        "Enzymatic defects in steroidogenesis",
        "Elevated 17-hydroxyprogesterone in 21-hydroxylase deficiency",
        "Usually autosomal recessive inheritance"
      ]
    },
    {
      "diseaseId": "autoimmune-primary-adrenal-insufficiency",
      "distinguishingFeatures": [
        "Presence of adrenal autoantibodies",
        "Typically affects adults",
        "No NR0B1 gene mutation"
      ]
    },
    {
      "diseaseId": "hypopituitarism",
      "distinguishingFeatures": [
        "Multiple pituitary hormone deficiencies",
        "Normal adrenal glands on imaging",
        "Low ACTH and cortisol levels"
      ]
    }
  ],
  "redFlags": [
    "Salt-wasting crisis with dehydration and shock in infancy",
    "Delayed or absent puberty in affected males",
    "Family history of unexplained male infant deaths or adrenal insufficiency"
  ],
