  "differentialDiagnoses": [
    {
      "diseaseId": "turner-syndrome",
      "distinguishingFeatures": [
        "Turner syndrome only affects females",
        "45,X or variant karyotype",
        "Ovarian failure rather than testicular issues",
        "Left-sided heart defects (coarctation, bicuspid aortic valve)"
      ]
    },
    {
      "diseaseId": "cardiofaciocutaneous-syndrome",
      "distinguishingFeatures": [
        "CFC syndrome has more severe intellectual disability",
        "Sparse, curly hair and absent eyebrows",
        "BRAF, MAP2K1, MAP2K2, KRAS mutations",
        "Ichthyosis or keratosis pilaris"
      ]
    },
    {
      "diseaseId": "costello-syndrome",
      "distinguishingFeatures": [
        "HRAS mutations",
        "More severe intellectual disability",
        "Papillomata around nose and mouth",
        "Higher malignancy risk (rhabdomyosarcoma, neuroblastoma)"
      ]
    },
    {
      "diseaseId": "fetal-alcohol-syndrome",
      "distinguishingFeatures": [
        "History of prenatal alcohol exposure",
        "Smooth philtrum, thin upper lip, short palpebral fissures",
        "Different cardiac defects pattern",
        "No genetic mutation"
      ]
    }
  ],
  "redFlags": [
    "Hypertrophic cardiomyopathy with outflow tract obstruction",
    "Development of JMML or other myeloproliferative disorder",
    "Chylothorax or severe lymphatic dysfunction in neonates",
    "Significant bleeding during surgical procedures",
    "Severe feeding difficulties with failure to thrive in infancy"
  ],
