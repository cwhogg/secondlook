  "diagnosticCriteria": {
    "formalCriteriaName": "PHP 1C Diagnostic Criteria",
    "criteria": [
      {
        "id": "resistance-to-parathyroid-hormone",
        "description": "Biochemical evidence of resistance to parathyroid hormone (elevated PTH with hypocalcemia and hyperphosphatemia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gsa-protein-activity-normal",
        "description": "Normal Gs alpha protein activity in erythrocyte membranes distinguishing type 1C from type 1A",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "albright-hereditary-osteodystrophy-phenotype",
        "description": "Presence of Albright hereditary osteodystrophy (AHO) phenotype including short stature, brachydactyly, and subcutaneous ossifications",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-molecular-mutations-in-gnas",
        "description": "Absence of GNAS mutations affecting Gs alpha activity (helps differentiate from PHP 1A)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biochemical PTH resistance with AHO phenotype and normal Gs alpha activity",
    "notes": "Molecular genetic testing is important to differentiate PHP 1C from PHP 1A and other subtypes."
  },
