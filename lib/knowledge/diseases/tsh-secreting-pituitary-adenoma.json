  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for TSH-secreting pituitary adenoma",
    "criteria": [
      {
        "id": "elevated-tsh",
        "description": "Inappropriately normal or elevated serum TSH levels despite elevated free thyroid hormones (FT3 and FT4)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pituitary-adenoma-imaging",
        "description": "Presence of pituitary adenoma on MRI or CT imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "suppressed-thyroid-peripheral-hormones",
        "description": "Lack of suppression of TSH after administration of exogenous thyroid hormone (TRH stimulation test or T3 suppression test)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alpha-subunit-elevation",
        "description": "Elevated serum alpha-subunit of glycoprotein hormones supporting diagnosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-hyperthyroidism",
        "description": "Signs and symptoms consistent with hyperthyroidism",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of inappropriately normal or elevated TSH with elevated free thyroid hormones plus pituitary adenoma on imaging",
    "notes": "Dynamic testing and biochemical evaluation are essential to differentiate from thyroid hormone resistance syndrome."
  },
