  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Hereditary Hypophosphatemic Rickets with Hypercalciuria",
    "criteria": [
      {
        "id": "hypophosphatemia",
        "description": "Persistent hypophosphatemia due to renal phosphate wasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypercalciuria",
        "description": "Elevated urinary calcium excretion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-1-25-oh-vitamin-d",
        "description": "Increased serum 1,25-dihydroxyvitamin D levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-rickets",
        "description": "Clinical and radiological evidence of rickets or osteomalacia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in SLC34A3 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypophosphatemia with renal phosphate wasting, hypercalciuria, elevated 1,25-dihydroxyvitamin D, and clinical/radiological evidence of rickets",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical and biochemical criteria are met."
  },
