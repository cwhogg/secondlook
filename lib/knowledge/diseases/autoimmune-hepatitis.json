  "keyFindings": {
    "laboratory": [
      "Elevated ALT and AST (often markedly elevated; hepatocellular pattern)",
      "Elevated IgG (polyclonal hypergammaglobulinemia)",
      "ANA positive (Type 1)",
      "SMA (anti-smooth muscle antibody) positive (Type 1)",
      "Anti-LKM1 (anti-liver kidney microsome type 1) positive (Type 2)",
      "Anti-SLA/LP (anti-soluble liver antigen/liver-pancreas) positive (most specific)",
      "Anti-LC1 (anti-liver cytosol type 1) positive (Type 2)",
      "Elevated bilirubin",
      "Negative viral hepatitis serologies (HAV, HBV, HCV, HEV)"
    ],
    "imaging": [
      "Liver ultrasound: hepatomegaly, heterogeneous parenchyma, signs of portal hypertension",
      "Transient elastography (FibroScan): elevated liver stiffness indicating fibrosis",
      "MRI/MRCP: to exclude PSC overlap"
    ],
    "genetic": [
      "HLA-DR3 (DRB1*0301) - earlier onset, more severe",
      "HLA-DR4 (DRB1*0401) - later onset, more treatment responsive",
      "HLA-DR7 association in Type 2 AIH"
    ],
    "other": [
      "Liver biopsy: interface hepatitis, plasma cell-rich portal infiltrate, hepatocyte rosetting, emperipolesis",
      "Liver biopsy: fibrosis staging (Metavir or Ishak scoring)"
    ]
  },
