  "diagnosticCriteria": {
    "formalCriteriaName": "Chanarin-Dorfman Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "ichthyosis",
        "description": "Congenital non-bullous ichthyosiform erythroderma or fine scaling ichthyosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lipid-vacuoles",
        "description": "Presence of lipid vacuoles in granulocytes (Jordan anomaly) on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the ABHD5 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepatic-involvement",
        "description": "Elevated liver enzymes or hepatomegaly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "myopathy",
        "description": "Clinical or electromyographic evidence of muscle weakness",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital ichthyosis, lipid vacuoles in granulocytes, and pathogenic ABHD5 mutation",
    "notes": "Diagnosis is confirmed by genetic testing; lipid vacuoles in granulocytes are a key supportive finding."
  },
