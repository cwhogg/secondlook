  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Oculodentodigital Dysplasia",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including thin nose with hypoplastic alae nasi and prominent columella",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "syndactyly",
        "description": "Syndactyly of the fourth and fifth fingers or toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-abnormalities",
        "description": "Microdontia, enamel hypoplasia, and delayed tooth eruption",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-features",
        "description": "Microphthalmia, glaucoma, or other ocular anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic GJA1 (connexin 43) mutation",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of at least two major clinical criteria plus genetic confirmation or three major clinical criteria if genetic testing is unavailable",
    "notes": "Genetic testing for GJA1 mutations is considered confirmatory; clinical variability exists even within families."
  },
