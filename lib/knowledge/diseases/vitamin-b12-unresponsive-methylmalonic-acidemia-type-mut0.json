  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Methylmalonic Acidemia",
    "criteria": [
      {
        "id": "elevated-methylmalonic-acid",
        "description": "Markedly elevated methylmalonic acid levels in plasma and urine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mut0-enzyme-activity",
        "description": "Absent or near-absent methylmalonyl-CoA mutase enzyme activity in fibroblasts or liver tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Biallelic pathogenic mutations in the MUT gene consistent with mut0 phenotype",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vitamin-b12-unresponsiveness",
        "description": "Lack of biochemical or clinical response to vitamin B12 supplementation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-presentation",
        "description": "Early onset metabolic decompensation with lethargy, vomiting, and failure to thrive",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated methylmalonic acid, absent mutase enzyme activity, and biallelic MUT gene mutations",
    "notes": "Vitamin B12-unresponsiveness distinguishes mut0 from mut- forms of methylmalonic acidemia."
  },
