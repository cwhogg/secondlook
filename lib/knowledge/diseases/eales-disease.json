  "keyFindings": {
    "laboratory": [
      "Elevated erythrocyte sedimentation rate (ESR) in some cases",
      "Positive Mantoux test or tuberculin sensitivity in some patients",
      "Exclusion of infectious agents (e.g., syphilis, tuberculosis) by serology"
    ],
    "imaging": [
      "Fluorescein angiography showing peripheral retinal capillary non-perfusion and leakage",
      "Optical coherence tomography (OCT) demonstrating macular edema",
      "Ultrasound B-scan showing vitreous hemorrhage"
    ],
    "genetic": [
      "No confirmed genetic markers identified",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Clinical exclusion of other systemic vasculitides and infectious etiologies"
    ]
  },
