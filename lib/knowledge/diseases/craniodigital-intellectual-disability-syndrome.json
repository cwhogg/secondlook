  "diagnosticCriteria": {
    "formalCriteriaName": "Craniodigital Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including brachycephaly and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digital-anomalies",
        "description": "Digital malformations such as brachydactyly, clinodactyly, or syndactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability confirmed by neuropsychological assessment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Generalized hypotonia in infancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: craniofacial dysmorphism, digital anomalies, and intellectual disability",
    "notes": "Diagnosis is clinical; genetic testing may assist but no specific gene identified."
  },
