  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Tetraamelia-Multiple Malformations Syndrome",
    "criteria": [
      {
        "id": "tetraamelia",
        "description": "Complete absence of all four limbs (tetraamelia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-malformations",
        "description": "Presence of craniofacial anomalies such as cleft lip and palate or micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "organ-malformations",
        "description": "Multiple internal organ malformations including cardiac and renal anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Intrauterine growth retardation or postnatal growth deficiency",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in WNT3 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of tetraamelia plus at least two major malformations (craniofacial and/or organ malformations)",
    "notes": "Genetic testing for WNT3 mutations supports diagnosis but is not mandatory."
  },
