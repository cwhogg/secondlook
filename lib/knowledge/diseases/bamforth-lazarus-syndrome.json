        "description": "Presence of cleft palate or other midline craniofacial defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "laryngeal-agenesis",
        "description": "Congenital absence or malformation of the larynx",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the FOXE1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital hypothyroidism with thyroid dysgenesis and cleft palate",
