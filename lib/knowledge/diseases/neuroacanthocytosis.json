  "diagnosticCriteria": {
    "formalCriteriaName": "Neuroacanthocytosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "acanthocytosis",
        "description": "Presence of acanthocytes (spiky red blood cells) on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "movement-disorder",
        "description": "Progressive chorea or other hyperkinetic movement disorders",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "Basal ganglia atrophy or signal abnormalities on MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Pathogenic mutations in VPS13A (Chorea-acanthocytosis) or XK gene (McLeod syndrome)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuropsychiatric-symptoms",
        "description": "Presence of neuropsychiatric symptoms such as cognitive decline or psychiatric disturbances",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acanthocytosis, progressive movement disorder, and pathogenic mutation in relevant gene or characteristic neuroimaging findings",
    "notes": "Diagnosis is supported by clinical presentation, blood smear findings, neuroimaging, and genetic testing."
  },
