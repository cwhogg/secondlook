  "keyFindings": {
    "laboratory": [
      "Marked deficiency of hexosaminidase A enzyme activity in leukocytes or fibroblasts",
      "Elevated GM2 ganglioside levels in tissues"
    ],
    "imaging": [
      "MRI showing cerebral atrophy and delayed myelination",
      "CT scan may show increased density in basal ganglia"
    ],
    "genetic": [
      "Pathogenic mutations in HEXA gene on chromosome 15",
      "Carrier testing available for at-risk populations",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Cherry-red spot on fundoscopy",
      "Electroencephalogram (EEG) abnormalities consistent with seizures"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sandhoff-disease",
      "distinguishingFeatures": [
        "Deficiency of both hexosaminidase A and B enzymes",
        "Similar clinical presentation but broader enzyme deficiency"
      ]
    },
    {
      "diseaseId": "gm1-gangliosidosis",
      "distinguishingFeatures": [
        "Deficiency of beta-galactosidase enzyme",
        "Presence of hepatosplenomegaly more common",
        "Different genetic mutation (GLB1 gene)"
      ]
    }
  ],
