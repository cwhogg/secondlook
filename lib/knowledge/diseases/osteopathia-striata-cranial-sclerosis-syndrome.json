  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "No specific biochemical markers identified"
    ],
    "imaging": [
      "X-ray showing longitudinal striations in long bones",
      "CT scan demonstrating diffuse cranial sclerosis",
      "MRI may show cranial nerve compression"
    ],
    "genetic": [
      "AMER1 (causative)",
      "CTNNB1 (causative, gain-of-function)",
      "X-linked dominant inheritance"
    ],
    "other": [
      "Family history consistent with X-linked dominant inheritance pattern"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "osteopetrosis",
      "distinguishingFeatures": [
        "Generalized increased bone density without longitudinal striations",
        "More severe hematological complications",
        "Different genetic mutations (e.g., CLCN7, TCIRG1)"
      ]
    },
    {
      "diseaseId": "melorheostosis",
      "distinguishingFeatures": [
        "Irregular, flowing hyperostosis on radiographs rather than linear striations",
        "Usually unilateral and segmental bone involvement",
        "No cranial sclerosis"
      ]
    }
  ],
  "redFlags": [
    "Progressive cranial nerve deficits",
    "Severe conductive hearing loss",
    "Signs of increased intracranial pressure such as hydrocephalus"
  ],
  "specialistType": [
