  "keyFindings": {
    "laboratory": [
      "No specific laboratory test; diagnosis is clinical",
      "Elevated ESR and CRP during flares",
      "Positive pathergy test (40-60% in endemic regions, lower in Western populations)",
      "HLA-B51 positive (not diagnostic but supportive)",
      "Elevated immunoglobulins",
      "Neutrophilia during flares"
    ],
    "imaging": [
      "MRI brain: brainstem/diencephalic lesions in neuro-Behcet",
      "CT angiography: pulmonary artery aneurysms, arterial/venous thrombosis",
      "MR venography: cerebral venous sinus thrombosis",
      "Fundoscopy/fluorescein angiography: retinal vasculitis, macular edema"
    ],
    "genetic": [
      "HLA-B*51 (strongest genetic association; OR ~6)",
      "IL-10, IL-23R, IL-12RB2 gene variants",
      "ERAP1 gene variants"
    ],
    "other": [
      "Pathergy test: intradermal needle prick with reading at 24-48 hours",
      "Skin biopsy: neutrophilic vascular reaction",
      "GI endoscopy: deep round ulcers in ileocecal region"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "inflammatory-bowel-disease-crohn",
      "distinguishingFeatures": [
        "Transmural inflammation",
