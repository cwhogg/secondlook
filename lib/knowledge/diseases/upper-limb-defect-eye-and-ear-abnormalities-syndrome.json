  "diagnosticCriteria": {
    "formalCriteriaName": "No formal diagnostic criteria established",
    "criteria": [
      {
        "id": "upper-limb-malformations",
        "description": "Presence of congenital upper limb malformations including hypoplasia or aplasia of digits or forearm bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "Congenital ocular abnormalities such as microphthalmia, coloboma, or cataracts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ear-malformations",
        "description": "External ear anomalies including microtia or anotia, often associated with hearing impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural or conductive hearing loss confirmed by audiological testing",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Mild facial dysmorphic features such as low-set ears or micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: congenital upper limb malformations, ocular abnormalities, and ear malformations",
    "notes": "Diagnosis is clinical and supported by imaging and audiological evaluation; genetic testing may assist but no specific gene identified"
  },
