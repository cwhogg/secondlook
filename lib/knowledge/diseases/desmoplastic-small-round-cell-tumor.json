  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological and Molecular Diagnostic Criteria for DSRCT",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of nests of small round blue tumor cells surrounded by abundant desmoplastic stroma on histology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Co-expression of epithelial (cytokeratin), mesenchymal (vimentin), and neural (desmin) markers on immunohistochemistry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "molecular-genetics",
        "description": "Detection of EWSR1-WT1 gene fusion by RT-PCR or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presentation with multiple peritoneal masses without a clear primary visceral origin",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of small round blue cells with desmoplastic stroma plus immunohistochemical co-expression of epithelial, mesenchymal, and neural markers, and molecular confirmation of EWSR1-WT1 fusion.",
    "notes": "Molecular genetic testing is critical to differentiate from other small round cell tumors."
  },
