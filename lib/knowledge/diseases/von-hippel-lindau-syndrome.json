  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Criteria for VHL Syndrome",
    "criteria": [
      {
        "id": "vhl-c1",
        "description": "CNS hemangioblastoma (cerebellar, spinal, or brainstem)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "vhl-c2",
        "description": "Retinal hemangioblastoma (retinal angioma)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "vhl-c3",
        "description": "Clear cell renal cell carcinoma (often bilateral or multifocal)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "vhl-c4",
        "description": "Pheochromocytoma or paraganglioma",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "vhl-c5",
        "description": "Pancreatic neuroendocrine tumor or multiple pancreatic cysts",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "vhl-c6",
        "description": "Endolymphatic sac tumor",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "vhl-c7",
        "description": "Broad ligament / epididymal cystadenomas",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "vhl-c8",
        "description": "Pathogenic VHL gene mutation",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "With family history: one VHL-associated tumor (hemangioblastoma, RCC, pheochromocytoma). Without family history: two or more hemangioblastomas, or one hemangioblastoma plus a visceral tumor. OR: pathogenic VHL germline mutation.",
    "notes": "Classified into Type 1 (low pheo risk; deletions/truncating mutations) and Type 2 (high pheo risk; missense mutations). Type 2 further divided into 2A (low RCC risk), 2B (high RCC risk), and 2C (pheo only). ~20% de novo."
  },
