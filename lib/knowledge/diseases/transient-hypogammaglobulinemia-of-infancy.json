  "keyFindings": {
    "laboratory": [
      "Low serum IgG levels below age-specific norms",
      "Normal or mildly reduced IgA and IgM levels",
      "Normal T-cell counts and function",
      "Normal vaccine antibody responses in some cases"
    ],
    "imaging": [
      "Chest X-ray may show signs of recurrent pneumonia or bronchitis",
      "Sinus imaging may reveal sinusitis"
    ],
    "genetic": [
      "TWIST2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Resolution of hypogammaglobulinemia typically by 24-36 months of age"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "x-linked-agammaglobulinemia",
      "distinguishingFeatures": [
        "Markedly reduced or absent B cells",
        "Persistent hypogammaglobulinemia without spontaneous resolution",
        "Severe infections early in infancy"
      ]
    },
    {
      "diseaseId": "common-variable-immunodeficiency",
      "distinguishingFeatures": [
        "Onset usually after infancy",
        "Persistent hypogammaglobulinemia with low IgA and/or IgM",
        "Increased risk of autoimmune disease and malignancy"
      ]
    }
  ],
  "redFlags": [
    "Severe or unusual infections (e.g., sepsis, meningitis)",
    "Failure to improve immunoglobulin levels after 36 months",
    "Absence of B cells on immunophenotyping"
  ],
