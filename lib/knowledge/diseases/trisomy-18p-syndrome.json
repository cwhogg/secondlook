  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible hypothyroidism on thyroid panel"
    ],
    "imaging": [
      "Brain MRI may show nonspecific cerebral atrophy or delayed myelination",
      "Echocardiography revealing congenital heart defects",
      "Skeletal X-rays showing clinodactyly or other anomalies"
    ],
    "genetic": [
      "Karyotype or chromosomal microarray demonstrating trisomy of chromosome 18p"
    ],
    "other": [
      "Developmental assessments confirming intellectual disability",
      "Audiological evaluation for hearing impairment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "trisomy-18-edwards-syndrome",
      "distinguishingFeatures": [
        "Full trisomy 18 involving entire chromosome 18",
        "More severe congenital anomalies including rocker-bottom feet",
        "Higher neonatal mortality"
      ]
    },
    {
      "diseaseId": "18p-deletion-syndrome",
      "distinguishingFeatures": [
        "Deletion of short arm of chromosome 18 rather than trisomy",
        "Distinct facial features and milder intellectual disability",
        "Different pattern of congenital anomalies"
      ]
    }
  ],
