  "keyFindings": {
    "laboratory": [
      "Elevated direct (conjugated) bilirubin",
      "Increased serum bile acids",
      "Elevated liver transaminases (ALT, AST)",
      "Prolonged prothrombin time",
      "Hypoglycemia",
      "Elevated serum ammonia"
    ],
    "imaging": [
      "Ultrasound showing hepatomegaly and fatty infiltration",
      "Absence of biliary obstruction"
    ],
    "genetic": [
      "SLC25A13 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Liver biopsy showing intrahepatic cholestasis and fatty changes (optional)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "biliary-atresia",
      "distinguishingFeatures": [
        "Obstructive cholestasis with absent or abnormal bile ducts on imaging",
        "No SLC25A13 mutations",
        "Requires surgical intervention (Kasai procedure)"
      ]
    },
    {
      "diseaseId": "alpha-1-antitrypsin-deficiency",
      "distinguishingFeatures": [
        "Low serum alpha-1-antitrypsin levels",
        "PiZZ genotype confirmation",
        "Different pattern of liver injury"
      ]
    },
    {
      "diseaseId": "progressive familial intrahepatic cholestasis",
      "distinguishingFeatures": [
        "Early onset cholestasis with different genetic mutations (e.g., ATP8B1, ABCB11)",
        "Progressive liver disease without metabolic abnormalities seen in NICCD"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive liver failure",
    "Severe hypoglycemia refractory to treatment",
    "Signs of hepatic encephalopathy"
  ],
