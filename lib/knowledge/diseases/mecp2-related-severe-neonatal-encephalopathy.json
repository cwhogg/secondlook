  "diagnosticCriteria": {
    "formalCriteriaName": "MECP2-related Severe Neonatal Encephalopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic or likely pathogenic variant in MECP2 gene identified by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset-encephalopathy",
        "description": "Onset of severe encephalopathy within the neonatal period (first 28 days of life)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-manifestations",
        "description": "Presence of profound hypotonia, absent or severely reduced spontaneous movements, and impaired respiratory drive",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other metabolic, infectious, or structural causes of neonatal encephalopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic MECP2 variant plus clinical presentation of severe neonatal encephalopathy with hypotonia and respiratory impairment",
    "notes": "Diagnosis relies heavily on genetic confirmation combined with characteristic clinical features in the neonatal period."
  },
