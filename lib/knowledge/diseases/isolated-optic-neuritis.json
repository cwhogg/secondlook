  "diagnosticCriteria": {
    "formalCriteriaName": "Optic Neuritis Diagnostic Criteria",
    "criteria": [
      {
        "id": "acute-vision-loss",
        "description": "Acute unilateral vision loss developing over hours to days",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "optic-nerve-pain",
        "description": "Periocular pain exacerbated by eye movement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "optic-disc-swelling",
        "description": "Optic disc edema or normal appearing disc on fundoscopy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "visual-field-defects",
        "description": "Central scotoma or other visual field defects on testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "MRI-optic-nerve-lesion",
        "description": "MRI evidence of optic nerve inflammation without other CNS lesions",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acute unilateral vision loss with optic nerve pain and visual field defects, supported by MRI findings if available",
    "notes": "Diagnosis requires exclusion of other causes such as multiple sclerosis or neuromyelitis optica."
  },
