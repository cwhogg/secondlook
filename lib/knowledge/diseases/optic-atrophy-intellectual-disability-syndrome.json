  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of metabolic causes of optic atrophy"
    ],
    "imaging": [
      "MRI brain may show optic nerve thinning",
      "Possible cerebral or cerebellar atrophy"
    ],
    "genetic": [
      "NR2F1 (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electroretinogram (ERG) typically normal",
      "Visual evoked potentials (VEP) show delayed conduction"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "leber-hereditary-optic-neuropathy",
      "distinguishingFeatures": [
        "Typically acute or subacute onset in young adults",
        "Mitochondrial inheritance pattern",
        "Absence of intellectual disability"
      ]
    },
    {
      "diseaseId": "wolfram-syndrome",
      "distinguishingFeatures": [
        "Diabetes mellitus and diabetes insipidus present",
        "Progressive optic atrophy with hearing loss",
        "Distinct endocrine involvement"
      ]
    },
    {
      "diseaseId": "biallelic-opa1-related-optic-atrophy",
      "distinguishingFeatures": [
        "Progressive optic atrophy with variable neurological features",
        "Genetic testing confirms OPA1 mutations",
        "Usually no intellectual disability"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive vision loss",
    "Severe developmental regression",
    "Onset of seizures or status epilepticus"
  ],
