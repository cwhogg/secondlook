  "diagnosticCriteria": {
    "formalCriteriaName": "SLC39A8-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "biallelic-slc39a8-mutation",
        "description": "Presence of biallelic pathogenic variants in the SLC39A8 gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-serum-transferrin-glycosylation",
        "description": "Abnormal serum transferrin glycosylation pattern detected by isoelectric focusing or mass spectrometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features including developmental delay, hypotonia, and dystonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-serum-manganese",
        "description": "Low serum manganese levels supporting impaired metal ion transport",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "impaired-glycosylation-enzymes",
        "description": "Reduced activity of glycosylation enzymes in fibroblasts or leukocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biallelic pathogenic SLC39A8 variants plus abnormal transferrin glycosylation and compatible clinical features",
    "notes": "Genetic confirmation is essential; biochemical testing supports diagnosis."
  },
