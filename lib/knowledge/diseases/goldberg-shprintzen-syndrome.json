  "diagnosticCriteria": {
    "formalCriteriaName": "Goldberg-Shprintzen Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of intellectual disability ranging from mild to severe",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hirschsprung-disease",
        "description": "Diagnosis of Hirschsprung disease or congenital aganglionic megacolon",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive craniofacial features including microcephaly, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-features",
        "description": "Additional neurological abnormalities such as hypotonia or seizures",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the KIAA1279 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of intellectual disability, Hirschsprung disease, and characteristic facial dysmorphism",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if clinical criteria are met"
  },
