  "keyFindings": {
    "laboratory": [
      "Elevated plasma dopamine concentrations",
      "Undetectable or very low plasma norepinephrine and epinephrine levels",
      "Normal or mildly elevated plasma DOPAC (3,4-dihydroxyphenylacetic acid)"
    ],
    "imaging": [
      "Normal brain MRI",
      "No structural abnormalities typically observed"
    ],
    "genetic": [
      "DBH (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Marked improvement of orthostatic hypotension with L-threo-3,4-dihydroxyphenylserine (L-DOPS) treatment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pure-autonomic-failure",
      "distinguishingFeatures": [
        "Normal or mildly reduced plasma norepinephrine levels",
        "Later onset, typically in middle to late adulthood",
        "Absence of congenital ptosis"
      ]
    },
    {
      "diseaseId": "familial-dysautonomia",
      "distinguishingFeatures": [
        "Presence of sensory neuropathy",
        "Characteristic facial features and developmental delay",
        "Genetic testing for IKBKAP mutations"
      ]
    },
    {
      "diseaseId": "multiple-system-atrophy",
      "distinguishingFeatures": [
        "Progressive neurodegeneration with parkinsonism or cerebellar signs",
        "Older age of onset",
        "MRI showing pontine and cerebellar atrophy"
      ]
    }
  ],
