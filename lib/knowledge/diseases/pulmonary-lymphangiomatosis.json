  "keyFindings": {
    "laboratory": [
      "Elevated triglycerides in pleural fluid consistent with chylothorax",
      "Lymphocyte-predominant pleural effusion"
    ],
    "imaging": [
      "High-resolution CT showing diffuse interstitial thickening, cystic changes, and pleural effusions",
      "Lymphangiography demonstrating abnormal lymphatic proliferation"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology showing proliferation of thin-walled lymphatic vessels within lung interstitium"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "lymphangioleiomyomatosis",
      "distinguishingFeatures": [
        "Presence of smooth muscle proliferation",
        "Predominantly affects women of childbearing age",
        "Positive HMB-45 immunostaining"
      ]
    },
    {
      "diseaseId": "pulmonary-lymphangiectasia",
      "distinguishingFeatures": [
        "Congenital dilation of lymphatic vessels rather than proliferation",
        "Usually presents in infancy",
        "Lack of progressive lymphatic proliferation"
      ]
    }
  ],
