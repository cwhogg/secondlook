  "diagnosticCriteria": {
    "formalCriteriaName": "Brown-Vialetto-Van Laere Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "progressive-pontobulbar-palsy",
        "description": "Progressive weakness and paralysis of cranial nerves affecting bulbar muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-deafness",
        "description": "Bilateral sensorineural hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "riboflavin-transporter-mutation",
        "description": "Identification of pathogenic mutations in SLC52A2 or SLC52A3 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-riboflavin",
        "description": "Clinical improvement or stabilization with high-dose riboflavin therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive pontobulbar palsy and sensorineural deafness with confirmed pathogenic mutation in riboflavin transporter genes",
    "notes": "Genetic testing is essential for definitive diagnosis; early riboflavin treatment improves prognosis."
  },
