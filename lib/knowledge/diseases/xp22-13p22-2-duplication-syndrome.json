  "diagnosticCriteria": {
    "formalCriteriaName": "Xp22.13p22.2 Duplication Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of duplication involving Xp22.13 to p22.2 region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Presence of global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Characteristic craniofacial dysmorphic features including hypertelorism and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital heart defects such as atrial septal defect",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of Xp22.13p22.2 duplication plus at least two major clinical features including developmental delay and characteristic dysmorphic features",
    "notes": "Diagnosis relies heavily on molecular genetic testing due to phenotypic variability."
  },
