    "laboratory": [
      "Normal routine blood tests",
      "Possible mild hypothyroidism on thyroid function tests"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter abnormalities",
      "Echocardiogram for congenital heart defects"
    ],
    "genetic": [
      "Microduplication of chromosome 7q11.23 detected by chromosomal microarray or FISH"
    ],
    "other": [
      "Neurodevelopmental assessment showing intellectual disability and speech delay"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "williams-syndrome",
      "distinguishingFeatures": [
        "7q11.23 microdeletion instead of duplication",
        "Distinctive elfin facial features",
        "Supravalvular aortic stenosis"
      ]
    },
    {
      "diseaseId": "autism-spectrum-disorder",
      "distinguishingFeatures": [
        "Lack of chromosomal microduplication",
        "More variable cognitive impairment",
        "Behavioral features without consistent dysmorphic features"
      ]
    }
  ],
