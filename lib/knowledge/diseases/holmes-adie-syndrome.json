  "diagnosticCriteria": {
    "formalCriteriaName": "Holmes-Adie Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "tonic-pupil",
        "description": "Presence of a unilateral or bilateral tonic pupil with poor or absent light reflex and slow, tonic constriction to near stimulus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-deep-tendon-reflexes",
        "description": "Absent or diminished deep tendon reflexes, especially Achilles tendon reflexes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "segmental-pupil-constriction",
        "description": "Segmental iris sphincter palsy demonstrated by slit-lamp examination",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "postganglionic-pupil-denervation",
        "description": "Pharmacological testing showing denervation supersensitivity of the pupil to dilute pilocarpine",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of tonic pupil with absent or diminished deep tendon reflexes",
    "notes": "Diagnosis is clinical supported by pharmacological testing and exclusion of other causes"
  },
