  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Creatine kinase may be mildly elevated in some cases"
    ],
    "imaging": [
      "X-rays showing joint contractures and dislocations",
      "Ultrasound or MRI demonstrating muscle hypoplasia or fibrosis",
      "Prenatal ultrasound may show decreased fetal movement"
    ],
    "genetic": [
      "Mutations in genes such as MYH3, TPM2, and others depending on subtype",
      "Genetic testing useful for subclassification and counseling"
    ],
    "other": [
      "Electromyography showing decreased muscle activity",
      "Muscle biopsy revealing fibrosis and fatty replacement"
    ]
  },
