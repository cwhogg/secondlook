  "keyFindings": {
    "laboratory": [
      "Elevated methylmalonic acid in plasma and urine",
      "Metabolic acidosis with increased anion gap",
      "Hyperammonemia during metabolic crises",
      "Normal serum vitamin B12 levels",
      "Elevated propionylcarnitine (C3) on acylcarnitine profile"
    ],
    "imaging": [
      "Brain MRI may show basal ganglia lesions or stroke-like changes",
      "Renal ultrasound may reveal chronic kidney changes"
    ],
    "genetic": [
      "MMUT (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Lack of biochemical or clinical response to vitamin B12 supplementation",
      "Reduced or absent methylmalonyl-CoA mutase enzyme activity in cultured fibroblasts"
    ]
  },
