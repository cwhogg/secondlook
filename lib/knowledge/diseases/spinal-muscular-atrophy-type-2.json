  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Elevated creatine kinase (mild to moderate elevation)"
    ],
    "imaging": [
      "Spinal X-rays showing scoliosis",
      "Muscle MRI showing selective muscle atrophy"
    ],
    "genetic": [
      "Homozygous deletion or mutation of SMN1 gene on chromosome 5q13"
    ],
    "other": [
      "Electromyography showing denervation and chronic reinnervation",
      "Muscle biopsy showing grouped atrophy of anterior horn cells"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-myopathies",
      "distinguishingFeatures": [
        "Muscle biopsy showing structural abnormalities",
        "Normal SMN1 gene testing"
      ]
    },
    {
      "diseaseId": "congenital-muscular-dystrophies",
      "distinguishingFeatures": [
        "Elevated creatine kinase often higher",
        "Muscle biopsy showing dystrophic changes",
        "Absence of SMN1 mutation"
      ]
    },
    {
      "diseaseId": "juvenile-onset amyotrophic lateral sclerosis",
      "distinguishingFeatures": [
        "Progressive upper and lower motor neuron signs",
        "Later onset than SMA type 2",
        "No SMN1 mutation"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive respiratory failure",
    "Loss of bulbar function (dysphagia, aspiration)",
    "Severe scoliosis causing restrictive lung disease"
  ],
