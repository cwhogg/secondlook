  "diagnosticCriteria": {
    "formalCriteriaName": "2023 ACR/EULAR Classification Criteria for Antiphospholipid Syndrome",
    "criteria": [
      {
        "id": "aps-1",
        "description": "At least one positive aPL test (lupus anticoagulant, anticardiolipin IgG/IgM, anti-beta2-glycoprotein I IgG/IgM) on two or more occasions at least 12 weeks apart",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aps-2",
        "description": "Venous thromboembolism (DVT, PE, or other venous thrombosis)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aps-3",
        "description": "Arterial thrombosis (stroke, MI, peripheral arterial thrombosis)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aps-4",
        "description": "Pregnancy morbidity: unexplained fetal death >= 10 weeks gestation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aps-5",
        "description": "Pregnancy morbidity: premature birth < 34 weeks due to eclampsia, preeclampsia, or placental insufficiency",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aps-6",
        "description": "Pregnancy morbidity: >= 3 consecutive unexplained miscarriages < 10 weeks gestation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aps-7",
        "description": "Microvascular involvement (livedo racemosa, nephropathy, cardiac valve disease)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "aps-8",
        "description": "Thrombocytopenia (platelet count 20,000-130,000/mm3)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Positive aPL entry criterion (score >= 3) plus at least one clinical domain with score >= 3; total combined score >= 7",
    "notes": "The 2023 criteria use a weighted scoring system. aPL positivity must be confirmed on two occasions at least 12 weeks apart. Catastrophic APS (CAPS) is a severe variant with multi-organ thrombosis."
  },
