  "keyFindings": {
    "laboratory": [
      "Pancytopenia on complete blood count",
      "Elevated fetal hemoglobin (HbF)",
      "Increased chromosomal breakage with diepoxybutane or mitomycin C"
    ],
    "imaging": [
      "Skeletal radiographs showing radial ray defects",
      "Renal ultrasound abnormalities",
      "Echocardiography for cardiac malformations"
    ],
    "genetic": [
      "Biallelic pathogenic variants in any of the FA genes (e.g., FANCA, FANCC, FANCG)",
      "Genetic testing confirms diagnosis and subtype"
    ],
    "other": [
      "Bone marrow biopsy showing hypocellularity",
      "Physical examination revealing congenital anomalies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dyskeratosis-congenita",
      "distinguishingFeatures": [
        "Mucocutaneous triad (nail dystrophy, leukoplakia, reticular pigmentation)",
        "Telomere shortening",
        "Pulmonary fibrosis"
      ]
    },
    {
      "diseaseId": "shwachman-diamond-syndrome",
      "distinguishingFeatures": [
        "Exocrine pancreatic insufficiency",
        "Neutropenia predominant",
        "Skeletal abnormalities less severe"
      ]
    }
  ],
  "redFlags": [
    "Progressive pancytopenia in a child with congenital anomalies",
