  "keyFindings": {
    "laboratory": [
      "Lymphopenia with decreased T and B lymphocytes",
      "Elevated serum IgM with low IgG and IgA",
      "Increased chromosomal breakage in lymphocytes"
    ],
    "imaging": [
      "Normal brain MRI or mild cerebellar atrophy in some cases",
      "Chest imaging showing recurrent infections or bronchiectasis"
    ],
    "genetic": [
      "RNF168 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Fibroblast radiosensitivity assay demonstrating increased cellular sensitivity to ionizing radiation"
    ]
  },
