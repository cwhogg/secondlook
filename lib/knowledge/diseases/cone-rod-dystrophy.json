  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Fundus autofluorescence showing macular atrophy and peripheral pigmentary changes",
      "Optical coherence tomography (OCT) revealing photoreceptor layer thinning",
      "Fluorescein angiography demonstrating retinal pigment epithelium abnormalities"
    ],
    "genetic": [
      "Pathogenic variants in genes such as ABCA4, CRX, GUCY2D, and RPGR",
      "Autosomal dominant, autosomal recessive, and X-linked inheritance patterns"
    ],
    "other": [
      "Electroretinography (ERG) showing reduced cone responses followed by rod responses",
      "Visual field testing demonstrating central scotomas progressing to peripheral constriction"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "retinitis-pigmentosa",
      "distinguishingFeatures": [
