        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in nuclear genes affecting oxidative phosphorylation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Brain MRI showing basal ganglia or brainstem abnormalities consistent with mitochondrial disease",
