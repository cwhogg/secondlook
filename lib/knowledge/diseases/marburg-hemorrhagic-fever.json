    "laboratory": [
      "Thrombocytopenia",
      "Leukopenia followed by leukocytosis",
      "Elevated liver enzymes (AST, ALT)",
      "Prolonged prothrombin time and activated partial thromboplastin time",
      "Detection of viral RNA by RT-PCR"
    ],
    "imaging": [
      "Chest radiograph may show pulmonary infiltrates or edema in advanced cases"
    ],
    "genetic": [],
    "other": [
      "Isolation of Marburg virus from blood or tissue samples",
      "Seroconversion detected by ELISA"
    ]
  },
