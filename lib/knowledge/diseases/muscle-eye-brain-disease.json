  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Muscle-Eye-Brain Disease",
    "criteria": [
      {
        "id": "muscle-weakness",
        "description": "Congenital hypotonia and progressive muscle weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-abnormalities",
        "description": "Congenital eye abnormalities including severe myopia, retinal dysplasia, and optic nerve hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-malformations",
        "description": "Structural brain abnormalities such as cobblestone lissencephaly and cerebellar hypoplasia on neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the POMGNT1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-creatine-kinase",
        "description": "Mild to moderate elevation of serum creatine kinase levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital muscle weakness, characteristic ocular abnormalities, and brain malformations on imaging",
    "notes": "Genetic testing for POMGNT1 mutations supports diagnosis but is not mandatory if clinical and imaging criteria are met."
  },
