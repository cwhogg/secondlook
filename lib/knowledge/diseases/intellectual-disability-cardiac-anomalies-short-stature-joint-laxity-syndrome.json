  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild elevation of serum creatine kinase in some cases"
    ],
    "imaging": [
      "Echocardiography showing septal defects or valvular abnormalities",
      "Skeletal X-rays revealing scoliosis or joint laxity features",
      "Brain MRI usually normal or nonspecific"
    ],
    "genetic": [
      "PUF60 (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Clinical assessment of joint hypermobility using Beighton score",
      "Neuropsychological testing confirming intellectual disability"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "loeys-dietz-syndrome",
      "distinguishingFeatures": [
        "More severe vascular involvement including arterial aneurysms",
        "Characteristic craniofacial features such as hypertelorism",
        "Presence of TGFBR1 or TGFBR2 mutations"
      ]
    },
    {
      "diseaseId": "ehlers-danlos-syndrome-hypermobility-type",
      "distinguishingFeatures": [
        "Absence of intellectual disability",
        "Predominantly musculoskeletal and skin involvement",
        "Lack of congenital cardiac septal defects"
      ]
    }
  ],
  "redFlags": [
    "Severe congenital heart defects requiring early surgical intervention",
    "Progressive aortic root dilation",
    "Rapidly worsening developmental delay or regression"
  ],
  "specialistType": [
    "Clinical geneticist",
    "Cardiologist",
    "Neurologist",
    "Pediatrician",
    "Orthopedist"
  ],
