  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for X-linked centronuclear myopathy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early onset hypotonia and generalized muscle weakness predominantly in males",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Muscle biopsy showing centrally located nuclei in the majority of muscle fibers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Pathogenic mutation in the MTM1 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Electromyographic evidence of myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early onset hypotonia and muscle weakness with muscle biopsy showing central nuclei plus confirmation of MTM1 mutation",
    "notes": "Muscle biopsy and genetic testing are essential for definitive diagnosis."
  },
