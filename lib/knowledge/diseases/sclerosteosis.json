  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Sclerosteosis",
    "criteria": [
      {
        "id": "progressive-bone-overgrowth",
        "description": "Progressive generalized cortical bone overgrowth primarily affecting the skull and long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "syndactyly",
        "description": "Syndactyly of fingers or toes, typically involving the second and third digits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-nerve-palsy",
        "description": "Recurrent or progressive facial nerve palsy due to cranial nerve entrapment",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiographic-skull-thickening",
        "description": "Radiographic evidence of skull bone thickening and sclerosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of loss-of-function mutations in the SOST gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive bone overgrowth with syndactyly plus radiographic skull thickening; genetic confirmation supportive but not mandatory",
    "notes": "Diagnosis is primarily clinical and radiological; genetic testing can confirm but is not always available."
  },
