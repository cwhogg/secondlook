  "diagnosticCriteria": {
    "formalCriteriaName": "Tubulinopathy Dysgyria Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in tubulin genes (e.g., TUBA1A, TUBB2B, TUBB3) by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging-dysgyria",
        "description": "MRI evidence of cortical dysgyria characterized by abnormal cortical folding and gyral pattern consistent with tubulinopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-neurological-features",
        "description": "Presence of early-onset developmental delay and motor impairment including spasticity and hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic tubulin gene mutation plus characteristic neuroimaging findings of dysgyria",
    "notes": "Diagnosis relies heavily on genetic testing combined with MRI findings; clinical features support but are not diagnostic alone."
  },
