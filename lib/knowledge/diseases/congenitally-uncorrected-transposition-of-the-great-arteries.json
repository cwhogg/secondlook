  "differentialDiagnoses": [
    {
      "diseaseId": "corrected-transposition-of-the-great-arteries",
      "distinguishingFeatures": [
        "Physiologic correction with atrioventricular and ventriculoarterial discordance but preserved circulation",
        "Often asymptomatic in early life",
        "Different surgical management"
      ]
    },
    {
      "diseaseId": "d-transposition-of-the-great-arteries",
      "distinguishingFeatures": [
        "Aorta arises from right ventricle and pulmonary artery from left ventricle without ventricular inversion",
        "Usually presents with severe cyanosis in neonates",
        "Requires early surgical intervention"
      ]
    }
  ],
