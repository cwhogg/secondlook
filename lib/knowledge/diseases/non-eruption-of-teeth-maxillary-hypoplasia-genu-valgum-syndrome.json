  "diagnosticCriteria": {
    "formalCriteriaName": "Non-eruption of Teeth-Maxillary Hypoplasia-Genu Valgum Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "non-eruption-teeth",
        "description": "Complete or near-complete failure of eruption of permanent teeth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "maxillary-hypoplasia",
        "description": "Underdevelopment of the maxillary bones leading to midface hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genu-valgum",
        "description": "Bilateral genu valgum deformity (knock knees)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-findings",
        "description": "Radiographic evidence of unerupted teeth with normal tooth morphology",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history suggestive of autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: non-eruption of teeth, maxillary hypoplasia, and genu valgum",
    "notes": "Diagnosis is primarily clinical supported by radiographic imaging and family history"
  },
