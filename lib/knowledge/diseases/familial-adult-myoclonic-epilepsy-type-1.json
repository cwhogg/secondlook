  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Familial Adult Myoclonic Epilepsy",
    "criteria": [
      {
        "id": "family-history",
        "description": "Presence of autosomal dominant family history of adult-onset cortical myoclonus and seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Adult onset of cortical myoclonus with or without generalized tonic-clonic seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electroencephalogram (EEG) showing cortical reflex myoclonus and epileptiform discharges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pentanucleotide repeat expansions in the SAMD12 gene or other related loci",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of autosomal dominant family history plus adult-onset cortical myoclonus and EEG evidence of cortical reflex myoclonus",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory; clinical and electrophysiological features are essential."
  },
  "symptoms": {
