  "diagnosticCriteria": {
    "formalCriteriaName": "SCA Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the CACNA1G gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-ataxias",
        "description": "Exclusion of other spinocerebellar ataxias and acquired causes",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia plus genetic confirmation of CACNA1G mutation and exclusion of other causes",
    "notes": "Genetic testing is essential for definitive diagnosis."
  },
