  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Laboratory Diagnostic Criteria for Thyrotoxic Periodic Paralysis",
    "criteria": [
      {
        "id": "thyrotoxicosis",
        "description": "Clinical and biochemical evidence of thyrotoxicosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypokalemia",
        "description": "Serum potassium level below 3.5 mmol/L during paralytic attack",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "episodic-muscle-weakness",
        "description": "Recurrent episodes of sudden onset flaccid muscle weakness or paralysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrocardiographic-changes",
        "description": "ECG abnormalities consistent with hypokalemia such as U waves or flattened T waves",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of familial periodic paralysis and other neuromuscular disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of thyrotoxicosis, hypokalemia during attack, and episodic muscle weakness",
    "notes": "Diagnosis is clinical supported by laboratory findings; genetic testing may be considered to exclude familial periodic paralysis."
  },
