  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild elevation of creatine kinase due to hypotonia"
    ],
    "imaging": [
      "Brain MRI may show nonspecific cerebral atrophy or delayed myelination",
      "Skeletal X-rays may reveal scoliosis"
    ],
    "genetic": [
      "Microduplication of distal Xq28 region detected by chromosomal microarray or FISH",
      "Involvement of genes such as MECP2 and IRAK1",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Electroencephalogram abnormalities consistent with epilepsy",
      "Developmental assessments confirming intellectual disability"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "rett-syndrome",
      "distinguishingFeatures": [
        "Regression of acquired skills after normal early development",
        "Characteristic hand-wringing movements",
        "Predominantly affects females"
      ]
    },
    {
      "diseaseId": "fragile-x-syndrome",
      "distinguishingFeatures": [
        "Macroorchidism in post-pubertal males",
        "Distinctive behavioral phenotype including social anxiety",
        "FMR1 gene mutation"
      ]
    }
  ],
