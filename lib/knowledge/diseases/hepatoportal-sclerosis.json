  "keyFindings": {
    "laboratory": [
      "Thrombocytopenia and leukopenia due to hypersplenism",
      "Normal or mildly elevated liver enzymes",
      "Preserved synthetic liver function (normal albumin and coagulation profile)"
    ],
    "imaging": [
      "Doppler ultrasound showing portal vein irregularities and absence of thrombosis",
      "CT or MRI demonstrating periportal fibrosis and portal hypertension signs",
      "Endoscopy revealing esophageal varices"
    ],
    "genetic": [
      "No specific genetic mutations identified; idiopathic etiology"
    ],
    "other": [
      "Liver biopsy showing obliterative portal venopathy with periportal fibrosis without cirrhosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cirrhosis",
      "distinguishingFeatures": [
        "Presence of nodular liver architecture on biopsy",
        "Elevated liver enzymes and impaired synthetic function",
        "History of chronic liver disease or risk factors"
      ]
    },
    {
      "diseaseId": "schistosomiasis",
      "distinguishingFeatures": [
        "Eosinophilia and history of exposure in endemic areas",
        "Characteristic granulomas and eggs on liver biopsy",
        "Positive serologic or stool tests for Schistosoma species"
      ]
    },
    {
      "diseaseId": "portal-vein-thrombosis",
      "distinguishingFeatures": [
        "Imaging evidence of portal vein thrombosis",
        "Acute abdominal pain and signs of ischemia",
        "Underlying prothrombotic conditions"
      ]
    }
  ],
  "redFlags": [
    "Acute gastrointestinal hemorrhage from variceal bleeding",
    "Rapid onset of hepatic encephalopathy",
    "Signs of portal vein thrombosis or infarction"
  ],
