  "differentialDiagnoses": [
    {
      "diseaseId": "primary-biliary-cholangitis",
      "distinguishingFeatures": [
        "Absence of systemic sclerosis features",
        "Liver-specific autoimmune markers without skin involvement"
      ]
    },
    {
      "diseaseId": "systemic-sclerosis",
      "distinguishingFeatures": [
        "Lack of primary biliary cholangitis serology and liver involvement",
        "Predominant skin and vascular manifestations"
      ]
    },
    {
      "diseaseId": "mixed-connective-tissue-disease",
      "distinguishingFeatures": [
        "Presence of anti-U1 RNP antibodies",
        "Overlap features including lupus and polymyositis not typical in Reynolds syndrome"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of skin thickening",
    "Development of pulmonary arterial hypertension",
