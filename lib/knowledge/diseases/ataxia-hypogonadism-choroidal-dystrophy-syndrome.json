  "diagnosticCriteria": {
    "formalCriteriaName": "Boucher-Neuhäuser syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "ataxia",
        "description": "Progressive cerebellar ataxia presenting with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogonadism",
        "description": "Hypogonadotropic hypogonadism with delayed or absent puberty",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "choroidal-dystrophy",
        "description": "Bilateral choroidal dystrophy evidenced by ophthalmological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in PNPLA6 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cerebellar-atrophy-imaging",
        "description": "MRI evidence of cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: progressive cerebellar ataxia, hypogonadotropic hypogonadism, and choroidal dystrophy",
    "notes": "Genetic testing for PNPLA6 mutations supports diagnosis but is not mandatory"
  },
