  "keyFindings": {
    "laboratory": [
      "Positive enzyme-linked immunoelectrotransfer blot (EITB) assay for Taenia solium antibodies",
      "CSF eosinophilia and elevated protein in neurocysticercosis",
      "Serum and CSF antigen detection tests"
    ],
    "imaging": [
      "CT or MRI showing cystic lesions with or without scolex",
      "Ventricular enlargement or hydrocephalus",
      "Calcified granulomas in chronic disease"
    ],
    "genetic": [],
    "other": [
      "Histopathological confirmation by biopsy of subcutaneous or muscular nodules",
      "Epidemiological link to endemic areas or exposure to undercooked pork"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "tuberculous-meningitis",
      "distinguishingFeatures": [
        "CSF findings with lymphocytic predominance and acid-fast bacilli",
        "Lack of cystic lesions with scolex on imaging",
        "Positive tuberculin skin test or interferon-gamma release assay"
      ]
    },
    {
      "diseaseId": "brain-tumors",
      "distinguishingFeatures": [
        "Mass lesions without cystic structure or scolex",
        "Progressive neurological deficits without infectious signs",
        "Histopathology confirming neoplasm"
      ]
    },
    {
      "diseaseId": "toxoplasmosis",
      "distinguishingFeatures": [
        "Multiple ring-enhancing lesions in immunocompromised patients",
        "Positive Toxoplasma serology",
        "Response to anti-toxoplasma therapy"
      ]
    }
  ],
