    "laboratory": [
      "Elevated serum triglycerides and cholesterol",
      "Mild elevation of liver transaminases (AST, ALT)",
      "Thrombocytopenia in rare cases"
    ],
    "imaging": [
      "MRI or CT may show signs of increased intracranial pressure in pseudotumor cerebri"
    ],
    "genetic": [
      "Autosomal recessive inheritance",
      "X-linked recessive inheritance"
    ],
