  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for SADDAN Syndrome",
    "criteria": [
      {
        "id": "achondroplasia-phenotype",
        "description": "Severe short-limbed dwarfism consistent with achondroplasia phenotype",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay including motor and cognitive impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acanthosis-nigricans",
        "description": "Presence of acanthosis nigricans skin lesions, especially in flexural areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fgfr3-mutation",
        "description": "Pathogenic FGFR3 gene mutation (commonly p.Lys650Met)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-findings",
        "description": "Characteristic skeletal radiographic abnormalities including narrowed foramen magnum",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe achondroplasia phenotype, developmental delay, acanthosis nigricans, and confirmed FGFR3 pathogenic mutation",
    "notes": "Molecular genetic testing is essential for definitive diagnosis."
  },
