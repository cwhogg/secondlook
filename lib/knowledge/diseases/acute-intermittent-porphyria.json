  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and biochemical criteria for acute porphyrias",
    "criteria": [
      {
        "id": "aip-c1",
        "description": "Markedly elevated urinary porphobilinogen (PBG) during acute attack (>10x upper limit of normal)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aip-c2",
        "description": "Elevated urinary aminolevulinic acid (ALA)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aip-c3",
        "description": "Reduced erythrocyte hydroxymethylbilane synthase (HMBS) activity (~50% of normal)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aip-c4",
        "description": "Pathogenic variant identified in HMBS gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aip-c5",
        "description": "Characteristic neurovisceral symptoms (abdominal pain, neuropathy, psychiatric manifestations)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "aip-c6",
        "description": "Dark or reddish-brown urine that darkens on standing",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "aip-c7",
        "description": "Normal fecal porphyrins (distinguishes from variegate porphyria and hereditary coproporphyria)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated urinary PBG during symptomatic episode, confirmed by HMBS enzyme assay or HMBS genetic testing",
    "notes": "Up to 90% of individuals with HMBS mutations remain clinically latent. Attacks are typically provoked by drugs, hormones, fasting, or stress."
  },
