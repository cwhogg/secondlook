  "diagnosticCriteria": {
    "formalCriteriaName": "Autoimmune Orchitis Diagnostic Criteria",
    "criteria": [
      {
        "id": "testicular-pain-swelling",
        "description": "Persistent testicular pain and swelling lasting more than 2 weeks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoantibodies-detection",
        "description": "Presence of anti-sperm or anti-testicular antibodies in serum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathologic-confirmation",
        "description": "Testicular biopsy showing lymphocytic infiltration and granulomatous inflammation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-infectious-causes",
        "description": "Exclusion of infectious orchitis by negative microbiological studies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-findings",
        "description": "Ultrasound evidence of heterogeneous testicular echotexture and increased vascularity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met for diagnosis",
    "notes": "Diagnosis requires exclusion of infectious and neoplastic causes"
  },
