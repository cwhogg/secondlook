  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for SBBYS syndrome",
    "criteria": [
      {
        "id": "blepharophimosis",
        "description": "Presence of blepharophimosis characterized by narrowed horizontal palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability confirmed by neuropsychological assessment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital heart defects such as atrial or ventricular septal defects",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia with delayed motor milestones",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of blepharophimosis and intellectual disability plus at least one additional supportive or minor criterion",
    "notes": "Genetic testing for mutations in the PHF6 gene can confirm diagnosis"
  },
