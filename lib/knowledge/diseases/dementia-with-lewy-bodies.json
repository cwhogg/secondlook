  "diagnosticCriteria": {
    "formalCriteriaName": "Fourth Consensus Report of the DLB Consortium",
    "criteria": [
      {
        "id": "cognitive-fluctuations",
        "description": "Recurrent fluctuations in attention and alertness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "visual-hallucinations",
        "description": "Recurrent well-formed visual hallucinations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "parkinsonism",
        "description": "Spontaneous parkinsonian motor features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "REM-sleep-behavior-disorder",
        "description": "REM sleep behavior disorder",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "severe-neuroleptic-sensitivity",
        "description": "Severe sensitivity to antipsychotic agents",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Dementia plus two or more core clinical features (cognitive fluctuations, visual hallucinations, parkinsonism) or one core feature with one or more suggestive features",
    "notes": "Diagnosis requires exclusion of other causes of dementia and parkinsonism."
  },
