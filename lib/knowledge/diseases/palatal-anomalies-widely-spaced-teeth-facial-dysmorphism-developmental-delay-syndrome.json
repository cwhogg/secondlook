    "laboratory": [
      "Normal routine blood tests",
      "No specific biochemical markers identified"
    ],
    "imaging": [
      "Craniofacial CT or MRI showing palatal anomalies",
      "Brain MRI may show nonspecific delayed myelination"
    ],
    "genetic": [
      "KDM1A (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Developmental assessments confirming delay",
      "Audiological evaluation for recurrent otitis media"
    ]
  },
