        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-anomalies",
        "description": "Presence of congenital heart defects such as ventricular septal defect or cardiomyopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-malformations",
        "description": "Structural or functional renal abnormalities including renal hypoplasia or nephropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: characteristic facial dysmorphism, cardiac anomalies, and renal malformations",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
