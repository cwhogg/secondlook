  "diagnosticCriteria": {
    "formalCriteriaName": "DES Exposure Diagnostic Criteria",
    "criteria": [
      {
        "id": "in-utero-exposure",
        "description": "Documented maternal exposure to diethylstilbestrol during pregnancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vaginal-cervical-abnormalities",
        "description": "Presence of vaginal adenosis, cervical hypoplasia, or structural anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "reproductive-complications",
        "description": "History of infertility, ectopic pregnancy, or spontaneous abortion",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "clear-cell-adenocarcinoma",
        "description": "Diagnosis of clear cell adenocarcinoma of the vagina or cervix",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Documented in utero DES exposure plus at least one major clinical feature",
    "notes": "Diagnosis is primarily clinical and based on exposure history combined with characteristic reproductive tract abnormalities."
  },
