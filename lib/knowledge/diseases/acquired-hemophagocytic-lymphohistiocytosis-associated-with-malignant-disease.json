  "diagnosticCriteria": {
    "formalCriteriaName": "HLH-2004 Diagnostic Criteria (adapted for acquired HLH)",
    "criteria": [
      {
        "id": "fever",
        "description": "Persistent high-grade fever (>38.5°C) lasting more than 7 days",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cytopenias",
        "description": "Bicytopenia or pancytopenia affecting at least two lineages in peripheral blood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemophagocytosis",
        "description": "Demonstration of hemophagocytosis in bone marrow, spleen, or lymph nodes without evidence of malignancy infiltration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyperferritinemia",
        "description": "Elevated serum ferritin levels >500 µg/L",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypertriglyceridemia",
        "description": "Fasting triglycerides >265 mg/dL (3 mmol/L) or hypofibrinogenemia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "lowNKcellActivity",
        "description": "Decreased or absent natural killer (NK) cell cytotoxicity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "At least 3 major criteria including hemophagocytosis plus clinical context of malignancy",
    "notes": "Diagnosis requires exclusion of primary HLH and other mimicking conditions; clinical judgment essential."
  },
