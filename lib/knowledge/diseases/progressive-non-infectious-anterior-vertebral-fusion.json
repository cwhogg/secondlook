  "keyFindings": {
    "laboratory": [
      "Normal inflammatory markers (ESR, CRP)",
      "Negative blood cultures and infectious serologies"
    ],
    "imaging": [
      "Progressive anterior vertebral body fusion on spinal X-ray and MRI",
      "Absence of vertebral osteomyelitis or discitis",
      "No evidence of neoplastic lesions"
    ],
    "genetic": [
      "No known specific genetic mutations identified"
    ],
    "other": [
      "Exclusion of infectious, neoplastic, and inflammatory causes by clinical and laboratory evaluation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ankylosing-spondylitis",
      "distinguishingFeatures": [
        "Presence of HLA-B27 positivity",
        "Sacroiliac joint involvement",
        "Elevated inflammatory markers"
      ]
    },
    {
      "diseaseId": "vertebral-osteomyelitis",
      "distinguishingFeatures": [
        "Positive infectious markers",
        "Fever and systemic signs of infection",
        "MRI showing disc space involvement and abscess formation"
      ]
    },
    {
      "diseaseId": "diffuse idiopathic skeletal hyperostosis",
      "distinguishingFeatures": [
        "Flowing ossification along anterolateral vertebral bodies",
        "Preserved intervertebral disc height",
        "Older age of onset"
      ]
    }
  ],
