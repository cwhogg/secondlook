  "differentialDiagnoses": [
    {
      "diseaseId": "erythema-nodosum",
      "distinguishingFeatures": [
        "Predominantly septal panniculitis on biopsy",
        "Usually associated with systemic diseases or infections",
        "Tender nodules primarily on anterior shins"
      ]
    },
    {
      "diseaseId": "suppurative-panniculitis",
      "distinguishingFeatures": [
        "Presence of neutrophilic abscesses and suppuration on biopsy",
        "Often associated with bacterial infections",
        "May show systemic signs of infection"
      ]
    },
    {
      "diseaseId": "lupus-panniculitis",
      "distinguishingFeatures": [
        "Associated with lupus erythematosus features",
        "Interface dermatitis and lymphocytic infiltrate on biopsy",
        "Positive autoimmune serologies"
      ]
    }
  ],
