    "formalCriteriaName": "Clinical Diagnostic Criteria for Distal Arthrogryposis Type 1",
    "criteria": [
      {
        "id": "congenital-contractures",
        "description": "Presence of congenital contractures predominantly affecting distal joints (hands and feet)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "camptodactyly",
        "description": "Camptodactyly (permanent flexion contracture) of fingers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clubfoot",
        "description": "Bilateral clubfoot (talipes equinovarus)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital distal joint contractures including camptodactyly and clubfoot, with or without positive family history",
    "notes": "Diagnosis is primarily clinical; genetic testing can support but is not always definitive."
  },
