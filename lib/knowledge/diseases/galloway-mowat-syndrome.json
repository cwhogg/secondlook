  "keyFindings": {
    "laboratory": [
      "Proteinuria and hypoalbuminemia consistent with nephrotic syndrome",
      "Elevated serum creatinine in progressive renal failure"
    ],
    "imaging": [
      "Brain MRI showing cerebral atrophy, pachygyria, or lissencephaly",
      "Renal ultrasound may show normal or hyperechoic kidneys"
    ],
    "genetic": [
      "Pathogenic variants in WDR73 gene",
      "Other implicated genes include OSGEP, TP53RK, TPRKB"
    ],
    "other": [
      "Renal biopsy showing focal segmental glomerulosclerosis or diffuse mesangial sclerosis"
    ]
  },
