  "diagnosticCriteria": {
    "formalCriteriaName": "Revised Diagnostic Criteria for Vogt-Koyanagi-Harada Disease",
    "criteria": [
      {
        "id": "bilateral-granulomatous-uveitis",
        "description": "Bilateral granulomatous panuveitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-auditory-manifestations",
        "description": "Neurological and/or auditory symptoms such as meningismus, tinnitus, or dysacusis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "integumentary-manifestations",
        "description": "Integumentary signs including vitiligo, alopecia, or poliosis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of uveitis and systemic symptoms",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Bilateral granulomatous uveitis plus exclusion of other causes, with or without neurological/auditory or integumentary manifestations",
    "notes": "Diagnosis is clinical and supported by imaging and laboratory findings; early recognition is critical to prevent vision loss."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Bilateral granulomatous panuveitis",
        "frequency": 0.95,
        "bodySystem": "ophthalmological",
        "notes": "Characteristic inflammation of the uveal tract in both eyes"
      },
      {
        "symptomName": "Serous retinal detachment",
        "frequency": 0.85,
        "bodySystem": "ophthalmological",
        "notes": "Exudative retinal detachment due to choroidal inflammation"
      },
      {
        "symptomName": "Poliosis (whitening of eyelashes or eyebrows)",
        "frequency": 0.75,
        "bodySystem": "dermatological",
        "notes": "Depigmentation of hair associated with chronic disease phase"
      }
    ],
    "common": [
      {
        "symptomName": "Tinnitus",
        "frequency": 0.65,
        "bodySystem": "neurological",
        "notes": "Ringing or buzzing in the ears"
      },
      {
        "symptomName": "Headache",
        "frequency": 0.6,
        "bodySystem": "neurological",
        "notes": "Often associated with meningeal irritation"
      },
      {
        "symptomName": "Vitiligo",
        "frequency": 0.55,
        "bodySystem": "dermatological",
        "notes": "Patchy depigmentation of the skin"
      },
      {
        "symptomName": "Neck stiffness (meningismus)",
        "frequency": 0.58,
        "bodySystem": "neurological",
        "notes": "Indicative of aseptic meningitis"
      },
      {
        "symptomName": "Alopecia",
        "frequency": 0.5,
        "bodySystem": "dermatological",
        "notes": "Hair loss occurring in chronic phase"
      }
    ],
    "occasional": [
      {
        "symptomName": "Dysacusis (hearing loss)",
        "frequency": 0.4,
        "bodySystem": "neurological",
        "notes": "Sensorineural hearing impairment"
      },
      {
        "symptomName": "Photophobia",
        "frequency": 0.35,
        "bodySystem": "ophthalmological",
        "notes": "Light sensitivity due to ocular inflammation"
      },
      {
        "symptomName": "Fever",
        "frequency": 0.3,
        "bodySystem": "constitutional",
        "notes": "Low-grade fever during acute phase"
      },
      {
        "symptomName": "Eye pain",
        "frequency": 0.25,
        "bodySystem": "ophthalmological",
        "notes": "Associated with uveitis"
      },
      {
        "symptomName": "Nausea",
        "frequency": 0.2,
        "bodySystem": "gastrointestinal",
        "notes": "May accompany meningeal symptoms"
      }
    ],
    "rare": [
      {
        "symptomName": "Cerebrospinal fluid pleocytosis",
        "frequency": 0.08,
        "bodySystem": "neurological",
        "notes": "Elevated white cells in CSF indicating aseptic meningitis"
      },
      {
        "symptomName": "Optic disc edema",
        "frequency": 0.07,
        "bodySystem": "ophthalmological",
        "notes": "Swelling of the optic nerve head"
      },
      {
        "symptomName": "Peripheral neuropathy",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Rare involvement of peripheral nerves"
      },
      {
        "symptomName": "Arthralgia",
        "frequency": 0.04,
        "bodySystem": "musculoskeletal",
        "notes": "Joint pain without arthritis"
      }
    ]
  },
  "systemsAffected": [
    "ophthalmological",
    "neurological",
    "dermatological",
    "constitutional",
    "gastrointestinal",
    "musculoskeletal"
  ],
  "keyFindings": {
    "laboratory": [
      "Elevated cerebrospinal fluid lymphocytes (pleocytosis)",
      "Elevated inflammatory markers (ESR, CRP) during acute phase",
      "Negative infectious and other autoimmune serologies"
    ],
    "imaging": [
      "Fluorescein angiography showing multiple pinpoint leaks",
      "Optical coherence tomography (OCT) demonstrating serous retinal detachments",
      "MRI brain may show meningeal enhancement"
    ],
    "genetic": [
      "Association with HLA-DR4 and HLA-DQ4 alleles"
    ],
    "other": [
      "Audiometry may reveal sensorineural hearing loss",
      "Skin biopsy showing melanocyte loss in depigmented areas"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sympathetic-ophthalmia",
      "distinguishingFeatures": [
        "History of ocular trauma or surgery",
        "Unilateral onset progressing to fellow eye",
        "Absence of systemic neurological or integumentary symptoms"
      ]
    },
    {
      "diseaseId": "sarcoidosis",
      "distinguishingFeatures": [
        "Noncaseating granulomas on biopsy",
        "Pulmonary involvement with hilar lymphadenopathy",
        "Serum ACE elevation"
      ]
    },
    {
      "diseaseId": "multiple-sclerosis",
      "distinguishingFeatures": [
        "Demyelinating lesions on MRI",
        "Optic neuritis without granulomatous uveitis",
        "Predominantly neurological symptoms without integumentary signs"
      ]
    }
  ],
  "redFlags": [
    "Rapid bilateral vision loss",
    "Signs of meningeal irritation (neck stiffness, severe headache)",
    "Sensorineural hearing loss progressing rapidly"
  ],
  "specialistType": [
    "Ophthalmologist",
    "Neurologist",
    "Rheumatologist",
    "Dermatologist"
  ],
