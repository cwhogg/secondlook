  "diagnosticCriteria": {
    "formalCriteriaName": "Primary Hyperoxaluria Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the GRHPR gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-oxalate-elevation",
        "description": "Elevated urinary oxalate excretion above age-adjusted reference ranges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-activity-deficiency",
        "description": "Demonstration of deficient glyoxylate reductase/hydroxypyruvate reductase enzyme activity in liver biopsy or fibroblasts",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nephrolithiasis-history",
        "description": "History of recurrent calcium oxalate nephrolithiasis or nephrocalcinosis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic GRHPR variants plus elevated urinary oxalate excretion",
    "notes": "Enzyme activity testing and clinical history support diagnosis but are not mandatory if genetic confirmation is present."
  },
