  "diagnosticCriteria": {
    "formalCriteriaName": "MPAN Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive extrapyramidal symptoms including dystonia, parkinsonism, and spasticity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-iron-accumulation",
        "description": "MRI evidence of iron accumulation predominantly in the globus pallidus and substantia nigra",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the C19orf12 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "optic-atrophy",
        "description": "Presence of optic nerve atrophy on ophthalmological examination",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cognitive-decline",
        "description": "Progressive cognitive impairment and neuropsychiatric symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive extrapyramidal symptoms, MRI evidence of brain iron accumulation, and genetic confirmation of C19orf12 mutations",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical and radiological features guide initial suspicion."
  },
