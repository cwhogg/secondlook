  "diagnosticCriteria": {
    "formalCriteriaName": "Donath-Landsteiner Test Diagnostic Criteria",
    "criteria": [
      {
        "id": "dl-test-positive",
        "description": "Positive Donath-Landsteiner test demonstrating biphasic hemolysin activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemoglobinuria",
        "description": "Presence of hemoglobinuria following cold exposure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "complement-mediated-hemolysis",
        "description": "Evidence of complement-mediated intravascular hemolysis (elevated LDH, low haptoglobin, elevated indirect bilirubin)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cold-exposure-trigger",
        "description": "History of hemolytic episodes triggered by cold exposure",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "anemia",
        "description": "Presence of anemia with reticulocytosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Positive Donath-Landsteiner test plus evidence of hemoglobinuria and complement-mediated hemolysis",
    "notes": "Diagnosis relies heavily on the Donath-Landsteiner test; false negatives can occur if testing conditions are not optimal."
  },
