        "requiredForDiagnosis": false
      },
      {
        "id": "normal-brain-imaging",
        "description": "Normal structural brain MRI excluding other neurodegenerative causes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical myoclonus, family history, electrophysiological evidence) must be met",
    "notes": "Genetic testing may assist but causative genes are not fully elucidated"
