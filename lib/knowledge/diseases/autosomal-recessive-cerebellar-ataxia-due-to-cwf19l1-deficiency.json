  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for CWF19L1-Related Autosomal Recessive Cerebellar Ataxia",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Presence of progressive cerebellar ataxia with gait disturbance and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the CWF19L1 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-atrophy-imaging",
        "description": "MRI evidence of cerebellar atrophy predominantly affecting the vermis and hemispheres",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Early onset developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-causes",
        "description": "Exclusion of other causes of cerebellar ataxia such as acquired or metabolic etiologies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive cerebellar ataxia with MRI cerebellar atrophy plus biallelic pathogenic variants in CWF19L1",
    "notes": "Diagnosis relies heavily on genetic confirmation due to phenotypic overlap with other hereditary ataxias."
  },
