  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and radiological diagnosis of hemangioblastoma",
    "criteria": [
      {
        "id": "imaging-characteristic",
        "description": "Presence of a well-circumscribed, contrast-enhancing cystic or solid mass on MRI or CT, typically in the cerebellum or spinal cord",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology-confirmation",
        "description": "Histological confirmation showing stromal cells with abundant capillaries and vacuolated cytoplasm",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "retinal-hemangioblastoma",
        "description": "Identification of retinal hemangioblastomas on ophthalmologic examination, especially in von Hippel-Lindau disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Radiological evidence of characteristic lesion plus histopathological confirmation",
    "notes": "Genetic testing for VHL mutations may support diagnosis in familial cases"
  },
