  "diagnosticCriteria": {
    "formalCriteriaName": "Non-specific Early-Onset Epileptic Encephalopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "early-onset-seizures",
        "description": "Onset of epileptic seizures within the first 24 months of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-regression",
        "description": "Developmental delay or regression following seizure onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroencephalogram-abnormalities",
        "description": "EEG showing epileptiform activity consistent with encephalopathy but lacking specific syndrome patterns",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-specific-etiologies",
        "description": "Exclusion of known genetic or metabolic causes of epileptic encephalopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset seizures, developmental delay/regression, and characteristic EEG abnormalities with exclusion of specific etiologies",
    "notes": "Diagnosis is clinical and supported by EEG; genetic testing often negative or non-diagnostic."
  },
