  "diagnosticCriteria": {
    "formalCriteriaName": "FHHNC Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypomagnesemia",
        "description": "Persistent hypomagnesemia with renal magnesium wasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypercalciuria",
        "description": "Elevated urinary calcium excretion (hypercalciuria)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nephrocalcinosis",
        "description": "Bilateral nephrocalcinosis detected by renal ultrasound or CT",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in CLDN16 or CLDN19 genes",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent hypomagnesemia, hypercalciuria, and nephrocalcinosis",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical criteria are met."
  },
