  "diagnosticCriteria": {
    "formalCriteriaName": "Norman-Roberts Lissencephaly Diagnostic Criteria",
    "criteria": [
      {
        "id": "lissencephaly",
        "description": "Presence of classical lissencephaly characterized by smooth cerebral cortex with agyria or pachygyria on neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-hypoplasia",
        "description": "Hypoplasia of the cerebellum identified by MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microcephaly",
        "description": "Congenital microcephaly with head circumference below the 3rd percentile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Severe global developmental delay and intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "Early-onset epileptic seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of classical lissencephaly with cerebellar hypoplasia and microcephaly confirmed by neuroimaging and clinical assessment",
    "notes": "Genetic confirmation of RELN gene mutation supports diagnosis"
  },
