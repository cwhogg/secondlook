    "formalCriteriaName": "Diagnostic Criteria for X-linked Intellectual Disability-Hypogammaglobulinemia-Progressive Neurological Deterioration Syndrome",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of moderate to severe intellectual disability with developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogammaglobulinemia",
        "description": "Documented hypogammaglobulinemia with decreased serum immunoglobulin levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-neurological-deterioration",
        "description": "Progressive neurological decline including motor dysfunction and cognitive regression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "X-linked pattern of inheritance or affected male relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variant in associated gene (e.g., MSN gene mutations)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: intellectual disability, hypogammaglobulinemia, and progressive neurological deterioration",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if clinical criteria are met"
  },
