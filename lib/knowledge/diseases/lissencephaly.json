  "diagnosticCriteria": {
    "formalCriteriaName": "Radiologic and Clinical Diagnostic Criteria for Lissencephaly",
    "criteria": [
      {
        "id": "imaging-smooth-brain",
        "description": "Presence of a smooth cerebral cortex with absent or reduced gyri and sulci on brain MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Severe global developmental delay evident in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "Early onset refractory epilepsy or infantile spasms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with neuronal migration (e.g., LIS1, DCX)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic brain MRI findings plus severe developmental delay and seizures",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical and imaging criteria are met."
  },
