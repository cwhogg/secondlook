        "requiredForDiagnosis": true
      },
      {
        "id": "postural-instability",
        "description": "Early postural instability with unexplained falls within the first year of symptom onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-support",
        "description": "Midbrain atrophy ('hummingbird sign') on MRI supportive but not mandatory",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-alzheimer-pathology",
        "description": "Lack of significant Alzheimer-type pathology on biomarkers or autopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive vertical supranuclear gaze palsy, progressive non-fluent aphasia, and early postural instability with falls",
    "notes": "Diagnosis is clinical and supported by neuroimaging; exclusion of other neurodegenerative diseases is essential."
