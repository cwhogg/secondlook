  "diagnosticCriteria": {
    "formalCriteriaName": "Vici Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "agenesis-corpus-callosum",
        "description": "Complete or partial agenesis of the corpus callosum confirmed by neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Combined immunodeficiency with hypogammaglobulinemia and recurrent infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiomyopathy",
        "description": "Hypertrophic or dilated cardiomyopathy confirmed by echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypopigmentation",
        "description": "Cutaneous hypopigmentation or oculocutaneous albinism-like features",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Severe global developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: agenesis of the corpus callosum, combined immunodeficiency, and cardiomyopathy",
    "notes": "Genetic confirmation of EPG5 mutations supports diagnosis but is not mandatory"
  },
