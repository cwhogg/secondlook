  "diagnosticCriteria": {
    "formalCriteriaName": "PRUNE1-related neurological syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the PRUNE1 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "global-developmental-delay",
        "description": "Severe global developmental delay or intellectual disability presenting in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-spasticity",
        "description": "Progressive spasticity and axial hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-atrophy",
        "description": "Neuroimaging evidence of cerebellar atrophy or hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "Presence of early-onset seizures or epileptic encephalopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic PRUNE1 variants plus at least two major clinical features including severe developmental delay and progressive spasticity",
    "notes": "Diagnosis is confirmed by genetic testing; clinical features support diagnosis and guide management."
  },
