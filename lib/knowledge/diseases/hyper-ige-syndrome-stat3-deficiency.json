  "keyFindings": {
    "laboratory": [
      "Markedly elevated serum IgE levels (>2000 IU/mL)",
      "Eosinophilia",
      "Impaired Th17 cell differentiation"
    ],
    "imaging": [
      "Chest X-ray or CT showing pneumatoceles and bronchiectasis",
      "Skeletal X-rays demonstrating scoliosis and fractures"
    ],
    "genetic": [
      "STAT3 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Delayed exfoliation of primary teeth",
      "Characteristic facial features including prominent forehead, broad nasal bridge, and deep-set eyes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "wiskott-aldrich-syndrome",
      "distinguishingFeatures": [
        "Thrombocytopenia with small platelets",
        "Eczema with recurrent infections but low IgE levels",
        "X-linked inheritance pattern"
      ]
    },
    {
      "diseaseId": "chronic-mucocutaneous-candidiasis",
      "distinguishingFeatures": [
        "Predominant mucocutaneous Candida infections",
        "Normal or mildly elevated IgE",
        "Lack of skeletal abnormalities"
      ]
    },
    {
      "diseaseId": "autosomal-recessive-hyper-ige-syndrome",
      "distinguishingFeatures": [
        "Mutations in DOCK8 or TYK2 genes",
        "Severe viral infections",
        "Different immunologic profile and inheritance"
      ]
    }
  ],
  "redFlags": [
    "Recurrent staphylococcal abscesses without significant inflammation",
    "Pneumatoceles or bronchiectasis on chest imaging",
    "Markedly elevated serum IgE (>2000 IU/mL) with eczema"
  ],
