  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria; diagnosis based on clinical, immunological, and genetic findings",
    "criteria": [
      {
        "id": "biallelic-lig4-mutations",
        "description": "Presence of biallelic pathogenic variants in the LIG4 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Combined immunodeficiency with low T and B lymphocyte counts and hypogammaglobulinemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microcephaly-growth-retardation",
        "description": "Congenital microcephaly and growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiosensitivity",
        "description": "Cellular radiosensitivity demonstrated by increased chromosomal breakage or sensitivity to ionizing radiation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "bone-marrow-failure",
        "description": "Evidence of bone marrow failure or cytopenias",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biallelic pathogenic LIG4 mutations plus clinical immunodeficiency and microcephaly/growth retardation",
    "notes": "Diagnosis is confirmed by genetic testing; radiosensitivity testing supports diagnosis."
  },
