  "differentialDiagnoses": [
    {
      "diseaseId": "chronic-inflammatory-demyelinating-polyradiculoneuropathy",
      "distinguishingFeatures": [
        "Chronic progressive or relapsing course rather than acute",
        "Less frequent respiratory involvement",
        "Longer duration of symptoms (>8 weeks)"
      ]
    },
    {
      "diseaseId": "acute-motor-axonal-neuropathy",
      "distinguishingFeatures": [
        "Predominantly motor involvement without sensory symptoms",
        "Axonal rather than demyelinating features on nerve conduction studies",
        "More common in certain geographic regions (e.g., Asia)"
      ]
    }
  ],
  "redFlags": [
