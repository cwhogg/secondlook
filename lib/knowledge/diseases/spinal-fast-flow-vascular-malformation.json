  "diagnosticCriteria": {
    "formalCriteriaName": "Spinal Fast-Flow Vascular Malformation Diagnostic Criteria",
    "criteria": [
      {
        "id": "imaging-confirmation",
        "description": "Demonstration of fast-flow vascular malformation on spinal angiography or MRI with flow voids",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-neurological-signs",
        "description": "Presence of progressive myelopathy symptoms such as motor weakness or sensory deficits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-causes",
        "description": "Exclusion of other spinal cord pathologies such as tumors or infections",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of imaging confirmation of fast-flow vascular malformation plus clinical neurological signs consistent with spinal cord involvement",
    "notes": "Diagnosis relies heavily on imaging and clinical correlation; biopsy is rarely indicated."
  },
