  "diagnosticCriteria": {
    "formalCriteriaName": "No formal diagnostic criteria established",
    "criteria": [
      {
        "id": "enzyme-activity-deficiency",
        "description": "Demonstration of markedly reduced or absent pancreatic triacylglycerol lipase activity in duodenal fluid or pancreatic secretions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-steatorrhea",
        "description": "Presence of chronic steatorrhea unresponsive to pancreatic enzyme replacement therapy containing lipase",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the PNLIP gene encoding pancreatic triacylglycerol lipase",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-malabsorption",
        "description": "Exclusion of other causes of fat malabsorption such as cystic fibrosis or chronic pancreatitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical steatorrhea with confirmed deficiency of pancreatic triacylglycerol lipase enzyme activity",
    "notes": "Genetic testing can support diagnosis but is not mandatory; diagnosis relies primarily on clinical presentation and enzyme assay."
  },
