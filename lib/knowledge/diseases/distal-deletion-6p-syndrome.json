  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Distal 6p Deletion Syndrome",
    "criteria": [
      {
        "id": "chromosomal-deletion",
        "description": "Confirmed terminal deletion involving the distal 6p region by chromosomal microarray or karyotyping",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial features including high forehead, hypertelorism, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defects",
        "description": "Structural congenital heart defects such as atrial or ventricular septal defects",
        "category": "common",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "common",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-anomalies",
        "description": "Ophthalmological abnormalities including anterior segment dysgenesis or optic nerve hypoplasia",
        "category": "common",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed distal 6p chromosomal deletion plus at least two major clinical features including craniofacial dysmorphism and congenital anomalies",
    "notes": "Diagnosis relies on genetic confirmation combined with characteristic clinical presentation."
  },
