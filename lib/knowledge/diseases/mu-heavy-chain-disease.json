  "keyFindings": {
    "laboratory": [
      "Monoclonal truncated mu-heavy chains in serum and urine detected by immunofixation electrophoresis",
      "Anemia and cytopenias on complete blood count",
      "Elevated ESR and inflammatory markers"
    ],
    "imaging": [
      "Lymphadenopathy and hepatosplenomegaly on ultrasound or CT scan",
      "Bone marrow biopsy showing lymphoplasmacytic infiltration"
    ],
    "genetic": [
      "No specific genetic mutation identified; clonal B-cell proliferation"
    ],
    "other": [
      "Exclusion of other heavy chain diseases and plasma cell dyscrasias is essential"
    ]
  },
  "differentialDiagnoses": [
