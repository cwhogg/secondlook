  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Pfeiffer Syndrome Type 1",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of coronal and/or other cranial sutures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "broad-thumb",
        "description": "Broad and medially deviated thumbs and great toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midface-hypoplasia",
        "description": "Midface hypoplasia with midfacial retrusion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-lifespan",
        "description": "Normal life expectancy in absence of complications",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis plus broad thumbs and/or great toes with midface hypoplasia",
    "notes": "Genetic testing for FGFR2 mutations can confirm diagnosis but is not mandatory."
  },
