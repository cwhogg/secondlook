  "diagnosticCriteria": {
    "formalCriteriaName": "Fanconi-Bickel Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "hepatomegaly",
        "description": "Presence of hepatomegaly due to glycogen accumulation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-tubular-dysfunction",
        "description": "Evidence of proximal renal tubular dysfunction (Fanconi syndrome)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-glucose-transport",
        "description": "Defective glucose and galactose transport due to GLUT2 (SLC2A2) gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypophosphatemic-rickets",
        "description": "Clinical or radiological evidence of rickets secondary to phosphate wasting",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in SLC2A2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of hepatomegaly, renal tubular dysfunction, and either genetic confirmation or impaired glucose transport",
    "notes": "Diagnosis is supported by clinical, biochemical, and genetic findings; genetic testing is confirmatory."
  },
