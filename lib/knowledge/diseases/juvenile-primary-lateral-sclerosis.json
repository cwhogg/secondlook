  "diagnosticCriteria": {
    "formalCriteriaName": "Juvenile Primary Lateral Sclerosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "progressive-spasticity",
        "description": "Progressive spasticity and weakness predominantly affecting the upper motor neurons",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-lower-motor-neuron-signs",
        "description": "Absence of lower motor neuron signs such as muscle atrophy or fasciculations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "onset-before-20",
        "description": "Symptom onset before 20 years of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-nerve-conduction",
        "description": "Normal nerve conduction studies excluding peripheral neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-motor-neuron-diseases",
        "description": "Exclusion of other motor neuron diseases including juvenile ALS",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Progressive upper motor neuron signs with onset before age 20, absence of lower motor neuron signs, and exclusion of other motor neuron diseases",
    "notes": "Diagnosis is clinical and supported by electrophysiological studies and exclusion of other conditions"
  },
