  "diagnosticCriteria": {
    "formalCriteriaName": "Holm Criteria for Prader-Willi Syndrome",
    "criteria": [
      {
        "id": "neonatal-hypotonia",
        "description": "Severe neonatal hypotonia with poor suck and feeding difficulties",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyperphagia",
        "description": "Onset of hyperphagia leading to obesity in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Molecular confirmation of imprinting center defect on chromosome 15q11-q13",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facial-features",
        "description": "Characteristic facial features including narrow forehead, almond-shaped eyes, and thin upper lip",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypogonadism",
        "description": "Hypogonadism manifesting as genital hypoplasia and delayed or incomplete puberty",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of neonatal hypotonia, hyperphagia with obesity, and molecular confirmation of imprinting mutation",
    "notes": "Genetic testing is essential to differentiate imprinting mutation from deletion or uniparental disomy subtypes."
  },
