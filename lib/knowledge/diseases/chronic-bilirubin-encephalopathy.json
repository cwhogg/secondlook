  "keyFindings": {
    "laboratory": [
      "Elevated total serum bilirubin in neonatal period (>20 mg/dL)",
      "Normal metabolic and infectious workup excluding other causes"
    ],
    "imaging": [
      "MRI showing bilateral hyperintensity in globus pallidus and subthalamic nuclei on T2-weighted images",
      "Brainstem abnormalities on MRI"
    ],
    "genetic": [
      "No specific genetic mutation; condition is secondary to hyperbilirubinemia"
    ],
    "other": [
      "Abnormal auditory brainstem response (ABR) testing",
      "Characteristic clinical neurological examination findings"
    ]
  },
