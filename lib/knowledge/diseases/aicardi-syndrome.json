  "keyFindings": {
    "laboratory": [
      "EEG showing hypsarrhythmia or other epileptiform abnormalities"
    ],
    "imaging": [
      "MRI demonstrating agenesis or hypogenesis of corpus callosum",
      "Brain malformations such as polymicrogyria or heterotopia",
      "Choroid plexus cysts on neuroimaging"
    ],
    "genetic": [
      "PTS (causative)",
      "No definitive causative gene identified; presumed X-linked dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Ophthalmologic exam revealing characteristic chorioretinal lacunae",
      "Skeletal survey showing vertebral anomalies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "agenesis-of-corpus-callosum",
      "distinguishingFeatures": [
        "Absence of chorioretinal lacunae",
        "Variable seizure types without classic triad",
        "No characteristic vertebral anomalies"
      ]
    },
    {
      "diseaseId": "rorb-related-retinal-dystrophy",
      "distinguishingFeatures": [
        "Retinal abnormalities without corpus callosum agenesis",
        "Later onset seizures or none",
        "Different genetic etiology"
      ]
    },
    {
      "diseaseId": "aicardi-goutieres-syndrome",
      "distinguishingFeatures": [
        "Presence of systemic inflammation",
        "Calcifications in basal ganglia on imaging",
        "Different genetic mutations (TREX1, RNASEH2)"
      ]
    }
  ],
  "redFlags": [
    "Early onset infantile spasms refractory to treatment",
