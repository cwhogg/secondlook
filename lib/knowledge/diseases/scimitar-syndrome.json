  "keyFindings": {
    "laboratory": [
      "Generally nonspecific; may show hypoxemia on arterial blood gas analysis"
    ],
    "imaging": [
      "Chest X-ray showing scimitar sign",
      "Echocardiography demonstrating anomalous pulmonary venous return and associated cardiac defects",
      "CT angiography or MRI confirming anomalous venous drainage and lung hypoplasia"
    ],
    "genetic": [
      "No specific genetic mutation identified; sporadic cases predominating"
    ],
    "other": [
      "Cardiac catheterization may be used to assess pulmonary pressures and shunt fraction"
    ]
  },
  "differentialDiagnoses": [
