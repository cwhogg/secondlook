  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Usher Syndrome Type 2",
    "criteria": [
      {
        "id": "sensorineural-hearing-loss",
        "description": "Moderate to severe congenital sensorineural hearing loss, predominantly affecting high frequencies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "retinitis-pigmentosa",
        "description": "Progressive retinitis pigmentosa with onset in adolescence or early adulthood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vestibular-function",
        "description": "Normal vestibular function (distinguishing from type 1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in USH2A, GPR98, or DFNB31 genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital moderate to severe sensorineural hearing loss plus progressive retinitis pigmentosa with normal vestibular function; genetic confirmation supportive but not mandatory",
    "notes": "Vestibular function testing is critical to differentiate from Usher syndrome type 1."
  },
