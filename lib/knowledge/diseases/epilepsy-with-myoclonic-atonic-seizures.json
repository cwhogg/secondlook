  "keyFindings": {
    "laboratory": [
      "Routine blood tests typically normal",
      "Metabolic screening usually unremarkable"
    ],
    "imaging": [
      "Brain MRI generally normal or nonspecific findings"
    ],
    "genetic": [
      "SLC2A1 (causative)",
      "SYNGAP1 (causative)",
      "NEXMIF (causative)",
      "SCN1A (causative)",
      "CHD2 (causative)",
      "SLC6A1 (causative, loss-of-function)",
      "AP2M1 (causative)"
    ],
    "other": [
