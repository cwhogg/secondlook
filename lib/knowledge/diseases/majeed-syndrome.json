  "diagnosticCriteria": {
    "formalCriteriaName": "Majeed Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-osteomyelitis",
        "description": "Presence of chronic recurrent multifocal osteomyelitis confirmed by clinical and radiological findings",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-dyserythropoietic-anemia",
        "description": "Evidence of congenital dyserythropoietic anemia with characteristic bone marrow findings",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neutrophilic-dermatosis",
        "description": "Neutrophilic dermatosis presenting as recurrent skin lesions such as Sweet syndrome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lpin2-mutation",
        "description": "Identification of biallelic pathogenic variants in the LPIN2 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (chronic recurrent multifocal osteomyelitis, congenital dyserythropoietic anemia, and neutrophilic dermatosis) must be present for diagnosis.",
    "notes": "Genetic testing for LPIN2 mutations supports diagnosis but is not mandatory."
  },
