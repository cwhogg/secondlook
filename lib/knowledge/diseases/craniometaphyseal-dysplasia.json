  "differentialDiagnoses": [
    {
      "diseaseId": "craniodiaphyseal-dysplasia",
      "distinguishingFeatures": [
        "More severe cranial hyperostosis",
        "Diaphyseal involvement rather than metaphyseal",
        "Earlier onset with more rapid progression"
      ]
    },
