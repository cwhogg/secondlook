  "diagnosticCriteria": {
    "formalCriteriaName": "NIPHS Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypoglycemia-confirmation",
        "description": "Documented symptomatic hypoglycemia with plasma glucose <55 mg/dL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "inappropriate-insulin-secretion",
        "description": "Inappropriately elevated insulin and C-peptide levels during hypoglycemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "negative-insulinoma-imaging",
        "description": "Absence of insulinoma on pancreatic imaging studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "selective-arterial-calcium-stimulation",
        "description": "Positive selective arterial calcium stimulation test indicating diffuse beta-cell hyperfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Histological evidence of islet cell hypertrophy and nesidioblastosis on pancreatic biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of documented hypoglycemia with inappropriate insulin secretion and exclusion of insulinoma by imaging",
    "notes": "Selective arterial calcium stimulation and histopathology support diagnosis but are not mandatory."
  },
