  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Glycogen Storage Disease Type 0",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Fasting hypoglycemia with ketonemia and absence of hepatomegaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-assay",
        "description": "Demonstration of deficient hepatic glycogen synthase enzyme activity in liver biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the GYS2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-profile",
        "description": "Low glycogen content in liver tissue",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of fasting hypoglycemia with ketonemia and either deficient hepatic glycogen synthase enzyme activity or pathogenic GYS2 mutations",
    "notes": "Liver biopsy is invasive and genetic testing is preferred when available."
  },
