  "diagnosticCriteria": {
    "formalCriteriaName": "Dermotrichic Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "congenital-hypertrichosis",
        "description": "Presence of congenital generalized hypertrichosis affecting multiple body regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "follicular-abnormalities",
        "description": "Histopathological evidence of abnormal hair follicle morphology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-thickening",
        "description": "Diffuse cutaneous thickening and hyperkeratosis in affected areas",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital generalized hypertrichosis plus histopathological confirmation of follicular abnormalities",
    "notes": "Genetic testing may assist but is not definitive; diagnosis primarily clinical and histological."
  },
