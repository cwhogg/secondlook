  "diagnosticCriteria": {
    "formalCriteriaName": "Currarino Triad Diagnostic Criteria",
    "criteria": [
      {
        "id": "sacral-malformation",
        "description": "Presence of partial sacral agenesis or sacral malformation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "presacral-mass",
        "description": "Presence of a presacral mass such as anterior meningocele, teratoma, or enteric cyst",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anorectal-malformation",
        "description": "Anorectal malformation including anal stenosis, imperforate anus, or fistula",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of Currarino syndrome or related sacral anomalies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "MNX1-mutation",
        "description": "Detection of pathogenic mutation in the MNX1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (sacral malformation, presacral mass, and anorectal malformation) or two major criteria with a positive MNX1 mutation or family history",
    "notes": "Genetic testing for MNX1 mutations can confirm diagnosis; some patients may present with incomplete triad."
  },
