  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Normosmic Congenital Hypogonadotropic Hypogonadism",
    "criteria": [
      {
        "id": "hypogonadism",
        "description": "Clinical evidence of hypogonadism including absent or incomplete puberty",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-gonadotropins",
        "description": "Low or inappropriately normal serum luteinizing hormone (LH) and follicle-stimulating hormone (FSH) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-olfaction",
        "description": "Normal sense of smell confirmed by olfactory testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclude-other-causes",
        "description": "Exclusion of other causes of hypogonadotropic hypogonadism such as pituitary tumors or systemic illness",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with nCHH (e.g., GNRHR, TAC3, TACR3)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical hypogonadism with low or inappropriately normal gonadotropins and normal olfaction, after exclusion of other causes",
    "notes": "Genetic testing can support diagnosis but is not mandatory"
  },
