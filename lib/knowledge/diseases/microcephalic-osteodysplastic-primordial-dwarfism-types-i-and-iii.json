    "laboratory": [
      "Normal routine blood tests; no specific biochemical markers"
    ],
    "imaging": [
      "Radiographs showing metaphyseal dysplasia and delayed bone age",
      "MRI brain may show microcephaly with simplified gyral pattern"
    ],
    "genetic": [
      "RNU4ATAC (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Prenatal ultrasound may detect intrauterine growth retardation and microcephaly"
    ]
  },
