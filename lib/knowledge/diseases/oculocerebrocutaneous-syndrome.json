  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria; diagnosis based on clinical triad",
    "criteria": [
      {
        "id": "ocular-malformations",
        "description": "Presence of orbital cysts or microphthalmia/anophthalmia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-lesions",
        "description": "Focal skin defects such as aplasia cutis or hypoplastic skin areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "central-nervous-system-anomalies",
        "description": "Brain malformations including agenesis of corpus callosum, cysts, or ventricular enlargement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including frontal bossing and hypertelorism",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-impairment",
        "description": "Developmental delay or seizures",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: ocular malformations, cutaneous lesions, and CNS anomalies",
    "notes": "Diagnosis is primarily clinical; genetic etiology remains unclear with sporadic occurrence."
