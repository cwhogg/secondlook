      "Liver function abnormalities in hepatic fibrosis"
    ],
    "imaging": [
      "Molar tooth sign on brain MRI",
      "Narrow bell-shaped thorax on chest X-ray",
      "Renal cystic changes on ultrasound"
    ],
    "genetic": [
      "CSPP1 (causative, loss-of-function)",
      "KIAA0586 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
