  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnostic criteria for dystrophic epidermolysis bullosa",
    "criteria": [
      {
        "id": "blistering-at-birth",
        "description": "Presence of skin blistering and erosions at or shortly after birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "spontaneous-improvement",
        "description": "Marked spontaneous improvement of skin fragility and blistering within the first year of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "col7a1-mutation",
        "description": "Identification of pathogenic variants in the COL7A1 gene associated with transient dystrophic epidermolysis bullosa",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Immunofluorescence mapping showing reduced or altered type VII collagen at the dermo-epidermal junction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-scarring",
        "description": "Lack of significant scarring or milia formation during follow-up",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of blistering at birth with spontaneous clinical improvement within the first year and confirmation of COL7A1 mutation",
    "notes": "Diagnosis is supported by genetic testing and immunofluorescence studies; differentiation from other dystrophic EB subtypes is critical."
  },
