  "orphanetId": "284",
  "prevalence": {
    "estimate": "1 in 100,000 to 1 in 200,000",
    "range": "0.0005%-0.001%",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 1,
      "max": 20,
      "peak": 5
    },
    "sexPredilection": "equal",
    "ethnicAssociations": [
      "Finnish",
      "Iranian Jewish",
      "Norwegian",
      "Italian"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "APECED Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-mucocutaneous-candidiasis",
        "description": "Presence of chronic mucocutaneous candidiasis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypoparathyroidism",
        "description": "Hypoparathyroidism confirmed by laboratory testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "adrenal-insufficiency",
        "description": "Primary adrenal insufficiency (Addison's disease)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoimmune-serology",
        "description": "Presence of autoantibodies against interferons or other endocrine tissues",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "AIRE-gene-mutation",
        "description": "Identification of biallelic pathogenic mutations in the AIRE gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least two of the three major criteria: chronic mucocutaneous candidiasis, hypoparathyroidism, and adrenal insufficiency",
    "notes": "Genetic testing for AIRE mutations supports diagnosis but is not mandatory."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Chronic mucocutaneous candidiasis",
        "frequency": 0.95,
        "bodySystem": "immunological",
        "notes": "Recurrent or persistent Candida infections of skin, nails, and mucosa"
      },
      {
        "symptomName": "Hypoparathyroidism",
        "frequency": 0.85,
        "bodySystem": "endocrine",
        "notes": "Leads to hypocalcemia with neuromuscular irritability"
      },
      {
        "symptomName": "Primary adrenal insufficiency",
        "frequency": 0.8,
        "bodySystem": "endocrine",
        "notes": "Addison's disease causing fatigue, hypotension, and electrolyte imbalance"
      }
    ],
    "common": [
      {
        "symptomName": "Alopecia areata",
        "frequency": 0.6,
        "bodySystem": "dermatological",
        "notes": "Patchy hair loss due to autoimmune attack on hair follicles"
      },
      {
        "symptomName": "Dental enamel hypoplasia",
        "frequency": 0.65,
        "bodySystem": "musculoskeletal",
        "notes": "Defective enamel formation leading to fragile teeth"
      },
      {
        "symptomName": "Vitiligo",
        "frequency": 0.55,
        "bodySystem": "dermatological",
        "notes": "Autoimmune depigmentation of skin"
      },
      {
        "symptomName": "Gastrointestinal dysfunction",
        "frequency": 0.7,
        "bodySystem": "gastrointestinal",
        "notes": "Includes malabsorption, diarrhea, or constipation"
      },
      {
        "symptomName": "Keratoconjunctivitis",
        "frequency": 0.5,
        "bodySystem": "ophthalmological",
        "notes": "Inflammation of cornea and conjunctiva causing eye irritation"
      }
    ],
    "occasional": [
      {
        "symptomName": "Autoimmune hepatitis",
        "frequency": 0.3,
        "bodySystem": "gastrointestinal",
        "notes": "Immune-mediated liver inflammation"
      },
      {
        "symptomName": "Pernicious anemia",
        "frequency": 0.25,
        "bodySystem": "hematological",
        "notes": "Vitamin B12 deficiency due to autoimmune gastritis"
      },
      {
        "symptomName": "Chronic diarrhea",
        "frequency": 0.4,
        "bodySystem": "gastrointestinal",
        "notes": "May be related to malabsorption or autoimmune enteropathy"
      },
      {
        "symptomName": "Nail dystrophy",
        "frequency": 0.2,
        "bodySystem": "dermatological",
        "notes": "Thickened, brittle, or discolored nails"
      },
      {
        "symptomName": "Enamel hypoplasia",
        "frequency": 0.15,
        "bodySystem": "musculoskeletal",
        "notes": "Defective enamel development"
      }
    ],
    "rare": [
      {
        "symptomName": "Autoimmune thyroiditis",
        "frequency": 0.08,
        "bodySystem": "endocrine",
        "notes": "Hashimoto's thyroiditis or other autoimmune thyroid dysfunction"
      },
      {
        "symptomName": "Primary ovarian insufficiency",
        "frequency": 0.05,
        "bodySystem": "reproductive",
        "notes": "Premature ovarian failure in females"
      },
      {
        "symptomName": "Chronic active hepatitis",
        "frequency": 0.07,
        "bodySystem": "gastrointestinal",
        "notes": "Progressive liver inflammation"
      },
      {
        "symptomName": "Malabsorption syndrome",
        "frequency": 0.06,
        "bodySystem": "gastrointestinal",
        "notes": "Due to autoimmune enteropathy"
      }
    ]
  },
  "systemsAffected": [
    "endocrine",
    "immunological",
    "dermatological",
    "gastrointestinal",
    "ophthalmological",
    "hematological",
    "reproductive"
  ],
  "keyFindings": {
    "laboratory": [
      "Hypocalcemia with low parathyroid hormone levels",
      "Hyponatremia and hyperkalemia consistent with adrenal insufficiency",
      "Presence of autoantibodies against interferon-ω and interferon-α",
      "Positive anti-adrenal and anti-parathyroid antibodies"
    ],
    "imaging": [
      "Adrenal gland atrophy on CT or MRI",
      "Dental radiographs showing enamel hypoplasia"
    ],
    "genetic": [
      "Biallelic pathogenic mutations in the AIRE gene on chromosome 21"
    ],
    "other": [
      "Histopathology of affected glands showing lymphocytic infiltration",
      "Positive fungal cultures or biopsy confirming chronic candidiasis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autoimmune-polyendocrinopathy-type-2",
      "distinguishingFeatures": [
        "Polygenic inheritance",
        "Later onset (typically adulthood)",
        "Absence of chronic mucocutaneous candidiasis"
      ]
    },
    {
      "diseaseId": "immunodeficiency-with-chronic-candidiasis",
      "distinguishingFeatures": [
        "Primary immunodeficiency with recurrent infections",
        "Lack of endocrine gland failure",
        "Different genetic mutations (e.g., STAT1 gain-of-function)"
      ]
    }
  ],
  "redFlags": [
    "Early onset chronic mucocutaneous candidiasis refractory to antifungal therapy",
    "Multiple endocrine gland failures in a pediatric patient",
    "Family history of autoimmune polyendocrinopathy or consanguinity"
  ],
  "specialistType": [
    "Endocrinologist",
    "Immunologist",
    "Dermatologist",
    "Geneticist"
  ],
