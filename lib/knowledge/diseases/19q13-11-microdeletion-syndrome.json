  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for 19q13.11 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of heterozygous microdeletion at chromosome 19q13.11 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Presence of global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Characteristic craniofacial dysmorphic features including microcephaly, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or genitourinary malformations",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-issues",
        "description": "Behavioral abnormalities including autistic features or attention deficits",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 19q13.11 microdeletion plus presence of developmental delay and characteristic dysmorphic features",
    "notes": "Diagnosis relies heavily on genetic testing combined with clinical presentation."
  },
