  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnosis of Gabriele-de Vries syndrome",
    "criteria": [
      {
        "id": "de-novo-variant",
        "description": "Presence of a de novo pathogenic variant in the YY1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial dysmorphisms including broad nasal bridge, thin upper lip, and arched eyebrows",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-issues",
        "description": "Behavioral abnormalities such as autism spectrum disorder or attention deficit hyperactivity disorder",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-delay",
        "description": "Postnatal growth retardation or feeding difficulties",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Identification of a pathogenic or likely pathogenic de novo variant in YY1 gene combined with developmental delay or intellectual disability",
    "notes": "Genetic testing is essential for confirmation; clinical features are variable and nonspecific."
  },
