  "diagnosticCriteria": {
    "formalCriteriaName": "SCARF Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "skeletal-abnormalities",
        "description": "Presence of multiple skeletal abnormalities including joint contractures and bone dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutis-laxa",
        "description": "Generalized loose, sagging skin consistent with cutis laxa",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ambiguous-genitalia",
        "description": "Ambiguous or atypical genitalia observed at birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features including broad nose, hypertelorism, and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: skeletal abnormalities, cutis laxa, and ambiguous genitalia",
    "notes": "Diagnosis is clinical; genetic testing may support but is not definitive."
  },
