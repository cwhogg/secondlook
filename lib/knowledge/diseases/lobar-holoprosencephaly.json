  "diagnosticCriteria": {
    "formalCriteriaName": "Holoprosencephaly Diagnostic Criteria",
    "criteria": [
      {
        "id": "imaging-midline-fusion",
        "description": "Presence of incomplete separation of the cerebral hemispheres on brain imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-midline-anomalies",
        "description": "Midline facial anomalies such as hypotelorism, single central incisor, or cleft lip/palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with holoprosencephaly (e.g., SHH, ZIC2, SIX3)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic brain imaging findings plus at least one major clinical feature such as midline facial anomaly",
    "notes": "Diagnosis is primarily based on neuroimaging and clinical features; genetic testing supports confirmation."
  },
