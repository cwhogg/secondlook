  "diagnosticCriteria": {
    "formalCriteriaName": "Ring Chromosome 2 Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Presence of ring chromosome 2 confirmed by karyotyping or molecular cytogenetics",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Pre- and postnatal growth retardation with microcephaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including micrognathia, hypertelorism, and broad nasal bridge",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or limb abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of ring chromosome 2 plus at least two major clinical features including growth retardation and developmental delay",
    "notes": "Diagnosis relies heavily on cytogenetic analysis; clinical features are variable and may overlap with other chromosomal disorders."
  },
