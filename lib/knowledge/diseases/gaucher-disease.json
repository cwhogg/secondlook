  "diagnosticCriteria": {
    "formalCriteriaName": "Expert consensus guidelines for Gaucher disease diagnosis",
    "criteria": [
      {
        "id": "gd-c1",
        "description": "Deficient acid beta-glucosidase (glucocerebrosidase) activity in leukocytes or fibroblasts (<15% of normal)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gd-c2",
        "description": "Biallelic pathogenic variants in GBA1 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gd-c3",
        "description": "Elevated biomarkers: chitotriosidase, CCL18/PARC, glucosylsphingosine (lyso-Gb1)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "gd-c4",
        "description": "Gaucher cells on bone marrow biopsy (lipid-laden macrophages with crinkled tissue paper appearance)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "gd-c5",
        "description": "Hepatosplenomegaly with cytopenia(s) on clinical examination and laboratory evaluation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient glucocerebrosidase enzyme activity, confirmed by GBA1 genetic testing. Enzyme assay is the gold standard.",
    "notes": "Type 1 (non-neuronopathic, ~94%) is most common and does not involve the CNS. Type 2 (acute neuronopathic) is fatal in infancy. Type 3 (chronic neuronopathic) has variable neurological involvement. GBA1 mutations are a strong risk factor for Parkinson disease."
  },
