  "keyFindings": {
    "laboratory": [
      "Markedly elevated methylmalonic acid in plasma and urine",
      "Metabolic acidosis with increased anion gap",
      "Elevated plasma homocysteine may be normal or mildly elevated"
    ],
    "imaging": [
      "MRI brain showing basal ganglia abnormalities and cerebral atrophy",
      "Renal ultrasound may show nephrocalcinosis or chronic changes"
    ],
    "genetic": [
      "Pathogenic variants in MMAB gene confirming cblA defect"
    ],
    "other": [
      "Reduced methylmalonyl-CoA mutase enzyme activity in fibroblasts or leukocytes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "methylmalonic-acidemia-cbl-b-defect",
      "distinguishingFeatures": [
        "Mutations in MMAB gene vs. MMACHC gene in cblB defect",
        "Similar biochemical profile but different genetic cause"
      ]
    },
    {
      "diseaseId": "propionic-acidemia",
      "distinguishingFeatures": [
        "Elevated propionic acid rather than methylmalonic acid",
        "Different enzyme deficiency (propionyl-CoA carboxylase)"
      ]
    }
  ],
  "redFlags": [
