  "keyFindings": {
    "laboratory": [
      "Mild to moderate elevation of serum creatine kinase",
      "Normal inflammatory markers"
    ],
    "imaging": [
      "Muscle MRI showing selective fatty infiltration and atrophy of distal muscles"
    ],
    "genetic": [
      "MYOT (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Muscle biopsy demonstrating myofibrillar myopathy with myotilin-positive protein aggregates"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "tibial-muscular-dystrophy",
      "distinguishingFeatures": [
        "Late onset distal weakness predominantly in anterior tibial muscles",
        "Absence of myotilin mutations",
        "Different muscle biopsy findings without myotilin-positive aggregates"
      ]
    },
    {
      "diseaseId": "desmin-related-myopathy",
      "distinguishingFeatures": [
        "Mutations in DES gene",
        "Presence of desmin-positive aggregates on muscle biopsy",
        "More frequent cardiac involvement"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of muscle weakness over weeks",
