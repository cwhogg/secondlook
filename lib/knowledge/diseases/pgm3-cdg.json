  "diagnosticCriteria": {
    "formalCriteriaName": "PGM3-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the PGM3 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Recurrent infections due to combined immunodeficiency with hypogammaglobulinemia and lymphopenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-features",
        "description": "Neurodevelopmental delay including intellectual disability and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal dysplasia or joint hyperextensibility",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "abnormal-glycosylation",
        "description": "Abnormal serum transferrin glycosylation pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic PGM3 variants plus clinical features of immunodeficiency and neurodevelopmental delay",
    "notes": "Diagnosis is confirmed by molecular genetic testing; biochemical testing supports diagnosis."
  },
