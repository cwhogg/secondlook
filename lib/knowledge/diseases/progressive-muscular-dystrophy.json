        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in dystrophin or related genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-serum-creatine-kinase",
        "description": "Elevated serum creatine kinase (CK) levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography-myopathic-pattern",
        "description": "Electromyography showing myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive symmetrical proximal muscle weakness plus either muscle biopsy showing dystrophic changes or genetic confirmation of pathogenic mutation",
    "notes": "Genetic testing is increasingly used to confirm diagnosis but is not mandatory if clinical and biopsy findings are conclusive."
