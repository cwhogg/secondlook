  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Juvenile Hyperuricemic Nephropathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "hyperuricemia",
        "description": "Persistent hyperuricemia often preceding renal impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant family history of hyperuricemia and renal disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-failure",
        "description": "Progressive chronic kidney disease leading to renal failure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gout",
        "description": "Clinical or radiographic evidence of gouty arthritis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of UMOD gene mutation",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hyperuricemia and family history of autosomal dominant renal disease with progressive renal failure",
    "notes": "Genetic testing for UMOD mutations can confirm diagnosis but is not always available."
  },
