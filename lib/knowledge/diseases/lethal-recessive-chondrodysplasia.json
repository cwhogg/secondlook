  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Lethal Recessive Chondrodysplasia",
    "criteria": [
      {
        "id": "rhizomelic-shortening",
        "description": "Severe rhizomelic shortening of the limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "narrow-thorax",
        "description": "Narrow thorax with short ribs leading to respiratory insufficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-changes",
        "description": "Characteristic radiological findings including metaphyseal abnormalities and platyspondyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the causative gene (e.g., SLC26A2)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "prenatal-ultrasound",
        "description": "Prenatal ultrasound showing limb shortening and narrow thorax",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe rhizomelic limb shortening, narrow thorax with respiratory insufficiency, and characteristic radiological findings; genetic confirmation supports diagnosis.",
    "notes": "Diagnosis is often made prenatally or neonatally due to lethality in early infancy."
  },
