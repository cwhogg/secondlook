  "keyFindings": {
    "laboratory": [
      "Elevated liver transaminases and cholestatic enzymes",
      "Impaired renal function tests (elevated creatinine, BUN)",
      "Pancreatic enzyme insufficiency markers"
    ],
    "imaging": [
      "Ultrasound or MRI showing bilateral renal cystic dysplasia",
      "Liver imaging demonstrating fibrosis and portal hypertension",
      "Pancreatic cystic changes on MRI or CT"
    ],
    "genetic": [
      "NPHP3 (causative, loss-of-function)",
      "NEK8 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathological confirmation of renal cystic dysplasia, hepatic fibrosis, and pancreatic ductal abnormalities"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autosomal-recessive-polycystic-kidney-disease",
      "distinguishingFeatures": [
        "Primarily renal and hepatic involvement without pancreatic dysplasia",
        "PKHD1 gene mutations",
        "Earlier onset of renal failure"
      ]
    },
    {
      "diseaseId": "meckel-gruber-syndrome",
      "distinguishingFeatures": [
        "Presence of occipital encephalocele and polydactyly",
        "More severe central nervous system malformations",
        "Usually lethal in perinatal period"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive renal failure in infancy",
    "Severe portal hypertension with variceal bleeding",
    "Signs of pancreatic exocrine insufficiency leading to malnutrition"
  ],
