        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-dysplasia",
        "description": "Radiological evidence of metaphyseal dysplasia with irregular, flared metaphyses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation with short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-complications",
        "description": "Recurrent respiratory infections or restrictive lung disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (craniofacial dysmorphism and skeletal dysplasia) with supportive clinical features",
    "notes": "Genetic testing may assist but is not definitive due to limited known mutations."
  },
