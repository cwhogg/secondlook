  "diagnosticCriteria": {
    "formalCriteriaName": "Dravet Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "febrile-seizures",
        "description": "Prolonged febrile seizures beginning in infancy (usually before 12 months)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multiple-seizure-types",
        "description": "Multiple seizure types including myoclonic, generalized tonic-clonic, and focal seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Developmental slowing or regression after seizure onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "scn1a-mutation",
        "description": "Presence of pathogenic SCN1A gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-early-development",
        "description": "Normal development prior to seizure onset",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of prolonged febrile seizures starting before 12 months, multiple seizure types including myoclonic seizures, and developmental delay after seizure onset",
    "notes": "Genetic testing for SCN1A mutations supports diagnosis but is not mandatory"
  },
