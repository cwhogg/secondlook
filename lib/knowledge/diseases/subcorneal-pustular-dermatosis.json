  "differentialDiagnoses": [
    {
      "diseaseId": "pustular-psoriasis",
      "distinguishingFeatures": [
        "Histopathology shows spongiform pustules of Kogoj",
        "More extensive systemic symptoms",
        "Positive family history and association with psoriasis"
      ]
    },
    {
      "diseaseId": "pemphigus-foliaceus",
      "distinguishingFeatures": [
        "Presence of acantholysis on histopathology",
        "Positive direct immunofluorescence with intercellular IgG deposits",
        "More fragile blisters and erosions"
      ]
    },
    {
      "diseaseId": "acute-generalized-exanthematous-pustulosis",
      "distinguishingFeatures": [
        "Acute onset often drug-induced",
        "Systemic symptoms including fever and leukocytosis",
        "Histology shows subcorneal pustules with eosinophils"
      ]
    }
  ],
  "redFlags": [
