  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate elevation)",
      "Abnormal electromyography showing myopathic changes"
    ],
    "imaging": [
      "Brain MRI demonstrating cerebral atrophy or delayed myelination",
      "Muscle MRI showing fatty infiltration and muscle wasting"
    ],
    "genetic": [
      "DPM2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy revealing dystrophic changes and abnormal glycosylation of alpha-dystroglycan"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "walker-warburg-syndrome",
      "distinguishingFeatures": [
        "More severe brain malformations including lissencephaly",
        "Ocular malformations such as retinal dysplasia",
        "Shorter life expectancy"
      ]
    },
    {
      "diseaseId": "dystroglycanopathy-with-epilepsy",
      "distinguishingFeatures": [
        "Variable intellectual disability with less severe muscular dystrophy",
        "Different genetic mutations affecting glycosylation pathway",
        "Less frequent refractory epilepsy"
      ]
    }
  ],
  "redFlags": [
    "Onset of severe epileptic seizures refractory to standard antiepileptic drugs",
