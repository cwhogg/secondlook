  "keyFindings": {
    "laboratory": [
      "Hypoalbuminemia (often < 2.5 g/dL)",
      "Hypogammaglobulinemia (low IgG, IgA, IgM)",
      "Lymphopenia (absolute lymphocyte count often < 1000/microL)",
      "Elevated fecal alpha-1-antitrypsin clearance (> 24 mL/day)",
      "Hypocalcemia and low fat-soluble vitamins"
    ],
    "imaging": [
      "CT enterography: thickened small bowel folds, particularly jejunum",
      "MR lymphangiography: dilated lymphatic channels",
      "Tc-99m albumin scintigraphy: demonstrates enteric protein loss"
    ],
    "genetic": [
      "Primary form may be associated with chromosomal abnormalities (Turner syndrome, Noonan syndrome)",
      "VEGFR3 pathway dysregulation implicated in some cases"
    ],
    "other": [
      "Upper endoscopy: 'snowflake' appearance of duodenal/jejunal mucosa (white-tipped villi)",
      "Capsule endoscopy: diffuse white spots on small bowel mucosa",
      "Small bowel biopsy: dilated lacteals in villous tips (pathognomonic histology)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "constrictive-pericarditis",
      "distinguishingFeatures": [
        "Constrictive pericarditis causes secondary lymphangiectasia from elevated venous pressure",
        "Jugular venous distension and Kussmaul sign present"
      ]
    },
    {
      "diseaseId": "celiac-disease",
      "distinguishingFeatures": [
        "Celiac has villous atrophy, not dilated lacteals",
        "Positive celiac serologies in celiac disease"
      ]
    },
    {
      "diseaseId": "nephrotic-syndrome",
      "distinguishingFeatures": [
        "Nephrotic syndrome has proteinuria > 3.5 g/day",
        "Nephrotic syndrome does not have elevated fecal alpha-1-antitrypsin"
      ]
    }
  ],
  "redFlags": [
    "Severe edema with respiratory compromise (pleural effusion, ascites)",
    "Recurrent serious infections suggesting severe immunodeficiency",
    "Development of lymphoma (watch for new lymphadenopathy, B-symptoms)",
    "Tetany or seizures from severe hypocalcemia"
  ],
