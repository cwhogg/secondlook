  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Distal 9p Deletion Syndrome",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic craniofacial features including trigonocephaly, flat nasal bridge, and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Detection of terminal deletion on the short arm of chromosome 9 by karyotyping or microarray",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital heart defects such as atrial or ventricular septal defects",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic craniofacial features, developmental delay, and genetic confirmation of 9p terminal deletion",
    "notes": "Diagnosis requires cytogenetic or molecular confirmation due to phenotypic overlap with other syndromes"
  },
