  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests except possible hypothyroidism",
      "Metabolic screening usually normal"
    ],
    "imaging": [
      "Brain MRI may show nonspecific cerebral atrophy or delayed myelination",
      "Echocardiogram revealing congenital heart defects",
      "Skeletal X-rays showing clinodactyly or other anomalies"
    ],
    "genetic": [
      "Karyotype or chromosomal microarray showing partial trisomy of chromosome 4p",
      "FISH analysis confirming duplication of 4p segment"
    ],
    "other": [
      "Developmental assessments confirming intellectual disability",
      "Audiological evaluation for hearing impairment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "wolf-hirschhorn-syndrome",
      "distinguishingFeatures": [
        "Deletion of 4p rather than duplication",
        "Distinctive 'Greek warrior helmet' facial appearance",
        "More severe growth retardation and seizures"
      ]
    },
    {
      "diseaseId": "trisomy-8-syndrome",
      "distinguishingFeatures": [
        "Trisomy of chromosome 8 rather than 4p",
        "Characteristic deep plantar and palmar creases",
        "Distinctive facial features including prominent forehead"
      ]
    }
  ],
