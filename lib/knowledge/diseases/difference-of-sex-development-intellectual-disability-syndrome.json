  "keyFindings": {
    "laboratory": [
      "Abnormal sex steroid hormone levels (low testosterone or estradiol)",
      "Elevated gonadotropins indicating gonadal failure"
    ],
    "imaging": [
      "Pelvic ultrasound showing streak gonads or absent uterus",
      "Brain MRI may show nonspecific abnormalities related to intellectual disability"
    ],
    "genetic": [
      "Pathogenic variants in genes such as NR5A1, SOX9, or other DSD-related genes",
      "Chromosomal abnormalities including mosaicism or structural rearrangements"
    ],
    "other": [
      "Neurodevelopmental assessment confirming intellectual disability",
      "Endocrinological evaluation for pubertal development"
    ]
  },
  "differentialDiagnoses": [
