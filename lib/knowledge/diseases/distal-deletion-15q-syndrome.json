  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Distal 15q Deletion Syndrome",
    "criteria": [
      {
        "id": "chromosomal-deletion",
        "description": "Confirmed deletion involving the distal segment of the long arm of chromosome 15 (15q26 region) by cytogenetic or molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-restriction",
        "description": "Prenatal and postnatal growth retardation including intrauterine growth restriction and short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features such as micrognathia, broad nasal bridge, and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-anomalies",
        "description": "Presence of congenital heart defects such as ventricular septal defect or patent ductus arteriosus",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of distal 15q deletion plus presence of at least two major clinical features including growth restriction and craniofacial dysmorphism",
    "notes": "Diagnosis relies heavily on genetic testing; clinical features support but are variable."
  },
