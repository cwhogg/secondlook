  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (CRP, ESR)",
      "Leukopenia or leukocytosis",
      "Elevated liver enzymes in some cases"
    ],
    "imaging": [
      "Chest X-ray may show infiltrates if respiratory involvement",
      "Ophthalmologic slit-lamp examination for ocular damage"
    ],
    "genetic": [
      "HLA-B*1502 allele associated with carbamazepine-induced SJS/TEN in Asian populations",
      "HLA-B*5801 associated with allopurinol-induced SJS/TEN"
    ],
    "other": [
      "Skin biopsy showing full-thickness epidermal necrosis with minimal dermal inflammation",
      "Positive Nikolsky sign on physical exam"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "staphylococcal-scalded-skin-syndrome",
      "distinguishingFeatures": [
        "More common in children",
        "Superficial epidermal splitting without mucosal involvement",
        "Rapid response to antibiotics"
      ]
    },
    {
      "diseaseId": "erythema-multiforme-major",
      "distinguishingFeatures": [
        "Target lesions with less extensive skin detachment",
        "Usually associated with herpes simplex virus",
        "Mucosal involvement less severe"
      ]
    },
    {
      "diseaseId": "acute-generalized-exanthematous-pustulosis",
      "distinguishingFeatures": [
        "Pustular lesions rather than necrosis",
        "Rapid onset after drug exposure",
        "Fever and leukocytosis prominent"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of skin detachment >10% BSA",
    "Signs of sepsis or septic shock",
    "Severe mucosal involvement causing airway compromise"
  ],
