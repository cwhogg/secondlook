  "diagnosticCriteria": {
    "formalCriteriaName": "Adult Hypophosphatasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "low-serum-alkaline-phosphatase",
        "description": "Persistently low serum alkaline phosphatase activity below age- and sex-adjusted reference ranges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-plasma-ppea",
        "description": "Elevated plasma pyridoxal 5'-phosphate (PLP) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of adult-onset bone pain, recurrent stress fractures, or pseudofractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the ALPL gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiographic-findings",
        "description": "Radiographic evidence of pseudofractures or osteomalacia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of low serum alkaline phosphatase and clinical features consistent with adult hypophosphatasia, supported by elevated plasma PLP or genetic confirmation",
    "notes": "Diagnosis requires exclusion of secondary causes of low alkaline phosphatase."
  },
