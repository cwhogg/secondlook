  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Autosomal Dominant Optic Atrophy and Cataract",
    "criteria": [
      {
        "id": "optic-atrophy",
        "description": "Bilateral optic nerve atrophy confirmed by ophthalmological examination and visual field testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cataract-presence",
        "description": "Presence of bilateral or unilateral cataract identified by slit-lamp examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance pattern",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in OPA1 gene or other associated genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "electrophysiology",
        "description": "Abnormal visual evoked potentials supporting optic nerve dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral optic atrophy and cataract with a compatible family history; genetic confirmation supports diagnosis",
    "notes": "Genetic testing is recommended but not mandatory if clinical criteria are strongly met."
  },
