  "diagnosticCriteria": {
    "formalCriteriaName": "DSM-5 Criteria for Neuroleptic Malignant Syndrome",
    "criteria": [
      {
        "id": "hyperthermia",
        "description": "Elevated body temperature typically >38°C",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-rigidity",
        "description": "Severe generalized muscle rigidity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autonomic-dysfunction",
        "description": "Autonomic instability including tachycardia, labile blood pressure, diaphoresis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "altered-mental-status",
        "description": "Altered consciousness ranging from agitation to coma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-creatine-kinase",
        "description": "Markedly elevated serum creatine kinase levels",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "leukocytosis",
        "description": "Elevated white blood cell count",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all four major criteria (hyperthermia, muscle rigidity, autonomic dysfunction, altered mental status) following exposure to dopamine antagonist",
    "notes": "Diagnosis is clinical and requires exclusion of other causes such as infections or serotonin syndrome."
  },
