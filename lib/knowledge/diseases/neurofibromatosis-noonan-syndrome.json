  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Neurofibromatosis-Noonan Syndrome",
    "criteria": [
      {
        "id": "nf1-criteria",
        "description": "Presence of two or more NIH diagnostic criteria for Neurofibromatosis type 1 (e.g., café-au-lait spots, neurofibromas, Lisch nodules)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "noonan-features",
        "description": "Characteristic Noonan syndrome facial features including hypertelorism, ptosis, and low-set ears",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-anomaly",
        "description": "Congenital heart defect typical of Noonan syndrome such as pulmonary valve stenosis or hypertrophic cardiomyopathy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "short-stature",
        "description": "Short stature below the 3rd percentile for age and sex",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in NF1 gene or related RAS-MAPK pathway genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of NF1 diagnostic criteria plus characteristic Noonan syndrome facial features",
    "notes": "Genetic testing can support diagnosis but is not mandatory; clinical features overlap with both NF1 and Noonan syndrome."
  },
