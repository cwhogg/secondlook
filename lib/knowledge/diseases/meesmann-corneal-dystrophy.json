  "differentialDiagnoses": [
    {
      "diseaseId": "epithelial-basement-membrane-dystrophy",
      "distinguishingFeatures": [
        "Absence of intraepithelial microcysts",
        "Presence of map-dot-fingerprint patterns",
        "Usually no family history"
      ]
    },
    {
      "diseaseId": "lisch-cornea-dystrophy",
      "distinguishingFeatures": [
        "Band-shaped epithelial opacities",
        "Different genetic mutations (KRT12)",
        "Distinct clinical appearance without microcysts"
      ]
    }
  ],
  "redFlags": [
