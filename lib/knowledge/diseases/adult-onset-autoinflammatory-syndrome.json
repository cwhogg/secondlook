  "keyFindings": {
    "laboratory": [
      "Elevated C-reactive protein (CRP) and erythrocyte sedimentation rate (ESR) during attacks",
      "Leukocytosis with neutrophilia",
      "Negative autoimmune serologies (ANA, RF)"
    ],
    "imaging": [
      "Chest X-ray or CT showing pleural effusions during serositis episodes",
      "Ultrasound or CT abdomen showing peritoneal inflammation"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Response to corticosteroids or IL-1 inhibitors supports diagnosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "adult-onset-still-disease",
      "distinguishingFeatures": [
        "High spiking quotidian fevers",
        "Characteristic salmon-pink rash",
        "Marked ferritin elevation"
      ]
    },
    {
      "diseaseId": "familial-mediterranean-fever",
      "distinguishingFeatures": [
        "Genetic confirmation of MEFV mutations",
        "Shorter fever episodes (1-3 days)",
        "Predominant serositis without multi-organ systemic inflammation"
      ]
    },
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "Positive ANA and other autoimmune antibodies",
        "Presence of specific organ involvement (renal, CNS) with immune complex deposition",
        "Chronic course without periodic fever pattern"
      ]
    }
  ],
  "redFlags": [
    "Persistent high-grade fever unresponsive to antibiotics",
    "Rapid progression to organ failure or amyloidosis",
    "Neurological symptoms suggestive of aseptic meningitis"
  ],
