  "diagnosticCriteria": {
    "formalCriteriaName": "Echocardiographic and Cardiac MRI Diagnostic Criteria for TGA",
    "criteria": [
      {
        "id": "atrioventricular-ventriculoarterial-dissociation",
        "description": "Discordant atrioventricular and ventriculoarterial connections demonstrated by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ventricular-positioning",
        "description": "Morphologic right ventricle positioned on the left and morphologic left ventricle on the right",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "great-artery-origin",
        "description": "Aorta arising from the morphologic right ventricle and pulmonary artery from the morphologic left ventricle",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "associated-cardiac-anomalies",
        "description": "Presence of ventricular septal defect, pulmonary stenosis, or conduction abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of discordant atrioventricular and ventriculoarterial connections confirmed by imaging",
    "notes": "Diagnosis is primarily based on echocardiography and cardiac MRI findings; genetic testing is not diagnostic but may identify syndromic associations."
  },
