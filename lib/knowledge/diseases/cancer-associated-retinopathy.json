  "keyFindings": {
    "laboratory": [
      "Detection of anti-retinal antibodies (e.g., anti-recoverin, anti-enolase antibodies)",
      "Paraneoplastic antibody panels"
    ],
    "imaging": [
      "Optical coherence tomography (OCT) may show outer retinal layer thinning",
      "Fluorescein angiography typically normal or mild abnormalities"
    ],
    "genetic": [],
    "other": [
      "Electroretinogram (ERG) showing reduced or extinguished rod and cone responses",
      "Identification of underlying malignancy via systemic workup"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "retinitis-pigmentosa",
      "distinguishingFeatures": [
        "Inherited progressive retinal degeneration",
        "Family history positive",
        "No associated malignancy or anti-retinal antibodies"
      ]
    },
    {
      "diseaseId": "autoimmune-retinopathy",
      "distinguishingFeatures": [
        "Similar clinical and immunological features but absence of underlying cancer",
        "May have systemic autoimmune disease"
      ]
    },
    {
      "diseaseId": "toxic-retinopathy",
      "distinguishingFeatures": [
        "History of drug/toxin exposure",
        "No anti-retinal antibodies",
        "ERG changes related to toxic agent"
      ]
    }
  ],
  "redFlags": [
    "Rapid bilateral visual loss over weeks to months",
    "Presence of systemic malignancy or history of cancer",
    "Detection of anti-retinal antibodies in serum"
  ],
