  "keyFindings": {
    "laboratory": [
      "Elevated double-negative T cells (CD3+ TCRαβ+ CD4- CD8-)",
      "Autoimmune cytopenias (positive Coombs test, thrombocytopenia)",
      "Elevated serum vitamin B12 and interleukin-10 levels"
    ],
    "imaging": [
      "Lymphadenopathy and splenomegaly on ultrasound or CT scan",
      "Hepatomegaly on abdominal imaging"
    ],
    "genetic": [
      "Pathogenic mutations in the FAS gene (TNFRSF6)",
      "Familial inheritance pattern in some cases"
    ],
    "other": [
      "Defective Fas-mediated lymphocyte apoptosis demonstrated by in vitro assays",
      "Increased risk of lymphoma development"
    ]
  },
