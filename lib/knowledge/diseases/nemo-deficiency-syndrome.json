        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Clinical or laboratory evidence of immunodeficiency such as recurrent infections and impaired NF-kB signaling",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history consistent with X-linked inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "skin-lesions",
        "description": "Characteristic stages of skin lesions including vesicular, verrucous, hyperpigmented, and hypopigmented phases",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic IKBKG mutation plus clinical evidence of ectodermal dysplasia and immunodeficiency",
    "notes": "Diagnosis is confirmed by molecular genetic testing; clinical features support diagnosis."
  },
