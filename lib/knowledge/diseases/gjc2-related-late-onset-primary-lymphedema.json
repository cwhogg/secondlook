  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for GJC2-related Late-Onset Primary Lymphedema",
    "criteria": [
      {
        "id": "clinical-lymphedema",
        "description": "Presence of chronic, non-pitting lymphedema predominantly affecting lower limbs with onset in adulthood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic or likely pathogenic variants in the GJC2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-secondary-causes",
        "description": "Exclusion of secondary causes of lymphedema such as infection, malignancy, or trauma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-lymphedema",
        "description": "Lymphoscintigraphy or MRI lymphangiography demonstrating impaired lymphatic drainage",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of late-onset lymphedema consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic late-onset lymphedema with pathogenic GJC2 variant and exclusion of secondary causes",
    "notes": "Diagnosis relies heavily on genetic testing and clinical exclusion of other causes."
  },
