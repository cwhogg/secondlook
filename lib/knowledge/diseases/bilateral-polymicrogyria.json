      "Electroencephalogram (EEG) showing focal or generalized epileptiform discharges"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "focal-polymicrogyria",
      "distinguishingFeatures": [
        "Unilateral or localized cortical involvement",
        "Less extensive developmental delay",
        "Focal neurological deficits"
      ]
    },
    {
      "diseaseId": "lissencephaly",
      "distinguishingFeatures": [
        "Smooth brain surface with absent or reduced gyri",
        "More severe motor impairment",
        "Distinct genetic mutations (e.g. LIS1)"
      ]
    },
    {
      "diseaseId": "cortical-dysplasia",
      "distinguishingFeatures": [
        "Focal cortical thickening",
        "Often associated with refractory epilepsy",
        "Different MRI pattern without excessive small gyri"
      ]
    }
  ],
