  "keyFindings": {
    "laboratory": [
      "Normal routine labs; possible anemia secondary to feeding difficulties"
    ],
    "imaging": [
      "Skeletal X-rays showing limb abnormalities",
      "Brain MRI may show structural abnormalities in some cases",
      "Echocardiography for congenital heart defects"
    ],
    "genetic": [
      "Pathogenic variants in NIPBL gene (~60% cases)",
      "Mutations in SMC1A, SMC3, RAD21, HDAC8 genes (cohesin complex genes)"
    ],
    "other": [
      "Clinical diagnosis supported by characteristic facial gestalt",
      "Prenatal ultrasound may detect limb abnormalities and growth retardation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "fetal-alcohol-spectrum-disorder",
      "distinguishingFeatures": [
        "History of prenatal alcohol exposure",
        "Facial features differ (smooth philtrum, thin upper lip)",
        "No limb reduction defects typical of CdLS"
      ]
    },
    {
      "diseaseId": "roberts-syndrome",
      "distinguishingFeatures": [
        "Severe limb reduction defects",
        "Cleft lip/palate more common",
        "Distinctive chromosomal abnormalities"
      ]
    }
  ],
  "redFlags": [
    "Severe limb reduction defects",
    "Feeding difficulties with failure to thrive",
    "Developmental delay with seizures"
  ],
