  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Nutcracker Syndrome",
    "criteria": [
      {
        "id": "left-renal-vein-compression",
        "description": "Compression of the left renal vein between the superior mesenteric artery and the aorta demonstrated by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hematuria",
        "description": "Presence of microscopic or macroscopic hematuria",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "left-flank-pain",
        "description": "Chronic or intermittent left flank or abdominal pain",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "venous-hypertension",
        "description": "Evidence of elevated pressure in the left renal vein by venography or Doppler ultrasound",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "varicocele-or-pelvic-congestion",
        "description": "Presence of varicocele in males or pelvic congestion syndrome in females",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of left renal vein compression on imaging plus hematuria and/or left flank pain",
    "notes": "Diagnosis is often supported by Doppler ultrasound, CT angiography, or venography findings combined with clinical symptoms."
  },
