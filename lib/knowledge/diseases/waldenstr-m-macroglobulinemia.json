        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Bone marrow lymphoplasmacytic infiltration plus monoclonal IgM in serum with clinical features consistent with WM and exclusion of other lymphomas",
