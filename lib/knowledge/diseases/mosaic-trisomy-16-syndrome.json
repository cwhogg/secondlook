  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Mosaic Trisomy 16",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Detection of mosaic trisomy 16 in peripheral blood or other tissues by karyotyping or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "prenatal-ultrasound-anomalies",
        "description": "Presence of prenatal ultrasound abnormalities such as intrauterine growth restriction or congenital malformations",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "postnatal-phenotypic-features",
        "description": "Characteristic clinical features including growth retardation, congenital heart defects, and dysmorphic facial features",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of mosaic trisomy 16 plus at least one major clinical feature",
    "notes": "Diagnosis may be complicated by tissue-specific mosaicism and variable phenotypic expression."
  },
