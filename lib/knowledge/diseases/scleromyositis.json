  "differentialDiagnoses": [
    {
      "diseaseId": "systemic-sclerosis",
      "distinguishingFeatures": [
        "Absence of significant muscle weakness or myopathy",
        "Predominant skin and vascular involvement"
      ]
    },
    {
      "diseaseId": "polymyositis",
      "distinguishingFeatures": [
        "Lack of scleroderma skin changes",
        "Different autoantibody profile"
      ]
    },
    {
      "diseaseId": "mixed-connective-tissue-disease",
      "distinguishingFeatures": [
