  "diagnosticCriteria": {
    "formalCriteriaName": "ALG9-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of multisystem involvement including neurological impairment and dysmorphic features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "transferrin-glycosylation",
        "description": "Abnormal serum transferrin glycosylation pattern consistent with type I CDG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the ALG9 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-laboratory",
        "description": "Additional biochemical abnormalities such as elevated liver enzymes or coagulation defects",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus abnormal transferrin glycosylation and confirmation by genetic testing identifying biallelic ALG9 pathogenic variants",
    "notes": "Diagnosis requires integration of clinical, biochemical, and molecular findings."
  },
