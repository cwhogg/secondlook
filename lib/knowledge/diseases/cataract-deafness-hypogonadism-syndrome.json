  "keyFindings": {
    "laboratory": [
      "Low serum testosterone or estradiol levels",
      "Elevated gonadotropins indicating primary hypogonadism",
      "Normal or mildly elevated thyroid antibodies in some cases"
    ],
    "imaging": [
      "Ocular ultrasound showing lens opacities consistent with cataracts",
      "Brain MRI typically normal or nonspecific",
      "Bone age radiographs showing delayed skeletal maturation"
    ],
    "genetic": [
      "No definitive causative gene identified; suspected autosomal recessive inheritance",
      "Genetic testing may exclude other syndromes with overlapping features"
    ],
    "other": [
      "Audiometry confirming bilateral sensorineural hearing loss",
      "Endocrine evaluation confirming hypogonadism"
    ]
  },
