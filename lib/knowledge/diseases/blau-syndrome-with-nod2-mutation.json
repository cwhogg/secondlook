  "diagnosticCriteria": {
    "formalCriteriaName": "Blau Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "arthritis",
        "description": "Chronic symmetric granulomatous arthritis involving multiple joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dermatitis",
        "description": "Papulonodular or maculopapular granulomatous dermatitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "uveitis",
        "description": "Chronic granulomatous anterior or panuveitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nod2-mutation",
        "description": "Presence of pathogenic NOD2 gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (arthritis, dermatitis, and uveitis) with or without confirmed NOD2 mutation",
    "notes": "Genetic testing for NOD2 mutation supports diagnosis but is not mandatory if clinical triad is present"
  },
