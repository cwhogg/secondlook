  "keyFindings": {
    "laboratory": [
      "Reduced glucocerebrosidase enzyme activity in leukocytes or fibroblasts",
      "Anemia and thrombocytopenia",
      "Elevated chitotriosidase levels"
    ],
    "imaging": [
      "MRI showing bone marrow infiltration and osteonecrosis",
      "CT or ultrasound demonstrating hepatosplenomegaly",
      "Brain MRI may show cerebral atrophy or white matter changes"
    ],
    "genetic": [
      "GBA1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Bone marrow biopsy revealing Gaucher cells",
      "Electrophysiological studies may show myoclonic activity"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "gaucher-disease-type-1",
      "distinguishingFeatures": [
        "Absence of neurological symptoms",
        "Later onset and milder course",
        "No oculomotor apraxia or myoclonus"
      ]
    },
    {
      "diseaseId": "neuronopathic-gaucher-disease-type-2",
      "distinguishingFeatures": [
        "Acute and rapidly progressive neurological decline",
        "Onset in infancy",
        "Shorter life expectancy"
      ]
    },
    {
      "diseaseId": "niemann-pick-disease-type-c",
      "distinguishingFeatures": [
        "Vertical supranuclear gaze palsy instead of oculomotor apraxia",
        "Presence of visceral and neurological symptoms",
        "Different genetic mutations (NPC1 or NPC2)"
      ]
    }
  ],
  "redFlags": [
    "Progressive neurological deterioration with oculomotor apraxia",
    "Early onset hepatosplenomegaly with cytopenias",
    "Recurrent bone crises and severe bone involvement"
  ],
