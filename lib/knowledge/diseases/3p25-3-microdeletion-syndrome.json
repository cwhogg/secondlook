  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for 3p25.3 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of heterozygous microdeletion at chromosome 3p25.3 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including microcephaly, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or renal malformations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 3p25.3 microdeletion plus presence of global developmental delay and at least one characteristic craniofacial dysmorphism",
    "notes": "Diagnosis relies heavily on molecular genetic testing combined with clinical features."
  },
