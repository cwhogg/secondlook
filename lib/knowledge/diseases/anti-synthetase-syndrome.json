  "diagnosticCriteria": {
    "formalCriteriaName": "Connor Criteria for Anti-synthetase Syndrome",
    "criteria": [
      {
        "id": "antisynthetase-antibodies",
        "description": "Presence of anti-aminoacyl tRNA synthetase antibodies (e.g., anti-Jo-1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "myositis",
        "description": "Clinical or laboratory evidence of inflammatory myopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "interstitial-lung-disease",
        "description": "Radiographic or histopathologic evidence of interstitial lung disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "arthritis",
        "description": "Non-erosive arthritis involving small joints",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "mechanic-hands",
        "description": "Hyperkeratotic, fissured skin on the lateral and palmar aspects of the fingers",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of anti-synthetase antibodies plus at least two clinical features including myositis, interstitial lung disease, or arthritis",
    "notes": "Diagnosis requires exclusion of other connective tissue diseases and idiopathic inflammatory myopathies."
  },
