  "diagnosticCriteria": {
    "formalCriteriaName": "NINDS-SPSP (National Institute of Neurological Disorders and Stroke and Society for Progressive Supranuclear Palsy) Criteria",
    "criteria": [
      {
        "id": "vertical-gaze-palsy",
        "description": "Progressive supranuclear vertical gaze palsy, especially downgaze impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "postural-instability",
        "description": "Early onset postural instability with falls within the first year of symptom onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "akinetic-rigid-syndrome",
        "description": "Symmetric akinetic-rigid parkinsonism unresponsive to levodopa",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cognitive-dysfunction",
        "description": "Frontal cognitive dysfunction including executive dysfunction and apathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "dysarthria-dysphagia",
        "description": "Progressive dysarthria and dysphagia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of vertical supranuclear gaze palsy and early postural instability with falls, plus symmetric akinetic-rigid syndrome unresponsive to levodopa",
    "notes": "Diagnosis is clinical; imaging and exclusion of other causes support diagnosis"
  },
