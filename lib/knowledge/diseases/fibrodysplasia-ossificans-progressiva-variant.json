  "diagnosticCriteria": {
    "formalCriteriaName": "Atypical FOP Diagnostic Criteria",
    "criteria": [
      {
        "id": "congenital-malformations",
        "description": "Presence of congenital skeletal malformations atypical for classic FOP (e.g., absence of great toe malformations)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "heterotopic-ossification",
        "description": "Progressive heterotopic ossification in characteristic anatomic patterns",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "atypical-genetic-mutations",
        "description": "Identification of atypical ACVR1 gene mutations distinct from classic R206H mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "flare-ups",
        "description": "Recurrent soft tissue flare-ups preceding ossification",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-great-toe-malformation",
        "description": "Lack of great toe malformation typically seen in classic FOP",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive heterotopic ossification plus identification of atypical ACVR1 mutation",
    "notes": "Diagnosis may require genetic testing due to atypical presentation"
  },
