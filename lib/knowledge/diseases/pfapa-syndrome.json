  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (CRP, ESR) during febrile episodes",
      "Normal white blood cell count between episodes",
      "Normal neutrophil counts (helps exclude cyclic neutropenia)"
    ],
    "imaging": [
      "Ultrasound showing cervical lymphadenitis during episodes"
    ],
    "genetic": [
      "No consistent genetic mutation identified; considered sporadic autoinflammatory syndrome"
    ],
    "other": [
      "Rapid response to single-dose corticosteroids during episodes",
      "Resolution of symptoms after tonsillectomy in some cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cyclic-neutropenia",
      "distinguishingFeatures": [
        "Regular 21-day neutrophil count nadir",
        "Neutropenia during febrile episodes",
        "More severe bacterial infections"
      ]
    },
    {
      "diseaseId": "familial-mediterranean-fever",
      "distinguishingFeatures": [
        "Shorter fever episodes (12-72 hours)",
        "Serositis and arthritis common",
        "Genetic mutations in MEFV gene"
      ]
    },
    {
      "diseaseId": "juvenile-rheumatoid-arthritis",
      "distinguishingFeatures": [
        "Persistent arthritis beyond fever episodes",
        "Chronic joint inflammation",
        "Autoimmune markers may be positive"
      ]
    }
  ],
  "redFlags": [
    "Persistent fever beyond typical 3-6 days",
    "Failure to thrive or growth retardation",
    "Neutropenia or abnormal blood counts",
    "Poor response or worsening with corticosteroids"
  ],
