  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Fundus autofluorescence showing zonal hypo- or hyperautofluorescence",
      "Optical coherence tomography (OCT) revealing outer retinal layer disruption",
      "Fluorescein angiography typically normal or showing mild window defects"
    ],
    "genetic": [],
    "other": [
      "Electroretinography demonstrating reduced amplitude in affected zones",
      "Visual field testing confirming zonal scotomas"
    ]
