        "description": "Congenital anal malformations such as anal atresia or stenosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including broad nasal bridge and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-delay",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: congenital ocular anomalies, trichologic abnormalities, and anal malformations",
    "notes": "Diagnosis is clinical; genetic testing may support but is not definitive."
