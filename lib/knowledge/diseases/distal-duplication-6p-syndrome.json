  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and cytogenetic diagnosis of distal 6p duplication",
    "criteria": [
      {
        "id": "chromosomal-duplication",
        "description": "Confirmed duplication of distal 6p region by cytogenetic or molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial features including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital heart defects such as septal defects",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of distal 6p duplication plus presence of at least two major clinical features",
    "notes": "Diagnosis relies heavily on genetic testing due to phenotypic overlap with other chromosomal disorders."
  },
