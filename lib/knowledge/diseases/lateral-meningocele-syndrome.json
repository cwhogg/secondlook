  "differentialDiagnoses": [
    {
      "diseaseId": "marfan-syndrome",
      "distinguishingFeatures": [
        "Aortic root dilation and ectopia lentis",
        "FBN1 gene mutations",
        "Absence of lateral meningoceles"
      ]
    },
    {
      "diseaseId": "neurofibromatosis-type-1",
      "distinguishingFeatures": [
        "Café-au-lait spots and neurofibromas",
        "Optic gliomas",
        "Different genetic etiology (NF1 gene)"
      ]
    },
    {
      "diseaseId": "loeys-dietz-syndrome",
      "distinguishingFeatures": [
        "Arterial tortuosity and aneurysms",
        "Distinct facial features including bifid uvula",
        "Mutations in TGFBR1/2 genes"
      ]
    }
  ],
