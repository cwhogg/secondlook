  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and biochemical diagnostic criteria for sepiapterin reductase deficiency",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Childhood-onset progressive dystonia with diurnal fluctuation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-markers",
        "description": "Reduced cerebrospinal fluid levels of biogenic amines metabolites (HVA and 5-HIAA) with normal pterin profile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the SPR gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "levodopa-response",
        "description": "Marked and sustained clinical improvement with low-dose levodopa therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus biochemical abnormalities and/or biallelic SPR mutations",
    "notes": "CSF neurotransmitter analysis is critical to differentiate from other dopa-responsive dystonias."
  },
