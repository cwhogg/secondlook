  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Alopecia Antibody Deficiency",
    "criteria": [
      {
        "id": "alopecia",
        "description": "Presence of non-scarring patchy alopecia confirmed by clinical examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogammaglobulinemia",
        "description": "Documented decreased serum immunoglobulin levels (IgG, IgA, and/or IgM) consistent with antibody deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoantibodies",
        "description": "Detection of autoantibodies targeting hair follicle antigens",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "recurrent-infections",
        "description": "History of recurrent bacterial infections indicative of immunodeficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of alopecia and immunodeficiency",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of patchy alopecia plus documented antibody deficiency and exclusion of other causes",
    "notes": "Diagnosis relies on combined dermatological and immunological assessment; genetic testing may support diagnosis."
  },
