  "keyFindings": {
    "laboratory": [
      "Non-specific inflammatory markers may be elevated during infections"
    ],
    "imaging": [
      "Chest X-ray showing enlarged tracheal and bronchial diameters",
      "CT scan demonstrating tracheobronchomegaly with thinning of airway walls"
    ],
    "genetic": [
      "No consistent genetic mutation identified; mostly sporadic cases"
    ],
    "other": [
      "Histopathology revealing atrophy of elastic fibers and smooth muscle in airway walls"
    ]
