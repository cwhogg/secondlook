  "keyFindings": {
    "laboratory": [
      "Elevated serum creatinine or markers of renal dysfunction in advanced cases",
      "Normal routine blood counts"
    ],
    "imaging": [
      "Chest X-ray showing narrow, bell-shaped thorax with short ribs",
      "Skeletal survey demonstrating shortened long bones",
      "Renal ultrasound revealing cystic changes",
      "MRI or CT may show hepatic fibrosis"
    ],
    "genetic": [
      "ATN1 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Pulmonary function tests showing restrictive pattern",
      "Histopathology of liver or kidney may show fibrosis or cystic changes"
    ]
  },
