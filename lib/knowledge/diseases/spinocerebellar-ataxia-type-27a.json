  "diagnosticCriteria": {
    "formalCriteriaName": "SCA27A Diagnostic Criteria",
    "criteria": [
      {
        "id": "ataxia",
        "description": "Progressive cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dopamine-dysfunction",
        "description": "Evidence of dopaminergic dysfunction including parkinsonism features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fgf14-mutation",
        "description": "Pathogenic mutation in the FGF14 gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cognitive-impairment",
        "description": "Mild cognitive impairment or psychiatric symptoms such as depression or anxiety",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia, parkinsonism features, and a pathogenic FGF14 mutation",
    "notes": "Diagnosis is confirmed by genetic testing; clinical presentation may vary with age of onset."
  },
