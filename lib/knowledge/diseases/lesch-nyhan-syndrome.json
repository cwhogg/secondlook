        "notes": "Kidney stones secondary to uric acid accumulation"
      },
      {
        "symptomName": "Hypotonia in infancy",
        "frequency": 0.55,
        "bodySystem": "neurological",
        "notes": "Reduced muscle tone during early infancy",
        "searchTerms": [
          "low muscle tone in babies",
          "floppy muscles in infancy",
          "reduced muscle strength in infants"
        ]
      }
