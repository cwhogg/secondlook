  "diagnosticCriteria": {
    "formalCriteriaName": "Adult-Onset Autoinflammatory Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "periodic-fever",
        "description": "Recurrent episodes of unexplained periodic fever lasting days to weeks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "systemic-inflammation",
        "description": "Evidence of systemic inflammation including elevated CRP and ESR during attacks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multi-organ-involvement",
        "description": "Clinical signs of multi-organ involvement such as serositis, arthritis, or rash",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-infections",
        "description": "Exclusion of infectious, malignant, and autoimmune causes",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-anti-inflammatory",
        "description": "Partial or complete response to anti-inflammatory or immunomodulatory therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria plus exclusion of other causes",
    "notes": "Genetic testing may support diagnosis but is not definitive due to heterogeneity"
  },
