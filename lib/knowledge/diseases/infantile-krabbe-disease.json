  "diagnosticCriteria": {
    "formalCriteriaName": "Krabbe Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of galactocerebrosidase (GALC) enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic mutations in the GALC gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive neurodegenerative symptoms including irritability, spasticity, and developmental regression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing demyelination with characteristic involvement of the periventricular white matter",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of GALC enzyme deficiency or pathogenic GALC mutations plus compatible clinical presentation",
    "notes": "Newborn screening and family history may aid early diagnosis"
  },
