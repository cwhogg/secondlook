  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Neuronal Ceroid Lipofuscinosis Type 12",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the ATP13A2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Progressive neurodegeneration with onset in childhood or early adulthood including cognitive decline and movement disorders",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Presence of characteristic lysosomal storage material (lipofuscin) in peripheral tissues or brain biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing cerebral and cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biallelic pathogenic ATP13A2 variants plus compatible clinical features",
    "notes": "Histopathology and neuroimaging findings support diagnosis but are not mandatory."
  },
