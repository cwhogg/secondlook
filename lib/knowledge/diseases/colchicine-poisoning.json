  "keyFindings": {
    "laboratory": [
      "Leukopenia and thrombocytopenia on complete blood count",
      "Elevated liver enzymes",
      "Elevated serum creatinine and blood urea nitrogen",
      "Metabolic acidosis on arterial blood gas"
    ],
    "imaging": [
      "Chest X-ray showing pulmonary edema or acute respiratory distress syndrome",
      "Abdominal imaging may show bowel wall thickening"
    ],
    "genetic": [],
    "other": [
      "Detection of colchicine in blood or urine by toxicology",
      "Electrocardiogram abnormalities including arrhythmias"
    ]
