      ]
    },
    {
      "diseaseId": "nemaline-myopathy",
      "distinguishingFeatures": [
        "Presence of nemaline rods on muscle biopsy",
        "Variable inheritance patterns",
        "Less severe respiratory involvement in some cases"
      ]
    },
    {
      "diseaseId": "congenital-myotonic-dystrophy",
      "distinguishingFeatures": [
        "Characteristic myotonia",
        "CTG repeat expansion in DMPK gene",
        "Facial diplegia and other systemic features"
      ]
    }
