  "keyFindings": {
    "laboratory": [
      "Pancytopenia on complete blood count",
      "Reticulocytopenia",
      "Low serum erythropoietin levels"
    ],
    "imaging": [
      "Bone marrow biopsy showing hypocellularity without fibrosis or malignant infiltration"
    ],
    "genetic": [
      "Somatic mutations in genes such as PIGA, BCOR, and DNMT3A in some cases",
      "No consistent germline mutations in acquired aplastic anemia"
    ],
    "other": [
      "Negative cytogenetics for clonal disorders",
      "Normal or decreased serum iron and ferritin"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "myelodysplastic-syndrome",
      "distinguishingFeatures": [
        "Presence of dysplastic changes in bone marrow",
        "Clonal cytogenetic abnormalities",
        "Hypercellular or normocellular marrow"
      ]
    },
    {
      "diseaseId": "acute-leukemia",
      "distinguishingFeatures": [
        "Presence of blasts in peripheral blood or bone marrow",
        "Hypercellular marrow with malignant infiltration",
        "Rapid clinical progression"
      ]
    },
    {
      "diseaseId": "paroxysmal-nocturnal-hemoglobinuria",
      "distinguishingFeatures": [
        "Complement-mediated hemolysis",
        "Flow cytometry showing CD55/CD59 deficiency",
        "Hemoglobinuria episodes"
      ]
    }
  ],
  "redFlags": [
    "Severe neutropenia with recurrent or severe infections",
    "Profound thrombocytopenia with spontaneous bleeding",
    "Rapid clinical deterioration with pancytopenia"
  ],
