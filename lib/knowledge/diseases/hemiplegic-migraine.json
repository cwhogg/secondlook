  "diagnosticCriteria": {
    "formalCriteriaName": "International Classification of Headache Disorders (ICHD-3) Criteria for Hemiplegic Migraine",
    "criteria": [
      {
        "id": "motor-weakness",
        "description": "Fully reversible motor weakness (hemiparesis) during aura",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "migraine-headache",
        "description": "Headache fulfilling migraine criteria, occurring during or following aura",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aura-symptoms",
        "description": "At least one other fully reversible aura symptom (visual, sensory, or speech/language disturbance)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of hemiplegic migraine (for familial type)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes such as stroke or epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of fully reversible motor weakness during aura plus migraine headache fulfilling criteria and at least one other aura symptom, with exclusion of other causes",
    "notes": "Genetic testing may support diagnosis in familial cases but is not mandatory."
  },
