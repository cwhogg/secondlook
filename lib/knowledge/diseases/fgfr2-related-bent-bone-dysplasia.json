  "diagnosticCriteria": {
    "formalCriteriaName": "FGFR2-related Bent Bone Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "bent-long-bones",
        "description": "Presence of characteristic bent or bowed long bones on radiographic imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fibular-hypoplasia",
        "description": "Hypoplasia or absence of fibulae detected radiographically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fgfr2-pathogenic-variant",
        "description": "Identification of pathogenic FGFR2 gene variant by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of craniofacial abnormalities such as midface hypoplasia or hypertelorism",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-compromise",
        "description": "Respiratory difficulties due to thoracic cage abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Diagnosis requires all three major criteria: bent long bones, fibular hypoplasia, and pathogenic FGFR2 variant identification.",
    "notes": "Molecular confirmation is essential due to phenotypic overlap with other skeletal dysplasias."
  },
