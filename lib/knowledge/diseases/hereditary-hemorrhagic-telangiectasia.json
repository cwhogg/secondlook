  "keyFindings": {
    "laboratory": [
      "Iron deficiency anemia with low serum ferritin",
      "Microcytic hypochromic anemia"
    ],
    "imaging": [
      "Contrast echocardiography or bubble study showing pulmonary AVMs",
      "CT angiography demonstrating AVMs in lungs, liver, or brain",
      "MRI brain for cerebral AVMs"
    ],
    "genetic": [
      "Mutations in ENG (endoglin) gene",
      "Mutations in ACVRL1 (ALK1) gene",
      "Mutations in SMAD4 gene (in combined juvenile polyposis-HHT syndrome)"
    ],
    "other": [
      "Nasal endoscopy showing telangiectasias",
      "Family history consistent with autosomal dominant inheritance"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "blue-rubber-bleb-nevus-syndrome",
      "distinguishingFeatures": [
        "Venous malformations rather than AVMs",
        "Skin lesions are rubbery blue nodules",
        "No recurrent epistaxis typical"
      ]
    },
    {
      "diseaseId": "capillary-malformation-arteriovenous-malformation-syndrome",
      "distinguishingFeatures": [
        "Presence of capillary malformations (port-wine stains)",
        "Different genetic mutations (RASA1)",
        "Distinct clinical features from HHT"
      ]
    }
  ],
  "redFlags": [
    "Sudden onset neurological symptoms indicating cerebral AVM rupture",
    "Severe hypoxemia or cyanosis from pulmonary AVMs",
    "Massive gastrointestinal bleeding causing hemodynamic instability"
  ],
