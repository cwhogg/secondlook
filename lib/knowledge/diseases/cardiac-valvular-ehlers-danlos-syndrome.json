    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "vascular-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Arterial rupture more common and earlier",
        "Thin translucent skin without significant valvular disease",
        "Pathogenic variants in COL3A1 gene"
      ]
    },
    {
      "diseaseId": "classical-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Prominent skin fragility and atrophic scarring",
        "Joint hypermobility without severe valvular involvement",
        "Pathogenic variants in COL5A1 or COL5A2 genes"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of valvular heart disease in young patients",
    "Spontaneous arterial rupture or dissection",
