  "differentialDiagnoses": [
    {
      "diseaseId": "leukonychia-partialis",
      "distinguishingFeatures": [
        "Partial or localized white spots or bands on nails rather than total whitening",
        "Often transient and associated with trauma or systemic illness"
      ]
    },
    {
      "diseaseId": "onychomycosis",
      "distinguishingFeatures": [
        "Nail plate thickening, subungual debris, and positive fungal cultures",
        "Often asymmetrical and involves nail dystrophy"
      ]
    },
    {
      "diseaseId": "pseudoleukonychia",
      "distinguishingFeatures": [
        "White nail discoloration due to external factors such as nail polish or trauma",
        "Reversible with removal of causative agent"
      ]
    }
  ],
