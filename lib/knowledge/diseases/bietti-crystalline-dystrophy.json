  "diagnosticCriteria": {
    "formalCriteriaName": "BCD Diagnostic Criteria",
    "criteria": [
      {
        "id": "crystalline-deposits",
        "description": "Presence of characteristic yellow-white crystalline deposits in the retina",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-chorioretinal-atrophy",
        "description": "Progressive chorioretinal atrophy observed on fundus examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cyp4v2-mutation",
        "description": "Identification of pathogenic mutations in the CYP4V2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroretinogram-abnormalities",
        "description": "Electroretinogram (ERG) showing reduced rod and cone responses",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of crystalline retinal deposits and progressive chorioretinal atrophy with confirmation of CYP4V2 mutation",
    "notes": "Diagnosis is supported by clinical findings and confirmed by genetic testing."
  },
