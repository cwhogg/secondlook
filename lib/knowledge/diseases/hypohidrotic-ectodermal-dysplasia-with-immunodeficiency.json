  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Hypohidrotic Ectodermal Dysplasia with Immunodeficiency",
    "criteria": [
      {
        "id": "ectodermal-dysplasia-features",
        "description": "Presence of characteristic ectodermal dysplasia features including hypotrichosis, hypohidrosis, and hypodontia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency-evidence",
        "description": "Laboratory evidence of immunodeficiency such as low immunoglobulin levels or impaired lymphocyte function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with HED-ID (e.g., IKBKG/NEMO mutations)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-infections",
        "description": "History of recurrent bacterial, viral, or fungal infections",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic ectodermal dysplasia features plus laboratory evidence of immunodeficiency and/or genetic confirmation",
    "notes": "Genetic testing is critical for definitive diagnosis; clinical presentation can vary in severity."
  },
