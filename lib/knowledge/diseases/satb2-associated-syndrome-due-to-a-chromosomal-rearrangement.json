        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-features",
        "description": "Behavioral abnormalities including autism spectrum disorder features",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of global developmental delay, characteristic craniofacial features, and genetic confirmation of SATB2 chromosomal rearrangement",
    "notes": "Diagnosis is confirmed by molecular genetic testing identifying chromosomal rearrangements affecting SATB2."
