  "diagnosticCriteria": {
    "formalCriteriaName": "Folinic Acid-Responsive Seizures Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-seizures",
        "description": "Presence of refractory seizures unresponsive to standard antiepileptic drugs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "folinic-acid-response",
        "description": "Seizure control or significant improvement after administration of folinic acid",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-markers",
        "description": "Normal or mildly abnormal cerebrospinal fluid folate levels without other metabolic abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in folate metabolism-related genes (e.g., FOLR1) supports diagnosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of refractory seizures with documented clinical response to folinic acid therapy",
    "notes": "Diagnosis is primarily clinical supported by therapeutic response; genetic and biochemical testing aid confirmation."
  },
