    "formalCriteriaName": "Idiopathic Left Ventricular Aneurysm Diagnostic Criteria",
    "criteria": [
      {
        "id": "aneurysm-localization",
        "description": "Presence of a localized outpouching of the left ventricular wall confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-infarction-history",
        "description": "No prior history or evidence of myocardial infarction or ischemic heart disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ventricular-function",
        "description": "Left ventricular systolic function may be preserved or mildly reduced",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of ventricular aneurysm such as trauma, infection, or congenital malformations",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of localized left ventricular aneurysm on imaging without prior infarction and exclusion of other causes",
    "notes": "Diagnosis relies heavily on imaging and clinical history to exclude ischemic and other secondary causes."
  },
