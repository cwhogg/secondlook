  "keyFindings": {
    "laboratory": [
      "Severe thrombocytopenia (platelet count <20,000/µL)",
      "Normal or reduced white blood cell and red blood cell counts",
      "Bone marrow biopsy showing absent or markedly reduced megakaryocytes"
    ],
    "imaging": [
      "Occasional splenomegaly on abdominal ultrasound"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Exclusion of immune thrombocytopenic purpura by lack of platelet antibodies",
      "No response to immunosuppressive therapy"
    ]
  },
  "differentialDiagnoses": [
