  "diagnosticCriteria": {
    "formalCriteriaName": "Odontochondrodysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "dental-anomalies",
        "description": "Presence of severe dental abnormalities including hypoplastic enamel and delayed tooth eruption",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-dysplasia",
        "description": "Radiographic evidence of short-limbed dwarfism with metaphyseal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation with short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in the TRIP11 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of dental anomalies and skeletal dysplasia confirmed by radiographic findings plus identification of TRIP11 mutation or consistent clinical features",
    "notes": "Diagnosis is primarily clinical supported by radiographic and genetic testing."
  },
