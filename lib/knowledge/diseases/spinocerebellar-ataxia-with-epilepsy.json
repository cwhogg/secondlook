  "differentialDiagnoses": [
    {
      "diseaseId": "friedreich-ataxia",
      "distinguishingFeatures": [
        "Onset typically earlier in childhood",
        "Cardiomyopathy and diabetes mellitus common",
        "Absent epilepsy in most cases"
      ]
    },
    {
      "diseaseId": "episodic-ataxia-type-2",
      "distinguishingFeatures": [
        "Paroxysmal ataxia episodes rather than progressive",
        "Associated with migraine and vertigo",
        "Epilepsy less common"
      ]
    },
    {
      "diseaseId": "mitochondrial-encephalopathy",
      "distinguishingFeatures": [
        "Multisystem involvement including muscle weakness and lactic acidosis",
        "Variable CNS manifestations including stroke-like episodes",
        "Genetic testing reveals mitochondrial DNA mutations"
      ]
    }
  ],
  "redFlags": [
