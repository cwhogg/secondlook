  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (CK) levels",
      "Normal inflammatory markers"
    ],
    "imaging": [
      "Muscle MRI showing fatty replacement and atrophy of proximal muscles",
      "Chest X-ray or pulmonary function tests indicating restrictive lung disease in advanced cases"
    ],
    "genetic": [
      "PLEC (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy demonstrating intraepidermal blistering with keratinocyte cytolysis",
      "Immunohistochemistry showing absence or reduction of plectin protein"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "epidermolysis-bullosa-simplex",
      "distinguishingFeatures": [
        "Skin blistering without muscular dystrophy",
        "No PLEC gene mutations associated with muscular involvement"
      ]
    },
    {
      "diseaseId": "limb-girdle-muscular-dystrophy",
      "distinguishingFeatures": [
        "Progressive proximal muscle weakness without skin blistering",
        "Different genetic mutations (e.g., CAPN3, DYSF)"
      ]
    },
    {
      "diseaseId": "junctional-epidermolysis-bullosa",
      "distinguishingFeatures": [
        "Blistering at the level of the lamina lucida",
        "More severe mucocutaneous involvement without muscular dystrophy"
      ]
    }
  ],
  "redFlags": [
