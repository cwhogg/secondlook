  "diagnosticCriteria": {
    "formalCriteriaName": "TELO2-related intellectual disability diagnostic criteria",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microcephaly",
        "description": "Congenital or postnatal microcephaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-hypoplasia",
        "description": "Neuroimaging evidence of cerebellar hypoplasia or vermis hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent forehead, hypertelorism, and broad nasal bridge",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "Presence of seizures or epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of intellectual disability, microcephaly, and cerebellar hypoplasia confirmed by neuroimaging, plus identification of pathogenic TELO2 variant",
    "notes": "Genetic confirmation via TELO2 gene sequencing is essential for definitive diagnosis."
  },
