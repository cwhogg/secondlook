  "diagnosticCriteria": {
    "formalCriteriaName": "Overlap Myositis Diagnostic Criteria",
    "criteria": [
      {
        "id": "proximal-muscle-weakness",
        "description": "Symmetrical proximal muscle weakness affecting limb girdle muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serologic-autoantibodies",
        "description": "Presence of myositis-specific or myositis-associated autoantibodies (e.g., anti-RNP, anti-Jo-1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy-inflammation",
        "description": "Muscle biopsy showing inflammatory myopathy with features overlapping other connective tissue diseases",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-overlap-features",
        "description": "Clinical features of other connective tissue diseases such as Raynaud phenomenon, arthritis, or sclerodactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-muscle-enzymes",
        "description": "Elevated serum creatine kinase or aldolase levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of symmetrical proximal muscle weakness, positive myositis-specific or associated autoantibodies, and muscle biopsy confirming inflammatory myopathy with overlap features",
    "notes": "Overlap myositis diagnosis requires exclusion of pure dermatomyositis or polymyositis and identification of overlapping connective tissue disease features."
  },
