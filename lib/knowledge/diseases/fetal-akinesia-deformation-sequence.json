  "diagnosticCriteria": {
    "formalCriteriaName": "Fetal Akinesia Deformation Sequence Diagnostic Criteria",
    "criteria": [
      {
        "id": "akinesia",
        "description": "Reduced or absent fetal movements detected prenatally or postnatally",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multiple-contractures",
        "description": "Presence of multiple congenital joint contractures (arthrogryposis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-deformations",
        "description": "Characteristic craniofacial abnormalities including micrognathia, cleft palate, and low-set ears",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-hypoplasia",
        "description": "Evidence of pulmonary hypoplasia or respiratory insufficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "polyhydramnios",
        "description": "Prenatal ultrasound evidence of polyhydramnios",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of fetal akinesia, multiple congenital contractures, and characteristic craniofacial deformations",
    "notes": "Diagnosis is primarily clinical supported by prenatal imaging and genetic testing when available."
  },
