  "diagnosticCriteria": {
    "formalCriteriaName": "ARC Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "arthrogryposis",
        "description": "Congenital joint contractures affecting multiple joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-dysfunction",
        "description": "Renal tubular dysfunction manifesting as Fanconi syndrome or renal tubular acidosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cholestasis",
        "description": "Intrahepatic cholestasis with elevated serum bile acids and conjugated hyperbilirubinemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "platelet-abnormalities",
        "description": "Platelet secretion defects leading to bleeding diathesis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ichthyosis",
        "description": "Congenital ichthyosis or skin scaling",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: arthrogryposis, renal tubular dysfunction, and cholestasis",
    "notes": "Genetic testing for VPS33B or VIPAS39 mutations supports diagnosis"
  },
