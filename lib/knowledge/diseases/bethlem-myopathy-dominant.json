  "diagnosticCriteria": {
    "formalCriteriaName": "Bethlem Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of proximal muscle weakness and distal contractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in COL6A1, COL6A2, or COL6A3 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing collagen VI deficiency or characteristic myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging",
        "description": "Muscle MRI showing selective involvement of specific muscle groups",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical features plus either a positive family history or pathogenic variant in COL6 genes",
    "notes": "Genetic confirmation is considered definitive; muscle biopsy and imaging are supportive."
  },
