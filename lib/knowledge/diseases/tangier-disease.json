  "diagnosticCriteria": {
    "formalCriteriaName": "Tangier Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "hdl-deficiency",
        "description": "Markedly reduced or absent high-density lipoprotein (HDL) cholesterol levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "orange-tonsils",
        "description": "Presence of characteristic orange-colored tonsils due to cholesterol ester accumulation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abc1-gene-mutation",
        "description": "Identification of biallelic mutations in the ABCA1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuropathy",
        "description": "Peripheral neuropathy with sensory and motor involvement",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hepatosplenomegaly",
        "description": "Enlargement of liver and spleen detected clinically or by imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of markedly reduced HDL cholesterol, characteristic orange tonsils, and biallelic ABCA1 gene mutations",
    "notes": "Diagnosis is confirmed by genetic testing and clinical features; lipid profile is essential for screening."
  },
