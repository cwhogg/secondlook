  "keyFindings": {
    "laboratory": [
      "Reduced iduronate-2-sulfatase enzyme activity in leukocytes or fibroblasts",
      "Elevated urinary glycosaminoglycans (dermatan sulfate and heparan sulfate)"
    ],
    "imaging": [
      "Skeletal X-rays showing dysostosis multiplex",
      "Cardiac echocardiography revealing valvular thickening and cardiomyopathy",
      "Brain MRI may show mild atrophy or hydrocephalus in some cases"
    ],
    "genetic": [
      "Pathogenic variants in the IDS gene on chromosome Xq28",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Electrodiagnostic studies may show carpal tunnel syndrome",
      "Audiometry demonstrating hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "mucopolysaccharidosis-type-1",
      "distinguishingFeatures": [
        "Presence of corneal clouding more prominent in MPS I",
        "Different enzyme deficiency (alpha-L-iduronidase)",
        "More severe cognitive impairment in Hurler syndrome subtype"
      ]
    },
    {
      "diseaseId": "mucopolysaccharidosis-type-6",
      "distinguishingFeatures": [
        "Arylsulfatase B deficiency",
        "No cognitive impairment",
        "Corneal clouding present"
      ]
    }
  ],
