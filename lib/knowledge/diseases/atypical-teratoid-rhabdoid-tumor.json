  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of CNS Tumors",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of rhabdoid tumor cells with characteristic morphology on histopathological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Loss of INI1 (SMARCB1) protein expression by immunohistochemistry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "molecular-genetics",
        "description": "Detection of SMARCB1 or SMARCA4 gene alterations by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-features",
        "description": "Imaging showing a large, heterogeneous, often contrast-enhancing CNS mass",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of rhabdoid tumor cells with loss of INI1 expression and/or molecular confirmation of SMARCB1/SMARCA4 alterations",
    "notes": "Diagnosis requires integration of histology, immunohistochemistry, and molecular genetics per WHO CNS tumor guidelines."
  },
