  "keyFindings": {
    "laboratory": [
      "Markedly elevated methylmalonic acid in plasma and urine",
      "Metabolic acidosis with increased anion gap",
      "Hyperammonemia during metabolic crises",
      "Elevated lactate levels"
    ],
    "imaging": [
      "Brain MRI may show basal ganglia abnormalities",
      "Renal ultrasound may reveal nephrocalcinosis or renal impairment"
    ],
    "genetic": [
      "Biallelic pathogenic mutations in the MUT gene consistent with Mut0 phenotype"
    ],
    "other": [
      "Complete absence or near absence of methylmalonyl-CoA mutase enzyme activity in fibroblast or liver assays"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "propionic-acidemia",
      "distinguishingFeatures": [
        "Elevated propionic acid rather than methylmalonic acid",
        "Deficiency of propionyl-CoA carboxylase enzyme",
        "Different genetic mutations (PCCA or PCCB genes)"
      ]
    },
    {
      "diseaseId": "cobalamin-deficiency-methylmalonic-acidemia",
      "distinguishingFeatures": [
        "Secondary methylmalonic acidemia due to cobalamin metabolism defects",
        "Responds to vitamin B12 supplementation",
        "Different genetic causes (e.g. MMACHC mutations)"
      ]
    }
  ],
  "redFlags": [
    "Recurrent severe metabolic ketoacidosis in infancy",
    "Rapid neurological deterioration during metabolic crises",
    "Persistent hyperammonemia unresponsive to standard treatments"
  ],
