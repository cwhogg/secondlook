  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for limb-girdle muscular dystrophies",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness predominantly affecting pelvic and shoulder girdles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes with reduced or absent alpha-sarcoglycan protein expression on immunohistochemistry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the SGCA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-ck",
        "description": "Elevated serum creatine kinase levels (typically 5-50 times normal)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "Electromyography showing myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal muscle weakness with either muscle biopsy showing alpha-sarcoglycan deficiency or pathogenic SGCA gene variants",
    "notes": "Genetic confirmation is considered definitive; muscle biopsy and clinical features support diagnosis."
  },
