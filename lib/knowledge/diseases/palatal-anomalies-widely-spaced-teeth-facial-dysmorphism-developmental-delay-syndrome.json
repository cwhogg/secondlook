  "diagnosticCriteria": {
    "formalCriteriaName": "PAWTFDD Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "palatal-anomaly",
        "description": "Presence of congenital palatal anomalies such as cleft or high-arched palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "widely-spaced-teeth",
        "description": "Widely spaced dentition with abnormal tooth morphology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including broad nasal bridge, hypertelorism, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay affecting motor and cognitive milestones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-features",
        "description": "Additional features such as hypotonia, feeding difficulties, and speech delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all four major criteria: palatal anomaly, widely spaced teeth, facial dysmorphism, and developmental delay",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
