  "diagnosticCriteria": {
    "formalCriteriaName": "SLSJ Congenital Lactic Acidosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-lactate",
        "description": "Persistent elevated blood lactate levels (>5 mmol/L) in absence of hypoxia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-deterioration",
        "description": "Progressive neurological deterioration including hypotonia and developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the LRPPRC gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-acidosis",
        "description": "Chronic metabolic acidosis with elevated anion gap",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "brain-imaging-abnormalities",
        "description": "MRI showing cerebral atrophy and basal ganglia abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent elevated lactate, progressive neurological deterioration, and genetic confirmation of LRPPRC mutation",
    "notes": "Diagnosis requires exclusion of other causes of lactic acidosis and mitochondrial disorders."
  },
