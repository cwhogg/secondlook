  "diagnosticCriteria": {
    "formalCriteriaName": "Rh Deficiency Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "absent-rh-antigens",
        "description": "Complete absence of Rh antigens on red blood cells demonstrated by serological testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chronic-hemolytic-anemia",
        "description": "Presence of chronic hemolytic anemia with reticulocytosis and mild to moderate anemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-red-cell-morphology",
        "description": "Presence of stomatocytes and spherocytes on peripheral blood smear",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or family history of similar hematological findings",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of absent Rh antigens on red blood cells plus chronic hemolytic anemia",
    "notes": "Diagnosis is confirmed by serological and molecular testing of Rh antigen expression."
  },
