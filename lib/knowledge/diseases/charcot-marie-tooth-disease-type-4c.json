  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnostic criteria for CMT4C",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Symmetric distal muscle weakness and atrophy predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensory-loss",
        "description": "Distal sensory loss with decreased proprioception and vibration sense",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "scoliosis",
        "description": "Presence of early-onset scoliosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the SH3TC2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-conduction",
        "description": "Electrophysiological evidence of demyelinating peripheral neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of clinical neuropathy with demyelinating features plus genetic confirmation of SH3TC2 mutations",
    "notes": "Early scoliosis is a common supportive feature but not mandatory for diagnosis."
  },
