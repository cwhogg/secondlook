  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electromyographic Diagnostic Criteria for Myotonia Congenita",
    "criteria": [
      {
        "id": "clinical-myotonia",
        "description": "Presence of delayed muscle relaxation after voluntary contraction (clinical myotonia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyographic-myotonia",
        "description": "Electromyography demonstrating myotonic discharges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the CLCN1 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant or recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical myotonia and electromyographic myotonic discharges; genetic confirmation supports diagnosis",
    "notes": "Genetic testing is confirmatory but not always necessary if clinical and EMG findings are definitive."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Delayed muscle relaxation after voluntary contraction",
        "frequency": 0.95,
        "bodySystem": "musculoskeletal",
        "notes": "Classic myotonia causing stiffness"
      },
      {
        "symptomName": "Myotonic discharges on electromyography",
        "frequency": 0.9,
        "bodySystem": "neurological",
        "notes": "Characteristic EMG finding"
      },
      {
        "symptomName": "Muscle stiffness improving with repeated activity (warm-up phenomenon)",
        "frequency": 0.85,
        "bodySystem": "musculoskeletal",
        "notes": "Typical clinical feature"
      }
    ],
    "common": [
      {
        "symptomName": "Muscle hypertrophy",
        "frequency": 0.75,
        "bodySystem": "musculoskeletal",
        "notes": "Especially in Becker type"
      },
      {
        "symptomName": "Muscle cramps",
        "frequency": 0.7,
        "bodySystem": "musculoskeletal",
        "notes": "Often painful"
      },
      {
        "symptomName": "Transient weakness after rest",
        "frequency": 0.65,
        "bodySystem": "musculoskeletal",
        "notes": "More common in Becker type"
      },
      {
        "symptomName": "Percussion myotonia",
        "frequency": 0.6,
        "bodySystem": "musculoskeletal",
        "notes": "Delayed relaxation after muscle percussion"
      },
      {
        "symptomName": "Mild muscle weakness",
        "frequency": 0.55,
        "bodySystem": "musculoskeletal",
        "notes": "Usually mild or absent"
      }
    ],
    "occasional": [
      {
        "symptomName": "Facial muscle stiffness",
        "frequency": 0.4,
        "bodySystem": "musculoskeletal",
        "notes": "May affect expression"
      },
      {
        "symptomName": "Cold sensitivity exacerbating stiffness",
        "frequency": 0.35,
        "bodySystem": "musculoskeletal",
        "notes": "Symptoms worsen in cold environments"
      },
      {
        "symptomName": "Difficulty releasing grip",
        "frequency": 0.3,
        "bodySystem": "musculoskeletal",
        "notes": "Common in hand muscles"
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.25,
