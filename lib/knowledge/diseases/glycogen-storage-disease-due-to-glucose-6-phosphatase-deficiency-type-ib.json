  "differentialDiagnoses": [
    {
      "diseaseId": "glycogen-storage-disease-type-ia",
      "distinguishingFeatures": [
        "Absence of neutropenia",
        "Mutations in G6PC gene instead of SLC37A4",
        "Similar hypoglycemia and hepatomegaly but no immune dysfunction"
      ]
    },
    {
      "diseaseId": "glycogen-storage-disease-type-ix",
      "distinguishingFeatures": [
        "Phosphorylase kinase deficiency",
        "Milder hypoglycemia",
        "No neutropenia or immune defects"
      ]
    }
  ],
