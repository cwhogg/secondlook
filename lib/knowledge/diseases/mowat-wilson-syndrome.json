  "keyFindings": {
    "laboratory": [
      "Genetic testing identifying pathogenic variants in ZEB2 gene",
      "Histopathology of rectal biopsy showing absence of ganglion cells in Hirschsprung disease"
    ],
    "imaging": [
      "Brain MRI showing agenesis or hypoplasia of corpus callosum",
      "Echocardiogram revealing congenital heart defects"
    ],
    "genetic": [
      "Heterozygous pathogenic mutation or deletion in ZEB2 gene (chromosome 2q22)",
      "De novo mutations are most common"
    ],
    "other": [
      "Characteristic facial features observed clinically",
      "Developmental assessments confirming intellectual disability"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "angelman-syndrome",
      "distinguishingFeatures": [
        "Ataxic gait and frequent laughter",
        "UBE3A gene mutation",
        "Absence of Hirschsprung disease"
      ]
    },
    {
      "diseaseId": "goldenhar-syndrome",
      "distinguishingFeatures": [
        "Hemifacial microsomia and ear anomalies",
        "No intellectual disability in most cases",
        "No Hirschsprung disease"
      ]
    },
    {
      "diseaseId": "rett-syndrome",
      "distinguishingFeatures": [
        "Regression of developmental milestones after 6-18 months",
        "MECP2 gene mutation",
        "Characteristic hand-wringing movements"
      ]
    }
  ],
