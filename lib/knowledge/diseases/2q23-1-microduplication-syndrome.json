  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Brain MRI may show nonspecific white matter abnormalities or delayed myelination",
      "Spinal X-rays may reveal scoliosis"
    ],
    "genetic": [
      "Microduplication of chromosome 2q23.1 region detected by chromosomal microarray or FISH",
      "Involves duplication of MBD5 gene among others"
    ],
    "other": [
      "Electroencephalogram (EEG) abnormalities in patients with seizures"
    ]
  },
  "differentialDiagnoses": [
