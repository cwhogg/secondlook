  "keyFindings": {
    "laboratory": [
      "Clonal T-cell receptor gene rearrangement detected by PCR",
      "Peripheral blood smear usually normal in early stages",
      "Elevated lactate dehydrogenase (LDH) in advanced disease"
    ],
    "imaging": [
      "CT or PET-CT may show lymphadenopathy or visceral involvement in advanced stages"
    ],
    "genetic": [
      "CTLA4 (fusion gene)",
      "TNFRSF1B (somatic)",
      "CD28 (fusion gene)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Skin biopsy demonstrating epidermotropism of atypical lymphocytes",
      "Immunohistochemistry showing CD3+, CD4+ T-cells with loss of CD7"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sezary-syndrome",
      "distinguishingFeatures": [
        "Presence of circulating malignant T-cells (Sezary cells) in blood",
        "Generalized erythroderma and lymphadenopathy",
        "More aggressive clinical course"
      ]
    },
    {
      "diseaseId": "psoriasis",
      "distinguishingFeatures": [
        "Well-demarcated plaques with silvery scale",
        "Absence of atypical lymphocytes on biopsy",
        "Lack of T-cell clonality"
      ]
    },
    {
      "diseaseId": "chronic-eczema",
      "distinguishingFeatures": [
        "History of atopy or allergen exposure",
        "Polymorphic inflammatory infiltrate without atypical lymphocytes",
        "Improvement with corticosteroids"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of skin lesions to tumors",
    "Development of generalized erythroderma",
    "Presence of systemic symptoms such as unexplained weight loss or night sweats"
  ],
