  "diagnosticCriteria": {
    "formalCriteriaName": "Cyclic Neutropenia Diagnostic Criteria",
    "criteria": [
      {
        "id": "cyclic-neutrophil-count",
        "description": "Regular oscillations of absolute neutrophil count with cycles approximately every 21 days",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-infections",
        "description": "Recurrent infections during neutropenic nadirs such as stomatitis, pharyngitis, and skin infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elane-mutation",
        "description": "Presence of pathogenic ELANE gene mutation identified by genetic testing",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "bone-marrow-exam",
        "description": "Bone marrow showing maturation arrest of myeloid lineage during neutropenic phases",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Documented cyclic neutropenia with regular 21-day neutrophil count oscillations plus recurrent infections during neutropenic phases",
    "notes": "Genetic testing for ELANE mutations supports diagnosis but is not mandatory"
  },
