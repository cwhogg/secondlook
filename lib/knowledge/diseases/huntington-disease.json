  "differentialDiagnoses": [
    {
      "diseaseId": "dystonia",
      "distinguishingFeatures": [
        "Lack of CAG repeat expansion",
        "Predominantly sustained muscle contractions without chorea",
        "No progressive cognitive decline"
      ]
    },
    {
      "diseaseId": "wilson-disease",
      "distinguishingFeatures": [
        "Presence of Kayser-Fleischer rings",
        "Abnormal copper metabolism",
        "Younger age of onset and hepatic involvement"
      ]
    },
    {
      "diseaseId": "parkinson-disease",
      "distinguishingFeatures": [
        "Predominant resting tremor and rigidity",
        "No chorea",
        "No HTT gene mutation"
      ]
    }
  ],
