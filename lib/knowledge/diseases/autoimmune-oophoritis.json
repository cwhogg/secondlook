  "diagnosticCriteria": {
    "formalCriteriaName": "Autoimmune Oophoritis Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-pof",
        "description": "Clinical evidence of premature ovarian failure (amenorrhea >4 months before age 40 with elevated gonadotropins)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoantibodies",
        "description": "Presence of anti-ovarian antibodies detected by immunoassays",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Ovarian biopsy showing lymphocytic infiltration consistent with autoimmune oophoritis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "associated-autoimmune-disease",
        "description": "Coexisting autoimmune disorders such as autoimmune adrenalitis or autoimmune thyroiditis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical premature ovarian failure and positive anti-ovarian antibodies; histopathology supportive if available",
    "notes": "Ovarian biopsy is rarely performed due to invasiveness; diagnosis often based on clinical and serological findings"
  },
