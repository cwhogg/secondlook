        "requiredForDiagnosis": true
      },
      {
        "id": "brain-iron-accumulation",
        "description": "MRI evidence of iron accumulation in basal ganglia and other brain regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ftl1-mutation",
        "description": "Identification of pathogenic mutation in the FTL1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-nbai",
        "description": "Exclusion of other neurodegeneration with brain iron accumulation (NBIA) disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive movement disorder, MRI evidence of brain iron accumulation, and pathogenic FTL1 gene mutation",
    "notes": "Genetic testing is essential for definitive diagnosis."
  },
