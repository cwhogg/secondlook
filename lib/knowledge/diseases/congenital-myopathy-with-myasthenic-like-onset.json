  "keyFindings": {
    "laboratory": [
      "Normal or mildly elevated creatine kinase",
      "Normal acetylcholine receptor antibody levels"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle involvement with fatty infiltration",
      "Chest imaging may reveal restrictive lung disease"
    ],
    "genetic": [
      "RYR1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography with decremental response on repetitive nerve stimulation",
      "Muscle biopsy showing congenital myopathy features without dystrophic changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-myasthenic-syndrome",
      "distinguishingFeatures": [
        "Typically shows good response to acetylcholinesterase inhibitors",
