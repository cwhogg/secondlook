  "diagnosticCriteria": {
    "formalCriteriaName": "McArdle Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "exercise-intolerance",
        "description": "History of exercise intolerance with premature fatigue and muscle cramps",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "myophosphorylase-deficiency",
        "description": "Demonstration of myophosphorylase deficiency in muscle biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the PYGM gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "second-wind-phenomenon",
        "description": "Presence of second-wind phenomenon during exercise testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-creatine-kinase",
        "description": "Elevated serum creatine kinase levels at rest or after exercise",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of exercise intolerance plus either myophosphorylase deficiency on muscle biopsy or pathogenic PYGM mutations",
    "notes": "Second-wind phenomenon and elevated CK levels support diagnosis but are not mandatory"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Exercise intolerance with premature fatigue",
        "frequency": 0.95,
        "bodySystem": "musculoskeletal",
        "notes": "Typically triggered by isometric or dynamic exercise"
      },
      {
        "symptomName": "Second-wind phenomenon",
        "frequency": 0.85,
        "bodySystem": "musculoskeletal",
        "notes": "Improvement in exercise tolerance after brief rest"
      },
      {
        "symptomName": "Muscle cramps during or immediately after exercise",
        "frequency": 0.75,
        "bodySystem": "musculoskeletal"
      }
    ],
    "common": [
      {
        "symptomName": "Myoglobinuria (dark urine) after intense exercise",
        "frequency": 0.65,
        "bodySystem": "renal",
        "notes": "Due to rhabdomyolysis"
      },
      {
        "symptomName": "Muscle weakness post-exercise",
        "frequency": 0.6,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Fatigue disproportionate to exertion",
