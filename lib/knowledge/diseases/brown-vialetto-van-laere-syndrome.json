  "keyFindings": {
    "laboratory": [
      "Low plasma riboflavin levels",
      "Elevated acylcarnitines in blood",
      "Normal routine blood counts"
    ],
    "imaging": [
      "Brain MRI showing pontine and medullary atrophy",
      "Optic nerve atrophy on orbital MRI"
    ],
    "genetic": [
      "Pathogenic variants in SLC52A2 or SLC52A3 genes"
    ],
    "other": [
      "Electromyography showing denervation",
      "Audiometry confirming sensorineural hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "motor-neuron-disease",
