  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for Sialidosis Type II",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of alpha-neuraminidase enzyme activity in cultured fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of coarse facial features, hepatosplenomegaly, and dysostosis multiplex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the NEU1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-oligosaccharides",
        "description": "Elevated urinary excretion of bound sialic acid-containing oligosaccharides",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of alpha-neuraminidase enzyme activity plus either characteristic clinical features or pathogenic NEU1 gene mutations",
    "notes": "Diagnosis is confirmed by biochemical enzyme assay and genetic testing; clinical features support diagnosis."
  },
