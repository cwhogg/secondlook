  "keyFindings": {
    "laboratory": [
      "Monoclonal gammopathy with lambda light chain restriction",
      "Elevated vascular endothelial growth factor (VEGF) levels",
      "Thrombocytosis or polycythemia"
    ],
    "imaging": [
      "Sclerotic bone lesions on X-ray, CT, or MRI",
      "Organomegaly on abdominal ultrasound or CT",
      "Pleural effusions or ascites on chest/abdominal imaging"
    ],
    "genetic": [
      "No specific genetic mutation identified; associated with plasma cell dyscrasia"
    ],
    "other": [
      "Nerve conduction studies showing demyelinating polyneuropathy",
      "Lymph node biopsy may show Castleman disease-like features"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "chronic-inflammatory-demyelinating-polyneuropathy",
      "distinguishingFeatures": [
        "Absence of monoclonal plasma cell disorder",
        "Lack of sclerotic bone lesions",
        "No endocrinopathy or characteristic skin changes"
      ]
    },
    {
      "diseaseId": "multiple-myeloma",
      "distinguishingFeatures": [
        "Lytic rather than sclerotic bone lesions",
        "Different pattern of neuropathy",
        "Absence of characteristic endocrinopathies and skin changes"
      ]
    },
    {
      "diseaseId": "castleman-disease",
      "distinguishingFeatures": [
        "Lymphadenopathy predominant without polyneuropathy",
        "No monoclonal plasma cell disorder",
        "Different systemic manifestations"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive demyelinating polyneuropathy",
    "Presence of monoclonal plasma cell disorder with systemic symptoms",
    "Development of sclerotic bone lesions with multisystem involvement"
  ],
