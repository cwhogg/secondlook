      },
      {
        "id": "pathogenic-foxg1-mutation",
        "description": "Identification of pathogenic FOXG1 gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of severe developmental delay, microcephaly, and a pathogenic FOXG1 mutation",
