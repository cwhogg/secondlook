  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "No specific biochemical markers"
    ],
    "imaging": [
      "MRI brain may show mild cerebral or cerebellar atrophy",
      "Spinal cord MRI typically normal"
    ],
    "genetic": [
      "SPART (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography may show evidence of peripheral neuropathy",
      "Neurophysiological studies consistent with upper motor neuron involvement"
    ]
  },
