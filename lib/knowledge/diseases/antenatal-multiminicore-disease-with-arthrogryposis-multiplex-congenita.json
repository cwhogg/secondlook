  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate elevation)",
      "Normal or mildly elevated lactate dehydrogenase"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle involvement with fatty infiltration",
      "Chest X-ray demonstrating diaphragmatic elevation or hypoventilation"
    ],
    "genetic": [
      "Pathogenic variants in SEPN1, RYR1, or other genes associated with multiminicore myopathy"
    ],
    "other": [
      "Muscle biopsy revealing multiple small cores with reduced oxidative enzyme activity",
      "Electromyography consistent with myopathic pattern"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "central-core-disease",
      "distinguishingFeatures": [
        "Presence of central cores rather than multiple small cores on muscle biopsy",
        "Usually milder arthrogryposis",
        "Often associated with RYR1 mutations but different histopathology"
      ]
    },
    {
      "diseaseId": "nemaline-myopathy",
      "distinguishingFeatures": [
        "Presence of nemaline rods on muscle biopsy",
        "Less frequent arthrogryposis multiplex congenita",
        "Different genetic mutations (e.g., NEB, ACTA1)"
      ]
    }
  ],
  "redFlags": [
    "Severe neonatal respiratory failure requiring ventilatory support",
    "Progressive muscle weakness with feeding difficulties",
    "Rapidly worsening joint contractures or spinal deformities"
