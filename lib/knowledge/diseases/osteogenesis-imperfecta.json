  "diagnosticCriteria": {
    "formalCriteriaName": "Sillence Classification (revised and expanded); Nosology of the International Skeletal Dysplasia Society",
    "criteria": [
      {
        "id": "oi-c1",
        "description": "Recurrent fractures with minimal or no trauma",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "oi-c2",
        "description": "Blue or grey sclerae",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "oi-c3",
        "description": "Dentinogenesis imperfecta (opalescent teeth)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "oi-c4",
        "description": "Family history consistent with autosomal dominant (COL1A1/COL1A2) or autosomal recessive inheritance",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "oi-m1",
        "description": "Short stature disproportionate to family",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "oi-m2",
        "description": "Wormian bones on skull radiograph",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "oi-m3",
        "description": "Progressive hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "oi-m4",
        "description": "Joint hypermobility",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "oi-m5",
        "description": "Easy bruising",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "oi-m6",
        "description": "Bone deformity (bowing of long bones)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical diagnosis based on recurrent low-trauma fractures plus supportive features. Genetic testing for COL1A1/COL1A2 or rarer genes (IFITM5, SERPINF1, CRTAP, etc.) confirms diagnosis.",
    "notes": "OI is classified into multiple types (historically I-IV by Sillence, now >20 genetic types). Severity ranges from mild (Type I) to perinatally lethal (Type II)."
  },
