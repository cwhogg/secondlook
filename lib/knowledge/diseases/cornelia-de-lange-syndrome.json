  "diagnosticCriteria": {
    "formalCriteriaName": "Cornelia de Lange Syndrome Clinical Diagnostic Criteria",
    "criteria": [
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial features including synophrys, long eyelashes, arched eyebrows, and thin downturned lips",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Prenatal and postnatal growth retardation with short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-abnormalities",
        "description": "Upper limb malformations such as micromelia, oligodactyly, or clinodactyly",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay and intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hirsutism",
        "description": "Excessive body hair including hirsutism and hypertrichosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "gastrointestinal-anomalies",
        "description": "Feeding difficulties, gastroesophageal reflux, and constipation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic facial features plus growth retardation and developmental delay, with or without limb abnormalities",
    "notes": "Genetic testing for mutations in cohesin complex genes (e.g., NIPBL) supports diagnosis"
  },
