  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Pycnodysostosis",
    "criteria": [
      {
        "id": "osteosclerosis",
        "description": "Generalized increased bone density (osteosclerosis) visible on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acro-osteolysis",
        "description": "Acro-osteolysis of distal phalanges demonstrated radiographically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cathepsin-k-mutation",
        "description": "Identification of pathogenic mutations in the CTSK gene encoding cathepsin K",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "short-stature",
        "description": "Short stature with disproportionate skeletal features",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "open-cranial-sutures",
        "description": "Persistence of open cranial sutures and fontanelles beyond infancy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized osteosclerosis and acro-osteolysis on imaging plus clinical features consistent with pycnodysostosis; genetic confirmation supports diagnosis",
    "notes": "Genetic testing for CTSK mutations is confirmatory but not always available; diagnosis is primarily clinical and radiological."
  },
