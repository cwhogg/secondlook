  "diagnosticCriteria": {
    "formalCriteriaName": "aHUS Diagnostic Criteria",
    "criteria": [
      {
        "id": "microangiopathic-hemolytic-anemia",
        "description": "Presence of microangiopathic hemolytic anemia with schistocytes on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thrombocytopenia",
        "description": "Thrombocytopenia with platelet count below normal range without other apparent cause",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acute-renal-impairment",
        "description": "Evidence of acute kidney injury or renal impairment (elevated creatinine, reduced GFR)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-shiga-toxin-hus",
        "description": "Exclusion of Shiga toxin-producing E. coli infection",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "complement-dysregulation",
        "description": "Evidence of complement system dysregulation (genetic or functional assays)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microangiopathic hemolytic anemia, thrombocytopenia, acute renal impairment, and exclusion of Shiga toxin-producing E. coli infection",
    "notes": "Genetic testing for complement mutations supports diagnosis but is not mandatory"
  },
