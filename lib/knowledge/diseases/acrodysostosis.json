  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Acrodysostosis",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia, nasal hypoplasia, and maxillary hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Severe brachydactyly with shortening of distal and middle phalanges and cone-shaped epiphyses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hormone-resistance",
        "description": "Resistance to multiple hormones such as parathyroid hormone (PTH) and thyroid-stimulating hormone (TSH)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation with short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-features",
        "description": "Variable intellectual disability and developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic facial dysmorphism and skeletal abnormalities (brachydactyly with cone-shaped epiphyses) with or without hormone resistance",
    "notes": "Genetic testing for mutations in PRKAR1A or PDE4D genes can confirm diagnosis."
  },
