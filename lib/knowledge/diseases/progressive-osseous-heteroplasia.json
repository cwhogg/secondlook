  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiographic Diagnostic Criteria for Progressive Osseous Heteroplasia",
    "criteria": [
      {
        "id": "heterotopic-ossification",
        "description": "Progressive heterotopic ossification involving skin, subcutaneous, and deep connective tissues",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset",
        "description": "Onset of heterotopic ossification during infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of inactivating mutations in the GNAS gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-endochondral-ossification",
        "description": "Radiographic absence of endochondral bone formation in heterotopic lesions",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-heterotopic-ossification-disorders",
        "description": "Exclusion of fibrodysplasia ossificans progressiva and other related disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive heterotopic ossification in skin and deep connective tissues with onset in infancy or early childhood, supported by clinical and radiographic findings",
    "notes": "Genetic testing for GNAS mutations can support diagnosis but is not mandatory"
  },
