  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (CK) levels",
      "Normal or mildly elevated liver enzymes"
    ],
    "imaging": [
      "Brain MRI showing cobblestone lissencephaly and white matter abnormalities",
      "Muscle MRI may show fatty infiltration and muscle atrophy"
    ],
    "genetic": [
      "FKTN (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy showing dystrophic changes and reduced glycosylation of alpha-dystroglycan"
    ]
  },
