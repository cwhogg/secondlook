  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "complex-syndactyly",
        "description": "Presence of complex syndactyly involving both hands and feet with fusion of metacarpals and metatarsals",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radioulnar-synostosis",
        "description": "Radiographic evidence of radioulnar synostosis or fusion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic craniofacial features including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the LRP4 gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of complex syndactyly involving hands and feet plus radiographic evidence of radioulnar synostosis",
    "notes": "Genetic testing for LRP4 mutations supports diagnosis but is not mandatory"
  },
