        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Rapidly growing, solitary, painless subcutaneous or intramuscular nodule usually less than 5 cm",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "MRI showing well-circumscribed, non-invasive soft tissue mass with variable signal intensity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation with USP6 gene rearrangement and compatible clinical presentation",
    "notes": "Molecular testing for USP6 rearrangement is critical to differentiate from sarcomas."
