  "keyFindings": {
    "laboratory": [
      "Normal serum calcium, phosphate, and alkaline phosphatase levels",
      "No systemic metabolic bone abnormalities"
    ],
    "imaging": [
      "Multifocal mixed radiolucent-radiopaque lesions in multiple jaw quadrants",
      "Lesions with well-defined borders and sclerotic margins",
      "Progressive maturation from radiolucent to radiopaque appearance"
    ],
    "genetic": [
      "No known genetic mutations currently associated"
    ],
    "other": [
      "Histopathology shows fibrous connective tissue with cementum-like calcifications replacing normal bone"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "periapical-cemento-osseous-dysplasia",
      "distinguishingFeatures": [
        "Typically localized to anterior mandible",
        "Usually involves fewer lesions",
        "Less extensive jaw involvement"
      ]
    },
    {
      "diseaseId": "ossifying-fibroma",
      "distinguishingFeatures": [
        "Usually presents as a solitary lesion",
        "Well-demarcated and expansile mass",
        "May cause more aggressive bone expansion"
      ]
    },
    {
      "diseaseId": "chronic-sclerosing-osteomyelitis",
      "distinguishingFeatures": [
        "Associated with pain and signs of infection",
        "Radiographic evidence of bone sclerosis with periosteal reaction",
        "Systemic symptoms may be present"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive jaw swelling",
    "Signs of secondary infection such as pain, fever, or purulent discharge",
    "Pathologic fracture or significant bone destruction"
  ],
