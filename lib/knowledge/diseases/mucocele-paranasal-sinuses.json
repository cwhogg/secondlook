    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Paranasal Sinus Mucocele",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of progressive facial swelling or deformity localized to the affected sinus region",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "CT or MRI evidence of an expansile, cystic lesion causing sinus opacification with bone erosion or remodeling",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sinus-obstruction",
        "description": "Evidence of sinus ostium obstruction or prior sinus surgery/trauma history",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus characteristic imaging findings",
    "notes": "Histopathological confirmation is rarely required unless malignancy is suspected"
  },
