  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Brachytelephalangic Chondrodysplasia Punctata",
    "criteria": [
      {
        "id": "brachytelephalangy",
        "description": "Presence of brachytelephalangy characterized by shortened distal phalanges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "punctate-calcifications",
        "description": "Radiographic evidence of punctate calcifications in epiphyseal cartilage",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia and nasal hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation with short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of brachytelephalangy and punctate calcifications on radiographs with supportive clinical features",
    "notes": "Genetic testing may assist but is not always definitive due to heterogeneity"
  },
