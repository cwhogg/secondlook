  "keyFindings": {
    "laboratory": [
      "Elevated erythrocyte sedimentation rate (ESR)",
      "Presence of nonspecific autoantibodies (e.g., ANA, RF)",
      "Detection of inner ear-specific autoantibodies (rare)"
    ],
    "imaging": [
      "MRI of internal auditory canals may show nonspecific enhancement",
      "Exclusion of retrocochlear pathology"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Audiometry showing progressive sensorineural hearing loss",
      "Vestibular function tests demonstrating dysfunction"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "meniere-disease",
      "distinguishingFeatures": [
        "Episodic vertigo with fluctuating hearing loss",
        "Presence of endolymphatic hydrops on imaging",
        "Typically unilateral involvement"
      ]
    },
    {
      "diseaseId": "labyrinthitis",
      "distinguishingFeatures": [
        "Acute onset with preceding infection",
        "Usually monophasic course",
        "No response to immunosuppressive therapy"
      ]
    },
    {
      "diseaseId": "sensorineural-hearing-loss-due-to-ototoxicity",
      "distinguishingFeatures": [
        "History of exposure to ototoxic drugs",
        "Symmetric hearing loss without vestibular symptoms",
        "No autoimmune markers"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive bilateral hearing loss",
    "Failure to respond to corticosteroid therapy",
    "Development of systemic autoimmune symptoms"
  ],
