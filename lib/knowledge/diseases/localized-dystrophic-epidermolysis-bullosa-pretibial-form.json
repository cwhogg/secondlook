  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for localized dystrophic epidermolysis bullosa",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of localized blistering and erosions predominantly on the pretibial areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing sublamina densa cleavage with scarring and fibrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the COL7A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Reduced or absent type VII collagen at the dermoepidermal junction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical presentation with pretibial blistering plus either histopathology or genetic confirmation",
    "notes": "Diagnosis requires exclusion of other forms of epidermolysis bullosa and acquired blistering disorders."
  },
