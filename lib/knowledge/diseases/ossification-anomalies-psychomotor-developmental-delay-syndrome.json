  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild metabolic abnormalities in some cases"
    ],
    "imaging": [
      "Radiographs showing delayed or abnormal ossification centers",
      "MRI brain may show nonspecific white matter changes"
    ],
    "genetic": [
      "No specific gene identified; possible autosomal recessive inheritance pattern suggested"
    ],
    "other": [
      "Developmental assessments confirming psychomotor delay"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cleidocranial-dysplasia",
      "distinguishingFeatures": [
        "Clavicular hypoplasia or aplasia",
        "Delayed closure of cranial sutures",
        "Normal psychomotor development"
      ]
    },
    {
      "diseaseId": "hypophosphatasia",
      "distinguishingFeatures": [
        "Low serum alkaline phosphatase",
        "Premature loss of deciduous teeth",
        "Variable neurological involvement"
      ]
    },
    {
      "diseaseId": "metaphyseal-dysplasia",
      "distinguishingFeatures": [
        "Metaphyseal abnormalities on X-ray",
        "Absence of significant psychomotor delay",
        "Distinct genetic mutations"
      ]
    }
  ],
