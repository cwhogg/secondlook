        "description": "Progressive renal failure typically presenting as focal segmental glomerulosclerosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "SMARCAL1-mutation",
        "description": "Identification of biallelic pathogenic variants in SMARCAL1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including a broad nasal bridge and microdontia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: spondyloepiphyseal dysplasia, immunodeficiency, and renal failure",
    "notes": "Genetic testing for SMARCAL1 mutations supports diagnosis but is not mandatory"
