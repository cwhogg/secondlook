  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible hypothyroidism on thyroid panel"
    ],
    "imaging": [
      "Brain MRI may show delayed myelination or structural abnormalities",
      "Echocardiogram revealing congenital heart defects"
    ],
    "genetic": [
      "Confirmed terminal or interstitial deletion of distal 3p by chromosomal microarray or FISH",
      "Deletion size varies, commonly involving 3p25-pter region"
    ],
    "other": [
      "Developmental assessments confirming intellectual disability",
      "Audiological evaluation for hearing impairment"
    ]
  },
