  "keyFindings": {
    "laboratory": [
      "Elevated TSH with low free T4 indicating hypothyroidism",
      "Normal or mildly elevated inflammatory markers",
      "Genetic testing revealing NKX2-1 gene mutations"
    ],
    "imaging": [
      "Chest X-ray or CT showing lung hypoplasia",
      "Brain MRI may show nonspecific white matter changes",
      "Thyroid ultrasound demonstrating thyroid agenesis or hypoplasia"
    ],
    "genetic": [
      "NKX2-1 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Neurodevelopmental assessment confirming developmental delay",
      "Pulmonary function tests indicating restrictive lung disease"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-hypothyroidism",
      "distinguishingFeatures": [
        "Absence of neurological and pulmonary involvement",
        "Normal lung imaging",
        "No NKX2-1 mutations"
      ]
    },
    {
      "diseaseId": "brain-lung-thyroid-dysgenesis-syndrome-like-conditions",
      "distinguishingFeatures": [
        "Different genetic mutations (e.g., FOXE1)",
        "Variable thyroid and lung involvement",
        "Less consistent neurological symptoms"
      ]
    },
    {
      "diseaseId": "choreoathetosis-hypothyroidism-respiratory-distress-syndrome",
      "distinguishingFeatures": [
        "Overlapping symptoms but distinct genetic etiology",
        "More prominent movement disorders",
        "Different pattern of lung disease"
      ]
    }
  ],
  "redFlags": [
