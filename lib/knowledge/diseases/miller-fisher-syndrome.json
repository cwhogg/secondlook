  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 120,
      "peak": 60
    },
    "sexPredilection": "slight-male",
    "ethnicAssociations": [
      "Higher incidence reported in East Asian populations"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Miller Fisher Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "ophthalmoplegia",
        "description": "Acute onset of ophthalmoplegia (external eye muscle paralysis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ataxia",
        "description": "Cerebellar ataxia manifesting as gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "areflexia",
        "description": "Areflexia or hyporeflexia in the limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anti-gq1b-antibodies",
        "description": "Presence of anti-GQ1b IgG antibodies in serum",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "csf-albuminocytologic-dissociation",
        "description": "Elevated cerebrospinal fluid protein with normal cell count",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of the clinical triad of ophthalmoplegia, ataxia, and areflexia",
    "notes": "Anti-GQ1b antibody testing supports diagnosis but is not mandatory."
  },
