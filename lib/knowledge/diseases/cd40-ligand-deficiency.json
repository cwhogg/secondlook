  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for X-linked Hyper-IgM Syndrome",
    "criteria": [
      {
        "id": "clinical-infections",
        "description": "Recurrent bacterial and opportunistic infections, especially of the respiratory and gastrointestinal tracts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunoglobulin-profile",
        "description": "Elevated or normal serum IgM with markedly decreased IgG, IgA, and IgE levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in the CD40LG gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "flow-cytometry",
        "description": "Absent or markedly reduced CD40 ligand (CD154) expression on activated T cells",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent infections plus abnormal immunoglobulin profile and confirmation by genetic testing or flow cytometry",
    "notes": "Genetic confirmation is considered definitive; immunophenotyping supports diagnosis."
  },
