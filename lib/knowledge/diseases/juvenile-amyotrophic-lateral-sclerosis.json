        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-neurological-decline",
        "description": "Progressive spread of symptoms or signs within a region or to other regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-diseases",
        "description": "Exclusion of other diseases that might explain signs and symptoms",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in known ALS-associated genes (e.g., ALS2, SETX)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both upper and lower motor neuron signs with progressive neurological decline and exclusion of other causes",
    "notes": "Genetic testing can support diagnosis but is not mandatory."
