  "diagnosticCriteria": {
    "formalCriteriaName": "EuroSCAR AGEP validation score",
    "criteria": [
      {
        "id": "acute-pustular-rash",
        "description": "Sudden onset of numerous non-follicular sterile pustules on an erythematous base",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fever",
        "description": "Fever greater than 38°C accompanying rash onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neutrophilia",
        "description": "Peripheral blood neutrophilia (>7000/mm³)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "drug-exposure",
        "description": "Recent exposure to a causative drug within 1-2 days to 3 weeks prior to rash",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing subcorneal or intraepidermal pustules with dermal edema and perivascular infiltrate",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acute pustular rash, fever, neutrophilia, and recent drug exposure with supportive histopathology",
    "notes": "Diagnosis is clinical and supported by histopathology and drug history; EuroSCAR scoring system may be used."
  },
