  "diagnosticCriteria": {
    "formalCriteriaName": "FOXP1 Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "speech-delay",
        "description": "Significant speech and language delay or impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "foxp1-mutation",
        "description": "Pathogenic or likely pathogenic mutation in the FOXP1 gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-abnormalities",
        "description": "Presence of behavioral abnormalities including autism spectrum disorder features",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "dysmorphic-features",
        "description": "Mild facial dysmorphisms such as broad nasal bridge or deep-set eyes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic FOXP1 mutation plus intellectual disability and speech delay",
    "notes": "Diagnosis is confirmed by genetic testing identifying FOXP1 mutation in the context of neurodevelopmental symptoms."
  },
