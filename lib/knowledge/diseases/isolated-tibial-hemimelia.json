  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Tibial Hemimelia",
    "criteria": [
      {
        "id": "absent-tibia",
        "description": "Complete or partial absence of the tibia confirmed by radiographic imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "foot-malformations",
        "description": "Presence of foot deformities such as equinovarus or absent rays",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-fibula",
        "description": "Fibula present and often hypertrophied without associated femoral abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-syndromic-features",
        "description": "No evidence of associated syndromic or systemic malformations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of complete or partial tibial absence with characteristic foot malformations in the absence of syndromic features",
    "notes": "Diagnosis is primarily clinical and radiological; genetic testing may be used to exclude syndromic causes."
  },
