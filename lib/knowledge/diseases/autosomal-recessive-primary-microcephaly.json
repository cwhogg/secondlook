  "commonPitfalls": [
    "Frequently misattributed to secondary microcephaly due to perinatal insults or infections.",
    "Developmental delay may be incorrectly attributed to environmental factors rather than a genetic etiology.",
    "Dysmorphic features are often subtle or absent, leading to missed diagnosis if only syndromic microcephaly is considered."
  ],
  "extendedDiscriminators": [
    {
      "vsCondition": "secondary-microcephaly",
      "feature": "Congenital onset with normal head growth trajectory in utero, as opposed to postnatal onset after a period of normal head circumference."
    },
    {
      "vsCondition": "seckel-syndrome",
      "feature": "Absence of severe growth retardation and characteristic bird-like facial features seen in Seckel syndrome."
    },
    {
      "vsCondition": "miller-dieker-lissencephaly",
      "feature": "Normal brain gyration on neuroimaging, as opposed to lissencephaly (smooth brain) seen in Miller-Dieker syndrome."
    }
  ],
  "ruleOutCriteria": [
    "Progressive postnatal decrease in head circumference after a normal birth head size.",
    "Presence of major structural brain malformations such as lissencephaly or holoprosencephaly on neuroimaging."
  ],
