  "diagnosticCriteria": {
    "formalCriteriaName": "Karyotype-confirmed Klinefelter Syndrome",
    "criteria": [
      {
        "id": "ks-c1",
        "description": "Male phenotype with at least one extra X chromosome on karyotype (47,XXY or variant)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ks-c2",
        "description": "Small firm testes (typically <4 mL in adulthood)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ks-c3",
        "description": "Hypergonadotropic hypogonadism (elevated FSH/LH, low testosterone)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ks-c4",
        "description": "Azoospermia or severe oligospermia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ks-c5",
        "description": "Tall stature with eunuchoid body proportions (long limbs relative to trunk)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Karyotype demonstrating 47,XXY (classic, ~80%) or mosaic (46,XY/47,XXY) or higher-order X aneuploidies (48,XXXY; 49,XXXXY)",
    "notes": "Only ~25% of cases are diagnosed during the individual's lifetime; most remain undiagnosed. Increasing prenatal detection via NIPT. Mosaic forms (46,XY/47,XXY) may have milder phenotypes."
  },
