  "diagnosticCriteria": {
    "formalCriteriaName": "European CMT Consortium Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Progressive distal muscle weakness and atrophy with distal sensory loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-conduction-velocity",
        "description": "Motor nerve conduction velocity in upper limbs <38 m/s indicating demyelinating neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Presence of PMP22 gene duplication confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical features plus either abnormal nerve conduction studies consistent with demyelination or PMP22 gene duplication",
    "notes": "Genetic confirmation is considered gold standard; nerve conduction studies essential for classification"
  },
