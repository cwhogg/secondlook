  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; thyroid function tests may reveal hypothyroidism in rare cases"
    ],
    "imaging": [
      "Echocardiography showing atrioventricular septal defects or ventricular septal defects",
      "Brain MRI may show nonspecific findings related to developmental delay"
    ],
    "genetic": [
      "GATA4 (phenotype modifier)"
    ],
    "other": [
      "Developmental assessments confirming global developmental delay",
      "Audiological evaluation for sensorineural hearing loss"
    ]
  },
  "differentialDiagnoses": [
