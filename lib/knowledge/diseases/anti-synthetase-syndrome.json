  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (CK) and aldolase",
      "Positive anti-aminoacyl tRNA synthetase antibodies (e.g., anti-Jo-1, anti-PL-7, anti-PL-12)",
      "Elevated inflammatory markers (ESR, CRP)"
    ],
    "imaging": [
      "High-resolution CT showing ground-glass opacities and reticulation consistent with interstitial lung disease",
      "MRI of muscles showing edema and inflammation"
    ],
    "genetic": [
      "No specific genetic mutations identified; association with HLA-DRB1*03 allele reported"
    ],
    "other": [
      "Muscle biopsy showing inflammatory infiltrates and muscle fiber necrosis",
      "Pulmonary function tests showing restrictive pattern"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "polymyositis",
      "distinguishingFeatures": [
        "Absence of anti-synthetase antibodies",
        "Less frequent interstitial lung disease",
        "No mechanic’s hands"
      ]
    },
    {
      "diseaseId": "systemic-sclerosis",
      "distinguishingFeatures": [
        "Presence of skin thickening and sclerodactyly",
        "Specific autoantibodies (anti-Scl-70, anti-centromere)",
        "More prominent vascular manifestations"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive interstitial lung disease",
    "Severe muscle weakness with respiratory compromise",
    "Development of pulmonary hypertension"
  ],
