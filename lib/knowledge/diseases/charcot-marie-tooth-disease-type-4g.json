  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Charcot-Marie-Tooth disease type 4G",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of progressive distal muscle weakness and atrophy with sensory loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-conduction-velocity",
        "description": "Markedly reduced motor and sensory nerve conduction velocities consistent with demyelinating neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the GDAP1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consistent autosomal recessive inheritance pattern or family history of neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Nerve biopsy showing demyelination and onion bulb formations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal neuropathy with demyelinating nerve conduction studies and confirmed GDAP1 mutation",
    "notes": "Genetic confirmation is essential for definitive diagnosis; nerve biopsy is supportive but not mandatory."
  },
