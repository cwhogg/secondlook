  "keyFindings": {
    "laboratory": [
      "Plasma ammonia markedly elevated (>150 µmol/L)",
      "Plasma citrulline concentration elevated (often >100 µmol/L)",
      "Elevated urinary orotic acid",
      "Metabolic acidosis or respiratory alkalosis"
    ],
    "imaging": [
      "Brain MRI showing cerebral edema during acute crisis",
      "Possible white matter abnormalities in chronic cases"
    ],
    "genetic": [
      "Pathogenic variants in ASS1 gene confirmed by sequencing",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Reduced argininosuccinate synthetase enzyme activity in fibroblasts or liver tissue"
    ]
  },
