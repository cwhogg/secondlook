  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate elevation)",
      "Normal or mildly elevated inflammatory markers"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle involvement with fatty infiltration",
      "Spinal X-rays demonstrating scoliosis or kyphosis"
    ],
    "genetic": [
