  "diagnosticCriteria": {
    "formalCriteriaName": "Wolman Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "lysosomal-acid-lipase-deficiency",
        "description": "Demonstration of deficient lysosomal acid lipase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "adrenal-calcification",
        "description": "Presence of bilateral adrenal gland calcifications on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepatosplenomegaly",
        "description": "Clinical or imaging evidence of hepatosplenomegaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the LIPA gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient lysosomal acid lipase enzyme activity plus presence of adrenal calcification and hepatosplenomegaly",
    "notes": "Genetic testing supports diagnosis but is not mandatory if enzyme deficiency and clinical features are present"
  },
