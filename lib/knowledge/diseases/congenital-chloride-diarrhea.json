  "keyFindings": {
    "laboratory": [
      "Elevated fecal chloride concentration (>90 mmol/L)",
      "Hypochloremic metabolic alkalosis on blood gas analysis",
      "Hypokalemia and hyponatremia"
    ],
    "imaging": [
      "Prenatal ultrasound showing polyhydramnios and dilated bowel loops",
      "Abdominal X-ray may show bowel distension"
    ],
    "genetic": [
      "Pathogenic mutations in SLC26A3 gene (chromosome 7q31)"
    ],
    "other": [
      "Positive family history or consanguinity",
      "Response to electrolyte replacement therapy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cystic-fibrosis",
      "distinguishingFeatures": [
        "Pancreatic insufficiency",
        "Elevated sweat chloride test",
        "Pulmonary involvement"
      ]
    },
    {
      "diseaseId": "bartter-syndrome",
      "distinguishingFeatures": [
        "Hypokalemic metabolic alkalosis with hyperreninemia",
        "Normal or low fecal chloride",
        "No chronic diarrhea"
      ]
    },
    {
      "diseaseId": "congenital-sodium-diarrhea",
      "distinguishingFeatures": [
        "High fecal sodium concentration",
        "Different genetic mutation (SPINT2 gene)",
        "Metabolic acidosis instead of alkalosis"
      ]
    }
  ],
  "redFlags": [
    "Severe dehydration unresponsive to oral rehydration",
    "Persistent hypochloremic metabolic alkalosis",
    "Failure to thrive despite nutritional support"
  ],
