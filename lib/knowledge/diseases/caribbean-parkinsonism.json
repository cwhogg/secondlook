  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Caribbean Parkinsonism",
    "criteria": [
      {
        "id": "parkinsonism-features",
        "description": "Presence of bradykinesia with at least one of resting tremor, rigidity, or postural instability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "geographic-history",
        "description": "History of residence or prolonged exposure in Caribbean endemic regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of parkinsonism such as drug-induced or vascular parkinsonism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-response-levodopa",
        "description": "Partial or poor response to levodopa therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuroimaging-findings",
        "description": "MRI showing absence of significant vascular lesions or structural abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of parkinsonism features plus geographic history and exclusion of other causes",
    "notes": "Diagnosis is clinical and supported by epidemiological context; levodopa response may be variable."
  },
