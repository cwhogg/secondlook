  "keyFindings": {
    "laboratory": [
      "CSF analysis typically negative for malignant cells",
      "No specific serum tumor markers"
    ],
    "imaging": [
      "MRI showing well-circumscribed pineal region mass with heterogeneous enhancement",
      "Possible hydrocephalus due to aqueductal stenosis"
    ],
    "genetic": [
      "No consistent genetic mutations identified; some cases show chromosomal imbalances"
    ],
    "other": [
      "Histopathology revealing papillary structures with epithelial-like cells",
      "Immunohistochemistry positive for cytokeratin, EMA; variable GFAP"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pineocytoma",
      "distinguishingFeatures": [
        "More uniform pineal parenchymal cells",
        "Lack of papillary architecture",
        "Different immunohistochemical profile (negative cytokeratin)"
      ]
    },
    {
      "diseaseId": "pineoblastoma",
      "distinguishingFeatures": [
        "Highly malignant with small round blue cells",
        "More aggressive clinical course",
        "Different radiologic features with diffuse infiltration"
      ]
    },
    {
      "diseaseId": "germ-cell-tumors-of-the-pineal-region",
      "distinguishingFeatures": [
        "Presence of germ cell tumor markers (AFP, β-hCG)",
        "Different histology (e.g., germinoma, teratoma)",
        "Often younger age at presentation"
      ]
    }
  ],
