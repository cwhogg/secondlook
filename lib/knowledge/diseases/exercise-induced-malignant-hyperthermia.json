  "diagnosticCriteria": {
    "formalCriteriaName": "Exercise-induced Malignant Hyperthermia Diagnostic Criteria",
    "criteria": [
      {
        "id": "hyperthermia",
        "description": "Rapid onset of hyperthermia (core body temperature >40°C) during or immediately after strenuous exercise",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-rigidity",
        "description": "Generalized muscle rigidity or masseter muscle spasm triggered by exercise",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-creatine-kinase",
        "description": "Marked elevation of serum creatine kinase levels (>10,000 IU/L) post-exercise",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of malignant hyperthermia or related myopathies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ryr1-mutation",
        "description": "Identification of pathogenic RYR1 gene mutation associated with malignant hyperthermia susceptibility",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of rapid hyperthermia and muscle rigidity triggered by exercise plus elevated creatine kinase levels",
    "notes": "Diagnosis is clinical but supported by genetic testing and family history; muscle biopsy contracture testing may be used if available."
  },
