  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Criteria for Lethal Kniest-like Dysplasia",
    "criteria": [
      {
        "id": "short-limbs",
        "description": "Severe micromelic dwarfism with disproportionately short limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-changes",
        "description": "Characteristic radiographic findings including platyspondyly, metaphyseal irregularities, and delayed ossification",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cartilage-abnormalities",
        "description": "Histopathological evidence of abnormal cartilage matrix resembling Kniest dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Midface hypoplasia and cleft palate",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-distress",
        "description": "Severe respiratory insufficiency due to thoracic hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (severe micromelic dwarfism, characteristic radiologic changes, and cartilage abnormalities) with supportive clinical features",
    "notes": "Diagnosis is primarily clinical and radiological; genetic testing may support but is not always available."
  },
