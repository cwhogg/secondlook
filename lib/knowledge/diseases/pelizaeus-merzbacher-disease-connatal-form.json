  "diagnosticCriteria": {
    "formalCriteriaName": "Pelizaeus-Merzbacher Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early onset nystagmus, hypotonia, and developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing hypomyelination with diffuse white matter abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of PLP1 gene mutation or duplication",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "X-linked inheritance pattern or affected male relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electrophysiology",
        "description": "Abnormal evoked potentials consistent with central myelin dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus confirmatory MRI findings and pathogenic PLP1 mutation",
    "notes": "Genetic testing is definitive; MRI and clinical features guide initial suspicion."
  },
