    "formalCriteriaName": "Diagnostic Criteria for Methylmalonic Acidemia",
    "criteria": [
      {
        "id": "elevated-methylmalonic-acid",
        "description": "Persistent elevation of methylmalonic acid in plasma and/or urine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lack-of-response-to-vitamin-b12",
        "description": "No biochemical or clinical improvement after vitamin B12 supplementation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in MUT gene confirming vitamin B12-unresponsive subtype",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of metabolic acidosis, developmental delay, and failure to thrive",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated methylmalonic acid with lack of response to vitamin B12 supplementation plus genetic confirmation of MUT gene mutation",
    "notes": "Early diagnosis is critical to prevent metabolic crises and irreversible neurological damage."
  },
