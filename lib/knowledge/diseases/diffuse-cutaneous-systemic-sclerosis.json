  "diagnosticCriteria": {
    "formalCriteriaName": "2013 ACR/EULAR Classification Criteria for Systemic Sclerosis",
    "criteria": [
      {
        "id": "skin-thickening",
        "description": "Proximal skin thickening of the fingers and/or hands extending proximal to the metacarpophalangeal joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sclerodactyly",
        "description": "Skin thickening limited to fingers (sclerodactyly)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "digital-pitting-scars",
        "description": "Digital tip ulcers or pitting scars",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pulmonary-fibrosis",
        "description": "Interstitial lung disease or pulmonary fibrosis on imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "anticentromere-antibody",
        "description": "Presence of specific autoantibodies (anti-Scl-70/anti-topoisomerase I)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of proximal skin thickening of the fingers extending proximal to the metacarpophalangeal joints or a total score of ≥9 points from the classification criteria",
    "notes": "Diagnosis is clinical supported by serology and imaging; anti-Scl-70 antibodies are more common in diffuse cutaneous subtype"
  },
