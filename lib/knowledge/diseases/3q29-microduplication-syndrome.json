    "formalCriteriaName": "Clinical and Molecular Diagnosis of 3q29 Microduplication Syndrome",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of a microduplication at chromosome 3q29 confirmed by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including mild dysmorphic traits such as micrognathia and prominent forehead",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-issues",
        "description": "Behavioral abnormalities including autism spectrum disorder or attention deficit hyperactivity disorder",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 3q29 microduplication plus presence of developmental delay or intellectual disability",
    "notes": "Clinical presentation is variable; genetic testing is essential for diagnosis."
