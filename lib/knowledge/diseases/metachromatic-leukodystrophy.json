  "diagnosticCriteria": {
    "formalCriteriaName": "Metachromatic Leukodystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficient arylsulfatase A enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the ARSA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Characteristic symmetric demyelination on brain MRI with periventricular white matter involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Progressive neurological decline including motor and cognitive deterioration",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of deficient arylsulfatase A enzyme activity plus characteristic MRI findings or pathogenic ARSA mutations",
    "notes": "Enzyme assay and genetic testing are confirmatory; MRI findings support diagnosis."
  },
