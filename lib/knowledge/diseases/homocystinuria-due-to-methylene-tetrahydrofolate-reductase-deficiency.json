  "keyFindings": {
    "laboratory": [
      "Markedly elevated plasma total homocysteine",
      "Low plasma methionine",
      "Elevated plasma methylmalonic acid in some cases",
      "Normal or low folate and vitamin B12 levels"
    ],
    "imaging": [
      "Brain MRI may show cerebral atrophy or white matter changes",
      "Doppler ultrasound for detection of thrombi"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Prolonged prothrombin time or activated partial thromboplastin time in thrombotic events",
      "Neuropsychological testing showing cognitive impairment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "classical-homocystinuria-cystathionine-beta-synthase-deficiency",
      "distinguishingFeatures": [
        "Elevated methionine levels (not low)",
        "Lens dislocation typically inferonasal",
        "Marfanoid habitus more prominent"
      ]
    },
    {
      "diseaseId": "methylmalonic-acidemia",
      "distinguishingFeatures": [
        "Elevated methylmalonic acid in plasma and urine",
        "Metabolic acidosis with ketosis",
        "No isolated homocysteine elevation"
      ]
    }
  ],
  "redFlags": [
    "Early onset thromboembolic events without obvious risk factors",
    "Progressive developmental delay with neurological deterioration",
    "Markedly elevated plasma homocysteine levels"
  ],
