  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of acquired causes (e.g. vitamin deficiencies, infections)"
    ],
    "imaging": [
      "MRI showing cerebellar atrophy predominantly affecting the vermis and hemispheres",
      "Spinal cord MRI may show corticospinal tract degeneration"
    ],
    "genetic": [
      "GBA2 (causative, loss-of-function)",
      "Biallelic pathogenic variants in genes associated with autosomal recessive cerebellar ataxia"
    ],
    "other": [
      "Electromyography may show mild peripheral neuropathy",
      "Neurophysiology demonstrating increased muscle tone and hyperreflexia"
    ]
  },
