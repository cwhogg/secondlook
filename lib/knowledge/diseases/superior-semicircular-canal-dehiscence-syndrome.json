  "diagnosticCriteria": {
    "formalCriteriaName": "Minor and Major Criteria for SSCD Diagnosis",
    "criteria": [
      {
        "id": "ct-confirmation",
        "description": "High-resolution CT scan demonstrating dehiscence of the bone overlying the superior semicircular canal",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vestibular-evoked-myogenic-potential",
        "description": "Abnormal vestibular-evoked myogenic potentials (VEMP) with lowered thresholds",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-symptoms",
        "description": "Presence of characteristic vestibular and auditory symptoms such as sound- or pressure-induced vertigo",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "audiometric-testing",
        "description": "Audiometric evidence of conductive hearing loss with intact tympanic membrane",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "differential-exclusion",
        "description": "Exclusion of other causes of vertigo and hearing loss",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: CT confirmation of dehiscence, abnormal VEMP testing, and characteristic clinical symptoms",
    "notes": "Diagnosis requires correlation of clinical, audiological, and radiological findings."
  },
