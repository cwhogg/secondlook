  "keyFindings": {
    "laboratory": [
      "Reduced or absent sweat response on quantitative sudomotor axon reflex testing",
      "Nerve conduction studies showing absent or reduced sensory nerve action potentials"
    ],
    "imaging": [
      "MRI may show normal peripheral nerves; muscle MRI may show mild atrophy in advanced cases"
    ],
    "genetic": [
      "Pathogenic variants in WNK1/HSN2 gene confirmed by molecular genetic testing"
    ],
    "other": [
      "Skin biopsy demonstrating loss of small unmyelinated fibers",
      "Nerve biopsy showing loss of small myelinated and unmyelinated fibers"
    ]
  },
