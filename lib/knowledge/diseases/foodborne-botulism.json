  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Laboratory Diagnostic Criteria for Foodborne Botulism",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Acute onset of bilateral cranial neuropathies with symmetric descending flaccid paralysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "toxin-detection",
        "description": "Detection of botulinum neurotoxin in serum, stool, or implicated food samples",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electrophysiological studies showing incremental response on repetitive nerve stimulation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of acute neuromuscular paralysis such as Guillain-Barré syndrome or myasthenia gravis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acute bilateral cranial neuropathies with descending paralysis plus detection of botulinum toxin in clinical specimens or implicated food",
    "notes": "Early diagnosis is critical for administration of antitoxin and supportive care."
  },
