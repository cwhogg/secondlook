  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Infantile Osteopetrosis with Neuroaxonal Dysplasia",
    "criteria": [
      {
        "id": "radiological-bone-density",
        "description": "Diffuse increased bone density with characteristic 'bone within bone' appearance on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroaxonal-dysplasia-confirmation",
        "description": "Histopathological confirmation of neuroaxonal spheroids in nervous tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Early onset of failure to thrive, cranial nerve palsies, and developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hematological-abnormalities",
        "description": "Presence of pancytopenia or anemia due to bone marrow failure",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with osteopetrosis and neuroaxonal dysplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of diffuse increased bone density on imaging plus histopathological confirmation of neuroaxonal dysplasia and compatible clinical features",
    "notes": "Genetic testing can support diagnosis but is not mandatory. Early diagnosis is critical due to rapid progression."
  },
