  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; polycythemia may be present rarely"
    ],
    "imaging": [
      "Radiographs showing absent or severely reduced vertebral ossification",
      "Shortened and bowed long bones",
      "Hypoplastic iliac bones",
      "Multiple rib fractures"
    ],
    "genetic": [
      "Pathogenic variants in SLC26A2 gene (Achondrogenesis Type IB)",
      "Pathogenic variants in COL2A1 gene (Achondrogenesis Type II)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Prenatal ultrasound showing severe micromelia and polyhydramnios",
      "Pulmonary hypoplasia confirmed postnatally"
    ]
  },
  "differentialDiagnoses": [
