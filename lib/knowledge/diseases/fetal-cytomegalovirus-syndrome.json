  "diagnosticCriteria": {
    "formalCriteriaName": "Congenital CMV Diagnostic Criteria",
    "criteria": [
      {
        "id": "cmv-detection",
        "description": "Detection of cytomegalovirus DNA or virus in urine, saliva, or blood within the first 3 weeks of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical signs consistent with congenital CMV infection such as microcephaly, petechiae, or hepatosplenomegaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging-findings",
        "description": "Neuroimaging evidence of intracranial calcifications, ventriculomegaly, or white matter abnormalities",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural hearing loss confirmed by audiologic testing",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Detection of CMV in body fluids within 3 weeks of birth plus at least one major clinical feature",
    "notes": "Diagnosis is confirmed by laboratory detection of CMV combined with clinical and imaging findings."
  },
