  "keyFindings": {
    "laboratory": [
      "Elevated blood and CSF lactate",
      "Elevated serum creatine kinase (mild to moderate)",
      "Abnormal oxidative phosphorylation enzyme activities in muscle"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle involvement and fatty replacement",
      "Normal brain MRI or mild nonspecific changes"
    ],
    "genetic": [
      "Pathogenic mitochondrial DNA mutations (e.g. MT-TL1, MT-ND genes)",
      "Nuclear gene mutations affecting mitochondrial function (e.g. POLG, TK2)",
      "Mitochondrial inheritance inheritance"
    ],
    "other": [
      "Muscle biopsy with ragged-red fibers and COX-negative fibers",
      "Abnormal mitochondrial ultrastructure on electron microscopy"
    ]
  },
