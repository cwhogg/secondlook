  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Microbrachycephaly-Ptosis-Cleft Lip Syndrome",
    "criteria": [
      {
        "id": "microbrachycephaly",
        "description": "Presence of microbrachycephaly characterized by a small, broad head",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ptosis",
        "description": "Unilateral or bilateral congenital ptosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cleft-lip",
        "description": "Unilateral or bilateral cleft lip with or without cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Additional facial dysmorphic features such as broad nasal bridge and low-set ears",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: microbrachycephaly, congenital ptosis, and cleft lip",
    "notes": "Diagnosis is primarily clinical; genetic testing may assist but no specific gene identified"
  },
