  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Triad Diagnostic Criteria",
    "criteria": [
      {
        "id": "fibrous-dysplasia",
        "description": "Presence of polyostotic fibrous dysplasia confirmed by imaging or biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cafe-au-lait-spots",
        "description": "Characteristic irregular 'coast of Maine' café-au-lait macules on skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "endocrine-hyperfunction",
        "description": "One or more endocrinopathies such as precocious puberty, hyperthyroidism, or growth hormone excess",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of at least two of the three major criteria: fibrous dysplasia, café-au-lait spots, and endocrine hyperfunction",
    "notes": "Diagnosis is clinical and supported by genetic testing for somatic GNAS mutations when available"
  },
