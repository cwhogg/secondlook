        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-findings",
        "description": "Radiological evidence of narrowed interpedicular distances in lumbar spine and shortened long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fgfr3-mutation",
        "description": "Identification of FGFR3 pathogenic mutation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of achondroplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of disproportionate short stature with characteristic facial features and supportive radiological findings; genetic confirmation if available",
    "notes": "Molecular genetic testing for FGFR3 mutations confirms diagnosis but is not always required if clinical and radiological features are definitive."
