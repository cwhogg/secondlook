  "diagnosticCriteria": {
    "formalCriteriaName": "Intermediate Charcot-Marie-Tooth Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of distal muscle weakness and atrophy with sensory loss predominantly in lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-conduction-velocity",
        "description": "Nerve conduction velocities in the intermediate range (25-45 m/s) in motor nerves",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in genes associated with intermediate CMT (e.g., MFN2, GDAP1, DNM2)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant or recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyography showing chronic denervation and reinnervation patterns",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical neuropathy with intermediate nerve conduction velocities plus either genetic confirmation or supportive family history",
    "notes": "Diagnosis requires exclusion of other causes of neuropathy and correlation with clinical and electrophysiological findings."
  },
