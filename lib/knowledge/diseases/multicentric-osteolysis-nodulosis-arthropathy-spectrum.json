  "keyFindings": {
    "laboratory": [
      "Normal inflammatory markers (ESR, CRP)",
      "Occasional mild anemia"
    ],
    "imaging": [
      "Progressive multicentric osteolysis primarily affecting carpal and tarsal bones",
      "Joint space narrowing without erosions",
      "Subcutaneous nodules visible on soft tissue imaging"
    ],
    "genetic": [
      "MMP2 (causative)",
      "MMP14 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology of nodules showing fibroblastic proliferation and collagen deposition"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "juvenile-idiopathic-arthritis",
      "distinguishingFeatures": [
        "Presence of inflammatory synovitis with elevated inflammatory markers",
        "Absence of multicentric osteolysis",
        "Lack of characteristic subcutaneous nodules"
      ]
    },
    {
      "diseaseId": "multicentric-carpal-tarsal-osteolysis-syndrome",
      "distinguishingFeatures": [
        "Similar osteolysis but without nodulosis",
        "Different genetic mutations (e.g., MAFB gene)",
        "Less prominent arthropathy"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of joint contractures leading to severe disability",
