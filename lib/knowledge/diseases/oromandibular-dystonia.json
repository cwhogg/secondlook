  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Oromandibular Dystonia",
    "criteria": [
      {
        "id": "involuntary-muscle-contractions",
        "description": "Presence of sustained or intermittent involuntary muscle contractions causing abnormal movements or postures of the jaw, tongue, or lower face",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "task-specificity",
        "description": "Symptoms may be task-specific, often triggered or worsened by speaking or chewing",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-secondary-causes",
        "description": "Exclusion of secondary causes such as drug-induced dystonia or structural brain lesions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-neurological-examination",
        "description": "Neurological examination demonstrating dystonic movements localized to the oromandibular region without other neurological deficits",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of sustained or intermittent involuntary oromandibular muscle contractions causing abnormal movements or postures, with exclusion of secondary causes",
    "notes": "Electromyography (EMG) may support diagnosis but is not mandatory"
  },
