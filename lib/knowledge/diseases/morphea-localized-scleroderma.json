  "diagnosticCriteria": {
    "formalCriteriaName": "Localized Scleroderma Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-plaque",
        "description": "Presence of one or more well-demarcated sclerotic plaques with ivory or waxy appearance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-thickening",
        "description": "Localized skin thickening and induration without systemic involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing dermal sclerosis with thickened collagen bundles and loss of adnexal structures",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-systemic-features",
        "description": "No clinical or laboratory evidence of systemic sclerosis",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "At least two major criteria including clinical plaques and localized skin thickening, plus absence of systemic sclerosis features",
    "notes": "Histopathology is supportive but not mandatory if clinical features are typical"
  },
