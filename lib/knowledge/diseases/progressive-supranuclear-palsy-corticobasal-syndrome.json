  "keyFindings": {
    "laboratory": [
      "Routine labs typically normal; used to exclude other causes"
    ],
    "imaging": [
      "MRI showing midbrain atrophy (hummingbird sign)",
      "Asymmetric cortical atrophy, especially parietal lobe",
      "FDG-PET showing hypometabolism in frontal and parietal regions"
    ],
    "genetic": [
      "MAPT (susceptibility)"
    ],
    "other": [
      "CSF biomarkers typically non-specific; used to exclude Alzheimer's disease"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "corticobasal-degeneration",
      "distinguishingFeatures": [
        "More prominent asymmetric cortical signs without vertical gaze palsy",
        "Different pathological findings on autopsy"
      ]
    },
    {
      "diseaseId": "multiple-system-atrophy",
      "distinguishingFeatures": [
        "Prominent autonomic failure",
        "Lack of vertical gaze palsy",
        "Different MRI findings (putaminal changes)"
      ]
    },
    {
      "diseaseId": "idiopathic-parkinson-disease",
      "distinguishingFeatures": [
        "Symmetric onset more common",
        "Good response to levodopa",
        "Absence of cortical signs and vertical gaze palsy"
      ]
    }
  ],
