  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Trisomy 5p Syndrome",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Detection of an extra copy of the short arm of chromosome 5 by karyotyping or chromosomal microarray",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Presence of characteristic craniofacial dysmorphisms including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital malformations such as cardiac defects or skeletal anomalies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of trisomy 5p plus presence of at least two major clinical features",
    "notes": "Diagnosis is confirmed primarily by genetic testing; clinical features support diagnosis and guide management."
  },
