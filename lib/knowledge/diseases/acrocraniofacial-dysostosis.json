  "diagnosticCriteria": {
    "formalCriteriaName": "Kaplan Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of cranial sutures leading to abnormal skull shape",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midface-hypoplasia",
        "description": "Hypoplasia of the midfacial bones resulting in characteristic facial appearance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Postaxial polydactyly or other digital anomalies of the hands and feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Pre- and postnatal growth retardation with short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Conductive or sensorineural hearing impairment",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: craniosynostosis, midface hypoplasia, and limb malformations",
    "notes": "Genetic testing for mutations in the RAB23 gene can support diagnosis"
  },
