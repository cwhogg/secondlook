  "differentialDiagnoses": [
    {
      "diseaseId": "brugada-syndrome",
      "distinguishingFeatures": [
        "Characteristic ECG pattern with ST elevation in V1-V3",
        "Increased risk of sudden cardiac death",
        "Often presents with fever-triggered arrhythmias"
      ]
    },
    {
      "diseaseId": "long-qt-syndrome",
      "distinguishingFeatures": [
        "Prolonged QT interval on ECG",
        "Syncope triggered by exercise or stress",
        "Family history of sudden death but with QT prolongation"
      ]
    },
    {
      "diseaseId": "catecholaminergic-polymorphic-ventricular-tachycardia",
      "distinguishingFeatures": [
        "Exercise or stress-induced bidirectional or polymorphic VT",
        "Normal resting ECG",
        "Mutations in RYR2 or CASQ2 genes"
      ]
    }
  ],
