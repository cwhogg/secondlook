    "criteria": [
      {
        "id": "hypouricemia",
        "description": "Serum uric acid concentration below 2 mg/dL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "increased-uric-acid-excretion",
        "description": "Elevated fractional excretion of uric acid (>10%)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the SLC2A9 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exercise-induced-aki-history",
        "description": "History of exercise-induced acute kidney injury episodes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypouricemia, increased renal uric acid excretion, and pathogenic SLC2A9 mutation",
    "notes": "Diagnosis may be supported by clinical history of exercise-induced AKI and exclusion of secondary causes."
