  "keyFindings": {
    "laboratory": [
      "Elevated plasma very long chain fatty acids (VLCFA)",
      "Adrenal hormone profile showing insufficiency (low cortisol, elevated ACTH)"
    ],
    "imaging": [
      "Brain MRI showing symmetric white matter demyelination, especially parieto-occipital regions"
    ],
    "genetic": [
      "Pathogenic mutation in ABCD1 gene on X chromosome"
    ],
    "other": [
      "Adrenal function testing confirming Addison’s disease",
      "Neuropsychological testing demonstrating cognitive decline"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "schizophrenia",
      "distinguishingFeatures": [
        "Absence of elevated VLCFA",
        "No ABCD1 mutation",
        "Lack of adrenal insufficiency"
      ]
    },
    {
      "diseaseId": "multiple-sclerosis",
      "distinguishingFeatures": [
        "MRI lesions are typically asymmetric and periventricular",
        "No VLCFA elevation",
        "No ABCD1 mutation"
      ]
    },
    {
      "diseaseId": "frontotemporal-dementia",
      "distinguishingFeatures": [
        "Predominant frontal lobe atrophy on imaging",
        "No VLCFA abnormalities",
        "No adrenal insufficiency"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive cognitive decline with psychiatric symptoms in adult male",
    "Elevated plasma VLCFA levels",
    "Evidence of adrenal insufficiency (e.g., hyperpigmentation, hypotension)"
  ],
