  "keyFindings": {
    "laboratory": [
      "Normal sweat chloride test differentiating from hypohidrotic ectodermal dysplasia"
    ],
    "imaging": [
      "Dental radiographs showing hypodontia or enamel hypoplasia"
    ],
    "genetic": [
      "GJB6 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Family history consistent with autosomal dominant inheritance"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hypohidrotic-ectodermal-dysplasia",
      "distinguishingFeatures": [
        "Reduced or absent sweating",
        "More severe dental abnormalities",
        "Different gene mutations (EDA, EDAR)"
      ]
    },
    {
      "diseaseId": "pachyonychia-congenita",
      "distinguishingFeatures": [
        "More severe nail thickening and painful plantar keratoderma",
        "Mutations in keratin genes (KRT6, KRT16, KRT17)",
        "Oral leukokeratosis"
      ]
    }
  ],
  "redFlags": [
