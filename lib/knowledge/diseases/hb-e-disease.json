  "keyFindings": {
    "laboratory": [
      "Hemoglobin electrophoresis or HPLC showing homozygous Hb E",
      "Mild microcytic anemia (low MCV, low MCH)",
      "Normal to mildly elevated reticulocyte count"
    ],
    "imaging": [
      "Ultrasound may show mild splenomegaly"
    ],
    "genetic": [
      "PLEKHG4 (candidate)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Usually no requirement for transfusion or chelation"
    ]
