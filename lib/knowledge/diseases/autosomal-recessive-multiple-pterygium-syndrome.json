  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Multiple Pterygium Syndrome",
    "criteria": [
      {
        "id": "multiple-pterygia",
        "description": "Presence of multiple web-like skin pterygia involving major joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "arthrogryposis",
        "description": "Congenital joint contractures affecting multiple joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including micrognathia, ptosis, and cleft palate",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-compromise",
        "description": "Respiratory difficulties due to thoracic cage abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple pterygia and arthrogryposis with supportive clinical features",
    "notes": "Genetic testing for mutations in CHRNG gene can confirm diagnosis"
  },
