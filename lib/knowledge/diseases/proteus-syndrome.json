  "keyFindings": {
    "laboratory": [
      "Elevated D-dimer and coagulation abnormalities in some patients",
      "Normal routine blood counts"
    ],
    "imaging": [
      "Asymmetric bone overgrowth on X-ray and MRI",
      "Soft tissue overgrowth and lipomas on MRI",
      "Venous malformations on Doppler ultrasound or MRI"
    ],
    "genetic": [
      "TWIST2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology of connective tissue nevi shows thickened collagen bundles",
      "Biopsy of tumors confirms benign nature"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "klippel-trenaunay-syndrome",
      "distinguishingFeatures": [
        "Capillary malformations (port-wine stains)",
        "Venous and lymphatic malformations",
        "Limb hypertrophy without cerebriform connective tissue nevi"
      ]
    },
    {
      "diseaseId": "mccune-albright-syndrome",
      "distinguishingFeatures": [
        "Café-au-lait skin pigmentation with irregular borders",
        "Endocrine hyperfunction (precocious puberty)",
        "Fibrous dysplasia of bone without mosaic AKT1 mutation"
      ]
    }
  ],
  "redFlags": [
    "Rapid asymmetric overgrowth causing functional impairment",
    "Development of deep vein thrombosis or pulmonary embolism",
    "Presence of cerebriform connective tissue nevus"
  ],
