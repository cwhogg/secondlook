  "diagnosticCriteria": {
    "formalCriteriaName": "Temple Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of maternal uniparental disomy of chromosome 14 or epigenetic alterations at the 14q32 imprinted region",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-restriction",
        "description": "Pre- and postnatal growth retardation including low birth weight and short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia with delayed motor milestones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "feeding-difficulties",
        "description": "Early feeding difficulties and failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "precocious-puberty",
        "description": "Onset of puberty earlier than average age",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including small hands and feet, and triangular face",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of genetic confirmation plus at least two major clinical criteria",
    "notes": "Molecular genetic testing is essential for definitive diagnosis due to phenotypic overlap with related imprinting disorders."
  },
