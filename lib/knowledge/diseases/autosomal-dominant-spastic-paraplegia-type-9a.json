        "requiredForDiagnosis": true
      },
      {
        "id": "spg9a-genetic-mutation",
        "description": "Identification of pathogenic mutation in the ALDH18A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-secondary-causes",
        "description": "Exclusion of acquired causes of spastic paraplegia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive lower limb spasticity with autosomal dominant family history and confirmed pathogenic ALDH18A1 mutation",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical presentation may overlap with other hereditary spastic paraplegias."
