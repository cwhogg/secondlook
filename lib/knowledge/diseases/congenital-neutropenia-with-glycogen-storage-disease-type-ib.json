  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Glycogen Storage Disease Type Ib",
    "criteria": [
      {
        "id": "neutropenia",
        "description": "Chronic neutropenia with absolute neutrophil count persistently below 500 cells/µL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glucose-6-phosphate-transporter-deficiency",
        "description": "Demonstration of glucose-6-phosphate transporter deficiency by enzymatic assay or genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-abnormalities",
        "description": "Presence of metabolic abnormalities including hypoglycemia, lactic acidosis, hyperuricemia, and hyperlipidemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepato-nephromegaly",
        "description": "Hepatomegaly and/or nephromegaly detected clinically or by imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "recurrent-infections",
        "description": "Recurrent bacterial infections due to neutropenia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic neutropenia, metabolic abnormalities consistent with GSD Ib, and confirmation of glucose-6-phosphate transporter deficiency by genetic or enzymatic testing",
    "notes": "Genetic testing for SLC37A4 mutations is confirmatory."
  },
