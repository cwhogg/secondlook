  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Autosomal Dominant Intermediate Charcot-Marie-Tooth Disease",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of progressive distal muscle weakness and atrophy predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies showing intermediate slowing of motor nerve conduction velocities (25-45 m/s)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the DNM2 gene associated with CMT type F",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Nerve biopsy showing intermediate neuropathic features with axonal and demyelinating changes",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal neuropathy with intermediate nerve conduction velocities and pathogenic DNM2 mutation",
    "notes": "Genetic confirmation is essential for definitive diagnosis; electrophysiological studies help differentiate from other CMT subtypes."
  },
