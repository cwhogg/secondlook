  "diagnosticCriteria": {
    "formalCriteriaName": "Adult Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including prominent forehead and midface hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-neurological-dysfunction",
        "description": "Progressive neurological symptoms such as spasticity and ataxia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multisystem-involvement",
        "description": "Involvement of at least two additional organ systems such as dermatological and musculoskeletal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the ADULT gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-similar-disorders",
        "description": "Exclusion of other syndromes with overlapping features by clinical and genetic testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met for diagnosis; genetic confirmation supports diagnosis but is not mandatory.",
    "notes": "Diagnosis relies heavily on clinical presentation due to limited availability of genetic testing."
