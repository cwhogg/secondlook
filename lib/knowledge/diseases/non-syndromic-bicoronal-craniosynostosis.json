  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Non-syndromic Bicoronal Craniosynostosis",
    "criteria": [
      {
        "id": "bicoronal-suture-fusion",
        "description": "Premature fusion of both coronal sutures confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-syndromic-features",
        "description": "Lack of extracranial anomalies or features suggestive of syndromic craniosynostosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-cranial-deformity",
        "description": "Presence of brachycephaly and frontal flattening with a high, broad forehead",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-genetic-testing",
        "description": "Negative genetic testing for known syndromic craniosynostosis mutations (e.g., FGFR2, TWIST1)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Premature bicoronal suture fusion with characteristic cranial deformity and absence of syndromic features",
    "notes": "Diagnosis is primarily clinical supported by imaging; genetic testing helps exclude syndromic forms."
  },
