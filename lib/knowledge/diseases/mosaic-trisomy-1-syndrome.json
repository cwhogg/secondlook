  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Mosaic Trisomy 1",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Detection of mosaic trisomy 1 in peripheral blood or fibroblast karyotyping",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial anomalies including micrognathia, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Intrauterine growth retardation and postnatal failure to thrive",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-malformations",
        "description": "Presence of congenital malformations such as cardiac defects or limb anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of mosaic trisomy 1 plus presence of at least two major clinical features",
    "notes": "Diagnosis requires both genetic confirmation and clinical correlation due to phenotypic variability."
  },
