  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for STT3B-CDG",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the STT3B gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-glycosylation",
        "description": "Demonstration of abnormal N-linked glycosylation pattern on transferrin isoelectric focusing or mass spectrometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of multisystem clinical features consistent with congenital disorder of glycosylation including neurological and hepatic involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-lab",
        "description": "Elevated liver transaminases and coagulation abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biallelic pathogenic variants in STT3B plus abnormal glycosylation pattern and compatible clinical features",
    "notes": "Diagnosis requires integration of genetic, biochemical, and clinical data."
