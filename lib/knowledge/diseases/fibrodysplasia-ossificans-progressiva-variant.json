  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (ESR, CRP) during flare-ups"
    ],
    "imaging": [
      "Heterotopic bone formation visible on X-ray and CT scans",
      "Absence or atypical presentation of great toe malformations on skeletal survey"
    ],
    "genetic": [
      "Presence of atypical ACVR1 gene mutations distinct from classic R206H mutation",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Soft tissue swelling and inflammation preceding ossification episodes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "classic-fibrodysplasia-ossificans-progressiva",
      "distinguishingFeatures": [
        "Presence of classic great toe malformations",
        "Typical ACVR1 R206H mutation",
        "More predictable ossification pattern"
      ]
    },
    {
      "diseaseId": "progressive-osseous-heteroplasia",
      "distinguishingFeatures": [
        "Heterotopic ossification begins in dermis and subcutaneous fat",
        "Lack of congenital skeletal malformations",
        "Different genetic etiology (GNAS mutations)"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive heterotopic ossification causing joint ankylosis",
    "Respiratory compromise due to thoracic cage involvement",
    "Severe flare-ups with systemic symptoms"
  ],
