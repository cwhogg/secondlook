        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in PHKG2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Documented growth delay or failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "mild-hypoglycemia",
        "description": "Episodes of mild fasting hypoglycemia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hepatomegaly plus reduced phosphorylase kinase activity and/or genetic confirmation of PHKG2 mutation",
    "notes": "Liver biopsy enzyme assay and genetic testing are critical for definitive diagnosis."
  },
