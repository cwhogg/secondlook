  "keyFindings": {
    "laboratory": [
      "Complete blood count may show transient myeloproliferative disorder in neonates",
      "Thyroid function tests indicating hypothyroidism"
    ],
    "imaging": [
      "Echocardiogram revealing atrioventricular septal defects or other congenital heart defects",
      "Cervical spine radiographs to assess atlantoaxial instability"
    ],
    "genetic": [
      "Karyotype showing trisomy 21 (47,XX,+21 or 47,XY,+21)",
      "Fluorescence in situ hybridization (FISH) or chromosomal microarray confirming extra chromosome 21 material"
    ],
    "other": [
      "Developmental assessments demonstrating intellectual disability",
      "Physical examination revealing characteristic dysmorphic features"
    ]
  },
