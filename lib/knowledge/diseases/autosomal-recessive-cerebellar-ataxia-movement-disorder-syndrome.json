  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Autosomal Recessive Cerebellar Ataxia-Movement Disorder Syndrome",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia evidenced by gait disturbance and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "movement-disorder",
        "description": "Presence of extrapyramidal movement disorder features such as dystonia, chorea, or myoclonus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in causative gene(s) associated with ARCA-MDS",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI evidence of cerebellar atrophy without significant supratentorial abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-ataxias",
        "description": "Exclusion of other known causes of cerebellar ataxia and movement disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia and movement disorder with genetic confirmation of biallelic pathogenic variants",
    "notes": "Diagnosis requires exclusion of acquired and other hereditary ataxias; genetic testing is essential for confirmation."
  },
