  "diagnosticCriteria": {
    "formalCriteriaName": "CHAND Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cranial-nerve-palsy",
        "description": "Presence of congenital cranial nerve palsies affecting ocular motility",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypopigmented-skin-lesions",
        "description": "Hypopigmented macules or patches on the skin consistent with neurocutaneous involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-hypoplasia",
        "description": "Neuroimaging evidence of cerebellar hypoplasia or dysgenesis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history suggestive of autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: congenital cranial nerve palsies, hypopigmented skin lesions, and developmental delay",
    "notes": "Diagnosis is clinical and supported by neuroimaging and family history; genetic testing may assist but no definitive gene identified."
  },
