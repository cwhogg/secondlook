{
  "id": "palindromic-rheumatism",
  "name": "Palindromic Rheumatism",
  "aliases": [
    "Palindromic Arthritis",
    "Episodic Rheumatism"
  ],
  "icd10Codes": [
    "M06.3"
  ],
  "prevalence": {
    "estimate": "1 in 100,000",
    "classification": "rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 20,
      "max": 60,
      "peak": 40
    },
    "sexPredilection": "slight-female",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Palindromic Rheumatism Diagnostic Criteria",
    "criteria": [
      {
        "id": "episodic-arthritis",
        "description": "Recurrent sudden attacks of mono- or oligoarticular arthritis lasting hours to days",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "complete-resolution",
        "description": "Complete resolution of symptoms and signs between attacks without joint damage",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-radiographic-damage",
        "description": "No radiographic evidence of joint erosion or damage between attacks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-arthritis",
        "description": "Exclusion of other causes of recurrent arthritis such as gout or rheumatoid arthritis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent sudden arthritis attacks with complete resolution and absence of joint damage on imaging",
    "notes": "Diagnosis is clinical and requires exclusion of other arthritides"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Recurrent sudden monoarticular arthritis attacks",
        "frequency": 0.9,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Complete resolution of joint swelling and pain between attacks",
        "frequency": 0.85,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Short duration of attacks (hours to days)",
        "frequency": 0.75,
        "bodySystem": "musculoskeletal"
      }
    ],
    "common": [
      {
        "symptomName": "Joint pain (arthralgia) during attacks",
        "frequency": 0.85,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Joint swelling and erythema during attacks",
        "frequency": 0.7,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Morning stiffness lasting less than 30 minutes",
        "frequency": 0.65,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Fatigue during attacks",
        "frequency": 0.6,
        "bodySystem": "constitutional"
      }
    ],
    "occasional": [
      {
        "symptomName": "Low-grade fever during attacks",
        "frequency": 0.4,
        "bodySystem": "constitutional"
      },
      {
        "symptomName": "Tenderness over affected joints",
        "frequency": 0.35,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Transient joint effusion",
        "frequency": 0.3,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Malaise",
        "frequency": 0.25,
        "bodySystem": "constitutional"
      }
    ],
    "rare": [
      {
        "symptomName": "Extra-articular manifestations such as rash",
        "frequency": 0.05,
        "bodySystem": "dermatological"
      },
      {
        "symptomName": "Lymphadenopathy",
        "frequency": 0.04,
        "bodySystem": "hematological"
      },
      {
        "symptomName": "Positive rheumatoid nodules",
        "frequency": 0.02,
        "bodySystem": "dermatological"
      }
    ]
  },
  "systemsAffected": [
    "musculoskeletal",
    "constitutional",
    "dermatological",
    "hematological"
  ],
  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP during attacks",
      "Positive rheumatoid factor (in ~50% of patients)",
      "Anti-cyclic citrullinated peptide (anti-CCP) antibodies may be positive"
    ],
    "imaging": [
      "Normal joint X-rays without erosions",
      "Ultrasound may show synovitis during attacks"
    ],
    "genetic": [
      "Association with HLA-DRB1 alleles similar to rheumatoid arthritis"
    ],
    "other": [
      "Synovial fluid analysis shows inflammatory profile without crystals"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "rheumatoid-arthritis",
      "distinguishingFeatures": [
        "Persistent joint swelling and pain without complete resolution",
        "Radiographic joint erosions",
        "Chronic progressive course"
      ]
    },
    {
      "diseaseId": "gout",
      "distinguishingFeatures": [
        "Presence of monosodium urate crystals in synovial fluid",
        "Typically affects first metatarsophalangeal joint",
        "Hyperuricemia"
      ]
    }
  ],
  "redFlags": [
    "Persistent joint swelling without resolution",
    "Radiographic evidence of joint erosion",
    "Systemic symptoms such as high fever or weight loss"
  ],
  "specialistType": [
    "Rheumatologist"
  ],
  "lastUpdated": "2026-02-17",
