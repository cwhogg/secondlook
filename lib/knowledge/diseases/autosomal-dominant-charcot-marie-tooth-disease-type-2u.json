  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for CMT2U",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of a length-dependent sensorimotor neuropathy with distal muscle weakness and atrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electrophysiological evidence of axonal neuropathy with reduced compound muscle action potential amplitudes and normal or mildly reduced conduction velocities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic heterozygous mutations in the DNMT1 gene associated with CMT2U",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-atrophy-pattern",
        "description": "Predominant distal lower limb muscle atrophy with mild upper limb involvement",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical neuropathy, electrophysiological evidence of axonal neuropathy, and identification of a pathogenic DNMT1 mutation",
    "notes": "Genetic testing is essential to confirm diagnosis due to phenotypic overlap with other CMT subtypes."
  },
