  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for XP-CS Complex",
    "criteria": [
      {
        "id": "photosensitivity",
        "description": "Severe photosensitivity with early onset freckling and poikiloderma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurodegeneration",
        "description": "Progressive neurodegeneration including microcephaly, developmental delay, and sensorineural hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dna-repair-defect",
        "description": "Molecular confirmation of nucleotide excision repair defect involving ERCC genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Severe postnatal growth failure and cachexia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-abnormalities",
        "description": "Ocular abnormalities including cataracts and retinal degeneration",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria including photosensitivity, neurodegeneration, and molecular confirmation of DNA repair defect",
    "notes": "Diagnosis is supported by clinical features overlapping both Xeroderma Pigmentosum and Cockayne Syndrome with genetic testing confirming mutations in ERCC genes."
  },
