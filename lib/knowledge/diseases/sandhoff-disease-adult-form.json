  "diagnosticCriteria": {
    "formalCriteriaName": "Sandhoff Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of β-hexosaminidase A and B enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the HEXB gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of progressive neurological symptoms including cerebellar ataxia and motor neuron signs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI findings consistent with cerebral and cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of β-hexosaminidase A and B enzyme activity plus identification of pathogenic HEXB mutations with compatible clinical features",
    "notes": "Diagnosis is confirmed by biochemical enzyme assay and genetic testing; neuroimaging and clinical features support diagnosis."
  },
