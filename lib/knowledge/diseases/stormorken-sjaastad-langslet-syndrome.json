  "keyFindings": {
    "laboratory": [
      "Persistent thrombocytopenia with normal platelet morphology",
      "Hypocalcemia on serum chemistry",
      "Elevated creatine kinase (CK) levels"
    ],
    "imaging": [
      "Muscle MRI showing fatty infiltration and atrophy",
      "Abdominal ultrasound demonstrating absent or hypoplastic spleen"
    ],
    "genetic": [
      "ORAI1 (causative, gain-of-function)",
      "STIM1 (causative, gain-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography (EMG) showing myopathic changes",
      "Ophthalmologic exam confirming persistent miosis"
    ]
