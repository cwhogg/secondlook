  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild hypothyroidism in rare cases"
    ],
    "imaging": [
      "Brain MRI may show nonspecific delayed myelination or mild cerebral atrophy",
      "Polysomnography confirming obstructive sleep apnea"
    ],
    "genetic": [
      "AHDC1 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Mild craniofacial dysmorphism on clinical examination",
      "Developmental assessment confirming intellectual disability"
    ]
  },
