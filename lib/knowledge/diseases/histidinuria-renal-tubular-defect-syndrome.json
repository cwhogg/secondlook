      "Hypophosphatemia and hypokalemia"
    ],
    "imaging": [
      "Renal ultrasound may show nephrocalcinosis in rare cases"
    ],
    "genetic": [
      "Mutations affecting renal tubular amino acid transporters (if identified)"
    ],
