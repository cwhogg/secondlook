    "formalCriteriaName": "Clinical and Radiological Diagnosis of Meconium Aspiration Syndrome",
    "criteria": [
      {
        "id": "meconium-stained-amniotic-fluid",
        "description": "Presence of meconium-stained amniotic fluid at delivery",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "respiratory-distress",
        "description": "Respiratory distress in the neonate within hours of birth (tachypnea, grunting, nasal flaring, retractions)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chest-radiograph-findings",
        "description": "Chest X-ray showing patchy infiltrates, hyperinflation, and areas of atelectasis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-causes",
        "description": "Exclusion of other causes of neonatal respiratory distress such as pneumonia or respiratory distress syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of meconium-stained amniotic fluid, respiratory distress within hours of birth, and characteristic chest radiograph findings",
    "notes": "Diagnosis is clinical supported by imaging and exclusion of other causes"
  },
