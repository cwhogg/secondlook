  "diagnosticCriteria": {
    "formalCriteriaName": "Cohen Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "developmental-delay",
        "description": "Developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neutropenia",
        "description": "Chronic neutropenia documented by laboratory testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facial-features",
        "description": "Characteristic facial features including microcephaly, prominent nasal bridge, and thick hair",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-abnormalities",
        "description": "Ocular abnormalities such as myopia and retinal dystrophy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "truncal-obesity",
        "description": "Truncal obesity with slender extremities",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "joint-hyperextensibility",
        "description": "Joint hyperextensibility and hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (developmental delay, chronic neutropenia, and characteristic facial features) with supportive genetic testing",
    "notes": "Genetic confirmation via VPS13B gene mutation analysis is recommended for definitive diagnosis."
  },
