  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Tumors of Hematopoietic and Lymphoid Tissues",
    "criteria": [
      {
        "id": "t15-17-translocation",
        "description": "Presence of t(15;17)(q22;q12) translocation or PML-RARA fusion gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "morphology",
        "description": "Bone marrow biopsy showing abnormal promyelocytes with heavy granulation and Auer rods",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "coagulopathy",
        "description": "Evidence of disseminated intravascular coagulation (DIC) or bleeding diathesis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of t(15;17) translocation or PML-RARA fusion gene plus characteristic bone marrow morphology",
    "notes": "Molecular confirmation is essential for diagnosis and treatment planning"
  },
