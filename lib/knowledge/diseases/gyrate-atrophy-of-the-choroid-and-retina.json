    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for Gyrate Atrophy",
    "criteria": [
      {
        "id": "clinical-retinal-findings",
        "description": "Characteristic progressive chorioretinal atrophy with scalloped peripheral lesions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyperornithinemia",
        "description": "Elevated plasma ornithine concentration due to ornithine aminotransferase deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the OAT gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "electroretinography",
        "description": "Reduced or extinguished rod and cone responses on electroretinogram",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic chorioretinal atrophy and elevated plasma ornithine levels",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if clinical and biochemical criteria are met."
  },
