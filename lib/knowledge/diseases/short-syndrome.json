  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for SHORT syndrome",
    "criteria": [
      {
        "id": "short-stature",
        "description": "Short stature present from infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facial-dysmorphism",
        "description": "Characteristic facial features including triangular face, prominent forehead, and deeply set eyes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "Ocular depression and Rieger anomaly (anterior segment dysgenesis of the eye)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "delayed-teething",
        "description": "Delayed eruption of primary teeth",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "lipodystrophy",
        "description": "Partial lipodystrophy affecting the face and upper body",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "insulin-resistance",
        "description": "Insulin resistance or early-onset diabetes mellitus",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of short stature, characteristic facial dysmorphism, and ocular anomalies",
    "notes": "Genetic testing for mutations in the PIK3R1 gene can confirm diagnosis"
  },
