  "diagnosticCriteria": {
    "formalCriteriaName": "PPoma Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histopathological confirmation of pancreatic neuroendocrine tumor with immunohistochemical positivity for pancreatic polypeptide",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-pp-levels",
        "description": "Elevated serum pancreatic polypeptide levels above normal reference range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-localization",
        "description": "Localization of pancreatic mass consistent with neuroendocrine tumor on imaging (CT, MRI, or somatostatin receptor scintigraphy)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-symptoms",
        "description": "Presence of symptoms attributable to pancreatic polypeptide secretion such as watery diarrhea and weight loss",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation with immunohistochemistry plus elevated serum pancreatic polypeptide and imaging localization of pancreatic tumor",
    "notes": "Diagnosis requires exclusion of other pancreatic neuroendocrine tumors and functional syndromes."
  },
