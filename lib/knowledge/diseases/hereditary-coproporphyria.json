  "diagnosticCriteria": {
    "formalCriteriaName": "Biochemical and genetic criteria for hereditary coproporphyria",
    "criteria": [
      {
        "id": "hcp-c1",
        "description": "Markedly elevated fecal coproporphyrin III (coproporphyrin III/I ratio >2)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hcp-c2",
        "description": "Elevated urinary PBG and ALA during acute attacks",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hcp-c3",
        "description": "Pathogenic variant in CPOX gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hcp-c4",
        "description": "Reduced coproporphyrinogen oxidase (CPOX) enzyme activity (~50%)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hcp-c5",
        "description": "Neurovisceral symptoms consistent with acute porphyria attack",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hcp-c6",
        "description": "Cutaneous photosensitivity with skin blistering",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated fecal coproporphyrin III with elevated urinary PBG during attacks, confirmed by CPOX gene testing",
    "notes": "HCP shares neurovisceral features with AIP but may also have cutaneous photosensitivity. Homozygous HCP (harderoporphyria) is extremely rare and presents in infancy."
  },
