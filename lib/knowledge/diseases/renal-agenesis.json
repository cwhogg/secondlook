  "diagnosticCriteria": {
    "formalCriteriaName": "Prenatal and Postnatal Imaging Diagnostic Criteria for Renal Agenesis",
    "criteria": [
      {
        "id": "absence-kidney",
        "description": "Complete absence of one or both kidneys confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-renal-artery",
        "description": "Absence of corresponding renal artery on Doppler ultrasound or angiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "compensatory-hypertrophy",
        "description": "Compensatory hypertrophy of contralateral kidney in unilateral cases",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of complete absence of kidney(s) on imaging with absent renal artery; compensatory hypertrophy supports diagnosis in unilateral cases",
    "notes": "Diagnosis is often made prenatally via ultrasound or confirmed postnatally with ultrasound, MRI, or CT."
  },
