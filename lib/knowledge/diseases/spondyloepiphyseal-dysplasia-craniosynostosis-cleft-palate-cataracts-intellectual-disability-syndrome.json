        "requiredForDiagnosis": true
      },
      {
        "id": "cleft-palate",
        "description": "Presence of cleft palate or submucous cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-cataracts",
        "description": "Bilateral congenital cataracts identified clinically or by imaging",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability confirmed by neurodevelopmental assessment",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of spondyloepiphyseal dysplasia, craniosynostosis, and cleft palate",
    "notes": "Genetic testing may support diagnosis but causative gene not yet definitively identified"
  },
