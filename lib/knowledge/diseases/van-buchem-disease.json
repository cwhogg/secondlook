  "diagnosticCriteria": {
    "formalCriteriaName": "Van Buchem Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "hyperostosis-skull-mandible",
        "description": "Radiologically confirmed hyperostosis of the skull and mandible",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing-sost",
        "description": "Identification of biallelic mutations or deletions in the SOST gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of progressive facial nerve palsy or cranial nerve compression symptoms",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of radiological hyperostosis of skull and mandible plus genetic confirmation of SOST mutation or deletion",
    "notes": "Diagnosis may be supported by clinical features and family history but requires imaging and genetic confirmation."
  },
