  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; exclusion of metabolic causes",
      "Elevated creatine kinase in severe cases"
    ],
    "imaging": [
      "MRI may show nonspecific white matter abnormalities",
      "Functional imaging may reveal altered basal ganglia activity"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electroencephalogram (EEG) typically normal or nonspecific",
      "Response to lorazepam challenge test supportive"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "neuroleptic-malignant-syndrome",
      "distinguishingFeatures": [
        "Recent exposure to neuroleptic drugs",
        "Hyperthermia and autonomic instability",
        "Elevated creatine kinase and leukocytosis"
      ]
    },
    {
      "diseaseId": "autoimmune-encephalitis",
      "distinguishingFeatures": [
        "Presence of autoantibodies",
        "Rapid onset with seizures and cognitive decline",
        "CSF pleocytosis or oligoclonal bands"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of catatonic symptoms",
    "Autonomic instability with cardiovascular compromise",
    "Failure to respond to benzodiazepines or ECT"
  ],
