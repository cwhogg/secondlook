  "diagnosticCriteria": {
    "formalCriteriaName": "Idiopathic Copper-Associated Cirrhosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "hepatic-copper-accumulation",
        "description": "Elevated hepatic copper concentration exceeding 250 µg/g dry weight in liver biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cirrhosis-on-biopsy",
        "description": "Histological evidence of cirrhosis without identifiable cause",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-wilson-disease",
        "description": "Normal ceruloplasmin levels and absence of ATP7B mutations to exclude Wilson disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-liver-disease",
        "description": "Exclusion of other known causes of cirrhosis such as viral hepatitis, alcohol, autoimmune hepatitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hepatic copper accumulation and cirrhosis on biopsy with exclusion of Wilson disease and other known causes of liver disease",
    "notes": "Diagnosis is one of exclusion; genetic testing for Wilson disease is essential."
  },
