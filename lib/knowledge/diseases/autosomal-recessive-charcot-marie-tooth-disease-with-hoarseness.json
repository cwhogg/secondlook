  "keyFindings": {
    "laboratory": [
      "Elevated creatine kinase may be mild or normal",
      "Routine blood tests typically normal"
    ],
    "imaging": [
      "MRI of larynx may show vocal cord paralysis",
      "Muscle MRI may show distal muscle atrophy"
    ],
    "genetic": [
      "GDAP1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Nerve conduction studies showing reduced conduction velocities or axonal loss",
      "Electromyography demonstrating chronic denervation"
    ]
  },
  "differentialDiagnoses": [
