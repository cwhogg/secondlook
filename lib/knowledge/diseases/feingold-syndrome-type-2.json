    "formalCriteriaName": "Feingold Syndrome Type 2 Diagnostic Criteria",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Presence of microcephaly (head circumference below the 3rd percentile)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digital-anomalies",
        "description": "Syndactyly or brachymesophalangy of the 2nd and 3rd toes or fingers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gastrointestinal-malformations",
        "description": "Esophageal or duodenal atresia or stenosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "learning-disability",
        "description": "Mild to moderate intellectual disability or learning difficulties",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "short-stature",
        "description": "Postnatal short stature below the 5th percentile",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microcephaly, digital anomalies, and gastrointestinal malformations",
    "notes": "Genetic testing for MYCN gene mutations can support diagnosis"
  },
