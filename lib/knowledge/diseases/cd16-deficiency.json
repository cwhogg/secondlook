  "diagnosticCriteria": {
    "formalCriteriaName": "CD16 Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "nk-cell-cytotoxicity",
        "description": "Markedly reduced or absent natural killer cell antibody-dependent cellular cytotoxicity (ADCC) activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cd16-expression",
        "description": "Absent or significantly decreased CD16 (FCGR3A) expression on natural killer cells by flow cytometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-viral-infections",
        "description": "History of recurrent or severe viral infections, particularly herpesviruses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in FCGR3A gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-immune-cell-counts",
        "description": "Normal total lymphocyte and NK cell counts",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria related to NK cell function and CD16 expression plus clinical history of recurrent viral infections",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if clinical and laboratory criteria are met."
  },
