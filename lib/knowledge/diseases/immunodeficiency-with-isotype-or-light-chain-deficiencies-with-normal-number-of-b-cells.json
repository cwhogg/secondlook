        "id": "impaired-specific-antibody-response",
        "description": "Impaired specific antibody response to vaccines or infections",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of normal B-cell count with documented deficiency of one or more immunoglobulin isotypes or light chains plus recurrent infections, after exclusion of secondary causes",
