  "diagnosticCriteria": {
    "formalCriteriaName": "Anderson type familial osteodysplasia diagnostic criteria",
    "criteria": [
      {
        "id": "skeletal-dysplasia",
        "description": "Presence of generalized skeletal dysplasia with metaphyseal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Short stature with disproportionate limb shortening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-findings",
        "description": "Characteristic radiographic findings including widened metaphyses and irregular epiphyses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development without neurological impairment",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: skeletal dysplasia, short stature with limb shortening, and characteristic radiographic findings",
    "notes": "Genetic testing may assist but is not always definitive due to unknown causative gene."
  },
