  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Blue Cone Monochromatism",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Congenital severe color vision deficiency with reduced visual acuity and photophobia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electroretinogram (ERG) showing absent or severely reduced L- and M-cone responses with preserved S-cone function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Pathogenic variants or deletions in the OPN1LW and OPN1MW genes on the X chromosome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "X-linked inheritance pattern with affected males and carrier females",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus confirmatory electrophysiology and/or genetic testing",
    "notes": "Diagnosis is primarily clinical supported by electrophysiological and genetic confirmation."
  },
