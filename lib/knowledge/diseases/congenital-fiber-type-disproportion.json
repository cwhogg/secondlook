  "diagnosticCriteria": {
    "formalCriteriaName": "Congenital Fiber Type Disproportion Diagnostic Criteria",
    "criteria": [
      {
        "id": "fiber-type-disproportion",
        "description": "Selective smallness of type 1 muscle fibers on muscle biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-muscle-weakness",
        "description": "Congenital or early-onset muscle weakness predominantly affecting proximal muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-myopathies",
        "description": "Exclusion of other congenital myopathies by clinical, histological, and genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyography showing myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with CFTD (e.g., TPM3, ACTA1)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of selective type 1 fiber smallness on muscle biopsy plus clinical evidence of congenital muscle weakness with exclusion of other myopathies",
    "notes": "Genetic testing can support diagnosis but is not mandatory; diagnosis relies heavily on muscle biopsy findings."
  },
