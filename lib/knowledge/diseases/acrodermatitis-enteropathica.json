        "description": "Rapid clinical improvement after zinc supplementation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the SLC39A4 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical triad plus low serum zinc and clinical response to zinc supplementation",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory"
