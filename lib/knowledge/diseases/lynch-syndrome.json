  "diagnosticCriteria": {
    "formalCriteriaName": "Amsterdam II Criteria",
    "criteria": [
      {
        "id": "family-history",
        "description": "At least three relatives with Lynch syndrome-associated cancers, one of whom is a first-degree relative of the other two",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "generations",
        "description": "Involvement of at least two successive generations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset",
        "description": "At least one Lynch syndrome-associated cancer diagnosed before age 50",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tumor-testing",
        "description": "Tumor demonstrating microsatellite instability or loss of mismatch repair protein expression",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met for clinical diagnosis; tumor testing supports diagnosis",
    "notes": "Genetic testing for mismatch repair gene mutations confirms diagnosis"
  },
