  "keyFindings": {
    "laboratory": [
      "Elevated serum IgG4 levels (>135 mg/dL)",
      "Hypocomplementemia (low C3 and C4)",
      "Elevated serum creatinine indicating renal impairment",
      "Mild proteinuria and microscopic hematuria"
    ],
    "imaging": [
      "Multiple low-density lesions on contrast-enhanced CT of kidneys",
      "Diffuse renal enlargement or swelling",
      "MRI showing characteristic renal parenchymal changes"
    ],
    "genetic": [],
    "other": [
      "Renal biopsy demonstrating dense lymphoplasmacytic infiltration with IgG4-positive plasma cells and storiform fibrosis",
      "Response to corticosteroid therapy with improvement in renal function and imaging"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "lupus-nephritis",
      "distinguishingFeatures": [
        "Presence of systemic lupus erythematosus clinical features",
        "Positive ANA and anti-dsDNA antibodies",
        "Different histopathological pattern on renal biopsy"
      ]
    },
    {
      "diseaseId": "tubulointerstitial-nephritis",
      "distinguishingFeatures": [
        "Absence of elevated serum IgG4",
        "No storiform fibrosis or IgG4-positive plasma cells on biopsy",
        "Often associated with drug exposure or infection"
      ]
    },
    {
      "diseaseId": "renal-cell-carcinoma",
      "distinguishingFeatures": [
        "Mass lesion on imaging with characteristic enhancement",
        "No elevated serum IgG4",
        "Histology showing malignant epithelial cells"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive renal failure",
    "Marked hypocomplementemia",
    "Failure to respond to corticosteroid therapy"
  ],
