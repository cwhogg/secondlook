  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP",
      "Mild normocytic anemia",
      "Normal or mildly impaired renal function tests"
    ],
    "imaging": [
      "CT or MRI showing retroperitoneal soft tissue mass encasing abdominal aorta and ureters",
      "Hydronephrosis on ultrasound or CT",
      "Delayed excretion on renal scintigraphy"
    ],
    "genetic": [
      "No known genetic mutations associated"
    ],
    "other": [
      "Histopathology showing dense fibrosis with chronic inflammatory infiltrate",
      "Exclusion of malignancy and infection"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "malignant-retroperitoneal-tumor",
      "distinguishingFeatures": [
        "Presence of malignant cells on biopsy",
        "Rapid progression and systemic symptoms",
        "Lack of response to immunosuppressive therapy"
      ]
    },
    {
      "diseaseId": "retroperitoneal-infection",
      "distinguishingFeatures": [
        "Positive microbiological cultures",
        "Fever and systemic signs of infection",
        "Response to antibiotics"
      ]
    },
    {
      "diseaseId": "secondary-retroperitoneal-fibrosis",
      "distinguishingFeatures": [
        "History of drugs, radiation, or surgery",
        "Associated autoimmune or neoplastic conditions",
        "Different imaging characteristics"
      ]
    }
  ],
  "redFlags": [
    "Acute renal failure due to bilateral ureteral obstruction",
    "Rapidly progressive lower limb edema or claudication",
    "Severe uncontrolled hypertension secondary to renal artery stenosis"
  ],
