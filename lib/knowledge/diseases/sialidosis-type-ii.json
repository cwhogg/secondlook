  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for Sialidosis",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of alpha-N-acetyl neuraminidase enzyme activity in cultured fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features including dysmorphic facies, developmental delay, and organomegaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the NEU1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cherry-red-spot",
        "description": "Presence of cherry-red spot on ophthalmologic examination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of alpha-N-acetyl neuraminidase enzyme activity plus either characteristic clinical features or pathogenic NEU1 mutations",
    "notes": "Genetic confirmation is preferred for definitive diagnosis."
  },
