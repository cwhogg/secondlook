  "diagnosticCriteria": {
    "formalCriteriaName": "Bohring-Opitz Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "asxl1-mutation",
        "description": "Presence of pathogenic ASXL1 gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial features including trigonocephaly, prominent metopic suture, microcephaly, and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bohring-opitz-posture",
        "description": "Typical Bohring-Opitz posture with flexion at elbows and wrists and ulnar deviation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Severe intrauterine and postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay and intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic ASXL1 mutation plus at least two major clinical features including distinctive facial features and Bohring-Opitz posture",
    "notes": "Genetic testing for ASXL1 mutations is essential for confirmation."
  },
