  "diagnosticCriteria": {
    "formalCriteriaName": "Nemaline Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Severe hypotonia and muscle weakness presenting at birth or within the neonatal period",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Muscle biopsy showing nemaline rods in muscle fibers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with nemaline myopathy (e.g., NEB, ACTA1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "respiratory-insufficiency",
        "description": "Early onset respiratory failure requiring ventilatory support",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including elongated face and high-arched palate",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe neonatal hypotonia and muscle weakness plus muscle biopsy demonstrating nemaline rods or pathogenic genetic variant in nemaline myopathy-associated genes",
    "notes": "Genetic confirmation is increasingly used to support diagnosis; muscle biopsy remains gold standard."
  },
