      "Bone scintigraphy showing oxalate deposition"
    ],
    "genetic": [
      "Pathogenic mutations in AGXT (PH type 1)",
      "Pathogenic mutations in GRHPR (PH type 2)",
      "Pathogenic mutations in HOGA1 (PH type 3)",
      "Autosomal recessive inheritance"
    ],
    "other": [
