  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced glucosephosphate isomerase enzyme activity in erythrocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemolytic-anemia",
        "description": "Chronic hemolytic anemia with reticulocytosis and elevated indirect bilirubin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the GPI gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other common causes of hemolytic anemia (e.g., G6PD deficiency, pyruvate kinase deficiency)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic hemolytic anemia with reduced GPI enzyme activity and identification of pathogenic GPI gene mutations",
    "notes": "Diagnosis requires combination of biochemical enzyme assay and molecular genetic confirmation"
  },
