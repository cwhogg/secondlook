  "diagnosticCriteria": {
    "formalCriteriaName": "Barth Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cardiomyopathy",
        "description": "Presence of dilated or hypertrophic cardiomyopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neutropenia",
        "description": "Chronic or intermittent neutropenia documented by serial blood counts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tafazzin-mutation",
        "description": "Pathogenic mutation in the TAZ (tafazzin) gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-myopathy",
        "description": "Clinical or electromyographic evidence of skeletal myopathy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-delay",
        "description": "Delayed growth and failure to thrive in infancy or early childhood",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "3-methylglutaconic-aciduria",
        "description": "Elevated urinary 3-methylglutaconic acid levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of cardiomyopathy, neutropenia, and a pathogenic TAZ gene mutation",
    "notes": "Diagnosis may be supported by biochemical findings and clinical features but requires genetic confirmation."
  },
