  "keyFindings": {
    "laboratory": [
      "Elevated methemoglobin fraction on co-oximetry",
      "Normal arterial oxygen tension (PaO2) despite cyanosis",
      "Normal or decreased oxygen saturation by pulse oximetry"
    ],
    "imaging": [
      "Usually normal chest X-ray",
      "Brain imaging may show hypoxic injury in severe cases"
    ],
    "genetic": [
      "TWIST2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Characteristic chocolate-brown colored blood sample",
      "Response to methylene blue treatment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cyanotic-congenital-heart-disease",
      "distinguishingFeatures": [
        "Abnormal cardiac anatomy on echocardiogram",
        "Low PaO2 on arterial blood gas",
        "No improvement with methylene blue"
      ]
    },
    {
      "diseaseId": "sulfhemoglobinemia",
      "distinguishingFeatures": [
        "Presence of sulfhemoglobin on specialized testing",
        "No response to methylene blue",
        "History of exposure to sulfur-containing drugs"
      ]
    }
  ],
  "redFlags": [
    "Rapidly worsening cyanosis despite oxygen therapy",
    "Neurological deterioration (seizures, coma)",
    "Cardiovascular instability or arrhythmias"
  ],
