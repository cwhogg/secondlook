  "diagnosticCriteria": {
    "formalCriteriaName": "Litvan Criteria for PSP-PAGF",
    "criteria": [
      {
        "id": "criterion-1",
        "description": "Progressive gait freezing without limb rigidity or tremor in the first 2 years",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-2",
        "description": "Absence of vertical supranuclear gaze palsy at onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-3",
        "description": "Poor or absent response to levodopa therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "criterion-4",
        "description": "Progressive akinesia with postural instability and falls within 3 years",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of progressive gait freezing and akinesia with postural instability, absence of early vertical gaze palsy, and poor levodopa response",
    "notes": "Diagnosis is clinical and supported by exclusion of other Parkinsonian syndromes"
  },
