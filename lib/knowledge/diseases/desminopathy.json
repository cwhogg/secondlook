        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing desmin-positive protein aggregates and myofibrillar disorganization",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Progressive skeletal myopathy with distal and proximal muscle weakness and cardiomyopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "EMG showing myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history of similar myopathy or cardiomyopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic DES mutation plus muscle biopsy findings consistent with desminopathy and compatible clinical features",
    "notes": "Diagnosis requires integration of genetic, histopathological, and clinical data."
  },
