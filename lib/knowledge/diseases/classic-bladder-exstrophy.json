        "requiredForDiagnosis": true
      },
      {
        "id": "epispadias",
        "description": "Presence of epispadias characterized by dorsal urethral defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pelvic-floor-muscle-deficiency",
        "description": "Deficiency or malformation of pelvic floor musculature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
