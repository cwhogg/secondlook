  "keyFindings": {
    "laboratory": [
      "Hypogammaglobulinemia with low IgG and IgA levels",
      "Impaired specific antibody responses to vaccines",
      "Lymphopenia with reduced T and B cell counts"
    ],
    "imaging": [
      "Chest radiograph may show recurrent pneumonia",
      "CT scan of sinuses may reveal chronic sinusitis"
    ],
    "genetic": [
      "Pathogenic variants in IKBKG (NEMO) gene on X chromosome"
    ],
    "other": [
      "Sweat test demonstrating absent or severely reduced sweating",
      "Dental radiographs showing hypodontia and abnormal tooth morphology"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hypohidrotic-ectodermal-dysplasia",
      "distinguishingFeatures": [
        "Lack of immunodeficiency",
        "Less severe or absent recurrent infections",
        "No mutations in IKBKG gene"
      ]
    },
    {
      "diseaseId": "severe-combined-immunodeficiency",
      "distinguishingFeatures": [
        "Absence of ectodermal dysplasia features",
        "More profound immunodeficiency",
        "Different genetic mutations (e.g. IL2RG, ADA)"
      ]
    }
  ],
  "redFlags": [
