    "laboratory": [
      "Normal or mild hypoxemia on arterial blood gas",
      "No specific blood biomarkers"
    ],
    "imaging": [
      "Chest X-ray showing bilateral lower lobe interstitial fibrosis",
      "High-resolution CT demonstrating subpleural fibrosis and honeycombing",
      "Pleural plaques visible on CT or X-ray"
    ],
    "genetic": [
      "No known genetic markers"
    ],
    "other": [
      "Identification of asbestos bodies in lung biopsy specimens",
      "Pulmonary function tests showing restrictive pattern with reduced diffusion capacity"
    ]
  },
