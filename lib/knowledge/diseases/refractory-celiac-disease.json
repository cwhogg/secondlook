  "diagnosticCriteria": {
    "formalCriteriaName": "Refractory Celiac Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "persistent-malabsorption",
        "description": "Persistent or recurrent malabsorptive symptoms despite strict adherence to a gluten-free diet for at least 12 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "villous-atrophy",
        "description": "Small intestinal biopsy showing persistent villous atrophy despite gluten-free diet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of villous atrophy such as infections, medication effects, or malignancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-lymphocytes",
        "description": "Presence of aberrant intraepithelial lymphocytes (especially in type II RCD)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "negative-serology",
        "description": "Negative or normalized celiac serology despite ongoing symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent malabsorptive symptoms and villous atrophy despite strict gluten-free diet for at least 12 months, with exclusion of other causes",
    "notes": "Subtyping into type I and type II RCD requires immunophenotyping of intraepithelial lymphocytes."
  },
