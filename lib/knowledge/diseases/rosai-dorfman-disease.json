  "diagnosticCriteria": {
    "formalCriteriaName": "Rosai-Dorfman Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "massive-lymphadenopathy",
        "description": "Painless, massive cervical lymphadenopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "emperipolesis",
        "description": "Histopathologic evidence of emperipolesis (lymphocytes within histiocytes)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "s100-positive-histiocytes",
        "description": "Immunohistochemical staining positive for S100 protein in histiocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "extranodal-involvement",
        "description": "Presence of extranodal disease in skin, respiratory tract, or other organs",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of massive lymphadenopathy with histopathologic confirmation of emperipolesis and S100-positive histiocytes",
    "notes": "Diagnosis requires lymph node biopsy with characteristic histopathology and immunohistochemistry."
  },
