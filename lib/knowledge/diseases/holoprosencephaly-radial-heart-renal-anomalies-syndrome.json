  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests unless secondary complications",
      "Possible abnormal renal function tests if renal impairment present"
    ],
    "imaging": [
      "Brain MRI or CT showing holoprosencephaly spectrum",
      "X-rays demonstrating radial ray anomalies",
      "Echocardiography revealing congenital heart defects",
      "Renal ultrasound showing hypoplasia or agenesis"
    ],
    "genetic": [
      "No single gene identified; possible chromosomal abnormalities or mutations in developmental genes",
      "Genetic testing may reveal deletions or mutations associated with midline defects"
    ],
    "other": [
      "Prenatal ultrasound may detect some anomalies",
      "Postmortem examination confirms diagnosis in fatal cases"
    ]
  },
