    "criteria": [
      {
        "id": "absence-fingerprints",
        "description": "Congenital absence of dermatoglyphics (fingerprints) on fingers and toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-milia",
        "description": "Presence of multiple congenital milia (tiny epidermal cysts) on the face and extremities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-sweat-glands",
        "description": "Normal sweat gland function without hypohidrosis or anhidrosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital absence of fingerprints and congenital milia with or without family history",
    "notes": "Diagnosis is primarily clinical; genetic testing may support but is not routinely available."
