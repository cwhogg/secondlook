  "keyFindings": {
    "laboratory": [
      "Presence of anti-MDA5 autoantibodies by ELISA or immunoprecipitation",
      "Normal or mildly elevated creatine kinase",
      "Elevated serum ferritin correlating with disease activity"
    ],
    "imaging": [
      "High-resolution CT showing ground-glass opacities and consolidation consistent with interstitial lung disease",
      "Nailfold capillaroscopy demonstrating capillary dropout and dilated loops"
    ],
    "genetic": [
      "ATP7A (causative, loss-of-function)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Pulmonary function tests showing restrictive pattern and reduced diffusion capacity",
      "Skin biopsy showing interface dermatitis with mucin deposition"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "classic-dermatomyositis",
      "distinguishingFeatures": [
        "More prominent muscle weakness",
        "Higher creatine kinase elevation",
        "Less frequent rapidly progressive ILD"
      ]
    },
    {
      "diseaseId": "antisynthetase-syndrome",
      "distinguishingFeatures": [
        "Presence of anti-synthetase antibodies (e.g. anti-Jo1)",
        "Mechanic’s hands more common",
        "Chronic rather than rapidly progressive ILD"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive respiratory failure",
    "Severe hypoxemia refractory to oxygen therapy",
    "Markedly elevated serum ferritin indicating high disease activity"
  ],
  "specialistType": [
    "Rheumatologist",
    "Pulmonologist",
