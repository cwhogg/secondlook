  "keyFindings": {
    "laboratory": [
      "Low serum potassium during attacks",
      "Elevated free T4 and suppressed TSH indicating thyrotoxicosis",
      "Normal or low serum potassium between attacks"
    ],
    "imaging": [
      "Thyroid ultrasound may show diffuse enlargement or nodules",
      "ECG showing hypokalemia-related changes"
    ],
    "genetic": [
      "CACNA1S (candidate)",
      "GABRA3 (susceptibility)",
      "KCNJ18 (susceptibility)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Electromyography may show reduced muscle excitability during attacks"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "familial-hypokalemic-periodic-paralysis",
      "distinguishingFeatures": [
        "Absence of thyrotoxicosis",
        "Positive family history",
        "Genetic mutations in CACNA1S or SCN4A genes"
      ]
    },
    {
      "diseaseId": "hyperkalemic-periodic-paralysis",
      "distinguishingFeatures": [
        "Elevated or normal serum potassium during attacks",
        "Shorter duration of paralysis episodes",
        "No association with thyroid disease"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression to respiratory muscle paralysis",
    "Severe hypokalemia with cardiac arrhythmias",
    "Recurrent paralysis without evidence of thyrotoxicosis"
  ],
