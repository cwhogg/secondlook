  "keyFindings": {
    "laboratory": [
      "Genetic testing identifying pathogenic TGFBI mutations (e.g., R555W)",
      "Histopathology showing hyaline deposits in corneal stroma"
    ],
    "imaging": [
      "Slit-lamp biomicroscopy revealing granular stromal opacities",
      "Anterior segment optical coherence tomography (AS-OCT) showing hyperreflective stromal deposits"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal dominant mutations in TGFBI gene",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Family history consistent with autosomal dominant inheritance"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "lattice-corneal-dystrophy",
      "distinguishingFeatures": [
        "Amyloid deposits forming lattice lines rather than granular hyaline deposits",
        "Different TGFBI mutations (e.g., R124C)",
        "More frequent recurrent erosions and corneal thinning"
      ]
    },
    {
      "diseaseId": "macular-corneal-dystrophy",
      "distinguishingFeatures": [
        "Diffuse stromal clouding with glycosaminoglycan deposits",
        "Involvement of deeper stromal layers",
        "Associated with CHST6 gene mutations"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of corneal opacities leading to severe vision loss",
    "Recurrent painful corneal erosions unresponsive to standard therapy",
    "Secondary complications such as corneal ulceration or glaucoma"
  ],
  "specialistType": [
    "Ophthalmologist",
