  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for HI/HA Syndrome",
    "criteria": [
      {
        "id": "hyperinsulinemic-hypoglycemia",
        "description": "Documented hypoglycemia with inappropriately elevated insulin levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-plasma-ammonia",
        "description": "Persistent mild to moderate hyperammonemia without primary urea cycle disorder",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glutamate-dehydrogenase-activation",
        "description": "Increased activity of glutamate dehydrogenase enzyme or pathogenic GLUD1 gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-urea-cycle-defects",
        "description": "Exclusion of primary urea cycle enzyme deficiencies by metabolic and genetic testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-diazooxide",
        "description": "Improvement of hypoglycemia with diazoxide therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hyperinsulinemic hypoglycemia, elevated plasma ammonia, and identification of GLUD1 mutation or increased glutamate dehydrogenase activity",
    "notes": "Genetic testing for GLUD1 mutations is confirmatory; biochemical exclusion of other causes of hyperammonemia is essential."
  },
