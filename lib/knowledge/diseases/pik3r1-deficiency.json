        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-infections",
        "description": "History of recurrent sinopulmonary and other bacterial infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
