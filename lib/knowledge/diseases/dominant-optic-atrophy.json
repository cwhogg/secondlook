  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 2,
      "max": 40,
      "peak": 20
    },
    "sexPredilection": "equal",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Dominant Optic Atrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "bilateral-optic-nerve-atrophy",
        "description": "Presence of bilateral optic nerve pallor or atrophy on fundoscopic examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-visual-acuity-loss",
        "description": "Progressive bilateral decrease in visual acuity starting in childhood or early adulthood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "color-vision-defects",
        "description": "Dyschromatopsia, especially tritanopia or blue-yellow color vision defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in OPA1 gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral optic nerve atrophy with progressive visual acuity loss and color vision defects, plus either positive family history or pathogenic OPA1 mutation",
    "notes": "Genetic testing is confirmatory but not mandatory if clinical criteria are met"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Bilateral optic nerve pallor",
        "frequency": 0.95,
        "bodySystem": "ophthalmological",
        "notes": "Characteristic temporal optic disc pallor"
      },
      {
        "symptomName": "Progressive bilateral visual acuity loss",
        "frequency": 0.9,
        "bodySystem": "ophthalmological",
        "notes": "Typically insidious onset in childhood or early adulthood"
      },
      {
        "symptomName": "Color vision defects (tritanopia)",
        "frequency": 0.75,
        "bodySystem": "ophthalmological",
        "notes": "Blue-yellow color vision impairment is common"
      }
    ],
    "common": [
      {
        "symptomName": "Central or cecocentral scotomas",
        "frequency": 0.7,
        "bodySystem": "ophthalmological",
        "notes": "Visual field defects affecting central vision"
      },
      {
        "symptomName": "Dyschromatopsia",
        "frequency": 0.65,
        "bodySystem": "ophthalmological",
        "notes": "General color vision abnormalities"
      },
      {
        "symptomName": "Mild optic disc excavation",
        "frequency": 0.6,
        "bodySystem": "ophthalmological",
        "notes": "Optic nerve head cupping may be present"
      },
      {
        "symptomName": "Reduced contrast sensitivity",
        "frequency": 0.55,
        "bodySystem": "ophthalmological",
        "notes": "Difficulty distinguishing shades of gray"
      }
    ],
    "occasional": [
      {
        "symptomName": "Mild sensorineural hearing loss",
        "frequency": 0.3,
        "bodySystem": "otolaryngological",
        "notes": "Reported in some cases with syndromic forms"
      },
      {
        "symptomName": "Muscle weakness or fatigue",
        "frequency": 0.25,
        "bodySystem": "musculoskeletal",
        "notes": "Occasionally reported in syndromic variants"
      },
      {
        "symptomName": "Headache",
        "frequency": 0.2,
        "bodySystem": "neurological",
        "notes": "Non-specific symptom sometimes present"
      },
      {
        "symptomName": "Mild peripheral neuropathy",
        "frequency": 0.15,
        "bodySystem": "neurological",
        "notes": "Rarely observed in some patients"
      }
    ],
    "rare": [
      {
        "symptomName": "Ataxia",
        "frequency": 0.08,
        "bodySystem": "neurological",
        "notes": "Seen in rare syndromic forms"
      },
      {
        "symptomName": "Cardiomyopathy",
        "frequency": 0.05,
        "bodySystem": "cardiovascular",
        "notes": "Reported in rare mitochondrial syndromic presentations"
      },
      {
        "symptomName": "Optic disc swelling",
        "frequency": 0.03,
        "bodySystem": "ophthalmological",
        "notes": "Uncommon, may indicate alternative diagnosis"
      }
    ]
  },
  "systemsAffected": [
    "ophthalmological",
    "neurological",
    "otolaryngological",
    "musculoskeletal",
    "cardiovascular"
  ],
  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of other causes of optic neuropathy"
    ],
    "imaging": [
      "Optical coherence tomography (OCT) showing retinal nerve fiber layer thinning",
      "MRI brain and orbit typically normal or showing optic nerve atrophy"
    ],
    "genetic": [
      "Pathogenic variants in OPA1 gene detected by molecular genetic testing"
    ],
    "other": [
      "Visual field testing revealing central or cecocentral scotomas",
      "Color vision testing abnormalities"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "leber-hereditary-optic-neuropathy",
      "distinguishingFeatures": [
        "Acute or subacute onset of vision loss",
        "Mitochondrial inheritance pattern",
        "Predominantly affects young adult males"
      ]
    },
    {
      "diseaseId": "optic-neuritis",
      "distinguishingFeatures": [
        "Pain on eye movement",
        "Unilateral presentation",
        "Often associated with demyelinating disease"
      ]
    },
    {
      "diseaseId": "nutritional-optic-neuropathy",
      "distinguishingFeatures": [
        "History of malnutrition or vitamin deficiency",
        "Improvement with nutritional supplementation",
        "Bilateral but potentially reversible"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset unilateral vision loss",
    "Pain with eye movement",
    "Optic disc swelling or hemorrhage"
  ],
  "specialistType": [
