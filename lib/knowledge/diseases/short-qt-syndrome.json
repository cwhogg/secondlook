  "commonPitfalls": [
    "Often overlooked on ECG due to subtle QT shortening, especially if not measured precisely.",
    "Misattributed to electrolyte disturbances (e.g., hypercalcemia) rather than recognizing congenital etiology.",
    "Symptoms such as syncope or palpitations may be attributed to vasovagal or anxiety disorders.",
    "Family history of sudden cardiac death may not be elicited or linked to the arrhythmia."
  ],
  "extendedDiscriminators": [
    {
      "vsCondition": "Long QT Syndrome",
      "feature": "QT interval is abnormally short (QTc < 340 ms) in Short QT Syndrome, whereas it is prolonged in Long QT Syndrome."
    },
    {
      "vsCondition": "Brugada Syndrome",
      "feature": "Short QT Syndrome lacks the characteristic coved-type ST-segment elevation in V1-V3 seen in Brugada Syndrome; instead, it shows a persistently short QT interval."
    },
    {
      "vsCondition": "Hypercalcemia-induced short QT",
      "feature": "Short QT Syndrome is familial and persistent, whereas hypercalcemia-induced short QT resolves with correction of calcium levels."
    }
  ],
  "ruleOutCriteria": [
    "QTc interval consistently within normal or prolonged range on serial ECGs.",
    "Presence of reversible causes of short QT interval (e.g., hypercalcemia, hyperkalemia, acidosis) without persistent QT shortening after correction.",
    "No personal or family history of arrhythmia, syncope, or sudden cardiac death."
  ],
