    "laboratory": [
      "Elevated serum creatine kinase usually normal or mildly elevated",
      "Abnormal glycosylation profiles in serum transferrin analysis"
    ],
    "imaging": [
      "Muscle MRI may show selective muscle involvement",
      "Chest imaging may reveal atelectasis or aspiration pneumonia secondary to bulbar weakness"
    ],
    "genetic": [
      "ALG2 (causative)",
      "DPAGT1 (causative)",
      "GFPT1 (causative)",
      "ALG14 (causative)",
      "GMPPB (causative)",
      "Confirmed autosomal recessive inheritance pattern"
    ],
