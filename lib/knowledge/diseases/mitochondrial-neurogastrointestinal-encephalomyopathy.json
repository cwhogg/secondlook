  "diagnosticCriteria": {
    "formalCriteriaName": "MNGIE Diagnostic Criteria",
    "criteria": [
      {
        "id": "gastrointestinal-dysmotility",
        "description": "Progressive gastrointestinal dysmotility including chronic intestinal pseudo-obstruction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-symptoms",
        "description": "Peripheral neuropathy and leukoencephalopathy demonstrated by MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thymidine-phosphorylase-deficiency",
        "description": "Deficiency of thymidine phosphorylase enzyme activity or pathogenic mutations in TYMP gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cachexia",
        "description": "Severe weight loss and muscle wasting",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-plasma-thymidine",
        "description": "Elevated plasma thymidine and deoxyuridine levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive gastrointestinal dysmotility, neurological symptoms consistent with peripheral neuropathy or leukoencephalopathy, and confirmed TYMP gene mutation or thymidine phosphorylase deficiency",
    "notes": "Molecular genetic testing is essential for definitive diagnosis."
  },
