  "diagnosticCriteria": {
    "formalCriteriaName": "Hyperekplexia Diagnostic Criteria",
    "criteria": [
      {
        "id": "exaggerated-startle",
        "description": "Exaggerated startle response to unexpected stimuli",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "generalized-stiffness",
        "description": "Generalized muscle stiffness or rigidity, especially in the neonatal period",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glra1-mutation",
        "description": "Identification of pathogenic mutation in the GLRA1 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-neurological-degeneration",
        "description": "No evidence of progressive neurological degeneration",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-clonazepam",
        "description": "Improvement of symptoms with clonazepam treatment",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of exaggerated startle response and generalized stiffness, with or without GLRA1 mutation confirmation",
    "notes": "Genetic testing is recommended but not mandatory for diagnosis."
  },
