        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive cerebellar ataxia plus genetic confirmation of FAT2 mutation with exclusion of other causes",
    "notes": "Genetic testing is essential due to phenotypic overlap with other SCAs"
