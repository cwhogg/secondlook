  "keyFindings": {
    "laboratory": [
      "Positive Donath-Landsteiner test",
      "Hemoglobinuria on urinalysis",
      "Elevated lactate dehydrogenase (LDH)",
      "Low serum haptoglobin",
      "Elevated indirect bilirubin",
      "Reticulocytosis",
      "Anemia with evidence of intravascular hemolysis"
    ],
    "imaging": [
      "Splenomegaly on abdominal ultrasound (occasionally)"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Cold exposure triggers hemolytic episodes",
      "Biphasic hemolysin antibody (IgG) binding at cold temperatures and causing complement activation at body temperature"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cold-agglutinin-disease",
      "distinguishingFeatures": [
        "Presence of cold agglutinins (IgM antibodies)",
        "Agglutination of red cells at cold temperatures",
        "Direct antiglobulin test positive for C3 only",
        "Usually chronic course"
      ]
    },
    {
      "diseaseId": "paroxysmal-nocturnal-hemoglobinuria",
      "distinguishingFeatures": [
        "Complement-mediated hemolysis without cold trigger",
        "Flow cytometry showing absence of CD55 and CD59 on red cells",
        "Chronic hemolysis with thrombosis risk"
      ]
    }
  ],
  "redFlags": [
    "Severe anemia with hemodynamic instability",
    "Acute renal failure secondary to hemoglobinuria",
    "Rapidly progressive hemolysis following cold exposure"
  ],
