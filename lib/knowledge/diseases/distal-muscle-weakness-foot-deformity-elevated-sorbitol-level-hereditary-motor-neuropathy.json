        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiological-findings",
        "description": "Nerve conduction studies showing motor neuropathy with reduced motor nerve conduction velocities and normal sensory conduction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with hereditary motor neuropathy and sorbitol metabolism",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical presentation, elevated sorbitol levels, and electrophysiological findings) must be met for diagnosis.",
    "notes": "Genetic testing and family history support diagnosis but are not mandatory."
  },
