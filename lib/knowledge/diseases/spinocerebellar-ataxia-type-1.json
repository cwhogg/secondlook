  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Spinocerebellar Ataxia",
    "criteria": [
      {
        "id": "progressive-ataxia",
        "description": "Progressive cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cag-repeat-expansion",
        "description": "Presence of expanded CAG trinucleotide repeat in ATXN1 gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "brain-imaging",
        "description": "MRI showing cerebellar and brainstem atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive cerebellar ataxia plus confirmed pathogenic CAG repeat expansion in ATXN1 gene",
    "notes": "Genetic testing is definitive; clinical features and family history support diagnosis."
  },
