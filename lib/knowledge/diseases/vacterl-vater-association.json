  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for VACTERL association",
    "criteria": [
      {
        "id": "vertebral-anomalies",
        "description": "Presence of vertebral anomalies such as hemivertebrae or vertebral fusion",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "anal-atresia",
        "description": "Imperforate anus or anal atresia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-defects",
        "description": "Congenital heart defects including ventricular septal defect or tetralogy of Fallot",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tracheoesophageal-fistula",
        "description": "Tracheoesophageal fistula or esophageal atresia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-anomalies",
        "description": "Renal structural anomalies such as renal agenesis or dysplasia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "limb-defects",
        "description": "Radial ray anomalies or other limb malformations",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least three of the following congenital malformations: vertebral anomalies, anal atresia, cardiac defects, tracheoesophageal fistula, renal anomalies, and limb defects",
    "notes": "Diagnosis is clinical; no definitive genetic test exists. Exclusion of other syndromes with overlapping features is important."
  },
