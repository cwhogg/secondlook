  "diagnosticCriteria": {
    "formalCriteriaName": "CCHS Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypoventilation-during-sleep",
        "description": "Hypoventilation with inadequate ventilatory response to hypercapnia and hypoxia during sleep",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "phox2b-mutation",
        "description": "Presence of pathogenic PHOX2B gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-primary-pulmonary-disease",
        "description": "Exclusion of primary pulmonary, cardiac, or neuromuscular causes of hypoventilation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autonomic-dysfunction",
        "description": "Evidence of autonomic nervous system dysfunction (e.g., impaired pupillary response, abnormal heart rate variability)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypoventilation during sleep with confirmed PHOX2B mutation and exclusion of other causes",
    "notes": "Genetic testing for PHOX2B mutations is critical for confirmation"
  },
