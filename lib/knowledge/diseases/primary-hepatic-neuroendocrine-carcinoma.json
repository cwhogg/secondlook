  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological and Immunohistochemical Diagnostic Criteria for Primary Hepatic Neuroendocrine Carcinoma",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histological confirmation of neuroendocrine carcinoma morphology in liver tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Positive immunohistochemical staining for neuroendocrine markers (chromogranin A, synaptophysin, CD56)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-metastasis",
        "description": "Exclusion of extrahepatic primary neuroendocrine tumor by comprehensive imaging and clinical evaluation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-characteristics",
        "description": "Radiological evidence of a solitary or dominant hepatic mass with neuroendocrine features on CT/MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "serum-markers",
        "description": "Elevated serum neuroendocrine markers such as neuron-specific enolase (NSE) or chromogranin A",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation with positive immunohistochemical neuroendocrine markers and exclusion of extrahepatic primary tumor",
    "notes": "Diagnosis requires thorough exclusion of metastatic neuroendocrine carcinoma from other primary sites."
  },
