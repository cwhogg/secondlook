  "keyFindings": {
    "laboratory": [
      "Elevated blood glucose or HbA1c in diabetic patients",
      "Hypercoagulability panel abnormalities (e.g., antiphospholipid antibodies, protein C/S deficiency)"
    ],
    "imaging": [
      "Fundus photography showing retinal hemorrhages and venous dilation",
      "Fluorescein angiography demonstrating delayed venous filling and capillary nonperfusion",
      "Optical coherence tomography (OCT) showing macular edema"
    ],
