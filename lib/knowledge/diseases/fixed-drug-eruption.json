  "diagnosticCriteria": {
    "formalCriteriaName": "Fixed Drug Eruption Diagnostic Criteria",
    "criteria": [
      {
        "id": "recurrent-lesions",
        "description": "Recurrent well-demarcated erythematous or violaceous patches or plaques at the same anatomical site upon re-exposure to the offending drug",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "drug-exposure",
        "description": "History of exposure to a known causative drug preceding lesion onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "residual-hyperpigmentation",
        "description": "Residual post-inflammatory hyperpigmentation at lesion sites after resolution",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing vacuolar interface dermatitis with necrotic keratinocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent lesions at identical sites with temporal relationship to drug exposure",
    "notes": "Patch testing or drug provocation tests may aid in identifying the causative agent."
  },
