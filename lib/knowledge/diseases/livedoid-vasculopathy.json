  "diagnosticCriteria": {
    "criteria": [
      {
        "id": "lv-maj1",
        "description": "Recurrent, painful, punched-out ulcers on the lower extremities (ankles, feet)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lv-maj2",
        "description": "Healing with ivory-white stellate scars (atrophie blanche)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lv-maj3",
        "description": "Skin biopsy showing hyalinization and thrombosis of dermal vessels without primary vasculitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lv-min1",
        "description": "Livedo reticularis surrounding ulcers",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "lv-min2",
        "description": "Evidence of hypercoagulable state (thrombophilia markers positive)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Recurrent painful lower extremity ulcers healing with atrophie blanche plus histopathological evidence of thrombotic vasculopathy (fibrin thrombi in dermal vessels, hyalinization of vessel walls) without significant perivascular inflammatory infiltrate.",
    "notes": "Livedoid vasculopathy is a thrombotic vasculopathy, NOT a vasculitis despite the historical name. It is a disorder of cutaneous microvascular thrombosis."
  },
