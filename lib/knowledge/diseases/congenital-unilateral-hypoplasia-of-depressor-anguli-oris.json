  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Ultrasound or MRI may show hypoplasia or absence of depressor anguli oris muscle",
      "Echocardiography to evaluate for associated cardiac anomalies"
    ],
    "genetic": [
      "No consistent genetic mutation identified; some cases associated with 22q11.2 deletion syndrome",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography may show reduced activity of depressor anguli oris muscle",
      "Clinical examination remains primary diagnostic tool"
    ]
