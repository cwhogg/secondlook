  "diagnosticCriteria": {
    "formalCriteriaName": "Juvenile Hemochromatosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in HJV or HAMP genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-serum-iron",
        "description": "Markedly elevated serum ferritin and transferrin saturation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-manifestations",
        "description": "Presence of early-onset iron overload symptoms such as cardiomyopathy or hypogonadism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-biopsy",
        "description": "Liver biopsy showing iron deposition (optional if genetic testing positive)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic HJV or HAMP mutation plus elevated serum iron indices and clinical manifestations of iron overload",
    "notes": "Genetic testing is critical for definitive diagnosis; liver biopsy may be supportive."
  },
