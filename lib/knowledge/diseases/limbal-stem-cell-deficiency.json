  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Impression Cytology Diagnostic Criteria for Limbal Stem Cell Deficiency",
    "criteria": [
      {
        "id": "clinical-signs",
        "description": "Presence of conjunctivalization of the corneal surface with loss of limbal palisades of Vogt",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impression-cytology",
        "description": "Detection of conjunctival epithelial cells on the corneal surface by impression cytology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "corneal-vascularization",
        "description": "Superficial corneal neovascularization extending from the limbus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fluorescein-staining",
        "description": "Persistent corneal epithelial defects or irregular fluorescein staining patterns",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "symptom-history",
        "description": "History of ocular surface inflammation, chemical injury, or chronic contact lens wear",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "At least two major criteria including clinical signs and impression cytology findings",
    "notes": "Diagnosis is primarily clinical supported by impression cytology; imaging modalities such as in vivo confocal microscopy may assist."
  },
