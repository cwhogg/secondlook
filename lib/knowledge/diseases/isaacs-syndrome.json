  "diagnosticCriteria": {
    "formalCriteriaName": "Isaacs Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of continuous muscle fiber activity including stiffness, cramps, and myokymia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyography (EMG) showing spontaneous, continuous motor unit activity such as neuromyotonic discharges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoantibodies",
        "description": "Detection of antibodies against voltage-gated potassium channels (VGKC) or associated proteins",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-neuromuscular",
        "description": "Exclusion of other neuromuscular disorders such as motor neuron disease or myotonia congenita",
        "category": "minor",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus EMG findings; supportive antibody testing enhances diagnostic confidence",
    "notes": "Diagnosis is clinical supported by electrophysiological and immunological studies"
  },
