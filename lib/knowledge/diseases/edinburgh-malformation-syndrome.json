  "diagnosticCriteria": {
    "formalCriteriaName": "Edinburgh Malformation Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial malformations including micrognathia and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Congenital limb anomalies such as syndactyly or clinodactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "central-nervous-system-anomalies",
        "description": "Evidence of brain malformations on imaging such as agenesis of corpus callosum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-defects",
        "description": "Presence of congenital heart defects such as ventricular septal defect",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (craniofacial dysmorphism, limb malformations, and CNS anomalies) is required for diagnosis",
    "notes": "Genetic testing may support diagnosis but is not definitive due to limited data"
  },
