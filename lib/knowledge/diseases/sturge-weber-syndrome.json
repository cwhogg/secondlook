      "Port-wine stain biopsy showing capillary malformations"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "klippel-trenaunay-syndrome",
      "distinguishingFeatures": [
        "Presence of limb overgrowth and varicosities",
        "Port-wine stain typically on limbs rather than face",
        "Absence of leptomeningeal angiomas"
      ]
    },
    {
      "diseaseId": "nevus-flammeus",
      "distinguishingFeatures": [
        "Isolated port-wine stain without neurological or ocular involvement",
        "No leptomeningeal vascular malformations"
      ]
    },
    {
      "diseaseId": "phakomatosis-pigmentovascularis",
      "distinguishingFeatures": [
        "Combination of pigmentary and vascular skin lesions",
        "Different genetic and clinical features"
      ]
    }
  ],
