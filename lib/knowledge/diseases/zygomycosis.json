  "keyFindings": {
    "laboratory": [
      "Histopathology showing broad, ribbon-like aseptate hyphae with right-angle branching",
      "Positive fungal culture for Mucorales species",
      "Elevated inflammatory markers (CRP, ESR)"
    ],
    "imaging": [
      "CT or MRI showing sinus opacification with bone destruction",
      "Pulmonary nodules or cavitary lesions on chest imaging",
      "Orbital involvement with soft tissue swelling and proptosis"
    ],
    "genetic": [],
    "other": [
      "Angioinvasion leading to tissue infarction and necrosis",
      "Rapid progression despite antibiotic therapy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "aspergillosis",
      "distinguishingFeatures": [
        "Septate hyphae with acute angle branching on histology",
        "More common in neutropenic patients",
        "Less frequent black necrotic eschars"
      ]
    },
    {
      "diseaseId": "bacterial-facial-cellulitis",
      "distinguishingFeatures": [
        "Responds to antibiotics",
        "Lacks fungal hyphae on biopsy",
        "Absence of tissue infarction and angioinvasion"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive necrotic facial or nasal lesions",
    "Black eschar formation in nasal or oral mucosa",
    "Neurological deficits indicating cerebral involvement"
  ],
  "specialistType": [
    "Infectious Disease Specialist",
