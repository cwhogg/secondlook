  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Thyroid Tumors",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of undifferentiated malignant cells with spindle, giant, or squamoid morphology on histopathological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rapid-tumor-growth",
        "description": "Rapidly enlarging thyroid mass with local invasion or distant metastases",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Negative or absent expression of thyroid differentiation markers such as thyroglobulin and TTF-1",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiologic-features",
        "description": "Imaging showing large, infiltrative thyroid mass with invasion of adjacent structures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of undifferentiated malignant thyroid cells with clinical evidence of rapidly progressive thyroid mass",
    "notes": "Molecular testing may support diagnosis but is not mandatory."
  },
