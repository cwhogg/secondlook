        "requiredForDiagnosis": true
      },
      {
        "id": "lysosomal-enzyme-assay",
        "description": "Normal lysosomal enzyme activities in plasma with intracellular accumulation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic ophthalmologic and neurologic findings plus confirmation by MCOLN1 gene mutation analysis",
    "notes": "Diagnosis is confirmed by molecular genetic testing; enzyme assays may be supportive but are not diagnostic."
