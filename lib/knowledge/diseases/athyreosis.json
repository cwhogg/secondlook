  "diagnosticCriteria": {
    "formalCriteriaName": "Congenital Hypothyroidism Diagnostic Criteria",
    "criteria": [
      {
        "id": "absent-thyroid-tissue",
        "description": "Absence of thyroid gland on thyroid scintigraphy or ultrasound",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-thyrotropin",
        "description": "Elevated serum thyroid-stimulating hormone (TSH) levels at neonatal screening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-thyroid-hormones",
        "description": "Low serum free thyroxine (T4) and triiodothyronine (T3) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Clinical signs of hypothyroidism such as prolonged jaundice, feeding difficulties, and hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of absent thyroid tissue on imaging combined with elevated TSH and low thyroid hormone levels",
    "notes": "Diagnosis is typically confirmed by neonatal screening and imaging studies."
  },
