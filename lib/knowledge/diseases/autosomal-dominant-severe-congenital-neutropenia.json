  "diagnosticCriteria": {
    "formalCriteriaName": "Severe Congenital Neutropenia Diagnostic Criteria",
    "criteria": [
      {
        "id": "persistent-neutropenia",
        "description": "Absolute neutrophil count (ANC) consistently below 0.5 x 10^9/L",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset-infection",
        "description": "Recurrent severe bacterial infections presenting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation-elane",
        "description": "Presence of heterozygous pathogenic mutation in ELANE gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-maturation-arrest",
        "description": "Bone marrow examination showing maturation arrest at promyelocyte/myelocyte stage",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent severe neutropenia with recurrent infections and confirmed ELANE gene mutation",
    "notes": "Diagnosis requires exclusion of secondary causes of neutropenia."
