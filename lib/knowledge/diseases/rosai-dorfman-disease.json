  "diagnosticCriteria": {
    "formalCriteriaName": "Rosai-Dorfman Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "massive-lymphadenopathy",
        "description": "Painless, massive cervical lymphadenopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "emperipolesis",
        "description": "Histopathologic evidence of emperipolesis (lymphocytes within histiocytes)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "s100-positive-histiocytes",
        "description": "Immunohistochemical staining positive for S100 protein in histiocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "extranodal-involvement",
        "description": "Presence of extranodal disease in skin, respiratory tract, or other organs",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of massive lymphadenopathy with histopathologic confirmation of emperipolesis and S100-positive histiocytes",
    "notes": "Diagnosis requires lymph node biopsy with characteristic histopathology and immunohistochemistry."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Massive painless cervical lymphadenopathy",
        "frequency": 0.95,
        "bodySystem": "immunological",
        "notes": "Typically bilateral and massive enlargement of cervical lymph nodes"
      },
      {
        "symptomName": "Emperipolesis observed in histiocytes",
        "frequency": 0.9,
        "bodySystem": "hematological",
        "notes": "Characteristic histopathological finding"
      },
      {
        "symptomName": "S100 protein positive histiocytes",
        "frequency": 0.85,
        "bodySystem": "hematological",
        "notes": "Immunohistochemical hallmark"
      }
    ],
    "common": [
      {
        "symptomName": "Fever",
        "frequency": 0.7,
        "bodySystem": "constitutional",
        "notes": "Intermittent low-grade fever is common"
      },
      {
        "symptomName": "Weight loss",
        "frequency": 0.65,
        "bodySystem": "constitutional",
        "notes": "Unintentional weight loss may occur"
      },
      {
        "symptomName": "Night sweats",
        "frequency": 0.6,
        "bodySystem": "constitutional",
        "notes": "Common systemic symptom"
      },
      {
        "symptomName": "Extranodal involvement (skin lesions)",
        "frequency": 0.55,
        "bodySystem": "dermatological",
        "notes": "Skin nodules or plaques may be present"
      },
      {
        "symptomName": "Extranodal involvement (nasal obstruction or sinusitis)",
        "frequency": 0.5,
        "bodySystem": "otolaryngological",
        "notes": "Nasal cavity or sinus involvement causing obstruction"
      }
    ],
    "occasional": [
      {
        "symptomName": "Hepatosplenomegaly",
        "frequency": 0.4,
        "bodySystem": "hematological",
        "notes": "Enlargement of liver and spleen may be observed"
      },
      {
        "symptomName": "Lymphadenopathy in axillary or inguinal regions",
        "frequency": 0.35,
        "bodySystem": "immunological",
        "notes": "Less commonly involved lymph node groups"
      },
      {
        "symptomName": "Anemia",
        "frequency": 0.3,
        "bodySystem": "hematological",
        "notes": "Mild anemia may be present"
      },
      {
        "symptomName": "Arthralgia",
        "frequency": 0.25,
        "bodySystem": "musculoskeletal",
        "notes": "Joint pain without inflammation"
      },
      {
        "symptomName": "Lymphocytosis",
        "frequency": 0.2,
        "bodySystem": "hematological",
        "notes": "Elevated lymphocyte count occasionally seen"
      }
    ],
    "rare": [
      {
        "symptomName": "Central nervous system involvement",
        "frequency": 0.08,
        "bodySystem": "neurological",
        "notes": "Rarely, CNS lesions or symptoms occur"
      },
      {
        "symptomName": "Renal involvement",
        "frequency": 0.05,
        "bodySystem": "renal",
        "notes": "Rare kidney infiltration or dysfunction"
      },
      {
        "symptomName": "Cardiac involvement",
        "frequency": 0.03,
        "bodySystem": "cardiovascular",
        "notes": "Very rare cardiac infiltration"
      }
    ]
  },
