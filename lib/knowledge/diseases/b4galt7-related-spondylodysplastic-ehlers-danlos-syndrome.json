  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed diagnostic criteria for spondylodysplastic EDS",
    "criteria": [
      {
        "id": "connective-tissue-fragility",
        "description": "Skin hyperextensibility and fragility with easy bruising",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-dysmorphism",
        "description": "Short stature with skeletal dysplasia including platyspondyly and metaphyseal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-hypermobility",
        "description": "Generalized joint hypermobility with recurrent dislocations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "molecular-confirmation",
        "description": "Biallelic pathogenic variants in B4GALT7 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-features",
        "description": "Characteristic craniofacial features including large fontanelles and frontal bossing",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all major clinical criteria plus molecular confirmation of biallelic B4GALT7 pathogenic variants",
    "notes": "Diagnosis relies heavily on genetic testing due to phenotypic overlap with other EDS subtypes and skeletal dysplasias."
  },
