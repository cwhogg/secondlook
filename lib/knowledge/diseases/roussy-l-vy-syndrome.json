  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Elevated cerebrospinal fluid protein without pleocytosis (albuminocytologic dissociation) in some cases"
    ],
    "imaging": [
      "MRI usually normal; may show muscle atrophy in advanced cases"
    ],
    "genetic": [
      "PMP22 (causative)",
      "MPZ (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Nerve conduction studies showing slowed conduction velocities consistent with demyelinating neuropathy",
      "Muscle biopsy showing neurogenic atrophy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "charcot-marie-tooth-disease-type-1a",
      "distinguishingFeatures": [
        "More common PMP22 duplication",
        "Similar demyelinating neuropathy but usually without pes cavus as early sign"
      ]
    },
    {
      "diseaseId": "hereditary-neuropathy-with-liability-to-pressure-palsies",
      "distinguishingFeatures": [
        "Recurrent focal neuropathies triggered by pressure",
        "Usually painless and transient episodes"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive weakness suggesting acquired neuropathy",
    "Respiratory insufficiency or failure",
    "Severe cardiac arrhythmias"
  ],
