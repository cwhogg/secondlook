  "diagnosticCriteria": {
    "formalCriteriaName": "Echocardiographic Diagnostic Criteria for Ostium Primum ASD",
    "criteria": [
      {
        "id": "defect-location",
        "description": "Presence of an atrial septal defect located at the lower portion of the atrial septum adjacent to the atrioventricular valves",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "atrioventricular-valve-abnormality",
        "description": "Associated cleft or malformation of the mitral and/or tricuspid valves",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "left-to-right-shunt",
        "description": "Evidence of left-to-right shunting across the atrial septal defect on Doppler echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Symptoms such as exertional dyspnea or recurrent respiratory infections in infancy or childhood",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Identification of an atrial septal defect at the ostium primum location with associated atrioventricular valve abnormalities and demonstration of left-to-right shunting on echocardiography",
    "notes": "Cardiac catheterization may be used for further hemodynamic assessment if echocardiographic findings are inconclusive."
  },
