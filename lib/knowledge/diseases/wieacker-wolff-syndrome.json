  "diagnosticCriteria": {
    "formalCriteriaName": "Wieacker-Wolff syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "arthrogryposis-multiplex-congenita",
        "description": "Presence of congenital joint contractures affecting multiple joints (arthrogryposis multiplex congenita)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Severe intellectual disability with developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including micrognathia and ptosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "motor-neuronopathy",
        "description": "Evidence of motor neuron involvement with muscle weakness and atrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the ZC4H2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of arthrogryposis multiplex congenita, intellectual disability, motor neuronopathy, and pathogenic ZC4H2 mutation",
    "notes": "Diagnosis is confirmed by genetic testing; clinical features may vary in severity."
  },
