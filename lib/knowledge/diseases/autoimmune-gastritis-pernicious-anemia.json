  "diagnosticCriteria": {
    "formalCriteriaName": "Autoimmune Gastritis Diagnostic Criteria",
    "criteria": [
      {
        "id": "anti-parietal-cell-antibodies",
        "description": "Presence of anti-parietal cell antibodies in serum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gastric-mucosal-atrophy",
        "description": "Histological evidence of gastric mucosal atrophy predominantly in the corpus and fundus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vitamin-b12-deficiency",
        "description": "Laboratory confirmed vitamin B12 deficiency with elevated methylmalonic acid and homocysteine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intrinsic-factor-antibodies",
        "description": "Presence of intrinsic factor antibodies in serum",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "megaloblastic-anemia",
        "description": "Peripheral blood smear showing megaloblastic anemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of gastric mucosal atrophy on biopsy plus either anti-parietal cell antibodies or vitamin B12 deficiency",
    "notes": "Intrinsic factor antibody testing increases specificity but is not always positive."
  },
