  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Kjellin Syndrome",
    "criteria": [
      {
        "id": "molar-tooth-sign",
        "description": "Presence of the molar tooth sign on brain MRI indicating cerebellar vermis hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "retinal-dystrophy",
        "description": "Progressive retinal dystrophy leading to vision impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nephronophthisis",
        "description": "Renal involvement characterized by nephronophthisis and chronic kidney disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay and hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ataxia",
        "description": "Cerebellar ataxia manifesting as impaired coordination",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of the molar tooth sign on MRI plus retinal dystrophy and nephronophthisis",
    "notes": "Diagnosis is supported by genetic testing identifying mutations in genes associated with Joubert syndrome spectrum disorders."
  },
