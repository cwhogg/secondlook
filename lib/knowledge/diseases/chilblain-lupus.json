  "differentialDiagnoses": [
    {
      "diseaseId": "chilblains-pernio",
      "distinguishingFeatures": [
        "Absence of interface dermatitis on biopsy",
        "No positive ANA or lupus serology",
        "Lesions resolve completely with warming"
      ]
    },
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "Presence of systemic symptoms (e.g. arthritis, nephritis)",
        "More widespread serological abnormalities",
        "Multisystem involvement"
      ]
    },
    {
      "diseaseId": "livedoid-vasculopathy",
      "distinguishingFeatures": [
        "Painful ulcerations with livedo racemosa",
        "Thrombotic vasculopathy on biopsy",
        "Lack of lupus-specific serology"
      ]
    }
  ],
  "redFlags": [
    "Development of digital gangrene or necrosis",
    "Signs of systemic lupus erythematosus (e.g. renal impairment, arthritis)",
    "Rapid progression of skin ulcerations despite treatment"
