  "differentialDiagnoses": [
    {
      "diseaseId": "pemphigus-vulgaris",
      "distinguishingFeatures": [
        "Presence of circulating anti-desmoglein antibodies",
        "More widespread mucosal involvement",
        "Positive direct immunofluorescence with intercellular IgG and C3"
      ]
    },
    {
      "diseaseId": "grover-disease",
      "distinguishingFeatures": [
        "Transient papulovesicular eruption usually in older men",
        "Histology shows focal acantholysis without familial pattern",
        "No ATP2C1 mutation"
      ]
    }
  ],
  "redFlags": [
    "Rapidly spreading blistering beyond typical intertriginous areas",
    "Signs of systemic infection or sepsis from secondary bacterial infection",
    "Severe pain or functional impairment due to extensive erosions"
  ],
