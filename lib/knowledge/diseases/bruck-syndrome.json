  "keyFindings": {
    "laboratory": [
      "Normal serum calcium and phosphate levels",
      "Normal alkaline phosphatase"
    ],
    "imaging": [
      "Multiple fractures with callus formation on X-ray",
      "Bone deformities including bowing and osteopenia",
      "Contractures visible on joint imaging"
    ],
    "genetic": [
      "PLOD2 (causative, loss-of-function)",
      "FKBP10 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histological evidence of abnormal collagen cross-linking",
      "Reduced lysyl hydroxylase activity in fibroblasts"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "osteogenesis-imperfecta",
      "distinguishingFeatures": [
