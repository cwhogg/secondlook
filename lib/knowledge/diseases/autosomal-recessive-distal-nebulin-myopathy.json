  "diagnosticCriteria": {
    "formalCriteriaName": "Nebulin Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive distal muscle weakness predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing nemaline rods and fiber size variability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Biallelic pathogenic variants in the NEB gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Myopathic changes on electromyography",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "serum-creatine-kinase",
        "description": "Normal or mildly elevated serum creatine kinase levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal muscle weakness with muscle biopsy demonstrating nemaline rods and confirmation of biallelic NEB gene mutations",
    "notes": "Diagnosis requires integration of clinical, histopathological, and genetic findings."
  },
