  "diagnosticCriteria": {
    "formalCriteriaName": "Juvenile Hyaline Fibromatosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "cutaneous-nodules",
        "description": "Presence of multiple subcutaneous nodules or tumors typically on scalp, ears, and back",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-contractures",
        "description": "Progressive painful joint contractures leading to restricted mobility",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gingival-hypertrophy",
        "description": "Severe gingival hypertrophy causing oral functional impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological confirmation showing hyaline material deposition in dermis and connective tissue",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the ANTXR2 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical features (cutaneous nodules, joint contractures, gingival hypertrophy) supported by histopathology or genetic confirmation",
    "notes": "Diagnosis is clinical but supported by histopathology and genetic testing when available."
  },
