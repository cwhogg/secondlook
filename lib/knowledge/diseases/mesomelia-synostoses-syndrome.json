  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Mesomelia-synostoses syndrome",
    "criteria": [
      {
        "id": "mesomelia",
        "description": "Presence of mesomelic shortening of the limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "synostoses",
        "description": "Radiological evidence of multiple synostoses involving forearm and lower leg bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of mesomelic limb shortening and radiological confirmation of multiple synostoses",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
