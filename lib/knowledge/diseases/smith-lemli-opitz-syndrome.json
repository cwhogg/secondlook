  "diagnosticCriteria": {
    "formalCriteriaName": "Smith-Lemli-Opitz Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cholesterol-deficiency",
        "description": "Biochemical evidence of low plasma cholesterol and elevated 7-dehydrocholesterol",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Presence of intellectual disability ranging from mild to severe",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-anomalies",
        "description": "Multiple congenital anomalies including microcephaly, syndactyly of toes 2-3, and facial dysmorphism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the DHCR7 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-features",
        "description": "Presence of autistic behaviors or behavioral disturbances",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biochemical abnormalities (low cholesterol and elevated 7-dehydrocholesterol) plus at least two major clinical features or identification of pathogenic DHCR7 variants",
    "notes": "Genetic testing is confirmatory but diagnosis can be made based on clinical and biochemical findings."
  },
