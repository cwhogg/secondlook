  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific biochemical markers"
    ],
    "imaging": [
      "Brain MRI showing cortical dysgyria with abnormal gyral pattern, possible corpus callosum hypoplasia, and variable cerebellar involvement"
    ],
    "genetic": [
      "TUBA1A (causative)",
      "TUBB2B (causative)",
      "TUBB3 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electroencephalogram (EEG) abnormalities consistent with epilepsy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "lissencephaly",
      "distinguishingFeatures": [
        "Smooth brain surface without normal gyral pattern",
        "Different genetic mutations (e.g., LIS1, DCX)",
        "More severe microcephaly and profound developmental delay"
      ]
    },
    {
      "diseaseId": "polymicrogyria",
      "distinguishingFeatures": [
        "Excessive small gyri rather than abnormal gyral pattern",
        "Often focal or multifocal distribution",
        "Different genetic and environmental causes"
      ]
    }
  ],
