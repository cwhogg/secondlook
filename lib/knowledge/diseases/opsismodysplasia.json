  "diagnosticCriteria": {
    "formalCriteriaName": "Opsismodysplasia diagnostic criteria",
    "criteria": [
      {
        "id": "delayed-ossification",
        "description": "Marked delay in bone ossification with characteristic radiographic findings",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "micromelia",
        "description": "Severe micromelia with short limbs disproportionate to trunk size",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features including prominent forehead, depressed nasal bridge, and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "metaphyseal-irregularities",
        "description": "Irregular metaphyseal borders and flared metaphyses on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "respiratory-compromise",
        "description": "Respiratory difficulties due to thoracic hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of major criteria including delayed ossification, micromelia, and metaphyseal irregularities on imaging",
    "notes": "Genetic testing for mutations in INPPL1 gene may support diagnosis"
  },
