    "L90.0"
  ],
  "omimId": "147480",
  "orphanetId": "101",
  "prevalence": {
    "estimate": "1 in 300 to 1 in 1000",
    "range": "0.1%-0.3%",
    "classification": "uncommon"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 80,
      "peak": 50
    },
    "sexPredilection": "slight-female",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "No universally accepted formal criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of white, atrophic plaques primarily in genital and perianal areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing epidermal thinning, homogenization of collagen in upper dermis, and band-like lymphocytic infiltrate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "symptom-chronicity",
        "description": "Chronic symptoms such as pruritus and pain persisting for months to years",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical presentation with characteristic lesions plus confirmatory histopathology",
    "notes": "Diagnosis is primarily clinical supported by biopsy; no standardized diagnostic scoring system exists."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "White atrophic plaques in genital and perianal skin",
        "frequency": 0.95,
        "bodySystem": "dermatological",
        "notes": "Classic porcelain-white, shiny plaques with wrinkled surface"
      },
      {
        "symptomName": "Sclerosis and skin thinning",
        "frequency": 0.85,
        "bodySystem": "dermatological",
        "notes": "Leads to fragility and easy tearing"
      }
    ],
    "common": [
      {
        "symptomName": "Pruritus of affected areas",
        "frequency": 0.75,
        "bodySystem": "dermatological",
        "notes": "Often severe and persistent"
      },
      {
        "symptomName": "Pain or burning sensation",
        "frequency": 0.65,
        "bodySystem": "dermatological",
        "notes": "Especially during urination or sexual activity"
      },
      {
        "symptomName": "Dyspareunia",
        "frequency": 0.6,
        "bodySystem": "reproductive",
        "notes": "Painful intercourse due to scarring"
      },
      {
        "symptomName": "Skin fissures and erosions",
        "frequency": 0.55,
        "bodySystem": "dermatological",
        "notes": "Due to skin fragility"
      }
    ],
    "occasional": [
      {
        "symptomName": "Urinary symptoms (dysuria, urinary retention)",
        "frequency": 0.3,
        "bodySystem": "reproductive",
        "notes": "Due to urethral involvement"
      },
      {
        "symptomName": "Vaginal or urethral stenosis",
        "frequency": 0.25,
        "bodySystem": "reproductive",
        "notes": "Secondary to scarring"
      },
      {
        "symptomName": "Pigmentary changes (hypo- or hyperpigmentation)",
        "frequency": 0.2,
        "bodySystem": "dermatological",
        "notes": "May occur in chronic lesions"
      },
      {
        "symptomName": "Secondary infection",
        "frequency": 0.15,
        "bodySystem": "dermatological",
        "notes": "Due to skin breakdown"
      }
    ],
    "rare": [
      {
        "symptomName": "Malignant transformation to squamous cell carcinoma",
        "frequency": 0.05,
        "bodySystem": "dermatological",
        "notes": "Occurs in longstanding untreated cases"
      },
      {
        "symptomName": "Phimosis in males",
        "frequency": 0.07,
        "bodySystem": "reproductive",
        "notes": "Due to scarring of foreskin"
      },
      {
        "symptomName": "Lymphadenopathy",
        "frequency": 0.03,
        "bodySystem": "immunological",
        "notes": "Reactive, uncommon"
      }
    ]
  },
  "systemsAffected": [
    "dermatological",
    "reproductive",
    "immunological",
    "constitutional"
  ],
  "keyFindings": {
    "laboratory": [
      "No specific blood test; autoimmune markers may be positive in some cases",
      "Elevated inflammatory markers are uncommon"
    ],
    "imaging": [
      "Not routinely used; ultrasound may show urethral strictures if involved"
    ],
    "genetic": [
      "No definitive genetic markers identified; possible HLA associations"
    ],
    "other": [
      "Histopathology is diagnostic with characteristic epidermal and dermal changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "lichen-planus",
      "distinguishingFeatures": [
        "Violaceous papules and plaques",
        "Wickham striae",
        "More mucosal involvement"
      ]
    },
    {
      "diseaseId": "vitiligo",
      "distinguishingFeatures": [
        "Depigmented macules without atrophy or sclerosis",
        "No pruritus or pain"
      ]
    },
    {
      "diseaseId": "morphea",
      "distinguishingFeatures": [
        "Localized sclerotic plaques without epidermal atrophy",
        "Usually not limited to genital area"
      ]
    }
  ],
  "redFlags": [
    "Rapidly enlarging or ulcerated lesion suggesting malignancy",
    "Severe urinary retention or obstruction",
    "Persistent severe pain unresponsive to treatment"
  ],
