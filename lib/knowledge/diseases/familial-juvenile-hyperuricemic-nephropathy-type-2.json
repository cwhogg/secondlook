  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Familial Juvenile Hyperuricemic Nephropathy",
    "criteria": [
      {
        "id": "hyperuricemia",
        "description": "Persistent hyperuricemia with elevated serum uric acid levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant family history of hyperuricemia and progressive kidney disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "umod-mutation",
        "description": "Identification of pathogenic UMOD gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tubulointerstitial-nephritis",
        "description": "Evidence of tubulointerstitial nephritis on renal biopsy or imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "gout-attacks",
        "description": "Recurrent gouty arthritis episodes typically in adolescence or early adulthood",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hyperuricemia, positive family history consistent with autosomal dominant inheritance, and detection of a pathogenic UMOD mutation",
    "notes": "Renal biopsy is not mandatory but may support diagnosis; genetic testing is confirmatory."
  },
