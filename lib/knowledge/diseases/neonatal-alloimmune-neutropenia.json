  "diagnosticCriteria": {
    "formalCriteriaName": "Neonatal Alloimmune Neutropenia Diagnostic Criteria",
    "criteria": [
      {
        "id": "neutropenia",
        "description": "Absolute neutrophil count (ANC) less than 1500/µL in the neonate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "maternal-alloantibodies",
        "description": "Detection of maternal anti-neutrophil antibodies reactive against neonatal neutrophils",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-infections",
        "description": "Exclusion of congenital infections or other causes of neonatal neutropenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-infections",
        "description": "Presence of bacterial or fungal infections in the neonate",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "maternal-history",
        "description": "History of maternal sensitization or previous affected pregnancies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of neonatal neutropenia with detection of maternal anti-neutrophil antibodies and exclusion of other causes",
    "notes": "Diagnosis relies heavily on laboratory confirmation of maternal antibodies and clinical exclusion of other etiologies."
  },
