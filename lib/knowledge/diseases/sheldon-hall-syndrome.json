  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Sheldon-Hall syndrome",
    "criteria": [
      {
        "id": "distal-contractures",
        "description": "Congenital contractures predominantly affecting distal joints (hands and feet)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including triangular face, downslanting palpebral fissures, small mouth, and prominent nasolabial folds",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-hypoplasia",
        "description": "Muscle hypoplasia or weakness evident on clinical examination",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital distal joint contractures and characteristic facial dysmorphism",
    "notes": "Genetic testing for mutations in MYH3, TNNI2, and TNNT3 genes can support diagnosis"
  },
