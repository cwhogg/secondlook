  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Craniofrontonasal Dysplasia-Poland Anomaly Syndrome",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of craniofrontonasal dysplasia features including coronal craniosynostosis, hypertelorism, and frontonasal dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "poland-anomaly",
        "description": "Unilateral absence or hypoplasia of the pectoralis major muscle with ipsilateral hand anomalies such as syndactyly or brachydactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-confirmation",
        "description": "Imaging evidence of rib anomalies and cranial suture abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with craniofrontonasal dysplasia or Poland anomaly (if available)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both craniofacial dysmorphism consistent with craniofrontonasal dysplasia and unilateral pectoralis major muscle hypoplasia or aplasia with ipsilateral hand anomalies",
    "notes": "Diagnosis is primarily clinical; genetic testing may aid but is not always conclusive."
  },
