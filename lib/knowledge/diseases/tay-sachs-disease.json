  "diagnosticCriteria": {
    "formalCriteriaName": "Tay-Sachs Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of hexosaminidase A enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic HEXA gene mutations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive neurodegeneration with developmental regression and hypotonia in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cherry-red-spot",
        "description": "Presence of cherry-red macular spot on ophthalmologic examination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hexosaminidase A deficiency and compatible clinical presentation, supported by genetic testing",
    "notes": "Enzyme assay and genetic testing are definitive; clinical features guide suspicion."
  },
