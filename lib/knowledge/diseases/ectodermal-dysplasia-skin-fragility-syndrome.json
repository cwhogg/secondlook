  "keyFindings": {
    "laboratory": [
      "Anemia due to chronic skin loss",
      "Elevated inflammatory markers during infections"
    ],
    "imaging": [
      "Radiologic evidence of pyloric atresia or stenosis"
    ],
    "genetic": [
      "PKP1 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
