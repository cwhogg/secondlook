  "diagnosticCriteria": {
    "formalCriteriaName": "Bowen-Conradi syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "emaciation",
        "description": "Severe prenatal and postnatal growth retardation with marked emaciation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microcephaly",
        "description": "Progressive microcephaly with characteristic craniofacial features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Metaphyseal dysplasia and other skeletal abnormalities detected radiologically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of homozygous mutation in EMG1 gene (p.D86G)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-signs",
        "description": "Severe psychomotor retardation and hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe growth retardation, microcephaly, skeletal abnormalities, and confirmation by genetic testing",
    "notes": "Diagnosis is confirmed by molecular genetic testing identifying EMG1 mutation"
  },
