  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Secondary Intestinal Lymphangiectasia",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histological evidence of dilated intestinal lymphatic vessels on biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of protein-losing enteropathy with hypoalbuminemia and lymphopenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Radiologic or endoscopic evidence of intestinal lymphatic dilation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "secondary-cause-identification",
        "description": "Identification of underlying condition causing lymphatic obstruction (e.g., lymphoma, cardiac disease)",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of lymphangiectasia plus clinical evidence of protein-losing enteropathy and identification of an underlying secondary cause",
    "notes": "Diagnosis requires exclusion of primary (congenital) intestinal lymphangiectasia."
  },
