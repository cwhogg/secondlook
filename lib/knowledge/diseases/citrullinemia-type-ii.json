  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Citrullinemia Type II",
    "criteria": [
      {
        "id": "hyperammonemia",
        "description": "Elevated plasma ammonia levels during acute episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "citrulline-elevation",
        "description": "Markedly increased plasma citrulline concentration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "slt2-deficiency",
        "description": "Identification of pathogenic mutations in the SLC25A13 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Recurrent neuropsychiatric symptoms including altered consciousness and seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "liver-biopsy",
        "description": "Histological evidence of citrin deficiency in liver tissue",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hyperammonemia and elevated plasma citrulline combined with pathogenic SLC25A13 mutations",
    "notes": "Genetic testing is essential for definitive diagnosis; liver biopsy is rarely required."
  },
