  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests except possible hypothyroidism",
      "Immunoglobulin levels may be decreased in some cases"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter changes",
      "Echocardiography reveals congenital heart defects",
      "Skeletal X-rays demonstrate clinodactyly or other anomalies"
    ],
    "genetic": [
      "Microdeletion at chromosome 8q21.11 detected by chromosomal microarray or FISH",
      "Deletion size varies but typically includes multiple genes",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Developmental assessments confirm global delay",
      "Audiological testing may reveal hearing impairment"
    ]
  },
