  "omimId": "210500",
  "orphanetId": "238",
  "prevalence": {
    "estimate": "1 in 10,000 to 15,000 live births",
    "range": "0.0067% - 0.01%",
    "classification": "rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 120,
      "peak": 45
    },
    "sexPredilection": "slight-female",
    "ethnicAssociations": [
      "Higher incidence in East Asian populations"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Kasai Diagnostic Criteria",
    "criteria": [
      {
        "id": "persistent-jaundice",
        "description": "Persistent conjugated hyperbilirubinemia beyond 2 weeks of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-or-narrow-bile-ducts",
        "description": "Intraoperative cholangiography showing absent or obliterated extrahepatic bile ducts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-biopsy-findings",
        "description": "Liver biopsy showing bile duct proliferation, portal fibrosis, and bile plugs",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ultrasound-findings",
        "description": "Ultrasound showing absent or abnormal gallbladder and triangular cord sign",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent conjugated hyperbilirubinemia plus cholangiographic evidence of bile duct obliteration",
    "notes": "Early diagnosis is critical for timely surgical intervention (Kasai portoenterostomy)."
  },
  "symptoms": {
    "pathognomonic": [
