  "keyFindings": {
    "laboratory": [
      "Leukopenia with relative lymphocytosis",
      "Mild elevation of ESR and CRP",
      "Negative bacterial and viral cultures"
    ],
    "imaging": [
      "Ultrasound or CT showing enlarged cervical lymph nodes without abscess formation"
    ],
    "genetic": [
      "No known genetic mutations associated"
    ],
    "other": [
      "Lymph node biopsy demonstrating necrotizing histiocytic lymphadenitis with karyorrhectic debris and absence of neutrophils"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "Positive ANA and other autoimmune serologies",
        "Presence of systemic symptoms beyond lymphadenopathy",
        "Histopathology showing hematoxylin bodies and plasma cell infiltration"
      ]
    },
    {
      "diseaseId": "tuberculous-lymphadenitis",
      "distinguishingFeatures": [
        "Caseating granulomas on biopsy",
        "Positive acid-fast bacilli stain or culture",
        "Systemic symptoms like weight loss and night sweats more pronounced"
      ]
    },
    {
      "diseaseId": "lymphoma",
      "distinguishingFeatures": [
        "Monoclonal lymphoid proliferation on biopsy",
        "B symptoms more severe and persistent",
        "Imaging showing widespread lymphadenopathy"
      ]
    }
  ],
  "redFlags": [
    "Rapidly enlarging lymph nodes",
    "Persistent high-grade fever",
    "Signs of systemic autoimmune disease or malignancy"
  ],
