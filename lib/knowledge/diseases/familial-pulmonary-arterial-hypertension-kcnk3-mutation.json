        "requiredForDiagnosis": true
      },
      {
        "id": "genetic",
        "description": "Presence of pathogenic or likely pathogenic mutation in KCNK3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion",
        "description": "Exclusion of other causes of pulmonary hypertension such as left heart disease, lung diseases, or thromboembolic disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of pulmonary arterial hypertension consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Hemodynamic confirmation of PAH by right heart catheterization plus identification of pathogenic KCNK3 mutation and exclusion of other causes",
    "notes": "Genetic testing is essential for confirmation in familial cases; clinical presentation may overlap with idiopathic PAH."
  },
