  "keyFindings": {
    "laboratory": [
      "Elevated cerebrospinal fluid protein (>100 mg/dL)",
      "Lactic acidosis in blood and CSF"
    ],
    "imaging": [
      "Brain MRI may show cerebellar atrophy",
      "Cardiac conduction abnormalities on ECG"
    ],
    "genetic": [
      "Single large-scale mitochondrial DNA deletions detected by Southern blot or PCR"
    ],
    "other": [
      "Muscle biopsy showing ragged red fibers on modified Gomori trichrome stain"
    ]
  },
  "differentialDiagnoses": [
    {
