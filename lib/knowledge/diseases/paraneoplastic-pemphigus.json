  "differentialDiagnoses": [
    {
      "diseaseId": "pemphigus-vulgaris",
      "distinguishingFeatures": [
        "Lack of associated neoplasm",
        "Autoantibodies primarily against desmoglein 3 and 1",
        "Less severe mucositis and absence of bronchiolitis obliterans"
      ]
    },
    {
      "diseaseId": "bullous-pemphigoid",
      "distinguishingFeatures": [
        "Tense blisters rather than polymorphous lesions",
        "Autoantibodies against hemidesmosomal proteins BP180 and BP230",
        "Usually spares mucous membranes"
      ]
    },
    {
      "diseaseId": "erythema-multiforme",
      "distinguishingFeatures": [
        "Target lesions with less severe mucosal involvement",
        "Usually triggered by infections or drugs",
        "No associated neoplasm or autoantibodies"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive mucosal erosions refractory to standard therapies",
    "Development of bronchiolitis obliterans causing respiratory compromise",
    "Presence of underlying malignancy requiring oncologic evaluation"
  ],
