  "diagnosticCriteria": {
    "formalCriteriaName": "Jansson Criteria for Chronic Nonbacterial Osteomyelitis",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Recurrent multifocal bone pain and swelling lasting more than 6 weeks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Radiologic evidence of osteolytic or sclerotic bone lesions on MRI or X-ray",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-infection",
        "description": "Negative bacterial cultures and absence of infectious etiology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Non-specific chronic inflammation without evidence of infection on biopsy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-anti-inflammatory-treatment",
        "description": "Improvement with NSAIDs or immunomodulatory therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (clinical presentation, imaging findings, and exclusion of infection) with supportive minor or supportive criteria as needed",
    "notes": "Diagnosis is primarily clinical and radiological after exclusion of infectious and neoplastic causes."
  },
