        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-intellectual-disability",
        "description": "Severe to profound intellectual disability and global developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic craniofacial dysmorphisms including prominent forehead, arched eyebrows, hypertelorism, and downturned mouth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia and feeding difficulties",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "autistic-features",
        "description": "Autistic-like behaviors and impaired social interaction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Identification of a pathogenic ASXL3 variant plus presence of severe intellectual disability and characteristic facial features",
    "notes": "Genetic testing is essential for confirmation; clinical features may overlap with other ASXL-related syndromes."
