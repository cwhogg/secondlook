  "keyFindings": {
    "laboratory": [
      "No specific laboratory markers; autoimmune markers usually negative"
    ],
    "imaging": [
      "MRI showing unilateral facial soft tissue and bone atrophy",
      "CT scan demonstrating osseous involvement of facial bones",
      "Brain MRI may reveal ipsilateral white matter changes"
    ],
    "genetic": [
      "No known genetic mutations definitively linked"
    ],
    "other": [
      "Histopathology shows dermal fibrosis and atrophy without inflammation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "linear-scleroderma-en-coup-de-sabre",
      "distinguishingFeatures": [
        "Presence of sclerotic skin plaques with induration",
        "More prominent inflammatory changes",
        "Often associated with systemic sclerosis features"
      ]
    },
    {
      "diseaseId": "facial-lipoatrophy",
      "distinguishingFeatures": [
        "Bilateral or symmetrical fat loss",
        "Associated with metabolic or HIV-related causes",
        "Lack of progressive bone involvement"
      ]
    },
    {
      "diseaseId": "traumatic-facial-atrophy",
      "distinguishingFeatures": [
        "History of trauma or surgery",
        "Non-progressive after initial insult",
        "Absence of neurological symptoms"
      ]
    }
  ],
