  "diagnosticCriteria": {
    "formalCriteriaName": "International Society for Cutaneous Lymphomas (ISCL) Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Persistent, progressive, erythematous, scaly patches or plaques with characteristic distribution",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Epidermotropic atypical T-cell infiltrate with cerebriform nuclei on skin biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotyping",
        "description": "Clonal T-cell receptor gene rearrangement and loss of pan-T-cell markers (e.g., CD7) in lesional skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-course",
        "description": "Chronic course with slow progression over years",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-entities",
        "description": "Exclusion of other cutaneous lymphomas and inflammatory dermatoses",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical presentation plus confirmatory histopathology and immunophenotyping findings",
    "notes": "Diagnosis often requires clinicopathologic correlation and may need multiple biopsies over time."
  },
