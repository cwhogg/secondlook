  "keyFindings": {
    "laboratory": [
      "Histopathological identification of amyloid deposits with Congo red staining",
      "Genetic testing revealing TGFBI gene mutations (e.g., R124C mutation)"
    ],
    "imaging": [
      "Slit-lamp biomicroscopy showing branching lattice stromal opacities",
      "Anterior segment optical coherence tomography (AS-OCT) demonstrating stromal deposits"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal dominant mutations in TGFBI gene",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Family history consistent with autosomal dominant inheritance pattern"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "granular-corneal-dystrophy",
      "distinguishingFeatures": [
        "Discrete, crumb-like stromal opacities rather than branching lattice",
        "Different TGFBI mutations (e.g., R555W)",
        "Less frequent recurrent erosions"
      ]
    },
    {
      "diseaseId": "macular-corneal-dystrophy",
      "distinguishingFeatures": [
        "Diffuse stromal haze with glycosaminoglycan deposits",
        "Early onset stromal clouding without lattice pattern",
        "Associated with keratan sulfate deficiency"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive vision loss",
    "Recurrent, severe corneal erosions with pain",
    "Signs of secondary infection or keratitis"
  ],
