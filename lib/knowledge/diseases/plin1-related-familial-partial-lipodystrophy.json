  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for PLIN1-related FPLD",
    "criteria": [
      {
        "id": "partial-lipodystrophy",
        "description": "Regional loss of subcutaneous adipose tissue predominantly affecting the limbs and trunk with relative fat accumulation in the face and neck",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-complications",
        "description": "Presence of insulin resistance, hypertriglyceridemia, and/or diabetes mellitus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "plin1-mutation",
        "description": "Identification of pathogenic heterozygous mutation in the PLIN1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history consistent with autosomal dominant inheritance of partial lipodystrophy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-weakness",
        "description": "Mild proximal muscle weakness or myopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic partial lipodystrophy phenotype plus pathogenic PLIN1 mutation",
    "notes": "Genetic testing is essential to confirm diagnosis; metabolic complications often develop after onset of fat loss."
  },
