  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Thymic Tumors",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histological confirmation of neuroendocrine tumor cells in thymic tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Positive immunohistochemical staining for neuroendocrine markers (chromogranin, synaptophysin, CD56)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Radiologic evidence of anterior mediastinal mass consistent with thymic origin on CT or MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of symptoms related to mass effect or hormone secretion",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation with positive neuroendocrine markers and imaging evidence of thymic mass",
    "notes": "Exclusion of metastatic neuroendocrine tumors from other primary sites is essential"
  },
