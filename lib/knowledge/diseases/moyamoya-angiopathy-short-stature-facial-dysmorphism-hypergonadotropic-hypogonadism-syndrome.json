  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Moyamoya Angiopathy-Short Stature-Facial Dysmorphism-Hypergonadotropic Hypogonadism Syndrome",
    "criteria": [
      {
        "id": "moyamoya-angiopathy",
        "description": "Presence of moyamoya angiopathy confirmed by cerebral angiography or MRI/MRA",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Height below the 3rd percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism, broad nasal bridge, and epicanthal folds",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypergonadotropic-hypogonadism",
        "description": "Elevated gonadotropin levels with clinical hypogonadism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "additional-features",
        "description": "Supportive findings such as cognitive impairment or skeletal anomalies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All four major criteria (moyamoya angiopathy, short stature, facial dysmorphism, and hypergonadotropic hypogonadism) must be present",
    "notes": "Diagnosis relies on clinical, radiological, and endocrinological evaluation; genetic testing may support but is not yet definitive"
  },
