  "diagnosticCriteria": {
    "formalCriteriaName": "MELAS Diagnostic Criteria (Yatsuga et al.)",
    "criteria": [
      {
        "id": "stroke-like-episodes",
        "description": "Recurrent stroke-like episodes before age 40",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lactic-acidosis",
        "description": "Elevated lactate levels in blood or cerebrospinal fluid",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mitochondrial-dna-mutation",
        "description": "Presence of pathogenic mitochondrial DNA mutation (e.g., m.3243A>G)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "History of seizures or epilepsy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Ragged-red fibers on muscle biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of stroke-like episodes before age 40, elevated lactate, and confirmed pathogenic mitochondrial DNA mutation",
    "notes": "Muscle biopsy and clinical features support diagnosis but are not mandatory if genetic confirmation is present"
  },
  "symptoms": {
