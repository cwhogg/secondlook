  "keyFindings": {
    "laboratory": [
      "Nerve conduction studies showing reduced sensory nerve action potentials",
      "Skin biopsy demonstrating loss of small myelinated and unmyelinated fibers"
    ],
    "imaging": [
      "X-rays showing neuropathic joint destruction (Charcot joints)",
      "MRI may show muscle atrophy in distal limbs"
    ],
    "genetic": [
      "Pathogenic variants in SPTLC1 gene",
      "Pathogenic variants in SPTLC2 gene"
    ],
    "other": [
      "Autonomic function tests showing impaired sudomotor and cardiovascular reflexes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "charcot-marie-tooth-disease",
      "distinguishingFeatures": [
        "Predominantly motor and sensory neuropathy with slower progression",
        "Usually no significant autonomic dysfunction"
      ]
    },
    {
      "diseaseId": "fabry-disease",
      "distinguishingFeatures": [
        "X-linked inheritance",
        "Presence of angiokeratomas and renal involvement",
        "Pain crises often present in childhood"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of sensory loss with severe ulcerations",
    "Signs of systemic autonomic failure such as syncope or arrhythmias",
    "Development of osteomyelitis or gangrene requiring amputation"
  ],
