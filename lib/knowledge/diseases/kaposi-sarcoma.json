  "keyFindings": {
    "laboratory": [
      "Positive immunohistochemistry for HHV-8 latent nuclear antigen",
      "Anemia secondary to gastrointestinal bleeding",
      "Elevated inflammatory markers in advanced disease"
    ],
    "imaging": [
      "Chest CT showing pulmonary nodules and infiltrates",
      "Endoscopic visualization of gastrointestinal lesions",
      "MRI or CT for visceral organ involvement"
    ],
    "genetic": [
      "Association with HHV-8 infection; no known germline mutations"
    ],
    "other": [
      "Histopathology showing spindle cell proliferation with neovascularization",
      "Lymphatic obstruction causing lymphedema"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "bacillary-angiomatosis",
      "distinguishingFeatures": [
        "Bartonella henselae infection",
        "Response to antibiotics",
        "Histopathology showing neutrophilic infiltrate"
      ]
    },
    {
      "diseaseId": "angiosarcoma",
      "distinguishingFeatures": [
        "More aggressive clinical course",
        "Histology showing atypical endothelial cells",
        "Lack of HHV-8 positivity"
      ]
    },
    {
      "diseaseId": "pyogenic-granuloma",
      "distinguishingFeatures": [
        "Rapidly growing vascular lesion",
        "Usually solitary and ulcerated",
        "Histology lacking spindle cells"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of skin lesions with ulceration",
    "Respiratory distress indicating pulmonary involvement",
    "Gastrointestinal bleeding or obstruction",
    "New onset lymphedema in affected limbs"
  ],
