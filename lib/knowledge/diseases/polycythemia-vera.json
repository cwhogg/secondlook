  "diagnosticCriteria": {
    "formalCriteriaName": "WHO 2022 Diagnostic Criteria for Polycythemia Vera",
    "criteria": [
      {
        "id": "pv-c1",
        "description": "Hemoglobin >16.5 g/dL in men or >16.0 g/dL in women, OR hematocrit >49% in men or >48% in women, OR increased red cell mass",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pv-c2",
        "description": "Bone marrow biopsy showing hypercellularity with trilineage growth (panmyelosis) with prominent erythroid, granulocytic, and megakaryocytic proliferation with pleomorphic mature megakaryocytes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pv-c3",
        "description": "Presence of JAK2 V617F or JAK2 exon 12 mutation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pv-c4",
        "description": "Subnormal serum erythropoietin level",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All 3 major criteria, OR first 2 major criteria plus the minor criterion",
    "notes": "JAK2 V617F is found in ~95% of PV cases. JAK2 exon 12 mutations account for most remaining cases. Criterion 2 (bone marrow biopsy) may not be required if hemoglobin is >18.5 g/dL in men or >16.5 g/dL in women with JAK2 mutation and low EPO."
  },
