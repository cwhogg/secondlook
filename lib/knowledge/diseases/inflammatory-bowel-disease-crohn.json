  "diagnosticCriteria": {
    "formalCriteriaName": "ACG/ECCO Diagnostic Approach for Crohn's Disease",
    "criteria": [
      {
        "id": "crohn-1",
        "description": "Clinical presentation: chronic diarrhea (>4 weeks), abdominal pain, weight loss",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "crohn-2",
        "description": "Endoscopic findings: skip lesions, deep linear/serpiginous ulcers, cobblestone mucosa, strictures",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "crohn-3",
        "description": "Histological findings: transmural inflammation, non-caseating granulomas, focal chronic inflammation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "crohn-4",
        "description": "Imaging: bowel wall thickening, mesenteric fat stranding (creeping fat), fistulae, abscesses",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "crohn-5",
        "description": "Perianal disease: fistulae, abscesses, skin tags",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "crohn-6",
        "description": "Exclusion of infectious causes (TB, Yersinia, C. difficile)",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Combination of clinical, endoscopic, histologic, and radiologic findings consistent with Crohn's disease after excluding infections. No single gold standard test.",
    "notes": "Montreal classification: Age at diagnosis (A1 <16, A2 17-40, A3 >40), Location (L1 ileal, L2 colonic, L3 ileocolonic, L4 upper GI), Behavior (B1 non-stricturing/non-penetrating, B2 stricturing, B3 penetrating, p perianal modifier)."
  },
