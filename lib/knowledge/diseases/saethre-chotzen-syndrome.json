  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Skull X-ray or CT showing premature fusion of coronal sutures",
      "3D CT reconstruction demonstrating craniosynostosis",
      "Hand and foot radiographs showing syndactyly or brachydactyly"
    ],
    "genetic": [
      "FGFR3 (candidate)",
      "FGFR2 (candidate)",
      "TWIST1 (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
