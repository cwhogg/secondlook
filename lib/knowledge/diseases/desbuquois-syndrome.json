  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild elevation of alkaline phosphatase due to bone turnover"
    ],
    "imaging": [
      "Radiographs showing advanced carpal bone ossification",
      "Monkey wrench deformity of proximal femora",
      "Generalized epiphyseal and metaphyseal dysplasia"
    ],
    "genetic": [
      "CSGALNACT1 (causative)",
      "CANT1 (causative, loss-of-function)",
      "XYLT1 (causative, loss-of-function)",
      "Mutations in CANT1 gene (autosomal recessive inheritance)"
    ],
    "other": [
      "Prenatal ultrasound may show short long bones and joint laxity"
    ]
  },
