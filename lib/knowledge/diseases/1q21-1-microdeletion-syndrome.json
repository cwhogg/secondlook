  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for 1q21.1 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of a heterozygous microdeletion at chromosome 1q21.1 confirmed by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurodevelopmental-delay",
        "description": "Developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or craniofacial dysmorphisms",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-phenotype",
        "description": "Behavioral abnormalities including autism spectrum disorder or attention deficit hyperactivity disorder",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 1q21.1 microdeletion plus at least one major clinical feature (neurodevelopmental delay or intellectual disability)",
    "notes": "Phenotypic variability is high; some individuals may be asymptomatic carriers."
  },
