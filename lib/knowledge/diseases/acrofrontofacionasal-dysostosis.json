  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Acrofrontofacionasal Dysostosis",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial anomalies including frontonasal dysplasia, hypertelorism, and midline nasal cleft",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Postaxial polydactyly and syndactyly of hands and feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Prenatal and postnatal growth retardation with short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cleft-palate",
        "description": "Presence of cleft palate or bifid uvula",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiological-findings",
        "description": "Radiographic evidence of cranial suture abnormalities and limb bone anomalies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic craniofacial anomalies plus limb malformations (polydactyly and/or syndactyly)",
    "notes": "Genetic testing may support diagnosis but is not definitive due to limited molecular characterization."
  },
