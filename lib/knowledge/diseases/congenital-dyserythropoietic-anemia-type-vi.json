  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Congenital Dyserythropoietic Anemia Type VI",
    "criteria": [
      {
        "id": "erythroid-abnormalities",
        "description": "Presence of characteristic erythroid abnormalities including multinuclearity and nuclear bridging in bone marrow erythroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-anemia",
        "description": "Chronic severe anemia with reticulocytopenia and ineffective erythropoiesis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cdan6-genetic-testing",
        "description": "Identification of pathogenic variants in the SEC23B gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemolysis-markers",
        "description": "Elevated lactate dehydrogenase (LDH) and indirect hyperbilirubinemia indicating hemolysis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "bone-marrow-hyperplasia",
        "description": "Bone marrow showing erythroid hyperplasia with dyserythropoietic features",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic erythroid abnormalities on bone marrow examination plus severe anemia and confirmation by genetic testing",
    "notes": "Genetic testing is essential to confirm diagnosis due to overlap with other CDA subtypes"
  },
