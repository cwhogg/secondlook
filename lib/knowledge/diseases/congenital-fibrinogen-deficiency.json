  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for congenital fibrinogen deficiency",
    "criteria": [
      {
        "id": "prolonged-pt-aptt",
        "description": "Prolonged prothrombin time (PT) and activated partial thromboplastin time (aPTT)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "undetectable-fibrinogen",
        "description": "Undetectable or severely reduced plasma fibrinogen levels by functional and antigenic assays",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in FGA, FGB, or FGG genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-bleeding-history",
        "description": "History of spontaneous or excessive bleeding episodes since birth or early childhood",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of undetectable fibrinogen levels and prolonged PT/aPTT with confirmatory genetic testing",
    "notes": "Differentiation from acquired fibrinogen deficiency and hypofibrinogenemia is essential."
  },
