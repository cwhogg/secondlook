  "keyFindings": {
    "laboratory": [
      "Isolated decreased serum IgM levels",
      "Normal serum IgG and IgA levels",
      "Normal lymphocyte counts and subsets",
      "Negative secondary causes of hypogammaglobulinemia"
    ],
    "imaging": [
      "Chest X-ray may show recurrent pneumonia or bronchiectasis"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Poor antibody response to polysaccharide vaccines in some patients"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "common-variable-immunodeficiency",
      "distinguishingFeatures": [
        "Low IgG and/or IgA in addition to IgM",
        "More frequent autoimmune and granulomatous disease",
        "More severe hypogammaglobulinemia"
      ]
    },
    {
      "diseaseId": "transient-hypogammaglobulinemia-of-infancy",
      "distinguishingFeatures": [
        "Occurs in infants under 2 years",
        "Transient decrease in multiple immunoglobulin classes",
        "Spontaneous resolution with age"
      ]
    },
    {
      "diseaseId": "secondary-immunodeficiency",
      "distinguishingFeatures": [
        "History of immunosuppressive therapy, malignancy, or infection",
        "Multiple immunoglobulin classes affected",
        "Reversible upon treatment of underlying cause"
      ]
    }
  ],
