  "diagnosticCriteria": {
    "formalCriteriaName": "SLC35A1-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of multisystemic clinical features including neurological impairment and skeletal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "transferrin-glycosylation",
        "description": "Abnormal serum transferrin isoelectric focusing pattern indicating N-glycosylation defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic biallelic variants in the SLC35A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-lab",
        "description": "Additional biochemical abnormalities such as reduced UDP-galactose transport activity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus abnormal transferrin glycosylation and confirmation by biallelic pathogenic variants in SLC35A1",
    "notes": "Diagnosis requires integration of clinical, biochemical, and genetic data."
  },
