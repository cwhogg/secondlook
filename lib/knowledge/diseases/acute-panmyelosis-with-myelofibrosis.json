  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Tumors of Hematopoietic and Lymphoid Tissues (2016) criteria for APMF",
    "criteria": [
      {
        "id": "bone-marrow-panmyelosis",
        "description": "Bone marrow biopsy showing panmyeloid proliferation with increased blasts and marked fibrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "blast-percentage",
        "description": "Peripheral blood or bone marrow blast count between 20% and 30%",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-bcr-abl1",
        "description": "Absence of BCR-ABL1 fusion gene and other defining genetic abnormalities of chronic myeloid leukemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "myelofibrosis",
        "description": "Presence of reticulin and/or collagen fibrosis in bone marrow",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cytopenias",
        "description": "Peripheral blood cytopenias involving at least two cell lines",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of panmyeloid proliferation with fibrosis on bone marrow biopsy, blast count 20-30%, and absence of BCR-ABL1 fusion gene",
    "notes": "Diagnosis requires exclusion of other myeloid neoplasms with fibrosis and genetic abnormalities"
  },
