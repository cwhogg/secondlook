        "description": "Identification of pathogenic mutations in the associated gene(s) (e.g., ERCC4/XPF)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: progressive cerebellar ataxia, photosensitivity, and short stature",
