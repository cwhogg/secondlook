  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible elevated lactate during status epilepticus"
    ],
    "imaging": [
      "Normal brain MRI early in disease",
      "Possible cerebral atrophy or hippocampal sclerosis in later stages"
    ],
    "genetic": [
      "Pathogenic variants in SCN1A gene in approximately 80% of cases"
    ],
    "other": [
      "Electroencephalogram (EEG) showing generalized spike-and-wave and polyspike discharges",
      "Prolonged seizures triggered by fever or hyperthermia"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "febrile-seizures",
      "distinguishingFeatures": [
        "Shorter duration febrile seizures",
        "No multiple seizure types",
        "No developmental regression"
      ]
    },
    {
      "diseaseId": "other-epileptic-encephalopathies",
      "distinguishingFeatures": [
        "Different genetic mutations",
        "Distinct seizure semiology",
        "Earlier or later onset"
      ]
    }
  ],
  "redFlags": [
    "Prolonged febrile seizures lasting more than 15 minutes",
    "Multiple seizure types refractory to standard antiepileptic drugs",
    "Developmental regression following seizure onset"
  ],
