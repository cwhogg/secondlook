  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for OFCD syndrome",
    "criteria": [
      {
        "id": "ocular-anomalies",
        "description": "Presence of congenital cataracts or microphthalmia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including long narrow face, high nasal bridge, and broad nasal tip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-defects",
        "description": "Congenital heart defects such as atrial septal defect or mitral valve prolapse",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-anomalies",
        "description": "Radiculomegaly of canine teeth and other dental abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in BCOR gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of ocular anomalies, facial dysmorphism, cardiac defects, and dental anomalies; genetic confirmation supports diagnosis",
    "notes": "Diagnosis is primarily clinical with genetic testing for confirmation"
  },
