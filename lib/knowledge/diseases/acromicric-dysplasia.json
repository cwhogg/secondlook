  "differentialDiagnoses": [
    {
      "diseaseId": "geleophysic-dysplasia",
      "distinguishingFeatures": [
        "More severe cardiac involvement",
        "Hepatomegaly and tracheal stenosis common",
        "Distinct facial features with thickened skin"
      ]
    },
    {
      "diseaseId": "wagner-syndrome",
      "distinguishingFeatures": [
        "Primarily ophthalmological manifestations",
        "Progressive vision loss without skeletal abnormalities",
        "No disproportionate short stature"
      ]
    },
    {
      "diseaseId": "weill-marchesani-syndrome",
      "distinguishingFeatures": [
        "Short stature with brachydactyly but with lens abnormalities (ectopia lentis)",
        "Joint stiffness with microspherophakia",
        "Distinctive facial features differ"
      ]
    }
