  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Cervical Dystonia",
    "criteria": [
      {
        "id": "sustained-involuntary-muscle-contractions",
        "description": "Presence of sustained or intermittent involuntary muscle contractions causing abnormal postures or repetitive movements of the neck",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "combined-segmental-involvement",
        "description": "Involvement of cervical muscles combined with dystonia in adjacent body regions (e.g., shoulder, upper limb)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-secondary-causes",
        "description": "Exclusion of secondary causes such as drug-induced or structural brain lesions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensory-trick-phenomenon",
        "description": "Improvement of dystonic posture or movements with specific sensory tricks or gestes antagonistes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyographic-confirmation",
        "description": "Electromyographic evidence of co-contraction of agonist and antagonist cervical muscles",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of sustained involuntary cervical muscle contractions with combined segmental involvement and exclusion of secondary causes",
    "notes": "Diagnosis is clinical; supportive tests such as EMG can aid confirmation."
  },
