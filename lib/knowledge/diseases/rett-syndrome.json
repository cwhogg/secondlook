    },
    "sexPredilection": "female",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Neul et al. 2010 Revised Diagnostic Criteria for Rett Syndrome",
    "criteria": [
      {
        "id": "regression",
        "description": "Partial or complete loss of acquired purposeful hand skills",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hand-stereotypies",
        "description": "Stereotypic hand movements such as hand wringing, clapping, or mouthing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "language-loss",
        "description": "Loss of spoken language skills",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gait-abnormalities",
        "description": "Impaired or absent gait",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "breathing-dysfunction",
        "description": "Breathing irregularities such as hyperventilation or apnea while awake",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "scoliosis",
        "description": "Development of scoliosis during progression",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All four major criteria (regression of purposeful hand skills, hand stereotypies, loss of spoken language, and gait abnormalities) must be present with supportive criteria considered.",
    "notes": "Exclusion of other neurological disorders and genetic testing for MECP2 mutations support diagnosis."
  },
  "symptoms": {
