  "diagnosticCriteria": {
    "formalCriteriaName": "PNAC Diagnostic Criteria",
    "criteria": [
      {
        "id": "prolonged-parenteral-nutrition",
        "description": "History of prolonged parenteral nutrition exceeding 14 days",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cholestatic-liver-function-tests",
        "description": "Elevated serum conjugated bilirubin >2 mg/dL or direct bilirubin >20% of total bilirubin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of cholestasis such as biliary obstruction or infection",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepatic-ultrasound",
        "description": "Imaging showing absence of biliary obstruction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-alkaline-phosphatase",
        "description": "Elevated serum alkaline phosphatase and gamma-glutamyl transferase",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of prolonged parenteral nutrition, cholestatic liver function abnormalities, and exclusion of other causes of cholestasis",
    "notes": "Diagnosis is clinical and supported by laboratory and imaging findings; liver biopsy is rarely required."
  },
