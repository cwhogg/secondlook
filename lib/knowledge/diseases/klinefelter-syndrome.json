  "keyFindings": {
    "laboratory": [
      "Elevated FSH (marked) and LH",
      "Low total and free testosterone",
      "Elevated estradiol relative to testosterone",
      "Semen analysis: azoospermia or severe oligospermia",
      "Low inhibin B",
      "Elevated SHBG"
    ],
    "imaging": [
      "Testicular ultrasound showing small testes",
      "DEXA scan for bone density assessment",
      "Breast imaging if gynecomastia is prominent or suspicious"
    ],
    "genetic": [
      "Karyotype: 47,XXY (~80% of cases)",
      "Mosaic: 46,XY/47,XXY (~10-20%)",
      "Higher-order aneuploidies: 48,XXXY; 48,XXYY; 49,XXXXY (more severe phenotypes)",
      "Non-disjunction during parental meiosis (maternal or paternal)"
    ],
    "other": [
      "Neuropsychological assessment for learning difficulties",
      "Metabolic screening (glucose tolerance, lipid panel)",
      "Bone age X-ray in childhood"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "kallmann-syndrome",
      "distinguishingFeatures": [
        "Hypogonadotropic (not hypergonadotropic) hypogonadism",
        "Anosmia or hyposmia (defining feature)",
