  "diagnosticCriteria": {
    "formalCriteriaName": "Landau-Kleffner Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "acquired-aphasia",
        "description": "Acquired receptive and expressive aphasia with loss of language comprehension and verbal expression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epileptiform-activity",
        "description": "Electroencephalogram (EEG) showing epileptiform activity, often during sleep",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-development-prior",
        "description": "Normal language development prior to onset of symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-structural-lesions",
        "description": "No evidence of structural brain lesions on neuroimaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizure-history",
        "description": "History of clinical seizures or subclinical seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acquired aphasia with abnormal EEG showing epileptiform activity and previously normal language development",
    "notes": "Diagnosis is clinical and supported by EEG findings; neuroimaging is used to exclude other causes."
  },
