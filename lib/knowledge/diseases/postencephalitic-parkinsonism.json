  "diagnosticCriteria": {
    "formalCriteriaName": "Postencephalitic Parkinsonism Diagnostic Criteria",
    "criteria": [
      {
        "id": "history-encephalitis",
        "description": "History of encephalitis lethargica or encephalitic illness preceding parkinsonism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "parkinsonian-features",
        "description": "Presence of parkinsonian motor symptoms including bradykinesia, rigidity, and resting tremor",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-idiopathic-parkinsonism",
        "description": "Exclusion of idiopathic Parkinson's disease and other secondary causes of parkinsonism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-neuroimaging",
        "description": "Neuroimaging showing basal ganglia abnormalities consistent with postencephalitic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-dopaminergic-therapy",
        "description": "Variable or poor response to dopaminergic therapy compared to idiopathic Parkinson's disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "History of encephalitis lethargica followed by parkinsonian motor features with exclusion of idiopathic Parkinson's disease",
    "notes": "Diagnosis is clinical and supported by history and exclusion of other causes; neuroimaging and response to therapy are supportive but not definitive."
  },
