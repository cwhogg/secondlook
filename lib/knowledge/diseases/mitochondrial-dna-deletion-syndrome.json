      },
      {
        "id": "cardiac-conduction",
        "description": "Cardiac conduction defects on ECG",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive external ophthalmoplegia and muscle weakness plus confirmation of mitochondrial DNA deletion",
    "notes": "Muscle biopsy and genetic testing are essential for definitive diagnosis."
