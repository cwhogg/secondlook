  "keyFindings": {
    "laboratory": [
      "Elevated fasting insulin and glucose levels indicating insulin resistance",
      "Elevated liver enzymes consistent with hepatic fibrosis",
      "Proteinuria and elevated serum creatinine indicating renal impairment"
    ],
    "imaging": [
      "Echocardiogram showing dilated or restrictive cardiomyopathy",
      "Liver ultrasound or MRI showing hepatic fibrosis",
      "Renal ultrasound showing structural abnormalities"
    ],
    "genetic": [
      "Biallelic pathogenic variants in ALMS1 gene confirmed by molecular genetic testing"
    ],
    "other": [
      "Electroretinogram showing reduced cone and rod function",
      "Audiometry confirming sensorineural hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "bardet-biedl-syndrome",
      "distinguishingFeatures": [
        "Polydactyly",
        "Cognitive impairment",
        "Renal anomalies more prominent",
        "Different genetic etiology"
      ]
    },
    {
      "diseaseId": "usher-syndrome",
      "distinguishingFeatures": [
        "Retinitis pigmentosa with hearing loss",
        "Absence of cardiomyopathy and metabolic dysfunction",
        "Different genetic mutations"
      ]
    }
  ],
  "redFlags": [
