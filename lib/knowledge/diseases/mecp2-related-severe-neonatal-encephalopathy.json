  "keyFindings": {
    "laboratory": [
      "Normal metabolic screening excluding other metabolic encephalopathies",
      "Possible mild anemia on complete blood count"
    ],
    "imaging": [
      "Brain MRI showing diffuse cerebral atrophy and delayed myelination",
      "EEG demonstrating burst suppression or severe background abnormalities"
    ],
    "genetic": [
      "MECP2 (causative, loss-of-function)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Abnormal respiratory function tests consistent with hypoventilation",
      "Feeding assessments showing poor coordination"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hypoxic-ischemic-encephalopathy",
