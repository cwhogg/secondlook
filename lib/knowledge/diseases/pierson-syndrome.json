        "description": "Identification of pathogenic mutations in the LAMB2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-abnormalities",
        "description": "Additional ocular abnormalities such as retinal detachment or cataracts",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
