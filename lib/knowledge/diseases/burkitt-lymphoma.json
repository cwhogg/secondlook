      "Hyperuricemia",
      "Cytopenias if bone marrow involved"
    ],
    "imaging": [
      "CT or MRI showing bulky abdominal or jaw masses",
      "PET-CT demonstrating high metabolic activity"
    ],
    "genetic": [
      "MYC (fusion gene)"
    ],
    "other": [
      "High Ki-67 proliferation index (~100%) on immunohistochemistry",
      "Starry sky appearance on histology due to macrophages"
    ]
