{
  "id": "dyskeratosis-congenita",
  "name": "Dyskeratosis Congenita",
  "aliases": [
    "DKC",
    "Zinsser-Engman-Cole syndrome"
  ],
  "icd10Codes": [
    "D61.8"
  ],
  "omimId": "127550",
