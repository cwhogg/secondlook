  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible localized intravascular coagulopathy markers (elevated D-dimer, low fibrinogen) in complicated cases"
    ],
    "imaging": [
      "MRI demonstrating slow-flow venous channels with high T2 signal intensity",
      "Presence of phleboliths on plain radiographs or CT",
      "Absence of arterial flow on Doppler ultrasound"
    ],
    "genetic": [
      "Somatic mutations in TEK (TIE2) gene reported in some cases"
    ],
    "other": [
      "Histopathology showing dilated, thin-walled venous channels lined by endothelial cells"
    ]
  },
