  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Cerebral Cavernous Malformation Diagnostic Criteria",
    "criteria": [
      {
        "id": "family-history",
        "description": "Presence of at least one first-degree relative with confirmed cerebral cavernous malformations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multiple-lesions",
        "description": "MRI evidence of multiple cerebral cavernous malformations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in CCM1 (KRIT1), CCM2, or CCM3 (PDCD10) genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "single-lesion",
        "description": "MRI evidence of a solitary cerebral cavernous malformation without family history",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple cerebral cavernous malformations on MRI plus a positive family history or identification of a pathogenic CCM gene mutation",
    "notes": "Genetic testing is supportive but not mandatory if clinical and imaging criteria are met."
  },
