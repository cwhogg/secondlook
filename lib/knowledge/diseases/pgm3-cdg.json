  "keyFindings": {
    "laboratory": [
      "Hypogammaglobulinemia with low IgG, IgA, and IgM",
      "Lymphopenia affecting T and B cells",
      "Abnormal serum transferrin glycosylation pattern"
    ],
    "imaging": [
      "Skeletal radiographs showing dysplasia or delayed bone age",
      "Brain MRI may show cerebral atrophy or white matter abnormalities"
    ],
    "genetic": [
      "PGM3 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Reduced phosphoglucomutase 3 enzyme activity in fibroblasts or leukocytes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pmn2-cdg",
      "distinguishingFeatures": [
        "PMM2-CDG typically presents with cerebellar hypoplasia and coagulation abnormalities",
        "Different genetic mutation in PMM2 gene"
      ]
    },
    {
      "diseaseId": "hyperimmunoglobulin-e-syndrome",
      "distinguishingFeatures": [
        "Elevated IgE levels and characteristic facial features",
        "STAT3 mutations rather than PGM3 mutations"
      ]
    }
  ],
