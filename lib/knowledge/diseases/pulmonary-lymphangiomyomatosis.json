  "diagnosticCriteria": {
    "formalCriteriaName": "European Respiratory Society (ERS) LAM Diagnostic Criteria",
    "criteria": [
      {
        "id": "lung-cysts",
        "description": "Characteristic thin-walled cystic changes on high-resolution CT scan of the lungs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "extrapulmonary-lam",
        "description": "Presence of angiomyolipomas or chylous effusions",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tuberous-sclerosis",
        "description": "Diagnosis of tuberous sclerosis complex or presence of TSC gene mutations",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "serum-vegf-d",
        "description": "Elevated serum vascular endothelial growth factor-D (VEGF-D) levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic lung cysts on HRCT plus either histological confirmation or presence of extrapulmonary manifestations (e.g., angiomyolipomas) or elevated VEGF-D",
    "notes": "Definitive diagnosis may require lung biopsy if clinical and radiologic criteria are inconclusive."
  },
