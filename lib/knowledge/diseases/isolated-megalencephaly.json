  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Criteria for Isolated Megalencephaly",
    "criteria": [
      {
        "id": "macrocephaly",
        "description": "Head circumference greater than 2 standard deviations above the mean for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-neurological-development",
        "description": "Normal neurological examination and developmental milestones without evidence of neurological deficits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Brain MRI showing increased brain volume without structural malformations or lesions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of megalencephaly such as metabolic, genetic syndromes, or hydrocephalus",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of macrocephaly with normal neurological development and supportive brain imaging findings, after exclusion of other causes",
    "notes": "Diagnosis is primarily clinical supported by neuroimaging and exclusion of secondary causes."
  },
