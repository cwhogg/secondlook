  "diagnosticCriteria": {
    "formalCriteriaName": "Molecular Cytogenetic Diagnostic Criteria for 10q22.3q23.3 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "microdeletion-confirmation",
        "description": "Detection of a heterozygous microdeletion involving the 10q22.3 to 10q23.3 chromosomal region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Presence of global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital heart defects such as ventricular septal defect or atrial septal defect",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Neonatal or infantile hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of 10q22.3q23.3 microdeletion plus presence of developmental delay or intellectual disability",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support but are variable."
  },
