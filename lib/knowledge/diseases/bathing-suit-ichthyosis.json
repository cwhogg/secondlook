  "diagnosticCriteria": {
    "formalCriteriaName": "Bathing Suit Ichthyosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "distribution-pattern",
        "description": "Presence of ichthyotic scaling predominantly in a bathing suit distribution pattern (trunk and proximal limbs)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "onset-age",
        "description": "Onset of symptoms in early infancy or neonatal period",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the TGM1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing hyperkeratosis with preserved granular layer",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic bathing suit distribution ichthyosis with early onset plus identification of TGM1 mutation or compatible family history",
    "notes": "Genetic confirmation is considered definitive; clinical presentation is key for initial suspicion."
  },
