  "diagnosticCriteria": {
    "formalCriteriaName": "Pallister-Hall Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypothalamic-hamartoma",
        "description": "Presence of hypothalamic hamartoma confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "polydactyly",
        "description": "Postaxial polydactyly of hands or feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pituitary-dysfunction",
        "description": "Endocrine abnormalities including hypopituitarism",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "bifid-epiglottis",
        "description": "Bifid epiglottis detected by laryngoscopy or imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic GLI3 gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of hypothalamic hamartoma plus either polydactyly or pathogenic GLI3 mutation",
    "notes": "Diagnosis is clinical but supported by genetic testing and imaging findings."
  },
