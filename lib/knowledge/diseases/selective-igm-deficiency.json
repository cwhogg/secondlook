  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Selective IgM Deficiency",
    "criteria": [
      {
        "id": "low-serum-igm",
        "description": "Serum IgM level below age-adjusted reference range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-igm-subclasses",
        "description": "Normal serum levels of IgG and IgA immunoglobulins",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-secondary-causes",
        "description": "Exclusion of secondary causes of hypogammaglobulinemia (e.g., medications, infections, malignancies)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-infections",
        "description": "Recurrent bacterial infections, especially respiratory tract infections",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent low serum IgM with normal IgG and IgA levels, after exclusion of secondary causes",
    "notes": "Diagnosis requires repeated immunoglobulin measurements and clinical correlation"
  },
