  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; exclusion of metabolic causes",
      "Possible mild elevation of creatine kinase if rigidity present"
    ],
    "imaging": [
      "Brain MRI typically normal; used to exclude structural lesions"
    ],
    "genetic": [
      "No known genetic markers identified for idiopathic catatonia"
    ],
    "other": [
      "Positive response to lorazepam challenge test supports diagnosis",
      "Electroencephalogram (EEG) usually normal or nonspecific"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "neuroleptic-malignant-syndrome",
      "distinguishingFeatures": [
        "Recent exposure to neuroleptic agents",
        "Marked hyperthermia and autonomic instability",
        "Elevated creatine kinase and leukocytosis"
      ]
    },
    {
      "diseaseId": "catatonia-associated-with-schizophrenia",
      "distinguishingFeatures": [
        "Presence of psychotic symptoms such as delusions or hallucinations",
        "Chronic psychiatric history",
        "Response to antipsychotic medications"
      ]
    },
    {
      "diseaseId": "autoimmune-encephalitis",
      "distinguishingFeatures": [
        "Presence of antibodies in CSF or serum",
        "Acute onset with seizures or cognitive decline",
        "MRI abnormalities in limbic regions"
      ]
    }
  ],
  "redFlags": [
