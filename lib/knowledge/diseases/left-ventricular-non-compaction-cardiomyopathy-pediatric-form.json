  "diagnosticCriteria": {
    "formalCriteriaName": "Jenni Criteria",
    "criteria": [
      {
        "id": "echocardiographic-trabeculation",
        "description": "Prominent trabeculations with a non-compacted to compacted myocardium ratio >2:1 at end-systole on echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "deep-intertrabecular-recesses",
        "description": "Presence of deep intertrabecular recesses perfused from the ventricular cavity demonstrated by color Doppler",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "left-ventricular-systolic-dysfunction",
        "description": "Left ventricular systolic dysfunction or heart failure symptoms in a pediatric patient",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-cardiomyopathies",
        "description": "Exclusion of other causes of cardiomyopathy such as dilated or hypertrophic cardiomyopathy",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of prominent trabeculations with non-compacted to compacted ratio >2:1 and deep intertrabecular recesses on imaging, plus exclusion of other cardiomyopathies",
    "notes": "Cardiac MRI may be used to confirm diagnosis when echocardiographic findings are inconclusive."
  },
