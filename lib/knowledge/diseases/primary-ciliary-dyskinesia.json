  "prevalence": {
    "estimate": "1 in 10,000 to 1 in 30,000",
    "classification": "rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 10,
      "peak": 2
    },
    "sexPredilection": "equal",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "ERS Guidelines for Diagnosis of Primary Ciliary Dyskinesia",
    "criteria": [
      {
        "id": "chronic-respiratory-infections",
        "description": "Persistent or recurrent upper and lower respiratory tract infections since early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "situs-inversus",
        "description": "Presence of situs inversus or other laterality defects",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "abnormal-ciliary-function",
        "description": "Abnormal ciliary ultrastructure or function demonstrated by electron microscopy or high-speed video microscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-nasal-nitric-oxide",
        "description": "Low nasal nitric oxide levels",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in known PCD-associated genes",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of chronic respiratory symptoms plus either abnormal ciliary function or biallelic pathogenic variants in PCD genes",
    "notes": "Diagnosis often requires a combination of clinical, functional, and genetic testing due to phenotypic variability."
  },
  "symptoms": {
