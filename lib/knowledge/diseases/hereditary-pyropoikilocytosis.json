    "laboratory": [
      "Peripheral blood smear showing marked poikilocytosis, microspherocytes, and elliptocytes",
      "Elevated reticulocyte count",
      "Elevated indirect bilirubin",
      "Reduced haptoglobin",
      "Increased lactate dehydrogenase (LDH)"
    ],
    "imaging": [
      "Ultrasound showing splenomegaly",
      "Ultrasound evidence of gallstones"
    ],
    "genetic": [
      "Mutations in spectrin alpha or beta genes (SPTA1, SPTB)",
