  "diagnosticCriteria": {
    "formalCriteriaName": "Shprintzen-Goldberg Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Presence of craniosynostosis, typically involving multiple sutures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "marfanoid-habitus",
        "description": "Marfanoid body habitus including tall stature, arachnodactyly, and joint hypermobility",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiovascular-abnormalities",
        "description": "Presence of cardiovascular anomalies such as aortic root dilation or mitral valve prolapse",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "craniofacial-features",
        "description": "Characteristic craniofacial features including hypertelorism, downslanting palpebral fissures, and high-arched palate",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis, marfanoid habitus, and intellectual disability",
    "notes": "Genetic testing for SKI gene mutations can support diagnosis but is not mandatory."
  },
