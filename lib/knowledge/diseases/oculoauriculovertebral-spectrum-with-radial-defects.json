  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Oculoauriculovertebral Spectrum with Radial Defects",
    "criteria": [
      {
        "id": "craniofacial-malformations",
        "description": "Presence of unilateral or bilateral craniofacial anomalies including hemifacial microsomia, mandibular hypoplasia, and ear malformations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radial-defects",
        "description": "Radial ray anomalies such as hypoplasia or aplasia of the radius, thumb hypoplasia, or other preaxial upper limb defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "Ocular abnormalities including epibulbar dermoids, microphthalmia, or coloboma",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "vertebral-anomalies",
        "description": "Presence of vertebral segmentation defects or scoliosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Conductive or sensorineural hearing loss due to ear malformations",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniofacial malformations and radial defects; ocular anomalies support diagnosis",
    "notes": "Diagnosis is primarily clinical; genetic testing may assist but no single gene mutation is definitive."
  },
