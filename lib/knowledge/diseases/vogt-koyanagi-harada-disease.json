  "diagnosticCriteria": {
    "formalCriteriaName": "Revised Diagnostic Criteria for Vogt-Koyanagi-Harada Disease",
    "criteria": [
      {
        "id": "bilateral-granulomatous-uveitis",
        "description": "Bilateral granulomatous panuveitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-auditory-manifestations",
        "description": "Neurological and/or auditory symptoms such as meningismus, tinnitus, or dysacusis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "integumentary-manifestations",
        "description": "Integumentary signs including vitiligo, alopecia, or poliosis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of uveitis and systemic symptoms",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Bilateral granulomatous uveitis plus exclusion of other causes, with or without neurological/auditory or integumentary manifestations",
    "notes": "Diagnosis is clinical and supported by imaging and laboratory findings; early recognition is critical to prevent vision loss."
  },
