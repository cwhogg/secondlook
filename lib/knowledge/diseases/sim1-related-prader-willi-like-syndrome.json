  "keyFindings": {
    "laboratory": [
      "Hormonal assays showing growth hormone deficiency and hypogonadotropic hypogonadism",
      "Normal methylation pattern at 15q11-q13 region (distinguishing from classic Prader-Willi syndrome)"
    ],
    "imaging": [
      "Brain MRI typically normal or nonspecific",
      "Skeletal X-rays may show scoliosis or delayed bone age"
    ],
    "genetic": [
      "SIM1 (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Polysomnography may reveal obstructive sleep apnea",
      "Neuropsychological testing indicating mild to moderate intellectual disability"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "prader-willi-syndrome",
      "distinguishingFeatures": [
        "15q11-q13 deletion or imprinting defects",
        "Characteristic facial features",
        "More severe intellectual disability"
      ]
    },
    {
      "diseaseId": "bardet-biedl-syndrome",
      "distinguishingFeatures": [
        "Retinal dystrophy",
        "Polydactyly",
        "Renal anomalies"
      ]
    }
  ],
  "redFlags": [
    "Rapid weight gain with hyperphagia in infancy",
    "Severe neonatal hypotonia with feeding difficulties",
    "Presence of SIM1 gene mutation without 15q11-q13 abnormalities"
  ],
