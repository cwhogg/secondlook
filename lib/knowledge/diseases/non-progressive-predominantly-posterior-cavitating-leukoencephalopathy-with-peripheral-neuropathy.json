        "requiredForDiagnosis": true
      },
      {
        "id": "peripheral-neuropathy",
        "description": "Clinical and electrophysiological evidence of peripheral neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "non-progressive-course",
        "description": "Stable or non-progressive clinical course over at least 2 years",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-leukoencephalopathies",
        "description": "Exclusion of other causes of cavitating leukoencephalopathy by metabolic, infectious, and genetic testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met: characteristic MRI findings, peripheral neuropathy, and non-progressive clinical course.",
    "notes": "Genetic testing may support diagnosis but no specific causative gene identified."
