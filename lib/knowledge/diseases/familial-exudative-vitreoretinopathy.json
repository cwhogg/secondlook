  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Familial Exudative Vitreoretinopathy",
    "criteria": [
      {
        "id": "peripheral-avascularity",
        "description": "Presence of peripheral retinal avascularity on fluorescein angiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "retinal-vessel-anomalies",
        "description": "Abnormal retinal vascular development including straightening and dragging of vessels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of FEVR or related retinal vascular disorders",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "retinal-detachment",
        "description": "Presence of retinal detachment or exudative changes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in FEVR-associated genes (e.g., FZD4, LRP5, TSPAN12)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of peripheral retinal avascularity and abnormal retinal vessel development, with or without family history or genetic confirmation",
    "notes": "Diagnosis is primarily clinical supported by imaging and genetic testing when available."
  },
