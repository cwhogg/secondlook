    "formalCriteriaName": "No formal standardized criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of symmetrical, red to violaceous papules, plaques, or nodules typically on extensor surfaces",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing leukocytoclastic vasculitis with neutrophilic infiltration and fibrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-treatment",
        "description": "Improvement with dapsone or other anti-inflammatory agents",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical lesions plus confirmatory histopathology",
    "notes": "Diagnosis is primarily clinical supported by histopathology; no standardized formal criteria exist."
  },
