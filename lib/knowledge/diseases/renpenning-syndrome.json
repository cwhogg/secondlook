  "diagnosticCriteria": {
    "formalCriteriaName": "Renpenning Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Moderate to severe intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microcephaly",
        "description": "Congenital microcephaly with progressive head growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent forehead, small face, and short nose",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation with short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Generalized hypotonia in infancy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "mutation-paqbp1",
        "description": "Pathogenic variants in the PQBP1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of intellectual disability, microcephaly, characteristic facial dysmorphism, and identification of a pathogenic PQBP1 mutation",
    "notes": "Diagnosis is confirmed by genetic testing identifying PQBP1 mutations; clinical features support diagnosis."
  },
