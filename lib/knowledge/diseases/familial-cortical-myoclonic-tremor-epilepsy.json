  "differentialDiagnoses": [
    {
      "diseaseId": "essential-tremor",
      "distinguishingFeatures": [
        "Absence of epilepsy",
        "No cortical reflex myoclonus on electrophysiology",
        "Typically no family history of epilepsy"
      ]
    },
    {
      "diseaseId": "juvenile-myoclonic-epilepsy",
      "distinguishingFeatures": [
        "Earlier onset (adolescence)",
        "Myoclonus without cortical tremor",
        "Characteristic EEG pattern with 4-6 Hz polyspike and wave"
      ]
    },
    {
      "diseaseId": "progressive-myoclonic-epilepsy",
      "distinguishingFeatures": [
        "Progressive neurological deterioration",
        "Widespread myoclonus and cognitive decline",
        "Often associated with metabolic or storage disorders"
      ]
    }
  ],
