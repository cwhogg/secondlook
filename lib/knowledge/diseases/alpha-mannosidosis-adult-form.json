  "keyFindings": {
    "laboratory": [
      "Reduced alpha-mannosidase enzyme activity in leukocytes or fibroblasts",
      "Elevated mannose-rich oligosaccharides in urine"
    ],
    "imaging": [
      "Skeletal X-rays showing dysostosis multiplex",
      "Brain MRI may show cerebral and cerebellar atrophy"
    ],
    "genetic": [
      "MAN2B1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Audiometry confirming sensorineural hearing loss",
      "Corneal examination revealing clouding"
    ]
  },
