  "diagnosticCriteria": {
    "formalCriteriaName": "Localized Junctional Epidermolysis Bullosa Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of localized blistering and erosions predominantly on hands and feet without widespread skin involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Immunofluorescence showing reduced or absent expression of laminin-332 or other basement membrane zone proteins",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in LAMA3, LAMB3, or LAMC2 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing cleavage within the lamina lucida of the basement membrane zone",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of localized blistering plus either immunofluorescence mapping abnormalities or pathogenic mutations in JEB-associated genes",
    "notes": "Diagnosis requires correlation of clinical, immunopathological, and genetic findings."
  },
