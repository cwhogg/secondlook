  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Autosomal Dominant Hypophosphatemic Rickets",
    "criteria": [
      {
        "id": "hypophosphatemia",
        "description": "Persistent hypophosphatemia due to renal phosphate wasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-fgf23",
        "description": "Elevated or inappropriately normal serum fibroblast growth factor 23 (FGF23) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Clinical features of rickets or osteomalacia including bone pain and deformities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "PHEX-mutation-exclusion",
        "description": "Exclusion of mutations in PHEX gene (to differentiate from X-linked hypophosphatemic rickets)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent hypophosphatemia with renal phosphate wasting, elevated FGF23 levels, and a compatible family history of autosomal dominant inheritance",
    "notes": "Genetic testing for FGF23 mutations can confirm diagnosis; exclusion of other causes of hypophosphatemia is essential"
  },
