  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Autosomal Non-Syndromic Agammaglobulinemia",
    "criteria": [
      {
        "id": "hypogammaglobulinemia",
        "description": "Marked reduction or absence of serum immunoglobulins (IgG, IgA, IgM)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-b-cells",
        "description": "Severe reduction or absence of peripheral blood B lymphocytes (CD19+ cells)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-bacterial-infections",
        "description": "History of recurrent bacterial infections, especially respiratory tract infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with autosomal agammaglobulinemia (e.g., IGHM, BLNK, CD79A, CD79B)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypogammaglobulinemia, absent peripheral B cells, and recurrent bacterial infections",
    "notes": "Genetic testing can confirm diagnosis and help differentiate from X-linked agammaglobulinemia"
  },
