  "keyFindings": {
    "laboratory": [
      "Elevated brain natriuretic peptide (BNP) in heart failure",
      "Possible elevated troponin in myocardial injury"
    ],
    "imaging": [
      "Echocardiography showing noncompacted to compacted myocardium ratio > 2:1",
      "Color Doppler demonstrating blood flow in deep intertrabecular recesses",
      "Cardiac MRI confirming extent of trabeculations and noncompaction"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Familial inheritance patterns observed in some cases",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electrocardiogram abnormalities including ventricular arrhythmias and conduction delays",
      "Holter monitoring for arrhythmia detection"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dilated-cardiomyopathy",
      "distinguishingFeatures": [
        "Absence of prominent trabeculations",
        "Diffuse ventricular dilation with systolic dysfunction",
        "No deep intertrabecular recesses with blood flow"
      ]
    },
    {
      "diseaseId": "hypertrophic-cardiomyopathy",
      "distinguishingFeatures": [
        "Asymmetric septal hypertrophy",
        "No deep intertrabecular recesses",
        "Different genetic mutations"
      ]
    },
    {
      "diseaseId": "endocardial-cardiomyopathy",
      "distinguishingFeatures": [
        "Fibrosis and thickening of endocardium",
        "No prominent trabeculations",
        "Different clinical presentation"
      ]
    }
  ],
