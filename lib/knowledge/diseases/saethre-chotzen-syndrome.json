  "diagnosticCriteria": {
    "formalCriteriaName": "Saethre-Chotzen syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of coronal sutures leading to abnormal skull shape",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including ptosis, low-set ears, and facial asymmetry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-anomalies",
        "description": "Syndactyly or brachydactyly of fingers and toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic TWIST1 gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis plus at least two of the following: characteristic facial dysmorphism, limb anomalies, or confirmed TWIST1 mutation",
    "notes": "Genetic testing for TWIST1 mutations is strongly recommended to confirm diagnosis."
  },
