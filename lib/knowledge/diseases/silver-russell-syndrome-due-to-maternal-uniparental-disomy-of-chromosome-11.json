  "diagnosticCriteria": {
    "formalCriteriaName": "Netchine-Harbison Clinical Scoring System (NH-CSS) adapted for matUPD11",
    "criteria": [
      {
        "id": "prenatal-growth-retardation",
        "description": "Intrauterine growth retardation with birth weight and/or length ≤ -2 SD",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "postnatal-growth-retardation",
        "description": "Postnatal growth failure with height ≤ -2 SD at 24 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "relative-macrocephaly",
        "description": "Head circumference at birth ≥ 1.5 SD above birth weight and/or length SD scores",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "body-hemihypoplasia",
        "description": "Asymmetry of limbs or body segments",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "feeding-difficulties",
        "description": "Early feeding difficulties and/or low BMI ≤ -2 SD at 24 months",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "maternal-uniparental-disomy-11",
        "description": "Molecular confirmation of maternal uniparental disomy of chromosome 11",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of prenatal and postnatal growth retardation plus molecular confirmation of maternal uniparental disomy of chromosome 11",
    "notes": "Diagnosis relies heavily on molecular genetic testing due to phenotypic overlap with other SRS etiologies."
  },
