  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Laboratory Diagnostic Criteria for Meningococcal Meningitis",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Acute onset of fever, headache, neck stiffness, and altered mental status",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "csf-analysis",
        "description": "Cerebrospinal fluid (CSF) analysis showing neutrophilic pleocytosis, elevated protein, and decreased glucose",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microbiological-confirmation",
        "description": "Isolation of Neisseria meningitidis from CSF or blood culture or positive PCR for meningococcal DNA",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "meningococcal-rash",
        "description": "Presence of petechial or purpuric rash",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus CSF analysis consistent with bacterial meningitis and microbiological confirmation of Neisseria meningitidis",
    "notes": "Early lumbar puncture is critical for diagnosis unless contraindicated."
  },
