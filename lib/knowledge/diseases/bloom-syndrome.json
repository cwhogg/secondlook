    "ethnicAssociations": [
      "Ashkenazi Jewish population"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Bloom Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "chromosomal-instability",
        "description": "Increased sister chromatid exchanges and chromosomal breaks on cytogenetic analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-deficiency",
        "description": "Pre- and postnatal growth retardation with short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "photosensitivity",
        "description": "Marked photosensitivity with erythematous facial rash and telangiectasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cancer-predisposition",
        "description": "Early onset of various malignancies including leukemias and carcinomas",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the BLM gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of chromosomal instability, growth deficiency, photosensitivity, and biallelic BLM gene mutations",
    "notes": "Diagnosis is confirmed by cytogenetic testing and genetic analysis of BLM gene"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Increased sister chromatid exchanges",
        "frequency": 0.95,
        "bodySystem": "hematological",
        "notes": "Detected by cytogenetic analysis"
      },
      {
        "symptomName": "Photosensitive erythematous facial rash with telangiectasia",
        "frequency": 0.85,
        "bodySystem": "dermatological",
        "notes": "Typically involves malar area and nose"
      },
      {
        "symptomName": "Severe pre- and postnatal growth deficiency",
        "frequency": 0.9,
        "bodySystem": "constitutional",
        "notes": "Short stature below 3rd percentile"
      }
    ],
    "common": [
      {
        "symptomName": "Immunodeficiency with recurrent infections",
        "frequency": 0.75,
        "bodySystem": "immunological",
        "notes": "Predisposes to respiratory and gastrointestinal infections"
      },
      {
        "symptomName": "Hypogonadism",
        "frequency": 0.6,
        "bodySystem": "endocrine",
        "notes": "More common in males"
      },
      {
        "symptomName": "Sun-induced photosensitivity with blistering",
        "frequency": 0.65,
        "bodySystem": "dermatological",
        "notes": "Exacerbated by UV exposure"
      },
      {
        "symptomName": "Early onset malignancies",
        "frequency": 0.7,
        "bodySystem": "hematological",
        "notes": "Leukemia, lymphoma, and carcinomas"
      },
      {
        "symptomName": "Facial telangiectasia",
        "frequency": 0.7,
        "bodySystem": "dermatological",
        "notes": "Dilated superficial blood vessels"
      }
    ],
    "occasional": [
      {
        "symptomName": "Microcephaly",
        "frequency": 0.3,
        "bodySystem": "neurological",
        "notes": "Head circumference below normal"
      },
      {
        "symptomName": "Chronic lung disease",
        "frequency": 0.25,
        "bodySystem": "respiratory",
        "notes": "Due to recurrent infections"
      },
      {
        "symptomName": "Gastrointestinal disturbances",
        "frequency": 0.4,
        "bodySystem": "gastrointestinal",
        "notes": "Including malabsorption and diarrhea"
      },
      {
        "symptomName": "Diabetes mellitus",
        "frequency": 0.15,
        "bodySystem": "endocrine",
        "notes": "Secondary to pancreatic insufficiency"
      },
      {
        "symptomName": "Ocular abnormalities such as cataracts",
        "frequency": 0.2,
        "bodySystem": "ophthalmological",
        "notes": "May develop in adolescence"
      }
    ],
    "rare": [
      {
        "symptomName": "Neurological deficits including developmental delay",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Not typical but reported"
      },
      {
        "symptomName": "Congenital heart defects",
        "frequency": 0.03,
        "bodySystem": "cardiovascular",
        "notes": "Rarely observed"
      },
      {
        "symptomName": "Renal abnormalities",
        "frequency": 0.02,
        "bodySystem": "renal",
        "notes": "Including structural anomalies"
      }
    ]
  },
