  "diagnosticCriteria": {
    "formalCriteriaName": "FRAXE Intellectual Disability Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-testing",
        "description": "Detection of CGG trinucleotide repeat expansion in the FMR2 (AFF2) gene promoter region",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Presence of intellectual disability ranging from mild to moderate severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-features",
        "description": "Behavioral abnormalities including social anxiety and autistic-like features",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of FMR2 gene CGG repeat expansion plus clinical evidence of intellectual disability",
    "notes": "Diagnosis relies primarily on molecular genetic testing; clinical features support but are not definitive alone."
  },
