  "keyFindings": {
    "laboratory": [
      "Elevated serum chromogranin A and neuron-specific enolase",
      "Mild elevation of liver function tests (ALT, AST, ALP, bilirubin)",
      "Possible elevated serotonin metabolites (5-HIAA) in urine if functional"
    ],
    "imaging": [
      "Contrast-enhanced CT or MRI showing hypervascular hepatic mass",
      "Somatostatin receptor scintigraphy (Octreoscan) positive uptake in liver lesion",
      "PET scan may show increased uptake depending on tumor grade"
    ],
    "genetic": [
      "No specific germline mutations identified; molecular profiling may reveal neuroendocrine carcinoma-associated mutations"
    ],
    "other": [
      "Histopathology demonstrating neuroendocrine morphology with mitotic figures and necrosis",
      "Immunohistochemistry positive for chromogranin A, synaptophysin, CD56"
    ]
  },
