  "keyFindings": {
    "laboratory": [
      "Pancytopenia on complete blood count",
      "Shortened telomere length by flow-FISH or qPCR",
      "Elevated fetal hemoglobin in some cases"
    ],
    "imaging": [
      "Chest CT showing pulmonary fibrosis",
      "Bone marrow biopsy showing hypocellularity"
    ],
    "genetic": [
      "Pathogenic variants in DKC1, TERC, TERT, TINF2, and other telomere maintenance genes"
    ],
    "other": [
      "Abnormal skin biopsy showing epidermal atrophy and pigment incontinence"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "fanconi-anemia",
      "distinguishingFeatures": [
        "Chromosomal breakage on diepoxybutane testing",
        "Absent mucocutaneous triad",
        "Different genetic mutations (FANCA, FANCC, etc.)"
      ]
    },
    {
      "diseaseId": "aplastic-anemia",
      "distinguishingFeatures": [
        "Lack of mucocutaneous features",
        "Usually acquired rather than inherited",
        "No telomere shortening"
      ]
    },
    {
      "diseaseId": "poikiloderma-congenitale",
      "distinguishingFeatures": [
        "Poikiloderma with photosensitivity",
        "Mutations in the RECQL4 gene",
        "Absence of bone marrow failure"
      ]
    }
  ],
