  "diagnosticCriteria": {
    "formalCriteriaName": "AASLD Guidelines for Diagnosis of PSC",
    "criteria": [
      {
        "id": "psc-1",
        "description": "Cholestatic biochemistry (elevated ALP, GGT) for >6 months",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "psc-2",
        "description": "Characteristic cholangiographic findings: multifocal strictures and segmental dilatations of intrahepatic and/or extrahepatic bile ducts (beaded appearance) on MRCP or ERCP",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "psc-3",
        "description": "Liver biopsy showing periductal (onion-skin) fibrosis (in small duct PSC or when cholangiography is normal)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "psc-4",
        "description": "Exclusion of secondary causes of sclerosing cholangitis (IgG4-related, ischemic, infectious)",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Cholestatic biochemistry plus characteristic cholangiographic findings, after exclusion of secondary causes",
    "notes": "Small duct PSC has normal cholangiography and is diagnosed by liver biopsy. Up to 80% of PSC patients have concurrent IBD (usually ulcerative colitis)."
  },
