    "laboratory": [
      "Presence of ringed sideroblasts on bone marrow iron stain",
      "Elevated serum ferritin and transferrin saturation",
      "Macrocytic or normocytic anemia with variable reticulocyte count",
      "Basophilic stippling on peripheral blood smear"
    ],
    "imaging": [
      "Hepatosplenomegaly on abdominal ultrasound (occasionally)"
    ],
    "genetic": [
      "TET2 (somatic)",
      "SF3B1 (somatic)"
    ],
    "other": [
      "Bone marrow biopsy showing erythroid hyperplasia with ringed sideroblasts",
      "Exclusion of secondary causes such as alcohol, drugs, toxins"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-sideroblastic-anemia",
      "distinguishingFeatures": [
        "Onset in childhood or early adulthood",
        "Known genetic mutations (e.g. ALAS2)",
        "Family history positive"
      ]
    },
    {
      "diseaseId": "myelodysplastic-syndrome-with-ringed-sideroblasts",
      "distinguishingFeatures": [
        "Presence of clonal cytogenetic abnormalities",
        "Dysplastic changes in multiple hematopoietic lineages",
        "Older age group with progressive cytopenias"
      ]
    },
    {
      "diseaseId": "secondary-sideroblastic-anemia",
      "distinguishingFeatures": [
        "History of exposure to alcohol, drugs (e.g. isoniazid), toxins",
        "Reversible upon removal of offending agent",
        "Absence of idiopathic features"
      ]
    }
  ],
