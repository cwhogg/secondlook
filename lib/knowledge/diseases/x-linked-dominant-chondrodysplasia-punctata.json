  "diagnosticCriteria": {
    "formalCriteriaName": "Conradi-Hünermann Diagnostic Criteria",
    "criteria": [
      {
        "id": "punctate-calcifications",
        "description": "Presence of punctate calcifications in epiphyseal cartilage on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ichthyosiform-erythroderma",
        "description": "Ichthyosiform erythroderma with Blaschkoid distribution",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cataracts",
        "description": "Congenital or early-onset cataracts",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "short-limbed-dwarfism",
        "description": "Short-limbed dwarfism with asymmetric limb shortening",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in EBP gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of punctate epiphyseal calcifications plus ichthyosiform erythroderma or pathogenic EBP mutation",
    "notes": "Diagnosis is supported by clinical, radiological, and genetic findings; male lethality in utero is common."
