        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other known causes of early-onset epilepsy and intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: early-onset epilepsy, intellectual disability, and brain anomalies on imaging",
    "notes": "Genetic testing can support diagnosis but is not mandatory; clinical and imaging findings are essential."
