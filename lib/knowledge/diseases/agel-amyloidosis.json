  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for AGel Amyloidosis",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in the GSN gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "amyloid-deposits",
        "description": "Histological demonstration of amyloid deposits with Congo red staining",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features including corneal lattice dystrophy and cranial neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic GSN mutation plus histological confirmation of amyloid deposits and characteristic clinical features",
    "notes": "Genetic testing is essential for definitive diagnosis; biopsy may be performed on affected tissues such as skin or nerve."
  },
