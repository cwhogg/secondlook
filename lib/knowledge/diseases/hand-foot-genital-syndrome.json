      {
        "id": "limb-malformations",
        "description": "Presence of characteristic limb malformations including short thumbs and hallux valgus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genitourinary-anomalies",
        "description": "Congenital genitourinary anomalies such as hypospadias in males or uterine abnormalities in females",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic limb malformations and genitourinary anomalies",
    "notes": "Genetic testing for HOXA13 mutations can confirm diagnosis"
