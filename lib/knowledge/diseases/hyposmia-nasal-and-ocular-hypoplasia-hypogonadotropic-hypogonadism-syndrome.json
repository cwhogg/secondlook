  "keyFindings": {
    "laboratory": [
      "Low serum gonadotropins (LH, FSH)",
      "Low sex steroid levels (testosterone or estradiol)"
    ],
    "imaging": [
      "MRI showing hypoplastic or absent olfactory bulbs",
      "Radiological evidence of nasal and ocular hypoplasia"
    ],
    "genetic": [
      "SMCHD1 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Clinical examination revealing midfacial hypoplasia and micropenis or cryptorchidism"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "kallmann-syndrome",
      "distinguishingFeatures": [
        "Kallmann syndrome presents with hypogonadotropic hypogonadism and anosmia but lacks nasal and ocular hypoplasia",
        "Usually no ocular structural abnormalities"
      ]
    },
    {
      "diseaseId": "septo-optic-dysplasia",
      "distinguishingFeatures": [
        "Septo-optic dysplasia includes optic nerve hypoplasia and pituitary hormone deficiencies but typically lacks nasal hypoplasia and hyposmia",
        "May have midline brain abnormalities"
      ]
    }
  ],
