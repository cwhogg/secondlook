  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "CSF analysis typically unremarkable"
    ],
    "imaging": [
      "MRI brain may show generalized cerebral and cerebellar atrophy",
      "Basal ganglia hypointensity on T2-weighted MRI"
    ],
    "genetic": [
      "ATP13A2 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Reduced dopamine transporter uptake on DaTscan"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "juvenile-parkinsonism-parkin-type",
      "distinguishingFeatures": [
        "Absence of pyramidal signs",
        "Mutations in PARK2 gene",
        "Better levodopa responsiveness"
      ]
    },
    {
      "diseaseId": "neurodegeneration-with-brain-iron-accumulation",
      "distinguishingFeatures": [
        "Iron accumulation visible on MRI (eye of the tiger sign)",
        "Different genetic mutations (e.g., PANK2)",
        "Prominent dystonia and spasticity"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of parkinsonism with pyramidal signs in adolescence",
    "Poor or fluctuating response to levodopa therapy",
    "Presence of vertical supranuclear gaze palsy"
  ],
