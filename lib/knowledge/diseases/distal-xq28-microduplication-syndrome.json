  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for Distal Xq28 Microduplication Syndrome",
    "criteria": [
      {
        "id": "molecular-confirmation",
        "description": "Detection of microduplication involving the distal Xq28 region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Presence of moderate to severe intellectual disability or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Congenital hypotonia observed in infancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "dysmorphic-features",
        "description": "Characteristic facial dysmorphisms including prominent forehead, broad nasal bridge, and micrognathia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "Recurrent seizures or epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of distal Xq28 microduplication plus presence of intellectual disability or developmental delay",
    "notes": "Diagnosis relies primarily on molecular genetic testing supported by clinical features."
  },
