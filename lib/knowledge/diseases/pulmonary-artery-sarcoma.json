  "keyFindings": {
    "laboratory": [
      "Non-specific elevation of inflammatory markers (ESR, CRP)",
      "Possible mild anemia"
    ],
    "imaging": [
      "CT pulmonary angiography showing intraluminal filling defect with mass characteristics",
      "MRI demonstrating heterogeneous mass with contrast enhancement in pulmonary artery",
      "PET-CT showing increased metabolic activity in pulmonary artery lesion"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology showing spindle cell sarcoma with immunohistochemical staining positive for vimentin and variable expression of smooth muscle actin"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pulmonary-embolism",
      "distinguishingFeatures": [
        "Acute onset symptoms",
        "Improvement with anticoagulation",
        "Absence of mass lesion on imaging"
      ]
    },
    {
      "diseaseId": "pulmonary-hypertension",
      "distinguishingFeatures": [
        "No intraluminal mass on imaging",
        "Chronic progressive dyspnea without mass",
        "Different hemodynamic profile on right heart catheterization"
      ]
    },
    {
      "diseaseId": "pulmonary-artery-thrombosis",
      "distinguishingFeatures": [
        "Thrombus rather than tumor on imaging",
        "Responds to anticoagulation",
        "No histopathological sarcoma features"
      ]
    }
  ],
  "redFlags": [
    "Persistent pulmonary artery filling defect despite anticoagulation",
    "Rapid progression of symptoms mimicking pulmonary embolism",
    "Evidence of intraluminal mass on advanced imaging"
  ],
  "specialistType": [
