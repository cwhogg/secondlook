  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological and Radiological Diagnostic Criteria for Ovarian Fibrothecoma",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histological identification of spindle-shaped fibroblastic cells with varying amounts of theca cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Ultrasound or MRI showing a solid, well-circumscribed ovarian mass with low to intermediate signal intensity on T2-weighted images",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presentation with pelvic mass and/or hormonal manifestations such as estrogenic effects",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation plus supportive imaging findings; clinical presentation supports diagnosis",
    "notes": "Definitive diagnosis requires histopathological examination post-surgical excision."
  },
