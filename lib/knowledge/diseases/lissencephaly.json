  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Genetic testing identifying mutations in LIS1, DCX, or other neuronal migration genes"
    ],
    "imaging": [
      "MRI showing agyria or pachygyria with thickened cortex and smooth brain surface",
      "Reduced or absent sulcation on brain imaging"
    ],
    "genetic": [
      "Pathogenic variants in LIS1 (PAFAH1B1), DCX, TUBA1A, or other related genes"
    ],
    "other": [
      "Electroencephalogram (EEG) showing epileptiform activity consistent with infantile spasms"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "polymicrogyria",
      "distinguishingFeatures": [
        "Excessive small gyri rather than absent gyri",
        "Irregular cortical surface on MRI"
      ]
    },
    {
      "diseaseId": "cobblestone-malformation",
      "distinguishingFeatures": [
        "Irregular, pebbled brain surface",
        "Associated with congenital muscular dystrophies"
      ]
    },
    {
      "diseaseId": "hydranencephaly",
      "distinguishingFeatures": [
        "Near complete absence of cerebral hemispheres replaced by CSF",
        "No cortical thickening or neuronal migration defect"
      ]
    }
  ],
