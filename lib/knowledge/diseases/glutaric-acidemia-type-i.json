      "Increased plasma glutarylcarnitine (C5DC)",
      "Reduced glutaryl-CoA dehydrogenase enzyme activity"
    ],
    "imaging": [
      "MRI showing frontotemporal atrophy",
      "Basal ganglia (caudate and putamen) signal abnormalities",
      "Subdural hematomas or hygromas in some cases"
    ],
    "genetic": [
      "Pathogenic variants in GCDH gene (autosomal recessive inheritance)"
    ],
    "other": [
      "Macrocephaly on physical examination",
      "Acute dystonic crises triggered by metabolic stress"
    ]
  },
