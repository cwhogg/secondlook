  "diagnosticCriteria": {
    "formalCriteriaName": "Charlie M Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including midface hypoplasia and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-cardiac-anomalies",
        "description": "Documented congenital cardiac defects such as ventricular septal defect or atrial septal defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Presence of skeletal abnormalities including clinodactyly or scoliosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variant in the CMS1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Diagnosis requires all three major criteria: craniofacial dysmorphism, congenital cardiac anomalies, and developmental delay.",
    "notes": "Genetic testing can support diagnosis but is not mandatory."
  },
