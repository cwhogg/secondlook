        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-progressive-conditions",
        "description": "Exclusion of progressive neurodegenerative or metabolic disorders by clinical, imaging, and laboratory evaluation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
