  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Genetic testing identifying mutations in SOX2 or related genes"
    ],
    "imaging": [
      "Orbital ultrasound or MRI showing microphthalmia",
      "Radiographs demonstrating limb bone hypoplasia or aplasia",
      "Echocardiogram for cardiac anomalies"
    ],
    "genetic": [
      "SMOC1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Prenatal ultrasound may detect microphthalmia and limb defects",
      "Ophthalmological examination critical for diagnosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "anophthalmia-microphthalmia-syndrome",
      "distinguishingFeatures": [
        "Complete absence of one or both eyes (anophthalmia) rather than small eyes",
        "May lack limb anomalies"
      ]
    },
    {
      "diseaseId": "trisomy-13-patau-syndrome",
      "distinguishingFeatures": [
        "Multiple midline defects including cleft lip/palate",
        "Severe neurological impairment and characteristic facial features",
        "Chromosomal abnormalities detected by karyotyping"
      ]
    }
  ],
  "redFlags": [
    "Severe bilateral microphthalmia with no light perception",
    "Presence of multiple congenital limb aplasias",
    "Associated cardiac or renal malformations indicating multisystem involvement"
  ],
