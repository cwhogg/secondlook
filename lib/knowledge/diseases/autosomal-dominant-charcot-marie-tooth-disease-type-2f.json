  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for CMT2F",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Progressive distal muscle weakness and atrophy predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies showing axonal neuropathy with normal or mildly reduced conduction velocities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic heterozygous mutations in the HSPB1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing neurogenic atrophy (if performed)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical neuropathy, supportive electrophysiological findings, and pathogenic HSPB1 mutation",
    "notes": "Genetic confirmation is essential for definitive diagnosis; electrophysiological studies help differentiate from demyelinating forms."
  },
