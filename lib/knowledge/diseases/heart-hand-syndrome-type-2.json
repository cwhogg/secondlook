  "diagnosticCriteria": {
    "formalCriteriaName": "Holt-Oram syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "congenital-cardiac-anomaly",
        "description": "Presence of congenital cardiac malformations, especially atrial septal defects or ventricular septal defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "upper-limb-malformations",
        "description": "Radial ray abnormalities including hypoplasia or aplasia of the thumb, triphalangeal thumb, or phocomelia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of heart-hand syndrome or related cardiac and limb anomalies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital cardiac malformation plus upper limb malformations, with or without family history",
    "notes": "Genetic testing for TBX5 mutations can support diagnosis but is not mandatory."
  },
