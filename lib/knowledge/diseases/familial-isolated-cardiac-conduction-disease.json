  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Isolated Cardiac Conduction Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "progressive-conduction-block",
        "description": "Progressive atrioventricular or intraventricular conduction block documented on ECG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-structural-heart-disease",
        "description": "No evidence of structural heart disease on echocardiography or cardiac MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of isolated cardiac conduction disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variant in known associated genes (e.g., SCN5A, LMNA)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-secondary-causes",
        "description": "Exclusion of secondary causes of conduction disease such as ischemia, myocarditis, or infiltrative cardiomyopathies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive conduction block with absence of structural heart disease and positive family history",
    "notes": "Genetic testing can support diagnosis but is not mandatory."
  },
