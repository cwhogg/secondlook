        "Absence of mitochondrial DNA depletion"
      ]
    },
    {
      "diseaseId": "spinal-muscular-atrophy",
      "distinguishingFeatures": [
        "Lower motor neuron degeneration",
        "SMN1 gene mutations without mitochondrial DNA depletion"
      ]
    },
