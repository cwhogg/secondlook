  "keyFindings": {
    "laboratory": [
      "Hexagonal cystine crystals on urine microscopy",
      "Elevated urinary cystine concentration (>250 mg/L)",
      "Positive cyanide-nitroprusside test"
    ],
    "imaging": [
      "Radiopaque kidney stones on abdominal X-ray or CT scan",
      "Hydronephrosis on ultrasound if obstruction present"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Stone analysis confirming cystine composition"
    ]
  },
  "differentialDiagnoses": [
    {
