  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase and aldolase",
      "Positive myositis-specific autoantibodies (anti-RNP, anti-Jo-1, anti-PL-7, anti-PL-12)",
      "Elevated inflammatory markers (ESR, CRP)"
    ],
    "imaging": [
      "MRI of muscles showing edema and inflammation",
      "High-resolution CT chest demonstrating interstitial lung disease"
    ],
    "genetic": [],
    "other": [
      "Muscle biopsy showing inflammatory infiltrates with features overlapping polymyositis and connective tissue disease",
      "Electromyography showing myopathic changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "polymyositis",
      "distinguishingFeatures": [
        "Lack of overlapping connective tissue disease features",
        "Absence of specific autoantibodies such as anti-RNP"
      ]
    },
    {
      "diseaseId": "dermatomyositis",
      "distinguishingFeatures": [
        "Presence of characteristic skin rash (heliotrope rash, Gottron papules)",
        "Distinct muscle biopsy findings with perifascicular atrophy"
      ]
    },
    {
      "diseaseId": "mixed-connective-tissue-disease",
      "distinguishingFeatures": [
        "Dominant features of systemic sclerosis, lupus, or polymyositis with high anti-RNP titers",
        "Overlap myositis may be considered a subset but requires muscle biopsy confirmation"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive muscle weakness with respiratory compromise",
    "Development of interstitial lung disease with hypoxia",
    "Cardiac arrhythmias or conduction blocks"
  ],
