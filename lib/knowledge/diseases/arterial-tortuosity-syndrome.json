  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific biochemical markers"
    ],
    "imaging": [
      "CT angiography or MR angiography showing arterial tortuosity, elongation, stenosis, and aneurysms",
      "Echocardiography may reveal valvular abnormalities"
    ],
    "genetic": [
      "SLC2A10 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy may show abnormalities in elastic fibers",
      "Joint hypermobility assessment using Beighton score"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "loeys-dietz-syndrome",
      "distinguishingFeatures": [
        "Presence of hypertelorism and bifid uvula",
        "Mutations in TGFBR1/2 genes",
        "More aggressive vascular phenotype with early aneurysm rupture"
      ]
    },
    {
      "diseaseId": "marfan-syndrome",
      "distinguishingFeatures": [
        "FBN1 gene mutations",
        "Ectopia lentis and tall stature",
        "Aortic root dilation without marked arterial tortuosity"
      ]
    },
    {
      "diseaseId": "ehlers-danlos-syndrome-classical-type",
      "distinguishingFeatures": [
        "COL5A1/2 mutations",
        "Skin fragility and atrophic scarring",
        "Joint hypermobility without arterial tortuosity"
      ]
    }
  ],
  "redFlags": [
    "Sudden onset chest or back pain suggestive of arterial dissection",
    "Neurological deficits indicating cerebral ischemia",
    "Progressive arterial aneurysm enlargement on imaging"
  ],
  "specialistType": [
    "Clinical geneticist",
