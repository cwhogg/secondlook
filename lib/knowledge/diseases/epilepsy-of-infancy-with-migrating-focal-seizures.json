  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus criteria for Epilepsy of Infancy with Migrating Focal Seizures",
    "criteria": [
      {
        "id": "clinical-seizure-pattern",
        "description": "Onset of focal seizures in infancy with migrating seizure foci involving multiple cortical regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroencephalographic-findings",
        "description": "EEG demonstrating multifocal epileptiform discharges with shifting seizure onset zones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-regression",
        "description": "Progressive developmental delay or regression following seizure onset",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes such as KCNT1 or PLCB1",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic migrating focal seizures in infancy confirmed by EEG with exclusion of other causes",
    "notes": "Genetic testing can support diagnosis but is not mandatory; clinical and EEG findings are essential."
  },
