  "keyFindings": {
    "laboratory": [
      "Antiphospholipid antibodies positive in ~40-50% (anticardiolipin, lupus anticoagulant, anti-beta2GP1)",
      "ANA may be weakly positive",
      "Complement levels may be low",
      "Routine coagulation studies typically normal",
      "Elevated lipoprotein(a) in some patients"
    ],
    "imaging": [
      "MRI brain: multiple infarcts (often subcortical white matter and periventricular, medium vessel territory)",
      "MRA/CTA: stenosis or occlusion of medium-sized intracranial arteries",
      "Echocardiography: Libman-Sacks-like valve vegetations in ~30%",
      "Renal artery Doppler: may show stenosis"
    ],
    "genetic": [
      "ADA2 (causative, loss-of-function)",
      "Rare familial autosomal dominant pattern described"
    ],
    "other": [
      "Skin biopsy (deep punch or wedge): endothelial proliferation and thrombosis of medium-sized arteries in deep dermis/subcutis",
      "Conventional angiography: beading/occlusion of medium cerebral arteries",
      "Transcranial Doppler: may show stenosis of intracranial vessels"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "antiphospholipid-syndrome",
      "distinguishingFeatures": [
        "APS requires persistently positive aPL antibodies (by definition)",
        "APS may have venous thrombosis (DVT/PE) in addition to arterial",
        "~40-50% of Sneddon patients have aPL, representing overlap"
      ]
    },
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "SLE has positive ANA, anti-dsDNA, multisystem involvement",
        "SLE may have nephritis, serositis, malar rash"
      ]
    },
    {
      "diseaseId": "susac-syndrome",
      "distinguishingFeatures": [
        "Susac has BRAO and hearing loss as part of clinical triad",
        "Susac has central corpus callosum lesions on MRI",
        "Susac lacks livedo racemosa"
      ]
    },
    {
      "diseaseId": "polyarteritis-nodosa",
      "distinguishingFeatures": [
        "PAN has systemic vasculitis with necrotizing inflammation",
        "PAN affects medium arteries with microaneurysms",
        "PAN has elevated inflammatory markers"
      ]
    }
  ],
  "redFlags": [
    "Acute stroke in young patient with livedo racemosa (do not dismiss as benign livedo reticularis)",
    "Progressive cognitive decline suggesting multi-infarct dementia",
    "Cardiac valve disease with embolic risk",
    "New-onset hypertension in young patient (consider renal artery involvement)",
    "Recurrent strokes despite anticoagulation"
  ],
