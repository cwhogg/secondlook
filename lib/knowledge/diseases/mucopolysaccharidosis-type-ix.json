        "bodySystem": "neurological",
        "notes": "Due to joint limitations"
      },
      {
        "symptomName": "Normal intelligence",
        "frequency": 0.55,
        "bodySystem": "neurological",
        "notes": "Cognitive function typically preserved"
      }
