  "diagnosticCriteria": {
    "formalCriteriaName": "Lipoamide Dehydrogenase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced or absent lipoamide dehydrogenase enzyme activity in fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the DLD gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of lactic acidosis with neurological symptoms such as developmental delay or hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-markers",
        "description": "Elevated blood and CSF lactate and pyruvate levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-findings",
        "description": "Brain MRI showing basal ganglia abnormalities or cerebral atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced enzyme activity or pathogenic DLD variants plus compatible clinical features",
    "notes": "Diagnosis may be supported by biochemical and imaging findings but requires enzymatic or genetic confirmation."
  },
