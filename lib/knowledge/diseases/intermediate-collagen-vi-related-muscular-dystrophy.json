  "diagnosticCriteria": {
    "formalCriteriaName": "Collagen VI-Related Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness with distal joint hyperlaxity and contractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing reduced or absent collagen VI immunostaining",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in COL6A1, COL6A2, or COL6A3 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "respiratory-assessment",
        "description": "Evidence of restrictive respiratory insufficiency on pulmonary function tests",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history consistent with autosomal dominant or recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal muscle weakness with distal joint hyperlaxity and contractures, plus either muscle biopsy showing collagen VI deficiency or pathogenic COL6 gene variants",
    "notes": "Diagnosis is supported by clinical, histological, and genetic findings; respiratory involvement may develop over time."
  },
