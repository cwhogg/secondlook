  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild hypothyroidism on thyroid function tests"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter abnormalities",
      "Echocardiogram to identify congenital heart defects"
    ],
    "genetic": [
      "Microdeletion at chromosome 20q13.33 detected by chromosomal microarray or FISH"
    ],
    "other": [
      "Neurodevelopmental assessment confirming developmental delay",
      "Dysmorphology evaluation identifying characteristic facial features"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "22q11-deletion-syndrome",
      "distinguishingFeatures": [
        "Cardiac defects more common and specific (e.g. interrupted aortic arch)",
        "Palatal abnormalities and immunodeficiency",
        "Distinct facial features different from 20q13.33 microdeletion"
      ]
    },
    {
      "diseaseId": "1p36-deletion-syndrome",
      "distinguishingFeatures": [
        "More severe intellectual disability",
        "Characteristic seizures and hypotonia",
        "Distinct craniofacial features including straight eyebrows and deep-set eyes"
      ]
    }
  ],
