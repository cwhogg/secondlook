  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Freeman-Sheldon Syndrome",
    "criteria": [
      {
        "id": "whistling-face",
        "description": "Characteristic 'whistling face' appearance due to microstomia and puckered lips",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "camptodactyly",
        "description": "Camptodactyly with ulnar deviation of fingers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clubfeet",
        "description": "Bilateral talipes equinovarus (clubfeet)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-features",
        "description": "Characteristic facial features including H-shaped chin dimpling and prominent nasolabial folds",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-contractures",
        "description": "Multiple congenital contractures affecting limbs",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of the whistling face appearance plus at least two major criteria including camptodactyly and clubfeet",
    "notes": "Genetic testing for MYH3 mutations can support diagnosis but is not mandatory"
  },
