  "diagnosticCriteria": {
    "formalCriteriaName": "Caudal Appendage-Deafness Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "caudal-appendage",
        "description": "Presence of a true caudal appendage (tail-like protrusion) in the sacrococcygeal region",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-deafness",
        "description": "Bilateral sensorineural hearing loss confirmed by audiometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vertebral-anomalies",
        "description": "Congenital vertebral anomalies such as sacral agenesis or hemivertebrae on imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cutaneous-markers",
        "description": "Cutaneous abnormalities over the lower back such as hypertrichosis or skin dimples",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (caudal appendage and bilateral sensorineural deafness) with or without minor/supportive criteria",
    "notes": "Diagnosis is clinical and supported by imaging and audiological studies."
  },
