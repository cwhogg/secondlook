  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for Saul-Wilson Syndrome",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Congenital microcephaly with progressive growth failure of the head circumference",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-dysplasia",
        "description": "Severe osteodysplasia characterized by short stature, metaphyseal abnormalities, and delayed bone age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pathogenic-CPC1-variant",
        "description": "Identification of heterozygous pathogenic variant in the COG4 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent forehead, deep-set eyes, and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Severe postnatal growth retardation with short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital microcephaly, osteodysplastic skeletal abnormalities, and a pathogenic COG4 gene variant",
    "notes": "Molecular confirmation via genetic testing is essential for definitive diagnosis."
  },
