  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for 22q11.2 Deletion Syndrome",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of 22q11.2 deletion or mutation confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-anomaly",
        "description": "Congenital heart defect, especially conotruncal anomalies (e.g., tetralogy of Fallot, interrupted aortic arch)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "immune-deficiency",
        "description": "Hypoplasia or aplasia of the thymus leading to T-cell immunodeficiency",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "craniofacial-features",
        "description": "Characteristic facial features including cleft palate, hooded eyelids, and bulbous nasal tip",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypocalcemia",
        "description": "Hypoparathyroidism causing hypocalcemia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 22q11.2 deletion or mutation plus at least one major clinical feature",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical features vary widely."
  },
