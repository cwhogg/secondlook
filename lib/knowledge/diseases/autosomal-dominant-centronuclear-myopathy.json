  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Autosomal Dominant Centronuclear Myopathy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive muscle weakness predominantly affecting proximal muscles with onset in childhood to early adulthood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Muscle biopsy showing centrally located nuclei in a majority of muscle fibers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with autosomal dominant CNM (e.g., DNM2 gene mutations)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Electromyographic evidence of myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal muscle weakness with muscle biopsy showing central nuclei and confirmation of pathogenic mutation in a relevant gene",
    "notes": "Genetic testing is essential for definitive diagnosis; muscle biopsy findings are characteristic but not exclusive."
  },
