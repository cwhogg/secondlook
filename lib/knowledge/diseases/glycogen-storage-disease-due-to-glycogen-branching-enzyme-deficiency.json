  "keyFindings": {
    "laboratory": [
      "Reduced glycogen branching enzyme activity in liver or muscle biopsy",
      "Elevated liver transaminases (AST, ALT)",
      "Hypoglycemia during fasting",
      "Elevated serum creatine kinase (CK) in some cases"
    ],
    "imaging": [
      "Ultrasound showing hepatosplenomegaly",
      "Liver biopsy demonstrating amylopectin-like glycogen deposits and fibrosis",
      "Echocardiogram revealing cardiomyopathy in some patients"
    ],
    "genetic": [
      "Pathogenic mutations in the GBE1 gene confirmed by molecular genetic testing",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histological evidence of abnormal glycogen structure with reduced branching"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "glycogen-storage-disease-type-iii",
      "distinguishingFeatures": [
        "Presence of debranching enzyme deficiency rather than branching enzyme deficiency",
        "Different glycogen structure on biopsy",
        "Less severe liver fibrosis in early stages"
      ]
    },
    {
      "diseaseId": "glycogen-storage-disease-type-vi",
      "distinguishingFeatures": [
        "Phosphorylase deficiency",
        "Milder clinical course with predominantly hepatomegaly and hypoglycemia",
        "Absence of amylopectin-like deposits"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive liver failure in infancy",
    "Severe hypotonia with muscle weakness",
    "Early onset cirrhosis with portal hypertension"
  ],
