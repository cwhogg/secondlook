  "differentialDiagnoses": [
    {
      "diseaseId": "autosomal-dominant-robinow-syndrome",
      "distinguishingFeatures": [
        "Autosomal dominant inheritance",
        "Milder limb shortening",
        "Less severe genital hypoplasia"
      ]
    },
    {
      "diseaseId": "campomelic-dysplasia",
      "distinguishingFeatures": [
        "More severe skeletal abnormalities",
        "Sex reversal in some cases",
        "Respiratory distress due to tracheomalacia"
      ]
    }
  ],
