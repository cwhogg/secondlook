  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Intellectual Disability-Facial Dysmorphism-Hand Anomalies Syndrome",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including broad nasal bridge, hypertelorism, and thin upper lip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hand-anomalies",
        "description": "Congenital hand malformations such as brachydactyly, clinodactyly, or syndactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Generalized hypotonia in infancy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of intellectual disability plus characteristic facial dysmorphism and at least one hand anomaly",
    "notes": "Diagnosis is clinical; genetic testing may assist but no specific gene identified yet."
  },
