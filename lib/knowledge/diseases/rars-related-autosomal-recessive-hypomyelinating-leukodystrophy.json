  "keyFindings": {
    "laboratory": [
      "Normal routine metabolic screening",
      "Elevated cerebrospinal fluid protein in some cases"
    ],
    "imaging": [
      "Diffuse hypomyelination with T2 hyperintensity and T1 hypointensity in cerebral white matter",
      "Preservation of basal ganglia and cerebellar structures"
    ],
    "genetic": [
      "RARS1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electrophysiological studies may show peripheral neuropathy"
    ]
