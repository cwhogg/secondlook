  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Trisomy 18",
    "criteria": [
      {
        "id": "chromosomal-confirmation",
        "description": "Presence of an extra full or partial chromosome 18 confirmed by karyotype or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facial-features",
        "description": "Micrognathia, prominent occiput, low-set malformed ears",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-heart-defects",
        "description": "Ventricular septal defect, atrial septal defect, patent ductus arteriosus",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clenched-fists-with-overlapping-fingers",
        "description": "Characteristic hand posture with overlapping index finger over middle finger",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Intrauterine growth restriction and postnatal failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Chromosomal confirmation of trisomy 18 plus presence of at least two major clinical features",
    "notes": "Diagnosis is primarily confirmed by cytogenetic analysis; clinical features support suspicion."
  },
