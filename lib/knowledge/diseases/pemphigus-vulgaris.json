  "diagnosticCriteria": {
    "formalCriteriaName": "Pemphigus Vulgaris Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of painful mucocutaneous erosions and flaccid blisters",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Intraepidermal acantholysis with suprabasal clefting on skin biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "direct-immunofluorescence",
        "description": "Intercellular IgG and C3 deposits in epidermis on direct immunofluorescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serologic-testing",
        "description": "Presence of circulating anti-desmoglein 3 (and sometimes desmoglein 1) autoantibodies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical presentation plus histopathology and direct immunofluorescence findings",
    "notes": "Serologic testing supports diagnosis and may aid in monitoring disease activity"
  },
  "symptoms": {
