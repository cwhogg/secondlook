  "keyFindings": {
    "laboratory": [
      "Reduced galactocerebrosidase enzyme activity in leukocytes or fibroblasts",
      "Elevated psychosine levels in blood or dried blood spots"
    ],
    "imaging": [
      "MRI showing symmetrical demyelination of cerebral white matter",
      "Thinning of corpus callosum",
      "Hyperintense T2-weighted lesions in periventricular regions"
    ],
    "genetic": [
      "GALC (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Presence of globoid cells on nerve biopsy (rarely performed)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "metachromatic-leukodystrophy",
      "distinguishingFeatures": [
        "Arylsulfatase A deficiency instead of GALC deficiency",
        "Later onset with predominant cognitive decline",
        "Different pattern of demyelination on MRI"
      ]
    },
    {
      "diseaseId": "adrenoleukodystrophy",
      "distinguishingFeatures": [
        "X-linked inheritance pattern",
        "Elevated very long chain fatty acids",
        "Adrenal insufficiency common"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive spasticity and developmental regression in late infancy or childhood",
    "Early onset optic atrophy with visual loss",
    "Severe peripheral neuropathy with areflexia"
  ],
