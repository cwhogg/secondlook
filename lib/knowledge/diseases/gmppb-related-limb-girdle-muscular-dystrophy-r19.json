  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed diagnostic criteria for GMPPB-related LGMD R19",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness predominantly affecting limb-girdle muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic biallelic variants in the GMPPB gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes with reduced or abnormal glycosylation of alpha-dystroglycan",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-ck",
        "description": "Elevated serum creatine kinase levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive limb-girdle muscle weakness plus biallelic pathogenic GMPPB variants",
    "notes": "Muscle biopsy and CK elevation support diagnosis but are not mandatory if genetic confirmation is obtained."
  },
