  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Childhood-onset Autosomal Recessive Spinocerebellar Ataxia",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Presence of slowly progressive cerebellar ataxia with onset in childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in associated genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging-findings",
        "description": "MRI evidence of cerebellar atrophy without significant supratentorial involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-ataxias",
        "description": "Exclusion of acquired and other hereditary ataxias by clinical and laboratory evaluation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of childhood-onset progressive cerebellar ataxia, supportive neuroimaging findings, and confirmation of biallelic pathogenic variants in relevant genes",
    "notes": "Diagnosis requires integration of clinical, genetic, and imaging data; family history may be supportive but not mandatory."
  },
