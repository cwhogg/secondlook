  "diagnosticCriteria": {
    "formalCriteriaName": "Ultrasound-based Diagnostic Criteria for Multicystic Dysplastic Kidney",
    "criteria": [
      {
        "id": "unilateral-cysts",
        "description": "Presence of multiple non-communicating cysts of varying sizes in one kidney",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-renal-pelvis",
        "description": "Absence or severe hypoplasia of the renal pelvis and calyces on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "contralateral-kidney-normal",
        "description": "Normal or compensatory hypertrophy of the contralateral kidney",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "no-urinary-tract-obstruction",
        "description": "No evidence of urinary tract obstruction or reflux on imaging studies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple non-communicating cysts with absent renal pelvis on imaging in one kidney",
    "notes": "Diagnosis is primarily based on prenatal or postnatal ultrasound findings; biopsy is rarely required."
  },
