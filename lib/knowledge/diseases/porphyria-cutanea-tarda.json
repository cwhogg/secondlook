  "keyFindings": {
    "laboratory": [
      "Markedly elevated urinary uroporphyrins and heptacarboxylporphyrins",
      "Elevated fecal isocoproporphyrins (pathognomonic)",
      "Elevated plasma porphyrins with fluorescence peak ~619 nm",
      "Elevated serum ferritin and transferrin saturation (iron overload)",
      "Hepatitis C serology often positive",
      "Normal urinary PBG and ALA (unlike acute porphyrias)"
    ],
    "imaging": [
      "Liver ultrasound may show hepatomegaly or steatosis",
      "MRI liver for iron quantification if iron overload suspected",
      "Hepatic imaging for HCC surveillance in chronic cases"
    ],
    "genetic": [
      "UROD gene mutation present in Type II (familial) PCT",
      "HFE gene mutations (C282Y, H63D) common as susceptibility factors",
      "Autosomal dominant inheritance for Type II",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Wood's lamp examination of urine shows coral-red fluorescence",
      "Skin biopsy shows subepidermal blister with festooning of dermal papillae",
      "PAS-positive thickening of dermal vessel walls"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "variegate-porphyria",
      "distinguishingFeatures": [
        "VP has both cutaneous and neurovisceral symptoms",
        "VP shows elevated fecal protoporphyrin and coproporphyrin",
        "VP has plasma fluorescence peak at ~626 nm",
        "VP involves PPOX gene mutation"
      ]
    },
    {
      "diseaseId": "hereditary-coproporphyria",
      "distinguishingFeatures": [
        "HCP has elevated fecal coproporphyrin III predominantly",
        "HCP may have acute neurovisceral attacks",
        "HCP involves CPOX gene mutation"
      ]
    },
    {
      "diseaseId": "pseudoporphyria",
      "distinguishingFeatures": [
        "Pseudoporphyria has normal porphyrin levels",
        "Often drug-induced (NSAIDs, furosemide)",
        "Clinically indistinguishable skin lesions but no biochemical abnormalities"
      ]
    },
    {
      "diseaseId": "epidermolysis-bullosa-acquisita",
      "distinguishingFeatures": [
        "EBA has anti-type VII collagen antibodies",
        "Porphyrin levels normal in EBA",
        "EBA is autoimmune in etiology"
      ]
    }
  ],
  "redFlags": [
    "Coexisting hepatitis C infection requiring treatment coordination",
    "Significant iron overload (ferritin >1000 ng/mL)",
    "Evidence of hepatic cirrhosis or hepatocellular carcinoma",
    "Concurrent HIV infection complicating management",
    "Severe sclerodermoid changes suggesting advanced disease"
  ],
