        "requiredForDiagnosis": true
      },
      {
        "id": "evidence-of-gerd",
        "description": "Clinical or instrumental evidence of gastroesophageal reflux disease (GERD)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "resolution-with-gerd-treatment",
        "description": "Improvement or resolution of neurological symptoms with treatment of GERD",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-neurological-disorders",
        "description": "Exclusion of primary neurological or musculoskeletal disorders causing dystonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reflux-associated dystonic movements plus evidence of GERD with symptom improvement after GERD treatment",
    "notes": "Diagnosis is clinical and often requires exclusion of other neurological conditions."
  },
