  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Episodic Ataxia Type 1",
    "criteria": [
      {
        "id": "episodic-ataxia",
        "description": "Recurrent brief episodes of ataxia lasting seconds to minutes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "myokymia",
        "description": "Presence of continuous or episodic myokymia (muscle twitching)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "KCNA1-mutation",
        "description": "Identification of pathogenic mutation in the KCNA1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern or positive family history",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-interictal-exam",
        "description": "Normal neurological examination between attacks",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent brief episodes of ataxia and myokymia with identification of KCNA1 mutation or positive family history consistent with autosomal dominant inheritance",
    "notes": "Genetic testing is confirmatory; electrophysiological studies may support diagnosis."
  },
