  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific biochemical markers",
      "CSF analysis typically unremarkable"
    ],
    "imaging": [
      "Brain MRI showing iron accumulation in globus pallidus with atypical or absent 'eye of the tiger' sign",
      "T2-weighted hypointensity in basal ganglia"
    ],
    "genetic": [
      "PANK2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Progressive extrapyramidal movement disorder with variable cognitive decline"
    ]
  },
  "differentialDiagnoses": [
