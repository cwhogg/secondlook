  "diagnosticCriteria": {
    "formalCriteriaName": "2012 International TSC Consensus Conference Diagnostic Criteria (Updated 2021)",
    "criteria": [
      {
        "id": "tsc-c1",
        "description": "Hypomelanotic macules (>= 3, at least 5mm diameter)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tsc-c2",
        "description": "Facial angiofibromas (>= 3) or fibrous cephalic plaque",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tsc-c3",
        "description": "Ungual fibromas (>= 2)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tsc-c4",
        "description": "Shagreen patch",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tsc-c5",
        "description": "Multiple retinal hamartomas",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tsc-c6",
        "description": "Cortical dysplasias (including tubers and cerebral white matter radial migration lines)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tsc-c7",
        "description": "Subependymal nodules",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tsc-c8",
        "description": "Subependymal giant cell astrocytoma (SEGA)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tsc-c9",
        "description": "Cardiac rhabdomyoma",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tsc-c10",
        "description": "Lymphangioleiomyomatosis (LAM)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tsc-c11",
        "description": "Angiomyolipomas (>= 2)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tsc-c12",
        "description": "Pathogenic variant in TSC1 or TSC2",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tsc-m1",
        "description": "Confetti skin lesions",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "tsc-m2",
        "description": "Dental enamel pits (>3)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "tsc-m3",
        "description": "Intraoral fibromas (>= 2)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "tsc-m4",
        "description": "Retinal achromic patch",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "tsc-m5",
        "description": "Multiple renal cysts",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "tsc-m6",
        "description": "Non-renal hamartomas",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Definite TSC: 2 major features, or 1 major + 2 minor features, or pathogenic TSC1/TSC2 mutation. Possible TSC: 1 major feature, or 2 or more minor features.",
    "notes": "LAM alone is insufficient for definite diagnosis without other features. Cardiac rhabdomyomas are often the first finding (prenatal ultrasound). Two-thirds of cases are de novo."
  },
