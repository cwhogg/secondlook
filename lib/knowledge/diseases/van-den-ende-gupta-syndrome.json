  "diagnosticCriteria": {
    "formalCriteriaName": "Van den Ende-Gupta syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "scapular-winging",
        "description": "Presence of bilateral scapular winging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial dysmorphism including blepharophimosis, hypoplastic maxilla, and prominent nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-contractures",
        "description": "Congenital joint contractures, especially camptodactyly and flexion contractures of elbows",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ptosis",
        "description": "Bilateral ptosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypoplastic-nasal-alae",
        "description": "Hypoplastic nasal alae",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: bilateral scapular winging, distinctive facial features, and congenital joint contractures",
    "notes": "Genetic testing confirming SCARF2 mutations supports diagnosis"
  },
