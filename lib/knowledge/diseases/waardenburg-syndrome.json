  "diagnosticCriteria": {
    "formalCriteriaName": "Farrer et al. Diagnostic Criteria for Waardenburg Syndrome",
    "criteria": [
      {
        "id": "dystopia-canthorum",
        "description": "Lateral displacement of inner canthi of the eyes (dystopia canthorum)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-deafness",
        "description": "Congenital sensorineural hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pigmentary-abnormalities",
        "description": "Pigmentary abnormalities of the iris (heterochromia iridum or brilliant blue eyes)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "white-forelock",
        "description": "White forelock or early graying of hair",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "skin-hypopigmentation",
        "description": "Congenital leukoderma or hypopigmented skin patches",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "broad-nasal-root",
        "description": "Broad nasal root",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least two major criteria or one major plus two minor criteria",
    "notes": "Diagnosis is clinical but can be supported by genetic testing."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Dystopia canthorum",
        "frequency": 0.85,
        "bodySystem": "ophthalmological",
        "notes": "Characteristic lateral displacement of inner eye corners"
      },
      {
        "symptomName": "Congenital sensorineural hearing loss",
        "frequency": 0.75,
        "bodySystem": "otolaryngological",
        "notes": "Bilateral or unilateral hearing impairment present at birth"
      },
      {
        "symptomName": "Iris pigmentary abnormalities (heterochromia iridum or brilliant blue eyes)",
        "frequency": 0.7,
        "bodySystem": "ophthalmological",
        "notes": "Distinctive iris color differences or brilliant blue eyes"
      }
    ],
    "common": [
      {
        "symptomName": "White forelock or early graying of scalp hair",
        "frequency": 0.65,
        "bodySystem": "dermatological",
        "notes": "Patch of white hair typically in the frontal scalp"
      },
      {
        "symptomName": "Leukoderma or hypopigmented skin patches",
        "frequency": 0.6,
        "bodySystem": "dermatological",
        "notes": "Areas of skin with reduced pigmentation"
      },
      {
        "symptomName": "Broad nasal root",
        "frequency": 0.55,
        "bodySystem": "constitutional",
        "notes": "Widened nasal bridge"
      },
      {
        "symptomName": "Synophrys (confluent eyebrows)",
        "frequency": 0.5,
        "bodySystem": "dermatological",
        "notes": "Eyebrows that meet in the midline"
      }
    ],
    "occasional": [
      {
        "symptomName": "Hypoplasia of alae nasi",
        "frequency": 0.3,
        "bodySystem": "constitutional",
        "notes": "Underdevelopment of the nasal wings"
      },
      {
        "symptomName": "Medial eyebrow flare",
        "frequency": 0.25,
        "bodySystem": "dermatological",
        "notes": "Upward flare of the medial eyebrows"
      },
      {
        "symptomName": "Broad high forehead",
        "frequency": 0.2,
        "bodySystem": "constitutional",
        "notes": "Prominent broad forehead"
      },
      {
        "symptomName": "Hypoplastic alae nasi",
        "frequency": 0.15,
        "bodySystem": "constitutional",
        "notes": "Underdeveloped nasal alae"
      }
    ],
    "rare": [
      {
        "symptomName": "Musculoskeletal abnormalities (e.g., limb anomalies)",
        "frequency": 0.08,
        "bodySystem": "musculoskeletal",
        "notes": "Rare limb malformations reported in some subtypes"
      },
      {
        "symptomName": "Hirschsprung disease",
        "frequency": 0.05,
        "bodySystem": "gastrointestinal",
        "notes": "Associated with Waardenburg-Shah syndrome subtype"
      },
      {
        "symptomName": "Neurological abnormalities",
        "frequency": 0.03,
        "bodySystem": "neurological",
        "notes": "Rare central nervous system involvement"
      }
    ]
  },
