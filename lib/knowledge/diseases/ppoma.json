  "keyFindings": {
    "laboratory": [
      "Elevated serum pancreatic polypeptide levels",
      "Mild hyperglycemia or hypoglycemia on glucose tolerance testing",
      "Possible elevated chromogranin A"
    ],
    "imaging": [
      "Pancreatic mass on contrast-enhanced CT or MRI",
      "Somatostatin receptor scintigraphy (Octreoscan) showing uptake in tumor",
      "Endoscopic ultrasound localization"
    ],
    "genetic": [
      "No specific genetic mutations identified; sporadic occurrence typical"
    ],
    "other": [
      "Histopathology showing neuroendocrine tumor cells positive for pancreatic polypeptide immunostaining"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "insulinoma",
      "distinguishingFeatures": [
        "Hypoglycemia due to insulin hypersecretion",
        "Elevated insulin and C-peptide levels",
        "Lack of elevated pancreatic polypeptide"
      ]
    },
    {
      "diseaseId": "vipoma",
      "distinguishingFeatures": [
        "Watery diarrhea with hypokalemia and achlorhydria (WDHA syndrome)",
        "Elevated vasoactive intestinal peptide (VIP) levels",
        "Different hormonal profile compared to PPoma"
      ]
    },
    {
      "diseaseId": "glucagonoma",
      "distinguishingFeatures": [
        "Necrolytic migratory erythema skin rash",
        "Elevated glucagon levels",
        "Diabetes mellitus more prominent"
      ]
    }
  ],
  "redFlags": [
