    "criteria": [
      {
        "id": "prolonged-qt-interval",
        "description": "Corrected QT interval (QTc) ≥ 480 ms on repeated ECGs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pathogenic-kcnq1-variant",
        "description": "Presence of pathogenic or likely pathogenic KCNQ1 gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-history",
        "description": "History of syncope triggered by exercise or emotional stress",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history of confirmed LQT1 or sudden cardiac death under age 30",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Prolonged QTc ≥ 480 ms and/or presence of pathogenic KCNQ1 mutation with clinical features",
    "notes": "Diagnosis is supported by Schwartz Score incorporating ECG, clinical, and family history data."
  },
