  "keyFindings": {
    "laboratory": [
      "Elevated blood and CSF lactate",
      "Combined deficiency of mitochondrial respiratory chain complexes I, III, and IV in muscle biopsy",
      "Elevated alanine levels"
    ],
    "imaging": [
      "Brain MRI may show cerebral atrophy or delayed myelination",
      "Cardiac echocardiography may reveal cardiomyopathy"
    ],
    "genetic": [
      "WARS2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy showing ragged-red fibers and mitochondrial abnormalities on electron microscopy"
    ]
  },
  "differentialDiagnoses": [
