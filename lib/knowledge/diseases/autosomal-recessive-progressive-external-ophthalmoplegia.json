  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Progressive External Ophthalmoplegia",
    "criteria": [
      {
        "id": "external-ophthalmoplegia",
        "description": "Progressive limitation of eye movements due to extraocular muscle weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mitochondrial-dna-deletions",
        "description": "Presence of multiple mitochondrial DNA deletions in muscle biopsy or blood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy-ragged-red-fibers",
        "description": "Muscle biopsy showing ragged-red fibers indicative of mitochondrial myopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history-ar-inheritance",
        "description": "Consistent autosomal recessive inheritance pattern in family history",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ptosis",
        "description": "Bilateral or unilateral eyelid ptosis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive external ophthalmoplegia plus either mitochondrial DNA deletions or muscle biopsy showing ragged-red fibers",
    "notes": "Genetic testing for nuclear gene mutations (e.g., POLG, TWNK) can support diagnosis"
  },
