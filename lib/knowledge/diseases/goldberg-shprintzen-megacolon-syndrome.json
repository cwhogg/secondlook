  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible electrolyte imbalances secondary to bowel obstruction"
    ],
    "imaging": [
      "Abdominal X-ray showing dilated colon",
      "Contrast enema demonstrating transition zone in colon",
      "MRI brain may show microcephaly"
    ],
    "genetic": [
      "KIFBP (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology of colon biopsy showing absence of ganglion cells"
    ]
  },
