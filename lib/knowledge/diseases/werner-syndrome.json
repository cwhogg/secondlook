  "diagnosticCriteria": {
    "formalCriteriaName": "International Registry of Werner Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "progeroid-appearance",
        "description": "Characteristic premature aging phenotype including skin atrophy and scleroderma-like changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cataracts",
        "description": "Bilateral juvenile cataracts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the WRN gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Adult short stature below the 3rd percentile",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "early-onset-atherosclerosis",
        "description": "Premature arteriosclerosis and cardiovascular disease",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "malignancies",
        "description": "Increased incidence of specific cancers such as sarcomas and thyroid carcinoma",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (progeroid appearance, bilateral juvenile cataracts, and WRN gene mutation) or clinical diagnosis supported by genetic confirmation",
    "notes": "Genetic testing is confirmatory; clinical diagnosis may be made based on phenotype and family history in absence of genetic results."
  },
