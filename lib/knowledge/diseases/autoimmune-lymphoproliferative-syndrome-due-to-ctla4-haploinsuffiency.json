  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for CTLA4 Haploinsufficiency",
    "criteria": [
      {
        "id": "autoimmune-manifestations",
        "description": "Presence of autoimmune cytopenias or autoimmune endocrinopathies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphoproliferation",
        "description": "Chronic lymphadenopathy and/or splenomegaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ctla4-mutation",
        "description": "Identification of heterozygous pathogenic variant in CTLA4 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogammaglobulinemia",
        "description": "Reduced serum immunoglobulin levels (IgG, IgA, and/or IgM)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "impaired-treg-function",
        "description": "Demonstration of regulatory T cell dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of heterozygous pathogenic CTLA4 mutation plus at least two major clinical criteria (autoimmune manifestations and lymphoproliferation)",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical presentation may be variable."
  },
