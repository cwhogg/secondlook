  "diagnosticCriteria": {
    "formalCriteriaName": "Schaaf-Yang Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "magel2-mutation",
        "description": "Presence of pathogenic or likely pathogenic variants in the MAGEL2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia with feeding difficulties",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-contractures",
        "description": "Distal joint contractures including camptodactyly",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "autism-spectrum-disorder",
        "description": "Autistic features or diagnosis of autism spectrum disorder",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-distress",
        "description": "Neonatal respiratory distress requiring intervention",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic MAGEL2 mutation plus presence of neonatal hypotonia and developmental delay",
    "notes": "Genetic testing is essential for confirmation; clinical features overlap with Prader-Willi syndrome but joint contractures and autism spectrum disorder are more prominent in SYS."
  },
