  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for 46,XX Gonadal Dysgenesis",
    "criteria": [
      {
        "id": "primary-amenorrhea",
        "description": "Presence of primary amenorrhea with absent or delayed puberty",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypergonadotropic-hypogonadism",
        "description": "Elevated gonadotropins (FSH and LH) with low estradiol levels indicating hypergonadotropic hypogonadism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "46xx-karyotype",
        "description": "Normal female karyotype (46,XX) without Y chromosome material",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "streak-gonads",
        "description": "Presence of streak gonads or gonadal agenesis on imaging or histology",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-secondary-sex-characteristics",
        "description": "Lack of breast development and other secondary sexual characteristics",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of primary amenorrhea with hypergonadotropic hypogonadism and confirmed 46,XX karyotype",
    "notes": "Exclusion of Y chromosome material is critical to differentiate from 46,XY gonadal dysgenesis"
  },
