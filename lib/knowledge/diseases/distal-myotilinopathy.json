  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Distal Myotilinopathy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive distal muscle weakness predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing myofibrillar disorganization with myotilin-positive protein aggregates",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the MYOT gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "EMG demonstrating myopathic changes with occasional fibrillation potentials",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal muscle weakness with confirmatory muscle biopsy findings and pathogenic MYOT mutation",
    "notes": "Diagnosis requires integration of clinical, histopathological, and genetic data."
  },
