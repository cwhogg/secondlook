  "diagnosticCriteria": {
    "formalCriteriaName": "Mounier-Kuhn Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "tracheal-dilation",
        "description": "Tracheal diameter exceeding 3 cm on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bronchial-dilation",
        "description": "Dilation of main bronchi exceeding normal diameter thresholds",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathologic-findings",
        "description": "Atrophy or absence of elastic fibers and smooth muscle in tracheal and bronchial walls",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "recurrent-respiratory-infections",
        "description": "History of recurrent lower respiratory tract infections",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of tracheal and bronchial dilation on imaging plus either histopathologic confirmation or characteristic clinical features such as recurrent respiratory infections",
    "notes": "Diagnosis is primarily radiological supported by clinical history; histopathology is rarely performed."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Tracheobronchomegaly",
        "frequency": 0.95,
        "bodySystem": "respiratory",
        "notes": "Marked dilation of trachea and main bronchi"
      },
      {
        "symptomName": "Atrophy of elastic fibers and smooth muscle in airway walls",
        "frequency": 0.85,
        "bodySystem": "respiratory",
        "notes": "Underlying pathological hallmark",
        "searchTerms": [
          "thinning airway walls",
          "weak lung tissue",
          "loss of elastic fibers in lungs"
        ]
      }
    ],
    "common": [
      {
        "symptomName": "Chronic productive cough",
        "frequency": 0.75,
        "bodySystem": "respiratory",
        "notes": "Due to impaired mucociliary clearance",
        "searchTerms": [
          "chronic cough with mucus production",
          "long-lasting productive cough",
          "persistent cough with phlegm"
        ]
      },
      {
        "symptomName": "Recurrent lower respiratory tract infections",
        "frequency": 0.7,
        "bodySystem": "respiratory",
        "notes": "Common complication",
        "searchTerms": [
          "frequent lower lung infections",
          "repeated bronchitis or pneumonia"
        ]
      },
      {
        "symptomName": "Dyspnea on exertion",
        "frequency": 0.65,
        "bodySystem": "respiratory",
        "notes": "Variable severity",
        "searchTerms": [
          "shortness of breath when active",
          "breathlessness on exertion",
          "difficulty breathing with activity"
        ]
      },
      {
        "symptomName": "Wheezing",
        "frequency": 0.6,
        "bodySystem": "respiratory",
        "notes": "May mimic asthma"
      }
    ],
    "occasional": [
