  "differentialDiagnoses": [
    {
      "diseaseId": "treacher-collins-syndrome",
      "distinguishingFeatures": [
        "Bilateral symmetrical facial bone hypoplasia",
        "Absence of vertebral anomalies",
        "Characteristic lower eyelid colobomas"
      ]
    },
    {
      "diseaseId": "hemifacial-microsomia",
      "distinguishingFeatures": [
        "Facial asymmetry without ocular dermoids",
        "Less frequent vertebral anomalies",
        "No ear tags or preauricular appendages"
      ]
    }
  ],
