  "diagnosticCriteria": {
    "formalCriteriaName": "Meesmann Corneal Dystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "microcysts",
        "description": "Presence of multiple intraepithelial microcysts in the corneal epithelium on slit-lamp examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in KRT3 or KRT12 genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "mild-visual-impairment",
        "description": "Mild visual symptoms such as glare or photophobia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic intraepithelial microcysts plus either a positive family history or genetic confirmation",
    "notes": "Diagnosis is primarily clinical supported by family history and genetic testing when available."
  },
