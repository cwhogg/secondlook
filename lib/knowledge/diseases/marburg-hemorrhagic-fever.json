  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Case Definition for Marburg Hemorrhagic Fever",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Acute onset of high fever and severe headache",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemorrhagic-symptoms",
        "description": "Presence of hemorrhagic manifestations such as petechiae, ecchymoses, or bleeding from mucous membranes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "laboratory-confirmation",
        "description": "Detection of Marburg virus RNA by RT-PCR or isolation of virus from clinical specimens",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epidemiological-link",
        "description": "History of exposure to infected bats, primates, or contact with a confirmed case",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acute febrile illness with hemorrhagic symptoms plus laboratory confirmation of Marburg virus infection",
    "notes": "Early diagnosis is critical due to rapid progression and high fatality rate."
  },
