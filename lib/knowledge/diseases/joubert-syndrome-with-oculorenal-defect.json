  "diagnosticCriteria": {
    "formalCriteriaName": "Joubert Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "molar-tooth-sign",
        "description": "Presence of the molar tooth sign on brain MRI indicating cerebellar vermis hypoplasia and brainstem malformation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oculorenal-anomalies",
        "description": "Presence of oculorenal defects including retinal dystrophy and nephronophthisis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia-developmental-delay",
        "description": "Early hypotonia with global developmental delay and intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-breathing-patterns",
        "description": "Episodic tachypnea and/or apnea in infancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-motor-apraxia",
        "description": "Impaired voluntary horizontal eye movements (ocular motor apraxia)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of molar tooth sign on MRI plus at least two major clinical features including oculorenal anomalies and hypotonia with developmental delay",
    "notes": "Genetic testing can support diagnosis but is not mandatory"
  },
