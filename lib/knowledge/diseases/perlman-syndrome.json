  "diagnosticCriteria": {
    "formalCriteriaName": "Perlman Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "fetal-overgrowth",
        "description": "Macrosomia or fetal overgrowth evident at birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nephroblastomatosis",
        "description": "Presence of nephroblastomatosis or Wilms tumor in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including deep-set eyes, depressed nasal bridge, and macroglossia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-cysts",
        "description": "Renal cystic dysplasia or cysts detected by imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "polyhydramnios",
        "description": "Polyhydramnios during pregnancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: fetal overgrowth, nephroblastomatosis or Wilms tumor, and characteristic facial dysmorphism",
    "notes": "Genetic testing for DIS3L2 mutations can support diagnosis but is not mandatory"
  },
