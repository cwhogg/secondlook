  "diagnosticCriteria": {
    "formalCriteriaName": "No formal named criteria",
    "criteria": [
      {
        "id": "giant-lysosomal-granules",
        "description": "Presence of giant lysosomal granules in neutrophils and other leukocytes on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-triad",
        "description": "Clinical triad of partial oculocutaneous albinism, recurrent pyogenic infections, and progressive neurological dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the LYST gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "immunological-dysfunction",
        "description": "Evidence of impaired natural killer cell and neutrophil function",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of giant lysosomal granules in leukocytes plus clinical features of albinism and recurrent infections; genetic confirmation supportive but not mandatory",
    "notes": "Diagnosis is often clinical supported by blood smear and genetic testing"
  },
