  "diagnosticCriteria": {
    "formalCriteriaName": "No formal diagnostic criteria established",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Presence of characteristic facial dysmorphic features including hypertelorism, broad nasal bridge, and prominent forehead",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "macrocephaly",
        "description": "Macrocephaly defined as head circumference > 2 standard deviations above mean for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dandy-walker-malformation",
        "description": "Neuroradiological evidence of Dandy-Walker malformation including hypoplasia of cerebellar vermis and cystic dilatation of the fourth ventricle",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "myopia",
        "description": "Presence of moderate to severe myopia confirmed by ophthalmological examination",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: characteristic facial dysmorphism, macrocephaly, and Dandy-Walker malformation on imaging",
    "notes": "Diagnosis is primarily clinical supported by neuroimaging and ophthalmological findings."
  },
