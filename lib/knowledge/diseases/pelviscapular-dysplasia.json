  "diagnosticCriteria": {
    "formalCriteriaName": "Pelviscapular Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "pelvic-malformation",
        "description": "Congenital malformation of the pelvic girdle with hypoplasia or aplasia of pelvic bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "scapular-hypoplasia",
        "description": "Bilateral scapular hypoplasia or dysplasia confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-contractures",
        "description": "Presence of joint contractures affecting upper and lower limbs",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "delayed-motor-development",
        "description": "Delayed gross motor milestones due to musculoskeletal abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (pelvic malformation and scapular hypoplasia) with supportive clinical features",
    "notes": "Genetic testing may assist but no specific gene identified yet"
  },
