      ]
    },
    {
      "diseaseId": "autoimmune-hypophysitis",
      "distinguishingFeatures": [
        "Inflammatory pituitary enlargement",
        "Autoimmune markers positive",
        "Often peripartum or associated with other autoimmune diseases"
      ]
