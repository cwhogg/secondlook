  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Congenital Insensitivity to Pain with Severe Intellectual Disability",
    "criteria": [
      {
        "id": "absent-pain-perception",
        "description": "Congenital absence of pain perception confirmed by clinical examination and patient history",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-intellectual-disability",
        "description": "Severe intellectual disability demonstrated by standardized cognitive testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autonomic-dysfunction",
        "description": "Evidence of autonomic nervous system dysfunction such as anhidrosis or temperature regulation abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with CIP with intellectual disability (e.g., SCN9A, PRDM12 mutations)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital absence of pain perception and severe intellectual disability with supportive clinical and/or genetic findings",
    "notes": "Genetic testing is recommended to confirm diagnosis and exclude other hereditary sensory neuropathies."
  },
