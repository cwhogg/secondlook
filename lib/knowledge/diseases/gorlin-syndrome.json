  "diagnosticCriteria": {
    "formalCriteriaName": "Evans et al. criteria (modified by Kimonis et al.)",
    "criteria": [
      {
        "id": "multiple-basal-cell-carcinomas",
        "description": "More than two basal cell carcinomas or one under the age of 20",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "odontogenic-keratocysts",
        "description": "Odontogenic keratocysts of the jaw confirmed by histology",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "palmar-plantar-pits",
        "description": "Three or more palmar or plantar pits",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "calcification-falx-cerebri",
        "description": "Calcification of the falx cerebri visible on imaging",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "first-degree-relative",
        "description": "First-degree relative with Gorlin syndrome",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "macrocephaly",
        "description": "Macrocephaly adjusted for height",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal abnormalities including bifid ribs or vertebral anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "medulloblastoma",
        "description": "Medulloblastoma, especially desmoplastic subtype",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ovarian-fibroma",
        "description": "Ovarian fibroma",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-malformations",
        "description": "Congenital malformations such as cleft lip/palate or polydactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Diagnosis requires two major criteria or one major and two minor criteria",
    "notes": "Genetic testing for PTCH1 mutations can support diagnosis but is not mandatory"
  },
