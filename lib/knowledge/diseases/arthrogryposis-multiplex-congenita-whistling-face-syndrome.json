  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Genetic testing revealing pathogenic variants in MYH3 gene"
    ],
    "imaging": [
      "X-rays showing joint contractures and bone deformities",
      "MRI may show muscle hypoplasia"
    ],
    "genetic": [
      "Mutations in MYH3 gene (encoding embryonic myosin heavy chain)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography may show myopathic changes",
      "Physical examination revealing characteristic facial and limb features"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "arthrogryposis-multiplex-congenita",
