  "diagnosticCriteria": {
    "formalCriteriaName": "Sneddon-Wilkinson diagnostic criteria",
    "criteria": [
      {
        "id": "clinical-pustules",
        "description": "Presence of flaccid, superficial pustules arranged in annular or serpiginous patterns",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology-subcorneal-pustules",
        "description": "Histopathology showing subcorneal accumulation of neutrophils without spongiosis or acantholysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "negative-culture",
        "description": "Sterile pustules with negative bacterial and fungal cultures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chronic-relapsing-course",
        "description": "Chronic relapsing course with recurrent pustular eruptions",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-dapsone",
        "description": "Clinical improvement with dapsone therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical pustules plus histopathological confirmation of subcorneal pustules and sterile cultures",
    "notes": "Diagnosis is primarily clinical supported by histopathology and exclusion of infectious causes."
  },
