        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "striatal-atrophy-imaging",
        "description": "MRI evidence of striatal atrophy or signal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variant in associated gene(s)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other neurodegenerative or metabolic disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive movement disorder with positive family history and supportive MRI findings; genetic confirmation if available",
    "notes": "Genetic testing is recommended but not mandatory if clinical and imaging criteria are met."
