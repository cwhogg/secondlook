  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for XLMTM",
    "criteria": [
      {
        "id": "muscle-weakness",
        "description": "Severe congenital hypotonia and generalized muscle weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-genitalia",
        "description": "Presence of genital anomalies such as micropenis or cryptorchidism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mtm1-mutation",
        "description": "Pathogenic mutation in the MTM1 gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Muscle biopsy showing centrally placed nuclei in muscle fibers (myotubular myopathy pattern)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-insufficiency",
        "description": "Early onset respiratory failure requiring ventilatory support",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe congenital muscle weakness, abnormal genitalia, and confirmed MTM1 pathogenic variant",
    "notes": "Muscle biopsy is supportive but not mandatory if genetic testing confirms diagnosis."
  },
