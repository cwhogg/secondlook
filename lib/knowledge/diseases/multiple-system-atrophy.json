  "diagnosticCriteria": {
    "formalCriteriaName": "Movement Disorder Society Criteria for MSA (2022 Revision)",
    "criteria": [
      {
        "id": "msa-1",
        "description": "Autonomic failure: orthostatic hypotension (>=20/10 mmHg within 3 min standing) or urogenital dysfunction (urinary incontinence or erectile dysfunction in males)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "msa-2",
        "description": "Parkinsonism poorly responsive to levodopa (MSA-P subtype)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "msa-3",
        "description": "Cerebellar ataxia with gait and limb ataxia, cerebellar dysarthria, cerebellar oculomotor dysfunction (MSA-C subtype)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "msa-4",
        "description": "Rapid disease progression",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "msa-5",
        "description": "MRI showing putaminal atrophy, hot cross bun sign, or cerebellar/pontine atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "msa-6",
        "description": "Stridor or inspiratory sighs",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Autonomic failure plus poorly levodopa-responsive parkinsonism OR cerebellar ataxia. Clinically established MSA requires additional supportive features.",
    "notes": "Definite diagnosis requires neuropathological confirmation with alpha-synuclein-positive glial cytoplasmic inclusions."
  },
