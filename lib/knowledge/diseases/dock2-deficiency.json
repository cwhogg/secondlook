  "keyFindings": {
    "laboratory": [
      "Profound lymphopenia with decreased T, B, and NK cells",
      "Impaired lymphocyte chemotaxis assays",
      "Hypogammaglobulinemia or dysgammaglobulinemia"
    ],
    "imaging": [
      "Chest X-ray or CT showing recurrent pneumonia or interstitial lung disease",
      "Ultrasound showing hepatosplenomegaly"
    ],
    "genetic": [
      "Biallelic pathogenic variants in DOCK2 gene confirmed by sequencing"
    ],
    "other": [
      "Abnormal lymphocyte functional assays demonstrating impaired migration",
      "Reduced oxidative burst in neutrophils may be observed"
    ]
  },
