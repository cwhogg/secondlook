  "diagnosticCriteria": {
    "formalCriteriaName": "Functioning Gonadotropic Adenoma Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-hormonal-evidence",
        "description": "Elevated serum gonadotropins (LH and/or FSH) with clinical signs of hormone hypersecretion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pituitary-imaging",
        "description": "Pituitary MRI showing adenomatous lesion consistent with gonadotroph adenoma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathological-confirmation",
        "description": "Immunohistochemical staining positive for gonadotropin subunits (LH, FSH) in tumor tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-pituitary-adenomas",
        "description": "Exclusion of other functioning pituitary adenomas by hormonal and immunohistochemical studies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical and biochemical evidence of gonadotropin hypersecretion plus pituitary adenoma on imaging and histopathological confirmation",
    "notes": "Diagnosis requires multidisciplinary evaluation including endocrinology, radiology, and pathology"
  },
