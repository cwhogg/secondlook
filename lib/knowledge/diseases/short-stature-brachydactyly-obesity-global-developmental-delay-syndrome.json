    "criteria": [
      {
        "id": "short-stature",
        "description": "Presence of significantly reduced height below the 3rd percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brachydactyly",
        "description": "Shortening of the fingers and toes due to abnormal bone development",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "obesity",
        "description": "Early-onset obesity with body mass index above the 95th percentile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "global-developmental-delay",
        "description": "Delayed acquisition of motor, cognitive, and speech milestones affecting multiple domains",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including broad nasal bridge and midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all four major criteria: short stature, brachydactyly, obesity, and global developmental delay",
    "notes": "Diagnosis is clinical; genetic testing may assist but no specific gene identified"
  },
