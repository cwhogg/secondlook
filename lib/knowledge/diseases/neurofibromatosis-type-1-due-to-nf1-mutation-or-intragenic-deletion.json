  "diagnosticCriteria": {
    "formalCriteriaName": "NIH Consensus Development Conference Diagnostic Criteria for NF1",
    "criteria": [
      {
        "id": "cafe-au-lait",
        "description": "Six or more café-au-lait macules over 5 mm in greatest diameter in prepubertal individuals and over 15 mm in postpubertal individuals",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurofibromas",
        "description": "Two or more neurofibromas of any type or one plexiform neurofibroma",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "freckling",
        "description": "Axillary or inguinal freckling",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "optic-glioma",
        "description": "Optic pathway glioma",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "lisch-nodules",
        "description": "Two or more Lisch nodules (iris hamartomas)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "osseous-lesions",
        "description": "Distinctive osseous lesion such as sphenoid dysplasia or thinning of long bone cortex with or without pseudarthrosis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "A first-degree relative with NF1 diagnosed by the above criteria",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of two or more of the above major criteria",
    "notes": "Diagnosis is clinical but can be confirmed by genetic testing identifying NF1 mutation or intragenic deletion"
  },
