  "keyFindings": {
    "laboratory": [
      "HLA-A29 positivity by PCR or serology",
      "Elevated intraocular inflammatory markers in aqueous or vitreous samples (research setting)"
    ],
    "imaging": [
      "Fundus fluorescein angiography showing hypofluorescent lesions",
      "Indocyanine green angiography revealing hypofluorescent spots corresponding to choroidal lesions",
      "Optical coherence tomography (OCT) demonstrating cystoid macular edema and retinal thinning",
      "Visual field testing showing characteristic defects"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electroretinography showing reduced b-wave amplitudes",
      "Bilateral involvement with chronic progression"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sarcoidosis",
      "distinguishingFeatures": [
        "Systemic granulomatous disease with multi-organ involvement",
        "Non-caseating granulomas on biopsy",
        "Absence of HLA-A29 association"
      ]
    },
    {
      "diseaseId": "multifocal-choroiditis",
      "distinguishingFeatures": [
        "Presence of punched-out chorioretinal scars",
        "More common in young myopic females",
        "Usually unilateral or asymmetric involvement"
      ]
    },
    {
      "diseaseId": "sympathetic-ophthalmia",
      "distinguishingFeatures": [
        "History of ocular trauma or surgery",
        "Diffuse granulomatous uveitis",
        "Rapid onset with bilateral involvement"
      ]
    }
  ],
  "redFlags": [
    "Rapid vision loss",
    "Development of cystoid macular edema",
    "Signs of secondary glaucoma",
    "Optic nerve involvement"
  ],
