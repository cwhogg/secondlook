      ]
    },
    {
      "diseaseId": "hypovolemic-shock",
      "distinguishingFeatures": [
        "History of hemorrhage or fluid loss",
        "No electrolyte abnormalities typical of adrenal insufficiency",
        "Normal cortisol levels"
      ]
    },
    {
      "diseaseId": "acute pancreatitis",
      "distinguishingFeatures": [
        "Elevated serum amylase and lipase",
        "Characteristic abdominal imaging findings",
        "No electrolyte disturbances typical of adrenal crisis"
      ]
    }
  ],
