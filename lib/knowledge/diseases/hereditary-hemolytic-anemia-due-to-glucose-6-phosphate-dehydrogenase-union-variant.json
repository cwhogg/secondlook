  "keyFindings": {
    "laboratory": [
      "Decreased G6PD enzyme activity in red blood cells",
      "Elevated reticulocyte count during hemolytic episodes",
      "Elevated indirect bilirubin and lactate dehydrogenase (LDH)",
      "Peripheral blood smear showing bite cells and Heinz bodies"
    ],
    "imaging": [
      "Ultrasound showing splenomegaly or hepatomegaly",
      "Ultrasound or CT scan detecting gallstones in chronic cases"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Positive family history of G6PD deficiency",
      "Clinical response to avoidance of oxidative triggers"
    ]
  },
