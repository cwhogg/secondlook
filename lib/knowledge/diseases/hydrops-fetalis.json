  "keyFindings": {
    "laboratory": [
      "Elevated fetal hemoglobin breakdown products in maternal serum",
      "Positive direct antiglobulin (Coombs) test in immune hydrops",
      "Anemia and thrombocytopenia in fetal blood sampling"
    ],
    "imaging": [
      "Ultrasound showing fluid accumulation in two or more fetal compartments",
      "Doppler ultrasound demonstrating increased middle cerebral artery peak systolic velocity indicating fetal anemia",
      "Echocardiography showing cardiomegaly and pericardial effusion"
    ],
    "genetic": [
      "Identification of underlying genetic disorders such as alpha-thalassemia, lysosomal storage diseases, or chromosomal abnormalities"
    ],
    "other": [
      "Maternal serology for infections (e.g., parvovirus B19, cytomegalovirus)",
      "Assessment for alloimmunization in Rh incompatibility"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "alpha-thalassemia-major",
