  "prevalence": {
    "estimate": "1 in 200,000 to 1 in 300,000",
    "classification": "rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 1,
      "peak": 0
    },
    "sexPredilection": "equal",
    "ethnicAssociations": [
      "Higher prevalence in consanguineous populations"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Lamellar Ichthyosis",
    "criteria": [
      {
        "id": "congenital-scaling",
        "description": "Presence of large, dark, plate-like scales covering most of the body from birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "collodion-baby",
        "description": "Neonatal presentation as a collodion baby with taut, shiny membrane",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ectropion",
        "description": "Ectropion (eversion of eyelids) commonly observed",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital scaling with collodion membrane at birth plus at least one additional major or minor criterion",
    "notes": "Genetic testing for TGM1 mutations can confirm diagnosis"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Large, dark, plate-like scaling",
        "frequency": 0.95,
        "bodySystem": "dermatological",
        "notes": "Generalized distribution including trunk and limbs"
      },
      {
        "symptomName": "Collodion membrane at birth",
        "frequency": 0.85,
        "bodySystem": "dermatological",
        "notes": "Shiny taut membrane covering neonate"
      },
      {
        "symptomName": "Ectropion",
        "frequency": 0.75,
        "bodySystem": "ophthalmological",
        "notes": "Eyelid eversion due to skin tightness"
      }
    ],
    "common": [
      {
        "symptomName": "Alopecia or scalp scaling",
        "frequency": 0.65,
        "bodySystem": "dermatological",
        "notes": "Variable hair involvement"
      },
      {
        "symptomName": "Palmoplantar keratoderma",
        "frequency": 0.6,
        "bodySystem": "dermatological",
        "notes": "Thickening of skin on palms and soles"
      },
      {
        "symptomName": "Hypohidrosis",
        "frequency": 0.55,
        "bodySystem": "dermatological",
        "notes": "Reduced sweating leading to heat intolerance"
      },
      {
        "symptomName": "Pruritus",
        "frequency": 0.5,
        "bodySystem": "dermatological",
        "notes": "Mild to moderate itching"
      }
    ],
    "occasional": [
      {
        "symptomName": "Eclabium",
        "frequency": 0.3,
        "bodySystem": "dermatological",
        "notes": "Eversion of lips due to skin tightness"
      },
      {
        "symptomName": "Secondary bacterial skin infections",
        "frequency": 0.25,
        "bodySystem": "dermatological",
        "notes": "Due to skin barrier disruption"
      },
      {
        "symptomName": "Heat intolerance",
        "frequency": 0.2,
        "bodySystem": "constitutional",
        "notes": "Related to hypohidrosis"
      },
      {
        "symptomName": "Nail dystrophy",
        "frequency": 0.15,
        "bodySystem": "dermatological",
        "notes": "Thickened or brittle nails"
      }
    ],
    "rare": [
      {
        "symptomName": "Sensorineural hearing loss",
        "frequency": 0.05,
        "bodySystem": "otolaryngological",
        "notes": "Reported in isolated cases"
      },
      {
        "symptomName": "Corneal ulceration",
        "frequency": 0.04,
        "bodySystem": "ophthalmological",
        "notes": "Secondary to ectropion and exposure"
      },
      {
        "symptomName": "Growth retardation",
        "frequency": 0.03,
        "bodySystem": "constitutional",
        "notes": "Due to chronic illness"
      }
    ]
  },
  "systemsAffected": [
    "dermatological",
    "ophthalmological",
    "constitutional",
    "otolaryngological"
  ],
  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Skin biopsy showing hyperkeratosis and thickened stratum corneum"
    ],
    "imaging": [
      "Not routinely required"
    ],
    "genetic": [
      "Mutations in TGM1 gene (most common)",
      "Other genes: ABCA12, ALOX12B, NIPAL4"
    ],
    "other": [
      "Clinical diagnosis supported by family history and genetic testing"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "harlequin-ichthyosis",
      "distinguishingFeatures": [
        "Severe, thick, armor-like scales at birth",
        "Eclabium and ectropion more pronounced",
        "High neonatal mortality"
      ]
    },
    {
      "diseaseId": "ichthyosis-vulgaris",
      "distinguishingFeatures": [
        "Onset in early childhood rather than at birth",
        "Fine, white scaling predominantly on extensor surfaces",
        "Associated with atopic dermatitis"
      ]
    }
  ],
  "redFlags": [
    "Severe ectropion causing corneal damage",
    "Secondary bacterial skin infections",
    "Heat intolerance with risk of hyperthermia"
  ],
