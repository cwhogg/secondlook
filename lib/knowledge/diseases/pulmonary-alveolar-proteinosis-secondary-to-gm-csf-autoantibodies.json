  "diagnosticCriteria": {
    "formalCriteriaName": "Autoimmune Pulmonary Alveolar Proteinosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "gm-csf-autoantibody-detection",
        "description": "Presence of circulating neutralizing GM-CSF autoantibodies detected by immunoassay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bronchoalveolar-lavage",
        "description": "Characteristic milky appearance of bronchoalveolar lavage fluid with periodic acid–Schiff (PAS) positive lipoproteinaceous material",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-pattern",
        "description": "High-resolution CT showing bilateral, symmetric ground-glass opacities with interlobular septal thickening (crazy paving pattern)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-secondary-causes",
        "description": "Exclusion of secondary causes of alveolar proteinosis such as inhalational exposures or hematologic malignancies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Detection of GM-CSF autoantibodies plus characteristic bronchoalveolar lavage findings and compatible imaging",
    "notes": "Lung biopsy is rarely required if criteria above are met."
  },
