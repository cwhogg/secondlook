        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-secondary-causes",
        "description": "Exclusion of secondary causes such as drug-induced or metabolic etiologies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with dystonia-parkinsonism syndromes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-dopaminergic-therapy",
        "description": "Partial or variable response to dopaminergic medications",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset progressive dystonia and parkinsonism symptoms with exclusion of secondary causes",
    "notes": "Genetic testing and neuroimaging assist in diagnosis but are not mandatory."
