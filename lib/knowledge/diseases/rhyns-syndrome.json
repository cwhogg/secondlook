  "diagnosticCriteria": {
    "formalCriteriaName": "RHYNS Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphisms including midface hypoplasia and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability confirmed by neuropsychological assessment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal abnormalities such as clinodactyly and short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variant in the RHYNS gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-features",
        "description": "Presence of behavioral abnormalities including mild autistic features",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical criteria (craniofacial dysmorphism, intellectual disability, skeletal abnormalities) with or without genetic confirmation",
    "notes": "Genetic testing is supportive but not mandatory for diagnosis."
  },
