  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mildly elevated or normal)",
      "Muscle biopsy showing type 1 fiber predominance and mild myopathic changes"
    ],
    "imaging": [
      "Echocardiogram showing mitral valve prolapse or aortic root dilation",
      "MRI muscle imaging may show fatty infiltration"
    ],
    "genetic": [
      "COL12A1 (causative)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography (EMG) may show myopathic changes",
      "Skin biopsy demonstrating abnormalities in collagen fibrils"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "classical-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "More prominent skin fragility and scarring",
        "Characteristic atrophic scars",
        "Less pronounced muscle weakness"
      ]
    },
    {
      "diseaseId": "congenital-myopathies",
      "distinguishingFeatures": [
        "Absence of skin hyperextensibility and joint hypermobility",
        "Distinct muscle biopsy findings",
        "Different genetic mutations"
      ]
    },
    {
      "diseaseId": "hypermobility-spectrum-disorders",
      "distinguishingFeatures": [
        "Lack of significant muscle weakness",
        "No characteristic muscle biopsy abnormalities",
        "Less severe skin involvement"
      ]
    }
  ],
  "redFlags": [
    "Severe proximal muscle weakness causing respiratory compromise",
    "Progressive aortic root dilation or mitral valve prolapse with cardiac symptoms",
    "Recurrent joint dislocations leading to functional impairment"
  ],
