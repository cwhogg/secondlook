  "keyFindings": {
    "laboratory": [
      "Routine blood tests typically normal",
      "CSF analysis may show mild protein elevation without pleocytosis"
    ],
    "imaging": [
      "MRI demonstrating spinal cord edema and flow voids consistent with AV malformations",
      "Spinal digital subtraction angiography confirming arteriovenous shunting in metameric distribution"
    ],
    "genetic": [
      "No known genetic mutations definitively associated"
    ],
    "other": [
      "Clinical correlation with segmental neurological deficits",
      "Exclusion of other spinal vascular disorders"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "spinal-dural-arteriovenous-fistula",
      "distinguishingFeatures": [
        "Typically presents in older adults",
        "Fistula located in dural root sleeve rather than metameric spinal cord segments",
        "Different angiographic pattern"
      ]
    },
    {
      "diseaseId": "hereditary-hemorrhagic-telangiectasia",
      "distinguishingFeatures": [
        "Systemic vascular malformations including mucocutaneous telangiectasias",
        "Family history positive",
        "Genetic testing positive for ENG or ACVRL1 mutations"
      ]
    }
  ],
  "redFlags": [
