  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of metabolic causes of spasticity"
    ],
    "imaging": [
      "MRI brain and spinal cord typically normal or showing mild corticospinal tract degeneration"
    ],
    "genetic": [
      "KIF5A (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography (EMG) may show mild peripheral neuropathy",
      "Nerve conduction studies may be normal or mildly abnormal"
    ]
  },
