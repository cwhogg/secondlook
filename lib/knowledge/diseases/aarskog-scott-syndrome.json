  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Aarskog-Scott syndrome",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism, widow's peak hairline, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Postnatal short stature with normal birth length",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genital-anomalies",
        "description": "Genital abnormalities such as shawl scrotum and cryptorchidism in males",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Mild skeletal anomalies including brachydactyly and clinodactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "X-linked inheritance pattern or family history consistent with syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (facial dysmorphism, short stature, genital anomalies) with or without supportive features",
    "notes": "Genetic testing for FGD1 mutations can confirm diagnosis but is not always necessary"
  },
