  "diagnosticCriteria": {
    "formalCriteriaName": "International Consensus Diagnostic Criteria for Birdshot Chorioretinopathy",
    "criteria": [
      {
        "id": "hypopigmented-lesions",
        "description": "Presence of multiple, bilateral, hypopigmented choroidal lesions in the posterior pole and midperiphery",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vitritis",
        "description": "Mild to moderate vitritis (intraocular inflammation)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hla-a29-positivity",
        "description": "Positive HLA-A29 haplotype",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cystoid-macular-edema",
        "description": "Presence of cystoid macular edema on imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "visual-field-defects",
        "description": "Characteristic visual field defects consistent with chorioretinal involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Bilateral hypopigmented choroidal lesions plus vitritis and HLA-A29 positivity",
    "notes": "Diagnosis requires exclusion of other causes of posterior uveitis."
  },
