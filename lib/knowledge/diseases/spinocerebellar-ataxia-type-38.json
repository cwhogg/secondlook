  "diagnosticCriteria": {
    "formalCriteriaName": "SCA38 Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with gait disturbance and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of heterozygous mutation in the ELOVL5 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI evidence of cerebellar atrophy predominantly affecting the vermis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-other-causes",
        "description": "Exclusion of other causes of ataxia such as acquired or metabolic etiologies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia with genetic confirmation of ELOVL5 mutation",
    "notes": "Diagnosis relies heavily on genetic testing due to overlapping clinical features with other SCAs."
  },
