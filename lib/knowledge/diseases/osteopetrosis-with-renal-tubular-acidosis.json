  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Osteopetrosis with RTA",
    "criteria": [
      {
        "id": "radiological-sclerosis",
        "description": "Diffuse increased bone density with characteristic 'bone within bone' appearance on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-tubular-acidosis",
        "description": "Evidence of proximal or distal renal tubular acidosis confirmed by metabolic acidosis with normal anion gap and urinary acidification defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with osteopetrosis and renal tubular acidosis (e.g., CLCN7, CA2)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical features such as bone fragility, growth retardation, and failure to thrive",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of radiological evidence of osteopetrosis plus biochemical confirmation of renal tubular acidosis",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory; clinical and radiological correlation is essential."
  },
