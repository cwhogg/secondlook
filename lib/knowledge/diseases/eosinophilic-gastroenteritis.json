  "diagnosticCriteria": {
    "formalCriteriaName": "Talley Criteria (Modified)",
    "criteria": [
      {
        "id": "ege-maj1",
        "description": "GI symptoms (abdominal pain, nausea, vomiting, diarrhea, bloating, weight loss)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ege-maj2",
        "description": "Eosinophilic infiltration of one or more areas of the GI tract on biopsy (>= 20 eos/hpf in stomach; >= 20 eos/hpf in small bowel)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ege-maj3",
        "description": "Exclusion of other causes of tissue eosinophilia (parasites, IBD, malignancy, hypereosinophilic syndrome, drug reaction)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ege-min1",
        "description": "Peripheral eosinophilia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ege-sup1",
        "description": "Personal or family history of atopy/allergic disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "GI symptoms with histological demonstration of eosinophilic infiltration of the GI tract (stomach and/or intestine) after exclusion of other causes of eosinophilia.",
    "notes": "Three subtypes based on layer involved: mucosal (most common), muscular (obstruction), and serosal (ascites). Serosal form often has eosinophilic ascites."
  },
