  "diagnosticCriteria": {
    "formalCriteriaName": "Alkaptonuria Diagnostic Criteria",
    "criteria": [
      {
        "id": "homogentisicaciduria",
        "description": "Presence of elevated homogentisic acid in urine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ochronosis",
        "description": "Clinical or histological evidence of ochronotic pigmentation in connective tissues",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "arthritis",
        "description": "Early-onset degenerative arthritis, especially of large weight-bearing joints and spine",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetictesting",
        "description": "Identification of pathogenic variants in the HGD gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of homogentisic aciduria plus ochronosis; genetic confirmation supportive",
    "notes": "Diagnosis is primarily clinical and biochemical; genetic testing confirms diagnosis"
  },
