  "diagnosticCriteria": {
    "formalCriteriaName": "Pancreatoblastoma Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of characteristic squamoid nests and acinar differentiation on histopathological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Identification of a well-defined pancreatic mass with heterogeneous enhancement on CT or MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alpha-fetoprotein",
        "description": "Elevated serum alpha-fetoprotein (AFP) levels supporting diagnosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of squamoid nests with acinar differentiation plus imaging evidence of pancreatic mass",
    "notes": "Serum AFP elevation is supportive but not mandatory; molecular testing may assist in ambiguous cases."
  },
