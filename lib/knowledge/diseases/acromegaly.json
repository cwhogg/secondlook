  "keyFindings": {
    "laboratory": [
      "Elevated serum IGF-1 above age-/sex-matched normal range",
      "Failure of GH suppression to <1 ng/mL on 75g OGTT",
      "Random GH levels >1 ng/mL (pulsatile secretion complicates interpretation)",
      "Elevated fasting glucose or HbA1c",
      "Possible hyperprolactinemia (co-secretion in mammosomatotroph adenomas)"
    ],
    "imaging": [
      "Pituitary MRI with gadolinium showing adenoma (macroadenoma in ~70%)",
      "Skull X-ray showing enlarged sella turcica, thickened calvarium (historical)",
      "Hand X-ray showing tufting of distal phalanges, widened joint spaces",
      "Echocardiography for cardiomyopathy assessment",
      "Sleep study (polysomnography) for obstructive sleep apnea"
    ],
    "genetic": [
      "AIP (susceptibility)",
      "GPR101 (susceptibility)",
      "GPR101 duplications in X-linked acrogigantism (X-LAG)"
    ],
    "other": [
      "Visual field testing (Goldmann or Humphrey perimetry)",
      "Colonoscopy screening for colorectal polyps at diagnosis",
      "Assessment of pituitary function (other axes: thyroid, adrenal, gonadal)"
    ]
  },
