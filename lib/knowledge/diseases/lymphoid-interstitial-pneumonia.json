  "keyFindings": {
    "laboratory": [
      "Polyclonal hypergammaglobulinemia",
      "Mildly elevated inflammatory markers (ESR, CRP)",
      "Negative infectious workup"
    ],
    "imaging": [
      "High-resolution CT showing diffuse ground-glass opacities",
      "Centrilobular nodules",
      "Thin-walled cysts predominantly in lower lobes"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Lung biopsy demonstrating lymphoid infiltration without monoclonality",
      "Pulmonary function tests showing restrictive pattern with reduced diffusion capacity"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "lymphoma-of-the-lung",
      "distinguishingFeatures": [
        "Monoclonal lymphoid proliferation on biopsy",
        "Mass lesions rather than diffuse infiltrates",
        "Systemic B symptoms more common"
      ]
    },
    {
      "diseaseId": "sarcoidosis",
      "distinguishingFeatures": [
        "Non-caseating granulomas on biopsy",
        "More frequent hilar lymphadenopathy",
        "Elevated serum ACE levels"
      ]
    },
    {
      "diseaseId": "hypersensitivity-pneumonitis",
      "distinguishingFeatures": [
        "History of antigen exposure",
        "Presence of granulomas and bronchiolitis on biopsy",
        "Improvement with antigen avoidance"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive respiratory failure",
    "Development of monoclonal lymphoid proliferation",
    "Severe hypoxemia refractory to oxygen therapy"
  ],
  "specialistType": [
