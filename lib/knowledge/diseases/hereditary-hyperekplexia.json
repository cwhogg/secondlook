  "diagnosticCriteria": {
    "formalCriteriaName": "Hyperekplexia Diagnostic Criteria",
    "criteria": [
      {
        "id": "exaggerated-startle",
        "description": "Exaggerated startle response to unexpected stimuli",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-stiffness",
        "description": "Generalized muscle stiffness or hypertonia especially in neonatal period",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glycine-receptor-mutation",
        "description": "Identification of pathogenic mutation in glycine receptor genes (e.g., GLRA1)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-neurological-signs",
        "description": "No evidence of other neurological disorders explaining symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of exaggerated startle response and muscle stiffness with exclusion of other neurological disorders; genetic confirmation supports diagnosis",
    "notes": "Genetic testing is recommended but not mandatory for diagnosis"
  },
  "symptoms": {
    "pathognomonic": [
