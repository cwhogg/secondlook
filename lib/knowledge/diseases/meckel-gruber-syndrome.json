  "diagnosticCriteria": {
    "formalCriteriaName": "Meckel-Gruber Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "occipital-encephalocele",
        "description": "Presence of occipital encephalocele or other neural tube defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "polycystic-kidneys",
        "description": "Bilateral enlarged polycystic kidneys",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "postaxial-polydactyly",
        "description": "Postaxial polydactyly of hands and/or feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepatic-fibrosis",
        "description": "Fibrotic changes in the liver or ductal plate malformation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or family history of Meckel-Gruber syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: occipital encephalocele, bilateral polycystic kidneys, and postaxial polydactyly",
    "notes": "Diagnosis is typically made prenatally or at birth due to lethal nature"
  },
