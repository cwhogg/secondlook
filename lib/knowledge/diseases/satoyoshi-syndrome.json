        "description": "Chronic diarrhea with malabsorption and weight loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal deformities including joint contractures and short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "autoimmune-markers",
        "description": "Presence of autoimmune antibodies or associated autoimmune phenomena",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: muscle spasms, alopecia, and chronic diarrhea with malabsorption",
    "notes": "Diagnosis is clinical; supportive laboratory and imaging findings aid confirmation"
  },
