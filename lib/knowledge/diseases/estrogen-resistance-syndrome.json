  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of clinical features consistent with estrogen resistance such as delayed puberty and lack of secondary sexual characteristics",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hormonal-profile",
        "description": "Elevated serum estradiol levels with absent or blunted physiological response",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the ESR1 gene encoding estrogen receptor alpha",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of estrogen deficiency or insensitivity such as aromatase deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical presentation, hormonal profile, and genetic confirmation) must be met",
    "notes": "Diagnosis is challenging due to rarity and overlap with other disorders of sexual development"
  },
