  "diagnosticCriteria": {
    "formalCriteriaName": "Revesz Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "bilateral-exudative-retinopathy",
        "description": "Presence of bilateral exudative retinopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-failure",
        "description": "Evidence of bone marrow failure including aplastic anemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intracranial-calcifications",
        "description": "Intracranial calcifications detected by neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "telomere-length",
        "description": "Markedly shortened telomere length on genetic testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "TINF2-mutation",
        "description": "Pathogenic mutation in TINF2 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (bilateral exudative retinopathy, bone marrow failure, and intracranial calcifications) must be present",
    "notes": "Genetic testing for TINF2 mutations and telomere length measurement support diagnosis but are not mandatory."
  },
