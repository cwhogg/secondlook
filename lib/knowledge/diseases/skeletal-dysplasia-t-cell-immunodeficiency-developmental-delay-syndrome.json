  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for SD-TCID-DD Syndrome",
    "criteria": [
      {
        "id": "skeletal-dysplasia",
        "description": "Radiologically confirmed skeletal dysplasia with characteristic bone abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "t-cell-immunodeficiency",
        "description": "Laboratory evidence of T-cell immunodeficiency including low CD3+ T-cell counts or impaired T-cell function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay affecting motor and cognitive milestones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variant in associated gene(s) if available",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other known causes of skeletal dysplasia and immunodeficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: skeletal dysplasia, T-cell immunodeficiency, and developmental delay",
    "notes": "Genetic testing can support diagnosis but is not mandatory; clinical and laboratory findings are essential."
  },
