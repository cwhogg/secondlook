  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed IMNEP Diagnostic Criteria",
    "criteria": [
      {
        "id": "neurologic-dysfunction",
        "description": "Progressive infantile-onset neurologic impairment including hypotonia and developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "endocrine-dysfunction",
        "description": "Evidence of endocrine abnormalities such as hypoglycemia or adrenal insufficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pancreatic-exocrine-insufficiency",
        "description": "Clinical or laboratory evidence of pancreatic exocrine insufficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in associated gene(s) if known",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "multisystem-involvement",
        "description": "Involvement of at least two organ systems including neurologic, endocrine, and pancreatic",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: infantile-onset neurologic impairment, endocrine dysfunction, and pancreatic exocrine insufficiency",
    "notes": "Genetic testing may support diagnosis but is not mandatory if clinical criteria are met."
  },
