  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Genetic Recurrent Myoglobinuria",
    "criteria": [
      {
        "id": "clinical-episodes",
        "description": "Recurrent episodes of muscle pain and dark urine consistent with myoglobinuria",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-creatine-kinase",
        "description": "Elevated serum creatine kinase (CK) levels during episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with metabolic myopathies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "myoglobinuria-confirmation",
        "description": "Detection of myoglobin in urine during symptomatic episodes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of acquired causes of myoglobinuria such as trauma or toxins",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent clinical episodes with myoglobinuria and elevated CK plus confirmation by genetic testing",
    "notes": "Diagnosis requires exclusion of secondary causes of myoglobinuria."
  },
