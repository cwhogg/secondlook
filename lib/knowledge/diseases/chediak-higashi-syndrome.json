        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Recurrent bacterial infections due to neutrophil and natural killer cell dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the LYST gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-features",
        "description": "Progressive neurological abnormalities including peripheral neuropathy and ataxia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of giant granules in leukocytes plus partial albinism and recurrent infections; genetic confirmation supportive",
    "notes": "Diagnosis is primarily clinical and laboratory-based; genetic testing confirms diagnosis."
