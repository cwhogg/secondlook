    "formalCriteriaName": "Sillence Classification Criteria for Osteogenesis Imperfecta",
    "criteria": [
      {
        "id": "bone-fractures",
        "description": "Recurrent low-trauma bone fractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "blue-sclerae",
        "description": "Presence of blue sclerae",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "dentinogenesis-imperfecta",
        "description": "Dentinogenesis imperfecta (opalescent teeth)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Progressive conductive or sensorineural hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent low-trauma fractures plus at least one major or minor criterion such as blue sclerae or dentinogenesis imperfecta",
    "notes": "Diagnosis is clinical but can be supported by genetic testing of COL1A1 and COL1A2 genes."
  },
