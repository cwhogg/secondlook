  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for OAAPN-GDD Syndrome",
    "criteria": [
      {
        "id": "optic-atrophy",
        "description": "Bilateral optic atrophy confirmed by ophthalmological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-ataxia",
        "description": "Clinical evidence of cerebellar ataxia including gait disturbance and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peripheral-neuropathy",
        "description": "Electrophysiological confirmation of peripheral neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "global-developmental-delay",
        "description": "Global developmental delay affecting motor and cognitive milestones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in associated gene(s) if known",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all four major criteria: bilateral optic atrophy, cerebellar ataxia, peripheral neuropathy, and global developmental delay",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory due to limited data."
  },
