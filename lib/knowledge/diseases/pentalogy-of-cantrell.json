  "diagnosticCriteria": {
    "formalCriteriaName": "Cantrell's Pentalogy Diagnostic Criteria",
    "criteria": [
      {
        "id": "midline-sternal-defect",
        "description": "Midline supraumbilical abdominal wall defect (e.g., omphalocele or epigastric hernia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anterior-diaphragmatic-defect",
        "description": "Defect of the anterior diaphragm",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lower-sternal-defect",
        "description": "Deficiency of the lower sternum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pericardial-defect",
        "description": "Defect of the diaphragmatic pericardium",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-cardiac-anomalies",
        "description": "Intracardiac malformations (e.g., ventricular septal defect, atrial septal defect, tetralogy of Fallot)",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of all five defects or four defects including the intracardiac anomaly and abdominal wall defect",
    "notes": "Diagnosis is clinical and imaging-based; genetic testing may assist but is not diagnostic."
  },
