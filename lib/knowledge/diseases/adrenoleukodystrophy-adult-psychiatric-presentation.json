  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Adult-Onset X-Linked Adrenoleukodystrophy",
    "criteria": [
      {
        "id": "psychiatric-symptoms",
        "description": "Presence of adult-onset psychiatric symptoms including psychosis, cognitive decline, or behavioral disturbances",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-vlcfa",
        "description": "Elevated plasma very long chain fatty acids (VLCFA) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abcd1-mutation",
        "description": "Identification of pathogenic mutation in the ABCD1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-mri-abnormalities",
        "description": "Characteristic white matter abnormalities on brain MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "adrenal-insufficiency",
        "description": "Evidence of adrenal insufficiency or Addison’s disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of adult-onset psychiatric symptoms plus elevated VLCFA and ABCD1 gene mutation",
    "notes": "Brain MRI and adrenal function testing support diagnosis but are not mandatory."
  },
