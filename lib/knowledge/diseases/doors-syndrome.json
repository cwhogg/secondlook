  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for DOORS syndrome",
    "criteria": [
      {
        "id": "deafness",
        "description": "Congenital or early-onset sensorineural deafness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "onychodystrophy",
        "description": "Nail abnormalities including hypoplasia, dystrophy, or absence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "osteodystrophy",
        "description": "Skeletal abnormalities such as brachydactyly, clinodactyly, or osteodystrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "Epileptic seizures of variable types and severity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "additional-features",
        "description": "Additional features such as dermatoglyphic abnormalities, facial dysmorphism, or growth retardation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of sensorineural deafness, onychodystrophy, osteodystrophy, and intellectual disability",
    "notes": "Genetic testing for TBC1D24 mutations can confirm diagnosis"
  },
