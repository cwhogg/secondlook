  "diagnosticCriteria": {
    "formalCriteriaName": "GM1 Gangliosidosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficient beta-galactosidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the GLB1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features including neurodegeneration, hepatosplenomegaly, and skeletal dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "Brain MRI showing cerebral and cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient beta-galactosidase enzyme activity plus pathogenic GLB1 variants with compatible clinical features",
    "notes": "Diagnosis is confirmed by enzymatic and genetic testing; clinical features support diagnosis and subtype classification."
  },
