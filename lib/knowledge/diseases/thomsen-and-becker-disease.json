  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electromyographic Diagnostic Criteria for Myotonia Congenita",
    "criteria": [
      {
        "id": "clinical-myotonia",
        "description": "Presence of muscle stiffness and delayed relaxation after voluntary contraction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyographic-myotonia",
        "description": "Electromyography demonstrating myotonic discharges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the CLCN1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant (Thomsen) or recessive (Becker) inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical myotonia and electromyographic myotonic discharges with or without genetic confirmation",
    "notes": "Genetic testing is confirmatory but not always necessary if clinical and EMG findings are definitive."
  },
