  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible abnormal renal function tests if kidney involvement"
    ],
    "imaging": [
      "Renal ultrasound showing cystic or structural anomalies",
      "Brain MRI may show nonspecific white matter changes"
    ],
    "genetic": [
      "Chromosomal microarray revealing 17q12 microduplication",
      "Fluorescence in situ hybridization (FISH) or MLPA confirming duplication"
    ],
