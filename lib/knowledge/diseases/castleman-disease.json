  "keyFindings": {
    "laboratory": [
      "Elevated IL-6 (key cytokine driver in iMCD)",
      "Elevated CRP and ESR",
      "Anemia of chronic disease",
      "Thrombocytopenia (TAFRO) or thrombocytosis",
      "Hypoalbuminemia",
      "Polyclonal hypergammaglobulinemia",
      "Elevated VEGF",
      "HHV-8 PCR/LANA immunostaining to classify (positive = HHV-8 MCD; negative = iMCD)"
    ],
    "imaging": [
      "CT: localized lymphadenopathy (UCD) or generalized (MCD); may show hepatosplenomegaly, effusions",
      "PET-CT: FDG-avid lymph nodes",
      "UCD: single large enhancing mass, often mediastinal or abdominal"
    ],
    "genetic": [
      "No hereditary genetic cause identified",
      "Clonal cytogenetic abnormalities described in some UCD cases"
    ],
    "other": [
      "Lymph node biopsy is essential: hyaline-vascular type (UCD), plasmacytic type (MCD), or mixed",
      "HHV-8 LANA staining on biopsy",
      "Bone marrow biopsy: reticulin fibrosis (TAFRO subtype)",
      "Exclude lymphoma, autoimmune diseases, and IgG4-related disease"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "lymphoma",
      "distinguishingFeatures": [
        "Lymphoma has monoclonal lymphoid population on flow cytometry/biopsy",
        "Lymphoma has specific histological subtypes (DLBCL, follicular, etc.)"
      ]
    },
    {
      "diseaseId": "sarcoidosis",
      "distinguishingFeatures": [
        "Sarcoidosis has non-caseating granulomas on biopsy",
        "Sarcoidosis has elevated ACE, bilateral hilar lymphadenopathy"
      ]
    },
    {
      "diseaseId": "igg4-related-disease",
      "distinguishingFeatures": [
        "IgG4-RD has elevated serum IgG4 and IgG4+ plasma cells on biopsy",
        "IgG4-RD has storiform fibrosis pattern"
      ]
    }
  ],
  "redFlags": [
    "TAFRO syndrome (thrombocytopenia, anasarca, renal failure - can be rapidly fatal)",
    "Rapid clinical deterioration with cytopenias and multiorgan failure",
    "Development of lymphoma (especially in HHV-8 MCD)",
    "Kaposi sarcoma (HHV-8 associated MCD + HIV)"
  ],
  "specialistType": [
