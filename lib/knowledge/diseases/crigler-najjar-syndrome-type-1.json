  "keyFindings": {
    "laboratory": [
      "Markedly elevated unconjugated (indirect) bilirubin levels (>20 mg/dL)",
      "Normal liver function tests except bilirubin",
      "No hemolysis on peripheral blood smear or reticulocyte count"
    ],
    "imaging": [
      "MRI brain may show bilateral basal ganglia and brainstem hyperintensities consistent with kernicterus"
    ],
    "genetic": [
      "UGT1A1 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Lack of response to phenobarbital therapy",
      "Positive family history in autosomal recessive pattern"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "gilbert-syndrome",
      "distinguishingFeatures": [
        "Mild unconjugated hyperbilirubinemia usually <3 mg/dL",
        "Normal or mildly elevated bilirubin with intermittent jaundice",
        "Phenobarbital responsiveness",
        "No risk of kernicterus"
      ]
    },
    {
      "diseaseId": "crigler-najjar-syndrome-type-2",
      "distinguishingFeatures": [
        "Partial deficiency of UGT1A1 enzyme",
        "Moderate unconjugated hyperbilirubinemia (usually <20 mg/dL)",
        "Phenobarbital responsiveness",
        "Lower risk of kernicterus"
      ]
    },
    {
      "diseaseId": "hemolytic-anemias",
      "distinguishingFeatures": [
        "Presence of anemia and reticulocytosis",
        "Elevated lactate dehydrogenase (LDH)",
        "Peripheral blood smear abnormalities",
        "Response to treatment of hemolysis"
      ]
    }
  ],
  "redFlags": [
    "Rapidly rising unconjugated bilirubin in neonate",
    "Signs of acute bilirubin encephalopathy (lethargy, hypotonia, poor feeding)",
    "Lack of response to phenobarbital therapy"
  ],
