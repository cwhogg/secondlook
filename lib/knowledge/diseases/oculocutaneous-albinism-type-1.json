  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Oculocutaneous Albinism",
    "criteria": [
      {
        "id": "hypopigmentation",
        "description": "Generalized hypopigmentation of skin, hair, and eyes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-abnormalities",
        "description": "Characteristic ocular findings including nystagmus, reduced visual acuity, foveal hypoplasia, and iris transillumination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tyrosinase-gene-mutation",
        "description": "Identification of pathogenic mutations in the TYR gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consistent autosomal recessive inheritance pattern or affected siblings",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-melanin",
        "description": "Histological or biochemical evidence of absent or severely reduced melanin production",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized hypopigmentation and characteristic ocular abnormalities plus identification of pathogenic TYR gene mutations",
    "notes": "Genetic testing is confirmatory; clinical diagnosis can be made based on phenotype and ocular findings in resource-limited settings."
  },
