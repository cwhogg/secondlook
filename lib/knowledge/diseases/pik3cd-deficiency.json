  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Activated PI3K Delta Syndrome",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of gain-of-function mutation in PIK3CD gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-infections",
        "description": "Recurrent sinopulmonary bacterial infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphoproliferation",
        "description": "Lymphadenopathy, splenomegaly, or hepatomegaly consistent with lymphoproliferation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunologic-abnormalities",
        "description": "Hypogammaglobulinemia or abnormal B and T cell subsets",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "autoimmune-manifestations",
        "description": "Presence of autoimmune cytopenias or other autoimmune phenomena",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of a pathogenic PIK3CD gain-of-function mutation plus at least two major clinical features including recurrent infections and lymphoproliferation",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical features vary widely."
  },
