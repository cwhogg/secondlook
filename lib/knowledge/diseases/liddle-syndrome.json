  "diagnosticCriteria": {
    "formalCriteriaName": "Liddle Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypertension",
        "description": "Early onset hypertension, often resistant to conventional therapy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypokalemia",
        "description": "Hypokalemia with metabolic alkalosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-renin-aldosterone",
        "description": "Suppressed plasma renin activity and low aldosterone levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of gain-of-function mutations in epithelial sodium channel (ENaC) genes (SCNN1B or SCNN1G)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early onset hypertension with hypokalemia and low renin-aldosterone levels, supported by genetic testing if available",
    "notes": "Genetic testing confirms diagnosis but clinical and biochemical findings are critical for initial suspicion."
  },
