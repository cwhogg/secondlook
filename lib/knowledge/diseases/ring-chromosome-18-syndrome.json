      ]
    },
    {
      "diseaseId": "miller-dieker-syndrome",
      "distinguishingFeatures": [
        "Lissencephaly with severe neurological impairment",
        "Distinct facial features including prominent forehead and bitemporal hollowing",
        "Different chromosomal abnormality (17p13.3 deletion)"
      ]
    }
