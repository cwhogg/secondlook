  "keyFindings": {
    "laboratory": [
      "Elevated fasting glucose and insulin levels indicating insulin resistance",
      "Hypertriglyceridemia and low HDL cholesterol",
      "Mildly elevated creatine kinase"
    ],
    "imaging": [
      "Echocardiography showing dilated cardiomyopathy or ventricular dysfunction",
      "MRI or CT demonstrating loss of subcutaneous fat",
      "Liver ultrasound showing steatosis"
    ],
    "genetic": [
      "LMNA (causative)",
      "Heterozygous pathogenic variants in LMNA gene with semi-dominant inheritance"
    ],
    "other": [
      "Electrocardiogram abnormalities including conduction defects and arrhythmias",
      "Muscle biopsy showing dystrophic changes"
    ]
  },
