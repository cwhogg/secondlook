  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "No specific biochemical markers"
    ],
    "imaging": [
      "MRI brain often normal or shows mild cortical atrophy",
      "Functional imaging may show hypometabolism in frontal lobes"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "EEG demonstrating prolonged ictal discharges with frontal or temporal onset",
      "Resistance to multiple antiepileptic drugs"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "juvenile-myoclonic-epilepsy",
      "distinguishingFeatures": [
        "Typical myoclonic jerks",
        "Generalized spike-wave EEG pattern",
        "No ring chromosome abnormalities"
      ]
    },
    {
      "diseaseId": "temporal-lobe-epilepsy",
      "distinguishingFeatures": [
        "MRI evidence of mesial temporal sclerosis",
        "Seizures responsive to treatment in many cases",
        "Absence of ring chromosome 20"
      ]
    }
  ],
  "redFlags": [
    "Refractory seizures despite multiple antiepileptic drugs",
