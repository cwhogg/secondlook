  "diagnosticCriteria": {
    "formalCriteriaName": "Radiological and Clinical Diagnostic Criteria for Arachnoid Cyst",
    "criteria": [
      {
        "id": "imaging-confirmation",
        "description": "Identification of a well-defined, CSF-like cystic lesion within the arachnoid membrane on MRI or CT imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-symptoms",
        "description": "Presence of neurological symptoms attributable to cyst mass effect such as headache, seizures, or focal neurological deficits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-lesions",
        "description": "Exclusion of other cystic intracranial lesions such as epidermoid cysts or neoplasms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "CSF-characteristics",
        "description": "Cyst fluid with cerebrospinal fluid characteristics on imaging and/or surgical sampling",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Radiological confirmation of arachnoid cyst plus clinical symptoms consistent with cyst location and exclusion of other cystic lesions",
    "notes": "Diagnosis primarily relies on neuroimaging; asymptomatic cysts may be incidental findings."
  },
