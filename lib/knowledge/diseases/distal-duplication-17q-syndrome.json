    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of distal duplication involving 17q25.3 region confirmed by chromosomal microarray or karyotyping",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Characteristic craniofacial dysmorphic features including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or limb abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of distal 17q duplication plus presence of developmental delay and characteristic dysmorphic features",
    "notes": "Diagnosis relies heavily on genetic testing combined with clinical presentation"
