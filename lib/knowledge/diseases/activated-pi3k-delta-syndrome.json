  "diagnosticCriteria": {
    "formalCriteriaName": "No standardized formal criteria; diagnosis based on clinical, immunological, and genetic findings",
    "criteria": [
      {
        "id": "heterozygous-pik3cd-mutation",
        "description": "Presence of heterozygous gain-of-function mutation in PIK3CD gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-respiratory-infections",
        "description": "History of recurrent sinopulmonary infections including pneumonia and bronchiectasis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunological-abnormalities",
        "description": "Immunological findings including hypogammaglobulinemia, elevated IgM, and impaired vaccine responses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphoproliferation",
        "description": "Presence of lymphadenopathy, splenomegaly, or hepatomegaly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "autoimmune-manifestations",
        "description": "Autoimmune cytopenias or other autoimmune phenomena",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Identification of a pathogenic PIK3CD mutation plus clinical evidence of recurrent infections and immunological abnormalities",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical presentation can be variable."
  },
