  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria; diagnosis based on clinical, histopathological, and genetic findings",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early-onset distal muscle weakness predominantly affecting ankle dorsiflexors and finger extensors",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing myopathic changes with rimmed vacuoles and fiber size variability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the MYH7 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected family members",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus muscle biopsy findings and confirmation by MYH7 mutation analysis",
    "notes": "Genetic testing is critical for definitive diagnosis due to phenotypic overlap with other distal myopathies"
  },
