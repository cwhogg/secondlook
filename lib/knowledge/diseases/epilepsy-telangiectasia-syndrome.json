  "keyFindings": {
    "laboratory": [
      "Elevated serum alpha-fetoprotein",
      "Lymphopenia with decreased IgA and IgG2 subclasses",
      "Elevated serum carcinoembryonic antigen (CEA) in some cases"
    ],
    "imaging": [
      "Cerebellar atrophy on brain MRI",
      "Pulmonary fibrosis on chest CT in advanced cases"
    ],
    "genetic": [
      "Biallelic pathogenic variants in ATM gene (chromosome 11q22-23)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Increased radiosensitivity in lymphocytes",
      "Abnormal cell cycle checkpoint control"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ataxia-telangiectasia",
      "distinguishingFeatures": [
        "Absence of epilepsy in classic ataxia-telangiectasia",
        "Similar cerebellar ataxia and telangiectasia but without recurrent seizures"
      ]
    },
    {
      "diseaseId": "epileptic-encephalopathy",
      "distinguishingFeatures": [
        "Lack of telangiectasia and immunodeficiency",
        "Different genetic etiology and clinical course"
      ]
    },
    {
      "diseaseId": "friedreich-ataxia",
      "distinguishingFeatures": [
        "No telangiectasia",
        "Different genetic mutation (FXN gene)",
        "Usually no immunodeficiency or epilepsy"
      ]
    }
  ],
  "redFlags": [
    "Early onset progressive cerebellar ataxia with ocular telangiectasia",
    "Recurrent generalized seizures resistant to standard antiepileptic drugs",
    "Recurrent sinopulmonary infections indicating immunodeficiency"
  ],
