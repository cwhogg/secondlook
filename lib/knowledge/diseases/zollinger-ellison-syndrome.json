  "diagnosticCriteria": {
    "criteria": [
      {
        "id": "zes-maj1",
        "description": "Fasting serum gastrin > 10 times upper limit of normal (> 1000 pg/mL) with gastric pH < 2",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "zes-maj2",
        "description": "Positive secretin stimulation test (gastrin increase > 120 pg/mL after IV secretin)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "zes-maj3",
        "description": "Imaging identification of gastrinoma (CT, MRI, EUS, or somatostatin receptor scintigraphy)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "zes-min1",
        "description": "Recurrent/refractory peptic ulcer disease",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "zes-min2",
        "description": "Diarrhea with hypergastrinemia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "zes-sup1",
        "description": "Association with MEN1 syndrome (present in 20-30% of ZES cases)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Fasting hypergastrinemia with gastric acid hypersecretion (pH < 2) plus either positive secretin stimulation test or localization of gastrinoma on imaging. PPIs must be held before testing.",
    "notes": "60-90% of gastrinomas are malignant. 70-80% are in the gastrinoma triangle (duodenum > pancreas). 20-30% are associated with MEN1."
  },
