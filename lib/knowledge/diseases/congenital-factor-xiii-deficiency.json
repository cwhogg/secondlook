  "diagnosticCriteria": {
    "formalCriteriaName": "Factor XIII Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "prolonged-bleeding",
        "description": "History of delayed bleeding or umbilical stump bleeding in neonatal period",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "factor-xiii-activity",
        "description": "Reduced or absent Factor XIII activity in plasma assays",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in F13A1 or F13B genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-pt-ptt",
        "description": "Normal prothrombin time (PT) and activated partial thromboplastin time (aPTT)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical bleeding symptoms plus confirmed low Factor XIII activity",
    "notes": "Genetic testing supports diagnosis but is not mandatory"
  },
