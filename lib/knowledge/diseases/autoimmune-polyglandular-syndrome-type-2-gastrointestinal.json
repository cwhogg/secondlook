  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Autoimmune Polyglandular Syndrome Type 2",
    "criteria": [
      {
        "id": "adrenal-insufficiency",
        "description": "Presence of primary adrenal insufficiency (Addison's disease)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoimmune-thyroid-disease",
        "description": "Coexisting autoimmune thyroid disease (Hashimoto thyroiditis or Graves disease)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "type-1-diabetes",
        "description": "Presence of type 1 diabetes mellitus",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "autoimmune-gastritis",
        "description": "Evidence of autoimmune gastritis or pernicious anemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "autoantibodies",
        "description": "Detection of relevant autoantibodies (e.g., 21-hydroxylase, thyroid peroxidase, intrinsic factor antibodies)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of primary adrenal insufficiency plus autoimmune thyroid disease, with or without type 1 diabetes mellitus",
    "notes": "Gastrointestinal manifestations such as autoimmune gastritis and malabsorption support diagnosis but are not mandatory."
  },
