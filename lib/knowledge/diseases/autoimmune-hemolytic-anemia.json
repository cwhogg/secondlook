  "diagnosticCriteria": {
    "formalCriteriaName": "No universally accepted formal criteria; diagnosis based on clinical and laboratory findings",
    "criteria": [
      {
        "id": "positive-direct-antiglobulin-test",
        "description": "Positive direct antiglobulin (Coombs) test indicating antibody or complement coating of red blood cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "evidence-hemolysis",
        "description": "Laboratory evidence of hemolysis including elevated lactate dehydrogenase, elevated indirect bilirubin, decreased haptoglobin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anemia",
        "description": "Presence of anemia with reticulocytosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of hemolytic anemia such as hereditary spherocytosis or drug-induced hemolysis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Positive direct antiglobulin test plus laboratory evidence of hemolysis and anemia",
    "notes": "Diagnosis requires integration of clinical presentation and laboratory findings; no single test is definitive alone."
  },
