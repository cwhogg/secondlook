  "diagnosticCriteria": {
    "formalCriteriaName": "DSM-5 Criteria for Anorexia Nervosa adapted for prepubertal children",
    "criteria": [
      {
        "id": "restriction-energy-intake",
        "description": "Restriction of energy intake relative to requirements leading to significantly low body weight for age, sex, and developmental trajectory",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intense-fear-gain-weight",
        "description": "Intense fear of gaining weight or becoming fat, or persistent behavior that interferes with weight gain, even though underweight",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "disturbance-body-image",
        "description": "Disturbance in the way one's body weight or shape is experienced, undue influence of body weight or shape on self-evaluation, or persistent lack of recognition of the seriousness of low body weight",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Possible delay or arrest in pubertal development due to malnutrition",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "amenorrhea",
        "description": "Absence of at least three consecutive menstrual cycles (if applicable)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met for diagnosis",
    "notes": "Diagnostic criteria adapted to consider developmental stage and prepubertal status"
  },
