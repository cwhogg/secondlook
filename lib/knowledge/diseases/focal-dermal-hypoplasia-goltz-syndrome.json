  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Focal Dermal Hypoplasia",
    "criteria": [
      {
        "id": "skin-atrophy",
        "description": "Presence of patchy dermal hypoplasia with skin atrophy and fat herniation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal malformations such as syndactyly, ectrodactyly, or limb asymmetry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "Ocular defects including coloboma or microphthalmia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in the PORCN gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic skin findings plus at least one skeletal abnormality or genetic confirmation",
    "notes": "Diagnosis is primarily clinical but can be supported by genetic testing for PORCN mutations."
  },
