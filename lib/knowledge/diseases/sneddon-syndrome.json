  "diagnosticCriteria": {
    "criteria": [
      {
        "id": "sned-maj1",
        "description": "Generalized livedo racemosa (widespread, irregular, non-reversible reticular pattern on skin)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sned-maj2",
        "description": "Cerebrovascular events (TIA or stroke, particularly in young adults)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sned-min1",
        "description": "Skin biopsy showing non-inflammatory thrombotic vasculopathy of dermal vessels",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sned-min2",
        "description": "Positive antiphospholipid antibodies (present in ~40-50%)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sned-sup1",
        "description": "Cardiac valvular disease (Libman-Sacks-like endocarditis)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Combination of generalized livedo racemosa plus cerebrovascular events (TIA or stroke). Skin biopsy demonstrating thrombotic vasculopathy of medium-sized arteries is confirmatory.",
    "notes": "Two forms: (1) antiphospholipid antibody-positive (~40-50%, overlap with APS), and (2) seronegative. The livedo pattern is typically racemosa (irregular, broken rings) not reticularis (regular, complete rings)."
  },
