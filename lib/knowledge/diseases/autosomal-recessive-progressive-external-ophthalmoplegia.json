  "keyFindings": {
    "laboratory": [
      "Elevated serum lactate and pyruvate levels",
      "Muscle biopsy showing ragged-red fibers and cytochrome c oxidase (COX) negative fibers"
    ],
    "imaging": [
      "Brain MRI may show mild cerebellar atrophy in some cases"
    ],
    "genetic": [
      "POLG (causative)",
      "TK2 (causative)",
      "TOP3A (causative)",
      "RRM1 (causative)",
      "Multiple mitochondrial DNA deletions detected in muscle or blood",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography showing myopathic changes",
      "Cardiac conduction studies revealing arrhythmias or heart block"
    ]
  },
