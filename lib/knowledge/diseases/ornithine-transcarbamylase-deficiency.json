  "diagnosticCriteria": {
    "formalCriteriaName": "Ornithine Transcarbamylase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "hyperammonemia",
        "description": "Elevated plasma ammonia levels during symptomatic episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-orotic-acid",
        "description": "Increased urinary orotic acid excretion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the OTC gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-ornithine-transcarbamylase-activity",
        "description": "Reduced OTC enzyme activity in liver biopsy or fibroblasts",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-presentation",
        "description": "Neonatal or late-onset hyperammonemic encephalopathy with neurological symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hyperammonemia and increased urinary orotic acid combined with pathogenic OTC gene variant or reduced enzyme activity",
    "notes": "Genetic testing is the gold standard for confirmation; enzyme assay may be used if genetic testing is inconclusive."
  },
