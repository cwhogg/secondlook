    "formalCriteriaName": "Proposed criteria for DNA2-related mitochondrial DNA deletion syndrome",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of progressive external ophthalmoplegia and/or mitochondrial myopathy symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the DNA2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mtDNA-deletions",
        "description": "Detection of multiple mitochondrial DNA deletions in muscle biopsy or other tissues",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-lab",
        "description": "Elevated serum lactate or abnormal mitochondrial respiratory chain enzyme activities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical features consistent with mitochondrial myopathy plus genetic confirmation of DNA2 pathogenic variants and evidence of multiple mtDNA deletions",
    "notes": "Muscle biopsy and genetic testing are critical for diagnosis; clinical heterogeneity is common."
  },
