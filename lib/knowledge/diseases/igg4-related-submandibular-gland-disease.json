  "keyFindings": {
    "laboratory": [
      "Elevated serum IgG4 concentration (>135 mg/dL)",
      "Mildly elevated serum IgE",
      "Normal or mildly elevated inflammatory markers (ESR, CRP)"
    ],
    "imaging": [
      "Ultrasound showing diffuse or nodular enlargement of submandibular glands",
      "CT/MRI demonstrating homogeneous gland enhancement without focal mass",
      "Absence of calcifications or abscess"
    ],
    "genetic": [],
    "other": [
      "Histopathology: dense lymphoplasmacytic infiltration rich in IgG4-positive plasma cells (>40% IgG4+/IgG+ ratio), storiform fibrosis, obliterative phlebitis"
    ]
  },
