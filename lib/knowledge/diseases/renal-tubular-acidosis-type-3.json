  "diagnosticCriteria": {
    "formalCriteriaName": "Combined Proximal and Distal Renal Tubular Acidosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "metabolic-acidosis",
        "description": "Presence of hyperchloremic metabolic acidosis with normal anion gap",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "proximal-bicarbonate-wasting",
        "description": "Evidence of proximal tubular bicarbonate wasting (e.g., decreased bicarbonate reabsorption)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distal-acidification-defect",
        "description": "Impaired distal tubular acidification demonstrated by inability to acidify urine (urine pH >5.5) despite systemic acidosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypokalemia",
        "description": "Presence of hypokalemia due to renal potassium wasting",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-glomerular-function",
        "description": "Preserved glomerular filtration rate with tubular dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hyperchloremic metabolic acidosis with normal anion gap plus evidence of both proximal bicarbonate wasting and distal acidification defect",
    "notes": "Diagnosis requires exclusion of other causes of metabolic acidosis and confirmation by laboratory testing of tubular function."
  },
