  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Acrofacial Dysostosis, Palagonia Type",
    "criteria": [
      {
        "id": "craniofacial-malformations",
        "description": "Presence of characteristic craniofacial anomalies including malar hypoplasia, micrognathia, and cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Bilateral postaxial polydactyly and limb shortening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-findings",
        "description": "Radiographic evidence of hypoplastic or absent bones in the hands and feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the EFTUD2 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Prenatal and postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (craniofacial malformations, limb malformations, and radiological findings) with or without genetic confirmation",
    "notes": "Genetic testing for EFTUD2 mutations can support diagnosis but is not mandatory."
  },
