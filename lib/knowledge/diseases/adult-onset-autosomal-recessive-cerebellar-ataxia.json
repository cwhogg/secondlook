  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Adult-onset Autosomal Recessive Cerebellar Ataxia",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with onset in adulthood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in genes associated with ARCA",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-ataxias",
        "description": "Exclusion of acquired, dominant, or mitochondrial causes of ataxia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-neuroimaging",
        "description": "MRI evidence of cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "supportive-neurophysiology",
        "description": "Electrophysiological studies excluding peripheral neuropathy or supporting cerebellar dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive adult-onset cerebellar ataxia with biallelic pathogenic variants in ARCA-associated genes and exclusion of other ataxia causes",
    "notes": "Diagnosis relies heavily on genetic testing combined with clinical and radiological findings."
  },
