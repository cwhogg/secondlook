  "diagnosticCriteria": {
    "formalCriteriaName": "Blepharo-cheilo-odontic syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "ectrodactyly",
        "description": "Presence of ectrodactyly (split hand/foot malformation)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ectodermal-dysplasia-features",
        "description": "Ectodermal dysplasia signs including sparse hair, hypohidrosis, and nail abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "odontodysplasia",
        "description": "Severe dental anomalies including hypodontia, conical teeth, and enamel hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features such as cleft lip/palate and eyelid malformations",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of ectrodactyly, ectodermal dysplasia features, and odontodysplasia",
    "notes": "Diagnosis is clinical and supported by family history and genetic testing when available."
  },
