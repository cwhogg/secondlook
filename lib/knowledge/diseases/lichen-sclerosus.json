  "diagnosticCriteria": {
    "formalCriteriaName": "No universally accepted formal criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of white, atrophic plaques primarily in genital and perianal areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing epidermal thinning, homogenization of collagen in upper dermis, and band-like lymphocytic infiltrate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "symptom-chronicity",
        "description": "Chronic symptoms such as pruritus and pain persisting for months to years",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical presentation with characteristic lesions plus confirmatory histopathology",
    "notes": "Diagnosis is primarily clinical supported by biopsy; no standardized diagnostic scoring system exists."
  },
