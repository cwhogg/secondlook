  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Genetic testing identifying pathogenic variants in ZNF469 or PRDM5"
    ],
    "imaging": [
      "Corneal pachymetry showing extreme thinning",
      "Ocular coherence tomography (OCT) revealing corneal structural abnormalities",
      "Echocardiography for cardiac valve and aortic root assessment"
    ],
    "genetic": [
      "ZNF469 (causative)",
      "PRDM5 (causative)",
      "Autosomal recessive inheritance pattern"
    ],
    "other": [
      "Slit-lamp examination showing corneal thinning and blue sclera",
      "Audiometry confirming sensorineural hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "More prominent skin hyperextensibility",
        "Wider range of systemic involvement",
        "Less severe corneal thinning"
      ]
    },
    {
      "diseaseId": "osteogenesis-imperfecta",
      "distinguishingFeatures": [
        "Frequent bone fractures",
        "Blue sclera but with bone fragility",
        "Absence of corneal rupture"
      ]
    },
    {
      "diseaseId": "keratoconus",
      "distinguishingFeatures": [
        "Corneal thinning localized to cone apex",
        "No systemic features",
        "No blue sclera"
      ]
    }
  ],
