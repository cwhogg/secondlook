  "diagnosticCriteria": {
    "formalCriteriaName": "Immunoglobulin Isotype Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "recurrent-infections",
        "description": "History of recurrent bacterial infections, particularly of the respiratory and gastrointestinal tracts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-rare-igg-isotypes",
        "description": "Serum immunoglobulin quantification showing deficiency in rare IgG isotypes (e.g., IgG2, IgG4) or other rare immunoglobulin isotypes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-secondary-causes",
        "description": "Exclusion of secondary causes of immunodeficiency such as HIV infection, malignancy, or immunosuppressive therapy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-total-igg",
        "description": "Normal or near-normal total IgG levels despite isotype-specific deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "impaired-antibody-response",
        "description": "Impaired specific antibody response to polysaccharide vaccines",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent infections plus documented deficiency in rare immunoglobulin isotypes with exclusion of secondary causes",
    "notes": "Diagnosis requires comprehensive immunological evaluation including quantitative and functional antibody testing."
  },
