  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnosis of Osteoporosis-pseudoglioma syndrome",
    "criteria": [
      {
        "id": "early-onset-osteoporosis",
        "description": "Severe osteoporosis presenting in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-pseudoglioma",
        "description": "Presence of pseudoglioma or vitreoretinal abnormalities leading to visual impairment or blindness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biallelic-LRP5-mutation",
        "description": "Identification of biallelic pathogenic variants in the LRP5 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-bone-fractures",
        "description": "Radiographic evidence of multiple low-trauma fractures",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "progressive-visual-loss",
        "description": "Progressive visual impairment starting in infancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset osteoporosis and ocular pseudoglioma with confirmation of biallelic LRP5 mutations",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical presentation may overlap with other skeletal dysplasias."
  },
