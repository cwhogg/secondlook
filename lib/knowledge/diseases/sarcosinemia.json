  "diagnosticCriteria": {
    "formalCriteriaName": "Sarcosinemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-sarcosine",
        "description": "Persistent elevated sarcosine levels in plasma and urine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sarcosine-dehydrogenase-deficiency",
        "description": "Demonstration of deficient sarcosine dehydrogenase enzyme activity in fibroblasts or liver tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the SARDH gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of neurological symptoms such as developmental delay or hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated sarcosine levels plus either enzyme deficiency or pathogenic SARDH gene variants",
    "notes": "Diagnosis is confirmed by biochemical and genetic testing; clinical presentation may be variable."
  },
