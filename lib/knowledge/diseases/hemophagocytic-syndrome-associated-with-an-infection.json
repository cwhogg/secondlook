  "keyFindings": {
    "laboratory": [
      "Elevated serum ferritin (>500 ng/mL, often >10,000 ng/mL)",
      "Cytopenias affecting ≥2 blood cell lineages",
      "Hypertriglyceridemia and/or hypofibrinogenemia",
      "Elevated liver enzymes (AST, ALT)",
      "Low or absent NK cell activity"
    ],
    "imaging": [
      "Splenomegaly and hepatomegaly on ultrasound or CT",
      "Lymphadenopathy on imaging"
    ],
    "genetic": [
      "No specific genetic mutation in infection-associated form; differs from familial HLH mutations"
    ],
    "other": [
      "Hemophagocytosis seen on bone marrow, lymph node, or spleen biopsy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "familial-hemophagocytic-lymphohistiocytosis",
      "distinguishingFeatures": [
        "Early onset in infancy or childhood",
        "Known genetic mutations (e.g., PRF1, UNC13D)",
        "Often no preceding infection"
      ]
    },
    {
      "diseaseId": "sepsis",
      "distinguishingFeatures": [
        "Positive blood cultures or clear infectious source",
        "Rapid response to antibiotics",
        "Lack of hemophagocytosis on biopsy"
      ]
    },
    {
      "diseaseId": "malignancy-associated hemophagocytic syndrome",
      "distinguishingFeatures": [
        "Presence of underlying malignancy (e.g., lymphoma)",
        "Malignant cells on biopsy",
        "Different treatment approach"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive multi-organ failure",
    "Unremitting high fever despite antimicrobial therapy",
    "Severe cytopenias with bleeding or infections"
  ],
