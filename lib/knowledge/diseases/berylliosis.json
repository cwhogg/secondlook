  "keyFindings": {
    "laboratory": [
      "Positive beryllium lymphocyte proliferation test (BeLPT)",
      "Elevated serum angiotensin-converting enzyme (ACE) levels (nonspecific)",
      "Mild leukocytosis or lymphocytosis in bronchoalveolar lavage fluid"
    ],
    "imaging": [
      "Chest X-ray showing bilateral hilar lymphadenopathy and nodular infiltrates",
      "High-resolution CT scan showing ground-glass opacities, nodules, and fibrosis"
    ],
    "genetic": [
      "HLA-DPB1 gene variants associated with increased susceptibility"
    ],
    "other": [
      "Noncaseating granulomas on lung biopsy",
      "Restrictive pattern on pulmonary function tests"
    ]
  },
  "differentialDiagnoses": [
