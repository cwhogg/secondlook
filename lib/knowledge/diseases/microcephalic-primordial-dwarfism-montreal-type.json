  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Microcephalic Primordial Dwarfism, Montreal Type",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Severe congenital microcephaly with head circumference below the 3rd percentile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "primordial-dwarfism",
        "description": "Severe prenatal and postnatal growth retardation resulting in primordial dwarfism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent nose, micrognathia, and large eyes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Radiological evidence of skeletal dysplasia with delayed bone age",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with microcephalic primordial dwarfism",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (severe microcephaly and primordial dwarfism) with supportive clinical and radiological findings",
    "notes": "Genetic testing may confirm diagnosis but is not mandatory if clinical criteria are met."
  },
