  "diagnosticCriteria": {
    "formalCriteriaName": "Gaucher Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of glucocerebrosidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the GBA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-manifestations",
        "description": "Presence of early-onset severe neurological symptoms including brainstem dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "visceral-involvement",
        "description": "Hepatosplenomegaly and bone marrow infiltration",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient glucocerebrosidase enzyme activity plus biallelic GBA mutations with clinical neurological involvement",
    "notes": "Diagnosis requires integration of enzymatic, genetic, and clinical findings due to phenotypic overlap with other Gaucher types."
  },
