  "diagnosticCriteria": {
    "formalCriteriaName": "Isolated Atrial Standstill Diagnostic Criteria",
    "criteria": [
      {
        "id": "absence-atrial-activity",
        "description": "Electrocardiogram (ECG) showing absence of P waves indicating no atrial electrical activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "atrial-electromechanical-dissociation",
        "description": "Echocardiographic evidence of absent atrial contraction despite normal ventricular function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-secondary-causes",
        "description": "Exclusion of secondary causes such as electrolyte imbalance, drug toxicity, or structural atrial disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-atrial-capture",
        "description": "Failure to capture atrial pacing despite adequate ventricular capture during electrophysiological study",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met: absence of P waves on ECG, echocardiographic evidence of absent atrial contraction, and exclusion of secondary causes",
    "notes": "Diagnosis requires careful exclusion of reversible or secondary causes of atrial inactivity."
  },
