  "keyFindings": {
    "laboratory": [
      "Elevated serum ferritin may be observed but is nonspecific",
      "Normal routine blood tests"
    ],
    "imaging": [
      "MRI showing hypointensity on T2-weighted images in globus pallidus and substantia nigra consistent with iron accumulation",
      "Optic nerve atrophy on orbital MRI"
    ],
    "genetic": [
      "C19ORF12 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Neurophysiological studies may show evidence of peripheral neuropathy"
    ]
  },
