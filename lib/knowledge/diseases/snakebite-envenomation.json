        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "local-envenomation-signs",
        "description": "Presence of local swelling, erythema, or necrosis at bite site",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "systemic-toxicity",
        "description": "Signs of systemic envenomation such as coagulopathy, neurotoxicity, or hypotension",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "laboratory-evidence",
        "description": "Laboratory abnormalities consistent with envenomation (e.g., thrombocytopenia, elevated creatine kinase)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "History of snakebite plus presence of local envenomation signs and/or systemic toxicity",
    "notes": "Diagnosis is primarily clinical; laboratory tests support severity assessment."
