  "diagnosticCriteria": {
    "formalCriteriaName": "Fragile X Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "fmr1-mutation",
        "description": "Presence of >200 CGG trinucleotide repeats in the FMR1 gene leading to gene silencing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability ranging from mild to severe",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facial-features",
        "description": "Presence of elongated face, large ears, and prominent jaw",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-features",
        "description": "Behavioral abnormalities including social anxiety, ADHD, and autistic-like behaviors",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of FMR1 full mutation (>200 CGG repeats) plus clinical features consistent with intellectual disability and characteristic phenotype",
    "notes": "Molecular genetic testing is the gold standard for diagnosis; clinical features support but are not solely diagnostic."
  },
