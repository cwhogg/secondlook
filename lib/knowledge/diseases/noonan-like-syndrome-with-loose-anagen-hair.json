  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild anemia secondary to feeding difficulties"
    ],
    "imaging": [
      "Echocardiogram showing pulmonic stenosis or hypertrophic cardiomyopathy",
      "Brain MRI typically normal or nonspecific"
    ],
    "genetic": [
      "DIS3L2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Hair microscopy showing loose anagen hair with misshapen hair roots",
      "Clinical facial dysmorphology assessment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "noonan-syndrome",
      "distinguishingFeatures": [
        "Absence of loose anagen hair",
        "Mutations in PTPN11, SOS1, RAF1 rather than SHOC2",
        "Similar cardiac and facial features"
      ]
    },
    {
      "diseaseId": "costello-syndrome",
      "distinguishingFeatures": [
        "Distinctive coarse facial features",
        "HRAS mutations",
        "More severe developmental delay and predisposition to tumors"
      ]
    },
    {
      "diseaseId": "cardiofaciocutaneous-syndrome",
      "distinguishingFeatures": [
        "BRAF, MEK1/2 mutations",
        "More severe skin abnormalities (ichthyosis, hyperkeratosis)",
        "Distinctive craniofacial features without loose anagen hair"
      ]
    }
  ],
  "redFlags": [
    "Severe congenital heart defects requiring early intervention",
