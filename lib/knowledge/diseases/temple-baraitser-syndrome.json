      ]
    },
    {
      "diseaseId": "cornelia-de-lange-syndrome",
      "distinguishingFeatures": [
        "Distinctive facial features including synophrys",
        "Limb abnormalities different from TBS",
        "NIPBL or other gene mutations"
      ]
    }
  ],
