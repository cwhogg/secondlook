  "keyFindings": {
    "laboratory": [
      "Arterial blood gases showing hypoxemia and hypercapnia",
      "Elevated inflammatory markers during aspiration pneumonia episodes"
    ],
    "imaging": [
      "Contrast esophagography demonstrating abnormal communication between airway and esophagus",
      "Chest X-ray showing recurrent infiltrates consistent with aspiration pneumonia",
      "CT or MRI may delineate extent of cleft and associated anomalies"
    ],
    "genetic": [
      "No specific gene identified; may be associated with syndromic conditions such as VACTERL",
      "Genetic testing recommended to rule out associated syndromes"
    ],
    "other": [
      "Endoscopic visualization is gold standard for diagnosis",
      "Bronchoscopy confirms extent of cleft and airway involvement"
    ]
  },
