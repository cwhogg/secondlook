  "diagnosticCriteria": {
    "formalCriteriaName": "Blepharonasofacial Malformation Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "blepharonasofacial-malformations",
        "description": "Presence of characteristic blepharonasofacial malformations including blepharophimosis, telecanthus, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphisms",
        "description": "Craniofacial anomalies such as cleft lip and/or palate and midface hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Presence of limb anomalies including syndactyly or camptodactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria: characteristic blepharonasofacial malformations and craniofacial anomalies",
    "notes": "Genetic testing may support diagnosis but is not definitive due to limited data."
  },
