  "diagnosticCriteria": {
    "formalCriteriaName": "Weyers Acrofacial Dysostosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia, micrognathia, and cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Postaxial polydactyly and short distal phalanges of fingers and toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nail-dysplasia",
        "description": "Hypoplastic or dysplastic nails affecting fingers and toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "dental-anomalies",
        "description": "Dental abnormalities including enamel hypoplasia and malocclusion",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: characteristic facial dysmorphism, limb malformations (postaxial polydactyly and short distal phalanges), and nail dysplasia",
    "notes": "Genetic testing for mutations in the EVC2 gene can support diagnosis"
  },
