  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Macrocephaly-Intellectual Disability-Autism Syndrome",
    "criteria": [
      {
        "id": "macrocephaly",
        "description": "Head circumference greater than 2 standard deviations above the mean for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Clinical evidence of intellectual disability confirmed by standardized cognitive testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autism-spectrum-disorder",
        "description": "Diagnosis of autism spectrum disorder based on DSM-5 criteria",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Delayed developmental milestones in motor and language domains",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of neurodevelopmental disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: macrocephaly, intellectual disability, and autism spectrum disorder",
    "notes": "Genetic testing may support diagnosis but is not mandatory; diagnosis is clinical."
  },
