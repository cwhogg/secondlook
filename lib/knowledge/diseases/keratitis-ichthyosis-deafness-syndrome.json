  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for KID Syndrome",
    "criteria": [
      {
        "id": "congenital-sensorineural-hearing-loss",
        "description": "Congenital or early-onset sensorineural hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "keratitis",
        "description": "Progressive keratitis with corneal vascularization and inflammation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ichthyosiform-dermatosis",
        "description": "Diffuse ichthyosiform erythroderma or palmoplantar keratoderma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "connexin-26-mutation",
        "description": "Identification of pathogenic GJB2 (connexin-26) gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nail-dystrophy",
        "description": "Nail abnormalities including dystrophy or thickening",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: sensorineural hearing loss, keratitis, and ichthyosiform skin changes",
    "notes": "Genetic testing for GJB2 mutations supports diagnosis but is not mandatory."
  },
