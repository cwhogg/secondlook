  "diagnosticCriteria": {
    "formalCriteriaName": "Bothnia Retinal Dystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive night blindness and peripheral visual field loss starting in adolescence or early adulthood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fundus-findings",
        "description": "Characteristic fundus changes including pigmentary retinopathy with bone spicule pigmentation and macular atrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the RLBP1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroretinography",
        "description": "Reduced or extinguished rod and cone responses on electroretinography",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive night blindness with characteristic fundus findings plus confirmation by genetic testing",
    "notes": "Genetic confirmation is critical for definitive diagnosis due to phenotypic overlap with other retinal dystrophies."
  },
