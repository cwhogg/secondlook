  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Genetic testing identifying mutations in neuronal migration genes (e.g., LIS1, DCX)"
    ],
    "imaging": [
      "MRI showing pachygyria with thickened, broad gyri and abnormal cortical lamination",
      "Possible associated ventriculomegaly"
    ],
    "genetic": [
      "Pathogenic variants in LIS1 (PAFAH1B1), DCX, TUBA1A, or related genes"
    ],
    "other": [
      "Electroencephalogram (EEG) showing epileptiform activity"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "lissencephaly",
      "distinguishingFeatures": [
        "Smooth brain surface without gyri (agyria) rather than broad gyri",
        "More severe cortical malformation"
      ]
    },
    {
      "diseaseId": "polymicrogyria",
      "distinguishingFeatures": [
        "Excessive small gyri rather than broad gyri",
        "Irregular cortical surface with multiple small folds"
      ]
    }
  ],
  "redFlags": [
    "Onset of refractory seizures in infancy",
    "Severe developmental regression",
    "Progressive neurological deterioration"
  ],
