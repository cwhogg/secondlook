  "diagnosticCriteria": {
    "formalCriteriaName": "Keutel Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cartilaginous-calcification",
        "description": "Diffuse abnormal calcification of cartilage including auricular, nasal, and tracheobronchial cartilage",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-artery-stenosis",
        "description": "Presence of peripheral pulmonary artery stenosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brachytelephalangy",
        "description": "Brachytelephalangy characterized by shortening of distal phalanges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Mild facial dysmorphic features such as midface hypoplasia and depressed nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of diffuse cartilaginous calcification plus at least two major criteria including pulmonary artery stenosis and brachytelephalangy",
    "notes": "Genetic testing for mutations in the MGP gene can support diagnosis"
  },
