  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Triad for Typical HUS",
    "criteria": [
      {
        "id": "microangiopathic-hemolytic-anemia",
        "description": "Evidence of microangiopathic hemolytic anemia (schistocytes on blood smear, elevated LDH, decreased haptoglobin)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thrombocytopenia",
        "description": "Thrombocytopenia (platelet count <150,000/µL)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acute-renal-failure",
        "description": "Acute kidney injury with elevated serum creatinine and reduced urine output",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "preceding-diarrheal-illness",
        "description": "History of preceding diarrheal illness, often bloody, caused by Shiga toxin-producing bacteria",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of the triad of microangiopathic hemolytic anemia, thrombocytopenia, and acute renal failure",
    "notes": "Confirmation of Shiga toxin-producing bacterial infection supports diagnosis but is not mandatory"
  },
