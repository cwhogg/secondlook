  "diagnosticCriteria": {
    "formalCriteriaName": "Van der Knaap Diagnostic Criteria for MLC",
    "criteria": [
      {
        "id": "macrocephaly",
        "description": "Early-onset macrocephaly usually presenting within the first year of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "subcortical-cysts",
        "description": "Presence of bilateral subcortical cysts predominantly in the anterior temporal and frontoparietal regions on MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "diffuse-leukoencephalopathy",
        "description": "Diffuse abnormal white matter signal changes on brain MRI consistent with leukoencephalopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in MLC1 or HEPACAM genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Mild motor developmental delay with slow progression of ataxia and spasticity",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset macrocephaly, characteristic MRI findings of subcortical cysts and diffuse leukoencephalopathy, with or without genetic confirmation",
    "notes": "Genetic testing is confirmatory but not mandatory if clinical and radiological features are typical."
  },
