  "keyFindings": {
    "laboratory": [
      "Normal or nonspecific cerebrospinal fluid findings",
      "Exclusion of inflammatory markers to rule out vasculitis"
    ],
    "imaging": [
      "Segmental multifocal narrowing of cerebral arteries on angiography",
      "Reversibility of vasoconstriction on follow-up imaging within 12 weeks",
      "MRI may show ischemic lesions or cortical subarachnoid hemorrhage"
    ],
    "genetic": [
      "No known genetic mutations associated"
    ],
    "other": [
      "Triggering factors such as vasoactive substances or postpartum state may be identified"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "primary-angitis-of-the-central-nervous-system",
      "distinguishingFeatures": [
        "Progressive course without reversibility",
        "Inflammatory CSF findings",
        "Systemic symptoms often present"
      ]
    },
    {
      "diseaseId": "aneurysmal-subarachnoid-hemorrhage",
      "distinguishingFeatures": [
        "Presence of aneurysm on imaging",
        "Non-reversible vasoconstriction",
        "More severe meningeal signs"
      ]
    },
    {
      "diseaseId": "posterior-reversible-encephalopathy-syndrome",
      "distinguishingFeatures": [
        "Characteristic MRI findings of vasogenic edema",
        "Associated with hypertension and renal failure",
        "Headache less severe and not thunderclap type"
      ]
    }
  ],
