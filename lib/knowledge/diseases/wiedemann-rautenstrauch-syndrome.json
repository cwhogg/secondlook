  "diagnosticCriteria": {
    "formalCriteriaName": "Wiedemann-Rautenstrauch Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "progeroid-appearance",
        "description": "Characteristic neonatal progeroid facial appearance including sparse scalp hair, prominent scalp veins, and thin skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intrauterine-growth-retardation",
        "description": "Severe intrauterine and postnatal growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lipodystrophy",
        "description": "Generalized loss of subcutaneous fat resulting in a cachectic appearance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-anomalies",
        "description": "Skeletal abnormalities including delayed bone age and hypoplastic clavicles",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-developmental-delay",
        "description": "Variable developmental delay and hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: neonatal progeroid facial appearance, severe intrauterine/postnatal growth retardation, and generalized lipodystrophy",
    "notes": "Genetic testing for POLR3A mutations may support diagnosis but is not mandatory"
  },
