  "diagnosticCriteria": {
    "formalCriteriaName": "Congenital Enterovirus Infection Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Neonatal onset of systemic symptoms including fever, irritability, and poor feeding",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "laboratory-confirmation",
        "description": "Detection of enterovirus RNA by PCR in sterile sites such as blood, cerebrospinal fluid, or amniotic fluid",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-infections",
        "description": "Exclusion of other congenital infections (e.g., TORCH infections)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging-findings",
        "description": "Neuroimaging evidence of meningoencephalitis or white matter abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "maternal-infection-history",
        "description": "Maternal history of febrile illness or enterovirus infection during pregnancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of neonatal systemic symptoms plus laboratory confirmation of enterovirus RNA in sterile sites and exclusion of other congenital infections",
    "notes": "Diagnosis is primarily clinical supported by molecular testing; early detection is critical for management."
  },
