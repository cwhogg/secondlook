  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate elevation or normal)",
      "Normal routine blood counts and metabolic panels"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle involvement and fatty infiltration",
      "Chest imaging may show restrictive lung disease features"
    ],
    "genetic": [
      "TPM3 (causative)",
      "ACTA1 (causative)",
      "NEB (causative)",
      "KLHL41 (causative, loss-of-function)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography demonstrating myopathic motor unit potentials",
      "Muscle biopsy with Gomori trichrome stain revealing nemaline rods"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "severe-congenital-nemaline-myopathy",
      "distinguishingFeatures": [
        "Earlier onset with more severe hypotonia and respiratory failure",
        "More profound muscle weakness and feeding difficulties",
        "Often lethal in infancy"
      ]
    },
    {
      "diseaseId": "mild-nemaline-myopathy",
      "distinguishingFeatures": [
        "Later onset with milder muscle weakness",
        "Minimal respiratory involvement",
        "Better motor function preservation"
      ]
    },
    {
      "diseaseId": "other-congenital-myopathies",
      "distinguishingFeatures": [
        "Absence of nemaline rods on muscle biopsy",
        "Different genetic mutations (e.g., central core disease, centronuclear myopathy)",
        "Distinct histopathological features"
      ]
    }
  ],
