  "diagnosticCriteria": {
    "formalCriteriaName": "Biochemical and Genetic Diagnostic Criteria for GAII",
    "criteria": [
      {
        "id": "biochemical-profile",
        "description": "Elevated plasma acylcarnitines and organic acids consistent with multiple acyl-CoA dehydrogenase deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in ETFA, ETFB, or ETFDH genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of hypoglycemia, metabolic acidosis, and muscle weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Ragged red fibers or lipid storage in muscle biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic biochemical profile plus pathogenic genetic variants or clinical presentation consistent with GAII",
    "notes": "Early diagnosis is critical due to potential for rapid metabolic decompensation"
  },
