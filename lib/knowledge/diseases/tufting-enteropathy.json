  "diagnosticCriteria": {
    "formalCriteriaName": "Tufting Enteropathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-intractable-diarrhea",
        "description": "Onset of severe, persistent, intractable diarrhea in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intestinal-biopsy-tufting",
        "description": "Histopathological evidence of epithelial 'tufting' on small intestinal biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epcam-mutation",
        "description": "Identification of biallelic pathogenic variants in the EPCAM gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-enteropathies",
        "description": "Exclusion of other causes of congenital diarrheal disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic intractable diarrhea from infancy plus characteristic intestinal biopsy findings and confirmation of EPCAM mutation",
    "notes": "Genetic testing is essential for definitive diagnosis; biopsy findings may overlap with other congenital enteropathies."
  },
