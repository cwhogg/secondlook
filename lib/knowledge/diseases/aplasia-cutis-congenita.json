    "formalCriteriaName": "Clinical Diagnostic Criteria for Aplasia Cutis Congenita",
    "criteria": [
      {
        "id": "absence-skin-lesion",
        "description": "Presence of a well-demarcated congenital absence of skin, typically on the scalp",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lesion-characteristics",
        "description": "Lesion may be ulcerated or scarred with variable depth involving epidermis and dermis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of skin defects such as trauma, infection, or epidermolysis bullosa",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history or genetic mutation associated with ACC",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "associated-anomalies",
        "description": "Presence of associated congenital anomalies (e.g., limb defects, scalp defects with underlying bone abnormalities)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital absence of skin lesion consistent with ACC and exclusion of other causes",
    "notes": "Diagnosis is primarily clinical; biopsy and genetic testing may support diagnosis in atypical cases"
  },
