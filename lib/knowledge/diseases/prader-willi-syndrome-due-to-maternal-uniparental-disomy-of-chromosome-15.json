  "diagnosticCriteria": {
    "formalCriteriaName": "Holm Criteria for Prader-Willi Syndrome",
    "criteria": [
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia with poor suck and feeding difficulties",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyperphagia",
        "description": "Onset of hyperphagia leading to obesity in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Molecular genetic confirmation of maternal uniparental disomy of chromosome 15",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypogonadism",
        "description": "Hypogonadism with genital hypoplasia and delayed or incomplete puberty",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "characteristic-facies",
        "description": "Characteristic facial features including narrow forehead, almond-shaped eyes, and thin upper lip",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of neonatal hypotonia and hyperphagia with molecular genetic confirmation of maternal uniparental disomy of chromosome 15",
    "notes": "Genetic testing is essential to differentiate from other causes of Prader-Willi syndrome"
  },
