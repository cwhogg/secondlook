  "keyFindings": {
    "laboratory": [
      "Presence of lupus anticoagulant, anticardiolipin antibodies, or anti-β2 glycoprotein I antibodies",
      "Thrombocytopenia and microangiopathic hemolytic anemia",
      "Elevated D-dimer and evidence of disseminated intravascular coagulation"
    ],
    "imaging": [
      "Multiorgan infarctions on CT or MRI",
      "Pulmonary embolism on chest CT angiography",
      "Echocardiography showing valvular vegetations"
    ],
    "genetic": [
      "No specific genetic mutations identified; association with autoimmune predisposition"
    ],
    "other": [
      "Histopathologic confirmation of small vessel thrombosis in affected tissues",
      "Rapid clinical deterioration with multiorgan failure"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "thrombotic-thrombocytopenic-purpura",
      "distinguishingFeatures": [
        "ADAMTS13 deficiency or inhibitor present",
        "Predominantly neurological and renal symptoms without antiphospholipid antibodies",
        "Slower progression compared to CAPS"
      ]
    },
    {
      "diseaseId": "disseminated-intravascular-coagulation",
      "distinguishingFeatures": [
        "Triggered by sepsis or trauma",
        "Widespread coagulation activation with bleeding tendency",
        "No persistent antiphospholipid antibodies"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset of multiorgan thrombosis within days",
    "Presence of high-titer antiphospholipid antibodies",
    "Evidence of small vessel occlusion on histopathology"
  ],
