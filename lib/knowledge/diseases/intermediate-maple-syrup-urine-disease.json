  "diagnosticCriteria": {
    "formalCriteriaName": "Biochemical and Genetic Diagnostic Criteria for MSUD",
    "criteria": [
      {
        "id": "elevated-bcaas",
        "description": "Elevated plasma branched-chain amino acids (leucine, isoleucine, valine) above diagnostic threshold",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urine-ketoacids",
        "description": "Presence of branched-chain ketoacids in urine organic acid analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bckd-complex-activity",
        "description": "Reduced activity of branched-chain alpha-ketoacid dehydrogenase complex in cultured fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in BCKDHA, BCKDHB, or DBT genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated plasma branched-chain amino acids plus presence of branched-chain ketoacids in urine and reduced BCKD complex activity",
    "notes": "Genetic testing supports diagnosis and guides prognosis but is not mandatory"
  },
