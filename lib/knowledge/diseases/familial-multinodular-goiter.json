  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Familial Diagnostic Criteria for Familial Multinodular Goiter",
    "criteria": [
      {
        "id": "family-history",
        "description": "Presence of multinodular goiter in two or more first-degree relatives",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thyroid-nodules",
        "description": "Palpable multinodular enlargement of the thyroid gland confirmed by ultrasound",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thyroid-function",
        "description": "Normal or mildly altered thyroid hormone levels without evidence of malignancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of multinodular goiter such as iodine deficiency or thyroiditis",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of multinodular goiter in at least two first-degree relatives plus clinical and ultrasound evidence of multinodular thyroid enlargement, with exclusion of other causes",
    "notes": "Genetic testing may support diagnosis but is not routinely required."
  },
