  "keyFindings": {
    "laboratory": [
      "Normal or nonspecific metabolic and genetic screening except for STXBP1 variant"
    ],
    "imaging": [
      "Brain MRI may be normal or show mild cerebral atrophy or delayed myelination"
    ],
    "genetic": [
      "STXBP1 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "EEG: Suppression-burst pattern or multifocal epileptiform discharges, especially in early infancy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "kcnq2-related-developmental-and-epileptic-encephalopathy",
      "distinguishingFeatures": [
        "KCNQ2 mutations affect potassium channels, not synaptic vesicle release",
        "KCNQ2-DEE often presents with neonatal seizures and less prominent movement disorders"
      ]
    },
    {
      "diseaseId": "scn2a-related-developmental-and-epileptic-encephalopathy",
      "distinguishingFeatures": [
        "SCN2A mutations affect sodium channels",
        "SCN2A-DEE may have later onset and different seizure types"
      ]
    },
    {
      "diseaseId": "cdkl5-deficiency-disorder",
      "distinguishingFeatures": [
        "CDKL5 mutations cause early-onset seizures, but often with Rett-like features and more severe cortical visual impairment"
      ]
    }
  ],
  "redFlags": [
    "Seizure onset in the first year of life with severe developmental delay",
    "Movement disorder in a child with early-onset epilepsy"
  ],
