  "keyFindings": {
    "laboratory": [
      "Genetic testing revealing PHOX2B polyalanine repeat expansion or other mutations",
      "Histopathological confirmation of aganglionosis in colonic biopsy"
    ],
    "imaging": [
      "Chest radiograph may show hypoventilation-related changes",
      "Abdominal X-ray or contrast enema demonstrating megacolon"
    ],
    "genetic": [
      "PHOX2B (causative)",
      "RET (causative)",
      "ASCL1 (causative)",
      "Autosomal dominant inheritance",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Polysomnography showing hypoventilation during sleep",
      "Autonomic function testing abnormalities"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-central-hypoventilation-syndrome",
      "distinguishingFeatures": [
        "Absence of Hirschsprung disease",
        "Similar respiratory phenotype but no intestinal aganglionosis"
      ]
    },
    {
      "diseaseId": "hirschsprung-disease-isolated",
      "distinguishingFeatures": [
        "No central hypoventilation",
        "Normal autonomic respiratory control"
      ]
    },
    {
      "diseaseId": "robinow-syndrome",
      "distinguishingFeatures": [
        "Distinct skeletal and facial abnormalities",
        "No central hypoventilation or Hirschsprung disease"
      ]
    }
  ],
  "redFlags": [
    "Severe hypoventilation during sleep requiring ventilatory support",
