  "diagnosticCriteria": {
    "formalCriteriaName": "NIH Consensus Criteria for Chronic GVHD",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical signs and symptoms in skin, liver, or gastrointestinal tract after allogeneic hematopoietic stem cell transplantation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Biopsy showing typical GVHD histological changes such as basal cell vacuolization and lymphocytic infiltration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes such as infection, drug reactions, or relapse of primary disease",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "laboratory-markers",
        "description": "Elevated inflammatory markers and abnormal liver function tests supportive but not diagnostic",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus histopathological confirmation and exclusion of other causes",
    "notes": "Diagnosis relies on clinical presentation post-transplant and histopathology; no single test is definitive."
  },
