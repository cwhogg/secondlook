  "diagnosticCriteria": {
    "formalCriteriaName": "Mohr-Majewski Diagnostic Criteria for OFD4",
    "criteria": [
      {
        "id": "oral-anomalies",
        "description": "Presence of cleft lip and/or cleft palate and multiple oral frenula",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digital-malformations",
        "description": "Preaxial polydactyly or brachydactyly of hands and feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Presence of short ribs or other skeletal anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the TMEM216 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (oral anomalies, digital malformations, and facial dysmorphism) with or without genetic confirmation",
    "notes": "Genetic testing can support diagnosis but is not mandatory; clinical presentation is key."
  },
