  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and radiological diagnostic criteria for Atelosteogenesis type III",
    "criteria": [
      {
        "id": "skeletal-dysplasia",
        "description": "Severe skeletal dysplasia with short limbs and joint dislocations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-findings",
        "description": "Characteristic radiographic features including absent or hypoplastic long bone epiphyses and vertebral anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features such as midface hypoplasia, micrognathia, and cleft palate",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the FLNB gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe skeletal dysplasia with characteristic radiological findings plus either facial dysmorphism or genetic confirmation",
    "notes": "Diagnosis is primarily clinical and radiological; genetic testing supports confirmation."
  },
