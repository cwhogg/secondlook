  "prevalence": {
    "estimate": "1 in 30,000",
    "range": "1 in 10,000 to 1 in 100,000",
    "classification": "rare"
  },
  "demographics": {
    "typicalOnsetAge": { "min": 3, "max": 55, "peak": 17 },
    "sexPredilection": "equal",
    "ethnicAssociations": [
      "Higher prevalence in Sardinia",
      "Higher prevalence in Japan",
      "Higher prevalence in Costa Rica",
      "Consanguineous populations"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Leipzig Scoring System for Wilson Disease (8th International Meeting on Wilson Disease, 2001)",
    "criteria": [
      {
        "id": "wd-c1",
        "description": "Kayser-Fleischer rings on slit-lamp examination",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "wd-c2",
        "description": "Low serum ceruloplasmin (<20 mg/dL)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "wd-c3",
        "description": "Elevated 24-hour urine copper (>40 µg/day; >100 µg/day highly suggestive)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "wd-c4",
        "description": "Elevated hepatic copper content (>250 µg/g dry weight)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "wd-c5",
        "description": "Pathogenic mutations in ATP7B gene (biallelic)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "wd-c6",
        "description": "Neuropsychiatric symptoms consistent with Wilson disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "wd-c7",
        "description": "Coombs-negative hemolytic anemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Leipzig score >= 4 based on combined clinical, biochemical, and genetic findings",
    "notes": "No single test is sufficient for diagnosis. A combination of clinical features, biochemistry, and genetics is typically required. Up to 50% of hepatic presentations lack Kayser-Fleischer rings."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Kayser-Fleischer rings",
        "snomedCode": "44867004",
        "frequency": 0.95,
        "bodySystem": "ophthalmologic",
        "notes": "Golden-brown copper deposits in Descemet's membrane; present in ~95% of neurologic presentations, ~50% of hepatic presentations"
      },
      {
        "symptomName": "Sunflower cataracts",
        "snomedCode": "95722004",
        "frequency": 0.15,
        "bodySystem": "ophthalmologic",
        "notes": "Copper deposition in lens; pathognomonic but uncommon"
      }
    ],
    "common": [
      {
        "symptomName": "Hepatic dysfunction (hepatitis, cirrhosis)",
        "snomedCode": "235856003",
        "frequency": 0.8,
        "bodySystem": "hepatic"
      },
      {
        "symptomName": "Tremor (wing-beating or postural)",
        "snomedCode": "26079004",
        "frequency": 0.6,
        "bodySystem": "neurological",
        "notes": "Wing-beating tremor is characteristic"
      },
      {
        "symptomName": "Dysarthria",
        "snomedCode": "8011004",
        "frequency": 0.55,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Dystonia",
        "snomedCode": "15802004",
        "frequency": 0.5,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Psychiatric symptoms (personality changes, depression, psychosis)",
        "snomedCode": "74732009",
        "frequency": 0.5,
        "bodySystem": "neuropsychiatric"
      }
