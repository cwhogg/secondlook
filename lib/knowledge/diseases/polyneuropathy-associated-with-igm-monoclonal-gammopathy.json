  "keyFindings": {
    "laboratory": [
      "Serum protein electrophoresis showing IgM monoclonal gammopathy",
      "Presence of anti-MAG antibodies in serum",
      "Elevated cerebrospinal fluid protein with normal cell count (albuminocytologic dissociation)"
    ],
    "imaging": [
      "MRI of peripheral nerves may show nerve enlargement",
      "Nerve ultrasound demonstrating nerve hypertrophy"
    ],
    "genetic": [
      "No specific genetic mutations identified; sporadic or associated with monoclonal gammopathy"
    ],
    "other": [
      "Nerve conduction studies showing demyelinating features with prolonged distal latencies and slowed conduction velocities",
      "Nerve biopsy may show demyelination and onion bulb formations"
    ]
  },
  "differentialDiagnoses": [
