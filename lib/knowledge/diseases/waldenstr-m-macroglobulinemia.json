  "keyFindings": {
    "laboratory": [
      "Serum protein electrophoresis showing monoclonal IgM spike",
      "Bone marrow biopsy with lymphoplasmacytic infiltration",
      "Presence of MYD88 L265P mutation in majority of cases",
      "Elevated serum viscosity"
    ],
    "imaging": [
      "CT scan showing lymphadenopathy and hepatosplenomegaly",
      "MRI brain in suspected Bing-Neel syndrome"
    ],
    "genetic": [
      "MYD88 (somatic)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Serum viscosity measurement",
      "Cryoglobulin testing"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "multiple-myeloma",
      "distinguishingFeatures": [
        "Predominant IgG or IgA paraprotein rather than IgM",
        "Lytic bone lesions",
        "Higher plasma cell percentage in marrow"
      ]
    },
    {
      "diseaseId": "chronic-lymphocytic-leukemia",
      "distinguishingFeatures": [
        "CD5 positive B cells",
        "Absence of IgM monoclonal gammopathy",
        "Different marrow infiltration pattern"
      ]
    },
    {
      "diseaseId": "marginal-zone-lymphoma",
      "distinguishingFeatures": [
        "Usually extranodal involvement",
        "IgM paraprotein less common",
        "Different immunophenotype"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive hyperviscosity symptoms (blurred vision, headache, confusion)",
    "Severe anemia with symptomatic fatigue or dyspnea",
    "Neurological deficits suggestive of CNS involvement (Bing-Neel syndrome)"
  ],
