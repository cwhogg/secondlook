  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for CMT2W",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of a length-dependent sensorimotor neuropathy with distal muscle weakness and atrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electrophysiological evidence of axonal neuropathy with reduced compound muscle action potential amplitudes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic heterozygous mutations in the HSPB1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-atrophy-pattern",
        "description": "Predominant distal lower limb muscle atrophy and weakness",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical neuropathy, electrophysiological evidence of axonal neuropathy, and pathogenic HSPB1 mutation",
    "notes": "Genetic confirmation is essential due to phenotypic overlap with other CMT subtypes"
  },
