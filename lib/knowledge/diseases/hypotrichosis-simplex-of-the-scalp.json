        "requiredForDiagnosis": true
      },
      {
        "id": "absence-other-hair-loss",
        "description": "Lack of involvement of other hair-bearing areas (eyebrows, eyelashes, body hair)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-scalp-skin",
        "description": "Normal scalp skin without scarring or inflammation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes such as CDSN or APCDD1",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive diffuse scalp hair thinning starting in early childhood, absence of other hair loss areas, and positive family history",
    "notes": "Diagnosis is primarily clinical; genetic testing can confirm but is not mandatory"
