  "diagnosticCriteria": {
    "formalCriteriaName": "Renal Tubular Dysgenesis Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histological evidence of absent or severely underdeveloped proximal renal tubules",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Severe oligohydramnios or anhydramnios detected prenatally",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic mutations in genes related to the renin-angiotensin system (e.g., ACE, AGT, REN, AGTR1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ultrasound-findings",
        "description": "Ultrasound showing hyperechogenic kidneys with poor corticomedullary differentiation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Neonatal refractory hypotension and anuria",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of histopathological confirmation plus clinical presentation and/or genetic confirmation",
    "notes": "Prenatal diagnosis is possible via ultrasound and genetic testing; postnatal confirmation requires histopathology."
  },
