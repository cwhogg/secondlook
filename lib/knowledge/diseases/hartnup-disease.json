  "diagnosticCriteria": {
    "formalCriteriaName": "Hartnup Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "neutral-aminoaciduria",
        "description": "Presence of neutral aminoaciduria demonstrated by increased urinary excretion of neutral amino acids",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pellagra-like-dermatitis",
        "description": "Pellagra-like photosensitive skin rash, especially on sun-exposed areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-symptoms",
        "description": "Neurological manifestations such as cerebellar ataxia, tremors, or psychiatric symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consanguinity or family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the SLC6A19 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of neutral aminoaciduria plus either pellagra-like dermatitis or neurological symptoms",
    "notes": "Diagnosis is supported by genetic testing and family history but primarily clinical and biochemical."
  },
