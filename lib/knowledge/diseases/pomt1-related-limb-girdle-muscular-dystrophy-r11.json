  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for POMT1-related LGMD R11",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness predominantly affecting limb-girdle muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes with reduced or abnormal alpha-dystroglycan glycosylation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic biallelic variants in the POMT1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Electromyography demonstrating myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "serum-creatine-kinase",
        "description": "Elevated serum creatine kinase levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal muscle weakness with confirmatory muscle biopsy findings and identification of pathogenic POMT1 variants",
    "notes": "Diagnosis requires integration of clinical, histopathological, and genetic data."
  },
