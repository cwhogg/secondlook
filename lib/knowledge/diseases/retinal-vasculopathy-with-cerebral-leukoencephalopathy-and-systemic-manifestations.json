  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for RVCL-S",
    "criteria": [
      {
        "id": "retinal-vasculopathy",
        "description": "Presence of characteristic retinal microvascular abnormalities including telangiectasia and microaneurysms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebral-leukoencephalopathy",
        "description": "MRI evidence of cerebral white matter lesions consistent with leukoencephalopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "systemic-manifestations",
        "description": "Systemic features such as renal impairment, liver dysfunction, or neurological deficits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic TREX1 gene mutation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of retinal vasculopathy, cerebral leukoencephalopathy on imaging, and systemic manifestations; genetic confirmation supports diagnosis",
    "notes": "Genetic testing for TREX1 mutations is strongly recommended to confirm diagnosis."
  },
