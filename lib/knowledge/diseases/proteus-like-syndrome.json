  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific biochemical markers",
      "Genetic testing negative for PTEN mutations"
    ],
    "imaging": [
      "MRI or CT showing asymmetric tissue overgrowth",
      "Vascular imaging demonstrating malformations",
      "Skeletal X-rays revealing deformities and asymmetry"
    ],
    "genetic": [
      "PTEN (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology of connective tissue nevi showing characteristic features",
      "Clinical observation of progressive asymmetric overgrowth"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "proteus-syndrome",
      "distinguishingFeatures": [
        "Confirmed AKT1 mutation",
        "More extensive and severe overgrowth",
        "Classic cerebriform connective tissue nevi"
      ]
    },
    {
      "diseaseId": "pten-hamartoma-tumor-syndrome",
      "distinguishingFeatures": [
        "Presence of PTEN gene mutation",
        "Multiple hamartomas without mosaic asymmetric overgrowth",
        "Higher risk of malignancies"
      ]
    },
    {
      "diseaseId": "klippel-trenaunay-syndrome",
      "distinguishingFeatures": [
        "Capillary malformations (port-wine stains)",
        "Venous and lymphatic malformations with limb hypertrophy",
        "Absence of connective tissue nevi"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of asymmetric overgrowth",
    "Development of deep vein thrombosis or pulmonary embolism",
    "Signs of malignant transformation in overgrown tissues"
  ],
