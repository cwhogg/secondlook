  "diagnosticCriteria": {
    "formalCriteriaName": "Netchine-Harbison Clinical Scoring System (NH-CSS)",
    "criteria": [
      {
        "id": "prenatal-growth-retardation",
        "description": "Prenatal growth retardation with birth weight and/or length ≤ -2 SD",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "postnatal-growth-retardation",
        "description": "Postnatal growth failure with height ≤ -2 SD at 24 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "relative-macrocephaly",
        "description": "Relative macrocephaly at birth (head circumference ≥ 1.5 SD above birth weight/length)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "body-hemihypoplasia",
        "description": "Body asymmetry (hemihypoplasia)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "feeding-difficulties",
        "description": "Feeding difficulties and/or low BMI ≤ -2 SD at 24 months",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "protruding-forehead",
        "description": "Prominent forehead during early childhood",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "At least 4 of 6 criteria including all 3 major criteria",
    "notes": "Genetic testing confirming a pathogenic point mutation in SRS-associated genes supports diagnosis."
  },
