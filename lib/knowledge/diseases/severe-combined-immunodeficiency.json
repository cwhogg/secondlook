  "diagnosticCriteria": {
    "formalCriteriaName": "ESID Diagnostic Criteria for SCID",
    "criteria": [
      {
        "id": "lymphopenia",
        "description": "Profound lymphopenia with markedly reduced T-cell counts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-t-cell-function",
        "description": "Absent or severely impaired T-cell function demonstrated by mitogen response testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogammaglobulinemia",
        "description": "Low or absent immunoglobulin levels (IgG, IgA, IgM)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of SCID or early infant deaths from infections",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in known SCID-associated genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of profound lymphopenia with severely impaired T-cell function and hypogammaglobulinemia",
    "notes": "Genetic testing is recommended to confirm diagnosis and guide treatment."
  },
