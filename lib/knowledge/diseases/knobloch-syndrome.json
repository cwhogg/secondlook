  "diagnosticCriteria": {
    "formalCriteriaName": "Knobloch Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "ocular-abnormalities",
        "description": "Presence of high myopia with vitreoretinal degeneration and retinal detachment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "occipital-defect",
        "description": "Occipital skull defect or encephalocele",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "COL18A1-mutation",
        "description": "Pathogenic variants in the COL18A1 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "additional-features",
        "description": "Other features such as cataracts, lens subluxation, or developmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria: ocular abnormalities (high myopia with vitreoretinal degeneration) and occipital skull defect or encephalocele",
    "notes": "Genetic testing for COL18A1 mutations supports diagnosis but is not mandatory."
  },
