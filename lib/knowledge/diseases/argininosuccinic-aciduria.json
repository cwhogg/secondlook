  "diagnosticCriteria": {
    "formalCriteriaName": "Argininosuccinic Aciduria Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-argininosuccinic-acid",
        "description": "Elevated argininosuccinic acid levels in plasma and/or urine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-assay-deficiency",
        "description": "Reduced argininosuccinate lyase enzyme activity in fibroblasts or liver tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "asl-gene-mutation",
        "description": "Identification of pathogenic mutations in the ASL gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyperammonemia",
        "description": "Presence of hyperammonemia during metabolic decompensation episodes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Clinical features consistent with urea cycle disorder such as vomiting, lethargy, and developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated argininosuccinic acid plus either reduced enzyme activity or pathogenic ASL gene mutations",
    "notes": "Molecular genetic testing is confirmatory; enzyme assay may be required if genetic testing is inconclusive."
  },
