  "differentialDiagnoses": [
    {
      "diseaseId": "nemaline-myopathy",
      "distinguishingFeatures": [
        "Presence of nemaline rods on muscle biopsy instead of tubular aggregates",
        "Earlier onset in many cases",
        "Different genetic mutations (e.g., NEB, ACTA1)"
      ]
    },
    {
      "diseaseId": "central-core-disease",
      "distinguishingFeatures": [
        "Muscle biopsy shows central cores rather than tubular aggregates",
        "Often associated with RYR1 mutations",
        "May have malignant hyperthermia susceptibility"
      ]
    },
    {
      "diseaseId": "inclusion-body-myopathy",
      "distinguishingFeatures": [
        "Presence of rimmed vacuoles and inclusion bodies on biopsy",
        "Typically adult onset with distal weakness",
        "Different genetic causes (e.g., GNE mutations)"
      ]
    }
