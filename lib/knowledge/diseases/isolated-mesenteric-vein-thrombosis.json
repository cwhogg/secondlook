  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Mesenteric Vein Thrombosis",
    "criteria": [
      {
        "id": "imaging-confirmation",
        "description": "Radiological evidence of thrombosis in mesenteric veins on contrast-enhanced CT or MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Acute or subacute abdominal pain disproportionate to physical findings",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "laboratory-markers",
        "description": "Elevated D-dimer and inflammatory markers supportive but not specific",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-arterial-thrombosis",
        "description": "Absence of arterial mesenteric ischemia on imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of imaging-confirmed mesenteric vein thrombosis with compatible clinical presentation",
    "notes": "Diagnosis requires exclusion of other causes of abdominal pain and vascular occlusion."
  },
