  "keyFindings": {
    "laboratory": [
      "Sputum cultures positive for Pseudomonas aeruginosa or Haemophilus influenzae",
      "Elevated inflammatory markers during exacerbations (e.g., ESR, CRP)"
    ],
    "imaging": [
      "HRCT showing bronchial dilation, lack of bronchial tapering, and bronchial wall thickening",
      "Mucus plugging and tree-in-bud opacities on HRCT"
    ],
    "genetic": [
      "CFTR (candidate)",
      "SCNN1A (causative)",
      "SCNN1B (causative)",
      "SCNN1G (causative)"
    ],
    "other": [
      "Pulmonary function tests showing obstructive or mixed ventilatory defects",
      "Bronchoscopy may show inflamed airways and purulent secretions"
    ]
  },
