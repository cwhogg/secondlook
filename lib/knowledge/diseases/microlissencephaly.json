  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Genetic testing revealing pathogenic variants in RELN, WDR62, or other associated genes"
    ],
    "imaging": [
      "MRI showing smooth cerebral cortex with absent or reduced gyri (lissencephaly)",
      "Reduced brain volume consistent with microcephaly"
    ],
    "genetic": [
      "Mutations in genes such as RELN, WDR62, TUBA1A, and others linked to microlissencephaly",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Abnormal EEG with epileptiform discharges",
      "Developmental assessments confirming severe delay"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "classic-lissencephaly",
      "distinguishingFeatures": [
        "Normal or near-normal head circumference",
        "More uniform cortical thickening without microcephaly",
        "Different genetic mutations (e.g., LIS1, DCX)"
      ]
    },
    {
      "diseaseId": "microcephaly-primary",
      "distinguishingFeatures": [
        "Microcephaly without cortical malformations",
        "Normal gyral pattern on neuroimaging",
        "Often caused by environmental or infectious etiologies"
      ]
    },
    {
      "diseaseId": "cobblestone-lissencephaly",
      "distinguishingFeatures": [
        "Irregular, pebbled cortical surface on imaging",
        "Associated muscular dystrophies",
        "Distinct genetic causes (e.g., POMT1, POMGNT1)"
      ]
    }
  ],
  "redFlags": [
    "Severe microcephaly detected prenatally or at birth",
