  "diagnosticCriteria": {
    "formalCriteriaName": "Joubert Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "molar-tooth-sign",
        "description": "Presence of the molar tooth sign on brain MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia with developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-defect",
        "description": "Documented ocular abnormalities such as oculomotor apraxia or retinal dystrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "breathing-abnormalities",
        "description": "Abnormal respiratory pattern in infancy (episodic tachypnea/apnea)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cognitive-impairment",
        "description": "Variable intellectual disability or developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of molar tooth sign on MRI plus hypotonia and at least one ocular defect",
    "notes": "Diagnosis is clinical and radiological; genetic testing can support diagnosis but is not mandatory."
  },
