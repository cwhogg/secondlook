  "diagnosticCriteria": {
    "formalCriteriaName": "MAN1B1-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypotonia",
        "description": "Congenital hypotonia presenting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-n-glycosylation",
        "description": "Abnormal serum transferrin glycosylation pattern detected by isoelectric focusing or mass spectrometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "man1b1-mutation",
        "description": "Biallelic pathogenic variants in the MAN1B1 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Presence of mild facial dysmorphic features such as hypertelorism and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic MAN1B1 pathogenic variants plus abnormal N-glycosylation pattern and clinical features including hypotonia and intellectual disability",
    "notes": "Diagnosis requires integration of clinical, biochemical, and genetic findings."
  },
