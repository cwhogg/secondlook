  "diagnosticCriteria": {
    "formalCriteriaName": "IGF-1 Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "short-stature",
        "description": "Height below the 3rd percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-serum-igf1",
        "description": "Serum insulin-like growth factor 1 levels below age- and sex-matched reference range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-gh-levels",
        "description": "Normal or elevated growth hormone levels excluding GH deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the IGF1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "delayed-bone-age",
        "description": "Radiological evidence of delayed bone age compared to chronological age",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of short stature with low serum IGF-1 levels and normal or elevated growth hormone levels",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory; exclusion of other causes of growth delay is essential."
  },
