  "diagnosticCriteria": {
    "formalCriteriaName": "APDS1 Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of heterozygous gain-of-function mutation in PIK3CD gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-respiratory-infections",
        "description": "History of recurrent sinopulmonary infections including bronchiectasis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphoproliferation",
        "description": "Presence of lymphadenopathy, splenomegaly, or hepatomegaly",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "immunoglobulin-abnormalities",
        "description": "Hypogammaglobulinemia or elevated IgM levels",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "autoimmune-manifestations",
        "description": "Autoimmune cytopenias or other autoimmune phenomena",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of PIK3CD mutation plus at least one major clinical criterion",
    "notes": "Diagnosis relies heavily on genetic testing combined with clinical features of immunodeficiency and lymphoproliferation."
  },
