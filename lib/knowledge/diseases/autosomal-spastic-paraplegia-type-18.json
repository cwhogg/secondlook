  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of metabolic and infectious causes"
    ],
    "imaging": [
      "MRI brain and spinal cord may show mild corticospinal tract degeneration",
      "Possible mild cerebellar atrophy"
    ],
    "genetic": [
      "ERLIN2 (causative)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography may show mild peripheral neuropathy",
      "Nerve conduction studies may be normal or mildly abnormal"
    ]
  },
