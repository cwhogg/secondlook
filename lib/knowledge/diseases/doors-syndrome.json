      "Audiometric testing confirming sensorineural deafness",
      "Nail examination revealing dystrophic changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "doose-syndrome",
      "distinguishingFeatures": [
        "Myoclonic-astatic epilepsy without nail or skeletal abnormalities",
        "Normal nails and digits"
      ]
    },
    {
      "diseaseId": "mohr-tranebjaerg-syndrome",
      "distinguishingFeatures": [
        "Progressive sensorineural deafness with dystonia and optic atrophy",
        "No onychodystrophy or osteodystrophy"
      ]
    },
    {
      "diseaseId": "nail-patella-syndrome",
      "distinguishingFeatures": [
        "Nail dysplasia with patellar hypoplasia",
        "No intellectual disability or deafness"
      ]
    }
  ],
