  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiographic Diagnostic Criteria for Thanatophoric Dysplasia",
    "criteria": [
      {
        "id": "fgfr3-mutation",
        "description": "Presence of pathogenic FGFR3 gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "extreme-limb-shortening",
        "description": "Severe shortening of the limbs (micromelia) evident on prenatal or postnatal imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "narrow-thorax",
        "description": "Narrow thoracic cage with short ribs causing respiratory insufficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "macrocephaly",
        "description": "Macrocephaly with frontal bossing",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cloverleaf-skull",
        "description": "Cloverleaf skull deformity (more common in Type II)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of FGFR3 mutation plus severe limb shortening and narrow thorax on imaging",
    "notes": "Genetic testing is confirmatory; prenatal ultrasound findings are critical for early diagnosis."
  },
