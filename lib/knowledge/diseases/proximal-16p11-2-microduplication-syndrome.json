  "diagnosticCriteria": {
    "formalCriteriaName": "Chromosomal Microduplication Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of proximal 16p11.2 microduplication by chromosomal microarray or other molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Presence of global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurobehavioral-features",
        "description": "Neurobehavioral abnormalities including autism spectrum disorder or speech delay",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "dysmorphic-features",
        "description": "Mild craniofacial dysmorphic features such as macrocephaly or facial asymmetry",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "History of seizures or epilepsy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of proximal 16p11.2 microduplication plus at least one major clinical feature such as developmental delay or neurobehavioral abnormalities",
    "notes": "Diagnosis relies primarily on molecular genetic testing; clinical features are variable and incomplete penetrance is common."
  },
