  "diagnosticCriteria": {
    "formalCriteriaName": "Infantile-onset Axonal Motor and Sensory Neuropathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of progressive axonal motor and sensory neuropathy with onset in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "optic-atrophy",
        "description": "Bilateral optic atrophy confirmed by ophthalmological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurodegeneration",
        "description": "Evidence of neurodegenerative progression on neurological examination and/or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies demonstrating axonal neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in associated genes (if known)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (infantile-onset axonal motor and sensory neuropathy, bilateral optic atrophy, and neurodegenerative progression) must be present.",
    "notes": "Genetic confirmation is supportive but not mandatory for diagnosis."
  },
