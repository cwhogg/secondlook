  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Diagnostic Criteria for Acral Peeling Skin Syndrome",
    "criteria": [
      {
        "id": "clinical-peeling",
        "description": "Recurrent painless peeling of the skin localized to acral areas (hands and feet)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological evidence of separation within the stratum corneum without inflammation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the TGM5 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or family history of similar acral skin peeling",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent acral skin peeling with histopathological confirmation; genetic testing supports diagnosis",
    "notes": "Diagnosis is primarily clinical supported by histopathology; genetic testing confirms but is not mandatory"
  },
