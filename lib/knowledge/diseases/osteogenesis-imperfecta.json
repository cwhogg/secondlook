  "keyFindings": {
    "laboratory": [
      "Bone turnover markers may be abnormal (elevated alkaline phosphatase during fractures)",
      "DEXA scan shows reduced bone mineral density",
      "Type I procollagen analysis on fibroblasts (historical)"
    ],
    "imaging": [
      "Skeletal radiographs showing osteopenia, fractures in various stages of healing",
      "Wormian bones on skull radiograph",
      "Bowing and deformity of long bones",
      "Vertebral compression fractures on spine imaging",
      "DEXA scan for bone density quantification"
    ],
    "genetic": [
      "COL1A1 mutations (most common, ~70-80% of OI cases; quantitative defects in Type I)",
      "COL1A2 mutations (qualitative/structural collagen defects)",
      "IFITM5 mutations (OI Type V, with hyperplastic callus)",
      "Autosomal recessive genes: CRTAP, LEPRE1/P3H1, PPIB, SERPINF1, SERPINH1, BMP1, WNT1, TMEM38B, SPARC, etc.",
      "Autosomal dominant in most cases; recessive forms account for 5-10%",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Clinical assessment of fracture history and family pedigree",
      "Dental examination for dentinogenesis imperfecta",
      "Audiometry for hearing assessment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ehlers-danlos-classical",
      "distinguishingFeatures": [
        "cEDS has marked skin hyperextensibility (absent in OI)",
        "cEDS has atrophic scarring",
        "OI has bone fragility as primary feature",
        "Some overlap with rare COL1A1 variants"
      ]
    },
    {
      "diseaseId": "marfan-syndrome",
      "distinguishingFeatures": [
        "Marfan features tall stature (OI often short stature)",
        "Marfan has aortic root dilation and ectopia lentis",
        "OI has bone fragility and fractures"
      ]
    }
  ],
  "redFlags": [
    "Multiple fractures in infancy or childhood (must distinguish from non-accidental injury)",
    "Basilar invagination symptoms (headache, dysphagia, cranial nerve palsies, myelopathy)",
    "Progressive scoliosis with cardiopulmonary compromise",
    "Blue sclerae alone is insufficient - many infants have blue sclerae normally",
    "Fractures with no trauma or minimal trauma across different stages of healing"
  ],
  "specialistType": [
    "Medical Geneticist",
    "Orthopedic Surgeon",
    "Endocrinologist",
    "Pediatric Specialist (for childhood cases)",
    "Audiologist",
    "Dentist (specialized in OI)"
  ],
