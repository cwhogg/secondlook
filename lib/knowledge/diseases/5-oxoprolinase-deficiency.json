  "diagnosticCriteria": {
    "formalCriteriaName": "Biochemical and Genetic Diagnostic Criteria for 5-Oxoprolinase Deficiency",
    "criteria": [
      {
        "id": "elevated-pyroglutamic-acid",
        "description": "Persistent elevated levels of pyroglutamic acid in urine detected by organic acid analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-activity-deficiency",
        "description": "Demonstrated deficiency of 5-oxoprolinase enzyme activity in cultured fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biallelic-oxoprolinase-mutations",
        "description": "Identification of pathogenic biallelic mutations in the OXOPROLINASE (OPLAH) gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical features consistent with metabolic acidosis and neurological impairment",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated urinary pyroglutamic acid plus either confirmed enzyme deficiency or biallelic pathogenic OPLAH mutations",
    "notes": "Diagnosis requires biochemical confirmation and genetic testing due to phenotypic variability."
  },
