  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "MRI showing abnormal cortical lamination with multiple small gyri localized to one hemisphere",
      "Possible associated white matter abnormalities adjacent to polymicrogyria"
    ],
    "genetic": [
      "Mutations in genes associated with cortical development such as TUBB2B, PIK3R2, or WDR62 in some cases"
    ],
    "other": [
      "Electroencephalogram (EEG) showing focal epileptiform discharges corresponding to affected cortical regions"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "bilateral-polymicrogyria",
      "distinguishingFeatures": [
        "Involvement of both cerebral hemispheres",
        "More diffuse neurological deficits",
        "Often more severe developmental delay"
      ]
    },
    {
      "diseaseId": "focal-cortical-dysplasia",
      "distinguishingFeatures": [
        "Focal cortical thickening without multiple small gyri",
        "Different MRI pattern without polymicrogyria",
        "May present with focal seizures but lacks polymicrogyria histology"
      ]
    }
  ],
