  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Down Syndrome",
    "criteria": [
      {
        "id": "trisomy-21",
        "description": "Presence of full or partial trisomy of chromosome 21 confirmed by karyotype",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facial-features",
        "description": "Typical facial dysmorphisms including upslanting palpebral fissures, epicanthal folds, flat nasal bridge, and macroglossia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Generalized hypotonia present in infancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay and intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed trisomy 21 by cytogenetic analysis plus characteristic clinical features",
    "notes": "Prenatal diagnosis can be made by non-invasive prenatal testing or invasive cytogenetic analysis."
  },
