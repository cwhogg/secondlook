  "keyFindings": {
    "laboratory": [
      "Absent or reduced sweat response on quantitative sudomotor axon reflex test",
      "Normal routine blood tests"
    ],
    "imaging": [
      "X-rays showing Charcot joints and bone fractures",
      "MRI may show peripheral nerve abnormalities"
    ],
    "genetic": [
      "Pathogenic mutations in NTRK1 gene confirmed by molecular genetic testing"
    ],
    "other": [
      "Nerve biopsy showing loss of small myelinated and unmyelinated fibers",
      "Absent intraepidermal nerve fibers on skin biopsy"
    ]
  },
