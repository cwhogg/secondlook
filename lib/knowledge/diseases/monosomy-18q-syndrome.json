  "keyFindings": {
    "laboratory": [
      "Thyroid function tests showing hypothyroidism",
      "Growth hormone levels may be decreased"
    ],
    "imaging": [
      "Brain MRI may show white matter abnormalities",
      "Echocardiogram revealing congenital heart defects",
      "Skeletal X-rays showing scoliosis or foot deformities"
    ],
    "genetic": [
      "Fluorescence in situ hybridization (FISH) or microarray confirming deletion of distal 18q",
      "Karyotyping demonstrating monosomy or partial deletion of chromosome 18q",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Audiometry confirming sensorineural or conductive hearing loss",
      "Neurodevelopmental assessments documenting delays"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "trisomy-18-patau-syndrome",
      "distinguishingFeatures": [
        "Presence of trisomy 18 or 13 instead of deletion",
        "More severe congenital anomalies and early lethality",
        "Distinct facial features different from 18q deletion"
      ]
    },
    {
      "diseaseId": "22q11-deletion-syndrome",
      "distinguishingFeatures": [
        "Deletion on chromosome 22q11 rather than 18q",
        "Characteristic cardiac defects and immunodeficiency",
        "Distinct facial dysmorphism and palatal abnormalities"
      ]
    }
  ],
  "redFlags": [
    "Severe congenital hypotonia with feeding difficulties",
    "Progressive developmental regression",
    "Unexplained congenital heart defects in a neonate"
  ],
