  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP indicating inflammation",
      "Negative rheumatoid factor (RF) on repeated testing",
      "Possible mild anemia of chronic disease"
    ],
    "imaging": [
      "X-ray showing joint space narrowing and erosions",
      "MRI demonstrating synovitis and enthesitis"
    ],
    "genetic": [
      "Association with HLA-B27 in some patients",
      "Family history of psoriasis or psoriatic arthritis"
    ],
    "other": [
      "Nail changes including pitting and onycholysis",
      "Skin biopsy confirming psoriasis if diagnosis uncertain"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "oligoarticular-juvenile-idiopathic-arthritis",
      "distinguishingFeatures": [
        "Absence of psoriasis or family history of psoriasis",
        "Usually ANA positive",
        "Less frequent dactylitis and nail changes"
      ]
    },
    {
      "diseaseId": "enthesitis-related-juvenile-idiopathic-arthritis",
      "distinguishingFeatures": [
        "Strong association with HLA-B27",
        "Predominantly affects lower limb entheses",
        "Usually male predominance and older age at onset"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive joint destruction",
    "Unexplained high fever or systemic symptoms",
    "Signs of uveitis such as eye pain or vision changes"
  ],
