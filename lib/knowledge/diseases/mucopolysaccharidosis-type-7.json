  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Mucopolysaccharidosis type 7",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of beta-glucuronidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-gags",
        "description": "Elevated urinary glycosaminoglycans (GAGs), especially dermatan sulfate and chondroitin sulfate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the GUSB gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features such as coarse facial features and skeletal dysplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of beta-glucuronidase enzyme activity plus elevated urinary GAGs or pathogenic GUSB gene variants",
    "notes": "Diagnosis is confirmed by enzyme assay and/or molecular genetic testing."
  },
