  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of metabolic, infectious, and inflammatory causes"
    ],
    "imaging": [
      "MRI brain and spinal cord typically normal or nonspecific",
      "Exclusion of structural lesions compressing motor neurons"
    ],
    "genetic": [
      "CHCHD10 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography showing chronic denervation and reinnervation patterns",
      "Nerve conduction studies typically normal sensory responses"
    ]
  },
