  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Acrocephalopolydactyly (Apert Syndrome)",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of coronal sutures leading to acrocephaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "syndactyly",
        "description": "Complex syndactyly of hands and feet involving fusion of digits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midface_hypoplasia",
        "description": "Midfacial hypoplasia with flat nasal bridge and shallow orbits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "palatal_abnormalities",
        "description": "Presence of high-arched or cleft palate",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing_loss",
        "description": "Conductive or sensorineural hearing impairment",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis, syndactyly of hands and feet, and midface hypoplasia",
    "notes": "Genetic testing for FGFR2 mutations can confirm diagnosis"
  },
