  "diagnosticCriteria": {
    "formalCriteriaName": "Pulmonary Artery Sarcoma Diagnostic Criteria",
    "criteria": [
      {
        "id": "imaging-mass",
        "description": "Presence of an intraluminal mass in the pulmonary artery on imaging studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology-confirmation",
        "description": "Histopathological confirmation of sarcomatous tumor cells from biopsy or surgical specimen",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "embolism-mimicry",
        "description": "Clinical and radiological features mimicking chronic pulmonary thromboembolism but unresponsive to anticoagulation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation plus imaging evidence of pulmonary artery mass",
    "notes": "Diagnosis is often delayed due to clinical similarity to pulmonary embolism."
  },
