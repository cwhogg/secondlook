  "keyFindings": {
    "laboratory": [
      "Possible elevated lactate in blood or CSF",
      "Normal metabolic screening excluding other causes"
    ],
    "imaging": [
      "Bilateral symmetric necrosis of the striatum on MRI T2-weighted images",
      "No evidence of other brain lesions"
    ],
    "genetic": [
      "No consistent genetic mutation identified; sporadic cases",
      "Genetic testing to exclude inherited basal ganglia disorders"
    ],
    "other": [
      "Progressive extrapyramidal movement disorder in infancy",
      "Absence of family history"
    ]
  },
