  "diagnosticCriteria": {
    "formalCriteriaName": "Biotinidase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced or absent serum biotinidase enzyme activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of neurological symptoms such as seizures or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the BTD gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-biotin",
        "description": "Clinical improvement with biotin supplementation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Reduced biotinidase enzyme activity plus either clinical features consistent with the disorder or pathogenic BTD gene variants",
    "notes": "Newborn screening programs often detect enzyme deficiency before symptom onset."
  },
