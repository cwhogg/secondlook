  "diagnosticCriteria": {
    "formalCriteriaName": "Kocher-Debre-Semelaigne Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypothyroidism",
        "description": "Biochemical evidence of hypothyroidism (elevated TSH, low free T4)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscular-pseudohypertrophy",
        "description": "Presence of muscular pseudohypertrophy predominantly in calves and limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "delayed-motor-development",
        "description": "Delayed motor milestones and muscle weakness",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyographic evidence of myopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-thyroid-hormone",
        "description": "Improvement of symptoms with thyroid hormone replacement therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biochemical hypothyroidism and muscular pseudohypertrophy with clinical features consistent with hypothyroid myopathy",
    "notes": "Diagnosis is supported by electromyography and clinical improvement after thyroid hormone therapy."
  },
