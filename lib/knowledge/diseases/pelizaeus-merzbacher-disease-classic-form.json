  "diagnosticCriteria": {
    "formalCriteriaName": "Pelizaeus-Merzbacher Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive nystagmus, hypotonia, and developmental delay presenting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing diffuse hypomyelination with T2 hyperintensity in cerebral white matter",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of PLP1 gene mutation or duplication",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Evoked potentials showing delayed conduction consistent with hypomyelination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical presentation plus confirmatory MRI findings and identification of PLP1 mutation",
    "notes": "Genetic testing is definitive; clinical and imaging findings guide initial suspicion."
  },
