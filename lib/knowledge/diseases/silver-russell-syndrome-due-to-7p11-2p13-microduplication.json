  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Silver-Russell syndrome variants",
    "criteria": [
      {
        "id": "prenatal-growth-retardation",
        "description": "Intrauterine growth retardation with birth weight and length below the 3rd percentile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "postnatal-growth-failure",
        "description": "Persistent postnatal growth failure with height below the 3rd percentile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic triangular face with prominent forehead and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-asymmetry",
        "description": "Body or limb asymmetry (hemihypoplasia or hemihypertrophy)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "7p11-2p13-microduplication",
        "description": "Presence of 7p11.2p13 microduplication confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of prenatal and postnatal growth retardation, characteristic facial features, and confirmation of 7p11.2p13 microduplication by genetic testing",
    "notes": "Diagnosis requires exclusion of other genetic causes of Silver-Russell syndrome such as 11p15 imprinting defects or maternal uniparental disomy 7"
  },
