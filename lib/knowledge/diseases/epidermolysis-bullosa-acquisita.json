  "diagnosticCriteria": {
    "formalCriteriaName": "Epidermolysis Bullosa Acquisita Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-blistering",
        "description": "Presence of tense blisters and erosions on trauma-prone skin areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence",
        "description": "Linear deposition of IgG and/or C3 along the dermal-epidermal junction on direct immunofluorescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serologic-testing",
        "description": "Circulating autoantibodies against type VII collagen detected by ELISA or immunoblot",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Subepidermal blister with minimal inflammatory infiltrate on skin biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical blistering, immunofluorescence findings, and serologic detection of anti-type VII collagen antibodies) must be met",
    "notes": "Histopathology supports diagnosis but is not mandatory"
  },
