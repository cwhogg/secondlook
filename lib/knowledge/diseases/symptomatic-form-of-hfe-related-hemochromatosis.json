  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for HFE-related hemochromatosis",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of pathogenic HFE gene mutations (commonly C282Y homozygosity)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-serum-ferritin",
        "description": "Serum ferritin levels persistently elevated above normal reference range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "transferrin-saturation",
        "description": "Transferrin saturation greater than 45%",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-symptoms",
        "description": "Presence of clinical manifestations consistent with iron overload",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Homozygous pathogenic HFE mutation plus elevated serum ferritin and transferrin saturation above 45%",
    "notes": "Liver biopsy or MRI may be used to assess iron overload severity if diagnosis is uncertain."
  },
