  "diagnosticCriteria": {
    "formalCriteriaName": "EB Clinical and Genetic Diagnostic Criteria",
    "criteria": [
      {
        "id": "blistering",
        "description": "Generalized skin blistering and erosions present from birth or early infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "scarring",
        "description": "Dystrophic scarring with milia formation and nail dystrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the COL7A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Reduced or absent type VII collagen at the dermal-epidermal junction on immunofluorescence mapping",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electron-microscopy",
        "description": "Electron microscopy showing sublamina densa cleavage and reduced anchoring fibrils",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized blistering and scarring with confirmed biallelic COL7A1 mutations",
    "notes": "Diagnosis is confirmed by genetic testing; clinical and histopathological findings support diagnosis."
  },
