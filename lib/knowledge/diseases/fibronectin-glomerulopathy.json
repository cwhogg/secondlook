  "keyFindings": {
    "laboratory": [
      "Persistent proteinuria (often nephrotic range)",
      "Microscopic hematuria",
      "Elevated serum creatinine in progressive cases",
      "Mild anemia in some patients"
    ],
    "imaging": [
      "Renal ultrasound may show normal or mildly increased echogenicity",
      "No specific imaging findings diagnostic"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Renal biopsy showing mesangial and subendothelial fibronectin deposits",
      "Immunohistochemistry positive for fibronectin"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "amyloidosis",
      "distinguishingFeatures": [
        "Amyloid deposits on biopsy with Congo red positivity",
        "Systemic involvement common",
        "Different protein composition than fibronectin"
      ]
    },
    {
      "diseaseId": "dense-deposit-disease",
      "distinguishingFeatures": [
        "Electron-dense deposits in glomerular basement membrane",
        "Complement abnormalities",
        "No fibronectin deposits"
      ]
    },
    {
      "diseaseId": "fibrillary-glomerulonephritis",
      "distinguishingFeatures": [
        "Fibrillary deposits on electron microscopy",
        "IgG and complement deposits on immunofluorescence",
        "No fibronectin accumulation"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive proteinuria",
    "Declining renal function despite standard therapy",
    "Family history of early-onset renal failure"
  ],
