  "keyFindings": {
    "laboratory": [
      "Hypoglycemia with metabolic acidosis after fructose ingestion",
      "Elevated liver transaminases (AST, ALT)",
      "Elevated serum uric acid",
      "Reduced aldolase B enzyme activity"
    ],
    "imaging": [
      "Hepatomegaly on abdominal ultrasound",
      "Fatty infiltration of liver in advanced cases"
    ],
    "genetic": [
      "Pathogenic mutations in ALDOB gene (e.g. p.A150P, p.A175D)"
    ],
    "other": [
      "Positive fructose tolerance test causing symptomatic hypoglycemia (rarely performed)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "fructose-1-6-bisphosphatase-deficiency",
      "distinguishingFeatures": [
        "Hypoglycemia without fructose-specific symptoms",
        "Lack of vomiting after fructose ingestion",
        "Different enzyme deficiency confirmed by genetic testing"
      ]
    },
    {
      "diseaseId": "galactosemia",
      "distinguishingFeatures": [
        "Symptoms triggered by galactose ingestion rather than fructose",
        "Presence of cataracts and E. coli sepsis in neonates",
        "Elevated galactose-1-phosphate in blood"
      ]
    }
  ],
