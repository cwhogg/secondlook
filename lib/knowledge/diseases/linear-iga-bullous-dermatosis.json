  "diagnosticCriteria": {
    "formalCriteriaName": "Linear IgA Bullous Dermatosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "linear-iga-deposition",
        "description": "Linear deposition of IgA at the basement membrane zone on direct immunofluorescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "subepidermal-blisters",
        "description": "Presence of subepidermal blisters on histopathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Tense vesicles and bullae with annular or grouped arrangement on skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "negative-bp180-bp230",
        "description": "Negative or absent circulating autoantibodies to BP180 and BP230",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-dapsone",
        "description": "Clinical improvement with dapsone therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (linear IgA deposition, subepidermal blisters, and characteristic clinical presentation) must be met",
    "notes": "Direct immunofluorescence is the gold standard for diagnosis"
  },
