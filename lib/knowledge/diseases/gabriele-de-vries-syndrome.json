        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-issues",
        "description": "Behavioral abnormalities such as autism spectrum disorder or attention deficit hyperactivity disorder",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-delay",
        "description": "Postnatal growth retardation or feeding difficulties",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Identification of a pathogenic or likely pathogenic de novo variant in YY1 gene combined with developmental delay or intellectual disability",
    "notes": "Genetic testing is essential for confirmation; clinical features are variable and nonspecific."
