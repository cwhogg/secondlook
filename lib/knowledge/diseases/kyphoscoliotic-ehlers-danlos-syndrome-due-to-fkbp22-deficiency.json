  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Kyphoscoliotic EDS due to FKBP22 Deficiency",
    "criteria": [
      {
        "id": "congenital-kyphoscoliosis",
        "description": "Congenital or early-onset progressive kyphoscoliosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "generalized-joint-hypermobility",
        "description": "Generalized joint hypermobility with recurrent dislocations or subluxations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-hyperextensibility",
        "description": "Skin hyperextensibility and fragility including easy bruising",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-hypotonia",
        "description": "Congenital muscle hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "biochemical-collagen-abnormalities",
        "description": "Abnormal collagen cross-linking and electrophoretic mobility on biochemical testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (congenital kyphoscoliosis, generalized joint hypermobility, and skin hyperextensibility) plus identification of biallelic pathogenic variants in FKBP14 gene",
    "notes": "Molecular genetic testing confirming FKBP14 mutations is essential for definitive diagnosis."
  },
