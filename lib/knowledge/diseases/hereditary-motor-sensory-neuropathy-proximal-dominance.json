  "diagnosticCriteria": {
    "formalCriteriaName": "Proximal HMSN Diagnostic Criteria",
    "criteria": [
      {
        "id": "proximal-weakness",
        "description": "Presence of predominant proximal muscle weakness in upper and/or lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensory-loss",
        "description": "Symmetric sensory loss affecting proximal regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-conduction-study",
        "description": "Electrophysiological evidence of demyelinating or axonal neuropathy with proximal involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in associated genes (e.g., HSPB1, MFN2)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of predominant proximal muscle weakness and sensory loss with positive family history",
    "notes": "Genetic testing and electrophysiological studies support diagnosis but are not mandatory."
  },
