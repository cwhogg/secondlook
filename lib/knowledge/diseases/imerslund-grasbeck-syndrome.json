  "diagnosticCriteria": {
    "formalCriteriaName": "Imerslund-Gräsbeck Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "vitamin-b12-malabsorption",
        "description": "Demonstration of selective vitamin B12 malabsorption with normal intrinsic factor secretion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "proteinuria",
        "description": "Presence of mild to moderate proteinuria without evidence of renal disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "megaloblastic-anemia",
        "description": "Clinical and laboratory evidence of megaloblastic anemia due to vitamin B12 deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in CUBN or AMN genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-vitamin-b12",
        "description": "Hematological and clinical improvement following parenteral vitamin B12 therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of selective vitamin B12 malabsorption, proteinuria, and megaloblastic anemia",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory"
  },
