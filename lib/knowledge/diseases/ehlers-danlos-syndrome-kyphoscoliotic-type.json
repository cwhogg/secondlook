  "differentialDiagnoses": [
    {
      "diseaseId": "ehlers-danlos-syndrome-classical-type",
      "distinguishingFeatures": [
        "Skin hyperextensibility and atrophic scarring more prominent",
        "Less severe or absent kyphoscoliosis",
        "Different genetic mutations (COL5A1, COL5A2)"
      ]
    },
    {
      "diseaseId": "marfan-syndrome",
      "distinguishingFeatures": [
        "Ectopia lentis and aortic root dilation common",
        "Tall stature with arachnodactyly",
        "FBN1 gene mutations"
      ]
    },
    {
      "diseaseId": "arthrochalasia-type-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Severe joint hypermobility with congenital bilateral hip dislocation",
        "Distinct COL1A1 or COL1A2 mutations",
        "Absence of kyphoscoliosis"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive kyphoscoliosis in infancy",
