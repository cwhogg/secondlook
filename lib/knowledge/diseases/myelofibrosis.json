  "keyFindings": {
    "laboratory": [
      "Leukoerythroblastic blood smear with teardrop cells (dacrocytes)",
      "Anemia (variable severity)",
      "Variable white cell count (may be elevated or decreased)",
      "Variable platelet count (may be elevated or decreased)",
      "Elevated LDH",
      "Elevated uric acid",
      "JAK2 V617F (~60%), CALR (~25%), or MPL (~7%) mutation"
    ],
    "imaging": [
      "Abdominal imaging showing massive splenomegaly and often hepatomegaly",
      "Bone scan or MRI may show osteosclerosis",
      "CT/MRI for extramedullary hematopoiesis sites"
    ],
    "genetic": [
      "JAK2 (somatic)",
      "MPL (somatic)",
      "TET2 (somatic)",
      "CALR (somatic)"
    ],
    "other": [
      "Bone marrow biopsy showing reticulin and/or collagen fibrosis (grade 2-3)",
      "Atypical megakaryocytes with cloud-like or balloon-like nuclei",
      "Dry tap on bone marrow aspiration common"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "polycythemia-vera",
      "distinguishingFeatures": [
        "PV presents with elevated hemoglobin/hematocrit",
        "Post-PV myelofibrosis develops after documented PV",
        "Different bone marrow morphology initially"
      ]
    },
    {
      "diseaseId": "essential-thrombocythemia",
      "distinguishingFeatures": [
        "ET presents with isolated thrombocytosis",
        "Minimal or no fibrosis on marrow biopsy",
        "Post-ET myelofibrosis develops after documented ET"
      ]
    },
    {
      "diseaseId": "chronic-myeloid-leukemia",
      "distinguishingFeatures": [
        "CML is BCR-ABL1 positive",
        "Marked leukocytosis with left shift and basophilia",
        "Philadelphia chromosome present"
      ]
    },
    {
      "diseaseId": "myelodysplastic-syndrome-with-fibrosis",
      "distinguishingFeatures": [
        "MDS shows dysplasia in hematopoietic lineages",
        "Different cytogenetic abnormalities",
        "No driver mutations (JAK2, CALR, MPL) typically"
      ]
    }
  ],
  "redFlags": [
    "Transformation to acute myeloid leukemia (blast crisis)",
    "Severe transfusion-dependent anemia",
    "Massive splenomegaly causing splenic infarction or rupture",
    "Portal hypertension with variceal bleeding",
    "Extramedullary hematopoiesis causing organ compression"
  ],
  "specialistType": [
    "Hematologist/Oncologist",
