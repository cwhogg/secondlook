  "diagnosticCriteria": {
    "formalCriteriaName": "Jung Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including hypertelorism and midface hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Radiographic evidence of multiple skeletal abnormalities such as short stature and vertebral anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-manifestations",
        "description": "Presence of skin abnormalities including café-au-lait spots or hypopigmented macules",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (craniofacial dysmorphism, skeletal abnormalities, developmental delay) must be present for diagnosis",
    "notes": "Genetic testing may support diagnosis but is not definitive due to heterogeneity"
  },
