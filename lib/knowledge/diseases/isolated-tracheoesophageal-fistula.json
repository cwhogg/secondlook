  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnosis of Isolated Tracheoesophageal Fistula",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of recurrent respiratory infections and choking episodes during feeding",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "contrast-esophagography",
        "description": "Demonstration of fistulous tract between trachea and esophagus on contrast esophagography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bronchoscopy",
        "description": "Visualization of fistula opening in the trachea via bronchoscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-esophageal-atresia",
        "description": "No evidence of esophageal atresia on imaging and clinical examination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical symptoms consistent with fistula plus confirmation by contrast esophagography or bronchoscopy",
    "notes": "Diagnosis may be delayed due to subtle clinical presentation; high suspicion required in infants with feeding difficulties and respiratory symptoms."
  },
