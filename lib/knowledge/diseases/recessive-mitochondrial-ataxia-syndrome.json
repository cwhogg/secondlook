  "diagnosticCriteria": {
    "formalCriteriaName": "Recessive Mitochondrial Ataxia Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in mitochondrial-related nuclear genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mitochondrial-dysfunction",
        "description": "Evidence of mitochondrial respiratory chain deficiency in muscle biopsy or biochemical assays",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "additional-neurological-features",
        "description": "Presence of peripheral neuropathy or pyramidal signs",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "brain-imaging",
        "description": "MRI showing cerebellar atrophy and/or signal abnormalities in basal ganglia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia, confirmed biallelic pathogenic variants in mitochondrial-related genes, and evidence of mitochondrial dysfunction",
    "notes": "Diagnosis requires exclusion of other hereditary ataxias and mitochondrial disorders."
  },
