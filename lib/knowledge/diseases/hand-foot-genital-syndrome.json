      ]
    },
    {
      "diseaseId": "greig-cephalopolysyndactyly-syndrome",
      "distinguishingFeatures": [
        "Polydactyly rather than brachydactyly",
        "Craniofacial abnormalities absent in HFGS"
      ]
    }
  ],
