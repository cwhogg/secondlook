  "diagnosticCriteria": {
    "formalCriteriaName": "EB Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of widespread blistering and erosions at birth or within the neonatal period",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Immunofluorescence showing reduced or absent expression of laminin-332 or other basement membrane zone proteins",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in LAMA3, LAMB3, or LAMC2 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Electron microscopy demonstrating cleavage within the lamina lucida of the basement membrane zone",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical blistering at or shortly after birth plus confirmation by immunofluorescence mapping or genetic testing",
    "notes": "Early diagnosis is critical due to high mortality and severe complications."
  },
