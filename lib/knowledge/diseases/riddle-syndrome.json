  "diagnosticCriteria": {
    "formalCriteriaName": "RIDDLE Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "immunodeficiency",
        "description": "Combined immunodeficiency with recurrent infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rad50-mutation",
        "description": "Biallelic pathogenic variants in RAD50 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiosensitivity",
        "description": "Cellular hypersensitivity to ionizing radiation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features including micrognathia and prominent nose",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic RAD50 mutations plus combined immunodeficiency and radiosensitivity",
    "notes": "Genetic testing is essential for confirmation; clinical features may overlap with other DNA repair disorders."
  },
