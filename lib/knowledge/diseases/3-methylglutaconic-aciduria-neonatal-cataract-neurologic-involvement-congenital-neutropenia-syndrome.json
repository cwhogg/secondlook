  "keyFindings": {
    "laboratory": [
      "Elevated urinary 3-methylglutaconic acid on organic acid analysis",
      "Persistent neutropenia on complete blood count with differential",
      "Mild anemia in some cases"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter changes or cerebral atrophy",
      "Ophthalmologic imaging confirms cataracts"
    ],
    "genetic": [
      "CLPB (causative, loss-of-function)",
      "Pathogenic variants in genes associated with mitochondrial function and neutrophil development (specific gene not yet fully established)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electroencephalogram (EEG) abnormalities in patients with seizures",
      "Bone marrow biopsy showing maturation arrest in neutrophil lineage"
    ]
  },
