  "keyFindings": {
    "laboratory": [
      "Markedly elevated serum alkaline phosphatase",
      "Normal or mildly elevated serum calcium and phosphate",
      "Normal parathyroid hormone levels"
    ],
    "imaging": [
      "Radiographs showing cortical thickening, bone expansion, and deformities",
      "Bone scintigraphy with increased uptake in affected bones",
      "CT or MRI may show cranial nerve compression"
    ],
    "genetic": [
      "TNFRSF11B (causative)",
      "TNFRSF11A (candidate)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Bone biopsy demonstrating increased osteoclastic activity and abnormal remodeling"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "adult-paget-disease",
      "distinguishingFeatures": [
        "Onset in adulthood rather than childhood",
        "Different genetic etiology",
        "Less severe bone deformities in early life"
      ]
    },
    {
      "diseaseId": "osteogenesis-imperfecta",
      "distinguishingFeatures": [
        "Presence of blue sclerae",
        "Frequent fractures with minimal trauma",
        "Genetic mutations in collagen genes"
      ]
    },
    {
      "diseaseId": "fibrous-dysplasia",
      "distinguishingFeatures": [
        "Radiographic ground-glass appearance",
        "Monostotic or polyostotic lesions",
        "No marked elevation of alkaline phosphatase"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive bone deformities in early childhood",
    "Severe skeletal pain unresponsive to standard analgesics",
    "Neurological deficits such as cranial nerve palsies or hearing loss"
