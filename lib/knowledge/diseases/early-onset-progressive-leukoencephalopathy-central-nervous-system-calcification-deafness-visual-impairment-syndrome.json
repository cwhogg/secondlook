  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Early-onset Progressive Leukoencephalopathy-CNS Calcification-Deafness-Visual Impairment Syndrome",
    "criteria": [
      {
        "id": "criterion-1",
        "description": "Early-onset progressive leukoencephalopathy confirmed by MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-2",
        "description": "Presence of bilateral central nervous system calcifications on neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-3",
        "description": "Sensorineural deafness documented by audiological testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-4",
        "description": "Visual impairment including optic atrophy or retinal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-5",
        "description": "Exclusion of other causes of leukoencephalopathy and CNS calcifications",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All four major criteria (early-onset progressive leukoencephalopathy, CNS calcifications, sensorineural deafness, and visual impairment) must be present",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
