  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate)",
      "Normal routine blood counts and metabolic panels"
    ],
    "imaging": [
      "MRI brain may show cortical atrophy in advanced cases",
      "Spinal MRI typically normal or shows mild anterior horn cell loss"
    ],
    "genetic": [
      "ASAH1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography showing denervation and chronic reinnervation",
      "EEG demonstrating generalized spike-wave and polyspike-wave discharges"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "unverricht-lundborg-disease",
      "distinguishingFeatures": [
        "Onset in childhood with progressive myoclonic epilepsy but no spinal muscular atrophy",
