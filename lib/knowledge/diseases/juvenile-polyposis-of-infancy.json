  "keyFindings": {
    "laboratory": [
      "Microcytic hypochromic anemia",
      "Hypoalbuminemia",
      "Elevated inflammatory markers (CRP, ESR)"
    ],
    "imaging": [
      "Endoscopic visualization of multiple juvenile polyps",
      "Barium enema showing polypoid lesions",
      "Ultrasound or CT scan may reveal bowel wall thickening or intussusception"
    ],
    "genetic": [
      "PTEN (phenotype modifier)",
      "BMPR1A (phenotype modifier)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology showing hamartomatous juvenile polyps with cystic gland dilation and inflammatory stroma"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "peutz-jeghers-syndrome",
      "distinguishingFeatures": [
        "Presence of mucocutaneous pigmentation",
        "Polyps are hamartomatous but with arborizing smooth muscle",
        "Later onset compared to juvenile polyposis of infancy"
      ]
    },
    {
      "diseaseId": "cowden-syndrome",
      "distinguishingFeatures": [
        "Multiple hamartomas in various tissues including skin and thyroid",
        "PTEN gene mutations",
        "Macrocephaly and mucocutaneous lesions"
      ]
    }
  ],
  "redFlags": [
    "Profuse gastrointestinal bleeding in infancy",
    "Severe failure to thrive despite nutritional support",
    "Early onset colorectal cancer or dysplasia"
  ],
