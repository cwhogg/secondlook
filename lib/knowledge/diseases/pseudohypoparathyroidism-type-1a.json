  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and biochemical criteria for PHP1A",
    "criteria": [
      {
        "id": "hormone-resistance",
        "description": "Evidence of resistance to parathyroid hormone (PTH) with hypocalcemia and hyperphosphatemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alo-phenotype",
        "description": "Presence of Albright hereditary osteodystrophy (AHO) phenotype including short stature, brachydactyly, and subcutaneous ossifications",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gsa-imprinting",
        "description": "Identification of GNAS gene mutation affecting the Gs alpha subunit",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "additional-hormone-resistance",
        "description": "Resistance to other hormones such as TSH or gonadotropins",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hormone resistance with biochemical abnormalities plus AHO phenotype and/or GNAS mutation",
    "notes": "Genetic testing for GNAS mutations confirms diagnosis; hormone resistance may develop progressively."
  },
