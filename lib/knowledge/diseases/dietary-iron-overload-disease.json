  "diagnosticCriteria": {
    "formalCriteriaName": "Dietary Iron Overload Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-serum-ferritin",
        "description": "Persistently elevated serum ferritin levels above normal reference range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "increased-transferrin-saturation",
        "description": "Transferrin saturation greater than 45%",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "excessive-dietary-iron-intake",
        "description": "History of chronic excessive dietary iron intake or consumption of iron-fortified foods",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hepatic-iron-deposition",
        "description": "Evidence of hepatic iron overload on liver biopsy or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-genetic-hemochromatosis",
        "description": "Negative genetic testing for common hereditary hemochromatosis mutations",
        "category": "minor",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Elevated serum ferritin and transferrin saturation with evidence of hepatic iron overload and exclusion of hereditary hemochromatosis",
    "notes": "Diagnosis requires exclusion of genetic causes and confirmation of excessive dietary iron exposure."
  },
