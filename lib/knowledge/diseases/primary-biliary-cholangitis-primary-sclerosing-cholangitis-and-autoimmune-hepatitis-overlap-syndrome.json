  "keyFindings": {
    "laboratory": [
      "Elevated alkaline phosphatase and gamma-glutamyl transferase",
      "Elevated serum aminotransferases (ALT, AST)",
      "Positive anti-mitochondrial antibodies (AMA) and/or anti-smooth muscle antibodies (ASMA), ANA",
      "Elevated serum IgG levels",
      "Hyperbilirubinemia"
    ],
    "imaging": [
      "Magnetic resonance cholangiopancreatography (MRCP) showing multifocal bile duct strictures and beading",
      "Ultrasound showing hepatomegaly and possible biliary ductal irregularities"
    ],
    "genetic": [
      "No specific genetic mutation identified; association with HLA-DR3 and HLA-DR4 haplotypes"
    ],
    "other": [
      "Liver biopsy demonstrating interface hepatitis, bile duct injury, and periductal fibrosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "primary-biliary-cholangitis",
      "distinguishingFeatures": [
        "Predominantly affects small intrahepatic bile ducts",
        "Strongly positive anti-mitochondrial antibodies (AMA)",
        "Absence of large bile duct strictures on imaging"
      ]
    },
    {
      "diseaseId": "primary-sclerosing-cholangitis",
      "distinguishingFeatures": [
        "Characteristic multifocal strictures and beading of large intra- and extrahepatic bile ducts on cholangiography",
        "Strong association with inflammatory bowel disease",
        "Lack of significant autoimmune hepatitis serology"
      ]
    },
    {
      "diseaseId": "autoimmune-hepatitis",
      "distinguishingFeatures": [
        "Markedly elevated serum aminotransferases",
        "Interface hepatitis on biopsy without significant bile duct injury",
        "Positive ANA and ASMA without cholestatic enzyme elevation"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive jaundice and coagulopathy indicating acute liver failure",
    "Development of hepatic encephalopathy",
    "Signs of portal hypertension such as variceal bleeding or ascites"
  ],
