  "diagnosticCriteria": {
    "formalCriteriaName": "No standardized formal criteria",
    "criteria": [
      {
        "id": "imaging-confirmation",
        "description": "Demonstration of complete discontinuity between ascending and descending aorta on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Neonatal onset of severe congestive heart failure and differential cyanosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "associated-cardiac-anomalies",
        "description": "Presence of associated congenital heart defects such as ventricular septal defect or patent ductus arteriosus",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Imaging confirmation of interrupted aortic arch plus compatible clinical presentation",
    "notes": "Diagnosis is primarily based on imaging and clinical features in neonates"
  },
