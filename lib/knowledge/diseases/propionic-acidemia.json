  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Propionic Acidemia",
    "criteria": [
      {
        "id": "elevated-propionylcarnitine",
        "description": "Elevated propionylcarnitine (C3) levels on newborn screening or plasma acylcarnitine profile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "organic-aciduria",
        "description": "Presence of elevated 3-hydroxypropionic acid, methylcitrate, and propionic acid in urine organic acid analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of propionyl-CoA carboxylase deficiency in cultured fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in PCCA or PCCB genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Clinical presentation with metabolic acidosis, hyperammonemia, and neurological symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated propionylcarnitine and organic aciduria consistent with propionic acidemia, supported by enzyme assay or genetic testing",
    "notes": "Newborn screening has improved early detection; confirmatory testing is essential."
  },
