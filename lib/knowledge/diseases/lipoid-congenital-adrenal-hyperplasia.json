  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Lipoid CAH",
    "criteria": [
      {
        "id": "steroidogenic-defect",
        "description": "Impaired steroid hormone synthesis due to mutations in the STAR gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Early onset adrenal insufficiency with salt-wasting crisis in neonates",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the STAR gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-profile",
        "description": "Low plasma cortisol and aldosterone with elevated ACTH and renin levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "adrenal-imaging",
        "description": "Enlarged adrenal glands with lipid accumulation on imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical adrenal insufficiency with salt-wasting crisis plus genetic confirmation of STAR mutations",
    "notes": "Diagnosis is confirmed by genetic testing; biochemical and imaging findings support diagnosis."
  },
