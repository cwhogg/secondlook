  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Multiple Epiphyseal Dysplasia-Macrocephaly-Facial Dysmorphism Syndrome",
    "criteria": [
      {
        "id": "epiphyseal-dysplasia",
        "description": "Radiographic evidence of multiple epiphyseal dysplasia affecting long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "macrocephaly",
        "description": "Macrocephaly defined as head circumference >2 standard deviations above mean for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including frontal bossing, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-pain-stiffness",
        "description": "Clinical presentation of joint pain and stiffness in childhood",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of radiographic multiple epiphyseal dysplasia plus macrocephaly and characteristic facial dysmorphism",
    "notes": "Genetic testing can support diagnosis but is not mandatory."
  },
