  "diagnosticCriteria": {
    "formalCriteriaName": "Ectopic Aldosterone-Producing Tumor Diagnostic Criteria",
    "criteria": [
      {
        "id": "biochemical-evidence",
        "description": "Elevated plasma aldosterone concentration with suppressed plasma renin activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-identification",
        "description": "Identification of extra-adrenal aldosterone-secreting tumor on imaging studies (CT, MRI, or PET)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-adrenal-adenoma",
        "description": "Exclusion of adrenal aldosterone-producing adenoma by adrenal vein sampling or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypertension",
        "description": "Presence of resistant hypertension despite standard therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypokalemia",
        "description": "Documented hypokalemia not explained by other causes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (biochemical evidence, imaging identification of ectopic tumor, and exclusion of adrenal adenoma) must be met for diagnosis.",
    "notes": "Adrenal vein sampling is critical to differentiate ectopic tumors from adrenal sources of aldosterone excess."
  },
