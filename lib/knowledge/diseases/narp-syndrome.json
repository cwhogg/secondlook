  "keyFindings": {
    "laboratory": [
      "Elevated lactate and pyruvate levels in blood and CSF",
      "Abnormal nerve conduction studies showing sensory neuropathy"
    ],
    "imaging": [
      "MRI brain showing cerebellar atrophy",
      "Ophthalmologic imaging demonstrating retinal pigmentary changes"
    ],
    "genetic": [
      "Mitochondrial DNA point mutations at position m.8993T>G or m.8993T>C in MT-ATP6 gene"
    ],
    "other": [
      "Muscle biopsy may show ragged-red fibers",
      "Electroretinography showing reduced retinal function"
    ]
  },
  "differentialDiagnoses": [
