  "diagnosticCriteria": {
    "formalCriteriaName": "Mowat-Wilson Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial gestalt including hypertelorism, broad nasal bridge, uplifted earlobes, and prominent chin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Moderate to severe intellectual disability and developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hirschsprung-disease",
        "description": "Presence of Hirschsprung disease or chronic constipation due to aganglionosis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "zeb2-mutation",
        "description": "Pathogenic mutation or deletion in the ZEB2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "other-congenital-anomalies",
        "description": "Congenital heart defects, genitourinary anomalies, or agenesis of the corpus callosum",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic facial features, intellectual disability, and a pathogenic ZEB2 mutation",
    "notes": "Hirschsprung disease is common but not mandatory for diagnosis"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Distinctive facial gestalt with hypertelorism and uplifted earlobes",
        "frequency": 0.95,
        "bodySystem": "constitutional",
        "notes": "Highly characteristic facial features aid diagnosis"
      },
      {
        "symptomName": "Moderate to severe intellectual disability",
        "frequency": 0.9,
        "bodySystem": "neurological",
        "notes": "Universal feature in affected individuals"
      },
      {
        "symptomName": "Hirschsprung disease (congenital aganglionic megacolon)",
        "frequency": 0.75,
        "bodySystem": "gastrointestinal",
        "notes": "Common but not present in all cases"
      }
    ],
    "common": [
      {
        "symptomName": "Seizures or epilepsy",
        "frequency": 0.6,
        "bodySystem": "neurological",
        "notes": "Often develops in childhood"
      },
      {
        "symptomName": "Congenital heart defects (e.g., septal defects)",
        "frequency": 0.55,
        "bodySystem": "cardiovascular",
        "notes": "Variable severity"
      },
      {
        "symptomName": "Microcephaly",
        "frequency": 0.58,
        "bodySystem": "neurological",
        "notes": "Head circumference below normal"
      },
      {
        "symptomName": "Delayed motor milestones",
        "frequency": 0.7,
        "bodySystem": "musculoskeletal",
        "notes": "Due to neurological impairment"
      },
      {
        "symptomName": "Genitourinary anomalies (e.g., hypospadias, cryptorchidism)",
        "frequency": 0.5,
        "bodySystem": "reproductive",
        "notes": "More common in males"
      }
    ],
    "occasional": [
      {
        "symptomName": "Agenesis or hypoplasia of the corpus callosum",
        "frequency": 0.4,
        "bodySystem": "neurological",
        "notes": "Detected by brain imaging"
      },
      {
        "symptomName": "Feeding difficulties in infancy",
        "frequency": 0.3,
        "bodySystem": "gastrointestinal",
        "notes": "Often related to hypotonia"
      },
      {
        "symptomName": "Constipation without Hirschsprung disease",
        "frequency": 0.35,
        "bodySystem": "gastrointestinal",
        "notes": "Chronic constipation common"
      },
      {
        "symptomName": "Ophthalmological abnormalities (e.g., strabismus)",
        "frequency": 0.25,
        "bodySystem": "ophthalmological",
        "notes": "May require corrective treatment"
      },
      {
        "symptomName": "Hypotonia",
        "frequency": 0.4,
        "bodySystem": "musculoskeletal",
        "notes": "Contributes to developmental delay"
      }
    ],
    "rare": [
      {
        "symptomName": "Hearing impairment",
        "frequency": 0.08,
        "bodySystem": "otolaryngological",
        "notes": "Sensorineural or conductive"
      },
      {
        "symptomName": "Scoliosis",
        "frequency": 0.05,
        "bodySystem": "musculoskeletal",
        "notes": "May develop during childhood"
      },
      {
        "symptomName": "Immune dysfunction",
        "frequency": 0.03,
        "bodySystem": "immunological",
        "notes": "Rarely reported"
      },
      {
        "symptomName": "Endocrine abnormalities (e.g., hypothyroidism)",
        "frequency": 0.02,
        "bodySystem": "endocrine",
        "notes": "Occasional reports"
      }
    ]
  },
