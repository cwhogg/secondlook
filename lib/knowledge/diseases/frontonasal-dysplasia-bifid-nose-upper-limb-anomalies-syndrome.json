  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Frontonasal Dysplasia-Bifid Nose-Upper Limb Anomalies Syndrome",
    "criteria": [
      {
        "id": "bifid-nose",
        "description": "Presence of a bifid nasal tip or cleft nose deformity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "frontonasal-dysplasia",
        "description": "Midline facial clefting or hypertelorism consistent with frontonasal dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "upper-limb-anomalies",
        "description": "Congenital upper limb malformations such as syndactyly, clinodactyly, or brachydactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cranial-suture-abnormalities",
        "description": "Abnormalities of cranial sutures including metopic synostosis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: bifid nose, frontonasal dysplasia features, and upper limb anomalies",
    "notes": "Genetic testing may support diagnosis but is not always definitive."
  },
