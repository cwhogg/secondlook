  "diagnosticCriteria": {
    "formalCriteriaName": "Jenni Criteria",
    "criteria": [
      {
        "id": "trabeculation-ratio",
        "description": "Ratio of non-compacted to compacted myocardium > 2:1 at end-systole on echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "deep-intertrabecular-recesses",
        "description": "Presence of deep intertrabecular recesses perfused from the ventricular cavity demonstrated by color Doppler",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "prominent-trabeculations",
        "description": "Prominent trabeculations predominantly in the apical and mid-ventricular segments of the left ventricle",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-other-cardiomyopathies",
        "description": "Exclusion of other causes of cardiomyopathy such as hypertrophic or dilated cardiomyopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (trabeculation ratio >2:1, deep intertrabecular recesses on Doppler, and prominent trabeculations in typical LV segments) must be met",
    "notes": "Cardiac MRI criteria (Petersen criteria) may also be used for diagnosis"
  },
