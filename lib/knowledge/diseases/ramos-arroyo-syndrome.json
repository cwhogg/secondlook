  "keyFindings": {
    "laboratory": [
      "Urinalysis may reveal proteinuria or hematuria",
      "Renal function tests may show elevated creatinine in advanced cases"
    ],
    "imaging": [
      "Renal ultrasound showing hypoplasia, agenesis, or cystic changes",
      "CT or MRI of neck showing branchial cleft cysts or fistulae",
      "Audiometry confirming sensorineural or conductive hearing loss",
      "Cervical spine X-rays for vertebral anomalies"
    ],
    "genetic": [
      "Mutations in EYA1 gene detected by molecular genetic testing",
      "Rare mutations in SIX1 and SIX5 genes",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Family history consistent with autosomal dominant inheritance",
      "Physical examination revealing preauricular pits and branchial anomalies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "branchio-oto-renal-syndrome-type-1",
      "distinguishingFeatures": [
        "Mutations in EYA1 gene but with different phenotypic spectrum",
        "More frequent renal anomalies and hearing loss",
        "Presence of branchial cleft anomalies similar but with distinct genetic markers"
      ]
    },
    {
      "diseaseId": "goldenhar-syndrome",
      "distinguishingFeatures": [
        "Hemifacial microsomia with ocular dermoids",
        "Absence of renal anomalies",
        "No branchial cleft cysts or fistulae"
      ]
    }
  ],
  "redFlags": [
    "Progressive renal insufficiency or failure",
    "Severe bilateral sensorineural hearing loss",
    "Recurrent neck infections due to branchial fistulae"
  ],
