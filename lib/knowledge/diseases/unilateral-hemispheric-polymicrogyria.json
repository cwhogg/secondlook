  "diagnosticCriteria": {
    "formalCriteriaName": "Neuroimaging-based Diagnostic Criteria for Polymicrogyria",
    "criteria": [
      {
        "id": "imaging-confirmation",
        "description": "MRI evidence of abnormal cortical lamination with excessive small gyri confined to one cerebral hemisphere",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-seizures",
        "description": "Presence of focal or generalized seizures consistent with cortical malformation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-deficits",
        "description": "Unilateral motor deficits such as hemiparesis or hemiplegia corresponding to affected hemisphere",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Variable cognitive and developmental delay supportive but not mandatory",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "MRI evidence of unilateral polymicrogyria plus at least one major clinical feature such as seizures or unilateral motor deficits",
    "notes": "Diagnosis relies heavily on high-resolution brain MRI and clinical correlation."
  },
