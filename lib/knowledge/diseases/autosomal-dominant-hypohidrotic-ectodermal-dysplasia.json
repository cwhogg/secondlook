  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Hypohidrotic Ectodermal Dysplasia",
    "criteria": [
      {
        "id": "hypohidrosis",
        "description": "Reduced or absent sweating (hypohidrosis or anhidrosis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypodontia",
        "description": "Congenital hypodontia or oligodontia with characteristic conical teeth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotrichosis",
        "description": "Sparse, thin, or absent scalp and body hair (hypotrichosis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-features",
        "description": "Characteristic facial features including frontal bossing, depressed nasal bridge, and periorbital wrinkling",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (hypohidrosis, hypodontia, and hypotrichosis) with or without supportive family history",
    "notes": "Genetic testing for mutations in the EDA gene or related pathways can confirm diagnosis."
  },
