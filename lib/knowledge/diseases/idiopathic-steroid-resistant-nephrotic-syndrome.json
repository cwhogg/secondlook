  "diagnosticCriteria": {
    "formalCriteriaName": "KDIGO Clinical Practice Guideline for Glomerulonephritis",
    "criteria": [
      {
        "id": "persistent-proteinuria",
        "description": "Persistent nephrotic-range proteinuria despite adequate corticosteroid therapy for at least 4 weeks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-secondary-causes",
        "description": "Exclusion of secondary causes of nephrotic syndrome such as infections, systemic diseases, or drug-induced nephropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-biopsy-findings",
        "description": "Renal biopsy showing minimal change disease or focal segmental glomerulosclerosis without response to steroids",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-serum-complement",
        "description": "Normal serum complement levels to rule out complement-mediated nephropathies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent nephrotic-range proteinuria despite corticosteroid therapy for at least 4 weeks, exclusion of secondary causes, and supportive renal biopsy findings consistent with steroid resistance",
    "notes": "Genetic testing may be indicated to identify underlying mutations associated with steroid resistance."
  },
