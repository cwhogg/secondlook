  "diagnosticCriteria": {
    "formalCriteriaName": "Mitochondrial Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-myopathy",
        "description": "Presence of isolated skeletal muscle weakness without multisystem involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing ragged-red fibers and cytochrome c oxidase (COX) deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mitochondrial DNA or nuclear DNA mutations affecting mitochondrial function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-lactate",
        "description": "Elevated blood or CSF lactate levels at rest or after exercise",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-cardiac-and-neuro",
        "description": "Absence of significant cardiac or neurological multisystem involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical myopathy, muscle biopsy findings, and genetic confirmation) must be met for diagnosis.",
    "notes": "Diagnosis requires exclusion of multisystem mitochondrial disorders and other myopathies."
  },
