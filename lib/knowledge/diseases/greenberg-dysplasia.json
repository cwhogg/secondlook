        "requiredForDiagnosis": true
      },
      {
        "id": "ectopic-calcifications",
        "description": "Ectopic calcifications in soft tissues detected by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic mutations in the LBR gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Presence of characteristic facial dysmorphic features including micrognathia and midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe hydrops fetalis, moth-eaten skeletal appearance, and ectopic calcifications; genetic confirmation supports diagnosis",
    "notes": "Diagnosis is often made prenatally or perinatally due to lethality"
  },
