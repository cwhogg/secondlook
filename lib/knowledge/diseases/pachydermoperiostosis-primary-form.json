  "diagnosticCriteria": {
    "formalCriteriaName": "Touraine-Solente-Golé Diagnostic Criteria",
    "criteria": [
      {
        "id": "digital-clubbing",
        "description": "Presence of digital clubbing (thickening of distal fingers and toes)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "periostitis",
        "description": "Radiographic evidence of periostitis of long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pachydermia",
        "description": "Cutaneous thickening and folding, especially of the forehead and scalp",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "arthralgia",
        "description": "Chronic joint pain and swelling",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: digital clubbing, periostitis on imaging, and pachydermia",
    "notes": "Diagnosis is clinical supported by radiographic findings; genetic testing may confirm mutations in HPGD or SLCO2A1 genes."
  },
  "symptoms": {
