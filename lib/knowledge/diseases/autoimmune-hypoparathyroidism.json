  "diagnosticCriteria": {
    "formalCriteriaName": "Autoimmune Hypoparathyroidism Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypocalcemia",
        "description": "Biochemically confirmed hypocalcemia with low serum calcium levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-pth",
        "description": "Inappropriately low or undetectable parathyroid hormone (PTH) levels in the presence of hypocalcemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoimmune-markers",
        "description": "Presence of circulating autoantibodies against parathyroid tissue or associated autoimmune disorders",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of hypoparathyroidism such as surgical removal or genetic causes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypocalcemia with low PTH levels and evidence of autoimmune etiology after exclusion of other causes",
    "notes": "Autoimmune hypoparathyroidism may occur isolated or as part of autoimmune polyglandular syndrome type 1."
  },
