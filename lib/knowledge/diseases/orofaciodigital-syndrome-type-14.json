  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including hypertelorism and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oral-anomalies",
        "description": "Presence of oral anomalies such as cleft tongue and oral frenula abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digital-malformations",
        "description": "Digital anomalies including brachydactyly and syndactyly of fingers or toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-hypoplasia",
        "description": "Neuroimaging evidence of cerebellar hypoplasia or vermis hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the TMEM107 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of facial dysmorphism, oral anomalies, digital malformations, and pathogenic TMEM107 gene variants",
    "notes": "Diagnosis is primarily clinical supported by genetic testing and neuroimaging findings."
  },
