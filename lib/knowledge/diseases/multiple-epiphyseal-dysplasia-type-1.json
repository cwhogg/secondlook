  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiographic Diagnostic Criteria for Multiple Epiphyseal Dysplasia",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early-onset joint pain and stiffness predominantly affecting large joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-epiphyseal-abnormalities",
        "description": "Radiographic evidence of delayed and irregular ossification of multiple epiphyses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the COMP gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical symptoms plus radiographic epiphyseal abnormalities; genetic confirmation supports diagnosis but is not mandatory.",
    "notes": "Genetic testing for COMP mutations is recommended to confirm diagnosis and differentiate from other skeletal dysplasias."
  },
