        "description": "Personal or family history of mucocutaneous bleeding symptoms such as epistaxis, menorrhagia, or easy bruising",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-factor-viii",
        "description": "Normal or mildly decreased factor VIII activity",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "multimer-analysis",
        "description": "Normal multimer pattern on VWF multimer analysis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
