  "diagnosticCriteria": {
    "formalCriteriaName": "No universally accepted formal criteria; diagnosis of exclusion",
    "criteria": [
      {
        "id": "encephalopathy",
        "description": "Subacute onset of encephalopathy with cognitive impairment, seizures, or altered consciousness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "antithyroid-antibodies",
        "description": "Elevated serum antithyroid antibodies (anti-thyroid peroxidase or anti-thyroglobulin antibodies)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "steroid-response",
        "description": "Clinical improvement with corticosteroid therapy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of encephalopathy including infections, metabolic, toxic, and neoplastic etiologies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thyroid-function",
        "description": "Thyroid function may be normal, hypothyroid, or hyperthyroid",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of encephalopathy with elevated antithyroid antibodies, exclusion of other causes, and clinical response to corticosteroids",
    "notes": "Diagnosis is clinical and by exclusion; no definitive biomarker exists"
  },
