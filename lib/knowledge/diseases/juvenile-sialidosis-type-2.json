  "diagnosticCriteria": {
    "formalCriteriaName": "Sialidosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of alpha-neuraminidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of progressive myoclonic epilepsy and cherry-red macular spots",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the NEU1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-analysis",
        "description": "Accumulation of sialylated oligosaccharides in urine",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of alpha-neuraminidase enzyme activity plus either clinical features or genetic confirmation",
    "notes": "Diagnosis is confirmed by enzymatic assay and molecular genetic testing of NEU1."
  },
