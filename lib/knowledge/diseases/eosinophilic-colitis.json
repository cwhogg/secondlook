  "diagnosticCriteria": {
    "formalCriteriaName": "Eosinophilic Colitis Diagnostic Criteria",
    "criteria": [
      {
        "id": "histologic-eosinophilia",
        "description": "Eosinophilic infiltration of the colonic mucosa with >20 eosinophils per high power field",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-infections",
        "description": "Exclusion of infectious causes of colitis by stool studies and cultures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-symptoms",
        "description": "Presence of gastrointestinal symptoms such as abdominal pain and diarrhea",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peripheral-eosinophilia",
        "description": "Peripheral blood eosinophilia may be present but is not mandatory",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-steroids",
        "description": "Clinical improvement with corticosteroid therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met: histologic eosinophilia in colonic biopsy, exclusion of infectious causes, and presence of compatible clinical symptoms.",
    "notes": "Diagnosis requires exclusion of secondary causes of eosinophilia such as parasitic infections, drug reactions, and systemic eosinophilic disorders."
  },
