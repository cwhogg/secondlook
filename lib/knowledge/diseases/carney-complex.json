        "description": "First-degree relative with Carney Complex",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "myxoma-other-sites",
        "description": "Myxomas in extracardiac locations (skin, breast, etc.)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Diagnosis requires two or more major criteria or one major criterion plus a pathogenic PRKAR1A mutation or a first-degree relative with Carney Complex",
    "notes": "Genetic testing for PRKAR1A mutations supports diagnosis but is not mandatory"
