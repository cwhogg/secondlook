        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of mild neurological symptoms such as sensorineural hearing loss or mild developmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of gain-of-function mutation in the PRPS1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Elevated PRPS enzymatic activity plus hyperuricemia and/or identification of PRPS1 gain-of-function mutation",
