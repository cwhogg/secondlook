  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Gingival Fibromatosis-Facial Dysmorphism Syndrome",
    "criteria": [
      {
        "id": "gingival-fibromatosis",
        "description": "Presence of generalized gingival fibromatosis characterized by firm, non-hemorrhagic gingival overgrowth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features including coarse facial appearance, broad nasal bridge, and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-anomalies",
        "description": "Delayed tooth eruption and malocclusion",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (generalized gingival fibromatosis and characteristic facial dysmorphism)",
    "notes": "Genetic testing may support diagnosis but is not mandatory."
  },
