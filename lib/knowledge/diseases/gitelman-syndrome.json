  "differentialDiagnoses": [
    {
      "diseaseId": "bartter-syndrome",
      "distinguishingFeatures": [
        "Hypercalciuria instead of hypocalciuria",
        "Earlier onset in infancy or childhood",
        "More severe volume depletion"
      ]
    },
    {
      "diseaseId": "primary-aldosteronism",
      "distinguishingFeatures": [
        "Hypertension present",
        "Suppressed plasma renin activity",
        "No hypomagnesemia"
      ]
    }
  ],
  "redFlags": [
