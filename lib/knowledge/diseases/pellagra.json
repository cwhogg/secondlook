  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnosis of Pellagra",
    "criteria": [
      {
        "id": "dermatitis",
        "description": "Symmetrical photosensitive dermatitis with erythema and scaling",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "diarrhea",
        "description": "Chronic diarrhea or gastrointestinal disturbances",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dementia",
        "description": "Neuropsychiatric symptoms including confusion, memory loss, and irritability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-niacin",
        "description": "Clinical improvement after niacin or nicotinamide supplementation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least two major criteria (dermatitis plus diarrhea or dementia) or all three major criteria",
    "notes": "Diagnosis is primarily clinical; laboratory confirmation is supportive but not mandatory."
  },
