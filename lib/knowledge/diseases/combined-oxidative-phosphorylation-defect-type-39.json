  "diagnosticCriteria": {
    "formalCriteriaName": "Mitochondrial Disease Diagnostic Criteria (MDC)",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of multisystem clinical features consistent with mitochondrial dysfunction including neurological and muscular symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-evidence",
        "description": "Demonstration of combined defects in multiple respiratory chain enzyme complexes in muscle or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in nuclear genes encoding mitochondrial oxidative phosphorylation components or assembly factors",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Muscle biopsy showing ragged-red fibers or cytochrome c oxidase (COX) deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multisystem clinical features plus biochemical evidence of combined respiratory chain defects and genetic confirmation of pathogenic variants",
    "notes": "Diagnosis requires integration of clinical, biochemical, histological, and genetic data."
  },
