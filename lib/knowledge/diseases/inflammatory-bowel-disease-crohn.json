  "keyFindings": {
    "laboratory": [
      "Elevated CRP and ESR",
      "Elevated fecal calprotectin (correlates with intestinal inflammation)",
      "Iron deficiency anemia",
      "B12 deficiency (ileal disease)",
      "Hypoalbuminemia (protein-losing enteropathy)",
      "Elevated white blood cell count",
      "ASCA (anti-Saccharomyces cerevisiae antibodies) positive (60-70%)",
      "pANCA usually negative (helps distinguish from UC)"
    ],
    "imaging": [
      "CT/MR enterography: bowel wall thickening, mural enhancement, mesenteric fat stranding (comb sign), strictures, fistulae, abscesses",
      "Pelvic MRI: perianal fistulae classification",
      "Small bowel capsule endoscopy: mucosal ulceration in small bowel",
      "Ileocolonoscopy: aphthous ulcers, deep linear ulcers, cobblestoning, skip lesions, strictures"
    ],
    "genetic": [
      "NOD2/CARD15 mutations (strongest single gene; especially for ileal disease)",
      "ATG16L1 (autophagy gene) variants",
      "IL23R protective variants",
      "Over 200 susceptibility loci identified by GWAS"
    ],
    "other": [
      "Endoscopic biopsies: focal chronic inflammation, granulomas (30%), architectural distortion, transmural lymphoid aggregates",
      "Video capsule endoscopy: for suspected small bowel Crohn's after excluding strictures"
    ]
  },
