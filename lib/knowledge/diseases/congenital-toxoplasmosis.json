  "diagnosticCriteria": {
    "formalCriteriaName": "Congenital Toxoplasmosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "serology",
        "description": "Detection of Toxoplasma-specific IgM or IgA antibodies in neonatal serum or cerebrospinal fluid",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical signs consistent with congenital toxoplasmosis such as chorioretinitis, intracranial calcifications, or hydrocephalus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "molecular-detection",
        "description": "Detection of Toxoplasma gondii DNA by PCR in amniotic fluid, neonatal blood, or cerebrospinal fluid",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-findings",
        "description": "Neuroimaging evidence of intracranial calcifications or hydrocephalus",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of Toxoplasma-specific IgM or IgA antibodies in neonatal serum or CSF plus compatible clinical features",
    "notes": "PCR testing and imaging support diagnosis but are not always required if serology and clinical features are definitive."
  },
