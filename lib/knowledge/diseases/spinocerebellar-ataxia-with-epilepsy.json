  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Spinocerebellar Ataxia with Epilepsy",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epilepsy-history",
        "description": "Documented history of recurrent epileptic seizures confirmed by EEG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in known SCA-related gene associated with epilepsy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuroimaging-findings",
        "description": "MRI evidence of cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of ataxia and epilepsy by clinical and laboratory evaluation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia and documented epilepsy with exclusion of other causes; genetic confirmation supports diagnosis but is not mandatory.",
    "notes": "Genetic heterogeneity exists; some patients may have atypical presentations."
  },
