  "diagnosticCriteria": {
    "formalCriteriaName": "EFNS/PNS Diagnostic Criteria for CIDP (adapted for subacute onset)",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive or relapsing motor and sensory neuropathy with subacute onset (4-8 weeks)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiological-evidence",
        "description": "Nerve conduction studies demonstrating demyelination (prolonged distal latencies, conduction block, temporal dispersion)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "csf-protein-elevation",
        "description": "Elevated cerebrospinal fluid protein with normal cell count (albuminocytologic dissociation)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Nerve biopsy showing demyelination and inflammatory infiltrates",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of alternative causes such as Guillain-Barré syndrome or hereditary neuropathies",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Subacute progressive motor and sensory neuropathy with electrophysiological evidence of demyelination and exclusion of alternative diagnoses",
    "notes": "Diagnosis relies on clinical presentation and electrophysiological findings; CSF and biopsy findings support diagnosis."
  },
