  "keyFindings": {
    "laboratory": [
      "Mild anemia on complete blood count",
      "Elevated inflammatory markers (ESR, CRP) during active disease"
    ],
    "imaging": [
      "Laryngoscopy showing mucosal erosions and granulation tissue",
      "Chest X-ray may show airway narrowing in severe cases"
    ],
    "genetic": [
      "LAMA3 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy demonstrating epidermolysis with granulation tissue",
      "Histopathology negative for basement membrane zone abnormalities"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "epidermolysis-bullosa-simplex",
      "distinguishingFeatures": [
        "Absence of laryngeal involvement",
        "Different genetic mutations (keratin genes)",
        "Blistering primarily on trauma-exposed skin without granulation tissue"
      ]
    },
    {
      "diseaseId": "junctional-epidermolysis-bullosa",
      "distinguishingFeatures": [
        "Severe mucocutaneous blistering at birth",
        "Different immunofluorescence findings",
        "No characteristic onychodystrophy as in LOC syndrome"
      ]
    }
  ],
  "redFlags": [
    "Progressive airway obstruction causing respiratory distress",
    "Severe laryngeal granulation tissue leading to stridor",
    "Secondary bacterial infections of skin lesions"
  ],
