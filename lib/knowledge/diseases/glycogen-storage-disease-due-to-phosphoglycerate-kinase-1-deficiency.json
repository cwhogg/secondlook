        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the PGK1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of hemolytic anemia and/or myopathy with exercise intolerance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing glycogen accumulation and decreased PGK1 activity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced PGK1 enzyme activity and pathogenic PGK1 gene variants along with compatible clinical features",
    "notes": "Diagnosis is confirmed by biochemical enzyme assay and molecular genetic testing."
  },
