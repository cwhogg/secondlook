  "keyFindings": {
    "laboratory": [
      "Mildly elevated inflammatory markers (ESR, CRP) in some cases",
      "Normal or mildly reduced DLCO on pulmonary function testing"
    ],
    "imaging": [
      "HRCT showing diffuse ground-glass opacities predominantly in lower lobes",
      "Absence of honeycombing or significant reticulation",
      "Mild volume loss in affected lung regions"
    ],
    "genetic": [],
    "other": [
      "Bronchoalveolar lavage showing increased pigmented macrophages",
      "Lung biopsy demonstrating alveolar macrophage accumulation and mild interstitial fibrosis"
    ]
  },
