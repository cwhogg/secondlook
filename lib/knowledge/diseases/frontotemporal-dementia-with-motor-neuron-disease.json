  "diagnosticCriteria": {
    "formalCriteriaName": "Neary Criteria for Frontotemporal Dementia with Motor Neuron Disease",
    "criteria": [
      {
        "id": "behavioral-dysfunction",
        "description": "Progressive behavioral changes consistent with frontotemporal dementia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "motor-neuron-signs",
        "description": "Clinical evidence of motor neuron disease including upper and/or lower motor neuron signs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "Frontal and/or temporal lobe atrophy on MRI or CT",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "Electromyographic evidence of denervation and reinnervation consistent with motor neuron disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of dementia and motor neuron disease",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of progressive frontotemporal dementia symptoms plus clinical or electromyographic evidence of motor neuron disease, with exclusion of other causes",
    "notes": "Genetic testing may support diagnosis in familial cases."
  },
