  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (CK) levels",
      "Mildly elevated liver transaminases"
    ],
    "imaging": [
      "Muscle MRI showing fatty infiltration and muscle atrophy in proximal limb muscles",
      "Echocardiogram may reveal mild cardiomyopathy"
    ],
    "genetic": [
      "TRAPPC11 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy demonstrating dystrophic changes with fibrosis and fatty replacement"
    ]
