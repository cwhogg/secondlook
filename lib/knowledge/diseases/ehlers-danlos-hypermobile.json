  "keyFindings": {
    "laboratory": [
      "No specific laboratory markers; used to exclude other conditions",
      "Normal inflammatory markers (CRP, ESR)",
      "Genetic testing negative for other EDS subtypes"
    ],
    "imaging": [
      "Echocardiography may reveal mild mitral valve prolapse or aortic root dilation",
      "MRI may show disc degeneration or joint effusions disproportionate to age",
      "Upright MRI can assess craniocervical instability if suspected"
    ],
    "genetic": [
      "No known causative gene identified as of 2026",
      "Autosomal dominant inheritance pattern suspected",
      "Genetic testing used to exclude other EDS subtypes (COL5A1, COL3A1, TNXB, etc.)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Beighton score assessment",
      "Skin extensibility measurement",
      "Tilt table test for POTS/dysautonomia evaluation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "joint-hypermobility-syndrome",
      "distinguishingFeatures": [
        "JHS does not meet full 2017 hEDS criteria",
        "Fewer systemic manifestations",
        "May represent milder end of same spectrum"
      ]
    },
    {
      "diseaseId": "ehlers-danlos-classical",
      "distinguishingFeatures": [
        "cEDS has marked skin hyperextensibility and atrophic scarring",
        "cEDS confirmed by COL5A1/COL5A2 genetic testing",
        "Tissue fragility more prominent in cEDS"
      ]
    },
    {
      "diseaseId": "marfan-syndrome",
      "distinguishingFeatures": [
        "Marfan features tall stature with disproportionately long limbs",
        "Ectopia lentis present in Marfan",
        "Aortic root dilation more significant in Marfan",
        "FBN1 mutation in Marfan"
      ]
    },
    {
      "diseaseId": "fibromyalgia",
      "distinguishingFeatures": [
        "Fibromyalgia lacks joint hypermobility",
        "Fibromyalgia features widespread tender points",
        "No subluxations or dislocations in fibromyalgia",
        "Can co-occur with hEDS"
      ]
    }
  ],
  "redFlags": [
    "Arterial rupture or dissection (consider vascular EDS)",
