  "keyFindings": {
    "laboratory": [
      "No specific blood test; autoimmune markers may be positive in some cases",
      "Elevated inflammatory markers are uncommon"
    ],
    "imaging": [
      "Not routinely used; ultrasound may show urethral strictures if involved"
    ],
    "genetic": [
      "ATN1 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology is diagnostic with characteristic epidermal and dermal changes"
    ]
