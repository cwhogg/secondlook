  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild anemia or thrombocytopenia in some cases"
    ],
    "imaging": [
      "Brain MRI may show nonspecific cerebral atrophy or delayed myelination",
      "Skeletal X-rays may reveal scoliosis or joint contractures"
    ],
    "genetic": [
      "CREBBP (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electroencephalogram abnormalities consistent with seizure activity",
      "Feeding assessments demonstrating swallowing dysfunction"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "rubinstein-taybi-syndrome",
      "distinguishingFeatures": [
        "Distinct CREBBP mutations affecting different domains",
        "Broad thumbs and toes",
        "Characteristic facial features differing from Menke-Hennekam syndrome"
      ]
    },
    {
      "diseaseId": "cornelia-de-lange-syndrome",
      "distinguishingFeatures": [
        "Distinct facial features including synophrys and long eyelashes",
        "Limb abnormalities",
        "NIPBL or other gene mutations"
      ]
    }
  ],
  "redFlags": [
