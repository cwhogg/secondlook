  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Autosomal Dominant Omodysplasia",
    "criteria": [
      {
        "id": "short-upper-limbs",
        "description": "Marked shortening of the upper limbs, especially the humerus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including depressed nasal bridge and prominent forehead",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-omal-bone",
        "description": "Radiographic evidence of hypoplastic or absent omal (shoulder) bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Mild to moderate short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: upper limb shortening, characteristic facial dysmorphism, and radiological omal bone abnormalities",
    "notes": "Genetic testing for mutations in the FZD2 gene can confirm diagnosis but is not mandatory."
  },
