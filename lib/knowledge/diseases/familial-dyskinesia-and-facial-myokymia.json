  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Familial Dyskinesia and Facial Myokymia",
    "criteria": [
      {
        "id": "familial-history",
        "description": "Presence of autosomal dominant family history of dyskinesia and facial myokymia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-myokymia",
        "description": "Persistent facial myokymia characterized by continuous, involuntary, fine rippling movements of facial muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "paroxysmal-dyskinesia",
        "description": "Episodes of paroxysmal dyskinesia including chorea, dystonia, or athetosis affecting limbs and trunk",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of secondary causes of dyskinesia and myokymia such as metabolic, toxic, or structural brain lesions",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of familial history plus both facial myokymia and paroxysmal dyskinesia with exclusion of secondary causes",
    "notes": "Genetic testing may support diagnosis but is not yet definitive."
  },
