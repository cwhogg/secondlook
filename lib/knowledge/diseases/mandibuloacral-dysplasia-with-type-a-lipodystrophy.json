  "keyFindings": {
    "laboratory": [
      "Elevated fasting insulin and glucose indicating insulin resistance",
      "Dyslipidemia with elevated triglycerides"
    ],
    "imaging": [
      "Radiographic evidence of acro-osteolysis of distal phalanges",
      "Delayed cranial suture closure on skull X-rays",
      "Clavicular and other bone calcifications"
    ],
    "genetic": [
      "LMNA (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy showing dermal fibrosis and atrophy",
      "Electrocardiogram and echocardiogram for cardiomyopathy screening"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hutchinson-gilford-progeria-syndrome",
      "distinguishingFeatures": [
        "Earlier onset in infancy",
        "More severe growth retardation",
        "Generalized lipodystrophy rather than partial"
      ]
    },
    {
      "diseaseId": "mandibuloacral-dysplasia-type-b",
      "distinguishingFeatures": [
        "Type B lipodystrophy with generalized fat loss",
        "More prominent skin sclerosis",
        "Higher risk of severe pulmonary complications"
      ]
    },
    {
      "diseaseId": "familial-partial-lipodystrophy-type-2",
      "distinguishingFeatures": [
        "Lipodystrophy predominantly affecting limbs and trunk but without acro-osteolysis",
        "Later onset in adolescence or adulthood",
        "Absence of mandibular hypoplasia"
      ]
    }
  ],
  "redFlags": [
    "Progressive acro-osteolysis leading to digital deformities",
