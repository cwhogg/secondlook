  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific laboratory abnormalities"
    ],
    "imaging": [
      "Panoramic radiographs showing bilateral multilocular radiolucent lesions of the jaws",
      "CT scan demonstrating expansile fibro-osseous lesions with cortical thinning"
    ],
    "genetic": [
      "Mutations in SH3BP2 gene on chromosome 4p16.3"
    ],
    "other": [
      "Histopathology revealing fibrous stroma with multinucleated giant cells"
    ]
  },
  "differentialDiagnoses": [
