  "diagnosticCriteria": {
    "formalCriteriaName": "DCMA Diagnostic Criteria",
    "criteria": [
      {
        "id": "dilated-cardiomyopathy",
        "description": "Echocardiographic evidence of dilated cardiomyopathy with reduced left ventricular systolic function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-ataxia",
        "description": "Clinical signs of cerebellar ataxia including gait disturbance and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the DNAJC19 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation documented by anthropometric measurements",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss confirmed by audiometry",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of dilated cardiomyopathy and cerebellar ataxia with genetic confirmation of DNAJC19 mutation",
    "notes": "Genetic testing is essential to confirm diagnosis due to phenotypic overlap with other mitochondrial disorders."
  },
