      ]
    },
    {
      "diseaseId": "5-alpha-reductase-deficiency",
      "distinguishingFeatures": [
        "Normal androgen receptor function",
        "Impaired conversion of testosterone to dihydrotestosterone",
        "Virialization at puberty often more pronounced"
      ]
    }
  ],
