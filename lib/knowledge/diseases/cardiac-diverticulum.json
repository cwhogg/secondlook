  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible elevated BNP in heart failure"
    ],
    "imaging": [
      "Echocardiography showing contractile ventricular outpouching",
      "Cardiac MRI demonstrating myocardial tissue in diverticulum wall",
      "CT angiography to exclude aneurysm or other structural abnormalities"
    ],
    "genetic": [
      "No specific genetic markers identified; may be associated with congenital syndromes in rare cases"
    ],
    "other": [
      "Histopathology confirming presence of all three cardiac layers in diverticulum wall"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ventricular-aneurysm",
      "distinguishingFeatures": [
        "Aneurysm shows fibrotic scar tissue and dyskinetic wall motion",
        "Diverticulum contracts synchronously with ventricle"
      ]
    },
    {
      "diseaseId": "left-ventricular-pseudoaneurysm",
      "distinguishingFeatures": [
        "Pseudoaneurysm lacks myocardial layer and has narrow neck",
        "Usually post-myocardial infarction or trauma"
      ]
    }
  ],
