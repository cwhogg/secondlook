  "keyFindings": {
    "laboratory": [
      "Reduced or absent steroid sulfatase enzyme activity in leukocytes or skin fibroblasts",
      "Normal routine blood tests"
    ],
    "imaging": [
      "Corneal punctate opacities on slit-lamp examination",
      "Brain MRI usually normal unless contiguous gene deletion syndrome"
    ],
    "genetic": [
