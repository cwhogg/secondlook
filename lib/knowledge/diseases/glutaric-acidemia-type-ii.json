  "keyFindings": {
    "laboratory": [
      "Elevated plasma acylcarnitines (C4-C18 species)",
      "Increased urinary organic acids including glutaric acid",
      "Hypoglycemia with low ketones",
      "Metabolic acidosis with elevated anion gap"
    ],
    "imaging": [
      "Muscle MRI showing lipid accumulation",
      "Echocardiogram revealing cardiomyopathy"
    ],
    "genetic": [
      "Pathogenic variants in ETFA, ETFB, or ETFDH genes"
    ],
    "other": [
      "Muscle biopsy showing lipid storage myopathy"
    ]
