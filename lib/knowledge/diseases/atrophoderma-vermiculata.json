  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Diagnostic Criteria for Atrophoderma Vermiculata",
    "criteria": [
      {
        "id": "clinical-lesions",
        "description": "Presence of characteristic honeycomb or worm-eaten atrophic depressions primarily on the cheeks and upper cheeks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "follicular-involvement",
        "description": "Follicular plugging and perifollicular erythema observed clinically and histologically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological evidence of dermal atrophy with perifollicular fibrosis and mild inflammatory infiltrate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-scarring",
        "description": "No evidence of scarring alopecia or other scarring dermatoses",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: characteristic clinical lesions, follicular involvement, and supportive histopathology",
    "notes": "Diagnosis is primarily clinical supported by histopathology; genetic testing is not routinely available."
  },
