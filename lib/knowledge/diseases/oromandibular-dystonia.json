      ]
    },
    {
      "diseaseId": "temporomandibular-joint-disorder",
      "distinguishingFeatures": [
        "Pain localized to TMJ with mechanical jaw dysfunction",
        "Absence of involuntary muscle contractions"
      ]
    },
    {
      "diseaseId": "psychogenic-dystonia",
