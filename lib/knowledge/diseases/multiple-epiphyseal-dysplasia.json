  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiographic Diagnostic Criteria for Multiple Epiphyseal Dysplasia",
    "criteria": [
      {
        "id": "epiphyseal-abnormalities",
        "description": "Radiographic evidence of irregular, delayed, or abnormal epiphyseal ossification",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-pain-stiffness",
        "description": "Chronic joint pain and stiffness, especially in hips, knees, and ankles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "early-osteoarthritis",
        "description": "Clinical or radiographic evidence of early-onset osteoarthritis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic epiphyseal abnormalities on imaging plus clinical symptoms of joint pain or stiffness",
    "notes": "Genetic testing for mutations in COMP, MATN3, or COL9A1-3 genes can support diagnosis"
  },
