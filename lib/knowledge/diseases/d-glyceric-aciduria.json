  "diagnosticCriteria": {
    "formalCriteriaName": "Biochemical and genetic diagnostic criteria for D-glyceric aciduria",
    "criteria": [
      {
        "id": "urinary-d-glyceric-acid-elevation",
        "description": "Marked elevation of D-glyceric acid in urine organic acid analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of D-glycerate dehydrogenase deficiency in fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the GLYCTK gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of neurological symptoms such as developmental delay or hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated urinary D-glyceric acid plus either enzyme deficiency or pathogenic GLYCTK variants",
    "notes": "Diagnosis is confirmed by biochemical and genetic testing; clinical presentation may vary."
  },
