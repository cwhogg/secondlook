  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Imaging Diagnostic Criteria for Thyroid Ectopia",
    "criteria": [
      {
        "id": "imaging-confirmation",
        "description": "Identification of thyroid tissue outside the normal anatomic location by ultrasound, scintigraphy, or MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-normal-thyroid",
        "description": "Absence or hypoplasia of orthotopic thyroid gland on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-hypothyroidism",
        "description": "Clinical or biochemical evidence of hypothyroidism or thyroid dysfunction",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathological-confirmation",
        "description": "Histological confirmation of ectopic thyroid tissue if biopsy performed",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of ectopic thyroid tissue confirmed by imaging with absent or hypoplastic orthotopic thyroid gland",
    "notes": "Biopsy is rarely required unless malignancy is suspected."
  },
