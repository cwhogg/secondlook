  "diagnosticCriteria": {
    "formalCriteriaName": "Microsporidiosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "microscopic-identification",
        "description": "Identification of microsporidial spores in clinical specimens by microscopy with special stains (e.g., modified trichrome)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "molecular-detection",
        "description": "Detection of microsporidial DNA by PCR in clinical samples",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical symptoms such as chronic diarrhea or keratoconjunctivitis in immunocompromised patients",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Identification of microsporidial spores by microscopy or positive PCR for microsporidia DNA in clinical specimens",
    "notes": "Diagnosis is confirmed by direct visualization or molecular detection; clinical features support but are not definitive alone."
  },
