  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological and Immunohistochemical Diagnostic Criteria for Gallbladder Neuroendocrine Tumors",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histological identification of neuroendocrine tumor cells in gallbladder tissue biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Positive immunohistochemical staining for neuroendocrine markers such as chromogranin A, synaptophysin, and CD56",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Radiological evidence of gallbladder mass with features suggestive of neuroendocrine tumor on CT or MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of symptoms consistent with gallbladder tumor such as jaundice or abdominal pain",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation with positive immunohistochemical staining for neuroendocrine markers",
    "notes": "Diagnosis requires tissue biopsy; imaging and clinical features support but are not definitive alone."
  },
