  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnostic criteria for Tricho-dento-osseous syndrome",
    "criteria": [
      {
        "id": "hair-abnormalities",
        "description": "Kinky, curly, or coarse hair texture present from birth or early infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-anomalies",
        "description": "Enamel hypoplasia, taurodontism, and dental caries",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-thickening",
        "description": "Increased bone density and thickening of cranial bones (skull sclerosis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "DLX3-mutation",
        "description": "Presence of pathogenic DLX3 gene mutation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical features (hair abnormalities, dental anomalies, and bone thickening) or identification of pathogenic DLX3 mutation with compatible clinical features",
    "notes": "Genetic testing for DLX3 mutations is confirmatory but not always available; clinical diagnosis relies on characteristic triad."
  },
