  "diagnosticCriteria": {
    "formalCriteriaName": "Emery-Dreifuss Muscular Dystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "early-contractures",
        "description": "Early-onset contractures of the elbows, Achilles tendons, and posterior cervical muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-weakness-pattern",
        "description": "Progressive muscle weakness and wasting predominantly affecting humeroperoneal muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-conduction-defects",
        "description": "Cardiac conduction defects including atrioventricular block and arrhythmias",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the EMD or related genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consistent autosomal recessive inheritance pattern in family history",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early contractures, characteristic muscle weakness pattern, and cardiac conduction defects; genetic confirmation supports diagnosis",
    "notes": "Genetic testing is recommended to confirm diagnosis and differentiate from X-linked forms."
  },
