  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate)",
      "Normal or mildly elevated lactate"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle involvement",
      "Chest X-ray showing scoliosis and reduced lung volumes"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy demonstrating multiple small cores with reduced oxidative enzyme activity",
      "Electromyography showing myopathic changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "central-core-disease",
      "distinguishingFeatures": [
        "Larger single cores on muscle biopsy",
        "Often associated with malignant hyperthermia susceptibility",
        "Usually milder respiratory involvement"
      ]
    },
    {
      "diseaseId": "nemaline-myopathy",
      "distinguishingFeatures": [
        "Presence of nemaline rods on muscle biopsy",
        "More prominent facial weakness",
        "Different genetic mutations (e.g. ACTA1, NEB)"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive respiratory failure",
    "Severe scoliosis causing restrictive lung disease",
    "Early onset feeding difficulties with aspiration risk"
  ],
