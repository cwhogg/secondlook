    ],
    "imaging": [
      "Echocardiography showing patent ductus arteriosus or septal defects",
      "Cranial ultrasound or MRI showing microcephaly or calcifications",
      "Ophthalmologic exam revealing cataracts or glaucoma"
    ],
    "genetic": [
      "No specific genetic mutation; caused by in utero rubella virus infection"
    ],
