        "description": "Evidence of immune dysregulation including lymphoproliferation, autoimmunity, or elevated IgM",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotyping",
        "description": "Abnormal B and T cell subsets consistent with activated PI3K delta syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of lymphadenopathy, hepatosplenomegaly, or bronchiectasis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic PIK3R1 mutation plus at least two major clinical features including recurrent infections and immune dysregulation",
    "notes": "Diagnosis requires genetic confirmation and clinical correlation; immunophenotyping supports diagnosis."
  },
