  "diagnosticCriteria": {
    "formalCriteriaName": "Bethlem Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "contractures",
        "description": "Presence of early-onset contractures, especially of the elbows, ankles, and fingers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-weakness",
        "description": "Mild to moderate proximal muscle weakness with slow progression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant family history consistent with Bethlem myopathy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing characteristic collagen VI deficiency or abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in COL6A1, COL6A2, or COL6A3 genes",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset contractures and proximal muscle weakness plus either pathogenic COL6 gene mutation or characteristic muscle biopsy findings",
    "notes": "Diagnosis is supported by clinical features, family history, muscle biopsy, and confirmed by genetic testing."
  },
