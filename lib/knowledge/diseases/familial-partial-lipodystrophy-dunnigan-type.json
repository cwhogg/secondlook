  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Familial Partial Lipodystrophy, Dunnigan Type",
    "criteria": [
      {
        "id": "partial-lipodystrophy",
        "description": "Progressive loss of subcutaneous adipose tissue from the limbs and trunk with fat accumulation in the face and neck",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-abnormalities",
        "description": "Presence of insulin resistance, diabetes mellitus, hypertriglyceridemia, or hepatic steatosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lmna-mutation",
        "description": "Identification of pathogenic heterozygous mutation in the LMNA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscular-hypertrophy",
        "description": "Prominent muscular hypertrophy especially in the limbs",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of partial lipodystrophy with metabolic abnormalities plus identification of LMNA gene mutation",
    "notes": "Genetic testing is confirmatory; clinical presentation may vary in severity."
  },
