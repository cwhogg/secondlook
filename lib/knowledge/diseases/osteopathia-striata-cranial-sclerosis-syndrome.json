  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Osteopathia Striata with Cranial Sclerosis",
    "criteria": [
      {
        "id": "cranial-sclerosis",
        "description": "Radiological evidence of cranial sclerosis with thickened cranial bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "osteopathia-striata",
        "description": "Longitudinal striations of metaphyseal and diaphyseal cortical bone on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic facial dysmorphism including frontal bossing and macrocephaly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the AMER1 (WTX) gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of cranial sclerosis and osteopathia striata on imaging plus either pathogenic AMER1 mutation or characteristic clinical features",
    "notes": "Genetic confirmation is strongly recommended for definitive diagnosis."
  },
