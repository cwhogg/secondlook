  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "microdeletion-confirmation",
        "description": "Detection of microdeletion at chromosome 14q22q23 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "Presence of bilateral anophthalmia or severe microphthalmia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pituitary-hypoplasia",
        "description": "Evidence of pituitary gland hypoplasia or dysfunction leading to hormonal deficiencies",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including midface hypoplasia and cleft palate",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed 14q22q23 microdeletion with at least one major clinical feature such as bilateral anophthalmia or pituitary hypoplasia",
    "notes": "Diagnosis relies heavily on genetic testing combined with clinical features; no standardized formal diagnostic criteria exist."
  },
