  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for COG5-CDG",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of multisystemic clinical features including developmental delay, hypotonia, and dysmorphic features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "transferrin-analysis",
        "description": "Abnormal serum transferrin glycosylation pattern consistent with type II CDG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the COG5 gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-lab",
        "description": "Additional biochemical abnormalities such as abnormal glycoprotein profiles",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus abnormal transferrin glycosylation and confirmation of pathogenic COG5 variants",
    "notes": "Diagnosis requires integration of clinical, biochemical, and genetic data."
  },
