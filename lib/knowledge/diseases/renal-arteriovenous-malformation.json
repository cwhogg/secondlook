  "keyFindings": {
    "laboratory": [
      "Microscopic or gross hematuria on urinalysis",
      "Mild proteinuria",
      "Possible anemia secondary to hematuria"
    ],
    "imaging": [
      "Renal angiography showing direct arteriovenous communication",
      "Contrast-enhanced CT or MRI demonstrating vascular malformation",
      "Doppler ultrasound revealing turbulent flow in renal vessels"
    ],
    "genetic": [],
    "other": [
      "Audible renal bruit on auscultation",
      "Elevated blood pressure readings"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "renal-cell-carcinoma",
      "distinguishingFeatures": [
        "Presence of solid renal mass on imaging",
        "Systemic symptoms like weight loss and fever",
        "No direct arteriovenous communication on angiography"
      ]
    },
    {
      "diseaseId": "renal-artery-stenosis",
      "distinguishingFeatures": [
        "Narrowing of renal artery without AV communication",
        "Hypertension without hematuria",
        "Imaging shows arterial stenosis rather than malformation"
      ]
    },
    {
      "diseaseId": "renal-vein-thrombosis",
      "distinguishingFeatures": [
        "Sudden flank pain with hematuria",
        "Imaging shows thrombus in renal vein",
        "No abnormal arterial-venous connections"
      ]
    }
  ],
  "redFlags": [
