  "diagnosticCriteria": {
    "formalCriteriaName": "Holmgren Lethal Bone Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "severe-micromelia",
        "description": "Severe micromelia with markedly shortened long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thoracic-hypoplasia",
        "description": "Hypoplastic thorax leading to respiratory insufficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-bone-abnormalities",
        "description": "Characteristic radiographic findings including metaphyseal flaring and irregular ossification",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features including midface hypoplasia and frontal bossing",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "perinatal-lethality",
        "description": "Perinatal lethality due to pulmonary hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: severe micromelia, thoracic hypoplasia, and characteristic radiographic bone abnormalities",
    "notes": "Diagnosis is primarily clinical and radiological; genetic testing may assist but specific gene mutations are not well characterized."
  },
