  "diagnosticCriteria": {
    "formalCriteriaName": "Enhanced S-Cone Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic NR2E3 gene mutations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroretinogram-pattern",
        "description": "Electroretinogram showing increased S-cone responses with reduced rod and L/M cone function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fundus-appearance",
        "description": "Characteristic fundus changes including pigmentary retinopathy and macular schisis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Night blindness and impaired dark adaptation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic NR2E3 mutation plus characteristic ERG pattern and fundus appearance",
    "notes": "Diagnosis relies heavily on genetic testing and electrophysiological studies."
  },
