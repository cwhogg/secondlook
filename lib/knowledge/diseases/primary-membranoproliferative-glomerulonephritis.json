  "diagnosticCriteria": {
    "formalCriteriaName": "Membranoproliferative Glomerulonephritis Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Renal biopsy showing mesangial cell proliferation with double-contour formation of glomerular basement membrane",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immune-complex-deposition",
        "description": "Immunofluorescence demonstrating granular deposits of C3 and immunoglobulins in glomeruli",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of nephrotic or nephritic syndrome with proteinuria and hematuria",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "complement-levels",
        "description": "Low serum complement levels (especially C3) supporting complement pathway activation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Renal biopsy confirming characteristic histopathology plus clinical presentation consistent with nephritic or nephrotic syndrome",
    "notes": "Exclusion of secondary causes such as infections, autoimmune diseases, and monoclonal gammopathies is essential."
  },
