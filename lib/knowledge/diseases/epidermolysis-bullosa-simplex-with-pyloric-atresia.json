  "keyFindings": {
    "laboratory": [
      "Anemia on complete blood count",
      "Electrolyte disturbances (hyponatremia, hypokalemia)"
    ],
    "imaging": [
      "Abdominal X-ray or contrast study showing pyloric atresia",
      "Ultrasound confirming gastric outlet obstruction"
    ],
    "genetic": [
      "PLEC (causative)",
      "ITGB4 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy showing intraepidermal cleavage",
      "Immunofluorescence mapping demonstrating reduced integrin α6β4"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "junctional-epidermolysis-bullosa-with-pyloric-atresia",
      "distinguishingFeatures": [
        "More extensive mucosal involvement",
        "Different genetic mutations (LAMB3, LAMC2, LAMA3)",
        "Histology shows cleavage within lamina lucida"
      ]
    },
    {
      "diseaseId": "epidermolysis-bullosa-simplex",
      "distinguishingFeatures": [
        "Absence of pyloric atresia",
        "Mutations in KRT5 or KRT14 genes",
        "Blistering limited to skin without gastrointestinal obstruction"
      ]
    }
  ],
  "redFlags": [
    "Neonatal gastric outlet obstruction symptoms (persistent vomiting, abdominal distension)",
    "Severe skin blistering with risk of infection and sepsis",
    "Failure to thrive in early infancy"
  ],
