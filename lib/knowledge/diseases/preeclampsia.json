  "keyFindings": {
    "laboratory": [
      "Proteinuria ≥300 mg/24 hours",
      "Elevated liver transaminases (AST, ALT)",
      "Thrombocytopenia (<100,000/µL)",
      "Elevated serum creatinine",
      "Hemolysis markers in severe cases"
