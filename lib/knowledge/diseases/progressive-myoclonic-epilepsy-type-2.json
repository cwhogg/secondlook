  "commonPitfalls": [
    "Often misdiagnosed as juvenile myoclonic epilepsy due to overlapping myoclonus and generalized seizures.",
    "May be confused with other progressive myoclonic epilepsies if Lafora bodies are not specifically sought on biopsy.",
    "Cognitive decline may be attributed to primary psychiatric disorders in early stages.",
    "Photosensitivity and visual hallucinations can be mistaken for primary visual disorders."
  ],
  "extendedDiscriminators": [
    {
      "vsCondition": "progressive-myoclonic-epilepsy-type-1",
      "feature": "Presence of Lafora bodies on skin or other tissue biopsy is specific for EPM2B (Lafora Disease Type 2), not seen in PME Type 1."
    },
    {
      "vsCondition": "unverricht-lundborg-disease",
      "feature": "EPM2B typically has a later onset (adolescence) and more rapid cognitive decline, with Lafora bodies on biopsy, whereas Unverricht-Lundborg has earlier onset and lacks Lafora bodies."
    },
    {
      "vsCondition": "neuronal-ceroid-lipofuscinosis",
      "feature": "EPM2B shows PAS-positive Lafora bodies on biopsy, while neuronal ceroid lipofuscinosis demonstrates autofluorescent lipopigment accumulation and vision loss is more prominent."
    }
  ],
  "ruleOutCriteria": [
    "Absence of Lafora bodies on skin or other tissue biopsy in a patient with compatible clinical features.",
    "Genetic testing negative for EPM2B (NHLRC1) mutations in the context of classic clinical presentation.",
    "Onset of symptoms exclusively in adulthood (after age 25) makes EPM2B highly unlikely."
  ],
