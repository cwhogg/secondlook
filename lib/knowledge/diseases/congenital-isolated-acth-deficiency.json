  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for isolated ACTH deficiency",
    "criteria": [
      {
        "id": "low-acth",
        "description": "Persistently low or undetectable plasma ACTH levels despite low cortisol",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-cortisol",
        "description": "Low serum cortisol levels not explained by adrenal pathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-other-pituitary-hormones",
        "description": "Normal secretion of other pituitary hormones excluding combined pituitary hormone deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-adrenal-abnormalities",
        "description": "No structural adrenal gland abnormalities on imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in genes associated with isolated ACTH deficiency (e.g., TBX19)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of low plasma ACTH and low serum cortisol with normal other pituitary hormones and exclusion of adrenal pathology",
    "notes": "Diagnosis requires exclusion of secondary causes and other pituitary hormone deficiencies."
  },
