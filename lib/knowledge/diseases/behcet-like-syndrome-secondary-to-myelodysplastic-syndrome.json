  "keyFindings": {
    "laboratory": [
      "Cytopenias (anemia, neutropenia, thrombocytopenia) consistent with MDS",
      "Elevated inflammatory markers (ESR, CRP)",
      "Negative pathergy test (often)",
      "Absence of HLA-B51 association"
    ],
    "imaging": [
      "MRI brain may show meningeal enhancement in neurological involvement",
      "CT angiography may reveal vascular aneurysms or thrombosis",
      "Endoscopy may demonstrate gastrointestinal ulcerations"
    ],
    "genetic": [
      "Somatic mutations associated with MDS (e.g., SF3B1, TET2, ASXL1) detected in hematopoietic cells"
    ],
    "other": [
      "Bone marrow biopsy confirming dysplastic hematopoiesis",
      "Temporal correlation of symptom onset with MDS diagnosis or progression"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "behcet-disease",
      "distinguishingFeatures": [
        "Primary autoimmune etiology without underlying hematologic malignancy",
        "Younger age of onset",
        "Positive pathergy test more common",
        "HLA-B51 association frequent"
      ]
    },
    {
      "diseaseId": "myelodysplastic-syndrome-with-autoimmune-features",
      "distinguishingFeatures": [
        "Autoimmune manifestations without classic Behçet-like mucocutaneous lesions",
        "More variable systemic symptoms",
        "Lack of recurrent oral and genital ulcers"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of cytopenias indicating MDS advancement",
    "Development of vascular aneurysms or thrombosis",
    "Neurological deterioration with meningoencephalitis signs"
  ],
