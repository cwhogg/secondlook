  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Bruck Syndrome",
    "criteria": [
      {
        "id": "congenital-contractures",
        "description": "Presence of congenital joint contractures (arthrogryposis multiplex congenita)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "osteogenesis-imperfecta-features",
        "description": "Clinical and radiological features of osteogenesis imperfecta including bone fragility and fractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in PLOD2 or FKBP10 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "blue-sclerae",
        "description": "Presence of blue sclerae",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "short-stature",
        "description": "Short stature and growth retardation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital joint contractures and osteogenesis imperfecta features plus genetic confirmation of pathogenic variants in PLOD2 or FKBP10",
    "notes": "Genetic testing is essential to differentiate Bruck syndrome from other osteogenesis imperfecta types with contractures."
  },
