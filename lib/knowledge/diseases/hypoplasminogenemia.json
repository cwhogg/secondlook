  "diagnosticCriteria": {
    "formalCriteriaName": "Hypoplasminogenemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "plasminogen-activity",
        "description": "Markedly reduced plasminogen activity in plasma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-pseudomembranes",
        "description": "Presence of ligneous pseudomembranes on mucous membranes (e.g., conjunctiva, gingiva)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the PLG gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Histological confirmation of fibrin-rich pseudomembranes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced plasminogen activity plus clinical evidence of ligneous pseudomembranes",
    "notes": "Genetic testing supports diagnosis but is not mandatory."
  },
