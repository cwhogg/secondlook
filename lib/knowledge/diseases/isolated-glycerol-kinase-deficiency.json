  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for isolated glycerol kinase deficiency",
    "criteria": [
      {
        "id": "elevated-urinary-glycerol",
        "description": "Persistent elevation of glycerol in urine detected by organic acid analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glycerol-kinase-activity-deficiency",
        "description": "Demonstrated deficiency of glycerol kinase enzyme activity in cultured fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-adrenal-or-muscle-involvement",
        "description": "Lack of clinical or biochemical evidence of adrenal hypoplasia or muscular dystrophy to exclude complex glycerol kinase deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the GK gene without contiguous gene deletions",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated urinary glycerol and confirmed glycerol kinase enzyme deficiency with exclusion of adrenal or muscular involvement",
    "notes": "Diagnosis requires differentiation from complex glycerol kinase deficiency and other metabolic disorders."
  },
