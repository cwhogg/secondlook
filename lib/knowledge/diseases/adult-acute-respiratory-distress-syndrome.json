  "keyFindings": {
    "laboratory": [
      "Arterial blood gas showing hypoxemia with low PaO2/FiO2 ratio",
      "Elevated inflammatory markers (e.g., CRP, procalcitonin) if infection present",
      "Normal or low cardiac biomarkers to exclude cardiogenic edema"
    ],
    "imaging": [
      "Chest X-ray or CT scan showing bilateral alveolar infiltrates",
      "Absence of cardiomegaly or pleural effusions to exclude cardiac causes"
    ],
    "genetic": [],
    "other": [
      "Pulmonary artery catheterization showing normal pulmonary capillary wedge pressure (<18 mmHg) to exclude cardiogenic pulmonary edema"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cardiogenic-pulmonary-edema",
      "distinguishingFeatures": [
        "Elevated pulmonary capillary wedge pressure",
        "Cardiomegaly on imaging",
        "Response to diuretics"
      ]
    },
    {
      "diseaseId": "pulmonary-embolism",
      "distinguishingFeatures": [
        "Sudden onset chest pain and dyspnea",
        "CT pulmonary angiography showing emboli",
        "Absence of bilateral infiltrates typical of ARDS"
      ]
    }
  ],
  "redFlags": [
