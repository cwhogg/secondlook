  "diagnosticCriteria": {
    "formalCriteriaName": "Baraitser-Winter Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "brain-malformations",
        "description": "Presence of characteristic brain malformations including pachygyria and lissencephaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinct-facial-features",
        "description": "Distinctive craniofacial features such as hypertelorism, ptosis, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "Ocular coloboma or other eye anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: brain malformations, distinct facial features, and intellectual disability",
    "notes": "Genetic testing confirming pathogenic variants in ACTB or ACTG1 genes supports diagnosis"
  },
