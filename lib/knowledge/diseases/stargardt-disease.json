  "diagnosticCriteria": {
    "formalCriteriaName": "Stargardt Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "central-vision-loss",
        "description": "Progressive bilateral central vision loss beginning in childhood or adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fundus-flavimaculatus",
        "description": "Presence of characteristic yellowish-white pisciform flecks at the level of the retinal pigment epithelium in the macula and mid-periphery",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology-abnormalities",
        "description": "Electroretinogram (ERG) showing normal or mildly reduced rod and cone responses",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the ABCA4 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Progressive bilateral central vision loss with characteristic fundus findings and/or pathogenic ABCA4 gene variants",
    "notes": "Genetic testing is increasingly used to confirm diagnosis; ERG may help differentiate from other retinal dystrophies."
  },
