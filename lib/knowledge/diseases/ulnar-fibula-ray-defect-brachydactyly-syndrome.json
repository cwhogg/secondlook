  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Ulnar/Fibula Ray Defect-Brachydactyly Syndrome",
    "criteria": [
      {
        "id": "ulnar-ray-defect",
        "description": "Presence of congenital ulnar ray deficiency characterized by hypoplasia or aplasia of the ulna",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fibula-ray-defect",
        "description": "Congenital fibular ray deficiency with partial or complete absence of the fibula",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brachydactyly",
        "description": "Brachydactyly involving shortening of the digits, particularly affecting the ulnar and fibular sides",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Additional limb malformations such as syndactyly or clinodactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiographic-confirmation",
        "description": "Radiographic evidence confirming bone deficiencies in the ulna and fibula",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital ulnar ray deficiency, fibular ray deficiency, and brachydactyly confirmed clinically and radiographically",
    "notes": "Diagnosis is primarily clinical supported by imaging; genetic testing may be inconclusive due to limited data."
  },
