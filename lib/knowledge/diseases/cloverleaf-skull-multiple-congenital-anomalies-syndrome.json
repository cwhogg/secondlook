  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Cloverleaf Skull Syndrome",
    "criteria": [
      {
        "id": "cloverleaf-skull",
        "description": "Presence of trilobed (cloverleaf-shaped) skull deformity due to premature craniosynostosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Severe midface hypoplasia and proptosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Presence of limb anomalies such as syndactyly or polydactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "vertebral-anomalies",
        "description": "Vertebral segmentation defects or scoliosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in FGFR genes (e.g., FGFR2 mutations)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of cloverleaf skull deformity plus at least one major craniofacial anomaly",
    "notes": "Genetic testing can support diagnosis but is not mandatory."
  },
