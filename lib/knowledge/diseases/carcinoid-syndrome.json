  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and biochemical criteria for carcinoid syndrome",
    "criteria": [
      {
        "id": "cs-c1",
        "description": "Elevated 24-hour urinary 5-hydroxyindoleacetic acid (5-HIAA)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cs-c2",
        "description": "Histologically confirmed neuroendocrine tumor (NET)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cs-c3",
        "description": "Characteristic clinical features (flushing, diarrhea, wheezing)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cs-c4",
        "description": "Elevated serum chromogranin A",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cs-c5",
        "description": "Hepatic metastases (syndrome typically develops only after hepatic metastasis for GI carcinoids)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cs-c6",
        "description": "Positive somatostatin receptor scintigraphy (OctreoScan) or 68Ga-DOTATATE PET",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical symptoms of carcinoid syndrome plus elevated 5-HIAA, with histologically confirmed neuroendocrine tumor",
    "notes": "Carcinoid syndrome occurs in <10% of patients with carcinoid tumors, usually requiring hepatic metastases to bypass first-pass hepatic metabolism of serotonin."
  },
