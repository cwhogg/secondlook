    "formalCriteriaName": "Diagnostic criteria for DDOST-CDG",
    "criteria": [
      {
        "id": "abnormal-n-glycosylation",
        "description": "Demonstration of abnormal N-glycosylation pattern on serum transferrin analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ddost-gene-mutation",
        "description": "Identification of biallelic pathogenic variants in the DDOST gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "multisystem-clinical-features",
        "description": "Presence of multisystem clinical features consistent with CDG, including developmental delay and hypotonia",
