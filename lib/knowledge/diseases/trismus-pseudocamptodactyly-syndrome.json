  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Trismus-pseudocamptodactyly syndrome",
    "criteria": [
      {
        "id": "trismus",
        "description": "Presence of trismus characterized by limited mouth opening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pseudocamptodactyly",
        "description": "Pseudocamptodactyly manifesting as finger flexion contractures during wrist extension",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "musculoskeletal-contractures",
        "description": "Congenital contractures of distal joints including camptodactyly and clubfoot",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in MYH8 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of trismus and pseudocamptodactyly with congenital distal joint contractures",
    "notes": "Genetic testing for MYH8 mutations supports diagnosis but is not mandatory"
  },
