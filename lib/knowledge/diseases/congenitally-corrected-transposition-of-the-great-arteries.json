  "keyFindings": {
    "laboratory": [
      "Elevated brain natriuretic peptide (BNP) in ventricular dysfunction",
      "Normal routine blood tests unless complications present"
    ],
    "imaging": [
      "Echocardiography showing atrioventricular and ventriculoarterial discordance",
      "Cardiac MRI confirming ventricular morphology and function",
      "Electrocardiogram demonstrating conduction abnormalities"
    ],
    "genetic": [
      "No specific genetic mutation identified; sporadic occurrence",
      "Rare familial cases reported"
    ],
    "other": [
      "Electrophysiological studies for arrhythmia evaluation",
      "Cardiac catheterization for hemodynamic assessment if needed"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "transposition-of-the-great-arteries",
      "distinguishingFeatures": [
        "Atrioventricular concordance with ventriculoarterial discordance",
        "Systemic left ventricle supporting systemic circulation",
        "Presentation usually in neonatal period with cyanosis"
      ]
    },
    {
      "diseaseId": "double-outlet-right-ventricle",
      "distinguishingFeatures": [
        "Both great arteries arise predominantly from right ventricle",
        "Variable ventricular septal defects",
        "No atrioventricular discordance"
      ]
    }
  ],
  "redFlags": [
    "Progressive systemic right ventricular failure",
    "Complete heart block or high-grade atrioventricular block",
    "Severe tricuspid valve regurgitation leading to heart failure"
  ],
