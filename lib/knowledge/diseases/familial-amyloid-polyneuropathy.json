  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Amyloid Polyneuropathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic transthyretin (TTR) gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-neuropathy",
        "description": "Presence of progressive peripheral sensorimotor polyneuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "amyloid-deposition",
        "description": "Demonstration of amyloid deposits in tissue biopsy (nerve, fat pad, or organ)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of amyloidosis or neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-involvement",
        "description": "Evidence of cardiac amyloidosis by imaging or biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic TTR mutation plus clinical evidence of progressive peripheral neuropathy and amyloid deposition on biopsy",
    "notes": "Genetic testing is essential; biopsy may be omitted if genetic and clinical findings are definitive."
  },
