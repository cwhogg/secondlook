  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (ESR, CRP)",
      "Mild anemia of chronic disease",
      "Negative rheumatoid factor and ANA"
    ],
    "imaging": [
      "Joint X-rays showing synovial thickening without erosions",
      "Chest radiograph may show pulmonary nodules",
      "Ultrasound or MRI showing tenosynovitis"
    ],
    "genetic": [
      "NOD2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Skin biopsy showing non-caseating granulomas",
      "Synovial biopsy demonstrating granulomatous inflammation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "juvenile-rheumatoid-arthritis",
      "distinguishingFeatures": [
        "Absence of granulomatous dermatitis and uveitis",
        "Negative NOD2 mutation",
        "Different joint involvement pattern"
      ]
    },
    {
      "diseaseId": "sarcoidosis",
      "distinguishingFeatures": [
        "Usually adult onset",
        "Pulmonary involvement more prominent",
        "No familial inheritance pattern"
      ]
    },
    {
      "diseaseId": "tuberculosis",
      "distinguishingFeatures": [
        "Caseating granulomas on biopsy",
        "Positive acid-fast bacilli stain",
        "Response to anti-tuberculous therapy"
      ]
    }
  ],
