  "keyFindings": {
    "laboratory": [
      "Organ-specific autoantibodies: 21-hydroxylase (adrenal), anti-TPO/TG (thyroid), anti-GAD/IA2/ZnT8 (islet), anti-parietal cell/intrinsic factor (gastric)",
      "Anti-interferon-omega and anti-IL-22 antibodies (Type 1 APECED; highly sensitive and specific)",
      "Low cortisol with elevated ACTH (adrenal insufficiency)",
      "Abnormal thyroid function tests",
      "Hypocalcemia with low PTH (hypoparathyroidism in Type 1)",
      "Hyperglycemia/elevated HbA1c (diabetes)",
      "Low B12 with macrocytic anemia (pernicious anemia)"
    ],
    "imaging": [
      "CT adrenals: small/atrophic adrenals (autoimmune adrenalitis)",
      "Thyroid ultrasound: features of Hashimoto's or Graves'",
      "DEXA scan: osteopenia (multiple endocrine deficiencies)"
    ],
    "genetic": [
      "AIRE (causative, loss-of-function)",
      "Type 1 (APECED): AIRE gene mutations (autosomal recessive; chromosome 21q22.3)",
      "Type 2: polygenic inheritance"
    ],
    "other": [
      "Regular screening for new autoimmune components (annual thyroid function, cortisol, glucose, B12, celiac antibodies, calcium/PTH)",
      "Family screening in Type 1 (AIRE gene testing) and monitoring in Type 2"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "addison-disease",
      "distinguishingFeatures": [
        "Isolated adrenal insufficiency without other endocrinopathies",
        "May be early presentation of APS Type 2; screen for additional components"
      ]
    },
    {
      "diseaseId": "hashimoto-thyroiditis",
      "distinguishingFeatures": [
        "Isolated thyroid involvement",
        "No adrenal or islet cell disease",
        "May progress to APS if additional glands become affected"
      ]
    },
    {
      "diseaseId": "type-1-diabetes",
      "distinguishingFeatures": [
        "Isolated islet autoimmunity",
        "Screen for thyroid and adrenal antibodies to detect evolving APS"
      ]
    },
    {
      "diseaseId": "digeorge-syndrome",
      "distinguishingFeatures": [
        "22q11 deletion",
        "Hypoparathyroidism but from developmental absence",
        "Cardiac defects",
        "No autoimmune adrenalitis"
      ]
    }
  ],
  "redFlags": [
    "Adrenal crisis in patient with known thyroid or diabetes autoimmunity (undiagnosed Addison's)",
    "New endocrine organ failure in patient with existing autoimmune endocrine disease",
    "Hypocalcemic seizures (undiagnosed hypoparathyroidism)",
    "Severe mucocutaneous candidiasis in childhood (APECED screening needed)",
    "Autoimmune hepatitis in child with candidiasis (APECED - can be fatal)"
  ],
