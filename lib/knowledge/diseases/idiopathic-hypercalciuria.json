  "diagnosticCriteria": {
    "formalCriteriaName": "Idiopathic Hypercalciuria Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypercalciuria",
        "description": "Elevated urinary calcium excretion (>4 mg/kg/day) in the absence of hypercalcemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-serum-calcium",
        "description": "Normal serum calcium concentration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-secondary-causes",
        "description": "Exclusion of secondary causes of hypercalciuria such as hyperparathyroidism, vitamin D intoxication, or malignancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of hypercalciuria or nephrolithiasis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-renal-function",
        "description": "Normal renal function tests",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated urinary calcium excretion with normal serum calcium and exclusion of secondary causes",
    "notes": "Diagnosis is primarily clinical and biochemical after ruling out other causes of hypercalciuria."
  },
