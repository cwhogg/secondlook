        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-hypermobility",
        "description": "Generalized joint hypermobility with recurrent dislocations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-hypotonia",
        "description": "Congenital or early-onset muscle hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal abnormalities including scoliosis and short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "X-linked inheritance pattern with affected males and carrier females",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (skin hyperextensibility and joint hypermobility) plus either a minor criterion or a positive family history",
    "notes": "Genetic testing for mutations in the FLNA gene can confirm diagnosis"
