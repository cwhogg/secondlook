  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for CANDLE Syndrome",
    "criteria": [
      {
        "id": "chronic-dermatitis",
        "description": "Chronic atypical neutrophilic dermatosis presenting as recurrent violaceous plaques and nodules",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lipodystrophy",
        "description": "Progressive lipodystrophy affecting face and extremities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "interferon-signature",
        "description": "Elevated type I interferon signature on molecular testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fever",
        "description": "Recurrent or persistent low-grade fever",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "arthralgia",
        "description": "Non-erosive joint pain or swelling",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic mutations in PSMB8 or related proteasome subunit genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria or two major criteria plus genetic confirmation",
    "notes": "Diagnosis is supported by clinical presentation, laboratory findings, and confirmed by genetic testing."
  },
