  "diagnosticCriteria": {
    "formalCriteriaName": "Gold Coast Criteria (2019) / Revised El Escorial Criteria",
    "criteria": [
      {
        "id": "als-1",
        "description": "Progressive motor impairment documented by history or clinical examination with evidence of upper motor neuron (UMN) and lower motor neuron (LMN) dysfunction in at least one body region, OR LMN dysfunction in at least two body regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "als-2",
        "description": "Absence of alternative explanation for the clinical presentation based on investigations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "als-3",
        "description": "EMG evidence of active and chronic denervation in clinically affected and unaffected regions",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "als-4",
        "description": "Progressive spread of symptoms within a region or to other regions",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "als-5",
        "description": "Neuroimaging to exclude structural mimics",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Gold Coast Criteria: Progressive motor impairment with UMN and LMN signs in one region OR LMN signs in two regions, plus exclusion of alternative diagnoses.",
    "notes": "Body regions: bulbar, cervical, thoracic, lumbosacral. The Gold Coast criteria simplify and improve sensitivity over El Escorial criteria. Familial ALS (~10%) and C9orf72-associated ALS may have atypical presentations."
  },
