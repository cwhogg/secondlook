  "diagnosticCriteria": {
    "formalCriteriaName": "No formal diagnostic criteria established",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of duplication involving chromosome 15q region by chromosomal microarray or karyotyping",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "overgrowth",
        "description": "Postnatal generalized overgrowth exceeding 2 standard deviations above mean height and/or weight",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Presence of developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "dysmorphic-features",
        "description": "Characteristic craniofacial dysmorphic features including macrocephaly and broad forehead",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 15q duplication plus presence of overgrowth phenotype",
    "notes": "Diagnosis relies primarily on genetic testing combined with clinical features; no standardized clinical criteria exist."
  },
