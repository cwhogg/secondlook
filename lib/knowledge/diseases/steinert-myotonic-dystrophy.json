  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Myotonic Dystrophy Type 1",
    "criteria": [
      {
        "id": "myotonia",
        "description": "Presence of clinical myotonia demonstrated by delayed muscle relaxation after contraction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-weakness",
        "description": "Distal muscle weakness and atrophy, especially in hand and facial muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ctg-repeat-expansion",
        "description": "Detection of expanded CTG trinucleotide repeat in the DMPK gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cataracts",
        "description": "Early-onset posterior subcapsular cataracts",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-conduction",
        "description": "Cardiac conduction defects identified on ECG",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical myotonia and muscle weakness combined with molecular confirmation of CTG repeat expansion in DMPK gene",
    "notes": "Genetic testing is definitive; clinical features support diagnosis and guide management."
  },
