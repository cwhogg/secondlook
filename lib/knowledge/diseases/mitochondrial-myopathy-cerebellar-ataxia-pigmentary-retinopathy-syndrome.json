  "keyFindings": {
    "laboratory": [
      "Elevated serum lactate and pyruvate levels",
      "Increased creatine kinase (mild to moderate elevation)",
      "Muscle biopsy showing ragged-red fibers and cytochrome c oxidase (COX) negative fibers"
    ],
    "imaging": [
      "MRI brain demonstrating cerebellar atrophy",
      "Optical coherence tomography (OCT) showing retinal pigment epithelium abnormalities"
    ],
    "genetic": [
      "MSTO1 (causative)",
      "Pathogenic mutations in mitochondrial DNA (mtDNA) or nuclear genes affecting mitochondrial function (e.g., POLG, TWNK)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography consistent with myopathic changes",
      "Visual field testing showing constricted peripheral vision"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "mitochondrial-encephalomyopathy-lactic-acidosis-and-stroke-like-episodes",
      "distinguishingFeatures": [
        "Stroke-like episodes with acute neurological deficits",
        "Elevated lactate in CSF",
        "Distinctive MRI findings with cortical involvement"
      ]
    },
    {
      "diseaseId": "leber-hereditary-optic-neuropathy",
      "distinguishingFeatures": [
        "Acute or subacute painless central vision loss",
        "Predominantly optic nerve involvement without cerebellar ataxia",
        "Specific mtDNA point mutations"
      ]
    }
  ],
