  "diagnosticCriteria": {
    "formalCriteriaName": "Isochromosomy Yp Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Presence of isochromosome Yp detected by karyotyping or FISH analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gonadal-dysgenesis",
        "description": "Clinical or histological evidence of gonadal dysgenesis or dysgenetic testes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ambiguous-genitalia",
        "description": "Presence of ambiguous or underdeveloped external genitalia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "short-stature",
        "description": "Short stature below the 5th percentile for age and sex",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "infertility",
        "description": "Primary infertility or azoospermia in postpubertal males",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of isochromosome Yp plus at least one major clinical feature such as gonadal dysgenesis or ambiguous genitalia",
    "notes": "Diagnosis relies heavily on cytogenetic analysis; clinical features may vary in severity."
  },
