        "Presence of dental abnormalities without hypophosphatemia"
      ]
    },
    {
      "diseaseId": "renal-tubular-acidosis",
      "distinguishingFeatures": [
        "Metabolic acidosis with normal anion gap",
        "No renal phosphate wasting"
      ]
    }
  ],
  "redFlags": [
