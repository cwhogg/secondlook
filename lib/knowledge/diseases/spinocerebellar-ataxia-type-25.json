  "diagnosticCriteria": {
    "formalCriteriaName": "Spinocerebellar Ataxia Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Presence of progressive cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in the FAT2 gene (SCA25 locus)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-ataxias",
        "description": "Exclusion of other common causes of ataxia by clinical and laboratory evaluation",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive cerebellar ataxia plus genetic confirmation of FAT2 mutation with exclusion of other causes",
    "notes": "Genetic testing is essential due to phenotypic overlap with other SCAs"
  },
