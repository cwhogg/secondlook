    "laboratory": [
      "Normal routine blood tests",
      "Possible mild hypothyroidism"
    ],
    "imaging": [
      "Brain MRI may show nonspecific findings or delayed myelination",
      "Skeletal X-rays may reveal joint contractures and scoliosis"
    ],
    "genetic": [
      "MAGEL2 (causative, loss-of-function)"
    ],
    "other": [
      "Electromyography may show myopathic features",
      "Polysomnography for sleep apnea evaluation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "prader-willi-syndrome",
      "distinguishingFeatures": [
        "Absence of MAGEL2 mutations",
        "More prominent hyperphagia and obesity",
        "Less frequent joint contractures"
      ]
    },
    {
      "diseaseId": "arthrogryposis-multiplex-congenita",
      "distinguishingFeatures": [
        "Joint contractures without MAGEL2 mutation",
        "Lack of neurodevelopmental delay typical of SYS"
      ]
    }
  ],
  "redFlags": [
