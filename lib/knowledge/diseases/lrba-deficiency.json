  ],
  "keyFindings": {
    "laboratory": [
      "Hypogammaglobulinemia (low IgG, IgA, sometimes IgM)",
      "Autoimmune cytopenias (positive Coombs test, thrombocytopenia)",
      "Elevated inflammatory markers during flares"
    ],
    "imaging": [
      "Chest CT showing bronchiectasis or interstitial lung disease",
      "Abdominal ultrasound showing splenomegaly and lymphadenopathy"
    ],
    "genetic": [
      "Biallelic pathogenic variants in LRBA gene confirmed by sequencing"
    ],
    "other": [
      "Reduced CTLA4 expression on regulatory T cells by flow cytometry",
      "Histopathology of gut biopsy showing autoimmune enteropathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ctla4-haploinsufficiency",
      "distinguishingFeatures": [
        "Heterozygous mutations in CTLA4 gene",
        "Variable hypogammaglobulinemia with predominant autoimmunity",
        "Later onset compared to LRBA deficiency"
      ]
    },
    {
      "diseaseId": "common-variable-immunodeficiency",
      "distinguishingFeatures": [
        "Polyclonal hypogammaglobulinemia without biallelic LRBA mutations",
        "Less frequent severe autoimmunity",
        "No characteristic CTLA4 expression defects"
      ]
    }
  ],
  "redFlags": [
    "Early onset hypogammaglobulinemia with severe autoimmunity",
    "Refractory autoimmune cytopenias",
    "Severe chronic diarrhea with autoimmune enteropathy"
  ],
  "specialistType": [
    "Immunologist",
    "Hematologist",
    "Gastroenterologist",
    "Geneticist"
  ],
  "lastUpdated": "2026-02-17",
  "references": [
    "Lo et al., 'LRBA Deficiency in Humans Causes Immune Dysregulation and Autoimmunity', Science, 2015",
