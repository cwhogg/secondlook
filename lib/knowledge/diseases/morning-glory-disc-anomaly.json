  "differentialDiagnoses": [
    {
      "diseaseId": "optic-nerve-coloboma",
      "distinguishingFeatures": [
        "Coloboma typically has a notch or gap in the optic disc rather than a funnel-shaped excavation",
        "Less prominent peripapillary pigment changes"
      ]
    },
    {
      "diseaseId": "peripapillary-pits",
      "distinguishingFeatures": [
        "Smaller, localized depressions near optic disc without central glial tuft",
        "Usually no abnormal retinal vessel pattern"
      ]
    },
    {
      "diseaseId": "optic-nerve-hypoplasia",
      "distinguishingFeatures": [
        "Small optic disc with reduced nerve fiber layer thickness",
        "Absence of excavated disc morphology"
      ]
    }
  ],
