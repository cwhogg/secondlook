        "requiredForDiagnosis": true
      },
      {
        "id": "hyperphosphatemia",
        "description": "Elevated serum phosphate levels consistent with hypoparathyroidism",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-primary-parathyroid-disease",
        "description": "Exclusion of primary parathyroid gland pathology or surgical removal",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of neuromuscular irritability symptoms such as tetany or carpopedal spasm",
