  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Monosomy 18q Syndrome",
    "criteria": [
      {
        "id": "chromosomal-deletion",
        "description": "Confirmed deletion of the distal long arm of chromosome 18 (18q) by cytogenetic or molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-hypotonia",
        "description": "Presence of congenital hypotonia with developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic craniofacial features including midface hypoplasia, prominent ears, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-impairment",
        "description": "Sensorineural or conductive hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation and short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed 18q deletion by genetic testing plus presence of at least two major clinical features including hypotonia and characteristic facial dysmorphism",
    "notes": "Diagnosis relies heavily on genetic confirmation; clinical features support diagnosis and guide management."
  },
