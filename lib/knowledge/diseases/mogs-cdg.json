  "diagnosticCriteria": {
    "formalCriteriaName": "No formal diagnostic criteria established",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of deficient mannosyl-oligosaccharide glucosidase enzyme activity in patient fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glycan-profile",
        "description": "Abnormal N-linked glycan profile with accumulation of glucosylated oligosaccharides on serum transferrin analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic biallelic variants in the MOGS gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of deficient MOGS enzyme activity or pathogenic MOGS gene variants combined with abnormal glycan profile",
    "notes": "Diagnosis relies on biochemical and molecular confirmation due to nonspecific clinical features"
  },
