  "keyFindings": {
    "laboratory": [
      "Normocytic normochromic anemia with low reticulocyte count",
      "Bone marrow hypocellularity without fibrosis",
      "Mild thrombocytopenia and leukopenia in some cases"
    ],
    "imaging": [
      "Diaphyseal sclerosis with endosteal and periosteal thickening on X-ray",
      "Delayed bone age on radiographs"
    ],
    "genetic": [
      "TBXAS1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Improvement of anemia with corticosteroid therapy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "camurati-engelmann-disease",
      "distinguishingFeatures": [
        "Camurati-Engelmann disease presents with hyperostosis of diaphyses but typically has elevated alkaline phosphatase and no anemia",
        "Autosomal dominant inheritance pattern"
      ]
    },
    {
      "diseaseId": "osteopetrosis",
      "distinguishingFeatures": [
        "Osteopetrosis shows generalized increased bone density with marrow space obliteration causing pancytopenia",
        "Radiological features differ with metaphyseal involvement"
      ]
    }
  ],
