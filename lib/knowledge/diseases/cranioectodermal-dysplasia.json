  "keyFindings": {
    "laboratory": [
      "Elevated serum creatinine and urea indicating renal impairment",
      "Liver function abnormalities consistent with hepatic fibrosis"
    ],
    "imaging": [
      "Radiographs showing short ribs and narrow thorax",
      "Renal ultrasound demonstrating corticomedullary cysts and increased echogenicity"
    ],
    "genetic": [
      "IFT122 (causative)",
      "WDR35 (causative)",
      "IFT43 (causative)",
      "WDR19 (causative)",
      "IFT52 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology of kidney biopsy showing tubulointerstitial fibrosis characteristic of nephronophthisis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "jeune-asphyxiating-thoracic-dystrophy",
      "distinguishingFeatures": [
        "More severe thoracic constriction causing respiratory failure",
        "Absence of ectodermal abnormalities",
        "Different genetic mutations (e.g. DYNC2H1)"
      ]
    },
    {
      "diseaseId": "short-rib-polydactyly-syndrome",
      "distinguishingFeatures": [
        "Presence of polydactyly more frequent and severe",
        "Lethal neonatal course common",
        "Distinct radiographic skeletal abnormalities"
      ]
    }
  ],
