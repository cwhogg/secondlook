  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Jansen Metaphyseal Chondrodysplasia",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Short-limbed dwarfism with disproportionate short stature and characteristic facial features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-findings",
        "description": "Metaphyseal irregularities with metaphyseal cupping and sclerosis on long bone X-rays",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of activating mutations in the PTH1R gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-abnormalities",
        "description": "Hypercalcemia and elevated serum alkaline phosphatase levels",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-course",
        "description": "Progressive skeletal deformities and short stature with normal intelligence",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features, radiological metaphyseal abnormalities, and confirmation of PTH1R gene mutation",
    "notes": "Genetic testing is essential for definitive diagnosis due to phenotypic overlap with other metaphyseal chondrodysplasias."
  },
