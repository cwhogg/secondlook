  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Exstrophy-Epispadias Complex",
    "criteria": [
      {
        "id": "bladder-exstrophy",
        "description": "Visible eversion of the bladder mucosa through the lower abdominal wall",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epispadias",
        "description": "Dorsal displacement of the urethral meatus with incomplete urethral closure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pubic-diastasis",
        "description": "Widening of the pubic symphysis detected clinically or radiologically",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genital-anomalies",
        "description": "Associated genital malformations such as bifid clitoris or penile abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bladder exstrophy with or without epispadias and supporting clinical or radiological findings",
    "notes": "Diagnosis is primarily clinical at birth; imaging supports extent and associated anomalies"
  },
