  "diagnosticCriteria": {
    "formalCriteriaName": "DK1-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "deficient-dolichol-kinase-activity",
        "description": "Demonstration of deficient dolichol kinase enzyme activity in fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypoglycosylation-of-serum-glycoproteins",
        "description": "Abnormal transferrin isoelectric focusing pattern indicating hypoglycosylation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biallelic-pathogenic-variants-in-dk1",
        "description": "Identification of biallelic pathogenic variants in the DK1 gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of multisystemic clinical features consistent with CDG Type I",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypoglycosylation on transferrin testing plus either deficient dolichol kinase activity or biallelic pathogenic variants in DK1 gene",
    "notes": "Molecular confirmation is essential for definitive diagnosis."
  },
