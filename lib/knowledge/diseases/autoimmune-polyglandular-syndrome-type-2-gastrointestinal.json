  "keyFindings": {
    "laboratory": [
      "Elevated ACTH with low cortisol (primary adrenal insufficiency)",
      "Positive 21-hydroxylase autoantibodies",
      "Positive thyroid peroxidase and thyroglobulin antibodies",
      "Macrocytic anemia with low vitamin B12",
      "Intrinsic factor antibodies",
      "Hypergastrinemia"
    ],
    "imaging": [
      "Adrenal gland atrophy on CT or MRI",
      "Thyroid ultrasound showing autoimmune thyroiditis features",
      "Endoscopy showing atrophic gastritis"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology of gastric mucosa showing lymphocytic infiltration and glandular atrophy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autoimmune-polyglandular-syndrome-type-1",
      "distinguishingFeatures": [
        "Earlier onset in childhood",
        "Presence of chronic mucocutaneous candidiasis",
        "Mutations in AIRE gene"
      ]
    },
    {
      "diseaseId": "isolated-primary-adrenal-insufficiency",
      "distinguishingFeatures": [
        "Lack of other autoimmune endocrinopathies",
        "Negative thyroid and pancreatic autoantibodies"
      ]
    },
    {
      "diseaseId": "celiac-disease",
      "distinguishingFeatures": [
        "Positive anti-tTG antibodies",
        "Villous atrophy on small bowel biopsy",
        "No adrenal or thyroid involvement"
      ]
    }
  ],
  "redFlags": [
    "Acute adrenal crisis (hypotension, shock, electrolyte imbalance)",
    "Severe malabsorption with weight loss and nutritional deficiencies",
    "Neurological deficits due to untreated pernicious anemia"
  ],
