  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria",
    "criteria": [
      {
        "id": "chronic-intractable-diarrhea",
        "description": "Presence of chronic, intractable diarrhea starting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hair-abnormalities",
        "description": "Characteristic brittle, woolly, or easily pluckable hair with trichorrhexis nodosa",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepatic-dysfunction",
        "description": "Evidence of liver involvement including hepatomegaly and abnormal liver function tests",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Severe growth retardation and failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "immunodeficiency",
        "description": "Variable immunodeficiency with hypogammaglobulinemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic intractable diarrhea, characteristic hair abnormalities, and hepatic dysfunction",
    "notes": "Genetic confirmation of mutations in TTC37 or SKIV2L genes supports diagnosis"
  },
