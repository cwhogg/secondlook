  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria established",
    "criteria": [
      {
        "id": "cutis-laxa",
        "description": "Generalized loose, inelastic, and wrinkled skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "marfanoid-habitus",
        "description": "Marfanoid body habitus including tall stature, arachnodactyly, and joint hypermobility",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiovascular-anomalies",
        "description": "Presence of cardiovascular abnormalities such as aortic root dilation or mitral valve prolapse",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing fragmented and decreased elastic fibers",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with elastic fiber formation (e.g., FBLN5, EFEMP2)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized cutis laxa with marfanoid habitus plus at least one major cardiovascular or histopathological criterion",
    "notes": "Diagnosis is clinical supported by histopathology and genetic testing; no standardized diagnostic criteria exist."
  },
