  "diagnosticCriteria": {
    "formalCriteriaName": "Choroidal Atrophy-Alopecia Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "choroidal-atrophy",
        "description": "Presence of bilateral choroidal atrophy confirmed by ophthalmological examination and imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alopecia",
        "description": "Congenital or early-onset alopecia affecting scalp and eyebrows",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "visual-impairment",
        "description": "Progressive visual impairment with reduced visual acuity and visual field defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroretinogram-abnormalities",
        "description": "Abnormal electroretinogram (ERG) findings indicating retinal dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (bilateral choroidal atrophy, alopecia, and progressive visual impairment) must be present for diagnosis.",
    "notes": "Genetic testing may support diagnosis but is not mandatory."
  },
