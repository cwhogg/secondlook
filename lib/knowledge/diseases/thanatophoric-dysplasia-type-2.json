  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Thanatophoric Dysplasia Type 2",
    "criteria": [
      {
        "id": "cloverleaf-skull",
        "description": "Presence of cloverleaf skull (Kleeblattschädel) deformity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-limbs",
        "description": "Severe micromelia with disproportionately short limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "narrow-thorax",
        "description": "Narrow thorax with short ribs causing respiratory insufficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "FGFR3-mutation",
        "description": "Detection of pathogenic FGFR3 gene mutation (usually p.Lys650Glu)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiological-features",
        "description": "Characteristic radiological findings including curved femora and flattened vertebral bodies",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of cloverleaf skull deformity, severe micromelia, and characteristic radiological features; genetic confirmation supports diagnosis",
    "notes": "Prenatal ultrasound and genetic testing are critical for early diagnosis."
  },
