    "formalCriteriaName": "Familial Non-Medullary Thyroid Carcinoma Diagnostic Criteria",
    "criteria": [
      {
        "id": "family-history",
        "description": "Presence of two or more first-degree relatives with papillary or follicular thyroid carcinoma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology-confirmation",
        "description": "Histopathological confirmation of papillary or follicular thyroid carcinoma in affected family members",
