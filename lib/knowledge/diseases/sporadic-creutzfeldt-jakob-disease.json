  "diagnosticCriteria": {
    "formalCriteriaName": "World Health Organization (WHO) Diagnostic Criteria for Sporadic CJD",
    "criteria": [
      {
        "id": "rapid-progressive-dementia",
        "description": "Rapidly progressive dementia with cognitive decline",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "myoclonus",
        "description": "Presence of myoclonus (involuntary muscle jerks)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "periodic-sharp-wave-complexes",
        "description": "Periodic sharp wave complexes on EEG",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "positive-14-3-3-protein",
        "description": "Detection of 14-3-3 protein in cerebrospinal fluid",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "high-signal-diffusion-mri",
        "description": "High signal abnormalities in caudate nucleus and putamen on diffusion-weighted MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Rapidly progressive dementia plus at least two supportive criteria (myoclonus, typical EEG, positive 14-3-3 CSF, or characteristic MRI findings)",
    "notes": "Definitive diagnosis requires neuropathological confirmation post-mortem."
  },
