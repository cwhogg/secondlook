        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial features including a pear-shaped nose, long philtrum, and thin upper lip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sparse-slow-growing-scalp-hair",
        "description": "Sparse, slow-growing scalp hair with fine texture",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Short stature relative to age and sex norms",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "brachydactyly",
        "description": "Shortening of the fingers and toes",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: cone-shaped epiphyses, distinctive facial features, and sparse scalp hair",
    "notes": "Genetic testing for mutations in the TRPS1 gene can confirm diagnosis"
  },
