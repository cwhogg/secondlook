  "diagnosticCriteria": {
    "formalCriteriaName": "Eurofever/PRINTO Classification Criteria (2019)",
    "criteria": [
      {
        "id": "caps-maj1",
        "description": "Recurrent episodes of systemic inflammation with urticarial-like rash",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "caps-maj2",
        "description": "Confirmed pathogenic NLRP3 (CIAS1) gene mutation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "caps-min1",
        "description": "Cold or environmental trigger (FCAS)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "caps-min2",
        "description": "Sensorineural hearing loss (MWS/NOMID)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "caps-min3",
        "description": "Chronic aseptic meningitis (NOMID/CINCA)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "caps-min4",
        "description": "Skeletal dysplasia/overgrowth of epiphyses (NOMID/CINCA)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "NLRP3 pathogenic mutation with compatible clinical features. Clinical diagnosis may be made with typical presentation including urticarial rash, fever, and musculoskeletal/neurologic involvement. Somatic mosaicism accounts for ~30% of NOMID cases without germline mutations.",
    "notes": "CAPS is a spectrum from mild (FCAS: cold-triggered) to moderate (MWS: hearing loss, amyloidosis risk) to severe (NOMID/CINCA: CNS inflammation, skeletal dysplasia). All result from NLRP3 gain-of-function."
  },
