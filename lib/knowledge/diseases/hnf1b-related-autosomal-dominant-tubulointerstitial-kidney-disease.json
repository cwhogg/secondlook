  "keyFindings": {
    "laboratory": [
      "Hypomagnesemia with renal magnesium wasting",
      "Hyperuricemia",
      "Elevated serum creatinine and reduced eGFR",
      "Mild elevation of liver enzymes"
    ],
    "imaging": [
      "Renal ultrasound showing multiple renal cysts and hypoplastic kidneys",
      "Pancreatic hypoplasia or atrophy on abdominal imaging",
      "Genital tract malformations on pelvic ultrasound or MRI"
    ],
    "genetic": [
      "HNF1B (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Family history consistent with autosomal dominant inheritance",
      "Histopathology showing tubulointerstitial fibrosis in kidney biopsy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autosomal-dominant-tubulointerstitial-kidney-disease-adtkd-muc1",
      "distinguishingFeatures": [
        "MUC1 mutations rather than HNF1B",
        "Absence of extrarenal features such as diabetes or pancreatic hypoplasia",
        "Later onset of kidney disease"
      ]
    },
    {
      "diseaseId": "polycystic-kidney-disease-autosomal-dominant-pkd1-pkd2",
      "distinguishingFeatures": [
        "Multiple large renal cysts with preserved renal parenchyma early",
        "No associated diabetes or pancreatic abnormalities",
        "Different genetic mutations (PKD1 or PKD2)"
      ]
    }
  ],
