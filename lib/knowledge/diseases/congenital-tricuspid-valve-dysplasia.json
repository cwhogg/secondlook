      ]
    },
    {
      "diseaseId": "tricuspid-atresia",
      "distinguishingFeatures": [
        "Complete absence of tricuspid valve",
        "Hypoplastic right ventricle",
        "Obligate right-to-left shunting"
      ]
    }
