  "keyFindings": {
    "laboratory": [
      "Elevated serum aminotransferases (AST, ALT)",
      "Prolonged prothrombin time (INR ≥ 1.5)",
      "Elevated serum bilirubin",
      "Hypoglycemia",
      "Elevated serum ammonia"
    ],
    "imaging": [
      "Ultrasound showing hepatomegaly or normal liver size",
      "CT/MRI to exclude cerebral edema in encephalopathy"
    ],
    "genetic": [
      "No specific genetic markers; genetic testing may be relevant in metabolic causes"
    ],
    "other": [
      "Liver biopsy may show massive hepatic necrosis",
      "Exclusion of chronic liver disease by clinical and imaging criteria"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "chronic-liver-failure",
      "distinguishingFeatures": [
        "History of chronic liver disease",
        "Slower onset of symptoms",
        "Presence of cirrhosis on imaging or biopsy"
      ]
    },
    {
      "diseaseId": "acute-on-chronic-liver-failure",
      "distinguishingFeatures": [
        "Underlying chronic liver disease with acute decompensation",
        "Presence of portal hypertension",
        "Different management approach"
      ]
    },
    {
      "diseaseId": "viral-hepatitis",
      "distinguishingFeatures": [
        "Positive viral serologies",
        "May present with acute hepatitis but without encephalopathy initially"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression to hepatic encephalopathy",
    "Coagulopathy unresponsive to vitamin K",
    "Development of cerebral edema or increased intracranial pressure"
  ],
