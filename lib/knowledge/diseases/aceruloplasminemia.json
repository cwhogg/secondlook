  "diagnosticCriteria": {
    "formalCriteriaName": "Aceruloplasminemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "low-ceruloplasmin",
        "description": "Markedly decreased or absent serum ceruloplasmin levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-iron-accumulation",
        "description": "MRI evidence of iron accumulation in basal ganglia and other brain regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of neurological symptoms such as movement disorders and cognitive decline",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "diabetes-mellitus",
        "description": "Coexisting diabetes mellitus due to pancreatic iron deposition",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "retinal-degeneration",
        "description": "Retinal degeneration or visual impairment",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the CP gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of low serum ceruloplasmin, MRI evidence of brain iron accumulation, neurological symptoms, and pathogenic CP gene mutation",
    "notes": "Diagnosis may be supported by diabetes mellitus and retinal degeneration but these are not mandatory."
  },
