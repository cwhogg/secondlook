  "diagnosticCriteria": {
    "formalCriteriaName": "3C Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cataracts",
        "description": "Presence of bilateral congenital or early-onset cataracts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiomyopathy",
        "description": "Evidence of dilated or hypertrophic cardiomyopathy confirmed by echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "celiac-disease",
        "description": "Serological and histological confirmation of celiac disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Failure to thrive or growth retardation in infancy or early childhood",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-weakness",
        "description": "Proximal muscle weakness and hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (cataracts, cardiomyopathy, and celiac disease) must be present for diagnosis",
    "notes": "Diagnosis is supported by genetic testing identifying mutations in the SLC33A1 gene."
  },
