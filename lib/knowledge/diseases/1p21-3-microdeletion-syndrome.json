  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of a heterozygous microdeletion at chromosome 1p21.3 by chromosomal microarray or other molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability documented by standardized testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-features",
        "description": "Presence of autism spectrum disorder or significant behavioral abnormalities including stereotypies and social communication deficits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Mild craniofacial dysmorphisms such as micrognathia, broad nasal bridge, or epicanthal folds",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of 1p21.3 microdeletion plus presence of developmental delay or intellectual disability and behavioral abnormalities",
    "notes": "Diagnosis relies primarily on genetic testing combined with clinical features; no formal consensus criteria exist."
  },
