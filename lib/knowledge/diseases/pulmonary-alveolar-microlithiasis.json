  "diagnosticCriteria": {
    "formalCriteriaName": "Pulmonary Alveolar Microlithiasis Diagnostic Criteria",
    "criteria": [
      {
        "id": "radiographic-pattern",
        "description": "Diffuse, sand-like micronodular calcifications visible on chest radiograph or CT scan",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the SLC34A2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bronchoalveolar-lavage",
        "description": "Presence of microliths in bronchoalveolar lavage fluid",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Progressive dyspnea and dry cough in absence of other causes",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic radiographic findings plus genetic confirmation or histopathological evidence of microliths",
    "notes": "Lung biopsy is rarely required if genetic testing and imaging are conclusive."
  },
