  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible hypothyroidism on thyroid function tests",
      "Metabolic screening usually unremarkable"
    ],
    "imaging": [
      "Skeletal X-rays showing broad thumbs and halluces",
      "Echocardiography revealing congenital heart defects",
      "Brain MRI may show nonspecific findings or normal"
    ],
    "genetic": [
      "CREBBP (phenotype modifier)"
    ],
    "other": [
      "Developmental assessment confirming intellectual disability",
      "Audiological evaluation for hearing impairment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "rubinstein-taybi-syndrome-classic",
      "distinguishingFeatures": [
        "CREBBP point mutations rather than microdeletion",
        "Similar phenotype but may have milder or variable features",
        "No large chromosomal deletion on microarray"
      ]
    },
    {
      "diseaseId": "cornelia-de-lange-syndrome",
      "distinguishingFeatures": [
        "Distinctive synophrys and limb abnormalities",
        "Different genetic etiology (NIPBL, SMC1A mutations)",
        "More severe growth retardation and cognitive impairment"
      ]
    },
    {
      "diseaseId": "floating-harbor-syndrome",
      "distinguishingFeatures": [
        "Triangular face with deep-set eyes",
        "Short stature with delayed bone age",
        "SRCAP gene mutations instead of CREBBP"
      ]
    }
  ],
  "redFlags": [
    "Severe congenital heart defects requiring early intervention",
    "Progressive respiratory infections with failure to thrive",
    "Significant developmental delay or regression"
  ],
