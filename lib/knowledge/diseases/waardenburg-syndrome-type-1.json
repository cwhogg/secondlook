      },
      {
        "symptomName": "Skin hypopigmented patches (leukoderma)",
        "frequency": 0.6,
        "bodySystem": "dermatological",
        "notes": "Areas of reduced pigmentation on the skin"
      },
      {
        "symptomName": "Broad nasal root",
        "frequency": 0.55,
        "bodySystem": "constitutional",
        "notes": "Characteristic facial morphology"
      },
      {
        "symptomName": "Synophrys (confluent eyebrows)",
