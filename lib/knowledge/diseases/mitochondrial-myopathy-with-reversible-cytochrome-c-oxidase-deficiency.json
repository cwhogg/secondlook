  "diagnosticCriteria": {
    "formalCriteriaName": "Reversible Cytochrome C Oxidase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early-onset muscle weakness with hypotonia and delayed motor milestones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy-cox-deficiency",
        "description": "Muscle biopsy showing reversible cytochrome c oxidase (COX) deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normalization-follow-up",
        "description": "Improvement or normalization of COX activity on follow-up biopsy or biochemical testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mitochondrial DNA or nuclear gene mutations associated with reversible COX deficiency (if available)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-mitochondrial-myopathies",
        "description": "Exclusion of other mitochondrial myopathies with permanent COX deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset muscle weakness with hypotonia plus muscle biopsy demonstrating reversible cytochrome c oxidase deficiency",
    "notes": "Diagnosis requires demonstration of reversibility of COX deficiency, typically by follow-up biopsy or biochemical testing."
  },
