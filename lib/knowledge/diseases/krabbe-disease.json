  "keyFindings": {
    "laboratory": [
      "Low galactocerebrosidase enzyme activity in leukocytes or fibroblasts",
      "Elevated psychosine levels in blood or dried blood spots"
    ],
    "imaging": [
      "MRI showing diffuse cerebral white matter demyelination",
      "Thickening of the optic nerve and corticospinal tract involvement"
    ],
    "genetic": [
      "Pathogenic variants in the GALC gene confirmed by molecular genetic testing"
    ],
    "other": [
      "Presence of globoid cells on nerve biopsy (rarely performed)"
    ]
