  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Fundus autofluorescence showing subretinal deposits and geographic atrophy",
      "Optical coherence tomography (OCT) revealing retinal pigment epithelium disruption and subretinal deposits",
      "Fluorescein angiography demonstrating window defects and choroidal neovascularization in advanced cases"
    ],
    "genetic": [
      "C1QTNF5 (causative)",
      "Autosomal dominant inheritance"
    ],
