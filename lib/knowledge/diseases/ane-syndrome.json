  "keyFindings": {
    "laboratory": [
      "Elevated serum aminotransferases",
      "Elevated cerebrospinal fluid (CSF) protein without pleocytosis",
      "Normal or mildly elevated inflammatory markers"
    ],
    "imaging": [
      "MRI showing bilateral symmetric lesions in thalami, brainstem, cerebellum, and white matter",
      "Absence of diffusion restriction in acute phase differentiates from infarction"
    ],
    "genetic": [
      "RBM28 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "History of recent viral febrile illness (commonly influenza or parainfluenza)",
      "Rapid clinical deterioration within days"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "infectious-encephalitis",
      "distinguishingFeatures": [
        "Presence of CSF pleocytosis",
        "Positive microbiological cultures or PCR",
        "Asymmetric brain lesions on imaging"
      ]
    },
    {
      "diseaseId": "acute-disseminated-encephalomyelitis",
      "distinguishingFeatures": [
        "Presence of multifocal demyelinating lesions",
        "Usually monophasic with slower progression",
        "CSF pleocytosis and oligoclonal bands"
      ]
    },
    {
      "diseaseId": "mitochondrial-encephalopathy",
      "distinguishingFeatures": [
        "Lactic acidosis",
        "Stroke-like episodes",
        "Genetic testing positive for mitochondrial DNA mutations"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression to coma within 24-48 hours",
    "Bilateral thalamic necrosis on MRI",
    "Lack of response to standard antiviral or antibiotic therapy"
  ],
