  "diagnosticCriteria": {
    "formalCriteriaName": "Radiographic and Clinical Criteria",
    "criteria": [
      {
        "id": "cm-1",
        "description": "Cerebellar tonsillar herniation >5mm below the foramen magnum on sagittal MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cm-2",
        "description": "Compatible clinical symptoms (occipital headache, neurological deficits)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cm-3",
        "description": "Tonsillar herniation 3-5mm with associated syringomyelia or CSF flow obstruction",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cm-4",
        "description": "Abnormal CSF flow dynamics on cine MRI at craniovertebral junction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Tonsillar herniation >5mm on MRI. 3-5mm herniation may be significant if symptomatic with supportive findings. Clinical correlation essential as many cases are asymptomatic.",
    "notes": "Chiari type II involves myelomeningocele and is typically diagnosed in infancy. Chiari 0.5 or Chiari 0 may have symptoms without meeting 5mm threshold."
  },
