  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Osteochondrosis of the Tarsal Bone",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Localized pain and tenderness over the affected tarsal bone exacerbated by weight-bearing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-findings",
        "description": "Radiographic evidence of sclerosis, fragmentation, and flattening of the affected tarsal bone",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-of-onset",
        "description": "Typical onset in childhood or early adolescence (5-15 years)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-infection",
        "description": "No signs of infection or systemic inflammatory disease",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of localized clinical symptoms plus confirmatory radiographic findings",
    "notes": "Diagnosis is primarily clinical supported by imaging; biopsy rarely needed."
  },
