  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Hidrotic Ectodermal Dysplasia",
    "criteria": [
      {
        "id": "nail-dystrophy",
        "description": "Presence of nail dystrophy including thickened, brittle, or dysplastic nails",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "palmoplantar-keratoderma",
        "description": "Palmoplantar hyperkeratosis with variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alopecia",
        "description": "Partial to total alopecia involving scalp, eyebrows, and eyelashes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-sweat-gland-function",
        "description": "Normal sweating function distinguishing from hypohidrotic ectodermal dysplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern or positive family history",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: nail dystrophy, palmoplantar keratoderma, and alopecia",
    "notes": "Genetic testing for GJB6 mutations can confirm diagnosis"
  },
