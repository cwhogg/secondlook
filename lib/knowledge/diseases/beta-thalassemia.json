  "keyFindings": {
    "laboratory": [
      "Microcytic hypochromic anemia with low MCV and MCH",
      "Elevated serum ferritin and transferrin saturation in transfused patients",
      "Elevated indirect bilirubin due to hemolysis",
      "Elevated HbA2 and HbF on hemoglobin electrophoresis"
    ],
    "imaging": [
      "Skull X-ray showing 'hair-on-end' appearance due to marrow expansion",
      "MRI for iron overload quantification in liver and heart",
      "Ultrasound showing hepatosplenomegaly and gallstones"
    ],
    "genetic": [
      "Mutations in the HBB gene on chromosome 11",
      "Common mutations include frameshift, nonsense, and splice site variants",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Bone marrow hyperplasia",
      "Extramedullary hematopoiesis with paraspinal masses"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "alpha-thalassemia",
      "distinguishingFeatures": [
        "Alpha-thalassemia involves mutations in HBA1 and HBA2 genes",
        "Hemoglobin electrophoresis shows different patterns with HbH or Hb Bart's",
        "Usually less severe anemia in carriers"
      ]
    },
    {
      "diseaseId": "iron-deficiency-anemia",
      "distinguishingFeatures": [
        "Iron deficiency anemia shows low serum ferritin and iron",
        "No elevation of HbA2 or HbF on electrophoresis",
        "Responds to iron supplementation"
      ]
    }
  ],
  "redFlags": [
    "Severe anemia unresponsive to iron therapy",
