  "diagnosticCriteria": {
    "formalCriteriaName": "Nodular Non-Suppurative Panniculitis Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of tender, erythematous subcutaneous nodules without signs of suppuration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Biopsy showing lobular panniculitis with absence of neutrophilic abscesses or suppuration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-infectious",
        "description": "Exclusion of infectious causes by negative microbiological cultures and stains",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-support",
        "description": "Imaging (ultrasound or MRI) demonstrating subcutaneous nodules without fluid collections",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "systemic-symptoms",
        "description": "Presence of low-grade fever or malaise",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical presentation, histopathology, and exclusion of infection) must be met for diagnosis.",
    "notes": "Diagnosis requires histopathological confirmation and exclusion of infectious panniculitis."
  },
