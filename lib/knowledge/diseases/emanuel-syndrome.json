  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and cytogenetic diagnosis of Emanuel Syndrome",
    "criteria": [
      {
        "id": "chromosomal-abnormality",
        "description": "Presence of supernumerary derivative chromosome 22 resulting from a 3:1 meiotic segregation of a parental balanced translocation t(11;22)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including micrognathia, prominent forehead, and ear anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-malformations",
        "description": "Presence of congenital heart defects and/or renal anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay and intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Identification of the supernumerary derivative chromosome 22 by cytogenetic analysis plus presence of characteristic facial dysmorphism and at least one congenital malformation",
    "notes": "Molecular cytogenetic confirmation is essential for definitive diagnosis."
  },
