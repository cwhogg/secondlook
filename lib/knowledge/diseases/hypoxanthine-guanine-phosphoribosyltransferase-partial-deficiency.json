  "diagnosticCriteria": {
    "formalCriteriaName": "Kelley-Seegmiller Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced but not absent hypoxanthine-guanine phosphoribosyltransferase enzyme activity in erythrocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "uric-acid-elevation",
        "description": "Elevated serum and urinary uric acid levels indicating hyperuricemia and hyperuricosuria",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of gouty arthritis, nephrolithiasis, or mild neurological symptoms without severe dystonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the HPRT1 gene consistent with partial deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Reduced HPRT enzyme activity plus hyperuricemia with clinical features of gout or nephrolithiasis",
    "notes": "Genetic testing supports diagnosis but is not mandatory if biochemical and clinical criteria are met."
  },
