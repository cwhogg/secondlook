    "criteria": [
      {
        "id": "eva-diameter",
        "description": "Vestibular aqueduct diameter greater than 1.5 mm at the midpoint on CT or MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Progressive or fluctuating sensorineural hearing loss documented by audiometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-other-inner-ear-malformations",
        "description": "No other major inner ear malformations present on imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of enlarged vestibular aqueduct on imaging plus documented sensorineural hearing loss",
    "notes": "Genetic testing for SLC26A4 mutations may support diagnosis but is not mandatory"
