        "requiredForDiagnosis": true
      },
      {
        "id": "romk-gene-mutation",
        "description": "Identification of biallelic pathogenic mutations in the KCNJ1 (ROMK) gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-alkalosis",
        "description": "Metabolic alkalosis with elevated renin and aldosterone levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-blood-pressure",
        "description": "Normotension despite elevated renin and aldosterone",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypokalemia with renal potassium wasting, hypercalciuria, and confirmed biallelic ROMK gene mutations",
    "notes": "Genetic testing is essential for definitive diagnosis; biochemical abnormalities support clinical suspicion."
