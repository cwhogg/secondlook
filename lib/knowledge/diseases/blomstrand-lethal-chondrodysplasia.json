  "diagnosticCriteria": {
    "formalCriteriaName": "Blomstrand Lethal Chondrodysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "advanced-endochondral-ossification",
        "description": "Markedly advanced endochondral ossification evident on prenatal or perinatal radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-chondrodysplasia",
        "description": "Severe generalized chondrodysplasia with short limbs and abnormal metaphyseal morphology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lethal-perinatal-course",
        "description": "Perinatal lethality typically occurring in utero or shortly after birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mutations-in-parathyroid-hormone-related-peptide-receptor",
        "description": "Identification of biallelic pathogenic variants in the PTHR1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-skeletal-dysplasia-features",
        "description": "Lack of features typical of other skeletal dysplasias such as achondroplasia or thanatophoric dysplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of advanced endochondral ossification and severe chondrodysplasia with lethal perinatal course; genetic confirmation supports diagnosis",
    "notes": "Diagnosis is primarily based on radiological and clinical findings; genetic testing for PTHR1 mutations confirms diagnosis."
  },
