  "diagnosticCriteria": {
    "formalCriteriaName": "Transient Hypogammaglobulinemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "low-serum-igG",
        "description": "Serum IgG levels below age-matched normal reference values",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-or-mildly-reduced-igA-igM",
        "description": "Normal or mildly reduced serum IgA and IgM levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-infections",
        "description": "History of recurrent bacterial infections, especially respiratory tract infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-t-cell-function",
        "description": "Normal T-cell numbers and function",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "resolution-after-24-months",
        "description": "Improvement or normalization of immunoglobulin levels after 24 to 36 months of age",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of low serum IgG below age norms with normal or mildly reduced IgA and IgM, recurrent infections, and exclusion of other immunodeficiencies",
    "notes": "Diagnosis is clinical and laboratory-based; exclusion of other primary immunodeficiencies is essential."
  },
