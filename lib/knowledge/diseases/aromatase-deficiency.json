  "keyFindings": {
    "laboratory": [
      "Elevated serum testosterone",
      "Low or undetectable serum estradiol",
      "Elevated luteinizing hormone (LH) and follicle-stimulating hormone (FSH) in females"
    ],
    "imaging": [
      "Delayed bone age on radiographs",
      "Osteopenia or osteoporosis on bone densitometry",
      "Ovarian cysts on pelvic ultrasound"
    ],
    "genetic": [
      "CYP19A1 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
