  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnostic criteria for CMTX3",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of progressive distal muscle weakness and atrophy predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies showing intermediate to demyelinating sensorimotor peripheral neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in the CMTX3 locus on the X chromosome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "X-linked inheritance pattern with affected male relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-causes",
        "description": "Exclusion of other acquired or hereditary neuropathies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical neuropathy, supportive electrophysiological findings, and pathogenic mutation in CMTX3 locus",
    "notes": "Genetic confirmation is essential due to phenotypic overlap with other CMT subtypes"
  },
