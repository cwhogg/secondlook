  "diagnosticCriteria": {
    "formalCriteriaName": "Haberland Diagnostic Criteria",
    "criteria": [
      {
        "id": "nevus-lipomatosus",
        "description": "Presence of nevus psiloliparus (hairless fatty nevus of the scalp)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "Unilateral ocular anomalies including epibulbar choristomas or dermoids",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "central-nervous-system-lesions",
        "description": "Ipsilateral cerebral malformations such as porencephalic cysts, cortical dysplasia, or arachnoid cysts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-lipomas",
        "description": "Subcutaneous lipomas or fatty masses in craniofacial regions",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-deficits",
        "description": "Neurological symptoms such as seizures or developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of nevus psiloliparus plus at least one major criterion involving ocular or CNS anomalies",
    "notes": "Diagnosis is clinical and supported by imaging and histopathology; genetic testing is not definitive."
  },
