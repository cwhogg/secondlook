  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Larsen Syndrome",
    "criteria": [
      {
        "id": "multiple-joint-dislocations",
        "description": "Presence of multiple congenital joint dislocations including knees, elbows, and hips",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic facial features including hypertelorism, depressed nasal bridge, and prominent forehead",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "spinal-abnormalities",
        "description": "Cervical spine anomalies such as cervical kyphosis or vertebral segmentation defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clubfoot",
        "description": "Congenital talipes equinovarus (clubfoot)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "short-stature",
        "description": "Mild to moderate short stature",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: multiple congenital joint dislocations, characteristic craniofacial dysmorphism, and cervical spine abnormalities",
    "notes": "Genetic testing for FLNB mutations can support diagnosis but is not mandatory."
  },
