  "keyFindings": {
    "laboratory": [
      "Flow cytometry: GPI-anchor-deficient populations (FLAER, CD55, CD59) on granulocytes, monocytes, and red cells",
      "Elevated LDH (often markedly elevated, 1.5-10x normal)",
      "Low or absent haptoglobin",
      "Elevated indirect bilirubin",
      "Elevated reticulocyte count",
      "Hemoglobinuria and hemosiderinuria",
      "May have concurrent pancytopenia (PNH/aplastic anemia overlap)"
    ],
    "imaging": [
      "Doppler ultrasound or CT venography for thrombosis evaluation",
      "MRI showing hepatic or renal hemosiderin deposition",
      "CT or MRI for Budd-Chiari syndrome if suspected"
    ],
    "genetic": [
      "PIGA (somatic)",
      "PIGA gene somatic mutation (X-linked; acquired, not inherited)"
    ],
    "other": [
      "Ham test (acidified serum lysis test) - historical, replaced by flow cytometry",
      "Sucrose lysis test - historical",
      "Bone marrow biopsy may show hypoplasia in PNH/aplastic anemia overlap"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "aplastic-anemia",
      "distinguishingFeatures": [
        "Aplastic anemia has pancytopenia with hypocellular marrow",
        "Small PNH clones may coexist in aplastic anemia",
        "No significant hemolysis in pure aplastic anemia"
      ]
    },
    {
      "diseaseId": "autoimmune-hemolytic-anemia",
      "distinguishingFeatures": [
        "Positive direct antiglobulin test",
        "No GPI-anchor-deficient population on flow cytometry",
        "Primarily extravascular hemolysis"
      ]
    },
    {
      "diseaseId": "thrombotic-thrombocytopenic-purpura",
      "distinguishingFeatures": [
        "Microangiopathic hemolytic anemia with schistocytes",
        "Severe thrombocytopenia",
        "ADAMTS13 deficiency",
        "No GPI-anchor deficiency"
      ]
    }
  ],
  "redFlags": [
    "Thrombosis at unusual sites (hepatic, cerebral, mesenteric veins)",
    "Budd-Chiari syndrome in young patients",
    "Severe hemolytic crises with renal impairment",
    "Development of severe bone marrow failure",
    "Transformation to myelodysplastic syndrome or acute leukemia"
  ],
