  "differentialDiagnoses": [
    {
      "diseaseId": "retinitis-pigmentosa",
      "distinguishingFeatures": [
        "Primary rod photoreceptor degeneration with secondary cone loss",
        "Night blindness as initial symptom",
        "Characteristic bone-spicule pigmentation in mid-peripheral retina"
      ]
    },
    {
      "diseaseId": "achromatopsia",
      "distinguishingFeatures": [
        "Congenital absence of cone function without rod degeneration",
        "Severe color vision loss from birth",
        "Nystagmus and photophobia present early"
      ]
    },
    {
      "diseaseId": "stargardt-disease",
      "distinguishingFeatures": [
        "Macular dystrophy with central vision loss",
        "Lipofuscin accumulation in retinal pigment epithelium",
        "Typically no early rod dysfunction"
      ]
    }
  ],
