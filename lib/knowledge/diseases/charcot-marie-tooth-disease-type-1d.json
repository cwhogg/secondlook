  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnostic criteria for CMT1D",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of a chronic, progressive distal sensorimotor neuropathy with distal muscle weakness and atrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-conduction-velocity",
        "description": "Nerve conduction studies showing uniformly slowed motor nerve conduction velocities consistent with demyelinating neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the LITAF gene (also known as SIMPLE gene)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Nerve biopsy showing demyelination and onion bulb formations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical neuropathy, supportive nerve conduction studies consistent with demyelinating neuropathy, and identification of pathogenic LITAF gene mutation",
    "notes": "Genetic confirmation is essential for definitive diagnosis; nerve biopsy is rarely required."
  },
