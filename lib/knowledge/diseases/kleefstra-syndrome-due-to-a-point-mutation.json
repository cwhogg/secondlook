  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific biochemical markers"
    ],
    "imaging": [
      "Brain MRI may show nonspecific findings such as delayed myelination or mild cerebral atrophy",
      "Echocardiogram may reveal congenital heart defects"
    ],
    "genetic": [
      "KMT2C (causative, loss-of-function)",
      "EHMT1 (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electroencephalogram (EEG) abnormalities consistent with epilepsy"
    ]
  },
