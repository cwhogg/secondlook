  "diagnosticCriteria": {
    "formalCriteriaName": "European Society for Immunodeficiencies (ESID) Diagnostic Criteria for XLA",
    "criteria": [
      {
        "id": "absent-b-cells",
        "description": "Markedly reduced or absent peripheral B cells (CD19+ cells <2%)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-immunoglobulins",
        "description": "Severely decreased serum immunoglobulin levels (IgG, IgA, and IgM)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "btk-mutation",
        "description": "Identification of pathogenic mutation in the BTK gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-infections",
        "description": "History of recurrent bacterial infections, especially of the respiratory tract",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of absent peripheral B cells, low serum immunoglobulins, and a pathogenic BTK gene mutation",
    "notes": "Diagnosis can be supported by clinical history and family history; genetic testing is confirmatory."
  },
