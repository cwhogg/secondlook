  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Reduced glycosaminoglycan synthesis in fibroblast cultures"
    ],
    "imaging": [
      "Radiographs showing platyspondyly and metaphyseal irregularities",
      "Bone age delay on hand/wrist X-rays"
    ],
    "genetic": [
      "B3GALT6 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy showing abnormalities in dermal collagen fibrils"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "b4galt7-related-spondylodysplastic-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Pathogenic variants in B4GALT7 gene",
        "More prominent radioulnar synostosis",
        "Different pattern of skeletal dysplasia"
      ]
    },
    {
      "diseaseId": "classical-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Pathogenic variants in COL5A1 or COL5A2",
        "More prominent skin fragility and atrophic scarring",
        "Absence of skeletal dysplasia"
      ]
    }
  ],
  "redFlags": [
    "Severe skeletal dysplasia with platyspondyly in infancy",
