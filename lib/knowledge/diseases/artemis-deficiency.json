  "diagnosticCriteria": {
    "formalCriteriaName": "Radiosensitive SCID Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the DCLRE1C gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotyping",
        "description": "Severe T-cell lymphopenia with absent or markedly reduced T-cell receptor excision circles (TRECs)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiosensitivity-assay",
        "description": "Increased cellular radiosensitivity demonstrated by fibroblast or lymphocyte assays",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-presentation",
        "description": "Early onset of recurrent severe infections, failure to thrive, and chronic diarrhea",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic DCLRE1C variants plus severe T-cell lymphopenia",
    "notes": "Radiosensitivity testing supports diagnosis but is not mandatory."
  },
