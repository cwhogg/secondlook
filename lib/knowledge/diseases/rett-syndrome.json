        "symptomName": "Loss of purposeful hand skills",
        "frequency": 0.95,
        "bodySystem": "neurological",
        "notes": "Typically occurs between 6-18 months of age",
        "searchTerms": [
          "loss of purposeful hand use",
          "unable to use hands intentionally",
          "loss of fine motor skills"
        ]
      },
      {
        "symptomName": "Stereotypic hand movements",
        "frequency": 0.9,
        "bodySystem": "neurological",
        "notes": "Includes hand wringing, clapping, mouthing",
        "searchTerms": [
          "repetitive hand movements",
          "stereotyped hand motions",
          "repeated hand gestures"
        ]
      },
      {
        "symptomName": "Loss of spoken language",
        "frequency": 0.85,
        "bodySystem": "neurological",
        "notes": "Progressive regression after initial normal development",
        "searchTerms": [
          "loss of speech",
          "unable to speak",
          "speech loss"
        ]
      }
    ],
    "common": [
