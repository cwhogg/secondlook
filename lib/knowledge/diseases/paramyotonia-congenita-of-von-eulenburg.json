  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electromyographic Diagnostic Criteria for Paramyotonia Congenita",
    "criteria": [
      {
        "id": "clinical-myotonia",
        "description": "Presence of cold- and exercise-induced muscle stiffness (myotonia) predominantly affecting the face, hands, and upper limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography-myotonic-discharges",
        "description": "Electromyographic evidence of myotonic discharges exacerbated by cold exposure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the SCN4A gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-muscle-wasting",
        "description": "Lack of progressive muscle weakness or atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "triggered-paralysis",
        "description": "Episodes of transient muscle weakness or paralysis triggered by cold or exercise",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical myotonia with cold/exercise triggers plus either EMG myotonic discharges or pathogenic SCN4A mutation",
    "notes": "Diagnosis is supported by family history and exclusion of other myotonic disorders."
  },
