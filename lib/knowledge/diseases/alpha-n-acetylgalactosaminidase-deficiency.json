  "diagnosticCriteria": {
    "formalCriteriaName": "Schindler Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity-deficiency",
        "description": "Demonstration of deficient alpha-N-acetylgalactosaminidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of neurodegeneration with developmental delay and regression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the NAGA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-markers",
        "description": "Elevated urinary excretion of glycopeptides and oligosaccharides",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient enzyme activity plus either compatible clinical features or pathogenic NAGA gene variants",
    "notes": "Genetic testing is confirmatory; enzyme assay is diagnostic cornerstone."
  },
