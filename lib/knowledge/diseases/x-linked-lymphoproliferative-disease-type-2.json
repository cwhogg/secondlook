  "keyFindings": {
    "laboratory": [
      "Cytopenias (anemia, thrombocytopenia, neutropenia)",
      "Elevated ferritin and triglycerides consistent with HLH",
      "Hypogammaglobulinemia",
      "Elevated soluble IL-2 receptor (sCD25)"
    ],
    "imaging": [
      "Splenomegaly and hepatomegaly on abdominal ultrasound or CT",
      "Lymphadenopathy on imaging studies",
      "Possible pulmonary infiltrates on chest X-ray or CT"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Defective apoptosis assays in lymphocytes",
      "Abnormal NK cell and cytotoxic T cell function tests"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "x-linked-lymphoproliferative-disease-type-1",
      "distinguishingFeatures": [
        "Mutation in SH2D1A gene instead of XIAP",
        "More frequent severe EBV-associated lymphoma",
        "Different immunophenotypic profile"
      ]
    },
    {
      "diseaseId": "familial-hemophagocytic-lymphohistiocytosis",
      "distinguishingFeatures": [
        "Mutations in PRF1, UNC13D, STX11, or STXBP2 genes",
        "Earlier onset in infancy",
        "Absence of XIAP mutations"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset of fever with cytopenias and organomegaly",
    "Severe or recurrent EBV infections",
    "Signs of HLH including hyperferritinemia and coagulopathy"
  ],
