  "diagnosticCriteria": {
    "formalCriteriaName": "Lymphoid Interstitial Pneumonia Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Diffuse infiltration of pulmonary interstitium by polyclonal lymphocytes and plasma cells on lung biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "High-resolution CT showing diffuse ground-glass opacities, centrilobular nodules, and cystic changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Subacute onset of respiratory symptoms including cough and dyspnea",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other lymphoproliferative disorders and infections",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation plus compatible imaging findings and exclusion of other causes",
    "notes": "Diagnosis often requires multidisciplinary evaluation including pulmonology, radiology, and pathology"
  },
