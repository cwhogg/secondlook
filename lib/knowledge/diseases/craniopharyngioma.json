  "keyFindings": {
    "laboratory": [
      "Hormonal assays showing pituitary hormone deficiencies (e.g., low GH, ACTH, TSH)",
      "Electrolyte abnormalities in diabetes insipidus (hypernatremia)"
    ],
    "imaging": [
      "MRI showing cystic and solid suprasellar mass with calcifications",
      "CT scan demonstrating calcifications within the lesion"
    ],
    "genetic": [
      "BRAF (somatic)",
      "CTNNB1 (somatic)"
    ],
    "other": [
      "Histopathology confirming adamantinomatous or papillary craniopharyngioma"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pituitary-adenoma",
      "distinguishingFeatures": [
        "Typically solid mass without calcifications",
        "Less frequent cystic components",
        "Different hormonal secretion patterns"
      ]
    },
    {
      "diseaseId": "rachnoid-cyst",
      "distinguishingFeatures": [
        "Lack of solid components and calcifications",
        "No endocrine dysfunction",
        "Different imaging characteristics"
      ]
    },
    {
      "diseaseId": "hypothalamic-glioma",
      "distinguishingFeatures": [
        "Usually infiltrative lesion without calcifications",
        "Different histopathology",
        "More common in younger children"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive visual loss",
    "Signs of increased intracranial pressure (severe headache, vomiting)",
    "Acute endocrine crisis (adrenal insufficiency)"
  ],
