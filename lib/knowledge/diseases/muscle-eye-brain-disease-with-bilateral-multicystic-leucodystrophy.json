  "diagnosticCriteria": {
    "formalCriteriaName": "Muscle-eye-brain disease diagnostic criteria",
    "criteria": [
      {
        "id": "muscle-weakness",
        "description": "Congenital hypotonia and progressive muscle weakness consistent with muscular dystrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-abnormalities",
        "description": "Ocular malformations including congenital cataracts, myopia, and retinal dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-imaging",
        "description": "Bilateral multicystic leukodystrophy with characteristic white matter abnormalities on MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the POMGNT1 gene or related glycosylation pathway genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "Electromyographic evidence of myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital muscle weakness, ocular abnormalities, and characteristic bilateral multicystic leukodystrophy on brain MRI",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if clinical and imaging criteria are met."
  },
