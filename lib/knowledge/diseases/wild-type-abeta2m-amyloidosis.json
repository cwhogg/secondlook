  "diagnosticCriteria": {
    "formalCriteriaName": "Wild Type Beta-2 Microglobulin Amyloidosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "amyloid-deposition",
        "description": "Histological confirmation of amyloid deposits positive for beta-2 microglobulin by immunohistochemistry or mass spectrometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of characteristic musculoskeletal symptoms including carpal tunnel syndrome and bone cysts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dialysis-history",
        "description": "History of long-term dialysis (>5 years) or chronic kidney disease",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-amyloidoses",
        "description": "Exclusion of other types of amyloidosis by genetic and biochemical testing",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Histological confirmation of beta-2 microglobulin amyloid deposits plus characteristic clinical presentation; exclusion of other amyloidosis types",
    "notes": "Diagnosis often requires tissue biopsy and specialized amyloid typing techniques."
  },
