  "diagnosticCriteria": {
    "formalCriteriaName": "Factor X Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "prolonged-pt-apt",
        "description": "Prolonged prothrombin time (PT) and activated partial thromboplastin time (aPTT)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "factor-x-activity",
        "description": "Reduced Factor X activity levels (<10% in severe cases)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the F10 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "bleeding-history",
        "description": "Personal or family history of bleeding diathesis",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of prolonged PT and aPTT with reduced Factor X activity levels, plus bleeding history",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory"
  },
