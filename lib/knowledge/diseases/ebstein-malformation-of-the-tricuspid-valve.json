  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; BNP may be elevated in heart failure"
    ],
    "imaging": [
      "Echocardiography showing apical displacement of tricuspid valve leaflets and atrialized right ventricle",
      "Cardiac MRI for detailed anatomical assessment",
      "Chest X-ray showing cardiomegaly and right atrial enlargement"
    ],
    "genetic": [
      "MYH7 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electrocardiogram showing right atrial enlargement, right bundle branch block, and pre-excitation (Wolff-Parkinson-White syndrome)"
    ]
  },
