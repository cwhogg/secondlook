  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Classical-like EDS Type 1",
    "criteria": [
      {
        "id": "skin-hyperextensibility",
        "description": "Marked skin hyperextensibility with velvety texture",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "atrophic-scarring",
        "description": "Presence of atrophic, cigarette-paper-like scars",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-hypermobility",
        "description": "Generalized joint hypermobility without recurrent dislocations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-vascular-features",
        "description": "Lack of significant vascular complications differentiating from vascular EDS",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in TNXB gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical criteria plus genetic confirmation of TNXB mutations",
    "notes": "Diagnosis requires exclusion of other EDS subtypes, especially classical and vascular types."
  },
