  "keyFindings": {
    "laboratory": [
      "Elevated plasma norepinephrine levels during supine rest",
      "Reduced or absent sweat response on quantitative sudomotor axon reflex testing"
    ],
    "imaging": [
      "Normal brain MRI",
      "Possible scoliosis on spinal X-ray"
    ],
    "genetic": [
      "Mutations in the IKBKAP (ELP1) gene, most commonly the IVS20+6T>C splice mutation"
    ],
    "other": [
      "Reduced or absent flare response to histamine skin test",
      "Abnormal autonomic function testing including blood pressure and heart rate variability"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hereditary-sensory-and-autonomic-neuropathy-type-1",
      "distinguishingFeatures": [
        "Earlier onset of sensory loss",
        "Presence of ulcerations and bone infections",
        "Different genetic mutations (SPTLC1 gene)"
      ]
    },
    {
      "diseaseId": "hereditary-sensory-and-autonomic-neuropathy-type-2",
      "distinguishingFeatures": [
        "More prominent distal sensory loss",
        "Less autonomic involvement",
        "Mutations in WNK1 gene"
      ]
    }
  ],
  "redFlags": [
    "Recurrent aspiration pneumonia",
    "Severe orthostatic hypotension causing syncope",
    "Failure to thrive in infancy"
  ],
