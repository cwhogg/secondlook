  "diagnosticCriteria": {
    "formalCriteriaName": "None established; diagnosis based on clinical, laboratory, and genetic findings",
    "criteria": [
      {
        "id": "lymphopenia",
        "description": "Severe lymphopenia affecting T, B, and NK cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ada-activity-deficiency",
        "description": "Markedly reduced or absent adenosine deaminase enzyme activity in red blood cells or lymphocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Pathogenic mutations identified in the ADA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "toxic-metabolites",
        "description": "Elevated toxic purine metabolites such as deoxyadenosine nucleotides in blood or urine",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Recurrent severe infections and failure to thrive in infancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe lymphopenia, ADA enzyme deficiency, and pathogenic ADA gene mutation",
    "notes": "Diagnosis confirmed by biochemical and genetic testing; newborn screening may detect early"
  },
