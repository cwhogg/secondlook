  "diagnosticCriteria": {
    "formalCriteriaName": "Juvenile Paget Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-alkaline-phosphatase",
        "description": "Markedly elevated serum alkaline phosphatase levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-bone-changes",
        "description": "Characteristic radiographic findings including cortical thickening, bone deformities, and osteopenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathologic-findings",
        "description": "Bone biopsy showing increased osteoclastic resorption and abnormal bone remodeling",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of bone deformities, fractures, and skeletal pain in early childhood",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in the TNFRSF11B gene (encoding osteoprotegerin)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated alkaline phosphatase and characteristic radiologic bone changes with clinical features consistent with juvenile onset",
    "notes": "Genetic testing can support diagnosis but is not mandatory."
  },
