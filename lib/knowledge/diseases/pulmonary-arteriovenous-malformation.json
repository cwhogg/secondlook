  "diagnosticCriteria": {
    "formalCriteriaName": "No standardized formal criteria; diagnosis based on clinical, imaging, and genetic findings",
    "criteria": [
      {
        "id": "imaging-confirmation",
        "description": "Demonstration of direct communication between pulmonary arteries and veins on contrast-enhanced chest CT or pulmonary angiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of hypoxemia or unexplained cyanosis consistent with right-to-left shunting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with hereditary hemorrhagic telangiectasia (e.g., ENG, ACVRL1) if applicable",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Imaging confirmation of pulmonary AVM plus clinical evidence of right-to-left shunting",
    "notes": "Genetic testing supports diagnosis especially in hereditary cases but is not mandatory."
  },
