  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (ESR, CRP)",
      "Leukopenia or lymphopenia",
      "Elevated liver enzymes in some cases"
    ],
    "imaging": [
      "Chest X-ray may show infiltrates if respiratory involvement present"
    ],
    "genetic": [
      "HLA-B (susceptibility)",
      "IKZF1 (susceptibility)"
    ],
    "other": [
      "Skin biopsy showing full-thickness epidermal necrosis and subepidermal bullae"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "toxic-epidermal-necrolysis",
      "distinguishingFeatures": [
        "Skin detachment >30% body surface area",
        "More severe systemic involvement",
        "Higher mortality rate"
      ]
    },
    {
      "diseaseId": "erythema-multiforme",
      "distinguishingFeatures": [
        "Target lesions without extensive mucosal involvement",
        "Less epidermal detachment",
        "Usually triggered by infections rather than drugs"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of skin detachment",
    "Signs of sepsis or systemic infection",
    "Respiratory distress or airway compromise"
  ],
