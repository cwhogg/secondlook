  "diagnosticCriteria": {
    "formalCriteriaName": "RTTN Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Congenital microcephaly with head circumference below the 3rd percentile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cortical-malformations",
        "description": "Neuroradiological evidence of cortical malformations including polymicrogyria or pachygyria",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Postnatal short stature below the 5th percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the RTTN gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital microcephaly, cortical malformations on imaging, short stature, and confirmation of biallelic RTTN pathogenic variants",
    "notes": "Diagnosis relies heavily on genetic testing and neuroimaging findings."
  },
