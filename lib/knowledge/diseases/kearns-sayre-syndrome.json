      ]
    },
    {
      "diseaseId": "mitochondrial-encephalomyopathy-lactic-acidosis-and-stroke-like-episodes",
      "distinguishingFeatures": [
        "Stroke-like episodes",
        "Different pattern of neurological involvement",
        "No characteristic pigmentary retinopathy"
      ]
    }
  ],
