  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnosis of Isolated Ectopia Lentis",
    "criteria": [
      {
        "id": "lens-dislocation",
        "description": "Presence of lens displacement (ectopia lentis) confirmed by slit-lamp examination or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-systemic-features",
        "description": "No clinical or genetic evidence of systemic connective tissue disorders such as Marfan syndrome or homocystinuria",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance of isolated ectopia lentis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of lens dislocation without systemic features of connective tissue disorders; family history supportive but not mandatory",
    "notes": "Genetic testing for FBN1 mutations may aid in differential diagnosis but isolated ectopia lentis can occur with or without identifiable mutations."
  },
