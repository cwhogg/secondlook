  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and biochemical diagnostic criteria for Occipital Horn Syndrome",
    "criteria": [
      {
        "id": "occipital-horns",
        "description": "Presence of characteristic occipital exostoses ('occipital horns') on skull radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "connective-tissue-features",
        "description": "Connective tissue abnormalities including skin laxity, joint hypermobility, and easy bruising",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lysyl-oxidase-deficiency",
        "description": "Reduced lysyl oxidase enzyme activity or biochemical evidence of impaired copper metabolism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ATP7A-mutation",
        "description": "Identification of pathogenic variants in the ATP7A gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "vascular-abnormalities",
        "description": "Presence of vascular tortuosity or aneurysms on imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of occipital horns plus connective tissue abnormalities and biochemical or genetic confirmation of ATP7A mutation or lysyl oxidase deficiency",
    "notes": "Diagnosis is supported by clinical, radiological, biochemical, and genetic findings; molecular confirmation is preferred."
  },
