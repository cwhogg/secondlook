  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Primary Familial Polycythemia",
    "criteria": [
      {
        "id": "elevated-hemoglobin-hematocrit",
        "description": "Sustained elevated hemoglobin and hematocrit levels above normal reference ranges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of erythrocytosis or polycythemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-erythropoietin-levels",
        "description": "Normal or low serum erythropoietin levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-secondary-causes",
        "description": "Exclusion of secondary causes of polycythemia such as hypoxia or tumors",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of germline mutations associated with familial erythrocytosis (e.g., EPOR mutations)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Sustained elevated hemoglobin/hematocrit with positive family history and exclusion of secondary causes",
    "notes": "Genetic testing can support diagnosis but is not mandatory."
  },
