  "diagnosticCriteria": {
    "formalCriteriaName": "ATS/JRS/ALAT Clinical Practice Guideline for Hypersensitivity Pneumonitis",
    "criteria": [
      {
        "id": "exposure-history",
        "description": "Documented exposure to known inciting antigen",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-pattern",
        "description": "High-resolution CT showing fibrotic interstitial lung disease with features suggestive of hypersensitivity pneumonitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bronchoalveolar-lavage",
        "description": "Lymphocytosis in bronchoalveolar lavage fluid (>20%)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Lung biopsy showing interstitial fibrosis with poorly formed granulomas and chronic inflammation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pulmonary-function-tests",
        "description": "Restrictive pattern with reduced diffusing capacity for carbon monoxide (DLCO)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of documented antigen exposure plus compatible imaging findings; supportive bronchoalveolar lavage or histopathology findings increase diagnostic confidence",
    "notes": "Diagnosis is often clinical and supported by multidisciplinary discussion including radiology and pathology."
  },
