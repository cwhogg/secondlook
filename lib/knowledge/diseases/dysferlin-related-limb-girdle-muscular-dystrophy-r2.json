  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for LGMD2B",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness predominantly affecting limb-girdle muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing absent or markedly reduced dysferlin protein expression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the DYSF gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serum-creatine-kinase",
        "description": "Elevated serum creatine kinase (CK) levels, often >10 times normal",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "Electromyography showing myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal limb-girdle muscle weakness plus either muscle biopsy showing absent/reduced dysferlin or identification of pathogenic DYSF mutations",
    "notes": "Genetic confirmation is considered the gold standard for diagnosis."
  },
