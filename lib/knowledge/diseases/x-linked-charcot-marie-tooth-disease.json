        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in the GJB1 gene (connexin 32)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-neuroimaging",
        "description": "MRI showing muscle atrophy and fatty replacement in distal limbs",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical features consistent with CMT plus nerve conduction abnormalities and identification of a pathogenic GJB1 mutation or compatible family history",
    "notes": "Genetic confirmation is considered the gold standard for diagnosis."
