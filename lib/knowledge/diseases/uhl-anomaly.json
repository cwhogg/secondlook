  "keyFindings": {
    "laboratory": [
      "Elevated liver enzymes secondary to right heart failure",
      "Normal cardiac biomarkers unless secondary injury"
    ],
    "imaging": [
      "Echocardiography showing absent or severely thinned right ventricular myocardium",
      "Cardiac MRI demonstrating right ventricular myocardial absence and dilation",
      "Right ventricular angiography with thin-walled right ventricle"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology confirming absence of right ventricular myocardium with preserved endocardium and epicardium"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "arrhythmogenic-right-ventricular-cardiomyopathy",
      "distinguishingFeatures": [
        "Fibrofatty replacement of right ventricular myocardium",
        "Progressive arrhythmias with genetic basis",
        "Right ventricular wall thinning but not complete absence"
      ]
    },
    {
      "diseaseId": "ebstein-anomaly",
      "distinguishingFeatures": [
        "Apical displacement of tricuspid valve leaflets",
        "Right atrial enlargement rather than right ventricular myocardial absence",
        "Associated tricuspid regurgitation"
      ]
    }
  ],
