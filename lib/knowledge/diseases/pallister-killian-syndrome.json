  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Pallister-Killian Syndrome",
    "criteria": [
      {
        "id": "mosaic-tetrasomy-12p",
        "description": "Presence of mosaic tetrasomy of chromosome 12p detected by cytogenetic or molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial dysmorphisms including high forehead, sparse scalp hair, hypertelorism, and flat nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay and intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Congenital hypotonia observed in infancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "skin-pigmentation-anomalies",
        "description": "Hypopigmented or hyperpigmented streaks or patches on the skin",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of mosaic tetrasomy 12p plus at least two major clinical features",
    "notes": "Diagnosis is confirmed by cytogenetic or molecular detection of mosaic tetrasomy 12p, often requiring skin fibroblast analysis due to low blood mosaicism."
  },
