  "diagnosticCriteria": {
    "formalCriteriaName": "Crane-Heise Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "short-limbs",
        "description": "Severe micromelic limb shortening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "narrow-thorax",
        "description": "Narrow thorax with short ribs causing respiratory compromise",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including prominent forehead and midface hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-findings",
        "description": "Radiographic evidence of metaphyseal abnormalities and vertebral anomalies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in genes associated with skeletal dysplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: severe micromelic limb shortening, narrow thorax with short ribs, and characteristic craniofacial dysmorphism",
    "notes": "Diagnosis is primarily clinical supported by radiological and genetic findings"
  },
