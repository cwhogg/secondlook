  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for AR Spastic Paraplegia Type 9B",
    "criteria": [
      {
        "id": "progressive-spasticity",
        "description": "Progressive lower limb spasticity and weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the SPG9B-associated gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging-exclusion",
        "description": "Brain and spinal cord MRI excluding other causes of spastic paraplegia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consistent autosomal recessive inheritance pattern or consanguinity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive lower limb spasticity and weakness plus genetic confirmation of biallelic pathogenic variants in the SPG9B gene",
    "notes": "Diagnosis requires exclusion of other causes of spastic paraplegia and supportive neuroimaging findings."
  },
