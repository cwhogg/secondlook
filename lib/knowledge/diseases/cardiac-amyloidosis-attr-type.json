  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for ATTR Cardiac Amyloidosis",
    "criteria": [
      {
        "id": "amyloid-deposition",
        "description": "Demonstration of transthyretin amyloid deposits in cardiac tissue by biopsy or non-invasive imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "echocardiographic-features",
        "description": "Echocardiographic evidence of increased left ventricular wall thickness with restrictive cardiomyopathy pattern",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic TTR gene mutation (for hereditary ATTR)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "bone-scintigraphy",
        "description": "Positive 99mTc-PYP or DPD bone scintigraphy with grade 2 or 3 myocardial uptake in absence of monoclonal protein",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-light-chain-amyloidosis",
        "description": "Exclusion of AL amyloidosis by serum and urine immunofixation and free light chain assay",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of cardiac amyloid deposits confirmed by biopsy or positive bone scintigraphy with typical echocardiographic features and exclusion of AL amyloidosis",
    "notes": "Genetic testing distinguishes hereditary from wild-type ATTR amyloidosis"
  },
