  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Autosomal Recessive Cerebellar Ataxia with Pyramidal Signs and Oculomotor Apraxia",
    "criteria": [
      {
        "id": "cerebellar-ataxia",
        "description": "Presence of progressive cerebellar ataxia confirmed by clinical examination and supported by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pyramidal-signs",
        "description": "Evidence of pyramidal tract involvement including spasticity and hyperreflexia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oculomotor-apraxia",
        "description": "Impaired voluntary horizontal saccades with compensatory head thrusts (oculomotor apraxia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nystagmus",
        "description": "Presence of gaze-evoked or spontaneous nystagmus",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in causative gene(s)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive cerebellar ataxia with pyramidal signs and oculomotor apraxia; genetic confirmation supportive but not mandatory",
    "notes": "Diagnosis requires exclusion of other hereditary ataxias and neurodegenerative disorders."
  },
