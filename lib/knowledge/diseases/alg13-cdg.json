  "diagnosticCriteria": {
    "formalCriteriaName": "ALG13-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "neurological-manifestations",
        "description": "Early-onset epileptic encephalopathy or infantile spasms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-transferrin-glycosylation",
        "description": "Abnormal serum transferrin glycosylation pattern detected by isoelectric focusing or mass spectrometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pathogenic-alg13-variant",
        "description": "Identification of pathogenic or likely pathogenic variants in the ALG13 gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Central hypotonia observed clinically",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic ALG13 variant plus abnormal transferrin glycosylation and clinical neurological manifestations",
    "notes": "Diagnosis confirmed by molecular genetic testing and biochemical assays; clinical presentation may vary."
  },
