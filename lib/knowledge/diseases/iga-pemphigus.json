  "differentialDiagnoses": [
    {
      "diseaseId": "pemphigus-vulgaris",
      "distinguishingFeatures": [
        "IgG autoantibodies against desmoglein 3 and 1",
        "Suprabasal acantholysis without predominant neutrophilic pustules",
        "Positive direct immunofluorescence for IgG and C3, not IgA"
      ]
    },
    {
      "diseaseId": "subcorneal-pustular-dermatosis",
      "distinguishingFeatures": [
        "Predominantly subcorneal pustules without acantholysis",
        "IgA deposition localized to subcorneal region",
        "Clinical presentation with annular pustules but absence of acantholytic cells"
      ]
    }
  ],
