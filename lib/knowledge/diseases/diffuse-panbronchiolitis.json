  "keyFindings": {
    "laboratory": [
      "Elevated cold hemagglutinin titers",
      "Mild leukocytosis with neutrophilia",
      "Elevated inflammatory markers (ESR, CRP)"
    ],
    "imaging": [
      "Chest X-ray showing bilateral diffuse small nodular shadows predominantly in lower lung fields",
      "High-resolution CT demonstrating centrilobular nodules, tree-in-bud pattern, and bronchiectasis"
    ],
    "genetic": [
      "Association with HLA-B54 and HLA-A11 alleles in East Asian populations"
    ],
    "other": [
      "Pulmonary function tests showing obstructive ventilatory defect",
      "Sputum cultures often positive for Pseudomonas aeruginosa"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "bronchiectasis",
      "distinguishingFeatures": [
        "Localized rather than diffuse bronchiectasis",
        "Often post-infectious or cystic fibrosis related",
        "Less association with chronic sinusitis"
      ]
    },
    {
      "diseaseId": "hypersensitivity-pneumonitis",
      "distinguishingFeatures": [
        "History of antigen exposure",
        "Interstitial infiltrates rather than centrilobular nodules",
        "Improvement with antigen avoidance"
      ]
    },
    {
      "diseaseId": "chronic-obstructive-pulmonary-disease",
      "distinguishingFeatures": [
        "History of smoking",
        "Emphysematous changes on imaging",
        "Less prominent sinusitis"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive respiratory failure",
    "Development of cor pulmonale",
    "Recurrent severe pulmonary infections"
  ],
