  "keyFindings": {
    "laboratory": [
      "Elevated serum CA-125 levels",
      "Cytology of ascitic fluid showing malignant mesothelial cells",
      "Mild anemia and thrombocytosis"
    ],
    "imaging": [
      "CT scan showing diffuse peritoneal thickening and nodularity",
      "Ascites with scalloping of visceral surfaces on imaging",
      "MRI demonstrating peritoneal masses and omental caking"
    ],
    "genetic": [
      "BAP1 gene mutations or deletions in tumor tissue",
      "Loss of p16 (CDKN2A) detected by FISH",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Positive immunohistochemical staining for calretinin, WT-1, cytokeratin 5/6",
      "Negative staining for carcinoma markers such as CEA and Ber-EP4"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "peritoneal-carcinomatosis",
