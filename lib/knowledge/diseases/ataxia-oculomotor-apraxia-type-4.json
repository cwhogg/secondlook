  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Ataxia-oculomotor apraxia type 4",
    "criteria": [
      {
        "id": "ataxia",
        "description": "Progressive cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oculomotor-apraxia",
        "description": "Presence of oculomotor apraxia characterized by impaired voluntary horizontal eye movements",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-alpha-fetoprotein",
        "description": "Elevated serum alpha-fetoprotein levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the PNKP gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peripheral-neuropathy",
        "description": "Evidence of sensorimotor peripheral neuropathy on electrophysiological studies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia and oculomotor apraxia with genetic confirmation of PNKP mutation",
    "notes": "Diagnosis is supported by elevated alpha-fetoprotein and peripheral neuropathy but these are not mandatory."
  },
