  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests except possible polycythemia",
      "Genetic testing confirming FGFR3 mutation (commonly p.Lys650Glu)"
    ],
    "imaging": [
      "Prenatal ultrasound showing cloverleaf skull and limb shortening",
      "Postnatal radiographs revealing curved femora, platyspondyly, and narrow thorax"
    ],
    "genetic": [
      "FGFR3 (causative)",
      "Autosomal dominant mutations in FGFR3 gene, typically p.Lys650Glu"
    ],
    "other": [
      "Prenatal MRI may assist in detailed skeletal and brain assessment",
      "Respiratory insufficiency leading to early neonatal death"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "thanatophoric-dysplasia-type-1",
      "distinguishingFeatures": [
        "Absence of cloverleaf skull deformity",
        "Presence of curved femora but no straight femora",
        "Different FGFR3 mutations (e.g., p.Arg248Cys)"
      ]
    },
    {
      "diseaseId": "achondroplasia",
      "distinguishingFeatures": [
        "Milder limb shortening",
        "No cloverleaf skull",
        "Normal thoracic size",
        "Different FGFR3 mutations (p.Gly380Arg)"
      ]
    }
  ],
  "redFlags": [
    "Severe respiratory distress at birth due to pulmonary hypoplasia",
