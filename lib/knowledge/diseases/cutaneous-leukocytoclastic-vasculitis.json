  "diagnosticCriteria": {
    "formalCriteriaName": "None established; clinical and histopathological diagnosis",
    "criteria": [
      {
        "id": "palpable-purpura",
        "description": "Presence of palpable purpura predominantly on lower extremities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-biopsy",
        "description": "Skin biopsy showing neutrophilic infiltration with leukocytoclasia and fibrinoid necrosis of small vessels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immune-complex-deposition",
        "description": "Immunofluorescence demonstrating immune complex deposition in vessel walls",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-systemic-involvement",
        "description": "Lack of systemic vasculitis signs or involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of palpable purpura with confirmatory skin biopsy demonstrating leukocytoclastic vasculitis",
    "notes": "Diagnosis is primarily clinical supported by histopathology; exclusion of systemic vasculitis is essential"
  },
