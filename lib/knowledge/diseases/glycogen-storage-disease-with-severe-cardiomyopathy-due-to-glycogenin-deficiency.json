  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Glycogenin Deficiency Cardiomyopathy",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the GYG1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiomyopathy-echocardiography",
        "description": "Echocardiographic evidence of severe hypertrophic or dilated cardiomyopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy-glycogen-accumulation",
        "description": "Muscle biopsy demonstrating abnormal glycogen accumulation with deficient glycogenin protein expression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of exercise intolerance and muscle weakness",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "laboratory-findings",
        "description": "Elevated serum creatine kinase and abnormal glycogen metabolism markers",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic GYG1 variants plus echocardiographic evidence of severe cardiomyopathy and muscle biopsy confirming glycogenin deficiency",
    "notes": "Genetic testing is essential for definitive diagnosis; muscle biopsy and cardiac imaging support clinical suspicion."
  },
