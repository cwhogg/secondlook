  "diagnosticCriteria": {
    "formalCriteriaName": "MPS VI Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficient activity of arylsulfatase B enzyme in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-gags",
        "description": "Elevated dermatan sulfate levels in urine glycosaminoglycan analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the ARSB gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features such as coarse facial features, skeletal dysplasia, and corneal clouding",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient arylsulfatase B enzyme activity plus elevated dermatan sulfate in urine; genetic confirmation supportive but not mandatory",
    "notes": "Early diagnosis is critical for management and treatment options"
  },
