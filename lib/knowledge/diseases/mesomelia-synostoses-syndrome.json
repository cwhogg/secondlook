      "Normal cognitive assessment",
      "Physical examination revealing characteristic facial features"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "multiple-synostoses-syndrome",
      "distinguishingFeatures": [
        "Presence of conductive hearing loss",
        "More extensive synostoses including carpal and tarsal bones",
        "Facial features differ, often with prominent ears"
      ]
    },
    {
      "diseaseId": "langer-mesomelic-dysplasia",
      "distinguishingFeatures": [
        "Severe mesomelic shortening with more pronounced limb deformities",
        "Associated with homozygous SHOX gene mutations",
        "Absence of multiple synostoses"
      ]
    }
  ],
