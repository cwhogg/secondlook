  "diagnosticCriteria": {
    "formalCriteriaName": "Hyperekplexia Diagnostic Criteria",
    "criteria": [
      {
        "id": "exaggerated-startle",
        "description": "Presence of exaggerated startle response to unexpected stimuli",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "stiffness",
        "description": "Generalized muscle stiffness or hypertonia, especially in neonatal period",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glra1-mutation",
        "description": "Identification of pathogenic mutation in the GLRA1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-neurological-signs",
        "description": "Lack of other neurological abnormalities such as seizures or cognitive impairment",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of exaggerated startle response and stiffness with confirmed GLRA1 mutation",
    "notes": "Diagnosis is clinical but confirmed by genetic testing for GLRA1 mutations"
  },
