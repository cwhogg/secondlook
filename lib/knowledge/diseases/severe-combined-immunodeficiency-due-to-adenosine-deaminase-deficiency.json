  "diagnosticCriteria": {
    "formalCriteriaName": "ESID Diagnostic Criteria for SCID",
    "criteria": [
      {
        "id": "lymphopenia",
        "description": "Profound lymphopenia with markedly reduced T, B, and NK cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ada-activity",
        "description": "Markedly decreased or absent adenosine deaminase enzyme activity in red blood cells or lymphocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the ADA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Early onset of severe infections including opportunistic infections",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-toxic-metabolites",
        "description": "Elevated deoxyadenosine nucleotides and dATP in blood or tissues",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of profound lymphopenia, absent ADA enzyme activity, and biallelic pathogenic ADA variants",
    "notes": "Diagnosis is confirmed by genetic testing and enzyme assay; early diagnosis critical for treatment."
  },
