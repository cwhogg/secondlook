  "diagnosticCriteria": {
    "formalCriteriaName": "Antley-Bixler syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of cranial sutures (craniosynostosis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiohumeral-synostosis",
        "description": "Radiohumeral synostosis or other upper limb joint fusions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midface-hypoplasia",
        "description": "Midface hypoplasia with midfacial retrusion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genital-anomalies",
        "description": "Ambiguous genitalia or genital anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "joint-contractures",
        "description": "Multiple joint contractures and limited range of motion",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial dysmorphism including frontal bossing and midface hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis, radiohumeral synostosis, and midface hypoplasia",
    "notes": "Genetic testing for mutations in FGFR2 or POR genes can support diagnosis"
  },
