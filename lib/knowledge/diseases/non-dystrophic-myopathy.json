  "diagnosticCriteria": {
    "formalCriteriaName": "Non-dystrophic Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of muscle weakness and/or myotonia without dystrophic changes on muscle biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyographic evidence of myotonia or myopathic changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with non-dystrophic myopathies (e.g., SCN4A, CLCN1, RYR1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing absence of dystrophic features and presence of specific histopathological abnormalities (e.g., fiber size variability, central nuclei)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant or recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation with supportive electromyography and genetic testing confirming pathogenic variants",
    "notes": "Muscle biopsy is supportive but not mandatory if genetic testing confirms diagnosis."
  },
