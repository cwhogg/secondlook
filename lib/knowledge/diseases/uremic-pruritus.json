  "keyFindings": {
    "laboratory": [
      "Elevated serum urea and creatinine consistent with chronic kidney disease",
      "Possible elevated serum parathyroid hormone (secondary hyperparathyroidism)",
      "Normal liver function tests (to exclude cholestatic pruritus)"
    ],
    "imaging": [
      "No specific imaging findings for uremic pruritus"
    ],
    "genetic": [
      "No known genetic markers associated"
    ],
    "other": [
      "Skin biopsy typically nonspecific; may show excoriations or secondary changes",
      "Improvement with dialysis optimization or parathyroidectomy in some cases"
    ]
  },
