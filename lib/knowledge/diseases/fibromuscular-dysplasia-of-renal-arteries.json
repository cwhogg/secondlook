  "diagnosticCriteria": {
    "formalCriteriaName": "No universally accepted formal criteria; diagnosis based on imaging and clinical presentation",
    "criteria": [
      {
        "id": "imaging-evidence",
        "description": "Characteristic 'string of beads' appearance or focal stenosis on angiography or CT/MR angiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypertension",
        "description": "Presence of secondary hypertension, often resistant or early onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-atherosclerosis",
        "description": "Exclusion of atherosclerotic renal artery disease and other causes of renal artery stenosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Symptoms consistent with renal ischemia such as flank pain or abdominal bruit",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Imaging evidence of characteristic arterial changes plus clinical evidence of secondary hypertension with exclusion of other causes",
    "notes": "Diagnosis primarily relies on imaging modalities combined with clinical presentation; biopsy rarely performed."
  },
