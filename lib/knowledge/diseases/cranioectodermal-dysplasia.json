  "diagnosticCriteria": {
    "formalCriteriaName": "Sensenbrenner Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including dolichocephaly, frontal bossing, and midface hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ectodermal-abnormalities",
        "description": "Ectodermal defects such as sparse hair, nail dystrophy, and dental anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-dysplasia",
        "description": "Skeletal abnormalities including short ribs, narrow thorax, and short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-disease",
        "description": "Presence of nephronophthisis or chronic kidney disease",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in IFT122, WDR35, or other related genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (craniofacial dysmorphism, ectodermal abnormalities, and skeletal dysplasia) with or without genetic confirmation",
    "notes": "Genetic testing is strongly recommended to confirm diagnosis and differentiate from overlapping ciliopathies."
  },
