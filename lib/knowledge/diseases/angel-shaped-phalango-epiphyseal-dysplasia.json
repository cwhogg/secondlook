  "diagnosticCriteria": {
    "formalCriteriaName": "Angel-shaped Phalango-Epiphyseal Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "angel-shaped-metacarpals",
        "description": "Presence of angel-shaped (V-shaped) deformity of the middle phalanges/metacarpals on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epiphyseal-dysplasia",
        "description": "Radiographic evidence of epiphyseal dysplasia affecting multiple long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Clinically observed disproportionate short stature with limb shortening",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "joint-hypermobility",
        "description": "Mild joint hypermobility and limited range of motion in affected joints",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of angel-shaped phalanges on radiographs plus epiphyseal dysplasia in multiple long bones",
    "notes": "Diagnosis is primarily radiological supported by clinical features; genetic testing may assist but is not definitive."
  },
