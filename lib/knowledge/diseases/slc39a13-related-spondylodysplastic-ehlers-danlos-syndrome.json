  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild anemia secondary to chronic disease"
    ],
    "imaging": [
      "Radiographs showing platyspondyly and metaphyseal dysplasia",
      "MRI may show spinal abnormalities"
    ],
    "genetic": [
      "SLC39A13 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy showing abnormalities in collagen fibril morphology",
      "Joint hypermobility assessed by Beighton score"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "classical-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "More prominent skin fragility and atrophic scarring",
        "Absence of skeletal dysplasia and platyspondyly",
        "Different genetic mutations (COL5A1, COL5A2)"
      ]
    },
    {
      "diseaseId": "spondylodysplastic-ehlers-danlos-syndrome-b4galt7-related",
      "distinguishingFeatures": [
        "Similar skeletal abnormalities but caused by B4GALT7 mutations",
        "Distinct biochemical defects in glycosaminoglycan synthesis",
        "Different facial features and joint involvement"
      ]
    }
  ],
  "redFlags": [
    "Early-onset severe joint dislocations",
    "Progressive platyspondyly with spinal deformities",
    "Signs of vascular involvement such as aortic root dilatation"
  ],
