  "diagnosticCriteria": {
    "formalCriteriaName": "MSMD Diagnostic Criteria",
    "criteria": [
      {
        "id": "recurrent-mycobacterial-infections",
        "description": "Recurrent or severe infections with weakly virulent mycobacteria such as BCG or environmental mycobacteria",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-ifn-gamma-response",
        "description": "Demonstrated impairment in IFN-γ signaling pathway by functional assays",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pathogenic-genetic-variant",
        "description": "Identification of pathogenic variants in genes involved in IFN-γ immunity (e.g., IFNGR1, IFNGR2, STAT1, IL12B, IL12RB1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-secondary-immunodeficiency",
        "description": "Exclusion of acquired or secondary immunodeficiencies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent infections with weakly virulent mycobacteria plus either impaired IFN-γ response or identification of pathogenic genetic variant in IFN-γ pathway genes",
    "notes": "Diagnosis requires integration of clinical, immunological, and genetic data."
  },
