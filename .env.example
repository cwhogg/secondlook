# Required: OpenAI API key for AI analysis pipeline
OPENAI_API_KEY=sk-...

# Required: UMLS API key for medical terminology validation
# Get one at: https://uts.nlm.nih.gov/uts/
UMLS_API_KEY=...

# Optional: Maximum budget per analysis in cents (default: 100 = $1.00)
# ANALYSIS_BUDGET_CENTS=100

# After setting OPENAI_API_KEY, generate the semantic search embeddings index:
#   node scripts/embed-diseases.js
# This creates lib/knowledge/embeddings-meta.json + embeddings-vectors.bin (gitignored).
# Without it, the retrieval engine falls back to string matching.
