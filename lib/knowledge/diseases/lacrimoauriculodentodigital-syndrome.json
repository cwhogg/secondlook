  "diagnosticCriteria": {
    "formalCriteriaName": "LADD Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "lacrimal-dysgenesis",
        "description": "Congenital aplasia or hypoplasia of lacrimal and salivary glands leading to dry eyes and mouth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "auricular-malformations",
        "description": "Malformed, cup-shaped, or low-set ears with hearing impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-abnormalities",
        "description": "Hypodontia, enamel hypoplasia, and abnormal tooth morphology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digital-anomalies",
        "description": "Clinodactyly, syndactyly, or hypoplastic thumbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-features",
        "description": "Characteristic facial dysmorphisms including broad nasal bridge and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital lacrimal/salivary gland aplasia or hypoplasia plus at least two of the following: auricular malformations, dental abnormalities, or digital anomalies",
    "notes": "Genetic testing for mutations in FGFR2, FGFR3, or FGFR1 genes can support diagnosis"
  },
