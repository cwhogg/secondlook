  "diagnosticCriteria": {
    "formalCriteriaName": "Chromosomal Microarray and Cytogenetic Diagnostic Criteria for 8p Inv Dup Del Syndrome",
    "criteria": [
      {
        "id": "cytogenetic-abnormality",
        "description": "Presence of inverted duplication and terminal deletion on the short arm of chromosome 8 confirmed by chromosomal microarray or karyotyping",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability identified in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Characteristic craniofacial dysmorphic features including microcephaly, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital heart defects such as ventricular septal defect or atrial septal defect",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia or decreased muscle tone",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed chromosomal abnormality on 8p plus presence of developmental delay or intellectual disability",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support but are variable."
  },
