  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible elevated lactate during stress episodes"
    ],
    "imaging": [
      "MRI showing diffuse symmetric white matter rarefaction and cystic degeneration",
      "Absence of contrast enhancement"
    ],
    "genetic": [
      "Biallelic pathogenic variants in EIF2B1, EIF2B2, EIF2B3, EIF2B4, or EIF2B5 genes"
    ],
    "other": [
      "Stress-induced clinical worsening",
      "Slowly progressive neurological decline"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "adult-onset-leukodystrophy",
