  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Chest X-ray showing absent or hypoplastic ribs and chest wall deformity",
      "MRI or CT scan confirming absence or hypoplasia of pectoralis major muscle",
      "Ultrasound or MRI of upper limb anomalies"
    ],
    "genetic": [
      "TWIST2 (causative)",
      "Rare familial cases reported with possible autosomal dominant inheritance with variable expressivity"
    ],
    "other": [
      "Clinical examination revealing unilateral chest wall and upper limb anomalies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "amniotic-band-syndrome",
      "distinguishingFeatures": [
        "Presence of constriction rings and distal amputations",
        "History of amniotic band disruption",
        "Multiple limb and craniofacial anomalies"
      ]
    },
    {
      "diseaseId": "thoracic-outlet-syndrome",
      "distinguishingFeatures": [
        "Neurovascular compression symptoms without congenital chest wall anomalies",
        "No pectoralis muscle absence",
        "Typically acquired rather than congenital"
      ]
    },
    {
      "diseaseId": "klippel-feil-syndrome",
      "distinguishingFeatures": [
        "Congenital fusion of cervical vertebrae",
        "Short neck and limited neck mobility",
        "No chest wall muscle absence"
      ]
    }
  ],
  "redFlags": [
