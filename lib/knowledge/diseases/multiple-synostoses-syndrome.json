  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Multiple Synostoses Syndrome",
    "criteria": [
      {
        "id": "proximal-interphalangeal-synostosis",
        "description": "Presence of proximal interphalangeal joint synostosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elbow-synostosis",
        "description": "Radiologically confirmed synostosis of the elbow joint",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "conductive-hearing-loss",
        "description": "Bilateral conductive hearing loss due to stapes ankylosis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including broad nasal bridge and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of proximal interphalangeal synostosis and elbow synostosis confirmed clinically and radiologically",
    "notes": "Genetic testing for NOG gene mutations can support diagnosis but is not mandatory"
  },
