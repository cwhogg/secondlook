  "diagnosticCriteria": {
    "formalCriteriaName": "Nephrotic Syndrome Diagnostic Criteria with Secondary Steroid Resistance",
    "criteria": [
      {
        "id": "initial-steroid-sensitivity",
        "description": "Initial complete remission of proteinuria following corticosteroid therapy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "secondary-steroid-resistance",
        "description": "Development of steroid resistance after initial steroid-sensitive response",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nephrotic-range-proteinuria",
        "description": "Proteinuria exceeding 40 mg/m2/hour or urine protein/creatinine ratio >2 mg/mg",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypoalbuminemia",
        "description": "Serum albumin less than 2.5 g/dL",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "edema",
        "description": "Presence of generalized edema at presentation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Initial steroid sensitivity with subsequent development of steroid resistance along with nephrotic-range proteinuria",
    "notes": "Diagnosis requires exclusion of secondary causes of nephrotic syndrome and confirmation by renal biopsy if indicated."
  },
