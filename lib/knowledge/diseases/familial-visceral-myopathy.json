  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Visceral Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "family-history",
        "description": "Presence of a family history of visceral myopathy or related gastrointestinal dysmotility disorders",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Muscle biopsy showing smooth muscle degeneration and fibrosis in visceral organs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Chronic gastrointestinal dysmotility symptoms including pseudo-obstruction and megacolon",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with smooth muscle function (e.g., ACTG2 mutations)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiologic-findings",
        "description": "Imaging evidence of dilated bowel loops without mechanical obstruction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of family history, characteristic clinical features, and confirmatory histopathology",
    "notes": "Genetic testing is supportive but not mandatory; diagnosis relies heavily on clinical and histopathological correlation."
  },
