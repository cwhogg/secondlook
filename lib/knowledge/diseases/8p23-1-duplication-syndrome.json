  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and molecular diagnosis of 8p23.1 duplication syndrome",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of a duplication involving the 8p23.1 chromosomal region confirmed by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defect",
        "description": "Presence of congenital heart defects, especially atrial or ventricular septal defects",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features such as micrognathia, broad nasal bridge, and hypertelorism",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 8p23.1 duplication plus at least one major clinical feature such as congenital heart defect or developmental delay",
    "notes": "Diagnosis relies primarily on molecular genetic testing; clinical features support but are variable."
  },
