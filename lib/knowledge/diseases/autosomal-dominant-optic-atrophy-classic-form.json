  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of mitochondrial DNA mutations in some cases"
    ],
    "imaging": [
      "Optical coherence tomography (OCT) showing thinning of retinal nerve fiber layer",
      "MRI brain usually normal or shows mild optic nerve atrophy"
    ],
    "genetic": [
      "OPA1 (causative)",
      "DNM1L (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Visual field testing demonstrating central or cecocentral scotomas",
      "Electrophysiology may show reduced visual evoked potentials"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "leber-hereditary-optic-neuropathy",
      "distinguishingFeatures": [
        "Typically acute or subacute onset",
        "Mitochondrial DNA mutations",
        "Male predominance"
      ]
    },
    {
      "diseaseId": "dominant-optic-atrophy-plus-syndrome",
      "distinguishingFeatures": [
        "Additional neurological symptoms such as ataxia and myopathy",
        "More severe multisystem involvement"
      ]
    },
    {
      "diseaseId": "optic-neuritis",
      "distinguishingFeatures": [
        "Painful vision loss",
        "Often unilateral",
        "Associated with demyelinating disease"
      ]
    }
  ],
  "redFlags": [
