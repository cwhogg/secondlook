      {
        "id": "frontonasal-clefting",
        "description": "Presence of frontonasal dysplasia characterized by midline facial clefting or hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "alopecia",
        "description": "Congenital or early-onset alopecia involving the scalp",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genital-anomalies",
        "description": "Congenital genital anomalies such as hypospadias, micropenis, or ambiguous genitalia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-anomalies",
        "description": "Additional craniofacial anomalies including broad nasal root and frontal bossing",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: frontonasal dysplasia, alopecia, and genital anomalies",
    "notes": "Diagnosis is primarily clinical; genetic testing may assist but no specific gene identified"
  },
