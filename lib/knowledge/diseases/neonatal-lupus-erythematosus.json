  "diagnosticCriteria": {
    "formalCriteriaName": "Neonatal Lupus Diagnostic Criteria",
    "criteria": [
      {
        "id": "maternal-autoantibodies",
        "description": "Presence of maternal anti-Ro/SSA and/or anti-La/SSB autoantibodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-lesions",
        "description": "Characteristic annular or polycyclic erythematous skin lesions in the neonate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-block",
        "description": "Presence of congenital heart block detected by ECG or echocardiography",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing interface dermatitis with basal cell degeneration",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-causes",
        "description": "Exclusion of other causes of neonatal rash and heart block",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of maternal anti-Ro/SSA or anti-La/SSB antibodies plus typical neonatal cutaneous lesions or congenital heart block",
    "notes": "Diagnosis is clinical supported by serology and may be confirmed by biopsy; heart block can occur without skin lesions."
  },
