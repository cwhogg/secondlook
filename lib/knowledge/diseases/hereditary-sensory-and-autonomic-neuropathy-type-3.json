  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Dysautonomia Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the IKBKAP gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autonomic-dysfunction",
        "description": "Presence of autonomic nervous system abnormalities including blood pressure instability and absent lacrimation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensory-neuropathy",
        "description": "Impaired pain and temperature sensation with preserved touch and vibration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Additional supportive features such as recurrent pneumonia, gastrointestinal dysmotility, and poor growth",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic IKBKAP mutation plus clinical evidence of autonomic dysfunction and sensory neuropathy",
    "notes": "Genetic testing is confirmatory; clinical diagnosis may be suspected based on characteristic symptoms and family history."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Absent fungiform papillae on the tongue",
        "frequency": 0.85,
        "bodySystem": "gastrointestinal",
        "notes": "Characteristic oral mucosal abnormality"
      },
      {
        "symptomName": "Absent or reduced tear production (alacrima)",
        "frequency": 0.9,
        "bodySystem": "ophthalmological",
        "notes": "Leads to dry eyes and corneal damage"
      },
      {
        "symptomName": "Impaired pain and temperature sensation",
        "frequency": 0.95,
        "bodySystem": "neurological",
        "notes": "Selective sensory neuropathy"
      }
    ],
    "common": [
      {
        "symptomName": "Orthostatic hypotension",
        "frequency": 0.75,
        "bodySystem": "cardiovascular",
        "notes": "Due to autonomic dysfunction"
      },
      {
        "symptomName": "Recurrent pneumonia",
        "frequency": 0.7,
        "bodySystem": "respiratory",
        "notes": "Secondary to aspiration and impaired cough reflex"
      },
      {
        "symptomName": "Gastrointestinal dysmotility",
        "frequency": 0.65,
        "bodySystem": "gastrointestinal",
        "notes": "Includes delayed gastric emptying and constipation"
      },
      {
        "symptomName": "Poor growth and failure to thrive",
        "frequency": 0.6,
        "bodySystem": "constitutional",
        "notes": "Common in infancy and childhood"
      },
      {
        "symptomName": "Reduced or absent deep tendon reflexes",
        "frequency": 0.55,
        "bodySystem": "neurological",
        "notes": "Reflects peripheral neuropathy"
      }
    ],
    "occasional": [
      {
        "symptomName": "Episodic hypertension",
        "frequency": 0.4,
        "bodySystem": "cardiovascular",
        "notes": "Paroxysmal blood pressure spikes"
      },
      {
        "symptomName": "Swallowing difficulties (dysphagia)",
        "frequency": 0.35,
        "bodySystem": "gastrointestinal",
        "notes": "Due to impaired autonomic control"
      },
      {
        "symptomName": "Scoliosis",
        "frequency": 0.3,
        "bodySystem": "musculoskeletal",
        "notes": "Secondary to muscle weakness and neuropathy"
      },
      {
        "symptomName": "Sleep apnea",
        "frequency": 0.25,
        "bodySystem": "respiratory",
        "notes": "Central and obstructive types reported"
      },
      {
        "symptomName": "Blunted or absent corneal reflex",
        "frequency": 0.2,
        "bodySystem": "ophthalmological",
        "notes": "Due to sensory nerve impairment"
      }
    ],
    "rare": [
      {
        "symptomName": "Renal tubular dysfunction",
        "frequency": 0.08,
        "bodySystem": "renal",
        "notes": "May cause electrolyte imbalances"
      },
      {
        "symptomName": "Cardiac arrhythmias",
        "frequency": 0.05,
        "bodySystem": "cardiovascular",
        "notes": "Due to autonomic nervous system involvement"
      },
      {
        "symptomName": "Psychiatric manifestations including anxiety and depression",
        "frequency": 0.04,
        "bodySystem": "psychiatric",
        "notes": "Secondary to chronic illness and neurological involvement"
      }
    ]
  },
  "systemsAffected": [
    "neurological",
