  "diagnosticCriteria": {
    "formalCriteriaName": "Newborn Screening and Clinical Diagnostic Criteria for Classic CAH",
    "criteria": [
      {
        "id": "elevated-17-ohp",
        "description": "Elevated serum 17-hydroxyprogesterone levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing-cyp21a2",
        "description": "Identification of pathogenic mutations in the CYP21A2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Clinical signs of adrenal insufficiency and/or virilization in neonates",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrolyte-abnormalities",
        "description": "Hyponatremia and hyperkalemia consistent with salt-wasting",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated 17-hydroxyprogesterone plus either pathogenic CYP21A2 mutations or clinical signs of adrenal insufficiency/virilization",
    "notes": "Newborn screening programs commonly detect elevated 17-OHP; confirmatory genetic testing is recommended."
  },
