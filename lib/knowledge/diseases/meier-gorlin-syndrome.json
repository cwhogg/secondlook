  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild anemia or immunological abnormalities in some cases"
    ],
    "imaging": [
      "Radiographs showing absent or hypoplastic patellae",
      "Delayed bone age on skeletal survey",
      "Possible cardiac ultrasound abnormalities if cardiac defects present"
    ],
    "genetic": [
      "KRT16 (causative)",
      "KRT17 (causative)",
      "KRT6A (causative)",
      "KRT6B (causative)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
