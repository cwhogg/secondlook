  "diagnosticCriteria": {
    "formalCriteriaName": "Galactosemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced or absent UDP-galactose-4-epimerase enzyme activity in erythrocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the GALE gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of clinical symptoms consistent with galactosemia such as feeding difficulties, hepatomegaly, or cataracts",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "galactosemia-screening",
        "description": "Positive newborn screening for elevated galactose or galactose-1-phosphate levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Reduced GALE enzyme activity and identification of pathogenic GALE gene variants",
    "notes": "Enzyme activity testing is essential to distinguish from other types of galactosemia."
  },
