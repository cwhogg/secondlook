  "keyFindings": {
    "laboratory": [
      "Elevated serum bile acids",
      "Normal or low gamma-glutamyl transferase (GGT)",
      "Elevated serum bilirubin (conjugated)",
      "Fat-soluble vitamin deficiencies"
    ],
    "imaging": [
      "Ultrasound showing hepatomegaly without biliary obstruction",
      "Liver elastography indicating fibrosis",
      "MRI/MRCP to exclude extrahepatic biliary obstruction"
    ],
    "genetic": [
      "Pathogenic mutations in ATP8B1 (PFIC1)",
      "Pathogenic mutations in ABCB11 (PFIC2)",
      "Pathogenic mutations in ABCB4 (PFIC3)",
      "Autosomal recessive inheritance"
    ],
