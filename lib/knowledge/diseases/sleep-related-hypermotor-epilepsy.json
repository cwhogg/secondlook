  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Criteria for Sleep-related Hypermotor Epilepsy Diagnosis",
    "criteria": [
      {
        "id": "nocturnal-hypermotor-seizures",
        "description": "Presence of stereotyped, hypermotor seizures predominantly occurring during sleep",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ictal-video-eeg-correlation",
        "description": "Video-EEG demonstrating ictal or interictal epileptiform discharges correlating with clinical events",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-disorders",
        "description": "Exclusion of non-epileptic sleep disorders and other epilepsy syndromes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of sleep-related hypermotor epilepsy or related epilepsy syndromes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-antiepileptic-drugs",
        "description": "Clinical improvement with antiepileptic drug therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of stereotyped nocturnal hypermotor seizures with supportive video-EEG evidence and exclusion of other disorders",
    "notes": "Diagnosis often requires prolonged video-EEG monitoring during sleep."
  },
