  "keyFindings": {
    "laboratory": [
      "Elevated plasma free metanephrines (sensitivity >97%)",
      "Elevated 24-hour urinary fractionated metanephrines and catecholamines",
      "Elevated plasma or urinary normetanephrine (norepinephrine-secreting) or metanephrine (epinephrine-secreting)",
      "Chromogranin A elevation (nonspecific marker)",
      "Hyperglycemia or impaired glucose tolerance"
    ],
    "imaging": [
      "CT abdomen with contrast showing adrenal mass (typically >3 cm, heterogeneous, >10 HU)",
      "MRI showing characteristic T2 hyperintensity ('light bulb sign')",
      "123I-MIBG scintigraphy for functional localization",
      "68Ga-DOTATATE PET/CT (superior sensitivity for metastatic disease)",
      "18F-FDG PET/CT for SDH-related or metastatic pheochromocytoma"
    ],
    "genetic": [
      "SLC25A11 (causative)",
      "KIF1B (causative, loss-of-function)",
      "MDH2 (causative)",
      "DLST (causative)",
      "RET (candidate)",
      "SDHA (causative)",
      "SDHC (causative)",
      "SDHD (causative)",
      "FH (causative, loss-of-function)",
      "SDHB (causative)",
      "TMEM127 (candidate)",
      "MAX (causative)",
      "NF1 (causative)",
      "VHL (causative)",
      "SDHAF2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Clonidine suppression test if biochemical results equivocal",
      "Histopathology: Zellballen pattern, positive chromogranin and synaptophysin staining",
      "PASS (Pheochromocytoma of the Adrenal Gland Scaled Score) for malignancy risk assessment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "essential-hypertension",
      "distinguishingFeatures": [
        "Essential hypertension lacks paroxysmal symptoms",
        "No biochemical catecholamine excess",
        "No adrenal mass on imaging"
      ]
    },
    {
      "diseaseId": "carcinoid-syndrome",
      "distinguishingFeatures": [
        "Carcinoid features flushing rather than pallor",
        "Carcinoid has elevated 5-HIAA",
        "Carcinoid rarely causes severe hypertension"
      ]
    },
    {
      "diseaseId": "anxiety-disorder",
      "distinguishingFeatures": [
        "Anxiety disorder lacks sustained hypertension",
        "Normal catecholamine and metanephrine levels",
        "No adrenal mass"
      ]
    },
    {
      "diseaseId": "thyrotoxicosis",
      "distinguishingFeatures": [
        "Thyrotoxicosis has suppressed TSH and elevated free T4",
        "Thyrotoxicosis features weight loss with increased appetite",
        "Heat intolerance more prominent in thyrotoxicosis"
      ]
    }
  ],
  "redFlags": [
    "Hypertensive crisis during surgery or anesthesia (undiagnosed pheochromocytoma)",
    "Paradoxical hypertensive response to beta-blockers (unopposed alpha stimulation)",
    "SDHB mutation carrier (high risk of malignant disease)",
    "Large tumor (>5 cm) or extra-adrenal location (higher malignancy risk)",
    "Catecholamine-induced cardiomyopathy or pulmonary edema",
    "Family history of MEN2, VHL, NF1, or hereditary paraganglioma syndromes"
  ],
