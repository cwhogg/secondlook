      "Mild elevation of liver transaminases",
      "Mild normocytic anemia"
    ],
    "imaging": [
      "Hepatomegaly and occasional splenomegaly on abdominal ultrasound",
      "Normal brain MRI in most cases"
    ],
    "genetic": [
      "GNE (causative)",
      "Pathogenic mutations in the GNE gene (autosomal dominant inheritance)"
    ],
    "other": [
      "Normal or mildly delayed developmental milestones",
      "Absence of lysosomal storage on biopsy"
    ]
  },
