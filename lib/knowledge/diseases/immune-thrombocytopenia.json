  "diagnosticCriteria": {
    "formalCriteriaName": "American Society of Hematology Diagnostic Criteria for ITP",
    "criteria": [
      {
        "id": "isolated-thrombocytopenia",
        "description": "Isolated thrombocytopenia with platelet count <100 x 10^9/L",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of thrombocytopenia such as bone marrow disorders, infections, or drug-induced thrombocytopenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-bone-marrow",
        "description": "Bone marrow examination showing normal or increased megakaryocytes without dysplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "presence-of-antiplatelet-antibodies",
        "description": "Detection of platelet autoantibodies (supportive but not mandatory)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent isolated thrombocytopenia <100 x 10^9/L with exclusion of other causes",
    "notes": "Diagnosis is primarily clinical and by exclusion; bone marrow biopsy is not always required."
  },
