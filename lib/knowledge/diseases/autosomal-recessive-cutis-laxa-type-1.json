  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Autosomal Recessive Cutis Laxa Type 1",
    "criteria": [
      {
        "id": "skin-looseness",
        "description": "Generalized loose, inelastic, and wrinkled skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "arterial-tortuosity",
        "description": "Presence of arterial tortuosity and aneurysms on vascular imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-emphysema",
        "description": "Early-onset pulmonary emphysema detected clinically or radiologically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the FBLN4 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or affected siblings consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized cutis laxa with arterial tortuosity or aneurysms and pulmonary emphysema, supported by genetic testing if available",
    "notes": "Diagnosis is primarily clinical but confirmed by molecular genetic testing of FBLN4 mutations."
  },
