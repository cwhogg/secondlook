    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Tethered Cord Syndrome",
    "criteria": [
      {
        "id": "clinical-symptoms",
        "description": "Presence of progressive neurological symptoms consistent with spinal cord tethering such as lower limb weakness, sensory deficits, or bladder dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "MRI evidence of a low-lying conus medullaris below the L2 vertebral level or thickened filum terminale",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiological-studies",
        "description": "Abnormal somatosensory evoked potentials or urodynamic studies supporting neurological impairment",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive neurological symptoms plus confirmatory MRI findings of tethered cord",
    "notes": "Diagnosis is clinical supported by imaging; electrophysiological studies are adjunctive."
  },
