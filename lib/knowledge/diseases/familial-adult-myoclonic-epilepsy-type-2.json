  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Familial Adult Myoclonic Epilepsy",
    "criteria": [
      {
        "id": "family-history",
        "description": "Presence of autosomal dominant family history of adult-onset myoclonic epilepsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-myoclonus",
        "description": "Adult-onset cortical myoclonic jerks predominantly affecting upper limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "generalized-seizures",
        "description": "Occurrence of generalized tonic-clonic seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eeg-findings",
        "description": "EEG showing generalized spike-wave or polyspike-wave discharges",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic repeat expansions in the STARD7 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of autosomal dominant family history plus adult-onset myoclonic jerks and generalized seizures",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory."
  },
