  "keyFindings": {
    "laboratory": [
      "Elevated blood phenylalanine levels",
      "Abnormal CSF pterin profile with decreased biopterin and increased neopterin",
      "Low CSF neurotransmitter metabolites (dopamine and serotonin metabolites)"
    ],
    "imaging": [
      "Brain MRI may show nonspecific cerebral atrophy or delayed myelination"
    ],
    "genetic": [
      "PTS (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Reduced 6-pyruvoyl-tetrahydropterin synthase enzyme activity in cultured fibroblasts or leukocytes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dihydropteridine-reductase-deficiency",
      "distinguishingFeatures": [
        "Deficiency of dihydropteridine reductase enzyme",
        "Different CSF pterin profile with normal or elevated biopterin",
        "More severe neurological deterioration without treatment"
      ]
    },
    {
      "diseaseId": "phenylketonuria",
      "distinguishingFeatures": [
        "Isolated hyperphenylalaninemia without neurotransmitter deficiency",
        "Normal CSF pterin profile",
        "Responds well to dietary phenylalanine restriction alone"
      ]
    }
  ],
