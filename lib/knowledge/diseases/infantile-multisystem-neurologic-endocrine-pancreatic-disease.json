  "keyFindings": {
    "laboratory": [
      "Low serum cortisol and aldosterone levels",
      "Elevated fecal fat indicating pancreatic exocrine insufficiency",
      "Hypoglycemia on fasting glucose testing",
      "Mild anemia on complete blood count"
    ],
    "imaging": [
      "Brain MRI showing cerebral atrophy and delayed myelination",
      "Abdominal ultrasound may show pancreatic hypoplasia or atrophy"
    ],
    "genetic": [
      "PTRH2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Abnormal sweat chloride test to exclude cystic fibrosis",
      "Electroencephalogram (EEG) may show nonspecific slowing"
    ]
  },
