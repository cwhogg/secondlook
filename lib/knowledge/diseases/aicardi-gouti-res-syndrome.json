  "keyFindings": {
    "laboratory": [
      "Elevated interferon-alpha levels in cerebrospinal fluid",
      "Chronic lymphocytosis in CSF",
      "Mild anemia and thrombocytopenia in some cases"
    ],
    "imaging": [
      "Intracranial calcifications predominantly in basal ganglia and white matter on CT",
      "Progressive leukodystrophy with white matter abnormalities on MRI",
      "Cerebral atrophy and ventricular enlargement on neuroimaging"
    ],
    "genetic": [
      "LSM11 (causative)",
      "RNU7-1 (causative)",
      "SAMHD1 (causative)",
      "RNASEH2A (causative)",
      "RNASEH2B (causative)",
      "RNASEH2C (causative)",
      "ADAR (causative)",
      "TREX1 (causative)",
      "IFIH1 (causative, gain-of-function)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Elevated interferon-stimulated gene expression signature in peripheral blood",
      "Chronic systemic inflammation markers"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-infections",
      "distinguishingFeatures": [
        "History of maternal infection",
        "Positive TORCH serologies",
        "Calcifications more diffuse and cortical"
      ]
    },
    {
      "diseaseId": "pseudo-tay-sachs-disease",
      "distinguishingFeatures": [
        "Lack of CSF lymphocytosis",
        "Different genetic mutations",
        "Absence of interferon signature"
      ]
    },
    {
      "diseaseId": "chilblain-lupus",
      "distinguishingFeatures": [
        "Autoimmune serologies positive",
        "Skin lesions predominate without neurological involvement",
        "Later onset"
      ]
    }
  ],
