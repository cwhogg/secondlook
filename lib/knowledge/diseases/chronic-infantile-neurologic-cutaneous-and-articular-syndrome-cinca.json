  "diagnosticCriteria": {
    "formalCriteriaName": "NOMID/CINCA Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-urticarial-rash",
        "description": "Persistent, non-pruritic urticarial rash starting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "arthropathy",
        "description": "Chronic, deforming arthritis with joint swelling and bony overgrowth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "central-nervous-system-involvement",
        "description": "Neurological manifestations including chronic aseptic meningitis, papilledema, and sensorineural hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-inflammatory-markers",
        "description": "Elevated acute phase reactants such as ESR and CRP",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nlrp3-gene-mutation",
        "description": "Identification of pathogenic mutation in NLRP3 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: chronic urticarial rash, arthropathy, and CNS involvement",
    "notes": "Genetic testing for NLRP3 mutations supports diagnosis but is not mandatory"
  },
