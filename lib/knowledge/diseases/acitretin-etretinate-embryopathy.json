  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Retinoid Embryopathy",
    "criteria": [
      {
        "id": "prenatal-exposure",
        "description": "Confirmed maternal exposure to acitretin or etretinate during pregnancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-malformations",
        "description": "Presence of characteristic craniofacial anomalies including microtia, low-set ears, and cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-defects",
        "description": "Presence of limb abnormalities such as limb hypoplasia, syndactyly, or camptodactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-anomalies",
        "description": "Detection of congenital heart defects such as ventricular septal defects",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Intrauterine growth retardation or postnatal growth deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed prenatal exposure plus presence of at least two major criteria",
    "notes": "Diagnosis is clinical and based on history of maternal retinoid exposure combined with characteristic malformations."
  },
