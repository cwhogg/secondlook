  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Langer Mesomelic Dysplasia",
    "criteria": [
      {
        "id": "mesomelic-shortening",
        "description": "Severe mesomelic shortening of the forearms and lower legs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-bowing",
        "description": "Radiological evidence of bowed and shortened radius and ulna, and tibia and fibula",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic mutations in SHOX or SHOX regulatory elements confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development without neurological impairment",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe mesomelic limb shortening with characteristic radiological findings plus confirmation of biallelic SHOX gene mutations",
    "notes": "Diagnosis is primarily clinical and radiological, supported by genetic testing."
  },
