  "diagnosticCriteria": {
    "formalCriteriaName": "Malignant Peritoneal Mesothelioma Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histopathological confirmation of malignant mesothelial cells in peritoneal biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Radiological evidence of diffuse peritoneal thickening or masses on CT or MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Positive immunohistochemical staining for mesothelial markers (e.g., calretinin, WT-1, cytokeratin 5/6)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-cancers",
        "description": "Exclusion of metastatic carcinoma or other primary peritoneal malignancies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation with positive immunohistochemistry and compatible imaging findings",
    "notes": "Diagnosis requires multidisciplinary evaluation including pathology, radiology, and clinical correlation."
  },
