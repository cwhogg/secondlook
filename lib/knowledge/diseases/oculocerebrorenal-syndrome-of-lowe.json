  "keyFindings": {
    "laboratory": [
      "Elevated urinary amino acids, glucose, phosphate, and bicarbonate indicating proximal tubular dysfunction",
      "Metabolic acidosis with normal anion gap",
      "Hypophosphatemia and hypokalemia"
    ],
    "imaging": [
      "Brain MRI may show cerebral atrophy",
      "Renal ultrasound may show nephrocalcinosis",
      "Ophthalmologic exam reveals cataracts and glaucoma"
    ],
    "genetic": [
      "OCRL (causative, loss-of-function)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Reduced OCRL enzyme activity in cultured fibroblasts or leukocytes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "fanconi-syndrome",
      "distinguishingFeatures": [
        "Fanconi syndrome without ocular or neurological involvement",
        "No OCRL gene mutation"
      ]
    },
    {
      "diseaseId": "dent-disease",
      "distinguishingFeatures": [
        "X-linked renal tubular disorder with proteinuria and nephrolithiasis",
        "Absence of congenital cataracts and intellectual disability"
      ]
    },
    {
      "diseaseId": "congenital-cataracts-with-intellectual-disability",
      "distinguishingFeatures": [
        "Presence of cataracts and intellectual disability but no renal tubular dysfunction",
        "Different genetic etiology"
      ]
    }
  ],
  "redFlags": [
    "Congenital bilateral cataracts in a male infant",
    "Early onset proximal renal tubular acidosis with polyuria and failure to thrive",
    "Severe intellectual disability with hypotonia and delayed milestones"
  ],
