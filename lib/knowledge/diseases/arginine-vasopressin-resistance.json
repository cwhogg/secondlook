  "diagnosticCriteria": {
    "formalCriteriaName": "Nephrogenic Diabetes Insipidus Diagnostic Criteria",
    "criteria": [
      {
        "id": "polyuria-polydipsia",
        "description": "Persistent polyuria and polydipsia despite normal or elevated plasma osmolality",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vasopressin-resistance",
        "description": "Lack of response to exogenous arginine vasopressin administration demonstrated by continued dilute urine output",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypernatremia",
        "description": "Elevated serum sodium concentration due to free water loss",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked or autosomal inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent polyuria and polydipsia with documented resistance to exogenous vasopressin",
    "notes": "Diagnosis is supported by genetic testing identifying mutations in AVPR2 or AQP2 genes."
  },
