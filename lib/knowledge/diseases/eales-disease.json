  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnosis of Eales disease",
    "criteria": [
      {
        "id": "retinal-periphlebitis",
        "description": "Idiopathic inflammation of peripheral retinal veins (periphlebitis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peripheral-retinal-ischemia",
        "description": "Evidence of peripheral retinal capillary non-perfusion and ischemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neovascularization",
        "description": "Presence of retinal neovascularization secondary to ischemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-vasculitis",
        "description": "Exclusion of other systemic or infectious causes of retinal vasculitis",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-vitreal-hemorrhage",
        "description": "History or presence of recurrent vitreous hemorrhages",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of idiopathic peripheral retinal periphlebitis with ischemia and neovascularization after exclusion of other causes",
    "notes": "Diagnosis is clinical and by exclusion; ancillary testing supports but does not confirm diagnosis"
  },
