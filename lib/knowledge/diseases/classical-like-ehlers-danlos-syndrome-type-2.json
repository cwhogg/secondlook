  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Platelet function tests may show mild abnormalities"
    ],
    "imaging": [
      "Echocardiography may reveal mitral valve prolapse or aortic root dilation",
      "MRI or ultrasound for joint and soft tissue evaluation"
    ],
    "genetic": [
      "AEBP1 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy showing reduced tenascin-X protein",
      "Beighton score used to assess joint hypermobility"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "classical-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Autosomal dominant inheritance",
        "COL5A1 or COL5A2 mutations",
        "More pronounced skin fragility and atrophic scarring"
      ]
    },
    {
      "diseaseId": "hypermobility-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Generalized joint hypermobility without significant skin involvement",
        "Absence of atrophic scars",
        "No identified causative gene"
      ]
    }
  ],
  "redFlags": [
    "Spontaneous arterial rupture or aneurysm",
    "Severe joint instability causing recurrent dislocations",
    "Progressive aortic root dilation"
  ],
  "specialistType": [
    "Clinical geneticist",
    "Rheumatologist",
    "Cardiologist",
    "Dermatologist"
  ],
