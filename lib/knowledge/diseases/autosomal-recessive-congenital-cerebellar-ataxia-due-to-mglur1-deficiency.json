  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for MGLUR1-Related Congenital Cerebellar Ataxia",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Presence of congenital onset cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the GRM1 gene encoding mGluR1",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI evidence of cerebellar hypoplasia or atrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-ataxias",
        "description": "Exclusion of other known causes of congenital ataxia by clinical and laboratory evaluation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital cerebellar ataxia, biallelic pathogenic GRM1 variants, and supportive neuroimaging findings",
    "notes": "Genetic testing is essential for definitive diagnosis; neuroimaging supports but is not solely diagnostic."
  },
