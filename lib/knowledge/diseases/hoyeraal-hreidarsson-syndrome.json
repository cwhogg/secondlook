  "keyFindings": {
    "laboratory": [
      "Severe lymphopenia and neutropenia",
      "Pancytopenia on complete blood count",
      "Shortened telomere length by flow-FISH or qPCR"
    ],
    "imaging": [
      "MRI showing cerebellar hypoplasia",
      "CT brain may show cerebral calcifications",
      "Chest imaging may reveal pulmonary fibrosis"
    ],
    "genetic": [
      "Mutations in DKC1, TINF2, RTEL1, or other telomere maintenance genes"
    ],
    "other": [
      "Bone marrow biopsy showing hypocellularity",
      "Skin biopsy consistent with dyskeratosis congenita"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dyskeratosis-congenita",
      "distinguishingFeatures": [
        "Less severe neurological involvement",
        "Later onset of symptoms",
        "Absence of cerebellar hypoplasia"
      ]
    },
    {
      "diseaseId": "fanconi-anemia",
      "distinguishingFeatures": [
        "Chromosomal breakage on diepoxybutane test",
        "Radial ray defects",
        "No cerebellar hypoplasia"
      ]
    },
    {
      "diseaseId": "severe-combined-immunodeficiency",
      "distinguishingFeatures": [
        "Immunodeficiency without mucocutaneous features",
        "No cerebellar hypoplasia",
        "Normal telomere length"
      ]
    }
  ],
