  "diagnosticCriteria": {
    "formalCriteriaName": "Hyperkeratosis-Hyperpigmentation Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "diffuse-hyperkeratosis",
        "description": "Presence of diffuse hyperkeratosis predominantly on palms and soles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "reticulated-hyperpigmentation",
        "description": "Reticulated hyperpigmentation involving trunk and extremities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nail-dystrophy",
        "description": "Nail dystrophy including thickening and discoloration",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "mucosal-involvement",
        "description": "Mucosal leukokeratosis or pigmentation abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (diffuse hyperkeratosis and reticulated hyperpigmentation) with or without minor criteria",
    "notes": "Diagnosis is clinical; genetic testing may support but is not definitive."
  },
