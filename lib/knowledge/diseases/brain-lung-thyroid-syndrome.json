  "diagnosticCriteria": {
    "formalCriteriaName": "Brain-Lung-Thyroid Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "neurological-dysfunction",
        "description": "Presence of neurological abnormalities including developmental delay and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-hypoplasia",
        "description": "Evidence of lung hypoplasia or chronic respiratory insufficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thyroid-dysgenesis",
        "description": "Congenital hypothyroidism due to thyroid dysgenesis or agenesis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "TTF1-NKX2-1-mutation",
        "description": "Identification of pathogenic variants in the NKX2-1 gene (also known as TTF1)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: neurological dysfunction, pulmonary hypoplasia, and thyroid dysgenesis",
    "notes": "Genetic testing for NKX2-1 mutations strongly supports diagnosis but is not mandatory."
  },
