  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP during attacks",
      "Leukocytosis with neutrophilia",
      "Elevated serum amyloid A (SAA) protein"
    ],
    "imaging": [
      "MRI or ultrasound may show fasciitis or myositis",
      "Echocardiography for pericarditis evaluation"
    ],
    "genetic": [
      "Pathogenic mutations in TNFRSF1A gene",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology of rash shows perivascular infiltrates",
      "Amyloid deposits in biopsy if amyloidosis develops"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "familial-mediterranean-fever",
      "distinguishingFeatures": [
        "Shorter febrile episodes (1-3 days)",
        "Serositis more common",
        "MEFV gene mutations"
      ]
    },
    {
      "diseaseId": "hyperimmunoglobulinemia-d-syndrome",
      "distinguishingFeatures": [
        "Elevated IgD levels",
        "Shorter fever episodes",
        "Mevalonate kinase gene mutations"
      ]
    },
    {
      "diseaseId": "cryopyrin-associated-periodic-syndrome",
      "distinguishingFeatures": [
        "Urticarial rash rather than migratory erythema",
        "NLRP3 gene mutations",
        "Neurological involvement more prominent"
      ]
    }
  ],
  "redFlags": [
    "Prolonged febrile episodes unresponsive to antibiotics",
    "Development of amyloidosis with renal failure",
    "Severe periorbital edema causing visual impairment"
  ],
  "specialistType": [
