  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Paroxysmal Nonkinesigenic Dyskinesia",
    "criteria": [
      {
        "id": "episodic-involuntary-movements",
        "description": "Recurrent episodes of involuntary dystonia, chorea, or athetosis lasting minutes to hours",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nonkinesigenic-trigger",
        "description": "Episodes not triggered by sudden voluntary movement but may be precipitated by stress, alcohol, caffeine, or fatigue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-interictal-exam",
        "description": "Neurological examination is normal between episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of similar episodes supports diagnosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of secondary causes such as metabolic, structural, or epileptic disorders",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent spontaneous episodes of involuntary movements not triggered by sudden movement, normal neurological exam between episodes, and exclusion of secondary causes",
    "notes": "Genetic testing for mutations in the PNKD gene can support diagnosis but is not mandatory"
  },
