  "diagnosticCriteria": {
    "formalCriteriaName": "Wagner Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "vitreoretinal-degeneration",
        "description": "Progressive vitreoretinal degeneration with optically empty vitreous and avascular vitreous strands",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "retinal-detachment",
        "description": "History or presence of retinal detachment or breaks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-cataract",
        "description": "Early onset cataract formation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the VCAN gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of vitreoretinal degeneration with at least one other major criterion (retinal detachment or positive family history)",
    "notes": "Genetic testing for VCAN mutations can confirm diagnosis but is not mandatory."
  },
