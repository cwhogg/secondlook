        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oromotor-dysfunction",
        "description": "Presence of oromotor dysfunction including dysarthria and dysphagia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epilepsy",
        "description": "Clinical history of epilepsy or seizure disorders",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Variable degrees of cognitive and developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "pseudobulbar-palsy",
        "description": "Signs of pseudobulbar palsy such as emotional lability and spasticity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "MRI confirmation of bilateral perisylvian polymicrogyria plus at least two clinical features including oromotor dysfunction and epilepsy",
    "notes": "Diagnosis relies heavily on neuroimaging combined with clinical presentation; genetic testing may support but is not diagnostic."
