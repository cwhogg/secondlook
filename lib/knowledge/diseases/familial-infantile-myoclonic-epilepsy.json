  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Familial Infantile Myoclonic Epilepsy",
    "criteria": [
      {
        "id": "myoclonic-seizures",
        "description": "Presence of myoclonic seizures beginning in infancy, typically between 3 and 12 months of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "familial-history",
        "description": "Positive family history of infantile myoclonic epilepsy or related epileptic syndromes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-development",
        "description": "Normal psychomotor development prior to seizure onset",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electroencephalogram-findings",
        "description": "EEG showing generalized or multifocal spike-and-wave discharges correlating with myoclonic seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-causes",
        "description": "Exclusion of other metabolic, structural, or infectious causes of infantile seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of myoclonic seizures in infancy with a positive family history and characteristic EEG findings",
    "notes": "Genetic testing may support diagnosis but is not always definitive due to heterogeneity."
  },
