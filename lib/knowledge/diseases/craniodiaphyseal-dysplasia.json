  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Craniodiaphyseal Dysplasia",
    "criteria": [
      {
        "id": "craniofacial-hyperostosis",
        "description": "Severe hyperostosis and sclerosis of craniofacial bones leading to characteristic facial deformities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "diaphyseal-sclerosis",
        "description": "Sclerosis and thickening of diaphyses of long bones evident on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cranial-nerve-compression",
        "description": "Clinical or radiological evidence of cranial nerve compression due to bone overgrowth",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniofacial hyperostosis and diaphyseal sclerosis on imaging with compatible clinical features",
    "notes": "Genetic testing may support diagnosis but is not definitive; diagnosis primarily clinical and radiological"
  },
