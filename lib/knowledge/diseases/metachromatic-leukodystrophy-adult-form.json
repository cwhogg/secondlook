  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Metachromatic Leukodystrophy",
    "criteria": [
      {
        "id": "arylsulfatase-a-deficiency",
        "description": "Demonstration of deficient arylsulfatase A enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of progressive neurological symptoms including cognitive decline and motor dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mri-leukodystrophy",
        "description": "Characteristic symmetric demyelination on brain MRI with periventricular white matter involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the ARSA gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient arylsulfatase A enzyme activity plus clinical features and supportive MRI findings",
    "notes": "Pseudodeficiency alleles must be excluded to confirm diagnosis."
  },
