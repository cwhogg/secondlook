        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "right-atrial-and-ventricular-enlargement",
        "description": "Right atrial and right ventricular enlargement on imaging consistent with volume overload",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of an interatrial septal defect visualized by echocardiography with evidence of left-to-right shunting",
    "notes": "Cardiac MRI or transesophageal echocardiography may be used for further anatomical delineation if transthoracic echocardiography is inconclusive."
  },
