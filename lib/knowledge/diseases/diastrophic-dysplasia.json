  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiographic Diagnostic Criteria for Diastrophic Dysplasia",
    "criteria": [
      {
        "id": "limb-shortening",
        "description": "Shortening of long bones with rhizomelic and mesomelic limb shortening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-contractures",
        "description": "Multiple joint contractures including clubfoot and limited joint mobility",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ear-deformities",
        "description": "Characteristic cauliflower ear deformities due to cartilage abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-changes",
        "description": "Radiographic evidence of spinal deformities, iliac hypoplasia, and metaphyseal abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in SLC26A2 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of limb shortening, joint contractures, and ear deformities with supportive radiographic or genetic confirmation",
    "notes": "Genetic testing is confirmatory but diagnosis can be made clinically with characteristic features and radiographs."
  },
