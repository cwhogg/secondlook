  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Distal 10q Deletion Syndrome",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of a terminal or interstitial deletion involving the distal long arm of chromosome 10 (10q26) confirmed by chromosomal microarray or karyotyping",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including microcephaly, hypertelorism, and downslanting palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or genitourinary malformations",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 10q distal deletion plus presence of at least two major clinical features including characteristic craniofacial dysmorphism and developmental delay",
    "notes": "Diagnosis relies heavily on molecular cytogenetic testing due to phenotypic variability."
  },
