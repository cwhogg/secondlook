  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for Gitelman Syndrome",
    "criteria": [
      {
        "id": "hypokalemia",
        "description": "Persistent hypokalemia with renal potassium wasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypomagnesemia",
        "description": "Hypomagnesemia with inappropriate renal magnesium loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-alkalosis",
        "description": "Metabolic alkalosis without hypertension",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in SLC12A3 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-calcium-excretion",
        "description": "Normal or low urinary calcium excretion differentiating from Bartter syndrome",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent hypokalemia, hypomagnesemia, and metabolic alkalosis with either genetic confirmation or supportive biochemical findings",
    "notes": "Genetic testing is confirmatory but not always required if clinical and biochemical criteria are met."
  },
