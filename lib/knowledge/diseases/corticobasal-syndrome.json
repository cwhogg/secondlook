  "keyFindings": {
    "laboratory": [
      "Routine labs typically normal; used to exclude other causes"
    ],
    "imaging": [
      "Asymmetric cortical atrophy on MRI, especially parietal and frontal lobes",
      "Hypometabolism on FDG-PET in affected cortical regions"
    ],
    "genetic": [
      "No consistent genetic mutation; some cases linked to MAPT mutations"
    ],
    "other": [
      "Definitive diagnosis requires neuropathological confirmation showing tau pathology"
    ]
  },
