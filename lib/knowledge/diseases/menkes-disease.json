        "description": "Identification of pathogenic ATP7A gene mutation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-findings",
        "description": "Brain MRI showing cerebral and cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical presentation plus low serum copper and ceruloplasmin or identification of ATP7A mutation",
    "notes": "Genetic testing is confirmatory; early diagnosis critical for treatment initiation"
