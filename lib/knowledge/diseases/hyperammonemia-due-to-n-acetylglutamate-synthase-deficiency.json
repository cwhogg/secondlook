  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for NAGS deficiency-associated hyperammonemia",
    "criteria": [
      {
        "id": "elevated-ammonia",
        "description": "Marked hyperammonemia in plasma during acute metabolic crisis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-or-nil-nags-activity",
        "description": "Deficient or absent N-acetylglutamate synthase enzyme activity in liver or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the NAGS gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-carbamylglutamate",
        "description": "Clinical and biochemical improvement following administration of carbamylglutamate",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hyperammonemia with either deficient NAGS enzyme activity or pathogenic NAGS gene variants",
    "notes": "Diagnosis is supported by rapid response to carbamylglutamate treatment."
  },
