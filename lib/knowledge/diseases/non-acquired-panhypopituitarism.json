  "keyFindings": {
    "laboratory": [
      "Low serum IGF-1 and IGFBP-3 indicating growth hormone deficiency",
      "Low free T4 with low or inappropriately normal TSH",
      "Low morning cortisol with low ACTH",
      "Low LH and FSH with low sex steroids",
      "Hyponatremia and hypoglycemia in some cases"
    ],
    "imaging": [
      "MRI showing hypoplastic or absent anterior pituitary gland",
      "Absent or thin pituitary stalk",
      "Ectopic posterior pituitary bright spot"
    ],
    "genetic": [
      "SOX3 (causative, loss-of-function)",
      "PROP1 (causative)",
      "Autosomal recessive inheritance",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Delayed bone age on hand/wrist X-rays",
      "Absence of secondary sexual characteristics in adolescents"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sheehan-syndrome",
      "distinguishingFeatures": [
        "History of postpartum hemorrhage",
        "Acquired rather than congenital onset",
        "MRI shows empty sella or pituitary necrosis"
      ]
    },
    {
      "diseaseId": "pituitary-adenoma-with-hypopituitarism",
      "distinguishingFeatures": [
        "Presence of pituitary mass lesion on MRI",
        "Possible hormone hypersecretion symptoms",
        "Usually acquired in adulthood"
      ]
    }
  ],
