  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnosis of Scorpion Envenomation",
    "criteria": [
      {
        "id": "history-of-scorpion-sting",
        "description": "History of recent scorpion sting or exposure in endemic area",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "localized-pain-and-erythema",
        "description": "Localized intense pain, erythema, and swelling at sting site",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "systemic-toxicity-signs",
        "description": "Presence of systemic signs such as autonomic storm, neuromuscular symptoms, or cardiovascular instability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "laboratory-confirmation",
        "description": "Supportive laboratory findings such as leukocytosis or elevated creatine kinase",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "History of scorpion sting plus presence of localized symptoms and at least one systemic toxicity sign",
    "notes": "Diagnosis is primarily clinical; laboratory and imaging studies support severity assessment."
  },
