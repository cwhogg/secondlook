        "Different facial dysmorphic features"
      ]
    },
    {
      "diseaseId": "miller-dieker-syndrome",
      "distinguishingFeatures": [
        "Lissencephaly on brain imaging",
        "Severe microcephaly with distinct facial features",
        "Deletion on chromosome 17p13.3 but not ring chromosome"
      ]
    }
  ],
