  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Spondylometaphyseal Dysplasia, Kozlowski Type",
    "criteria": [
      {
        "id": "radiological-spinal-abnormalities",
        "description": "Radiographic evidence of platyspondyly with anterior vertebral beaking",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metaphyseal-irregularities",
        "description": "Irregular and flared metaphyses of long bones on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-short-trunk-dwarfism",
        "description": "Clinical presentation of disproportionate short-trunk dwarfism with normal intelligence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the TRPV4 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-extra-skeletal-features",
        "description": "Lack of significant extraskeletal manifestations such as neurological deficits",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical disproportionate short-trunk dwarfism plus radiological evidence of platyspondyly with metaphyseal irregularities",
    "notes": "Genetic testing for TRPV4 mutations can support diagnosis but is not mandatory"
  },
