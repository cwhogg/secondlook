{
  "id": "legius-syndrome",
  "name": "Legius Syndrome",
  "aliases": [
    "SPRED1-related RASopathy",
    "Neurofibromatosis type 1-like syndrome"
  ],
  "icd10Codes": [
    "Q87.89"
  ],
  "omimId": "611431",
  "orphanetId": "1983",
  "prevalence": {
    "estimate": "1 in 20,000 to 1 in 50,000",
    "range": "0.002% - 0.005%",
    "classification": "rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 50,
      "peak": 5
    },
    "sexPredilection": "equal",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Legius Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cafe-au-lait-spots",
        "description": "Presence of multiple café-au-lait macules (≥6, each >5 mm in prepubertal individuals or >15 mm in postpubertal individuals)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-neurofibromas",
        "description": "Absence of neurofibromas and other NF1-associated tumors",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "SPRED1-mutation",
        "description": "Identification of pathogenic SPRED1 gene mutation by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "freckling",
        "description": "Axillary or inguinal freckling",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "macrocephaly",
        "description": "Macrocephaly (head circumference >97th percentile)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple café-au-lait spots without neurofibromas plus identification of a pathogenic SPRED1 mutation",
    "notes": "Diagnosis is primarily clinical supported by genetic testing; absence of tumors differentiates from NF1"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Multiple café-au-lait macules",
        "frequency": 0.95,
        "bodySystem": "dermatological",
        "notes": "Typically ≥6 macules, size varies with age"
      },
      {
        "symptomName": "Axillary and/or inguinal freckling",
        "frequency": 0.75,
        "bodySystem": "dermatological",
        "notes": "Intertriginous freckling similar to NF1 but less extensive"
      }
    ],
    "common": [
      {
        "symptomName": "Macrocephaly",
        "frequency": 0.65,
        "bodySystem": "constitutional",
        "notes": "Head circumference >97th percentile"
      },
      {
        "symptomName": "Learning difficulties",
        "frequency": 0.6,
        "bodySystem": "neurological",
        "notes": "Mild cognitive impairment or attention deficits"
      },
      {
        "symptomName": "No neurofibromas or plexiform neurofibromas",
        "frequency": 0.85,
        "bodySystem": "dermatological",
        "notes": "Distinguishes from NF1"
      },
      {
        "symptomName": "Mild facial dysmorphism",
        "frequency": 0.55,
        "bodySystem": "constitutional",
        "notes": "Includes hypertelorism and broad nasal bridge"
      }
    ],
    "occasional": [
      {
        "symptomName": "Lipomas",
        "frequency": 0.3,
        "bodySystem": "dermatological",
        "notes": "Benign fatty tumors occasionally reported"
      },
      {
        "symptomName": "Attention deficit hyperactivity disorder (ADHD)",
        "frequency": 0.25,
        "bodySystem": "psychiatric",
        "notes": "Behavioral issues reported in some patients"
      },
      {
        "symptomName": "Seizures",
        "frequency": 0.15,
        "bodySystem": "neurological",
        "notes": "Rare but documented in some cases"
      },
      {
        "symptomName": "Short stature",
        "frequency": 0.2,
        "bodySystem": "constitutional",
        "notes": "Less common growth abnormalities"
      }
    ],
    "rare": [
      {
        "symptomName": "Vascular anomalies",
        "frequency": 0.05,
        "bodySystem": "cardiovascular",
        "notes": "Rare reports of arterial stenosis or aneurysms"
      },
      {
        "symptomName": "Scoliosis",
        "frequency": 0.07,
        "bodySystem": "musculoskeletal",
        "notes": "Mild spinal curvature occasionally observed"
      },
      {
        "symptomName": "Optic pathway gliomas",
        "frequency": 0.02,
        "bodySystem": "ophthalmological",
        "notes": "Very rare; typically absent unlike NF1"
      }
    ]
  },
  "systemsAffected": [
    "dermatological",
    "neurological",
    "constitutional",
    "psychiatric",
    "musculoskeletal",
    "cardiovascular",
    "ophthalmological"
  ],
  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "MRI to exclude optic pathway gliomas and other tumors",
      "Skeletal X-rays to assess scoliosis if clinically indicated"
    ],
    "genetic": [
      "Pathogenic variants in SPRED1 gene detected by molecular genetic testing"
    ],
    "other": [
      "Clinical examination revealing multiple café-au-lait spots and freckling without neurofibromas"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "neurofibromatosis-type-1",
      "distinguishingFeatures": [
        "Presence of neurofibromas and plexiform neurofibromas",
        "Lisch nodules in the iris",
        "Higher risk of tumors including optic gliomas"
      ]
    },
    {
      "diseaseId": "noonan-syndrome",
      "distinguishingFeatures": [
        "Distinct facial features including ptosis and low-set ears",
        "Congenital heart defects common",
        "Short stature and developmental delay"
      ]
    }
  ],
  "redFlags": [
    "Development of neurofibromas or plexiform neurofibromas",
    "Rapid increase in size or number of café-au-lait spots",
    "Neurological deficits or seizures"
  ],
  "specialistType": [
    "Geneticist",
    "Dermatologist",
    "Neurologist",
    "Pediatrician"
  ],
  "lastUpdated": "2026-02-17",
  "references": [
