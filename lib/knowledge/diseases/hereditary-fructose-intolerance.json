  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and biochemical diagnosis of Hereditary Fructose Intolerance",
    "criteria": [
      {
        "id": "fructose-intolerance-symptoms",
        "description": "Symptoms triggered by ingestion of fructose, sucrose, or sorbitol including vomiting and hypoglycemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aldolase-b-deficiency",
        "description": "Demonstration of aldolase B enzyme deficiency in liver biopsy or erythrocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the ALDOB gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fructose-tolerance-test",
        "description": "Positive fructose tolerance test showing hypoglycemia and metabolic abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "liver-function-abnormalities",
        "description": "Elevated liver enzymes and hepatomegaly after fructose ingestion",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic symptoms after fructose ingestion plus either aldolase B deficiency or pathogenic ALDOB mutations",
    "notes": "Fructose tolerance test is rarely performed due to risk of severe hypoglycemia."
  },
