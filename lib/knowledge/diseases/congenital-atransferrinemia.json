  "keyFindings": {
    "laboratory": [
      "Undetectable or severely decreased serum transferrin",
      "Severe microcytic hypochromic anemia",
      "Elevated serum ferritin and iron levels",
      "Low total iron-binding capacity (TIBC)",
      "Elevated liver enzymes in some cases"
    ],
    "imaging": [
      "Hepatomegaly and splenomegaly on abdominal ultrasound",
      "Cardiac MRI showing iron deposition in myocardium",
      "Liver MRI demonstrating iron overload"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Bone marrow biopsy showing erythroid hyperplasia",
      "Liver biopsy confirming iron overload"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hereditary-hemochromatosis",
      "distinguishingFeatures": [
        "Normal or elevated transferrin levels",
        "Adult onset",
        "No severe anemia"
      ]
    },
    {
      "diseaseId": "iron-refractory-iron-deficiency-anemia",
      "distinguishingFeatures": [
        "Low serum ferritin",
        "Normal transferrin levels",
        "Response to parenteral iron therapy"
      ]
    },
    {
      "diseaseId": "aplastic-anemia",
      "distinguishingFeatures": [
        "Pancytopenia",
        "Bone marrow hypocellularity",
        "No iron overload"
      ]
    }
  ],
  "redFlags": [
