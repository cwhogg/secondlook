  "diagnosticCriteria": {
    "formalCriteriaName": "LAD I Diagnostic Criteria",
    "criteria": [
      {
        "id": "cd18-deficiency",
        "description": "Deficiency or absence of CD18 integrin expression on leukocytes confirmed by flow cytometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-bacterial-infections",
        "description": "Recurrent severe bacterial infections without pus formation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "delayed-umbilical-cord-separation",
        "description": "Delayed separation of the umbilical cord beyond 3 weeks of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neutrophilia",
        "description": "Persistent peripheral blood neutrophilia during infections",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the ITGB2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent bacterial infections with delayed umbilical cord separation plus either CD18 deficiency on flow cytometry or pathogenic ITGB2 mutation",
    "notes": "Diagnosis is confirmed by flow cytometric analysis of CD18 expression and/or genetic testing."
  },
