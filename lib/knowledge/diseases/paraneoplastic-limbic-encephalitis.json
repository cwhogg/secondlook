{
  "id": "paraneoplastic-limbic-encephalitis",
  "name": "Paraneoplastic Limbic Encephalitis",
  "aliases": [
    "PLE",
    "Paraneoplastic Limbic Encephalopathy"
  ],
  "icd10Codes": [
    "G04.81"
  ],
  "prevalence": {
    "estimate": "1 in 500,000",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 30,
      "max": 70,
      "peak": 50
    },
    "sexPredilection": "slight-male",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Graus et al. 2004 Paraneoplastic Neurological Syndrome Criteria",
    "criteria": [
      {
        "id": "limbic-symptoms",
        "description": "Subacute onset of memory loss, seizures, or psychiatric symptoms consistent with limbic system involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cancer-association",
        "description": "Presence of an underlying malignancy within 5 years of neurological symptom onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "antineuronal-antibodies",
        "description": "Detection of well-characterized paraneoplastic antibodies (e.g., anti-Hu, anti-Ma2, anti-CRMP5) in serum or CSF",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "MRI-findings",
        "description": "MRI evidence of medial temporal lobe hyperintensity on T2/FLAIR sequences",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "CSF-inflammatory-changes",
        "description": "CSF pleocytosis or elevated protein suggestive of inflammation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Subacute limbic symptoms plus either confirmed malignancy or presence of paraneoplastic antibodies",
    "notes": "Diagnosis may be supported by MRI and CSF findings but these are not mandatory."
  },
