  "diagnosticCriteria": {
    "criteria": [
      {
        "id": "whip-maj1",
        "description": "Positive PAS (periodic acid-Schiff) staining of foamy macrophages in small intestinal biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "whip-maj2",
        "description": "Positive Tropheryma whipplei PCR from tissue or body fluid",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "whip-min1",
        "description": "Clinical features: diarrhea, weight loss, arthralgias, lymphadenopathy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "whip-min2",
        "description": "Electron microscopy showing characteristic bacilli in macrophages",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "whip-sup1",
        "description": "Immunohistochemistry positive for T. whipplei",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "PAS-positive macrophages in small intestinal biopsy is the classic diagnostic finding. PCR confirmation of T. whipplei is increasingly used. For extraintestinal disease, PCR from affected tissue/fluid.",
    "notes": "Arthralgias may precede GI symptoms by years to decades. Immunocompromised patients may have atypical presentations."
  },
