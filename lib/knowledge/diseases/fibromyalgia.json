  "keyFindings": {
    "laboratory": [
      "All standard laboratory tests are normal (CBC, CMP, ESR, CRP, TSH, ANA)",
      "Labs serve to exclude other conditions (hypothyroidism, inflammatory arthritis, lupus)",
      "No specific biomarker for fibromyalgia"
    ],
    "imaging": [
      "Imaging is normal and used to rule out other pathology",
      "Functional MRI research shows altered central pain processing (research setting only)"
    ],
    "genetic": [
      "No specific genetic test",
      "Evidence of polygenic susceptibility (serotonergic, catecholaminergic gene polymorphisms)",
      "Familial aggregation observed"
    ],
    "other": [
      "Widespread Pain Index (WPI) scoring",
      "Symptom Severity Scale (SSS) scoring",
      "Exclusion of inflammatory and autoimmune conditions"
    ]
  },
