  "keyFindings": {
    "laboratory": [
      "Electromyography showing continuous myotonic discharges",
      "Normal routine blood tests"
    ],
    "imaging": [
      "Radiographs showing chondrodysplasia and joint contractures",
      "Skeletal survey revealing short stature and scoliosis"
    ],
    "genetic": [
      "HSPG2 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy showing myopathic changes with fibrosis",
      "Clinical observation of characteristic facial features"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "myotonic-dystrophy",
      "distinguishingFeatures": [
        "Progressive muscle weakness rather than stiffness",
        "Adult onset typical",
        "Presence of cataracts and cardiac conduction defects"
      ]
    },
    {
      "diseaseId": "stiff-person-syndrome",
      "distinguishingFeatures": [
        "Autoimmune etiology",
        "Fluctuating muscle rigidity",
        "Presence of anti-GAD antibodies"
      ]
    },
    {
      "diseaseId": "congenital-myotonia",
      "distinguishingFeatures": [
        "Absence of skeletal dysplasia",
        "Mutations in CLCN1 gene",
        "No characteristic facial dysmorphism"
      ]
    }
  ],
  "redFlags": [
    "Severe respiratory compromise due to chest wall rigidity",
    "Progressive joint contractures limiting mobility",
    "Signs of cardiac arrhythmia or conduction abnormalities"
  ],
