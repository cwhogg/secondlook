  "diagnosticCriteria": {
    "formalCriteriaName": "ICF Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "immunoglobulin-deficiency",
        "description": "Hypogammaglobulinemia with low serum immunoglobulin levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "centromeric-instability",
        "description": "Chromosomal abnormalities involving centromeric instability of chromosomes 1, 9, and 16",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "zbtb24-mutation",
        "description": "Pathogenic biallelic mutations in the ZBTB24 gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoimmune-features",
        "description": "Presence of autoimmune manifestations such as autoimmune cytopenias",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial anomalies including epicanthal folds and hypertelorism",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypogammaglobulinemia, centromeric instability on cytogenetics, and confirmed pathogenic ZBTB24 mutations",
    "notes": "Diagnosis requires integration of clinical, cytogenetic, and molecular genetic findings."
  },
