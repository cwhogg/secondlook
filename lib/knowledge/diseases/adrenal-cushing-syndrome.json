  "diagnosticCriteria": {
    "formalCriteriaName": "Endocrine Society Clinical Practice Guideline for Cushing Syndrome",
    "criteria": [
      {
        "id": "hypercortisolism-confirmation",
        "description": "Elevated 24-hour urinary free cortisol or elevated late-night salivary cortisol",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "adrenal-source-confirmation",
        "description": "Elevated plasma ACTH-independent cortisol levels with suppressed plasma ACTH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-adrenal-lesion",
        "description": "Identification of adrenal adenoma or carcinoma on adrenal CT or MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dexamethasone-suppression-test",
        "description": "Lack of cortisol suppression after low-dose dexamethasone test",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of confirmed hypercortisolism with suppressed ACTH and imaging evidence of adrenal lesion",
    "notes": "Differentiation from pituitary or ectopic ACTH sources is critical."
  },
