  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for HSV Stromal Keratitis",
    "criteria": [
      {
        "id": "stromal-infiltrates",
        "description": "Presence of stromal corneal infiltrates without primary epithelial ulceration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dendritic-epithelial-lesions",
        "description": "History or presence of dendritic epithelial lesions typical of HSV infection",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "corneal-scarring",
        "description": "Corneal stromal scarring or neovascularization consistent with prior HSV keratitis episodes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "positive-hsv-dna-pcr",
        "description": "Detection of HSV DNA in corneal scrapings by PCR",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of stromal corneal infiltrates with clinical history or evidence of HSV infection",
    "notes": "Diagnosis is primarily clinical supported by laboratory confirmation when available."
  },
