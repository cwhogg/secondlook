  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Chilblain Lupus Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-cold-induced-lesions",
        "description": "Persistent erythematous to violaceous acral lesions exacerbated by cold exposure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathologic-findings",
        "description": "Skin biopsy showing interface dermatitis with basal vacuolar changes and perivascular lymphocytic infiltrate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "positive-antinuclear-antibodies",
        "description": "Presence of positive antinuclear antibodies (ANA) with or without anti-Ro/SSA antibodies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-systemic-lupus-features",
        "description": "Lack of systemic lupus erythematosus clinical or serological criteria",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (chronic cold-induced acral lesions and characteristic histopathology) with supportive serology and exclusion of systemic lupus erythematosus",
    "notes": "Diagnosis requires correlation of clinical, histopathological, and immunological findings; cold exposure history is important."
  },
