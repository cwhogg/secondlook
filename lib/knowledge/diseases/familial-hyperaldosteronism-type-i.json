  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Familial Hyperaldosteronism Type I",
    "criteria": [
      {
        "id": "family-history",
        "description": "Presence of a family history of early-onset hypertension with biochemical evidence of hyperaldosteronism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aldosterone-renin-ratio",
        "description": "Elevated aldosterone-to-renin ratio indicating autonomous aldosterone secretion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glucocorticoid-suppression-test",
        "description": "Suppression of aldosterone production by dexamethasone administration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of chimeric CYP11B1/CYP11B2 gene confirming diagnosis",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of elevated aldosterone-renin ratio with family history plus either glucocorticoid suppression test positivity or confirmatory genetic testing",
    "notes": "Genetic testing is considered the gold standard for definitive diagnosis."
  },
