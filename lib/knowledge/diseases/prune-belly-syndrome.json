  "diagnosticCriteria": {
    "formalCriteriaName": "Classic Triad Diagnostic Criteria",
    "criteria": [
      {
        "id": "abdominal-wall-deficiency",
        "description": "Partial or complete absence of abdominal wall musculature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-tract-anomalies",
        "description": "Dilatation of the urinary tract including ureters and bladder",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cryptorchidism",
        "description": "Bilateral undescended testes in males",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-hypoplasia",
        "description": "Underdevelopment of the lungs",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "renal-dysplasia",
        "description": "Abnormal development of the kidneys",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: abdominal wall musculature deficiency, urinary tract anomalies, and bilateral cryptorchidism in males",
    "notes": "Diagnosis is clinical and supported by imaging studies; females may present with variable genital anomalies instead of cryptorchidism."
  },
