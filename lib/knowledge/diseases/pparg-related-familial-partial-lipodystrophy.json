  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Familial Partial Lipodystrophy Type 3",
    "criteria": [
      {
        "id": "partial-lipodystrophy",
        "description": "Selective loss of subcutaneous adipose tissue predominantly affecting the limbs and gluteal region with relative preservation or accumulation in the face and neck",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pparg-mutation",
        "description": "Identification of pathogenic heterozygous mutation in the PPARG gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-complications",
        "description": "Presence of insulin resistance, diabetes mellitus, hypertriglyceridemia, or hepatic steatosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history consistent with autosomal dominant inheritance of partial lipodystrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic partial lipodystrophy phenotype plus identification of a pathogenic PPARG mutation",
    "notes": "Diagnosis may be supported by metabolic abnormalities and family history but requires genetic confirmation."
  },
