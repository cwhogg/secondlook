  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Self-limited Neonatal Epilepsy",
    "criteria": [
      {
        "id": "onset-neonatal",
        "description": "Seizure onset within the first week of life, typically between day 2 and day 7",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizure-type",
        "description": "Focal clonic seizures with or without secondary generalization",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-development",
        "description": "Normal neurological development before, during, and after the seizure period",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of neonatal seizures or epilepsy with similar benign course",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electroencephalogram",
        "description": "Interictal EEG showing normal background with focal epileptiform discharges",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of neonatal onset focal seizures with normal development and spontaneous remission within weeks to months",
    "notes": "Genetic testing for KCNQ2 or KCNQ3 mutations may support diagnosis but is not mandatory."
  },
