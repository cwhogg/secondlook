  "keyFindings": {
    "laboratory": [
      "Hyperglycemia with insulin deficiency",
      "Low gonadotropin levels (LH, FSH)",
      "Hypothyroidism markers (low T4, elevated TSH)"
    ],
    "imaging": [
      "Brain MRI may show basal ganglia abnormalities",
      "Cardiac echocardiography may reveal cardiomyopathy"
    ],
    "genetic": [
      "Biallelic pathogenic variants in DCAF17 gene (formerly C2orf37)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography showing peripheral neuropathy",
      "Audiometry confirming sensorineural hearing loss"
    ]
  },
