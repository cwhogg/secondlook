  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "characteristic-skin-lesions",
        "description": "Presence of characteristic porcelain-white atrophic papules with erythematous telangiectatic rim",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing wedge-shaped dermal necrosis with occlusive vasculopathy of small and medium-sized arteries",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "systemic-involvement",
        "description": "Evidence of systemic involvement such as gastrointestinal or central nervous system infarcts",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic skin lesions and confirmatory histopathology",
    "notes": "Diagnosis is clinical supported by histopathology; systemic involvement indicates malignant form"
  },
