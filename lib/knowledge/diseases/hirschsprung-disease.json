  "keyFindings": {
    "laboratory": [
      "Leukocytosis in enterocolitis",
      "Electrolyte imbalances in severe obstruction"
    ],
    "imaging": [
      "Contrast enema showing transition zone between dilated proximal colon and narrow distal segment",
      "Abdominal X-ray showing dilated bowel loops"
    ],
    "genetic": [
      "Mutations in RET proto-oncogene",
      "Mutations in EDNRB and EDN3 genes"
    ],
    "other": [
      "Absence of rectoanal inhibitory reflex on anorectal manometry",
      "Histopathology showing absence of ganglion cells and hypertrophic nerve trunks"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "meconium-ileus",
      "distinguishingFeatures": [
        "Associated with cystic fibrosis",
        "Meconium obstruction localized to ileum",
        "Positive sweat chloride test"
      ]
    },
    {
      "diseaseId": "intestinal-atresia",
      "distinguishingFeatures": [
        "Anatomic obstruction rather than functional",
        "Detected prenatally or shortly after birth",
        "No aganglionosis on biopsy"
      ]
    },
    {
      "diseaseId": "chronic idiopathic constipation",
      "distinguishingFeatures": [
        "No histopathological aganglionosis",
        "Normal anorectal manometry",
        "Later onset and less severe symptoms"
      ]
    }
  ],
  "redFlags": [
    "Failure to pass meconium within 48 hours of birth",
    "Progressive abdominal distension with vomiting",
    "Signs of enterocolitis including fever, diarrhea, and sepsis"
  ],
