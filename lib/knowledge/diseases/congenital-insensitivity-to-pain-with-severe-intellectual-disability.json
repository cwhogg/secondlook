  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible elevated creatine kinase due to muscle injury"
    ],
    "imaging": [
      "X-rays showing multiple painless fractures and bone deformities",
      "MRI may show peripheral nerve abnormalities"
    ],
    "genetic": [
      "CLTCL1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electrophysiological studies demonstrating absent or reduced nociceptive nerve function",
      "Skin biopsy showing loss of small unmyelinated nerve fibers"
    ]
  },
