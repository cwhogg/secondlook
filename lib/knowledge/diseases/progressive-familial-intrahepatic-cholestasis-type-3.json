  "diagnosticCriteria": {
    "formalCriteriaName": "PFIC Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-cholestasis",
        "description": "Presence of chronic cholestasis with pruritus and jaundice",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-abnormalities",
        "description": "Elevated serum gamma-glutamyl transferase (GGT) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the ABCB4 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-biopsy",
        "description": "Histological evidence of intrahepatic cholestasis with ductular proliferation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical cholestasis with elevated GGT and confirmation of ABCB4 gene mutation",
    "notes": "Diagnosis requires exclusion of other causes of cholestasis and may be supported by liver biopsy findings."
  },
