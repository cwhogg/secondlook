  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible elevated creatine kinase in some cases"
    ],
    "imaging": [
      "Brain MRI may show nonspecific cerebral atrophy or delayed myelination"
    ],
    "genetic": [
      "DDX3X (causative, loss-of-function)",
      "Pathogenic variants in the causative X-linked gene (specific gene currently under investigation)",
      "X-linked dominant inheritance"
    ],
    "other": [
      "Electromyography may show decreased muscle tone",
      "EEG abnormalities in patients with seizures"
    ]
  },
