  "diagnosticCriteria": {
    "formalCriteriaName": "Adult Idiopathic Neutropenia Diagnostic Criteria",
    "criteria": [
      {
        "id": "persistent-neutropenia",
        "description": "Absolute neutrophil count (ANC) below 1500/µL for more than 3 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-secondary-causes",
        "description": "Exclusion of secondary causes such as infections, medications, autoimmune diseases, and malignancies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-examination",
        "description": "Bone marrow biopsy showing normal or mildly hypoplastic myeloid lineage without dysplasia or malignancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-cytogenetic-abnormalities",
        "description": "No clonal cytogenetic abnormalities detected",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-stability",
        "description": "Chronicity of neutropenia without progression to aplastic anemia or leukemia over at least 6 months",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent neutropenia (ANC <1500/µL) for >3 months with exclusion of secondary causes and supportive bone marrow findings",
    "notes": "Diagnosis is one of exclusion; secondary causes must be thoroughly ruled out."
  },
