  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Lowe Syndrome",
    "criteria": [
      {
        "id": "congenital-cataracts",
        "description": "Presence of bilateral congenital cataracts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-tubular-dysfunction",
        "description": "Evidence of proximal renal tubular dysfunction (Fanconi syndrome)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-impairment",
        "description": "Intellectual disability and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "OCRL1-gene-mutation",
        "description": "Identification of pathogenic variants in the OCRL1 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "additional-ocular-features",
        "description": "Glaucoma or nystagmus",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral congenital cataracts, proximal renal tubular dysfunction, and neurological impairment; genetic confirmation supports diagnosis",
    "notes": "Genetic testing for OCRL1 mutations is confirmatory but not always required if clinical features are classic."
  },
