  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for DCX-related Lissencephaly",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in the DCX gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroradiological-features",
        "description": "MRI showing agyria or pachygyria predominantly in the cerebral cortex with a smooth brain surface",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Severe developmental delay with early-onset epilepsy and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history consistent with X-linked inheritance or affected male relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic DCX gene mutation plus characteristic neuroradiological features and clinical presentation",
    "notes": "Genetic testing is essential for definitive diagnosis; MRI findings are critical for phenotypic correlation."
  },
