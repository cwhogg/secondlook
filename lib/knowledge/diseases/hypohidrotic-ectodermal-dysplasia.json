  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Hypohidrotic Ectodermal Dysplasia",
    "criteria": [
      {
        "id": "hypohidrosis",
        "description": "Reduced or absent sweating (hypohidrosis or anhidrosis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypodontia",
        "description": "Congenital hypodontia or oligodontia with abnormal tooth morphology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotrichosis",
        "description": "Sparse, thin, or absent scalp and body hair (hypotrichosis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including frontal bossing, saddle nose, and periorbital wrinkling",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked or autosomal inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: hypohidrosis, hypodontia, and hypotrichosis",
    "notes": "Genetic testing for mutations in EDA, EDAR, or EDARADD genes can confirm diagnosis."
  },
