  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Elevated lactate may be absent or mild"
    ],
    "imaging": [
      "Brain MRI typically normal or shows mild cerebral atrophy in advanced stages"
    ],
    "genetic": [
      "Biallelic pathogenic variants in CSTB gene (cystatin B)"
    ],
    "other": [
      "EEG with generalized spike-wave and polyspike-wave discharges",
      "Photosensitivity on EEG"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "lafora-disease",
      "distinguishingFeatures": [
        "Onset in adolescence with rapid progression",
        "Presence of Lafora bodies on skin biopsy",
        "Mutations in EPM2A or EPM2B genes"
      ]
    },
    {
      "diseaseId": "myoclonic-epilepsy-with-ragged-red-fibers",
      "distinguishingFeatures": [
        "Mitochondrial inheritance pattern",
        "Presence of ragged-red fibers on muscle biopsy",
        "Associated mitochondrial DNA mutations"
      ]
    }
  ],
  "redFlags": [
    "Onset of seizures before 6 years of age",
    "Rapid neurological deterioration",
    "Poor response to standard antiepileptic drugs"
  ],
