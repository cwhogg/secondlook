  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Boomerang Dysplasia",
    "criteria": [
      {
        "id": "skeletal-malformations",
        "description": "Severe micromelia with characteristic boomerang-shaped long bones on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "prenatal-lethal",
        "description": "Prenatal or perinatal lethality due to respiratory insufficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the FLNB gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features including midface hypoplasia and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiological-findings",
        "description": "Absent or hypoplastic ossification of vertebral bodies and pelvis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic boomerang-shaped long bones on imaging plus prenatal or perinatal lethality; genetic confirmation supports diagnosis",
    "notes": "Diagnosis is primarily clinical and radiological; genetic testing is confirmatory but not always available."
  },
