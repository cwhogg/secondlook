{
  "id": "icf-syndrome-type-1",
  "name": "Immunodeficiency, Centromeric Instability, and Facial Anomalies Syndrome Type 1",
  "aliases": [
    "ICF Syndrome Type 1",
    "Immunodeficiency-Centromeric Instability-Facial Anomalies Syndrome 1"
  ],
  "icd10Codes": [
    "D81.8"
  ],
  "omimId": "242860",
  "orphanetId": "284",
  "prevalence": {
    "estimate": "1 in 1,000,000",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 5,
      "peak": 1
    },
    "sexPredilection": "equal",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "ICF Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "immunoglobulin-deficiency",
        "description": "Hypogammaglobulinemia with low or absent serum IgG, IgA, and/or IgM",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-anomalies",
        "description": "Characteristic facial dysmorphisms including hypertelorism, epicanthal folds, flat nasal bridge, and macroglossia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chromosomal-instability",
        "description": "Centromeric instability and multiradial chromosomes involving chromosomes 1, 9, and 16 detected by cytogenetic analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dnmt3b-mutation",
        "description": "Pathogenic mutations in the DNMT3B gene confirmed by genetic testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "recurrent-infections",
        "description": "History of recurrent bacterial infections, especially respiratory and gastrointestinal",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (immunoglobulin deficiency, characteristic facial anomalies, and chromosomal instability) with or without DNMT3B mutation confirmation",
    "notes": "Genetic testing for DNMT3B mutations supports diagnosis but is not mandatory if clinical and cytogenetic criteria are met."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Centromeric chromosomal instability",
        "frequency": 0.95,
        "bodySystem": "hematological",
        "notes": "Detected by cytogenetic analysis showing multiradial chromosomes"
      },
      {
        "symptomName": "Hypogammaglobulinemia",
        "frequency": 0.9,
        "bodySystem": "immunological",
        "notes": "Marked deficiency of IgG, IgA, and/or IgM"
      },
      {
        "symptomName": "Characteristic facial dysmorphisms",
        "frequency": 0.85,
        "bodySystem": "constitutional",
        "notes": "Includes hypertelorism, epicanthal folds, flat nasal bridge, and macroglossia"
      }
    ],
    "common": [
      {
        "symptomName": "Recurrent respiratory infections",
        "frequency": 0.75,
        "bodySystem": "respiratory",
        "notes": "Often bacterial pneumonia or bronchitis"
      },
      {
        "symptomName": "Recurrent gastrointestinal infections",
        "frequency": 0.7,
        "bodySystem": "gastrointestinal",
        "notes": "Including chronic diarrhea"
      },
      {
        "symptomName": "Failure to thrive",
        "frequency": 0.65,
        "bodySystem": "constitutional",
        "notes": "Poor growth and weight gain in infancy"
      },
      {
        "symptomName": "Lymphopenia",
        "frequency": 0.6,
        "bodySystem": "hematological",
        "notes": "Reduced lymphocyte counts"
      },
      {
        "symptomName": "Developmental delay",
        "frequency": 0.55,
        "bodySystem": "neurological",
        "notes": "Mild to moderate psychomotor delay"
      }
    ],
    "occasional": [
      {
        "symptomName": "Autoimmune manifestations",
        "frequency": 0.4,
        "bodySystem": "immunological",
        "notes": "Including autoimmune cytopenias"
      },
      {
        "symptomName": "Hepatosplenomegaly",
        "frequency": 0.35,
        "bodySystem": "hematological",
        "notes": "Enlargement of liver and spleen"
      },
      {
        "symptomName": "Skin hypopigmentation or hyperpigmentation",
        "frequency": 0.3,
        "bodySystem": "dermatological",
        "notes": "Variable skin pigmentation abnormalities"
      },
      {
        "symptomName": "Epileptic seizures",
        "frequency": 0.2,
        "bodySystem": "neurological",
        "notes": "Occasional seizure activity reported"
      },
      {
        "symptomName": "Oral candidiasis",
        "frequency": 0.15,
        "bodySystem": "otolaryngological",
        "notes": "Fungal infections of oral mucosa"
      }
    ],
    "rare": [
      {
        "symptomName": "Congenital heart defects",
        "frequency": 0.08,
        "bodySystem": "cardiovascular",
        "notes": "Rare structural cardiac anomalies"
      },
      {
        "symptomName": "Sensorineural hearing loss",
        "frequency": 0.06,
        "bodySystem": "otolaryngological",
        "notes": "Reported in a minority of cases"
      },
      {
        "symptomName": "Malignancies",
        "frequency": 0.05,
        "bodySystem": "hematological",
        "notes": "Increased risk of lymphomas and leukemias"
      }
    ]
  },
