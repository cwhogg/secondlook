  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Peters Plus Syndrome",
    "criteria": [
      {
        "id": "peters-anomaly",
        "description": "Presence of Peters anomaly characterized by central corneal opacity with iridocorneal or lenticulocorneal adhesions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature-brachydactyly",
        "description": "Short stature and brachydactyly with characteristic facial dysmorphism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biallelic-b3galnt2-mutation",
        "description": "Identification of biallelic pathogenic variants in the B3GALTL gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital heart defects such as atrial or ventricular septal defects",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of Peters anomaly plus short stature with brachydactyly and characteristic facial features; genetic confirmation supports diagnosis",
    "notes": "Genetic testing for B3GALTL mutations is confirmatory but not always available"
  },
