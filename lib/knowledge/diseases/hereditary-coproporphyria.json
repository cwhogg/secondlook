  "keyFindings": {
    "laboratory": [
      "Markedly elevated fecal coproporphyrin III (coproporphyrin III/I ratio >2)",
      "Elevated urinary PBG and ALA during acute attacks",
      "Elevated urinary coproporphyrins",
      "Normal fecal protoporphyrin (distinguishes from variegate porphyria)",
      "Plasma fluorescence peak at ~618-620 nm if cutaneous features present"
    ],
    "imaging": [
      "Abdominal imaging typically unremarkable during acute attacks",
      "MRI brain if neurological complications suspected"
    ],
    "genetic": [
      "CPOX (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Nerve conduction studies may show motor axonal neuropathy during attacks",
      "Fecal porphyrin fractionation is critical for distinguishing from AIP and VP"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "acute-intermittent-porphyria",
      "distinguishingFeatures": [
        "AIP never has cutaneous manifestations",
        "AIP has normal fecal porphyrins",
        "AIP has reduced HMBS enzyme activity"
      ]
    },
    {
      "diseaseId": "variegate-porphyria",
      "distinguishingFeatures": [
        "VP has elevated fecal protoporphyrin",
        "VP has plasma fluorescence peak at ~626 nm",
        "VP involves PPOX gene mutation"
      ]
    },
    {
      "diseaseId": "porphyria-cutanea-tarda",
      "distinguishingFeatures": [
        "PCT lacks neurovisceral attacks",
        "PCT has elevated urinary uroporphyrins",
        "PCT has normal urinary PBG"
      ]
    }
  ],
  "redFlags": [
    "Progressive motor neuropathy (risk of respiratory failure)",
    "Severe hyponatremia during acute attacks",
    "Administration of porphyrinogenic drugs",
    "Homozygous presentation in neonates with jaundice and hemolysis (harderoporphyria)",
    "Seizures indicating CNS involvement"
  ],
