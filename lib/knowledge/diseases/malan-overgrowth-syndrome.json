  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "No specific biochemical markers identified"
    ],
    "imaging": [
      "Skeletal X-rays showing scoliosis or other skeletal anomalies",
      "Brain MRI may show nonspecific findings or mild ventriculomegaly"
    ],
    "genetic": [
      "NFIX (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Clinical assessment of growth parameters showing postnatal overgrowth",
      "Neurodevelopmental evaluation confirming intellectual disability"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sotos-syndrome",
      "distinguishingFeatures": [
        "NSD1 gene mutations instead of NFIX",
        "More pronounced macrocephaly",
        "Distinct facial features differing from Malan syndrome"
      ]
    },
    {
      "diseaseId": "weaver-syndrome",
      "distinguishingFeatures": [
        "EZH2 gene mutations",
        "Advanced bone age",
        "Characteristic facial features distinct from Malan syndrome"
      ]
    }
  ],
