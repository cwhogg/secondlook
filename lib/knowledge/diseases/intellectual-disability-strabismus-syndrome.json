  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "No specific metabolic abnormalities identified"
    ],
    "imaging": [
      "Brain MRI may show nonspecific mild cerebral atrophy or delayed myelination",
      "Ophthalmologic imaging confirms ocular misalignment"
    ],
    "genetic": [
      "ADAT3 (causative)",
      "No consistent pathogenic variants identified; possible autosomal recessive inheritance pattern suggested in some families"
    ],
    "other": [
      "Electroencephalogram (EEG) may show nonspecific abnormalities in patients with seizures"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "down-syndrome",
      "distinguishingFeatures": [
        "Characteristic facial features",
        "Trisomy 21 genetic confirmation",
        "Hypotonia with distinct cognitive profile"
      ]
    },
    {
      "diseaseId": "angelman-syndrome",
      "distinguishingFeatures": [
        "Severe speech impairment with happy demeanor",
        "Ataxia and frequent laughter",
        "Distinct genetic deletion or imprinting defect on chromosome 15"
      ]
    }
  ],
  "redFlags": [
    "Rapid regression of developmental milestones",
    "Onset of seizures with loss of previously acquired skills",
    "Progressive visual impairment beyond strabismus"
  ],
