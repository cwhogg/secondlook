  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Oculocutaneous Albinism",
    "criteria": [
      {
        "id": "hypopigmentation-skin-hair",
        "description": "Diffuse hypopigmentation of skin and hair with residual pigment production",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-hypopigmentation",
        "description": "Hypopigmentation of the iris and retinal pigment epithelium with associated visual abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tyrosinase-activity",
        "description": "Presence of residual tyrosinase enzyme activity confirmed by biochemical or genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the TYR gene consistent with OCA1B",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "visual-impairment",
        "description": "Nystagmus and reduced visual acuity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypopigmentation of skin/hair and ocular hypopigmentation with residual tyrosinase activity or pathogenic TYR gene variants",
    "notes": "Diagnosis is confirmed by genetic testing identifying TYR mutations associated with OCA1B."
  },
