  "keyFindings": {
    "laboratory": [
      "Elevated blood and CSF lactate and pyruvate levels",
      "Deficient activity of multiple mitochondrial respiratory chain complexes in muscle biopsy",
      "Elevated serum creatine kinase (CK) in some cases"
    ],
    "imaging": [
      "Brain MRI showing basal ganglia abnormalities or cerebral atrophy",
      "Muscle MRI may show fatty infiltration"
    ],
    "genetic": [
      "MTRFR (causative)",
      "Pathogenic variants in nuclear genes encoding mitochondrial translation factors or respiratory chain assembly proteins (e.g., GFM1, MRPS22)",
      "Mitochondrial DNA depletion or multiple deletions may be present",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy showing ragged-red fibers and COX-deficient fibers",
      "Electromyography showing myopathic changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "mitochondrial-dna-depletion-syndrome",
      "distinguishingFeatures": [
        "Primarily affects mitochondrial DNA copy number",
        "Often presents with severe infantile hepatopathy or myopathy",
        "Genetic mutations in nuclear genes involved in mtDNA replication"
      ]
    },
    {
      "diseaseId": "leber-hereditary-optic-neuropathy",
      "distinguishingFeatures": [
        "Predominantly optic nerve involvement causing acute vision loss",
        "Usually caused by specific mitochondrial DNA point mutations",
        "Lacks multisystemic involvement typical of combined OXPHOS defects"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive muscle weakness with respiratory failure",
    "Severe lactic acidosis refractory to treatment",
    "Early onset cardiomyopathy with conduction defects"
  ],
