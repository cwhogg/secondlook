  "diagnosticCriteria": {
    "formalCriteriaName": "Postaxial Polydactyly-Dental and Vertebral Anomalies Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "postaxial-polydactyly",
        "description": "Presence of postaxial polydactyly (extra digit on the ulnar or fibular side)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-anomalies",
        "description": "Dental abnormalities including hypodontia, enamel hypoplasia, or malformed teeth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vertebral-malformations",
        "description": "Vertebral anomalies such as hemivertebrae, butterfly vertebrae, or segmentation defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Mild facial dysmorphic features including broad nasal bridge or micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-cognitive-development",
        "description": "Normal intellectual development",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: postaxial polydactyly, dental anomalies, and vertebral malformations",
    "notes": "Diagnosis is clinical and supported by radiographic and dental evaluations."
  },
