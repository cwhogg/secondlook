      },
      {
        "id": "absence-ulnar-involvement",
        "description": "No synostosis involving the ulna or other bones of the forearm",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "isolated-presentation",
        "description": "Lack of associated syndromic features or systemic involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital humero-radial fusion confirmed clinically and radiologically without involvement of the ulna or other syndromic features",
    "notes": "Diagnosis is primarily clinical and radiological; genetic testing may be considered to exclude syndromic causes."
