  "diagnosticCriteria": {
    "formalCriteriaName": "LAD3 Diagnostic Criteria",
    "criteria": [
      {
        "id": "integrin-activation-defect",
        "description": "Demonstration of defective integrin activation on leukocytes and platelets",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bleeding-tendency",
        "description": "Presence of mucocutaneous bleeding and platelet dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-infections",
        "description": "Recurrent bacterial infections with impaired neutrophil adhesion and migration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in FERMT3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-leukocyte-count",
        "description": "Normal or elevated leukocyte counts without leukocytosis typical of LAD1",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of defective integrin activation plus clinical bleeding and recurrent infections, confirmed by genetic testing of FERMT3",
    "notes": "Diagnosis requires integration of clinical, laboratory, and genetic findings due to overlap with other LAD types."
  },
