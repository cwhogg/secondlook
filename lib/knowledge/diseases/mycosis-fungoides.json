  "keyFindings": {
    "laboratory": [
      "Peripheral blood smear may show Sézary cells in advanced disease",
      "Elevated LDH in advanced stages",
      "T-cell clonality by PCR"
    ],
    "imaging": [
      "CT scan for lymph node and visceral involvement",
      "PET scan to assess extent of disease"
    ],
    "genetic": [
      "OCRL (causative, loss-of-function)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Skin biopsy demonstrating epidermotropism and Pautrier microabscesses",
      "Immunohistochemistry showing CD4+ T-cell predominance with loss of CD7"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "psoriasis",
      "distinguishingFeatures": [
        "Well-demarcated plaques with silvery scale",
        "Absence of atypical lymphocytes on biopsy",
        "Lack of T-cell clonality"
      ]
    },
    {
      "diseaseId": "eczema",
      "distinguishingFeatures": [
        "Pruritic, inflamed patches with spongiosis on biopsy",
        "Polyclonal T-cell infiltrate",
        "Rapid response to topical steroids"
      ]
    },
    {
      "diseaseId": "parapsoriasis",
      "distinguishingFeatures": [
        "Smaller, less infiltrated patches",
        "Lack of epidermotropism of atypical lymphocytes",
        "Usually benign clinical course"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression from patches to tumors",
    "Development of erythroderma",
    "Lymphadenopathy with systemic symptoms"
  ],
  "specialistType": [
    "Dermatologist",
    "Hematologist-Oncologist",
    "Pathologist"
  ],
