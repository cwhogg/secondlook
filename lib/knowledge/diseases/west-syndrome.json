  "prevalence": {
    "estimate": "1 in 2,000 to 1 in 4,000 live births",
    "range": "0.025% - 0.05%",
    "classification": "rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 2,
      "max": 12,
      "peak": 4
    },
    "sexPredilection": "slight-male",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "West Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "infantile-spasms",
        "description": "Presence of infantile spasms (epileptic spasms)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypsarrhythmia-eeg",
        "description": "Hypsarrhythmia pattern on electroencephalogram (EEG)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-regression",
        "description": "Developmental delay or regression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-onset",
        "description": "Onset typically between 3 and 12 months of age",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of infantile spasms, hypsarrhythmia on EEG, and developmental regression",
    "notes": "EEG findings may vary over time; clinical correlation is essential."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Infantile epileptic spasms",
        "frequency": 0.95,
        "bodySystem": "neurological",
        "notes": "Brief symmetric contractions involving neck, trunk, and limbs"
      },
      {
        "symptomName": "Hypsarrhythmia on EEG",
        "frequency": 0.9,
        "bodySystem": "neurological",
        "notes": "Chaotic high-voltage slow waves and multifocal spikes"
      },
      {
        "symptomName": "Developmental regression",
        "frequency": 0.85,
        "bodySystem": "neurological",
        "notes": "Loss of previously acquired milestones"
      }
    ],
    "common": [
      {
        "symptomName": "Irritability",
        "frequency": 0.7,
        "bodySystem": "psychiatric",
        "notes": "Increased fussiness and crying"
      },
      {
        "symptomName": "Hypotonia",
        "frequency": 0.65,
        "bodySystem": "musculoskeletal",
        "notes": "Reduced muscle tone"
      },
      {
        "symptomName": "Sleep disturbances",
        "frequency": 0.6,
        "bodySystem": "psychiatric",
        "notes": "Difficulty initiating or maintaining sleep"
      },
      {
        "symptomName": "Feeding difficulties",
        "frequency": 0.55,
        "bodySystem": "gastrointestinal",
        "notes": "Poor sucking or swallowing"
      }
    ],
    "occasional": [
      {
        "symptomName": "Microcephaly",
        "frequency": 0.4,
        "bodySystem": "neurological",
        "notes": "Head circumference below normal percentiles"
      },
      {
        "symptomName": "Ocular abnormalities",
        "frequency": 0.3,
        "bodySystem": "ophthalmological",
        "notes": "Including nystagmus or strabismus"
      },
      {
        "symptomName": "Autonomic instability",
        "frequency": 0.25,
        "bodySystem": "neurological",
        "notes": "Fluctuations in heart rate and respiration"
      },
      {
        "symptomName": "Seizure types other than spasms",
        "frequency": 0.15,
        "bodySystem": "neurological",
        "notes": "Focal or generalized seizures may occur"
      }
    ],
    "rare": [
      {
        "symptomName": "Cutaneous hypopigmentation",
        "frequency": 0.08,
        "bodySystem": "dermatological",
        "notes": "Associated with tuberous sclerosis complex"
      },
      {
        "symptomName": "Cardiac arrhythmias",
        "frequency": 0.05,
        "bodySystem": "cardiovascular",
        "notes": "Rarely reported in underlying etiologies"
      },
      {
        "symptomName": "Hepatomegaly",
        "frequency": 0.03,
        "bodySystem": "gastrointestinal",
        "notes": "Possible in metabolic causes"
      }
    ]
  },
  "systemsAffected": [
    "neurological",
    "psychiatric",
    "musculoskeletal",
    "gastrointestinal",
    "ophthalmological",
    "dermatological",
    "cardiovascular"
  ],
  "keyFindings": {
    "laboratory": [
      "Metabolic screening abnormalities in some cases",
      "Elevated lactate or ammonia in mitochondrial disorders"
    ],
    "imaging": [
      "Brain MRI may show cortical malformations, tubers, or atrophy"
    ],
    "genetic": [
      "Mutations in ARX, CDKL5, STXBP1, TSC1/TSC2 genes in some patients"
    ],
    "other": [
      "EEG demonstrating hypsarrhythmia pattern",
      "Response to adrenocorticotropic hormone (ACTH) or vigabatrin therapy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dravet-syndrome",
      "distinguishingFeatures": [
        "Prolonged febrile seizures",
        "Onset after 6 months",
        "Different EEG patterns without hypsarrhythmia"
      ]
    },
    {
      "diseaseId": "tuberous-sclerosis-complex",
      "distinguishingFeatures": [
        "Presence of cortical tubers and subependymal nodules on MRI",
        "Characteristic skin lesions (ash leaf spots, shagreen patches)",
        "May present with infantile spasms but with systemic features"
      ]
    }
  ],
  "redFlags": [
    "Onset of spasms after 12 months of age",
    "Absence of hypsarrhythmia on EEG despite spasms",
    "Rapid developmental regression or stagnation"
  ],
  "specialistType": [
    "Pediatric Neurologist",
    "Epileptologist",
    "Clinical Geneticist"
  ],
  "lastUpdated": "2026-02-17",
  "references": [
