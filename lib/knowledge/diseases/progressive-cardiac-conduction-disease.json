  "diagnosticCriteria": {
    "formalCriteriaName": "Progressive Cardiac Conduction Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "ecg-conduction-delay",
        "description": "Evidence of progressive conduction delay on serial electrocardiograms (e.g., PR prolongation, bundle branch block)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-arrhythmias",
        "description": "Presence of symptomatic arrhythmias such as syncope or documented heart block",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of conduction system disease or sudden cardiac death",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with cardiac conduction system disease (e.g., SCN5A, LMNA)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive conduction abnormalities on ECG plus symptomatic arrhythmias or heart block",
    "notes": "Diagnosis is clinical and supported by family history and genetic testing when available."
  },
