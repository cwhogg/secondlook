  "diagnosticCriteria": {
    "formalCriteriaName": "Congenital Primary Megaureter Diagnostic Criteria",
    "criteria": [
      {
        "id": "ureteral-dilation",
        "description": "Radiologic evidence of ureteral dilation without distal obstruction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-vesicoureteral-reflux",
        "description": "No vesicoureteral reflux on voiding cystourethrogram",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "functional-obstruction",
        "description": "Functional obstruction at the ureterovesical junction demonstrated by nuclear renography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "prenatal-hydronephrosis",
        "description": "Prenatal ultrasound showing hydronephrosis or hydroureter",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "urinary-tract-infections",
        "description": "History of recurrent urinary tract infections",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of ureteral dilation without reflux and evidence of functional obstruction at the ureterovesical junction",
    "notes": "Diagnosis requires exclusion of secondary causes such as vesicoureteral reflux or distal ureteral obstruction."
  },
