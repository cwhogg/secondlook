  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for 2q23.1 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "molecular-confirmation",
        "description": "Detection of heterozygous microdeletion at chromosome 2q23.1 encompassing the MBD5 gene by chromosomal microarray or sequencing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "speech-impairment",
        "description": "Severe speech impairment or absent speech",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-features",
        "description": "Presence of autistic features or behavioral abnormalities including hyperactivity",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "craniofacial-features",
        "description": "Characteristic craniofacial dysmorphisms such as broad nasal bridge and prominent forehead",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of 2q23.1 microdeletion involving MBD5 plus presence of global developmental delay and speech impairment",
    "notes": "Diagnosis relies heavily on molecular genetic testing due to phenotypic variability."
  },
