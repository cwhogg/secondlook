  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and biochemical diagnosis of postpartum hypopituitarism",
    "criteria": [
      {
        "id": "history-postpartum-hemorrhage",
        "description": "History of significant postpartum hemorrhage or hypotension",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pituitary-hormone-deficiency",
        "description": "Evidence of anterior pituitary hormone deficiencies (e.g., low cortisol, TSH, prolactin, gonadotropins)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pituitary-imaging",
        "description": "MRI showing empty sella or pituitary atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "History of postpartum hemorrhage plus clinical and biochemical evidence of anterior pituitary hormone deficiencies",
    "notes": "Diagnosis is primarily clinical supported by hormonal assays and imaging; pituitary necrosis is often irreversible."
  },
