  "diagnosticCriteria": {
    "formalCriteriaName": "Hypokalemic Periodic Paralysis Diagnostic Criteria",
    "criteria": [
      {
        "id": "episodic-muscle-weakness",
        "description": "Recurrent episodes of muscle weakness or paralysis lasting hours to days",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypokalemia-during-attack",
        "description": "Documented low serum potassium levels during paralytic episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of similar episodes consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in CACNA1S or SCN4A genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "trigger-factors",
        "description": "Episodes precipitated by triggers such as carbohydrate-rich meals, rest after exercise, or stress",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent episodic muscle weakness with documented hypokalemia during attacks",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory; exclusion of other causes of periodic paralysis is essential."
  },
