  "diagnosticCriteria": {
    "formalCriteriaName": "Diabetic Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness and atrophy in a patient with known diabetes mellitus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "laboratory-evidence",
        "description": "Elevated serum creatine kinase (CK) levels above normal range",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyographic evidence of myopathic changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing fiber atrophy, necrosis, and mitochondrial abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of myopathy such as inflammatory, toxic, or hereditary myopathies",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal muscle weakness with elevated CK and EMG myopathic changes in a diabetic patient, excluding other causes",
    "notes": "Muscle biopsy is supportive but not mandatory; diagnosis relies on clinical and laboratory correlation."
  },
