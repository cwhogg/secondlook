  "keyFindings": {
    "laboratory": [
      "Low serum gonadotropins (LH, FSH) consistent with hypogonadotropic hypogonadism",
      "Normal or mildly elevated thyroid function tests",
      "Normal metabolic panels"
    ],
    "imaging": [
      "Ocular ultrasound confirming cataracts",
      "Brain MRI may show nonspecific findings or be normal",
      "Skeletal survey showing delayed bone age"
    ],
    "genetic": [
      "RAB3GAP1 (causative, loss-of-function)",
      "RAB3GAP2 (causative, loss-of-function)",
      "No specific gene identified; presumed autosomal recessive inheritance in some cases"
    ],
    "other": [
      "Neurodevelopmental assessment confirming intellectual disability",
      "Endocrinological evaluation for pubertal development"
    ]
  },
