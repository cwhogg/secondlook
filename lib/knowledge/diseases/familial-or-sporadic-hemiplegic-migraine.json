  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "CSF analysis typically normal unless complicated"
    ],
    "imaging": [
      "Brain MRI usually normal between attacks",
      "Transient cortical edema or diffusion abnormalities during attacks possible"
    ],
    "genetic": [
      "SCN1A (causative)",
      "CACNA1A (causative)",
      "ATP1A2 (causative)",
      "PRRT2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electroencephalogram (EEG) may show slowing during attacks"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "stroke",
      "distinguishingFeatures": [
        "Persistent neurological deficits",
        "Imaging evidence of infarction",
        "Lack of fully reversible symptoms"
      ]
    },
    {
      "diseaseId": "epilepsy",
      "distinguishingFeatures": [
        "Paroxysmal events with epileptiform EEG changes",
        "Shorter duration of symptoms",
        "Lack of migraine headache"
      ]
    },
    {
      "diseaseId": "transient ischemic attack",
      "distinguishingFeatures": [
        "Sudden onset neurological deficits",
        "No migraine headache or aura",
        "Risk factors for vascular disease"
      ]
    }
  ],
  "redFlags": [
    "Prolonged hemiplegia beyond 72 hours",
    "New onset neurological deficits without headache",
    "Signs of stroke or intracranial hemorrhage"
  ],
