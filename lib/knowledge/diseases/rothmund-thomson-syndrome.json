  "diagnosticCriteria": {
    "formalCriteriaName": "Rothmund-Thomson Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "poikiloderma",
        "description": "Early-onset poikiloderma with facial erythema, telangiectasia, and pigmentation changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Presence of skeletal abnormalities such as radial ray defects, absent or hypoplastic thumbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cancer-predisposition",
        "description": "Increased risk of osteosarcoma or other malignancies",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation and short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hair-abnormalities",
        "description": "Sparse, thin, or absent hair including eyebrows and eyelashes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Biallelic pathogenic variants in RECQL4 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset poikiloderma plus at least one major criterion (skeletal abnormalities or cancer predisposition) or confirmed RECQL4 pathogenic variants",
    "notes": "Genetic testing for RECQL4 mutations is confirmatory but not always available."
  },
