    "formalCriteriaName": "CDC Diagnostic Criteria for Idiopathic CD4 Lymphocytopenia",
    "criteria": [
      {
        "id": "cd4-count",
        "description": "Absolute CD4+ T-lymphocyte count persistently below 300 cells/μL or less than 20% of total T cells on at least two occasions separated by at least 6 weeks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hiv-negative",
        "description": "Absence of HIV-1 and HIV-2 infection confirmed by serology and PCR",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "secondary-causes-exclusion",
        "description": "Exclusion of other known causes of CD4 lymphocytopenia such as immunosuppressive therapy, malignancies, or infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of opportunistic infections or autoimmune manifestations supportive but not mandatory",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent CD4+ T-cell count <300 cells/μL or <20% total T cells on two occasions, absence of HIV infection, and exclusion of secondary causes",
    "notes": "Diagnosis requires careful exclusion of HIV and other immunodeficiency causes; clinical presentation varies widely."
  },
