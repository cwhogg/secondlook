        "Holoprosencephaly frequent"
      ]
    },
    {
      "diseaseId": "turner-syndrome",
      "distinguishingFeatures": [
        "Monosomy X rather than trisomy",
        "Short stature with webbed neck",
        "Lack of severe congenital malformations typical of trisomy 18"
      ]
    }
  ],
