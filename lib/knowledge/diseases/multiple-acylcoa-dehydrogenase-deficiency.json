  "keyFindings": {
    "laboratory": [
      "Elevated plasma acylcarnitines (C4-C18 species)",
      "Increased urinary glutaric acid and other organic acids",
      "Hypoglycemia with metabolic acidosis"
    ],
    "imaging": [
      "Muscle MRI showing lipid accumulation",
      "Echocardiogram demonstrating cardiomyopathy"
    ],
    "genetic": [
      "Pathogenic variants in ETFA, ETFB, or ETFDH genes"
    ],
    "other": [
      "Muscle biopsy showing lipid storage and ragged red fibers",
      "Positive response to riboflavin supplementation in some cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "medium-chain-acyl-coa-dehydrogenase-deficiency",
      "distinguishingFeatures": [
        "Typically presents with hypoketotic hypoglycemia without amino acid metabolism defects",
        "No involvement of multiple acyl-CoA dehydrogenases"
      ]
    },
    {
      "diseaseId": "carnitine-palmitoyltransferase-deficiency",
      "distinguishingFeatures": [
        "Primarily affects long-chain fatty acid oxidation",
        "Usually presents with exercise-induced rhabdomyolysis without metabolic acidosis"
      ]
    }
  ],
  "redFlags": [
    "Severe hypoglycemia unresponsive to glucose administration",
    "Rapid onset metabolic acidosis with muscle weakness",
    "Cardiomyopathy in a neonate or infant"
  ],
