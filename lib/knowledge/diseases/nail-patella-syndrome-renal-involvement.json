  "diagnosticCriteria": {
    "formalCriteriaName": "Nail-Patella Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "nail-dysplasia",
        "description": "Presence of nail abnormalities including absent, hypoplastic, or dystrophic nails",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "patellar-hypoplasia",
        "description": "Hypoplasia or aplasia of the patella confirmed by clinical examination or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-involvement",
        "description": "Evidence of renal disease such as proteinuria or progressive renal failure",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "iliac-horns",
        "description": "Radiographic presence of bilateral iliac horns",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of nail dysplasia and patellar hypoplasia with or without renal involvement",
    "notes": "Genetic testing for LMX1B mutations can confirm diagnosis"
  },
