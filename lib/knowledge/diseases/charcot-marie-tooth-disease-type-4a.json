  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and electrophysiological criteria for CMT4A",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Symmetric distal muscle weakness and atrophy predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies showing severely reduced motor and sensory nerve conduction velocities consistent with demyelinating neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the GDAP1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consistent autosomal recessive inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Onion bulb formations and demyelination on nerve biopsy (if performed)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features, supportive electrophysiological findings, and confirmation by genetic testing",
    "notes": "Genetic confirmation is considered definitive; nerve biopsy is rarely required."
  },
