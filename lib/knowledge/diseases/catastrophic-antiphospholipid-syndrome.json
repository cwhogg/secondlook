  "diagnosticCriteria": {
    "formalCriteriaName": "Preliminary criteria for Catastrophic Antiphospholipid Syndrome",
    "criteria": [
      {
        "id": "multiorgan-thrombosis",
        "description": "Evidence of thrombosis involving three or more organs, systems, or tissues",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rapid-onset",
        "description": "Development of manifestations simultaneously or in less than one week",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "antiphospholipid-antibodies",
        "description": "Laboratory confirmation of antiphospholipid antibodies (lupus anticoagulant, anticardiolipin, or anti-β2 glycoprotein I antibodies)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathologic-confirmation",
        "description": "Histopathologic evidence of small vessel occlusion in at least one organ or tissue",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: multiorgan thrombosis, rapid onset, and positive antiphospholipid antibodies",
    "notes": "Diagnosis requires exclusion of other thrombotic microangiopathies and sepsis."
  },
