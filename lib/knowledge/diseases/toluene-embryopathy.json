  "keyFindings": {
    "laboratory": [
      "No specific laboratory biomarker; toxicology may detect toluene metabolites in maternal samples"
    ],
    "imaging": [
      "Brain MRI may show microcephaly and delayed myelination",
      "Echocardiogram may reveal septal defects"
    ],
    "genetic": [
      "No known genetic mutations; diagnosis based on exposure and phenotype"
    ],
    "other": [
      "Maternal history of solvent abuse during pregnancy is critical for diagnosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "fetal-alcohol-spectrum-disorder",
      "distinguishingFeatures": [
        "History of maternal alcohol use rather than solvent exposure",
        "Characteristic facial features differ (e.g., smooth philtrum, thin upper lip)"
      ]
    },
    {
      "diseaseId": "cornelia-de-lange-syndrome",
      "distinguishingFeatures": [
        "Distinctive limb malformations and facial features",
        "Genetic testing positive for NIPBL or related gene mutations"
      ]
    }
  ],
  "redFlags": [
    "Confirmed maternal toluene solvent abuse during pregnancy",
