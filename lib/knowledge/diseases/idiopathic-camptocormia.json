  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Normal inflammatory markers",
      "Creatine kinase usually normal or mildly elevated"
    ],
    "imaging": [
      "MRI showing fatty infiltration and atrophy of paraspinal muscles",
      "X-ray demonstrating marked thoracolumbar flexion",
      "No structural vertebral abnormalities"
    ],
    "genetic": [
      "No known genetic mutations associated"
    ],
    "other": [
      "Electromyography showing myopathic changes in paraspinal muscles",
      "Muscle biopsy with nonspecific myopathic features"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "parkinson-disease",
      "distinguishingFeatures": [
        "Presence of bradykinesia, resting tremor, rigidity",
        "Camptocormia often accompanied by other extrapyramidal signs",
        "Poor reversibility of spinal flexion when supine"
      ]
    },
    {
      "diseaseId": "dystonic-camptocormia",
      "distinguishingFeatures": [
        "Involuntary sustained muscle contractions causing abnormal posture",
        "Presence of other dystonic movements",
        "EMG showing dystonic muscle activity"
      ]
    },
    {
      "diseaseId": "myopathic-camptocormia",
      "distinguishingFeatures": [
        "Identifiable primary myopathy on muscle biopsy",
        "Elevated creatine kinase levels",
        "Progressive muscle weakness beyond paraspinal muscles"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive spinal flexion",
    "Severe respiratory compromise",
    "Presence of neurological deficits beyond postural abnormalities"
  ],
