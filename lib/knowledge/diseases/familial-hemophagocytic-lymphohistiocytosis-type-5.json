  "keyFindings": {
    "laboratory": [
      "Elevated serum ferritin",
      "Cytopenias in ≥2 cell lines",
      "Hypertriglyceridemia and/or hypofibrinogenemia",
      "Elevated soluble CD25 (sIL-2 receptor)",
      "Decreased NK cell activity"
    ],
    "imaging": [
      "Hepatosplenomegaly on abdominal ultrasound or CT",
      "Lymphadenopathy on imaging",
      "Pulmonary infiltrates on chest X-ray or CT"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Hemophagocytosis observed in bone marrow, spleen, or lymph node biopsy"
    ]
  },
