  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and biochemical diagnostic criteria for Rhizomelic Chondrodysplasia Punctata",
    "criteria": [
      {
        "id": "rhizomelia",
        "description": "Bilateral proximal limb shortening (rhizomelia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chondrodysplasia-punctata",
        "description": "Epiphyseal stippling (punctate calcifications) visible on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peroxisomal-dysfunction",
        "description": "Biochemical evidence of peroxisomal dysfunction including reduced plasmalogens and elevated phytanic acid",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia and depressed nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cataracts",
        "description": "Congenital cataracts detected on ophthalmologic exam",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of rhizomelia and chondrodysplasia punctata on imaging plus biochemical evidence of peroxisomal dysfunction",
    "notes": "Genetic testing for PEX7 mutations can confirm diagnosis"
  },
