  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific biochemical markers"
    ],
    "imaging": [
      "Brain MRI may show nonspecific findings such as mild cerebral atrophy or white matter abnormalities",
      "Echocardiogram may detect congenital heart defects"
    ],
    "genetic": [
      "Heterozygous deletion of approximately 1.6 Mb at chromosome 3q29 detected by chromosomal microarray or FISH",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Neuropsychological testing reveals intellectual disability and developmental delays"
    ]
  },
