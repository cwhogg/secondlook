  "diagnosticCriteria": {
    "formalCriteriaName": "Osteopenia-Intellectual Disability-Sparse Hair Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "osteopenia",
        "description": "Radiologically confirmed osteopenia or low bone mineral density",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability confirmed by neuropsychological assessment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sparse-hair",
        "description": "Clinically evident sparse, thin, or brittle scalp hair",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Presence of characteristic facial features including frontal bossing and midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: osteopenia, intellectual disability, and sparse hair",
    "notes": "Diagnosis is clinical supported by radiological and neuropsychological findings; genetic testing may assist but is not definitive."
  },
