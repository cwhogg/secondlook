  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for X-linked Charcot-Marie-Tooth disease type 6",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of progressive distal muscle weakness and atrophy predominantly in lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies showing intermediate to demyelinating sensorimotor peripheral neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in the PRPS1 gene associated with CMTX6",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "X-linked inheritance pattern with affected male relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-otosclerosis",
        "description": "Sensorineural hearing loss in some affected individuals",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal neuropathy with supportive electrophysiological findings plus identification of pathogenic PRPS1 mutation",
    "notes": "Genetic confirmation is essential due to phenotypic overlap with other CMT subtypes."
  },
