  "diagnosticCriteria": {
    "formalCriteriaName": "AVED Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with onset in childhood or adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-vitamin-e",
        "description": "Markedly reduced serum vitamin E levels in the absence of fat malabsorption",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tTPA-gene-mutation",
        "description": "Identification of pathogenic mutations in the TTPA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Peripheral sensory neuropathy demonstrated by nerve conduction studies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-vitamin-e",
        "description": "Clinical improvement or stabilization with high-dose vitamin E supplementation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia, low serum vitamin E without malabsorption, and pathogenic TTPA gene mutations",
    "notes": "Early diagnosis is critical to prevent irreversible neurological damage."
  },
