  "diagnosticCriteria": {
    "formalCriteriaName": "Wild-type ATTR Amyloidosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "amyloid-confirmation",
        "description": "Histological confirmation of amyloid deposits with Congo red staining and apple-green birefringence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ttr-typing",
        "description": "Immunohistochemical or mass spectrometry confirmation of transthyretin as amyloid fibril protein",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-mutations",
        "description": "Genetic testing confirming absence of pathogenic TTR mutations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features such as restrictive cardiomyopathy and carpal tunnel syndrome in elderly patients",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histological confirmation of amyloid deposits with transthyretin typing and absence of TTR mutations",
    "notes": "Diagnosis requires exclusion of hereditary ATTR amyloidosis by genetic testing."
  },
