  "keyFindings": {
    "laboratory": [
      "Low beta-galactosidase enzyme activity in leukocytes or fibroblasts",
      "Elevated urinary oligosaccharides and glycosaminoglycans"
    ],
    "imaging": [
      "Brain MRI showing cerebral and cerebellar atrophy",
      "Skeletal X-rays demonstrating dysostosis multiplex"
    ],
    "genetic": [
      "Pathogenic mutations in the GLB1 gene",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Presence of cherry-red macular spots on ophthalmologic examination"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "tay-sachs-disease",
      "distinguishingFeatures": [
        "Hexosaminidase A deficiency",
        "Absence of hepatosplenomegaly",
        "More prominent startle response"
      ]
    },
    {
      "diseaseId": "sandhoff-disease",
      "distinguishingFeatures": [
        "Deficiency of both hexosaminidase A and B",
        "Similar neurodegeneration but earlier onset",
        "Presence of visceral involvement less common"
      ]
    }
  ],
  "redFlags": [
    "Rapid developmental regression in infancy",
    "Presence of cherry-red macular spot",
    "Progressive hepatosplenomegaly with neurological decline"
  ],
