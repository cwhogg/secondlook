  "diagnosticCriteria": {
    "formalCriteriaName": "7q11.23 Microduplication Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of a microduplication at chromosome 7q11.23 confirmed by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "speech-language-impairment",
        "description": "Significant speech and language impairment or delay",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Infantile hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-issues",
        "description": "Behavioral abnormalities including autism spectrum disorder features or anxiety",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 7q11.23 microduplication plus at least one major clinical feature such as developmental delay or intellectual disability",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features are variable and supportive."
  },
