  "differentialDiagnoses": [
    {
      "diseaseId": "kyphoscoliotic-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Severe congenital hypotonia with progressive scoliosis",
        "Lysyl hydroxylase deficiency",
        "Absence of distal joint contractures"
      ]
    },
    {
      "diseaseId": "classical-ehlers-danlos-syndrome",
      "distinguishingFeatures": [
        "Marked skin hyperextensibility and atrophic scarring",
        "Joint hypermobility without congenital contractures",
        "Mutations in COL5A1 or COL5A2 genes"
      ]
    }
  ],
