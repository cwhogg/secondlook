  "diagnosticCriteria": {
    "formalCriteriaName": "Pseudo-von Willebrand Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-bleeding",
        "description": "Mucocutaneous bleeding symptoms such as epistaxis, menorrhagia, and easy bruising",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "platelet-vwf-binding",
        "description": "Increased platelet binding to von Willebrand factor demonstrated by ristocetin-induced platelet aggregation at low ristocetin concentrations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vwd-factor-levels",
        "description": "Normal or elevated plasma von Willebrand factor antigen and activity levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of gain-of-function mutations in the platelet glycoprotein Ib alpha (GP1BA) gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclude-vwd",
        "description": "Exclusion of classic von Willebrand disease by normal multimer analysis and absence of VWF gene mutations",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of mucocutaneous bleeding symptoms plus demonstration of increased platelet binding to VWF with supportive genetic testing and exclusion of classic VWD",
    "notes": "Diagnosis requires specialized platelet function testing and genetic analysis to differentiate from classic von Willebrand disease."
  },
