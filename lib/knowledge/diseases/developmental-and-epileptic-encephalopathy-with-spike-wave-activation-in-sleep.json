  "keyFindings": {
    "laboratory": [
      "Normal routine metabolic screening in most cases",
      "Occasional mild elevation of lactate or ammonia if mitochondrial involvement"
    ],
    "imaging": [
      "Brain MRI often normal or shows mild cerebral atrophy",
      "Occasional delayed myelination or cortical dysplasia"
    ],
    "genetic": [
      "GRIN2A (causative)",
      "FRRS1L (candidate)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "EEG with characteristic spike-wave activation during non-REM sleep",
      "Developmental regression temporally associated with seizure onset"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "west-syndrome",
      "distinguishingFeatures": [
        "Infantile spasms with hypsarrhythmia on EEG rather than spike-wave activation in sleep",
        "Onset typically before 1 year of age"
      ]
    },
    {
      "diseaseId": "landau-kleffner-syndrome",
      "distinguishingFeatures": [
        "Acquired epileptic aphasia with continuous spike-wave activity during sleep",
        "Language regression more prominent than global developmental delay"
      ]
    },
    {
      "diseaseId": "early-infantile-epileptic-encephalopathy",
      "distinguishingFeatures": [
        "Severe seizures with burst suppression EEG pattern",
        "Usually no spike-wave activation specifically linked to sleep"
      ]
    }
  ],
  "redFlags": [
    "Rapid developmental regression following seizure onset",
    "Refractory seizures despite multiple antiepileptic drugs",
    "Presence of continuous spike-wave activity during sleep on EEG"
  ],
