  "keyFindings": {
    "laboratory": [
      "Low serum gonadotropin levels (LH, FSH) consistent with hypogonadotropic hypogonadism",
      "Normal or mildly elevated lactate and pyruvate levels"
    ],
    "imaging": [
      "Brain MRI showing diffuse hypomyelination with T2 hyperintensity and T1 hypointensity",
      "Relative preservation of cerebellar white matter and corpus callosum",
      "Hypoplastic or absent gonads on pelvic ultrasound or MRI"
    ],
    "genetic": [
      "Pathogenic variants in POLR3A gene",
      "Pathogenic variants in POLR3B gene"
    ],
    "other": [
      "Dental X-rays confirming hypodontia or delayed tooth eruption"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pelizaeus-merzbacher-disease",
      "distinguishingFeatures": [
        "X-linked inheritance pattern",
        "Nystagmus and early infantile onset",
        "Absence of hypogonadotropic hypogonadism and hypodontia"
      ]
    },
    {
      "diseaseId": "leukoencephalopathy-with-vanishing-white-matter",
      "distinguishingFeatures": [
        "Progressive neurological decline with stress-induced episodes",
        "Characteristic MRI with cystic degeneration",
        "No associated hypogonadism or dental abnormalities"
      ]
    }
  ],
  "redFlags": [
