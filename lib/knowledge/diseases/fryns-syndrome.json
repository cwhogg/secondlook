  "diagnosticCriteria": {
    "formalCriteriaName": "Fryns Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "diaphragmatic-hernia",
        "description": "Congenital diaphragmatic hernia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distal-limb-hypoplasia",
        "description": "Hypoplasia or aplasia of distal phalanges and nails",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facies",
        "description": "Coarse facial features including broad nasal bridge, micrognathia, and cleft lip/palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-hypoplasia",
        "description": "Pulmonary hypoplasia or agenesis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "polyhydramnios",
        "description": "Polyhydramnios during pregnancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital diaphragmatic hernia plus at least two major criteria including distal limb hypoplasia and characteristic facial features",
    "notes": "Diagnosis is primarily clinical; genetic testing is not definitive as causative gene(s) remain unknown."
  },
