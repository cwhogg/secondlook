  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and histopathological criteria for Tateyama distal myopathy",
    "criteria": [
      {
        "id": "clinical-distal-weakness",
        "description": "Progressive distal muscle weakness predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rimmed-vacuoles-biopsy",
        "description": "Muscle biopsy showing rimmed vacuoles and myopathic changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of causative mutation in the GNE gene or associated loci",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography-findings",
        "description": "EMG showing myopathic motor unit potentials",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal muscle weakness with characteristic rimmed vacuoles on muscle biopsy; genetic confirmation supports diagnosis",
    "notes": "Genetic testing may not always identify a mutation; diagnosis relies on clinical and histopathological correlation."
  },
