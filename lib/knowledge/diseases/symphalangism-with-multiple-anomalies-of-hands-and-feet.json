        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-confirmation",
        "description": "Radiographic evidence of symphalangism and multiple digital anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of similar limb anomalies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-syndromic-features",
        "description": "Exclusion of other syndromes with limb anomalies by clinical and genetic testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital proximal interphalangeal joint fusion and polysyndactyly confirmed by radiographic imaging",
    "notes": "Genetic testing may assist but is not mandatory for diagnosis; diagnosis primarily clinical and radiological."
  },
