{
  "id": "neonatal-hemochromatosis",
  "name": "Neonatal Hemochromatosis",
  "aliases": [
    "Congenital Hemochromatosis",
    "Neonatal Iron Overload Syndrome"
  ],
  "icd10Codes": [
    "P55.0"
  ],
  "omimId": "235200",
  "orphanetId": "2381",
  "prevalence": {
    "estimate": "1 in 40,000 to 1 in 60,000 live births",
    "range": "0.0017%-0.0025%",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 28,
      "peak": 7
    },
    "sexPredilection": "equal",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Neonatal Hemochromatosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "hepatic-iron-overload",
        "description": "Evidence of severe hepatic iron overload on liver biopsy or MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "extrahepatic-iron-deposition",
        "description": "Iron deposition in extrahepatic tissues such as salivary glands or pancreas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-liver-failure",
        "description": "Clinical and laboratory evidence of acute or subacute liver failure in the neonate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "History of neonatal liver failure or fetal loss in siblings",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "serum-ferritin-elevation",
        "description": "Markedly elevated serum ferritin levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hepatic iron overload plus either extrahepatic iron deposition or clinical liver failure",
    "notes": "Diagnosis is often confirmed by histopathology and imaging; genetic testing may be supportive but not definitive."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Severe neonatal liver failure",
        "frequency": 0.9,
        "bodySystem": "gastrointestinal",
        "notes": "Rapid onset in first weeks of life"
      },
      {
        "symptomName": "Extrahepatic iron deposition",
        "frequency": 0.85,
        "bodySystem": "gastrointestinal",
        "notes": "Detected by biopsy or MRI in tissues such as salivary glands"
      },
      {
        "symptomName": "Marked hyperferritinemia",
        "frequency": 0.75,
        "bodySystem": "hematological",
        "notes": "Serum ferritin often >1000 ng/mL"
      }
    ],
    "common": [
      {
        "symptomName": "Jaundice",
        "frequency": 0.85,
        "bodySystem": "gastrointestinal",
        "notes": "Due to cholestasis and liver dysfunction"
      },
      {
        "symptomName": "Hepatomegaly",
        "frequency": 0.8,
        "bodySystem": "gastrointestinal",
        "notes": "Enlarged liver on physical exam"
      },
      {
        "symptomName": "Ascites",
        "frequency": 0.7,
        "bodySystem": "gastrointestinal",
        "notes": "Due to portal hypertension and liver failure"
      },
      {
        "symptomName": "Coagulopathy",
        "frequency": 0.65,
        "bodySystem": "hematological",
        "notes": "Prolonged PT/INR from liver synthetic failure"
      },
      {
        "symptomName": "Edema",
        "frequency": 0.6,
        "bodySystem": "constitutional",
        "notes": "Peripheral edema from hypoalbuminemia"
      }
    ],
    "occasional": [
      {
        "symptomName": "Hypoglycemia",
        "frequency": 0.4,
        "bodySystem": "endocrine",
        "notes": "Due to impaired gluconeogenesis"
      },
      {
        "symptomName": "Failure to thrive",
        "frequency": 0.35,
        "bodySystem": "constitutional",
        "notes": "Poor feeding and weight gain"
      },
      {
        "symptomName": "Splenomegaly",
        "frequency": 0.3,
        "bodySystem": "hematological",
        "notes": "Secondary to portal hypertension"
      },
      {
        "symptomName": "Hypotonia",
        "frequency": 0.25,
        "bodySystem": "neurological",
        "notes": "Due to metabolic disturbances"
      },
      {
        "symptomName": "Respiratory distress",
        "frequency": 0.2,
        "bodySystem": "respiratory",
        "notes": "Secondary to ascites or systemic illness"
      }
    ],
    "rare": [
      {
        "symptomName": "Cardiomyopathy",
        "frequency": 0.08,
        "bodySystem": "cardiovascular",
        "notes": "Iron deposition may affect myocardium"
      },
      {
        "symptomName": "Hypothyroidism",
        "frequency": 0.06,
        "bodySystem": "endocrine",
        "notes": "Rare involvement of thyroid gland"
      },
      {
        "symptomName": "Neurological impairment",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Secondary to metabolic encephalopathy"
      }
    ]
  },
  "systemsAffected": [
    "gastrointestinal",
    "hematological",
    "endocrine",
    "neurological",
    "cardiovascular",
    "respiratory",
    "constitutional"
  ],
  "keyFindings": {
    "laboratory": [
      "Markedly elevated serum ferritin",
      "Elevated liver transaminases (AST, ALT)",
      "Coagulopathy with prolonged PT/INR",
      "Hypoglycemia",
      "Hyperbilirubinemia"
    ],
    "imaging": [
      "MRI showing hepatic and extrahepatic iron deposition",
      "Ultrasound demonstrating hepatomegaly and ascites"
    ],
    "genetic": [
      "No consistent single gene mutation; often associated with alloimmune mechanisms",
      "Genetic testing may exclude hereditary hemochromatosis"
    ],
    "other": [
      "Liver biopsy showing extensive iron deposition in hepatocytes and Kupffer cells",
      "Salivary gland biopsy positive for iron deposition"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hereditary-hemochromatosis",
      "distinguishingFeatures": [
        "Later onset (adolescence or adulthood)",
        "Genetic mutations in HFE gene",
        "Lack of neonatal liver failure"
      ]
    },
    {
      "diseaseId": "galactosemia",
      "distinguishingFeatures": [
        "Positive reducing substances in urine",
        "Elevated galactose metabolites",
        "No iron overload"
      ]
    },
    {
      "diseaseId": "neonatal hepatitis",
      "distinguishingFeatures": [
        "Absence of iron overload on biopsy",
        "Variable etiology including infections",
        "Slower progression of liver failure"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive liver failure in first month of life",
    "Marked hyperferritinemia with multi-organ iron deposition",
    "Family history of neonatal liver failure or fetal loss"
  ],
  "specialistType": [
    "Pediatric Hepatologist",
    "Neonatologist",
    "Geneticist"
  ],
