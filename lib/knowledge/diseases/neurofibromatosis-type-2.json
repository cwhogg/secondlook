  "diagnosticCriteria": {
    "formalCriteriaName": "Manchester Criteria for NF2 (Updated 2022)",
    "criteria": [
      {
        "id": "nf2-c1",
        "description": "Bilateral vestibular schwannomas (VS)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "nf2-c2",
        "description": "First-degree relative with NF2 AND unilateral VS or any 2 of: meningioma, schwannoma, glioma, neurofibroma, posterior subcapsular lenticular opacity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "nf2-c3",
        "description": "Unilateral VS AND any 2 of: meningioma, schwannoma, glioma, neurofibroma, posterior subcapsular lenticular opacity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "nf2-c4",
        "description": "Multiple meningiomas AND unilateral VS or any 2 of: schwannoma, glioma, neurofibroma, posterior subcapsular lenticular opacity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "nf2-c5",
        "description": "Pathogenic constitutional NF2 (merlin) gene mutation",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Meeting any one of the above criteria. Bilateral vestibular schwannomas alone are sufficient. Gene-based criteria using NF2 mutation are sufficient.",
    "notes": "NF2 was reclassified in 2022 as NF2-related schwannomatosis. Very different from NF1 despite similar name. ~50% de novo. Mosaicism common (~25-33% of de novo cases)."
  },
