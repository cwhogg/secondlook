  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Microcephaly-Cardiomyopathy Syndrome",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Congenital microcephaly defined as head circumference more than 3 standard deviations below the mean for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiomyopathy",
        "description": "Presence of dilated or hypertrophic cardiomyopathy confirmed by echocardiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent forehead and micrognathia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with microcephaly and cardiomyopathy (e.g., PRDM16 mutations)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital microcephaly and cardiomyopathy confirmed by imaging, with or without genetic confirmation",
    "notes": "Genetic testing is recommended but not mandatory for diagnosis. Clinical presentation may vary."
  },
