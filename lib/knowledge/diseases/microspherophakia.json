  "diagnosticCriteria": {
    "formalCriteriaName": "Microspherophakia Diagnostic Criteria",
    "criteria": [
      {
        "id": "lens-size-shape",
        "description": "Presence of a small, spherical crystalline lens on slit-lamp examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lens-dislocation",
        "description": "Lens subluxation or dislocation observed clinically or by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glaucoma",
        "description": "Secondary glaucoma due to pupillary block or angle closure",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of microspherophakia or related syndromes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "associated-syndromes",
        "description": "Presence of systemic features suggestive of Weill-Marchesani syndrome or other connective tissue disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of a small spherical lens with lens subluxation or dislocation",
    "notes": "Diagnosis is primarily clinical supported by slit-lamp examination and imaging; genetic testing may assist in syndromic cases."
  },
