  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Audiometry confirming sensorineural hearing loss"
    ],
    "imaging": [
      "Radiographs showing preaxial brachydactyly with shortened metacarpals and phalanges",
      "CT or MRI of temporal bones may show inner ear anomalies",
      "Echocardiogram if cardiac defects suspected"
    ],
    "genetic": [
      "CHSY1 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Clinical examination revealing characteristic facial features and limb anomalies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "greig-cephalopolysyndactyly-syndrome",
