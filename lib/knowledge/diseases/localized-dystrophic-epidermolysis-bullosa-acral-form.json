  "differentialDiagnoses": [
    {
      "diseaseId": "epidermolysis-bullosa-simplex",
      "distinguishingFeatures": [
        "Blistering occurs intraepidermally rather than sublamina densa",
        "Usually generalized rather than localized acral distribution",
        "Mutations in keratin genes (KRT5, KRT14) instead of COL7A1"
      ]
    },
    {
      "diseaseId": "junctional-epidermolysis-bullosa",
      "distinguishingFeatures": [
        "Blistering occurs within lamina lucida",
        "Often more severe mucosal involvement",
        "Mutations in genes encoding laminin-332 or integrins"
      ]
    }
  ],
  "redFlags": [
