        "description": "Mild skeletal dysplasia including short stature and limb anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (cutaneous hypoplasia and dental anomalies) with or without minor criteria",
    "notes": "Genetic testing may support diagnosis but is not mandatory."
