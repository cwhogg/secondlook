  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for NSHPT",
    "criteria": [
      {
        "id": "hypercalcemia",
        "description": "Marked hypercalcemia typically >3.5 mmol/L in neonates",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-pth",
        "description": "Elevated serum parathyroid hormone (PTH) levels disproportionate to calcium levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Neonatal onset of symptoms including hypotonia, respiratory distress, and failure to thrive",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of homozygous or compound heterozygous inactivating mutations in the calcium-sensing receptor (CASR) gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiologic-findings",
        "description": "Radiographic evidence of subperiosteal bone resorption and osteopenia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of marked hypercalcemia with elevated PTH in a neonate presenting with clinical symptoms consistent with NSHPT",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory for initial clinical diagnosis."
  },
