  "diagnosticCriteria": {
    "formalCriteriaName": "Myeloperoxidase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced or absent myeloperoxidase enzyme activity in neutrophils",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neutrophil-function",
        "description": "Impaired microbial killing demonstrated by functional neutrophil assays",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-infections",
        "description": "Recurrent fungal infections, especially candidiasis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the MPO gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced or absent myeloperoxidase enzyme activity plus recurrent fungal infections",
    "notes": "Genetic testing and neutrophil functional assays support diagnosis but are not mandatory."
  },
