  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electrophysiological Diagnostic Criteria for Myotonia Congenita",
    "criteria": [
      {
        "id": "clinical-myotonia",
        "description": "Presence of clinical myotonia characterized by delayed muscle relaxation after voluntary contraction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography-myotonic-discharges",
        "description": "Electromyographic evidence of myotonic discharges in affected muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the CLCN1 gene encoding the skeletal muscle chloride channel",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant or recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-weakness",
        "description": "Presence of transient or permanent muscle weakness, especially after rest",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical myotonia plus either electromyographic myotonic discharges or pathogenic CLCN1 gene mutation",
    "notes": "Genetic testing is confirmatory; electromyography is essential for diagnosis in ambiguous cases."
  },
