  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Microphthalmia with Brain and Digit Anomalies",
    "criteria": [
      {
        "id": "microphthalmia",
        "description": "Presence of unilateral or bilateral microphthalmia confirmed by ophthalmologic examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-anomalies",
        "description": "Structural brain anomalies detected by neuroimaging, including agenesis or hypoplasia of corpus callosum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digit-malformations",
        "description": "Presence of digital anomalies such as syndactyly, polydactyly, or brachydactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including micrognathia and low-set ears",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microphthalmia plus at least one major anomaly in brain structure and one major digital anomaly",
    "notes": "Diagnosis is clinical supported by neuroimaging and genetic testing when available."
  },
