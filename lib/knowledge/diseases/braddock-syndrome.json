  "diagnosticCriteria": {
    "formalCriteriaName": "Braddock Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including midface hypoplasia and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-neurological-decline",
        "description": "Progressive neurological deterioration with spasticity and ataxia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-hyperpigmentation",
        "description": "Diffuse cutaneous hyperpigmentation with café-au-lait spots",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in the BRDCK1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of all major criteria including craniofacial dysmorphism, progressive neurological decline, and pathogenic BRDCK1 mutation",
    "notes": "Genetic testing is critical for confirmation; clinical presentation may vary."
  },
