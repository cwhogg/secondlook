  "diagnosticCriteria": {
    "formalCriteriaName": "Eurofever/PRINTO Classification Criteria (2019)",
    "criteria": [
      {
        "id": "traps-maj1",
        "description": "Recurrent febrile episodes lasting >= 7 days (typically 1-4 weeks)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "traps-maj2",
        "description": "Confirmed pathogenic TNFRSF1A mutation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "traps-min1",
        "description": "Migratory myalgia/rash (centrifugal spreading erythematous patches)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "traps-min2",
        "description": "Periorbital edema",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "traps-min3",
        "description": "Family history of recurrent febrile episodes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "traps-min4",
        "description": "Abdominal pain, pleuritis, arthralgia during episodes",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Eurofever criteria: TNFRSF1A pathogenic mutation plus compatible clinical features. Clinical suspicion based on recurrent febrile episodes >7 days duration with migratory rash, periorbital edema, and myalgia.",
    "notes": "Autosomal dominant inheritance. Attacks typically last 1-4 weeks (longer than FMF). R92Q and P46L are low-penetrance variants with uncertain pathogenicity."
  },
