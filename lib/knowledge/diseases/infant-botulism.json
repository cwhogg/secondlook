  "diagnosticCriteria": {
    "formalCriteriaName": "Infant Botulism Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive hypotonia and bulbar palsy in an infant under 12 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "laboratory-confirmation",
        "description": "Isolation of Clostridium botulinum spores or toxin from stool or intestinal samples",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiological-findings",
        "description": "Electromyography showing characteristic incremental response to repetitive nerve stimulation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus laboratory confirmation of botulinum toxin or spores",
    "notes": "Early diagnosis is critical to initiate appropriate treatment and reduce morbidity."
  },
