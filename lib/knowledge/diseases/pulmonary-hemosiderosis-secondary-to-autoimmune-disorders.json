  "diagnosticCriteria": {
    "formalCriteriaName": "No formal standardized criteria; diagnosis based on clinical, radiological, and histopathological findings",
    "criteria": [
      {
        "id": "alveolar-hemorrhage",
        "description": "Recurrent or persistent alveolar hemorrhage confirmed by bronchoalveolar lavage or lung biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemosiderin-laden-macrophages",
        "description": "Presence of hemosiderin-laden macrophages in sputum, bronchoalveolar lavage fluid, or lung tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoimmune-markers",
        "description": "Positive autoimmune serologies (e.g., ANA, anti-GBM antibodies, ANCA) indicating underlying autoimmune disorder",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of pulmonary hemorrhage such as infections, coagulopathies, or cardiac disease",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent alveolar hemorrhage with hemosiderin-laden macrophages and positive autoimmune serology after exclusion of other causes",
    "notes": "Lung biopsy may be required in uncertain cases; diagnosis often requires multidisciplinary evaluation"
  },
