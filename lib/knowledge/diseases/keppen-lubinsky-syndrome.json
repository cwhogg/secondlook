  "diagnosticCriteria": {
    "formalCriteriaName": "Keppen-Lubinsky Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "lipodystrophy",
        "description": "Severe progressive lipodystrophy predominantly affecting the face and extremities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including microcephaly, prominent nasal bridge, and thin nose",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Severe postnatal growth retardation and failure to thrive",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-impairment",
        "description": "Developmental delay and intellectual disability of variable severity",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skin-thinning",
        "description": "Thin, translucent skin with visible veins",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: severe progressive lipodystrophy, characteristic craniofacial dysmorphism, and severe postnatal growth retardation",
    "notes": "Genetic testing for mutations in the PCYT1A gene can support diagnosis but is not mandatory."
  },
