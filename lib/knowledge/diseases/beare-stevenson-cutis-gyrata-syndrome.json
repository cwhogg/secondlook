  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Genetic testing revealing FGFR2 pathogenic variants"
    ],
    "imaging": [
      "CT scan showing premature cranial suture fusion",
      "MRI for evaluation of hydrocephalus or brain anomalies",
      "X-rays demonstrating craniosynostosis and midface hypoplasia"
    ],
    "genetic": [
      "Autosomal dominant mutations in FGFR2 gene, commonly p.Tyr375Cys"
    ],
    "other": [
      "Skin biopsy showing thickened dermis with increased collagen",
      "Clinical photographic documentation of cutis gyrata"
    ]
