  "keyFindings": {
    "laboratory": [
      "MPO-ANCA (p-ANCA) positive (60-70%)",
      "Elevated serum creatinine with active urine sediment",
      "Proteinuria and hematuria with RBC casts",
      "Elevated ESR and CRP",
      "Anemia (often from renal failure or hemorrhage)",
      "PR3-ANCA can be positive in ~20%"
    ],
    "imaging": [
      "Chest CT: ground-glass opacities (alveolar hemorrhage), interstitial fibrosis (UIP or NSIP pattern)",
      "Chest X-ray: bilateral alveolar infiltrates in DAH",
      "Renal ultrasound: normal or slightly enlarged kidneys initially"
    ],
    "genetic": [
      "HLA-DQ association",
      "SERPINA1 gene variants"
    ],
    "other": [
      "Renal biopsy: pauci-immune necrotizing and crescentic glomerulonephritis",
      "Lung biopsy: capillaritis without granulomas",
      "Skin biopsy: leukocytoclastic vasculitis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "granulomatosis-with-polyangiitis",
      "distinguishingFeatures": [
        "Granulomatous inflammation on biopsy",
        "ENT involvement (sinusitis, saddle nose)",
        "PR3-ANCA predominant",
        "Cavitating pulmonary nodules"
      ]
    },
    {
      "diseaseId": "anti-gbm-disease",
      "distinguishingFeatures": [
        "Anti-GBM antibodies",
        "Linear IgG on renal biopsy",
        "Can coexist with MPA (double-positive)"
      ]
    },
    {
      "diseaseId": "polyarteritis-nodosa",
      "distinguishingFeatures": [
        "Medium vessel involvement",
        "Microaneurysms on angiography",
        "ANCA negative",
        "No glomerulonephritis"
      ]
    },
    {
      "diseaseId": "iga-vasculitis",
      "distinguishingFeatures": [
        "IgA deposits on biopsy",
        "Younger patients",
        "Palpable purpura with abdominal pain"
      ]
    }
  ],
  "redFlags": [
    "Rapidly rising creatinine with active urine sediment",
    "Hemoptysis with falling hemoglobin (diffuse alveolar hemorrhage)",
    "Pulmonary-renal syndrome",
    "Acute respiratory failure requiring intubation",
    "Oliguria/anuria suggesting rapidly progressive GN"
  ],
