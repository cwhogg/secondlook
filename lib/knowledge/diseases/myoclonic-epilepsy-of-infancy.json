  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Myoclonic Epilepsy of Infancy",
    "criteria": [
      {
        "id": "onset-age",
        "description": "Onset of myoclonic seizures between 3 and 12 months of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizure-type",
        "description": "Presence of myoclonic seizures characterized by sudden, brief, involuntary muscle jerks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eeg-pattern",
        "description": "Electroencephalogram (EEG) showing generalized spike-and-wave or polyspike-and-wave discharges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-development",
        "description": "Normal psychomotor development prior to seizure onset",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-causes",
        "description": "Exclusion of other metabolic, structural, or genetic causes of epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of myoclonic seizures with onset between 3 and 12 months, characteristic EEG findings, and exclusion of other causes",
    "notes": "Diagnosis is clinical and supported by EEG; genetic testing may aid in differential diagnosis."
  },
