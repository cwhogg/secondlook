  "diagnosticCriteria": {
    "formalCriteriaName": "Guadalajara Type 3 Camptodactyly Diagnostic Criteria",
    "criteria": [
      {
        "id": "camptodactyly",
        "description": "Congenital flexion deformity of one or more fingers (camptodactyly)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features including micrognathia and downslanting palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-stature",
        "description": "Postnatal short stature with normal intelligence",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-anomalies",
        "description": "Additional skeletal anomalies such as scoliosis or clinodactyly",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital camptodactyly plus at least one major criterion (facial dysmorphism) or two minor/supportive criteria",
    "notes": "Diagnosis is clinical; genetic testing may support but is not definitive."
  },
