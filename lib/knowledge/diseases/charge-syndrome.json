  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible hormonal abnormalities related to hypogonadism"
    ],
    "imaging": [
      "Ocular ultrasound or MRI showing coloboma",
      "CT or MRI confirming choanal atresia",
      "Echocardiography revealing congenital heart defects",
      "Brain MRI showing cranial nerve anomalies"
    ],
    "genetic": [
      "Pathogenic variants in CHD7 gene detected by molecular genetic testing"
    ],
    "other": [
      "Audiological evaluation confirming sensorineural or conductive hearing loss",
      "Endocrine evaluation for hypogonadism"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "22q11-deletion-syndrome",
      "distinguishingFeatures": [
        "Absence of coloboma",
        "Characteristic facial features different from CHARGE",
        "Hypocalcemia and immunodeficiency more common"
      ]
    },
    {
      "diseaseId": "vacterl-association",
      "distinguishingFeatures": [
        "Vertebral anomalies, anal atresia, cardiac defects, tracheoesophageal fistula",
        "Lack of coloboma and choanal atresia",
        "No CHD7 mutation"
      ]
    }
  ],
