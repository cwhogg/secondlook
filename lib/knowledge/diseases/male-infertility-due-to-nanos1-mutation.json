  "diagnosticCriteria": {
    "formalCriteriaName": "NANOS1 Mutation Male Infertility Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic or likely pathogenic mutation in the NANOS1 gene by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "azoospermia-or-oligozoospermia",
        "description": "Presence of azoospermia or severe oligozoospermia confirmed by semen analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other known causes of male infertility such as obstructive azoospermia, hormonal imbalances, or chromosomal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "testicular-histopathology",
        "description": "Testicular biopsy showing impaired spermatogenesis or Sertoli cell-only syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic NANOS1 mutation plus azoospermia or severe oligozoospermia with exclusion of other causes",
    "notes": "Genetic counseling is recommended for affected individuals and families."
  },
