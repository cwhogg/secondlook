  "diagnosticCriteria": {
    "formalCriteriaName": "Nasu-Hakola Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in TREM2 or TYROBP genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-neuropsychiatric",
        "description": "Progressive presenile dementia with frontal lobe syndrome",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-bone-cysts",
        "description": "Multiple bilateral cystic lesions in the appendicular skeleton on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "leukoencephalopathy-mri",
        "description": "White matter abnormalities consistent with sclerosing leukoencephalopathy on brain MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or affected siblings with similar clinical features",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive presenile dementia with frontal lobe syndrome, characteristic bilateral bone cysts on imaging, and confirmation of pathogenic variants in TREM2 or TYROBP genes",
    "notes": "Diagnosis requires integration of clinical, radiological, and genetic findings."
  },
