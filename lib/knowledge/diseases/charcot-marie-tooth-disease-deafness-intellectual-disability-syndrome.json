  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible elevated creatine kinase in some cases"
    ],
    "imaging": [
      "MRI brain usually normal or nonspecific",
      "Possible muscle MRI showing distal muscle atrophy"
    ],
    "genetic": [
      "Pathogenic variants in genes associated with Charcot-Marie-Tooth disease (e.g., PMP22, MPZ) combined with syndromic features",
      "Variants affecting genes linked to syndromic intellectual disability and deafness",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Nerve conduction studies showing demyelinating or axonal neuropathy",
      "Audiometric confirmation of sensorineural hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "charcot-marie-tooth-disease",
      "distinguishingFeatures": [
        "Absence of intellectual disability and deafness",
        "Primarily peripheral neuropathy without syndromic features"
      ]
    },
    {
      "diseaseId": "hereditary-sensory-and-autonomic-neuropathy",
      "distinguishingFeatures": [
        "Prominent sensory loss with autonomic dysfunction",
        "Usually no intellectual disability or deafness"
      ]
    },
    {
