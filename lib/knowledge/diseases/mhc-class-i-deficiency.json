  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for MHC Class I Deficiency",
    "criteria": [
      {
        "id": "low-mhc-i-expression",
        "description": "Markedly reduced or absent expression of MHC class I molecules on peripheral blood lymphocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cd8-lymphopenia",
        "description": "Significant reduction in circulating CD8+ T-cell counts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in genes involved in antigen processing (e.g., TAP1, TAP2, TAPBP)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-respiratory-infections",
        "description": "History of recurrent sinopulmonary infections",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-mhc-class-ii-expression",
        "description": "Normal expression of MHC class II molecules",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: low MHC class I expression, CD8+ T-cell deficiency, and genetic confirmation of causative mutations",
    "notes": "Diagnosis requires exclusion of other immunodeficiencies affecting T-cell subsets."
  },
