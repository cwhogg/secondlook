        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyographic evidence of chronic denervation and reinnervation consistent with motor neuron disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with autosomal dominant proximal SMA (e.g., BICD2, DYNC1H1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-sensory-involvement",
        "description": "Lack of significant sensory neuropathy on clinical and electrophysiological examination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive proximal muscle weakness with autosomal dominant family history plus confirmatory electromyography and genetic testing",
    "notes": "Diagnosis requires exclusion of other motor neuron diseases and distal SMA forms."
  },
