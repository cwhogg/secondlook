  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (CRP, ESR)",
      "Leukopenia or leukocytosis",
      "Electrolyte abnormalities secondary to fluid loss"
    ],
    "imaging": [
      "Chest X-ray may show infiltrates if respiratory involvement present"
    ],
    "genetic": [
      "HLA-B*1502 and HLA-B*5801 alleles associated with increased risk in certain populations"
    ],
    "other": [
      "Skin biopsy demonstrating full-thickness epidermal necrosis",
      "Positive Nikolsky sign on clinical examination"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "stevens-johnson-syndrome",
      "distinguishingFeatures": [
        "Epidermal detachment <10% BSA in SJS versus >30% in TEN",
        "Less extensive mucosal involvement in SJS"
      ]
    },
    {
      "diseaseId": "staphylococcal-scalded-skin-syndrome",
      "distinguishingFeatures": [
        "Occurs primarily in neonates and young children",
        "No mucosal involvement",
        "Positive bacterial cultures"
      ]
    },
    {
      "diseaseId": "pemphigus-vulgaris",
      "distinguishingFeatures": [
        "Autoimmune blistering with intraepidermal acantholysis",
        "Chronic course versus acute onset in TEN",
        "Presence of circulating anti-desmoglein antibodies"
      ]
    }
  ],
