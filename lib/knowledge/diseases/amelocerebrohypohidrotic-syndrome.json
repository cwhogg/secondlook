  "diagnosticCriteria": {
    "formalCriteriaName": "Amelocerebrohypohidrotic Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "amelogenesis-imperfecta",
        "description": "Presence of hypoplastic or hypomineralized enamel defects consistent with amelogenesis imperfecta",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-impairment",
        "description": "Developmental delay or intellectual disability with associated cerebral anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypohidrosis",
        "description": "Reduced or absent sweating leading to heat intolerance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including frontal bossing and midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consistent family history suggesting autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (amelogenesis imperfecta, neurological impairment, and hypohidrosis) must be present for diagnosis.",
    "notes": "Genetic testing may support diagnosis but is not mandatory."
  },
