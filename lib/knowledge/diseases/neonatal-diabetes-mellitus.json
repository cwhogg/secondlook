  "diagnosticCriteria": {
    "formalCriteriaName": "Neonatal Diabetes Diagnostic Criteria",
    "criteria": [
      {
        "id": "onset-age",
        "description": "Onset of hyperglycemia within the first 6 months of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "persistent-hyperglycemia",
        "description": "Persistent hyperglycemia documented on multiple occasions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in genes affecting insulin production (e.g., KCNJ11, ABCC8, INS)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-autoantibodies",
        "description": "Negative pancreatic autoantibodies (to distinguish from type 1 diabetes)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Onset of hyperglycemia before 6 months of age plus either persistent hyperglycemia or identification of a causative genetic mutation",
    "notes": "Genetic testing is critical for confirming diagnosis and guiding treatment."
  },
