  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Echocardiographic Diagnostic Criteria for Hypoplastic Right Heart Syndrome",
    "criteria": [
      {
        "id": "right-ventricle-hypoplasia",
        "description": "Underdevelopment or severe hypoplasia of the right ventricle",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-valve-atresia-or-stenosis",
        "description": "Pulmonary valve atresia or severe stenosis leading to obstruction of right ventricular outflow",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "atrial-septal-defect",
        "description": "Presence of an atrial septal defect or patent foramen ovale facilitating right-to-left shunting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cyanosis",
        "description": "Clinical evidence of central cyanosis due to right-to-left shunting",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "echocardiographic-confirmation",
        "description": "Echocardiographic confirmation of right heart structural abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of right ventricular hypoplasia, pulmonary valve atresia or stenosis, and atrial septal defect confirmed by echocardiography",
    "notes": "Diagnosis is primarily based on echocardiographic findings combined with clinical presentation of cyanosis and heart failure in neonates."
  },
