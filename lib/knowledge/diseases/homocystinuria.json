  "diagnosticCriteria": {
    "formalCriteriaName": "Biochemical and genetic criteria for classical homocystinuria",
    "criteria": [
      {
        "id": "hcu-c1",
        "description": "Markedly elevated plasma total homocysteine (typically >100 micromol/L)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hcu-c2",
        "description": "Elevated plasma methionine",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hcu-c3",
        "description": "Low or absent plasma cystathionine and cysteine",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hcu-c4",
        "description": "Positive urinary cyanide-nitroprusside test (detects disulfides including homocystine)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hcu-c5",
        "description": "Biallelic pathogenic variants in CBS gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hcu-c6",
        "description": "Reduced CBS enzyme activity in fibroblasts or liver",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hcu-c7",
        "description": "Pyridoxine (B6) responsiveness testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Markedly elevated plasma homocysteine and methionine, confirmed by CBS enzyme assay or genetic testing. Must distinguish from other causes of hyperhomocysteinemia.",
    "notes": "About 50% of patients are pyridoxine (vitamin B6) responsive, which is associated with a milder phenotype. Newborn screening can detect elevated methionine but has limited sensitivity for B6-responsive forms."
  },
