  "keyFindings": {
    "laboratory": [
      "Positive antinuclear antibodies (ANA) in 30-50% of cases",
      "Normal inflammatory markers (ESR, CRP) in most cases"
    ],
    "imaging": [
      "MRI may show soft tissue and muscle involvement underlying skin lesions",
      "X-rays can reveal bone atrophy or deformities adjacent to lesions"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy demonstrating thickened collagen bundles and dermal fibrosis",
      "Absence of systemic sclerosis features"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "systemic-sclerosis",
      "distinguishingFeatures": [
        "Presence of systemic involvement including Raynaud phenomenon",
        "Positive specific autoantibodies (e.g. anti-Scl-70, anti-centromere)",
        "Widespread skin involvement rather than linear localized plaques"
      ]
    },
    {
      "diseaseId": "morphea-generalized",
      "distinguishingFeatures": [
        "Multiple plaques with widespread distribution",
        "Lack of linear band pattern",
        "Less common in pediatric population"
      ]
    },
    {
      "diseaseId": "linear-nevus-syndrome",
      "distinguishingFeatures": [
        "Presence of epidermal nevi rather than sclerotic plaques",
        "Associated neurological abnormalities from birth",
        "Different histopathological findings"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of skin thickening with functional impairment",
    "Neurological symptoms such as seizures or hemiparesis",
    "Signs of systemic sclerosis or internal organ involvement"
  ],
  "specialistType": [
