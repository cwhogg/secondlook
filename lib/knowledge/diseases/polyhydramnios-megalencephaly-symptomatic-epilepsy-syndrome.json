  "diagnosticCriteria": {
    "formalCriteriaName": "PMSE Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "polyhydramnios",
        "description": "Prenatal polyhydramnios detected by ultrasound",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "megalencephaly",
        "description": "Postnatal megalencephaly confirmed by head circumference measurements and neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "symptomatic-epilepsy",
        "description": "Early-onset symptomatic epilepsy with refractory seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Severe global developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of homozygous mutation in LYK5 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of prenatal polyhydramnios, postnatal megalencephaly, symptomatic epilepsy, and confirmation of LYK5 gene mutation",
    "notes": "Diagnosis is confirmed by genetic testing; clinical features support diagnosis in absence of genetic confirmation"
  },
