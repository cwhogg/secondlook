        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotyping",
        "description": "Absent or markedly reduced CD8+ T cells with normal CD4+ T cell counts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Biallelic pathogenic mutations in the ZAP70 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "t-cell-function",
        "description": "Impaired T-cell receptor signaling demonstrated by functional assays",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe recurrent infections plus absent/reduced CD8+ T cells and confirmed biallelic ZAP70 mutations",
    "notes": "Diagnosis requires integration of clinical, immunophenotypic, and genetic data"
