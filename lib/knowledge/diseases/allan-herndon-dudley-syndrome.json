  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnostic criteria for Allan-Herndon-Dudley syndrome",
    "criteria": [
      {
        "id": "neurological-impairment",
        "description": "Severe psychomotor retardation with hypotonia and spasticity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thyroid-hormone-abnormalities",
        "description": "Abnormal thyroid function tests showing elevated serum T3 with low or normal T4 and TSH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "slc16a2-mutation",
        "description": "Pathogenic mutation in the SLC16A2 gene encoding the MCT8 thyroid hormone transporter",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "movement-disorder",
        "description": "Presence of dystonia, choreoathetosis, or ataxia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "delayed-milestones",
        "description": "Severe developmental delay with absent or limited speech and motor milestones",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe psychomotor retardation with characteristic thyroid hormone abnormalities and confirmed pathogenic SLC16A2 mutation",
    "notes": "Genetic testing is definitive; thyroid hormone profile is a key biochemical hallmark."
  },
