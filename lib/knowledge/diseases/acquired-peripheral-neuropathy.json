  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electrophysiological Diagnostic Criteria for Acquired Peripheral Neuropathy",
    "criteria": [
      {
        "id": "clinical-symptoms",
        "description": "Presence of distal symmetrical sensory and/or motor symptoms consistent with peripheral nerve involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies demonstrating reduced conduction velocity or amplitude consistent with axonal or demyelinating neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-hereditary",
        "description": "Absence of family history or genetic markers indicating hereditary neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "identification-of-acquired-cause",
        "description": "Identification of an underlying acquired cause such as diabetes, toxins, infections, or autoimmune disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical symptoms plus supportive electrophysiological evidence of peripheral nerve dysfunction",
    "notes": "Diagnosis requires exclusion of hereditary neuropathies and correlation with clinical context."
  },
