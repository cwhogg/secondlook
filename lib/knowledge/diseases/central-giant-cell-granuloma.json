  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological and radiographic diagnostic criteria for Central Giant Cell Granuloma",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of multinucleated giant cells in a fibroblastic stroma with hemorrhage and hemosiderin deposits on biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-appearance",
        "description": "Radiolucent, multilocular or unilocular lesion typically located in the anterior mandible or maxilla",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Slow-growing, painless swelling of the jaw with possible cortical expansion",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of multinucleated giant cells with compatible radiographic findings",
    "notes": "Diagnosis requires exclusion of other giant cell lesions such as brown tumor of hyperparathyroidism and cherubism."
  },
