  "keyFindings": {
    "laboratory": [
      "Skin biopsy may show abnormal collagen V fibrils on electron microscopy",
      "Normal inflammatory markers"
    ],
    "imaging": [
      "Echocardiography for mitral valve prolapse screening",
      "X-rays may show joint subluxation or early osteoarthritis"
    ],
    "genetic": [
      "COL5A1 mutations (most common, ~90% of molecularly confirmed cases)",
      "COL5A2 mutations (rare)",
      "COL1A1 mutations (very rare, c.934C>T specific variant)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Beighton hypermobility score assessment",
      "Skin extensibility measurement (stretch at neutral site >1.5 cm)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ehlers-danlos-hypermobile",
      "distinguishingFeatures": [
        "hEDS lacks marked skin hyperextensibility",
        "hEDS has no papyraceous scarring",
        "hEDS has no confirmatory genetic test"
      ]
    },
    {
      "diseaseId": "ehlers-danlos-vascular",
      "distinguishingFeatures": [
        "vEDS features thin translucent skin rather than hyperextensible skin",
        "vEDS has arterial/organ rupture risk",
        "vEDS confirmed by COL3A1 testing"
      ]
    },
    {
      "diseaseId": "osteogenesis-imperfecta",
      "distinguishingFeatures": [
        "OI features bone fragility and fractures",
        "OI may have blue sclerae",
        "Some overlap with rare COL1A1-related cEDS variant"
      ]
    }
  ],
  "redFlags": [
    "Arterial or organ rupture (suspect vascular EDS instead)",
    "Severe progressive scoliosis in childhood",
    "Bone fractures disproportionate to trauma (consider OI overlap)",
    "Significant surgical wound complications requiring re-operation"
  ],
