  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of metabolic or infectious causes"
    ],
    "imaging": [
      "Brain MRI usually normal between attacks",
      "Transient cortical edema or diffusion abnormalities during attacks"
    ],
    "genetic": [
      "Pathogenic mutations in CACNA1A gene"
    ],
    "other": [
      "Electroencephalogram (EEG) may show slowing during attacks"
    ]
