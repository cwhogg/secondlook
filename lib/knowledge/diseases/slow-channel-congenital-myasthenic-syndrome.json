  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electrophysiological Diagnostic Criteria for Slow-Channel CMS",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive muscle weakness with fatigability beginning in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electromyography showing prolonged endplate potentials and repetitive compound muscle action potentials",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in acetylcholine receptor subunit genes (e.g., CHRNA1, CHRNB1, CHRND, CHRNE)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-treatment",
        "description": "Poor or worsening response to acetylcholinesterase inhibitors",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Presence of endplate myopathy and postsynaptic structural abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of typical clinical presentation plus electrophysiological abnormalities and confirmation by genetic testing",
    "notes": "Diagnosis requires integration of clinical, electrophysiological, and genetic data due to phenotypic overlap with other CMS subtypes."
  },
