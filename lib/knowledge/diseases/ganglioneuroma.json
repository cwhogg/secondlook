  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological and radiological diagnosis criteria for Ganglioneuroma",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of mature ganglion cells and Schwannian stroma without immature neuroblasts on biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-characteristics",
        "description": "Well-circumscribed, homogeneous mass on MRI or CT with characteristic signal intensity and lack of aggressive features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Slow-growing, often asymptomatic mass or symptoms related to local mass effect",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of mature ganglion cells and Schwannian stroma plus compatible imaging findings",
    "notes": "Definitive diagnosis requires histopathology; imaging supports but is not diagnostic alone."
  },
