  "diagnosticCriteria": {
    "formalCriteriaName": "Revised Ghent Criteria (for Marfan Syndrome) and Clinical Criteria for Heritable Aortopathies",
    "criteria": [
      {
        "id": "aortic-root-dilation",
        "description": "Aortic root dilation or aneurysm detected by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of aortic dissection or related connective tissue disorders",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ectopia-lentis",
        "description": "Ectopia lentis (dislocation of the ocular lens)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "systemic-features",
        "description": "Presence of systemic connective tissue features such as skeletal abnormalities (e.g., arachnodactyly, pectus deformities)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with aortic dissection syndromes (e.g., FBN1, TGFBR1/2, COL3A1)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of aortic root dilation or dissection plus either a pathogenic genetic variant or characteristic systemic features or family history",
    "notes": "Diagnosis often requires integration of clinical, imaging, and genetic data."
  },
