  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Prader-Willi Syndrome",
    "criteria": [
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia with poor suck and feeding difficulties",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyperphagia",
        "description": "Onset of hyperphagia leading to obesity in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of chromosomal translocation involving 15q11-q13 region",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate global developmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypogonadism",
        "description": "Hypogonadism with genital hypoplasia and delayed puberty",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of neonatal hypotonia and hyperphagia with genetic confirmation of translocation involving 15q11-q13 region",
    "notes": "Genetic testing is essential to differentiate from typical deletion or uniparental disomy cases of PWS."
  },
