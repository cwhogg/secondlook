  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for rapid-onset dystonia-parkinsonism",
    "criteria": [
      {
        "id": "rapid-onset",
        "description": "Abrupt onset of dystonia and parkinsonism symptoms within days to weeks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "segmental-distribution",
        "description": "Predominantly cranio-cervical and limb involvement with rostrocaudal gradient",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ATP1A3-mutation",
        "description": "Presence of pathogenic ATP1A3 gene mutation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "lack-of-response-levodopa",
        "description": "Poor or absent response to levodopa therapy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-causes",
        "description": "Exclusion of secondary causes of dystonia and parkinsonism",
        "category": "minor",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Abrupt onset of dystonia-parkinsonism with segmental distribution and exclusion of other causes",
    "notes": "Genetic testing for ATP1A3 mutations supports diagnosis but is not mandatory"
  },
