  "keyFindings": {
    "laboratory": [
      "Low sucrase and isomaltase enzyme activity in small intestinal biopsy",
      "Positive hydrogen breath test after sucrose or maltose challenge",
      "Iron deficiency anemia and electrolyte abnormalities in blood tests"
    ],
    "imaging": [
      "Usually normal abdominal imaging; may show nonspecific bowel gas patterns"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Clinical response to sacrosidase enzyme replacement therapy",
      "Malabsorption evidenced by stool fat analysis"
    ]
  },
