  "diagnosticCriteria": {
    "formalCriteriaName": "Neuroaxonal Dystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive motor decline with spasticity and ataxia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Presence of axonal spheroids in peripheral nerve or CNS biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing cerebral and cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in relevant genes (e.g., PLA2G6)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive motor decline plus histopathological confirmation of axonal spheroids",
    "notes": "Genetic testing and neuroimaging support diagnosis but are not mandatory."
  },
