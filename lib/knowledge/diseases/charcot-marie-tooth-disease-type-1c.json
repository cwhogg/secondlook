  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electrophysiological Diagnostic Criteria for CMT1C",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Symmetric distal muscle weakness and atrophy predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-conduction-velocity",
        "description": "Reduced motor nerve conduction velocity consistent with demyelinating neuropathy (<38 m/s)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the LITAF gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Onion bulb formations and demyelination on nerve biopsy (if performed)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of symmetric distal neuropathy with demyelinating nerve conduction velocities plus identification of pathogenic LITAF mutation",
    "notes": "Genetic testing is essential for definitive diagnosis; nerve biopsy is rarely required."
  },
