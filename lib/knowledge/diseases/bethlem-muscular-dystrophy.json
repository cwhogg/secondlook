  "diagnosticCriteria": {
    "formalCriteriaName": "Bethlem Muscular Dystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Progressive proximal muscle weakness with contractures primarily affecting the elbows, ankles, and fingers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-imaging",
        "description": "Characteristic muscle MRI findings showing selective involvement of muscles with fatty infiltration",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in COL6A1, COL6A2, or COL6A3 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes with reduced or abnormal collagen VI immunostaining",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus pathogenic variant in collagen VI genes or supportive muscle biopsy findings",
    "notes": "Genetic confirmation is considered definitive; muscle biopsy and imaging support diagnosis."
  },
