  "diagnosticCriteria": {
    "formalCriteriaName": "RegiSCAR Diagnostic Criteria",
    "criteria": [
      {
        "id": "skin-detachment",
        "description": "Epidermal detachment involving >10% body surface area for TEN or 1-10% for SJS",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mucosal-involvement",
        "description": "Involvement of at least two mucous membranes (oral, ocular, genital)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing full-thickness epidermal necrosis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "drug-exposure",
        "description": "Recent exposure to high-risk medications within 1-3 weeks prior to onset",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "fever",
        "description": "High fever >38°C at onset",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of epidermal detachment >1% BSA plus involvement of at least two mucous membranes, supported by clinical history and/or histopathology",
    "notes": "Diagnosis is clinical but supported by skin biopsy and exclusion of mimics"
  },
