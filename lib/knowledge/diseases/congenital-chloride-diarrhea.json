  "keyFindings": {
    "laboratory": [
      "Elevated fecal chloride concentration (>90 mmol/L)",
      "Hypochloremic metabolic alkalosis on blood gas analysis",
      "Hypokalemia and hyponatremia"
    ],
    "imaging": [
      "Prenatal ultrasound showing polyhydramnios and dilated bowel loops",
      "Abdominal X-ray may show bowel distension"
    ],
    "genetic": [
      "Pathogenic mutations in SLC26A3 gene (chromosome 7q31)"
    ],
    "other": [
      "Positive family history or consanguinity",
      "Response to electrolyte replacement therapy"
    ]
  },
