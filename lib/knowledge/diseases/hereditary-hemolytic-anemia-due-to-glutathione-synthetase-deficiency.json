  "diagnosticCriteria": {
    "formalCriteriaName": "Glutathione Synthetase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced glutathione synthetase enzyme activity in erythrocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemolytic-anemia",
        "description": "Presence of chronic hemolytic anemia with reticulocytosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-acidosis",
        "description": "Chronic metabolic acidosis with elevated 5-oxoproline in urine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the GSS gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of neurological symptoms such as developmental delay or seizures",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced glutathione synthetase enzyme activity plus chronic hemolytic anemia and metabolic acidosis",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if enzyme assay and clinical features are definitive."
  },
