  "diagnosticCriteria": {
    "formalCriteriaName": "Classic Triad Diagnostic Criteria",
    "criteria": [
      {
        "id": "agenesis-corpus-callosum",
        "description": "Complete or partial agenesis of the corpus callosum confirmed by neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "infantile-spasms",
        "description": "Presence of infantile spasms or other seizure types starting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chorioretinal-lesions",
        "description": "Characteristic chorioretinal lacunae or abnormalities detected by ophthalmologic exam",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vertebral-anomalies",
        "description": "Presence of vertebral anomalies such as hemivertebrae or scoliosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cortical-malformations",
        "description": "Additional brain malformations such as polymicrogyria or heterotopia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of the classic triad: agenesis of corpus callosum, infantile spasms, and chorioretinal lacunae",
    "notes": "Diagnosis is clinical supported by neuroimaging and ophthalmologic findings; genetic testing is not definitive as causative gene is unknown"
  },
