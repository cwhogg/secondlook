  "diagnosticCriteria": {
    "formalCriteriaName": "Hall-Riggs Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial dysmorphic features including micrognathia and midface hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Multiple skeletal anomalies including short stature, brachydactyly, and vertebral segmentation defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiographic-findings",
        "description": "Radiographic evidence of abnormal bone morphology consistent with dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history suggestive of autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniofacial dysmorphism, skeletal abnormalities, and radiographic findings consistent with Hall-Riggs syndrome",
    "notes": "Genetic testing may assist but causative gene not yet identified"
  },
