  "diagnosticCriteria": {
    "formalCriteriaName": "Methimazole Embryofetopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "prenatal-exposure",
        "description": "Confirmed maternal methimazole exposure during the first trimester of pregnancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "scalp-defects",
        "description": "Presence of aplasia cutis congenita (scalp defects)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-malformations",
        "description": "Characteristic craniofacial anomalies including choanal atresia or esophageal atresia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-anomalies",
        "description": "Presence of limb defects such as aplasia or hypoplasia of distal phalanges",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-anomalies",
        "description": "Congenital heart defects associated with embryofetopathy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed first trimester methimazole exposure plus presence of aplasia cutis congenita and at least one other major malformation (craniofacial or limb anomaly)",
    "notes": "Diagnosis is clinical and based on history of exposure and characteristic malformations; genetic testing is not diagnostic."
  },
