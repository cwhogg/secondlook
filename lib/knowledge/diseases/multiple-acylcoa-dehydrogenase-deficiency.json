  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for MADD",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of hypoglycemia, metabolic acidosis, and muscle weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-markers",
        "description": "Elevated plasma acylcarnitines and urinary organic acids consistent with fatty acid oxidation defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in ETFA, ETFB, or ETFDH genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Ragged red fibers or lipid accumulation in muscle biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical symptoms plus biochemical markers and/or genetic confirmation",
    "notes": "Diagnosis may be supported by muscle biopsy and response to riboflavin therapy"
  },
