  "diagnosticCriteria": {
    "formalCriteriaName": "MOMO Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "macrosomia",
        "description": "Presence of congenital macrosomia (excessive birth weight and size)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "obesity",
        "description": "Early-onset severe obesity developing in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "macrocephaly",
        "description": "Macrocephaly characterized by an abnormally large head circumference",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-abnormalities",
        "description": "Ocular abnormalities including strabismus and nystagmus",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (macrosomia, obesity, and macrocephaly) with supportive minor criteria such as ocular abnormalities or developmental delay",
    "notes": "Diagnosis is clinical; genetic etiology remains unknown."
  },
