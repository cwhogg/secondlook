  "diagnosticCriteria": {
    "formalCriteriaName": "Karyotype-confirmed Turner Syndrome",
    "criteria": [
      {
        "id": "ts-c1",
        "description": "Female phenotype with complete or partial absence of one X chromosome on karyotype analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ts-c2",
        "description": "Short stature (height <5th percentile or >2 SD below mean)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ts-c3",
        "description": "Primary ovarian insufficiency (elevated FSH, absent or delayed puberty)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ts-c4",
        "description": "Lymphedema (congenital or recurrent)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ts-c5",
        "description": "Congenital heart defect (especially bicuspid aortic valve, coarctation of the aorta)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Karyotype showing 45,X or variant (mosaicism 45,X/46,XX; isochromosome Xq; ring X; partial X deletion) in a phenotypic female",
    "notes": "~50% have classic 45,X; ~30% are mosaic; ~20% have structural X abnormalities. Prenatal diagnosis by amniocentesis or CVS is increasing. Phenotype varies widely, especially in mosaic cases."
  },
