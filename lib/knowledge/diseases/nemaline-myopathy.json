  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild or normal)",
      "Muscle biopsy showing nemaline rods with Gomori trichrome stain"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle involvement and fatty replacement"
    ],
    "genetic": [
      "TWIST2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography consistent with myopathic changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "central-core-disease",
      "distinguishingFeatures": [
        "Central cores on muscle biopsy instead of nemaline rods",
        "Usually caused by RYR1 mutations",
        "Different muscle involvement pattern on MRI"
      ]
    },
    {
      "diseaseId": "myotubular-myopathy",
      "distinguishingFeatures": [
        "Presence of centrally located nuclei in muscle fibers",
        "Different genetic mutations (MTM1 gene)",
        "More severe neonatal hypotonia and respiratory failure"
      ]
    },
    {
      "diseaseId": "congenital muscular dystrophy",
      "distinguishingFeatures": [
        "Muscle biopsy shows dystrophic changes rather than rods",
        "Often associated with brain and eye abnormalities",
        "Different genetic causes"
      ]
    }
  ],
  "redFlags": [
    "Severe neonatal hypotonia with respiratory distress",
    "Rapidly progressive respiratory failure",
    "Feeding difficulties with risk of aspiration"
  ],
