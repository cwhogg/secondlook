  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild elevation of inflammatory markers if secondary complications"
    ],
    "imaging": [
      "Radiographs showing syndactyly and bone abnormalities of phalanges",
      "MRI brain may show white matter changes in some patients"
    ],
    "genetic": [
      "GJA1 (causative)",
      "Autosomal dominant inheritance",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Ophthalmologic examination revealing microphthalmia and glaucoma",
      "Dental evaluation showing enamel hypoplasia and microdontia"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hallermann-streiff-syndrome",
