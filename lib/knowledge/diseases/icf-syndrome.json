  "diagnosticCriteria": {
    "formalCriteriaName": "ICF Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "immunodeficiency",
        "description": "Hypogammaglobulinemia or combined immunodeficiency with recurrent infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "centromeric-instability",
        "description": "Chromosomal abnormalities involving centromeric instability of chromosomes 1, 9, and 16",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-anomalies",
        "description": "Characteristic facial dysmorphisms including hypertelorism, epicanthal folds, flat nasal bridge, and macroglossia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in DNMT3B, ZBTB24, CDCA7, or HELLS genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of immunodeficiency, centromeric instability on cytogenetic analysis, and characteristic facial anomalies",
    "notes": "Genetic testing is confirmatory but not mandatory if clinical and cytogenetic criteria are met."
  },
