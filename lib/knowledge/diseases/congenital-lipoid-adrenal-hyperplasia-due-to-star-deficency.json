  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for Congenital Lipoid Adrenal Hyperplasia",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Neonatal salt-wasting crisis with hyponatremia, hyperkalemia, and dehydration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hormonal-profile",
        "description": "Severely decreased plasma cortisol and aldosterone levels with elevated ACTH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the STAR gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "adrenal-imaging",
        "description": "Enlarged adrenal glands with lipid accumulation on imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "external-genitalia",
        "description": "Female external genitalia in 46,XY individuals (sex reversal)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of neonatal salt-wasting crisis, characteristic hormonal profile, and confirmation by genetic testing of STAR mutations",
    "notes": "Early diagnosis is critical to prevent adrenal crisis and manage hormone replacement therapy."
  },
