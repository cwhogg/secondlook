  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Holoprosencephaly-postaxial polydactyly syndrome",
    "criteria": [
      {
        "id": "holoprosencephaly",
        "description": "Presence of holoprosencephaly confirmed by neuroimaging or autopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "postaxial-polydactyly",
        "description": "Postaxial polydactyly of one or more limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial anomalies including midline facial defects (e.g., hypotelorism, cleft lip/palate)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with holoprosencephaly spectrum",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of holoprosencephaly plus postaxial polydactyly and characteristic craniofacial anomalies",
    "notes": "Diagnosis is primarily clinical supported by neuroimaging and genetic testing when available."
  },
