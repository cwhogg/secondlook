  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible elevated lactate in some cases"
    ],
    "imaging": [
      "Brain MRI showing microcephaly with simplified gyral pattern",
      "Occasional white matter abnormalities"
    ],
    "genetic": [
      "AFG2A (causative)",
      "Likely autosomal recessive inheritance pattern"
    ],
    "other": [
      "Abnormal EEG with epileptiform discharges",
      "Audiometric confirmation of sensorineural hearing loss"
    ]
  },
