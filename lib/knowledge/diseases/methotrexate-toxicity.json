  "keyFindings": {
    "laboratory": [
      "Pancytopenia with neutropenia and thrombocytopenia",
      "Elevated serum creatinine and blood urea nitrogen",
      "Elevated liver transaminases",
      "Hypoalbuminemia",
      "Elevated serum methotrexate levels"
    ],
    "imaging": [
      "Chest X-ray or CT showing interstitial infiltrates or pneumonitis",
      "Renal ultrasound may show acute changes"
    ],
    "genetic": [
      "Polymorphisms in methylenetetrahydrofolate reductase (MTHFR) gene may increase toxicity risk"
    ],
    "other": [
      "Bone marrow biopsy showing hypocellularity",
      "Elevated inflammatory markers (CRP, ESR)"
    ]
  },
  "differentialDiagnoses": [
    {
