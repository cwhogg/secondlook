  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Mucolipidosis type III",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of UDP-N-acetylglucosamine-1-phosphotransferase enzyme activity in fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of progressive skeletal abnormalities including dysostosis multiplex and joint stiffness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in GNPTAB gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lysosomal-enzyme-elevation",
        "description": "Elevated lysosomal enzyme levels in plasma due to defective targeting",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiologic-findings",
        "description": "Radiographic evidence of dysostosis multiplex",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of UDP-N-acetylglucosamine-1-phosphotransferase enzyme activity plus either clinical features consistent with ML III or identification of pathogenic GNPTAB variants",
    "notes": "Diagnosis is confirmed by enzymatic assay and/or molecular genetic testing; clinical presentation overlaps with mucopolysaccharidoses."
  },
