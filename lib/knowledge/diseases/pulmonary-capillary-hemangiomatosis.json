  "keyFindings": {
    "laboratory": [
      "Elevated brain natriuretic peptide (BNP) indicating right heart strain",
      "Hypoxemia on arterial blood gas analysis"
    ],
    "imaging": [
      "High-resolution CT showing diffuse ground-glass opacities and septal thickening",
      "Right heart enlargement on echocardiography",
      "Pulmonary arterial hypertension on right heart catheterization"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology demonstrating capillary proliferation within alveolar septa",
      "Exclusion of pulmonary veno-occlusive disease by pathology"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pulmonary-veno-occlusive-disease",
      "distinguishingFeatures": [
        "Histopathology shows venous and venular occlusion rather than capillary proliferation",
        "More prominent pulmonary venous involvement",
        "Different radiologic pattern with more septal thickening and lymphadenopathy"
      ]
    },
    {
      "diseaseId": "idiopathic-pulmonary-arterial-hypertension",
      "distinguishingFeatures": [
        "Absence of capillary proliferation on histology",
        "Normal pulmonary venous system",
        "Different clinical course and response to therapy"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive dyspnea and hypoxemia",
    "Signs of right heart failure with hemodynamic compromise",
    "Hemoptysis indicating possible pulmonary hemorrhage"
  ],
