  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Spondylocostal Dysostosis",
    "criteria": [
      {
        "id": "vertebral-segmentation-anomalies",
        "description": "Presence of multiple vertebral segmentation defects including hemivertebrae and fused vertebrae",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "rib-malformations",
        "description": "Abnormal rib anomalies such as fused, absent, or bifid ribs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive or dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes such as DLL3, MESP2, LFNG, or HES7",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of vertebral segmentation anomalies and rib malformations confirmed by imaging",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical and radiological features are definitive."
  },
