  "keyFindings": {
    "laboratory": [
      "Persistent villous atrophy on duodenal biopsy",
      "Negative or normalized anti-tTG and anti-endomysial antibodies despite symptoms",
      "Iron deficiency anemia refractory to treatment",
      "Hypoalbuminemia and other malnutrition markers"
    ],
    "imaging": [
      "Endoscopic findings of mucosal atrophy and scalloping in small intestine",
      "CT or MRI enterography may show bowel wall thickening or complications"
    ],
    "genetic": [
      "HLA-DQ2 or HLA-DQ8 positive in majority of patients"
    ],
    "other": [
      "Immunophenotyping showing aberrant intraepithelial lymphocytes in type II RCD",
      "Exclusion of infections and malignancies"
    ]
  },
