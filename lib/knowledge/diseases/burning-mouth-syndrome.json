  "keyFindings": {
    "laboratory": [
      "Normal hematologic and biochemical profiles; exclusion of anemia, diabetes, and nutritional deficiencies",
      "Negative oral swabs for candidiasis"
    ],
    "imaging": [
      "No specific imaging abnormalities; imaging used to exclude other causes if indicated"
    ],
    "genetic": [
      "No known genetic markers associated"
    ],
    "other": [
      "Normal oral mucosa on clinical examination",
      "Possible altered peripheral or central nerve function on specialized testing"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "oral-candidiasis",
      "distinguishingFeatures": [
        "Presence of white plaques or erythema on oral mucosa",
        "Positive fungal cultures or response to antifungal therapy"
      ]
    },
    {
      "diseaseId": "nutritional-deficiency-stomatitis",
      "distinguishingFeatures": [
        "Laboratory evidence of iron, vitamin B12, or folate deficiency",
        "Mucosal atrophy or glossitis on examination"
      ]
    },
    {
      "diseaseId": "xerostomia-secondary-to-sjogrens-syndrome",
      "distinguishingFeatures": [
        "Objective hyposalivation on sialometry",
        "Positive autoimmune markers (e.g., anti-Ro/SSA, anti-La/SSB)"
      ]
    }
  ],
  "redFlags": [
