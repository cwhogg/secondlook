  "diagnosticCriteria": {
    "formalCriteriaName": "Mitochondrial Disease Diagnostic Criteria (MDC)",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of multisystemic clinical manifestations consistent with mitochondrial dysfunction",
