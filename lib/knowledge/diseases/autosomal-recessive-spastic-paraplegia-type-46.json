  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of metabolic causes of spastic paraplegia"
    ],
    "imaging": [
      "Brain MRI demonstrating mild cerebral and cerebellar atrophy",
      "Spinal cord MRI typically normal"
    ],
    "genetic": [
      "GBA2 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography (EMG) may show mild peripheral neuropathy",
      "Nerve conduction studies typically normal or mildly abnormal"
    ]
  },
  "differentialDiagnoses": [
