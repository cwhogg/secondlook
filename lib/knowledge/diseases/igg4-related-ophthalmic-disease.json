  "diagnosticCriteria": {
    "formalCriteriaName": "Comprehensive Diagnostic Criteria for IgG4-related Disease (2011)",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Characteristic histopathological features including dense lymphoplasmacytic infiltration, storiform fibrosis, and obliterative phlebitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serum-igg4-elevation",
        "description": "Elevated serum IgG4 concentration (>135 mg/dL)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-orbital-involvement",
        "description": "Imaging evidence of orbital tissue enlargement or mass lesions consistent with IgG4-related disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-steroids",
        "description": "Clinical improvement with corticosteroid therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic histopathology plus elevated serum IgG4 and compatible imaging findings",
    "notes": "Diagnosis requires exclusion of malignancy and other inflammatory conditions."
  },
