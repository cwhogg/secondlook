      ]
    },
    {
      "diseaseId": "papillary-fibroelastoma",
      "distinguishingFeatures": [
        "Smaller size, often on valves",
        "Different echocardiographic appearance",
        "Histology distinct from myxoma"
      ]
    }
  ],
  "redFlags": [
