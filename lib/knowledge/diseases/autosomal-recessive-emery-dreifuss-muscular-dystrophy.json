  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate elevation)"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle atrophy and fatty infiltration",
      "Echocardiogram demonstrating conduction system abnormalities and possible cardiomyopathy"
    ],
    "genetic": [
      "LMNA (causative)",
      "Biallelic pathogenic variants in EMD, SYNE1, or related genes associated with autosomal recessive inheritance"
    ],
    "other": [
      "Electrocardiogram (ECG) showing atrioventricular block and arrhythmias",
      "Electromyography (EMG) consistent with myopathic changes"
    ]
  },
