  "diagnosticCriteria": {
    "formalCriteriaName": "Neurofaciodigitorenal Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including broad nasal bridge, hypertelorism, and prominent forehead",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-anomalies",
        "description": "Presence of renal abnormalities such as cystic dysplasia or renal hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-features",
        "description": "Neurological manifestations including developmental delay and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digital-anomalies",
        "description": "Digital malformations such as brachydactyly or clinodactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: characteristic facial dysmorphism, renal anomalies, and neurological features",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
