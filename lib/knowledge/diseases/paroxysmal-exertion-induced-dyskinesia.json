  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Paroxysmal Exertion-Induced Dyskinesia",
    "criteria": [
      {
        "id": "exertion-trigger",
        "description": "Recurrent episodes of involuntary hyperkinetic movements triggered by prolonged exertion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "episode-duration",
        "description": "Episodes lasting from several minutes up to an hour",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-interictal",
        "description": "Normal neurological examination and absence of symptoms between episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of paroxysmal dyskinesias such as epilepsy or metabolic disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of similar paroxysmal movement disorder",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent exertion-triggered dyskinetic episodes lasting minutes to an hour with normal interictal neurological exam and exclusion of other causes",
    "notes": "Genetic testing for mutations in SLC2A1 may support diagnosis"
  },
