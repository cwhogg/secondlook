  "keyFindings": {
    "laboratory": [
      "Reduced alpha-mannosidase enzyme activity in leukocytes or fibroblasts",
      "Elevated urinary mannose-rich oligosaccharides",
      "Mild anemia and leukopenia"
    ],
    "imaging": [
      "Skeletal X-rays showing dysostosis multiplex",
      "Brain MRI may show cerebral atrophy or hydrocephalus",
      "Echocardiogram may reveal cardiomyopathy"
    ],
    "genetic": [
      "Pathogenic variants in the MAN2B1 gene"
    ],
    "other": [
      "Hearing tests showing sensorineural hearing loss",
      "Immunological studies revealing decreased antibody production"
    ]
  },
