{
  "id": "mucolipidosis-iii",
  "name": "Mucolipidosis III (Pseudo-Hurler Polydystrophy)",
  "aliases": [
    "Pseudo-Hurler Polydystrophy",
    "Mucolipidosis III Alpha/Beta",
    "Mucolipidosis III Gamma"
  ],
  "icd10Codes": [
    "E75.2"
  ],
  "omimId": "252600",
  "orphanetId": "237",
  "prevalence": {
    "estimate": "1 in 200,000 to 1 in 1,000,000",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 1,
      "max": 15,
      "peak": 5
    },
    "sexPredilection": "equal",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Mucolipidosis III",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of deficient activity of UDP-N-acetylglucosamine-1-phosphotransferase enzyme in fibroblasts or leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of progressive joint stiffness and skeletal deformities resembling mucopolysaccharidoses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in GNPTAB or GNPTG genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-findings",
        "description": "Radiographic evidence of dysostosis multiplex with mild skeletal abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "urinary-glycosaminoglycans",
        "description": "Normal or mildly elevated urinary glycosaminoglycans (distinguishing from mucopolysaccharidoses)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient enzyme activity plus compatible clinical features and/or pathogenic variants in GNPTAB or GNPTG genes",
    "notes": "Diagnosis requires biochemical confirmation; clinical presentation is milder than mucopolysaccharidoses."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Progressive joint stiffness",
        "frequency": 0.85,
        "bodySystem": "musculoskeletal",
        "notes": "Typically affects large and small joints symmetrically"
      },
      {
        "symptomName": "Skeletal deformities resembling dysostosis multiplex",
        "frequency": 0.8,
        "bodySystem": "musculoskeletal",
        "notes": "Includes hip dysplasia, scoliosis, and short stature"
      },
      {
        "symptomName": "Coarse facial features",
        "frequency": 0.75,
        "bodySystem": "constitutional",
        "notes": "Mild compared to mucopolysaccharidoses"
      }
    ],
    "common": [
      {
        "symptomName": "Mild growth retardation",
        "frequency": 0.7,
        "bodySystem": "constitutional",
        "notes": "Height below average for age"
      },
      {
        "symptomName": "Carpal tunnel syndrome",
        "frequency": 0.65,
        "bodySystem": "neurological",
        "notes": "Due to nerve compression from joint abnormalities"
      },
      {
        "symptomName": "Limited range of motion in joints",
        "frequency": 0.6,
        "bodySystem": "musculoskeletal",
        "notes": "Contributes to functional impairment"
      },
      {
        "symptomName": "Mild corneal clouding",
        "frequency": 0.55,
        "bodySystem": "ophthalmological",
        "notes": "Less severe than in mucopolysaccharidoses"
      }
    ],
    "occasional": [
      {
        "symptomName": "Carpal tunnel syndrome neuropathy",
        "frequency": 0.4,
        "bodySystem": "neurological",
        "notes": "Sensory symptoms in hands"
      },
      {
        "symptomName": "Mild cardiac valve thickening",
        "frequency": 0.3,
        "bodySystem": "cardiovascular",
        "notes": "Usually asymptomatic in early stages"
      },
      {
        "symptomName": "Mild hepatomegaly",
        "frequency": 0.25,
        "bodySystem": "gastrointestinal",
        "notes": "Due to lysosomal storage"
      },
      {
        "symptomName": "Mild hearing loss",
        "frequency": 0.15,
        "bodySystem": "otolaryngological",
        "notes": "Conductive or sensorineural"
      }
    ],
    "rare": [
      {
        "symptomName": "Respiratory infections",
        "frequency": 0.08,
        "bodySystem": "respiratory",
        "notes": "Due to restrictive lung disease from skeletal abnormalities"
      },
      {
        "symptomName": "Carpal tunnel syndrome requiring surgery",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Severe nerve compression"
      },
      {
        "symptomName": "Mild cognitive impairment",
        "frequency": 0.04,
        "bodySystem": "neurological",
        "notes": "Less common and usually mild"
      }
    ]
  },
