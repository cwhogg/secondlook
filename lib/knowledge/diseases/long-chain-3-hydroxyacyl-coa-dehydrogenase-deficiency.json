  "diagnosticCriteria": {
    "formalCriteriaName": "Biochemical and genetic diagnostic criteria for LCHAD deficiency",
    "criteria": [
      {
        "id": "biochemical-evidence",
        "description": "Elevated plasma long-chain 3-hydroxyacylcarnitines on acylcarnitine profile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-activity",
        "description": "Reduced LCHAD enzyme activity in cultured fibroblasts or lymphocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the HADHA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of hypoketotic hypoglycemia, cardiomyopathy, or liver dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biochemical evidence plus either reduced enzyme activity or pathogenic HADHA gene variants",
    "notes": "Newborn screening often detects elevated long-chain 3-hydroxyacylcarnitines; confirmatory testing is required."
  },
