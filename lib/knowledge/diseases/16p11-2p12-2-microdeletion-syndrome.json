  "diagnosticCriteria": {
    "formalCriteriaName": "Chromosomal Microdeletion Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of heterozygous microdeletion at chromosome 16p11.2p12.2 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Presence of global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Characteristic craniofacial dysmorphic features including broad forehead and hypertelorism",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-manifestations",
        "description": "Neurological abnormalities such as hypotonia or seizures",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 16p11.2p12.2 microdeletion plus at least one major clinical feature (developmental delay or intellectual disability)",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support but are variable."
  },
