  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for SPG26",
    "criteria": [
      {
        "id": "progressive-spasticity",
        "description": "Progressive lower limb spasticity and weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the B4GALNT1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging-exclusion",
        "description": "Absence of structural brain abnormalities on MRI excluding other causes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or affected siblings consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive lower limb spasticity with genetic confirmation of biallelic B4GALNT1 mutations",
    "notes": "Diagnosis requires exclusion of other causes of spastic paraplegia and supportive clinical features."
  },
