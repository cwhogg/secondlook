  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests unless secondary complications",
      "Possible immunological abnormalities in rare cases"
    ],
    "imaging": [
      "Brain MRI may show microcephaly and structural abnormalities",
      "Echocardiogram to detect congenital heart defects",
      "Renal ultrasound for kidney anomalies"
    ],
    "genetic": [
      "Ring chromosome 7 identified by karyotyping",
      "FISH or array CGH may detect deletions at chromosome 7 ends"
    ],
    "other": [
      "Developmental assessments for cognitive and motor delays"
    ]
  },
