  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Lissencephaly",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in the LIS1 (PAFAH1B1) gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-lissencephaly",
        "description": "MRI demonstrating characteristic smooth cerebral cortex with absent or reduced gyration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of severe developmental delay and early-onset epilepsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-features",
        "description": "Additional features such as microcephaly and hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pathogenic LIS1 mutation plus MRI evidence of lissencephaly and consistent clinical features",
    "notes": "Diagnosis relies on integration of genetic, imaging, and clinical data."
  },
