  "diagnosticCriteria": {
    "formalCriteriaName": "Gastrocutaneous Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cutaneous-gastrointestinal-fistula",
        "description": "Presence of a congenital or early-onset fistula connecting the gastrointestinal tract to the skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-lesions",
        "description": "Characteristic cutaneous lesions including ulcerations or nodules at fistula site",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathological-confirmation",
        "description": "Histopathological evidence of gastrointestinal tissue in skin biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "associated-gastrointestinal-malformations",
        "description": "Presence of associated gastrointestinal malformations or anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of similar lesions or syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: gastrocutaneous fistula, characteristic cutaneous lesions, and histopathological confirmation",
    "notes": "Diagnosis is clinical supported by histopathology; genetic testing is not established."
  },
