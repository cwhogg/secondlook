  "diagnosticCriteria": {
    "formalCriteriaName": "Corneodermatoosseous Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "corneal-dystrophy",
        "description": "Presence of bilateral corneal opacities consistent with corneal dystrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-hyperkeratosis",
        "description": "Diffuse palmoplantar hyperkeratosis with follicular involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "osseous-anomalies",
        "description": "Radiographic evidence of bone sclerosis and cortical thickening, especially in long bones and skull",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-anomalies",
        "description": "Presence of dental abnormalities such as enamel hypoplasia or delayed eruption",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (corneal dystrophy, palmoplantar hyperkeratosis, and osseous anomalies) must be present for diagnosis.",
    "notes": "Genetic testing may support diagnosis but is not mandatory."
  },
