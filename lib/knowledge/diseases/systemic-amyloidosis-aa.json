  "keyFindings": {
    "laboratory": [
      "Proteinuria (often nephrotic-range > 3.5 g/day)",
      "Elevated serum amyloid A (SAA) protein",
      "Elevated ESR and CRP (reflecting underlying inflammation)",
      "Hypoalbuminemia (nephrotic syndrome)",
      "Elevated serum creatinine (renal impairment)",
      "Congo red stain with apple-green birefringence on biopsy"
    ],
    "imaging": [
      "Renal ultrasound: normal or enlarged kidneys initially; small kidneys in advanced disease",
      "SAP (serum amyloid P component) scintigraphy: demonstrates amyloid deposits in organs (available in specialized centers)",
      "Echocardiography usually normal (unlike AL amyloidosis)"
    ],
    "genetic": [
      "SAA1 (susceptibility)"
    ],
    "other": [
      "Abdominal fat pad aspiration: least invasive biopsy (sensitivity ~70-80%)",
      "Renal biopsy: gold standard for renal amyloidosis; mesangial and vascular deposits",
      "Rectal biopsy: alternative biopsy site",
      "Mass spectrometry for definitive amyloid typing (laser microdissection/mass spec)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "al-amyloidosis",
      "distinguishingFeatures": [
        "AL amyloidosis has monoclonal light chains on serum/urine",
        "AL more commonly causes cardiac involvement and macroglossia",
        "Amyloid typing distinguishes AA from AL protein"
      ]
    },
    {
      "diseaseId": "diabetic-nephropathy",
      "distinguishingFeatures": [
        "Diabetic nephropathy occurs in context of long-standing diabetes",
        "Different histological pattern on renal biopsy"
      ]
    },
    {
      "diseaseId": "membranous-nephropathy",
      "distinguishingFeatures": [
        "Membranous nephropathy has subepithelial immune deposits",
        "Anti-PLA2R antibodies positive in primary membranous"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive renal failure",
    "Nephrotic syndrome in patient with chronic inflammatory disease",
    "GI hemorrhage from mucosal amyloid deposits",
    "Adrenal crisis from bilateral adrenal infiltration"
  ],
