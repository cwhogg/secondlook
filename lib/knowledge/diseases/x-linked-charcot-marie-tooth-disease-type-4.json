  "diagnosticCriteria": {
    "formalCriteriaName": "CMT Diagnostic Criteria for X-linked forms",
    "criteria": [
      {
        "id": "clinical-neuropathy",
        "description": "Presence of progressive distal muscle weakness and atrophy predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies showing reduced motor and sensory nerve conduction velocities consistent with demyelinating neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in the PRPS1 gene associated with CMTX4",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "X-linked inheritance pattern with affected males and carrier females",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of pes cavus and sensory loss in distal extremities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal neuropathy with electrophysiological evidence of demyelination plus identification of pathogenic PRPS1 mutation",
    "notes": "Genetic confirmation is essential due to overlap with other CMT subtypes."
  },
