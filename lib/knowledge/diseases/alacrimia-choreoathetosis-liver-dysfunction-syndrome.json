  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "alacrimia",
        "description": "Congenital or early-onset absence or severe reduction of tear production",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "choreoathetosis",
        "description": "Presence of involuntary choreoathetotic movements",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-dysfunction",
        "description": "Evidence of liver dysfunction including elevated liver enzymes or hepatomegaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-neuroimaging",
        "description": "Neuroimaging showing basal ganglia abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in associated gene(s)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: alacrimia, choreoathetosis, and liver dysfunction",
    "notes": "Diagnosis is clinical; genetic confirmation may support diagnosis but is not mandatory."
  },
