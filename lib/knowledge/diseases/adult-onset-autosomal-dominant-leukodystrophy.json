  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Adult-onset Autosomal Dominant Leukodystrophy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive adult-onset neurological symptoms including autonomic dysfunction and pyramidal signs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "MRI showing diffuse symmetrical white matter abnormalities predominantly in the cerebral hemispheres",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of LMNB1 gene duplication or mutation confirming autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive adult-onset neurological symptoms with characteristic MRI findings and confirmation by genetic testing",
    "notes": "Genetic testing for LMNB1 duplication is definitive; MRI findings support clinical suspicion."
  },
