  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (ESR, CRP)",
      "Neutrophilic leukocytosis",
      "Negative bacterial cultures from ulcer base"
    ],
    "imaging": [
      "Imaging to exclude osteomyelitis (X-ray, MRI)",
      "Chest imaging if pulmonary involvement suspected"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology showing neutrophilic dermatosis with sterile dermal infiltrate",
      "Exclusion of infectious, neoplastic, and vascular causes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "necrotizing-fasciitis",
      "distinguishingFeatures": [
        "Rapidly spreading infection with systemic toxicity",
        "Positive bacterial cultures",
        "Severe pain with skin anesthesia"
      ]
    },
    {
      "diseaseId": "vasculitis",
      "distinguishingFeatures": [
        "Histopathology showing vessel wall inflammation",
        "Systemic vasculitic symptoms",
        "Presence of ANCA or other autoantibodies"
      ]
    },
    {
      "diseaseId": "cutaneous-malignancy",
      "distinguishingFeatures": [
        "Histopathology confirming malignancy",
        "Non-healing ulcer without inflammatory border",
        "Lack of rapid progression typical of PG"
      ]
    }
  ],
  "redFlags": [
    "Rapid ulcer enlargement with systemic toxicity",
    "Failure to respond to immunosuppressive therapy",
    "Signs of secondary infection or sepsis"
  ],
