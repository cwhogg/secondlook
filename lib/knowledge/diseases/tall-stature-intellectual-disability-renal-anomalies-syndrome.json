  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Tall Stature-Intellectual Disability-Renal Anomalies Syndrome",
    "criteria": [
      {
        "id": "tall-stature",
        "description": "Height significantly above the 97th percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability confirmed by standardized cognitive testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-anomalies",
        "description": "Structural or functional renal anomalies identified by imaging or laboratory tests",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including broad forehead and hypertelorism",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Delayed motor and speech milestones",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: tall stature, intellectual disability, and renal anomalies",
    "notes": "Diagnosis is clinical and supported by genetic testing when available"
  },
