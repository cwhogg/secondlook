  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Genetic testing may reveal mutations in genes such as EMX2, COL4A1"
    ],
    "imaging": [
      "MRI showing polymicrogyria with multiple small gyri",
      "Schizencephalic clefts lined by polymicrogyric cortex",
      "Possible associated ventriculomegaly or hydrocephalus"
    ],
    "genetic": [
      "Mutations in EMX2, COL4A1, and other cortical development genes",
      "Often sporadic but familial cases reported"
    ],
    "other": [
      "Electroencephalogram (EEG) showing epileptiform discharges",
      "Neurodevelopmental assessment confirming delays"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "focal-cortical-dysplasia",
      "distinguishingFeatures": [
        "Focal cortical thickening without schizencephalic clefts",
        "Usually localized epilepsy without widespread developmental delay"
      ]
    },
    {
      "diseaseId": "lissencephaly",
      "distinguishingFeatures": [
        "Smooth brain surface lacking gyri",
        "Absence of schizencephalic clefts",
        "More severe developmental impairment"
      ]
    }
  ],
  "redFlags": [
    "Early onset refractory epilepsy",
    "Progressive neurological deterioration",
    "Signs of increased intracranial pressure"
  ],
