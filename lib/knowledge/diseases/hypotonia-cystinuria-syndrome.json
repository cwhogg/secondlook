  "diagnosticCriteria": {
    "formalCriteriaName": "Hypotonia-cystinuria syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "hypotonia",
        "description": "Congenital or early-onset generalized hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cystinuria",
        "description": "Presence of cystinuria confirmed by urinary amino acid analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chromosome-17q21-deletion",
        "description": "Microdeletion at chromosome 17q21 detected by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including broad nasal bridge and epicanthal folds",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital hypotonia, confirmed cystinuria, and detection of 17q21 microdeletion",
    "notes": "Diagnosis is confirmed by genetic testing combined with clinical and biochemical findings."
  },
