  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Ocular Albinism",
    "criteria": [
      {
        "id": "hypopigmentation",
        "description": "Hypopigmentation of the iris and retina observed on slit-lamp and fundoscopic examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "foveal-hypoplasia",
        "description": "Foveal hypoplasia demonstrated by optical coherence tomography (OCT)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the GPR143 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nystagmus",
        "description": "Congenital, involuntary, pendular nystagmus",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "visual-impairment",
        "description": "Reduced visual acuity and abnormal visual evoked potentials",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypopigmentation and foveal hypoplasia with confirmation by genetic testing for GPR143 mutation",
    "notes": "Diagnosis is primarily clinical supported by genetic confirmation; absence of skin and hair hypopigmentation distinguishes it from oculocutaneous albinism."
  },
