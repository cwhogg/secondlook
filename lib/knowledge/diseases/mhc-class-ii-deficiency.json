  "keyFindings": {
    "laboratory": [
      "Absent or severely reduced MHC class II expression on B cells, monocytes, and dendritic cells by flow cytometry",
      "Markedly decreased CD4+ T-cell counts with normal or elevated CD8+ T-cell counts",
      "Variable immunoglobulin levels, often hypogammaglobulinemia",
      "Lymphopenia with impaired T-helper cell function"
    ],
    "imaging": [
      "Chest X-ray or CT showing recurrent pneumonia or bronchiectasis",
      "Abdominal ultrasound may reveal hepatosplenomegaly"
    ],
