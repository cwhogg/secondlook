  "diagnosticCriteria": {
    "formalCriteriaName": "Isotretinoin-like Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "exposure-history",
        "description": "History of exposure to isotretinoin or related retinoids",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-manifestations",
        "description": "Presence of characteristic dermatological symptoms such as cheilitis and xerosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-symptoms",
        "description": "Neurological symptoms including headache, dizziness, or pseudotumor cerebri",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "laboratory-findings",
        "description": "Elevated liver enzymes or lipid abnormalities consistent with retinoid toxicity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "History of isotretinoin exposure plus at least two major criteria or one major and two minor/supportive criteria",
    "notes": "Diagnosis is clinical and supported by exclusion of other causes"
  },
