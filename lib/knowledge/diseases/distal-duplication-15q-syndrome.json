  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnosis criteria for distal 15q duplication",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of distal 15q duplication by chromosomal microarray or karyotyping",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Presence of characteristic craniofacial dysmorphic features such as microcephaly, broad nasal bridge, and epicanthal folds",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Neonatal or infantile hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "History of seizures or epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of distal 15q duplication plus developmental delay or intellectual disability",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support but are variable."
  },
