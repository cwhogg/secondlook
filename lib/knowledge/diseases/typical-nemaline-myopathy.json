  "diagnosticCriteria": {
    "formalCriteriaName": "Nemaline Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Congenital or early childhood onset of hypotonia and muscle weakness predominantly affecting proximal muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Muscle biopsy showing nemaline rods (electron-dense rod-like structures) in muscle fibers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with nemaline myopathy (e.g., NEB, ACTA1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Electromyographic evidence of myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-course",
        "description": "Slowly progressive or non-progressive muscle weakness with preserved cognition",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of typical clinical presentation plus muscle biopsy demonstrating nemaline rods and/or genetic confirmation of pathogenic variants",
    "notes": "Muscle biopsy remains the gold standard; genetic testing increasingly used for confirmation and subtype classification."
  },
