  "keyFindings": {
    "laboratory": [
      "Elevated gonadotropins (FSH, LH) indicating gonadal failure",
      "Thyroid function tests abnormal in autoimmune thyroiditis"
    ],
    "imaging": [
      "Pelvic ultrasound showing streak ovaries or gonadal dysgenesis",
      "Echocardiography revealing congenital heart defects"
    ],
    "genetic": [
      "Molecular confirmation of maternal uniparental disomy of chromosome X by SNP microarray or methylation studies"
    ],
    "other": [
