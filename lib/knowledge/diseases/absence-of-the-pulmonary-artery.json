  "keyFindings": {
    "laboratory": [
      "Generally nonspecific; may show hypoxemia on arterial blood gas analysis"
    ],
    "imaging": [
      "CT angiography showing absence of unilateral pulmonary artery",
      "MRI angiography confirming vascular anatomy",
      "Chest X-ray showing decreased vascular markings on affected side",
      "Echocardiography revealing absent or hypoplastic pulmonary artery and secondary cardiac changes"
    ],
    "genetic": [
      "No specific genetic mutation identified; sporadic cases predominating"
    ],
    "other": [
      "Right ventricular hypertrophy on ECG",
      "Pulmonary function tests may show restrictive or obstructive patterns depending on secondary complications"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pulmonary-artery-stenosis",
      "distinguishingFeatures": [
        "Presence of narrowed but patent pulmonary artery on imaging",
        "Less severe or absent recurrent infections",
        "Different hemodynamic profile on echocardiography"
      ]
    },
    {
      "diseaseId": "pulmonary-hypoplasia",
      "distinguishingFeatures": [
        "Underdevelopment of lung tissue rather than absence of artery",
        "Imaging shows hypoplastic lung with present pulmonary artery",
        "Different clinical course with predominant respiratory insufficiency"
      ]
    }
  ],
