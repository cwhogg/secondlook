  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological Diagnostic Criteria for Chronic Pneumonitis of Infancy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive respiratory distress and hypoxemia in infants under 1 year of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-findings",
        "description": "Diffuse interstitial infiltrates on chest radiograph or CT scan",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Lung biopsy showing interstitial thickening with alveolar septal inflammation and type II pneumocyte hyperplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-infection",
        "description": "Exclusion of infectious causes by microbiological testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-steroids",
        "description": "Clinical improvement with corticosteroid therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive respiratory distress with characteristic radiologic findings and confirmatory lung biopsy histopathology",
    "notes": "Diagnosis requires lung biopsy due to overlap with other interstitial lung diseases in infancy."
  },
