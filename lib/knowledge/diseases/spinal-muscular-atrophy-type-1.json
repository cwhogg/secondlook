  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Elevated creatine kinase (mildly elevated or normal)"
    ],
    "imaging": [
      "Chest X-ray showing bell-shaped chest and atelectasis",
      "Spinal X-ray may show scoliosis"
    ],
    "genetic": [
      "Homozygous deletion or mutation of SMN1 gene on chromosome 5q13"
    ],
    "other": [
      "Electromyography showing denervation and reduced motor unit potentials",
      "Muscle biopsy demonstrating grouped atrophy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-myopathies",
      "distinguishingFeatures": [
        "Muscle biopsy shows structural abnormalities rather than denervation",
        "Genetic mutations differ from SMN1"
      ]
    },
    {
      "diseaseId": "congenital-bilateral-hip-dislocation",
      "distinguishingFeatures": [
        "Primarily orthopedic with no motor neuron involvement",
        "Normal EMG and genetic testing"
      ]
    },
    {
      "diseaseId": "myasthenia-gravis-infantile",
      "distinguishingFeatures": [
        "Fluctuating weakness with fatigability",
        "Positive acetylcholine receptor antibodies",
        "Response to anticholinesterase therapy"
      ]
    }
  ],
  "redFlags": [
    "Onset of severe hypotonia before 6 months of age",
    "Progressive respiratory failure",
    "Absence of deep tendon reflexes"
  ],
