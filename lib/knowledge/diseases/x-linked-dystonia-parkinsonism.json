  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "No specific biochemical markers"
    ],
    "imaging": [
      "MRI may show mild basal ganglia atrophy",
      "Functional imaging (DAT scan) shows presynaptic dopaminergic deficit"
    ],
    "genetic": [
      "TAF1 (causative)",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Electromyography may show dystonic muscle activity"
    ]
  },
  "differentialDiagnoses": [
