  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible elevated creatine kinase due to muscle involvement"
    ],
    "imaging": [
      "X-rays showing joint contractures and pterygia",
      "Thoracic cage deformities on chest radiograph",
      "MRI may show muscle hypoplasia"
    ],
    "genetic": [
      "CHRNG (causative)",
      "MYH3 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography may show myopathic changes",
      "Prenatal ultrasound may detect joint contractures and pterygia"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "multiple-pterygium-syndrome-autosomal-dominant",
      "distinguishingFeatures": [
        "Autosomal dominant inheritance pattern",
        "Less severe joint contractures",
        "Different genetic mutations (e.g. MYH3 gene)"
      ]
    },
    {
      "diseaseId": "freeman-sheldon-syndrome",
      "distinguishingFeatures": [
        "Distinctive facial features including 'whistling face'",
        "Primarily distal arthrogryposis",
        "Mutations in MYH3 gene"
      ]
    }
  ],
  "redFlags": [
    "Severe respiratory distress in neonatal period",
    "Progressive joint contractures leading to immobility",
    "Feeding difficulties with risk of aspiration"
  ],
