        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: microbrachycephaly, congenital ptosis, and cleft lip",
    "notes": "Diagnosis is primarily clinical; genetic testing may assist but no specific gene identified"
