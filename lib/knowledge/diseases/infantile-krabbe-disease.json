  "keyFindings": {
    "laboratory": [
      "Reduced galactocerebrosidase (GALC) enzyme activity in leukocytes or fibroblasts",
      "Elevated psychosine levels in blood or dried blood spots"
    ],
    "imaging": [
      "MRI showing diffuse demyelination predominantly in periventricular white matter",
      "Thinning of corpus callosum",
      "Optic nerve atrophy on neuroimaging"
    ],
    "genetic": [
      "PSAP (causative)",
      "GALC (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Presence of multinucleated globoid cells on brain biopsy (rarely performed)",
      "Abnormal nerve conduction studies indicating peripheral neuropathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "metachromatic-leukodystrophy",
      "distinguishingFeatures": [
        "Arylsulfatase A deficiency instead of GALC deficiency",
        "Later onset compared to infantile Krabbe disease",
        "Different pattern of demyelination on MRI"
      ]
    },
    {
      "diseaseId": "adrenoleukodystrophy",
      "distinguishingFeatures": [
        "X-linked inheritance pattern",
        "Elevated very long chain fatty acids (VLCFA)",
        "Adrenal insufficiency common"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive neurodegeneration in infancy",
    "Severe spasticity with developmental regression",
    "Early onset seizures with optic atrophy"
  ],
