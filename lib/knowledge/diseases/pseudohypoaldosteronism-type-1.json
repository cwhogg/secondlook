  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and biochemical criteria for Pseudohypoaldosteronism Type 1",
    "criteria": [
      {
        "id": "aldosterone-resistance",
        "description": "Elevated plasma aldosterone levels with clinical signs of aldosterone resistance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyponatremia-hyperkalemia",
        "description": "Persistent hyponatremia and hyperkalemia despite normal adrenal function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-acidosis",
        "description": "Presence of metabolic acidosis due to renal salt wasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in NR3C2 or ENaC subunit genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of congenital adrenal hyperplasia and other causes of mineralocorticoid deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated aldosterone with hyponatremia, hyperkalemia, and metabolic acidosis consistent with aldosterone resistance",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical and biochemical criteria are met."
  },
