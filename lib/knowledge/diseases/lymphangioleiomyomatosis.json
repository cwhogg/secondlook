  "diagnosticCriteria": {
    "formalCriteriaName": "American Thoracic Society/Japanese Respiratory Society Consensus Criteria for LAM Diagnosis",
    "criteria": [
      {
        "id": "cystic-lung-lesions",
        "description": "Characteristic multiple thin-walled cystic lung lesions on high-resolution CT",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tuberous-sclerosis-complex",
        "description": "Presence of tuberous sclerosis complex or its features",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "lymphatic-involvement",
        "description": "Evidence of lymphatic involvement such as chylous effusions or lymphangioleiomyomas",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "serum-vegf-d",
        "description": "Elevated serum vascular endothelial growth factor-D (VEGF-D) levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "lung-biopsy",
        "description": "Histopathological confirmation of LAM cells in lung biopsy",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic cystic lung lesions on HRCT plus either elevated VEGF-D levels, lymphatic involvement, or histopathological confirmation",
    "notes": "Diagnosis can be established without biopsy if characteristic imaging and elevated VEGF-D are present."
  },
