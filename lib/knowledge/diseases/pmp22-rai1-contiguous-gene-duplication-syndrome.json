  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for PMP22-RAI1 Contiguous Gene Duplication Syndrome",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of a contiguous gene duplication involving PMP22 and RAI1 by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Presence of global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including brachycephaly, broad forehead, and midface hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Early-onset hypotonia with delayed motor milestones",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuropathy",
        "description": "Evidence of peripheral neuropathy on clinical or electrophysiological examination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of PMP22-RAI1 contiguous gene duplication plus presence of developmental delay or intellectual disability",
    "notes": "Diagnosis requires genetic testing; clinical features support but are not sufficient alone."
  },
