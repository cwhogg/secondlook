  "diagnosticCriteria": {
    "formalCriteriaName": "RegiSCAR Diagnostic Criteria for Stevens-Johnson Syndrome",
    "criteria": [
      {
        "id": "mucosal-involvement",
        "description": "Involvement of at least two mucous membranes with erosions or ulcerations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-detachment",
        "description": "Epidermal necrosis with skin detachment involving less than 10% of body surface area",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "prodromal-symptoms",
        "description": "Presence of prodromal flu-like symptoms such as fever, malaise, and sore throat",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing full-thickness epidermal necrosis",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of skin detachment involving less than 10% BSA plus involvement of at least two mucous membranes",
    "notes": "Diagnosis is clinical but supported by histopathology and exclusion of other causes."
  },
