  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Diagnostic Criteria for Pityriasis Rubra Pilaris",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of follicular hyperkeratotic papules with orange-red scaling plaques",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "islands-of-sparing",
        "description": "Characteristic 'islands of sparing' with unaffected skin within erythematous plaques",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing alternating orthokeratosis and parakeratosis in both vertical and horizontal directions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "palmoplantar-keratoderma",
        "description": "Presence of thickened, orange-yellow keratoderma on palms and soles",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-psoriasis-features",
        "description": "Lack of typical psoriasis features such as Auspitz sign and nail pitting",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical presentation, islands of sparing, and histopathology) must be met for diagnosis.",
    "notes": "Diagnosis is primarily clinical supported by histopathology; exclusion of psoriasis is important."
  },
