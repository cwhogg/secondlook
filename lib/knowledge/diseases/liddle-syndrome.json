  "keyFindings": {
    "laboratory": [
      "Hypokalemia with metabolic alkalosis",
      "Low plasma renin activity",
      "Low serum aldosterone levels",
      "Normal or low serum sodium"
    ],
    "imaging": [
      "Possible evidence of hypertensive end-organ damage on echocardiogram or renal ultrasound"
    ],
    "genetic": [
      "Gain-of-function mutations in SCNN1B or SCNN1G genes encoding epithelial sodium channel subunits"
    ],
    "other": [
      "Resistance to conventional antihypertensive therapy excluding mineralocorticoid receptor antagonists"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "primary-aldosteronism",
      "distinguishingFeatures": [
        "Elevated aldosterone levels",
        "Suppressed renin",
        "Responds to mineralocorticoid receptor antagonists"
      ]
    },
    {
      "diseaseId": "gordon-syndrome",
      "distinguishingFeatures": [
        "Hypertension with hyperkalemia",
        "Metabolic acidosis",
        "Mutations in WNK1 or WNK4 genes"
      ]
    },
    {
      "diseaseId": "congenital-adrenal-hyperplasia",
      "distinguishingFeatures": [
        "Elevated 17-hydroxyprogesterone",
        "Variable aldosterone and cortisol levels",
        "May have ambiguous genitalia"
      ]
    }
  ],
  "redFlags": [
    "Severe hypertension in a child or young adult",
    "Hypokalemia refractory to potassium supplementation",
    "Low renin and aldosterone levels despite hypertension"
  ],
