  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Hereditary Motor and Sensory Neuropathy Type 2",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive distal muscle weakness and atrophy with sensory loss predominantly in lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies showing reduced amplitude of sensory and motor action potentials with relatively preserved conduction velocities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in genes associated with axonal neuropathy (e.g., MFN2, NEFL)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nerve-biopsy",
        "description": "Nerve biopsy showing axonal degeneration with loss of large myelinated fibers",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal motor and sensory neuropathy with supportive electrophysiological evidence and identification of pathogenic mutation in relevant gene",
    "notes": "Diagnosis is primarily clinical supported by electrophysiology and genetic testing; nerve biopsy is rarely required."
  },
