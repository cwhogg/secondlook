  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for 10p11.21p12.31 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Presence of characteristic facial dysmorphic features including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay affecting motor and speech milestones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-abnormalities",
        "description": "Behavioral abnormalities such as hyperactivity, autistic features, or attention deficit",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Detection of microdeletion at chromosome 10p11.21p12.31 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-features",
        "description": "Additional features such as hypotonia, feeding difficulties, or seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic facial dysmorphism, developmental delay, behavioral abnormalities, and confirmed 10p11.21p12.31 microdeletion",
    "notes": "Diagnosis requires genetic confirmation due to phenotypic overlap with other microdeletion syndromes"
  },
