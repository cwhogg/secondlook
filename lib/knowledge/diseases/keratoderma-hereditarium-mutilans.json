  "diagnosticCriteria": {
    "formalCriteriaName": "Vohwinkel Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "palmoplantar-keratoderma",
        "description": "Diffuse honeycomb-like palmoplantar keratoderma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pseudoainhum",
        "description": "Constriction bands leading to autoamputation (pseudoainhum) of digits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "starfish-shaped-keratoses",
        "description": "Starfish-shaped keratotic plaques on dorsal hands and feet",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Sensorineural hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of diffuse palmoplantar keratoderma and pseudoainhum with or without starfish-shaped keratoses",
    "notes": "Genetic testing for GJB2 mutations can support diagnosis"
  },
