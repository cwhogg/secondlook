    "formalCriteriaName": "Aquagenic Palmoplantar Keratoderma Diagnostic Criteria",
    "criteria": [
      {
        "id": "water-induced-wrinkling",
        "description": "Rapid development of translucent whitish papules and plaques on the palms after brief water exposure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "symptom-resolution-dry",
        "description": "Resolution of lesions within minutes to hours after drying",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "associated-pruritus-burning",
        "description": "Presence of pruritus, burning sensation, or discomfort during or after water exposure",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-keratodermas",
        "description": "Exclusion of other hereditary or acquired palmoplantar keratodermas",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of rapid water-induced wrinkling and papule formation on the palms with resolution after drying, plus exclusion of other keratodermas",
    "notes": "Diagnosis is primarily clinical; biopsy is rarely required."
  },
