  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (mild to moderate)",
      "Normal or mildly elevated lactate dehydrogenase"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle involvement and fatty infiltration"
    ],
    "genetic": [
      "Pathogenic variants in MTM1, DNM2, BIN1, RYR1 genes"
    ],
