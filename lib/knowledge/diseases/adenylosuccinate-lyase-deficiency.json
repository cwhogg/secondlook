  "diagnosticCriteria": {
    "formalCriteriaName": "Adenylosuccinate Lyase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "biochemical-elevation",
        "description": "Elevated levels of succinyladenosine and succinylaminoimidazole carboxamide riboside in urine or cerebrospinal fluid",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the ADSL gene by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of neurodevelopmental delay, seizures, and autistic features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "Brain MRI showing cerebral atrophy or delayed myelination",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biochemical elevation and genetic confirmation along with clinical features",
    "notes": "Diagnosis requires biochemical and genetic confirmation; clinical features support diagnosis."
  },
