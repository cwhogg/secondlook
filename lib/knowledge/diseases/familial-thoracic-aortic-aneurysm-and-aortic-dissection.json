  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Thoracic Aortic Aneurysm and Dissection Diagnostic Criteria",
    "criteria": [
      {
        "id": "family-history",
        "description": "Presence of thoracic aortic aneurysm or dissection in at least one first-degree relative",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aortic-aneurysm",
        "description": "Thoracic aortic aneurysm diagnosed by imaging (CT, MRI, or echocardiography)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic mutation in genes associated with familial thoracic aortic aneurysm (e.g., ACTA2, TGFBR1, TGFBR2, MYH11)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-syndromic-features",
        "description": "Lack of clinical features suggestive of syndromic connective tissue disorders such as Marfan syndrome or Loeys-Dietz syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of thoracic aortic aneurysm or dissection plus a positive family history or identification of a pathogenic mutation in a related gene",
    "notes": "Genetic testing is recommended to confirm diagnosis and guide family screening."
  },
