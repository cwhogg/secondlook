  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "alopecia",
        "description": "Congenital or early-onset alopecia involving scalp and body hair",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "contractures",
        "description": "Multiple joint contractures affecting large and small joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dwarfism",
        "description": "Postnatal growth retardation resulting in proportionate dwarfism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability confirmed by neuropsychological testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including micrognathia and prominent forehead",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all four major criteria: alopecia, joint contractures, dwarfism, and intellectual disability",
    "notes": "Diagnosis is clinical; genetic testing may assist but no specific gene identified."
  },
