  "diagnosticCriteria": {
    "formalCriteriaName": "Asbestosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "history-exposure",
        "description": "Documented history of significant occupational or environmental asbestos exposure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-evidence",
        "description": "Chest imaging showing bilateral interstitial fibrosis predominantly in lower lung zones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-function",
        "description": "Restrictive ventilatory defect on pulmonary function tests",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "biopsy-fibrosis",
        "description": "Histopathological confirmation of asbestos bodies and interstitial fibrosis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of interstitial lung disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of documented asbestos exposure plus characteristic radiologic findings; biopsy confirmation if available",
    "notes": "Diagnosis is primarily clinical supported by imaging and exposure history; biopsy is reserved for uncertain cases."
  },
