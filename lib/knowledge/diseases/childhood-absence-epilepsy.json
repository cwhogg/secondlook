  "diagnosticCriteria": {
    "formalCriteriaName": "International League Against Epilepsy (ILAE) 2017 Classification",
    "criteria": [
      {
        "id": "clinical-absence-seizures",
        "description": "Presence of frequent, brief episodes of impaired consciousness characterized by sudden onset and termination without loss of postural tone",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eeg-3hz-spike-wave",
        "description": "Electroencephalogram demonstrating generalized 3 Hz spike-and-wave discharges during typical absence seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-onset",
        "description": "Onset of absence seizures typically between ages 4 and 10 years",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-neurodevelopment",
        "description": "Normal neurological examination and cognitive development prior to seizure onset",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of typical clinical absence seizures with EEG showing generalized 3 Hz spike-and-wave discharges and onset between 4 and 10 years",
    "notes": "Diagnosis requires exclusion of other epilepsy syndromes and secondary causes."
  },
