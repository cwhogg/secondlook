  "keyFindings": {
    "laboratory": [
      "Elevated serum creatinine in cases with renal impairment",
      "Urinalysis showing proteinuria or hematuria"
    ],
    "imaging": [
      "Renal ultrasound revealing structural anomalies such as hypoplasia or cysts",
      "Skeletal X-rays showing tall stature with possible scoliosis"
    ],
    "genetic": [
      "FIBP (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Neurodevelopmental assessment confirming intellectual disability",
      "Developmental milestone evaluation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sotos-syndrome",
      "distinguishingFeatures": [
        "Macrocephaly more prominent",
        "Distinct facial gestalt with pointed chin",
        "Overgrowth usually accompanied by advanced bone age"
      ]
    },
    {
      "diseaseId": "beckwith-wiedemann-syndrome",
      "distinguishingFeatures": [
        "Macrosomia with neonatal hypoglycemia",
        "Abdominal wall defects such as omphalocele",
        "Increased risk of embryonal tumors"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive renal failure",
    "Severe intellectual disability with regression",
    "Unexplained recurrent urinary tract infections"
  ],
