  "keyFindings": {
    "laboratory": [
      "Positive antinuclear antibodies (ANA)",
      "Specific autoantibodies: anti-centromere, anti-topoisomerase I (Scl-70), anti-RNA polymerase III",
      "Elevated ESR and CRP in active disease"
    ],
    "imaging": [
      "High-resolution CT showing interstitial lung disease",
      "Echocardiography indicating pulmonary arterial hypertension",
      "Nailfold capillaroscopy showing capillary dropout and dilated loops"
    ],
    "genetic": [
      "No single causative gene; associations with HLA class II alleles (e.g., HLA-DRB1*11)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Skin biopsy showing dermal fibrosis and collagen deposition",
      "Pulmonary function tests showing restrictive pattern"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "mixed-connective-tissue-disease",
      "distinguishingFeatures": [
        "Presence of anti-U1 RNP antibodies",
        "Overlap features of lupus, polymyositis, and systemic sclerosis",
        "Less severe skin thickening"
      ]
    },
    {
      "diseaseId": "localized-scleroderma",
      "distinguishingFeatures": [
        "Skin involvement limited to localized plaques or bands",
        "No internal organ involvement",
        "Absence of systemic symptoms"
      ]
    },
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "Presence of malar rash and photosensitivity",
        "Positive anti-dsDNA and anti-Sm antibodies",
        "More prominent hematological and renal involvement"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive skin thickening with respiratory symptoms",
    "New onset severe hypertension with acute kidney injury",
    "Signs of pulmonary arterial hypertension (exertional dyspnea, syncope)"
  ],
  "specialistType": [
    "Rheumatologist",
