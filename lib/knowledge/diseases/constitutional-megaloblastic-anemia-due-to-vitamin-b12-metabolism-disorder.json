  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Megaloblastic Anemia due to Vitamin B12 Metabolism Disorder",
    "criteria": [
      {
        "id": "macrocytosis",
        "description": "Presence of macrocytic anemia with elevated mean corpuscular volume (MCV)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vitamin-b12-deficiency",
        "description": "Low serum vitamin B12 levels or functional deficiency evidenced by elevated methylmalonic acid and homocysteine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-megaloblastosis",
        "description": "Bone marrow examination showing megaloblastic changes with nuclear-cytoplasmic asynchrony",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes involved in vitamin B12 metabolism (e.g., MMACHC, MUT, CUBN)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-symptoms",
        "description": "Presence of neurological manifestations such as peripheral neuropathy or subacute combined degeneration",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of macrocytic anemia with confirmed vitamin B12 deficiency and bone marrow megaloblastosis",
    "notes": "Genetic testing can support diagnosis but is not mandatory. Neurological symptoms may be absent in early stages."
  },
