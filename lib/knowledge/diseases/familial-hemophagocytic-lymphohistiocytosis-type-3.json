  "diagnosticCriteria": {
    "formalCriteriaName": "HLH-2004 Diagnostic Criteria",
    "criteria": [
      {
        "id": "fever",
        "description": "Persistent high fever (>38.5°C)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cytopenias",
        "description": "Cytopenias affecting ≥2 of 3 lineages in peripheral blood (hemoglobin <9 g/dL, platelets <100,000/mm3, neutrophils <1,000/mm3)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemophagocytosis",
        "description": "Hemophagocytosis in bone marrow, spleen, or lymph nodes without evidence of malignancy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hyperferritinemia",
        "description": "Elevated serum ferritin (>500 ng/mL)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "lowNKcellactivity",
        "description": "Decreased or absent natural killer (NK) cell activity",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevatedsolubleCD25",
        "description": "Elevated soluble IL-2 receptor alpha (sCD25) levels",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular diagnosis consistent with FHL3 mutation or fulfillment of 5 out of 8 HLH-2004 criteria",
    "notes": "Genetic testing for UNC13D mutations confirms diagnosis of FHL3"
  },
