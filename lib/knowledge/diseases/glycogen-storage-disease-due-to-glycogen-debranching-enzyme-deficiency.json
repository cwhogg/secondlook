  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Glycogen Storage Disease Type III",
    "criteria": [
      {
        "id": "enzyme-activity-deficiency",
        "description": "Demonstration of deficient glycogen debranching enzyme activity in liver or muscle biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Presence of hepatomegaly and hypoglycemia with ketotic episodes in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the AGL gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-markers",
        "description": "Elevated serum transaminases and creatine kinase levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-findings",
        "description": "Ultrasound evidence of hepatomegaly and possible liver fibrosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient glycogen debranching enzyme activity plus clinical presentation consistent with disease or pathogenic AGL gene mutations",
    "notes": "Genetic testing is increasingly used to confirm diagnosis; enzyme assay remains gold standard."
  },
