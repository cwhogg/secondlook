  "diagnosticCriteria": {
    "formalCriteriaName": "Dalakas Diagnostic Criteria for Stiff Person Syndrome",
    "criteria": [
      {
        "id": "muscle-rigidity",
        "description": "Progressive muscle rigidity predominantly affecting axial and proximal limb muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-spasms",
        "description": "Episodic painful muscle spasms triggered by stimuli or emotional stress",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anti-gad-antibodies",
        "description": "Presence of elevated anti-glutamic acid decarboxylase (anti-GAD) antibodies in serum or CSF",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electrophysiology",
        "description": "Continuous motor unit activity on electromyography (EMG) at rest",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-diseases",
        "description": "Exclusion of other neurological or musculoskeletal disorders causing rigidity",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of progressive muscle rigidity and episodic spasms plus exclusion of other causes; supportive laboratory or electrophysiological findings strengthen diagnosis",
    "notes": "Anti-GAD antibodies are present in approximately 60-80% of cases but absence does not exclude diagnosis."
  },
