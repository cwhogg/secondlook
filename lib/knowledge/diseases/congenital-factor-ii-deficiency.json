  "diagnosticCriteria": {
    "formalCriteriaName": "Inherited Factor II Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "prolonged-pt-apt-t",
        "description": "Prolonged prothrombin time (PT) and activated partial thromboplastin time (aPTT) not corrected by mixing studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-factor-ii-activity",
        "description": "Markedly reduced Factor II activity levels (<10% of normal)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the F2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-bleeding-history",
        "description": "Personal or family history of bleeding diathesis including mucocutaneous or surgical bleeding",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of prolonged PT/aPTT with low Factor II activity confirmed by genetic testing",
    "notes": "Differentiation from acquired causes of Factor II deficiency is essential."
  },
