  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Ultrasound Diagnostic Criteria for Placental Insufficiency",
    "criteria": [
      {
        "id": "fetal-growth-restriction",
        "description": "Evidence of fetal growth restriction (estimated fetal weight below 10th percentile)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-umbilical-doppler",
        "description": "Abnormal umbilical artery Doppler velocimetry showing increased resistance or absent/reversed end-diastolic flow",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "maternal-risk-factors",
        "description": "Presence of maternal risk factors such as hypertension, preeclampsia, or diabetes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "oligohydramnios",
        "description": "Oligohydramnios detected by ultrasound (amniotic fluid index <5 cm)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of fetal growth restriction plus abnormal umbilical artery Doppler findings",
    "notes": "Diagnosis is primarily clinical supported by ultrasound and Doppler studies; placental histopathology may confirm diagnosis postpartum."
  },
