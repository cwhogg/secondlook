        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-syndromic-causes",
        "description": "Exclusion of other familial cancer syndromes associated with thyroid carcinoma (e.g., familial adenomatous polyposis, Cowden syndrome)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset",
        "description": "Diagnosis of thyroid carcinoma at a younger age than typical sporadic cases",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "multifocal-tumors",
        "description": "Presence of multifocal tumors within the thyroid gland",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of papillary or follicular thyroid carcinoma in two or more first-degree relatives with exclusion of other familial cancer syndromes",
    "notes": "Genetic testing may be supportive but no single causative gene has been definitively identified."
  },
