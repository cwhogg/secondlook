  "diagnosticCriteria": {
    "formalCriteriaName": "ESID Diagnostic Criteria for SCID",
    "criteria": [
      {
        "id": "lymphopenia",
        "description": "Profound lymphopenia with markedly reduced or absent T cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in IL2RG gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunoglobulin-deficiency",
        "description": "Severe hypogammaglobulinemia with absent or dysfunctional B cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Recurrent, severe infections including opportunistic infections",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of profound T-cell lymphopenia plus genetic confirmation of IL2RG mutation",
    "notes": "Early diagnosis is critical for effective treatment such as hematopoietic stem cell transplantation."
  },
