  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and histopathological diagnostic criteria for Hyperkeratosis lenticularis perstans",
    "criteria": [
      {
        "id": "clinical-lesions",
        "description": "Presence of multiple small, discrete, reddish-brown to brown hyperkeratotic papules primarily on the lower extremities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological evidence of compact hyperkeratosis, focal parakeratosis, and a band-like lymphocytic infiltrate in the upper dermis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chronic-course",
        "description": "Chronic persistence of lesions without spontaneous resolution over months to years",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical lesions plus confirmatory histopathology",
    "notes": "Diagnosis is primarily clinical supported by skin biopsy; exclusion of other keratodermas is essential"
  },
