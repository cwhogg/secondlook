  "diagnosticCriteria": {
    "formalCriteriaName": "RAG1 Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the RAG1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphocyte-phenotype",
        "description": "Severe reduction or absence of T and B lymphocytes in peripheral blood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Early onset severe infections consistent with combined immunodeficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunoglobulin-levels",
        "description": "Low or absent serum immunoglobulin levels (IgG, IgA, IgM)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "v-d-j-recombination-assay",
        "description": "Impaired V(D)J recombination demonstrated by functional assays",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic RAG1 variants plus severe T and B cell lymphopenia with compatible clinical presentation",
    "notes": "Functional assays and immunophenotyping support diagnosis but are not mandatory if genetic confirmation is present."
  },
