  "keyFindings": {
    "laboratory": [
      "Elevated serum ferritin levels may be present but not consistent",
      "Normal routine blood counts"
    ],
    "imaging": [
      "MRI showing hypointense signals in basal ganglia on T2-weighted and susceptibility-weighted imaging",
      "Iron deposition in globus pallidus, putamen, and caudate nucleus"
    ],
    "genetic": [
      "Pathogenic mutations in the FTL1 gene (ferritin light chain gene)"
    ],
    "other": [
      "Autosomal dominant inheritance pattern",
      "Progressive neurodegeneration with iron accumulation"
    ]
  },
  "differentialDiagnoses": [
    {
