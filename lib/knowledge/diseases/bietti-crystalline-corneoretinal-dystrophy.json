    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "retinitis-punctata-alba",
      "distinguishingFeatures": [
        "Smaller, punctate white retinal spots without corneal involvement",
        "Different genetic mutations (RLBP1 gene)",
        "Less progressive chorioretinal atrophy"
      ]
    },
    {
      "diseaseId": "cystinosis",
      "distinguishingFeatures": [
        "Systemic cystine accumulation with renal and endocrine involvement",
        "Corneal crystals but systemic symptoms present",
        "Different genetic cause (CTNS gene)"
      ]
    },
    {
      "diseaseId": "retinitis-pigmentosa",
      "distinguishingFeatures": [
        "Absence of crystalline deposits",
        "More prominent pigmentary changes in retina",
        "Varied inheritance patterns and genetic causes"
      ]
    }
  ],
