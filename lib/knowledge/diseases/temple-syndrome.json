  "diagnosticCriteria": {
    "formalCriteriaName": "Temple Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "growth-restriction",
        "description": "Prenatal and postnatal growth retardation including low birth weight and short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscular-hypotonia",
        "description": "Neonatal and infantile hypotonia with delayed motor milestones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "precocious-puberty",
        "description": "Early onset of puberty typically before age 8 in females and 9 in males",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including a broad forehead, small chin, and triangular face",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Molecular confirmation of maternal uniparental disomy of chromosome 14 or related imprinting defects",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "feeding-difficulties",
        "description": "Neonatal feeding difficulties and failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of prenatal/postnatal growth retardation, muscular hypotonia, and genetic confirmation of maternal uniparental disomy 14 or related imprinting defect",
    "notes": "Diagnosis is supported by characteristic facial features and early puberty but these are not mandatory."
  },
