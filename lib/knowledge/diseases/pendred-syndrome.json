  "diagnosticCriteria": {
    "formalCriteriaName": "Pendred Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss, often congenital or early childhood onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thyroid-goiter",
        "description": "Presence of thyroid goiter, typically developing in late childhood or adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-perchlorate-test",
        "description": "Abnormal perchlorate discharge test indicating impaired iodide organification",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "scl26a4-mutation",
        "description": "Identification of biallelic pathogenic mutations in the SLC26A4 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "temporal-bone-imaging",
        "description": "Imaging evidence of enlarged vestibular aqueduct or Mondini malformation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Bilateral sensorineural hearing loss plus thyroid goiter, supported by genetic testing or imaging findings",
    "notes": "Genetic testing for SLC26A4 mutations is confirmatory; perchlorate discharge test may be used when genetic testing is unavailable."
  },
