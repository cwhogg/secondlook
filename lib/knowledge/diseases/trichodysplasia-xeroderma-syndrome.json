    "criteria": [
      {
        "id": "follicular-hyperkeratosis",
        "description": "Presence of follicular hyperkeratotic papules predominantly on the face and scalp",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "trichodysplasia",
        "description": "Abnormal hair shaft morphology including twisted and broken hairs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "xeroderma",
        "description": "Diffuse xerosis and scaling of the skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological evidence of follicular epithelial dysplasia with inner root sheath abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in genes associated with follicular keratinization (if known)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: follicular hyperkeratosis, trichodysplasia, and xeroderma",
    "notes": "Diagnosis is primarily clinical supported by histopathology; genetic testing may assist but is not definitive."
