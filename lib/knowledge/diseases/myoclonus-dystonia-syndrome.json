  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Myoclonus-Dystonia",
    "criteria": [
      {
        "id": "myoclonus",
        "description": "Presence of predominant myoclonic jerks affecting upper limbs and neck",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dystonia",
        "description": "Coexisting dystonia, typically cervical or upper limb",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "alcohol-responsiveness",
        "description": "Marked improvement of myoclonus symptoms after alcohol intake",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in SGCE gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of myoclonus and dystonia with or without positive family history or genetic confirmation",
    "notes": "Alcohol responsiveness is supportive but not mandatory; genetic testing confirms diagnosis."
  },
