  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for COG7-CDG",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of multisystemic involvement including developmental delay, growth retardation, and dysmorphic features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "transferrin-glycosylation",
        "description": "Abnormal serum transferrin isoform pattern consistent with type II congenital disorders of glycosylation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic biallelic variants in the COG7 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-activity",
        "description": "Reduced activity of the conserved oligomeric Golgi complex (COG) in fibroblasts or leukocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus abnormal transferrin glycosylation pattern and confirmation by genetic testing identifying pathogenic COG7 variants",
    "notes": "Diagnosis requires integration of clinical, biochemical, and molecular findings."
  },
