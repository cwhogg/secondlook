  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Schwannomatosis",
    "criteria": [
      {
        "id": "multiple-schwannomas",
        "description": "Presence of two or more non-intradermal schwannomas confirmed by pathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-vestibular-tumors",
        "description": "No evidence of vestibular schwannomas on high-quality MRI after age 30",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pain-syndrome",
        "description": "Chronic localized or generalized pain associated with schwannomas",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in SMARCB1 or LZTR1 genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Two or more pathologically confirmed schwannomas without vestibular tumors on MRI and exclusion of NF2",
    "notes": "Genetic testing can support diagnosis but is not mandatory; exclusion of NF2 is critical."
  },
