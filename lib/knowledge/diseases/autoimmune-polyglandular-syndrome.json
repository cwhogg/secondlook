  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for APS Type 1 and Type 2",
    "criteria": [
      {
        "id": "aps-t1-1",
        "description": "Type 1 (APECED): Two of three cardinal features: chronic mucocutaneous candidiasis, hypoparathyroidism, adrenal insufficiency (Addison's)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aps-t1-2",
        "description": "Type 1: AIRE gene mutation confirmed",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aps-t1-3",
        "description": "Type 1: One cardinal feature in a sibling of an affected individual",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aps-t2-1",
        "description": "Type 2 (Schmidt syndrome): Adrenal insufficiency (Addison's) plus autoimmune thyroid disease (Hashimoto's or Graves') and/or Type 1 diabetes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aps-t2-2",
        "description": "Type 2: Presence of organ-specific autoantibodies supporting diagnosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "aps-t3-1",
        "description": "Type 3: Autoimmune thyroid disease plus another autoimmune condition (excluding adrenal insufficiency)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "aps-t4-1",
        "description": "Type 4: Two or more organ-specific autoimmune endocrine conditions not fitting Types 1-3",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Type 1: 2 of 3 cardinal features OR 1 cardinal feature plus AIRE mutation OR 1 cardinal feature in sibling of APECED patient. Type 2: Addison's disease plus autoimmune thyroid disease and/or Type 1 diabetes.",
    "notes": "Type 1 (APECED) is autosomal recessive (AIRE gene); onset in childhood. Type 2 (Schmidt) is polygenic with HLA associations; onset in adulthood. Type 2 is much more common than Type 1."
  },
