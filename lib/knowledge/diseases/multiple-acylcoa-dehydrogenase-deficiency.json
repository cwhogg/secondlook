  "keyFindings": {
    "laboratory": [
      "Elevated plasma acylcarnitines (C4-C18 species)",
      "Increased urinary glutaric acid and other organic acids",
      "Hypoglycemia with metabolic acidosis"
    ],
    "imaging": [
      "Muscle MRI showing lipid accumulation",
      "Echocardiogram demonstrating cardiomyopathy"
    ],
    "genetic": [
      "Pathogenic variants in ETFA, ETFB, or ETFDH genes"
    ],
