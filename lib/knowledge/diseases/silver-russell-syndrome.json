      "Normal routine blood tests"
    ],
    "imaging": [
      "Delayed bone age on radiographs",
      "Limb length discrepancy on skeletal survey"
    ],
    "genetic": [
      "Loss of methylation at 11p15 imprinting center 1 (~30-60% of cases)",
      "Maternal uniparental disomy of chromosome 7 (~5-10% of cases)",
      "Other imprinting defects or unknown molecular causes"
    ],
