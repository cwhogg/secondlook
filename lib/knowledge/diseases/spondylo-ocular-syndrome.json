  "diagnosticCriteria": {
    "formalCriteriaName": "Spondylo-ocular syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "ocular-manifestations",
        "description": "Presence of congenital cataracts or retinal detachment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Spondyloepiphyseal dysplasia with platyspondyly and epiphyseal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the XYLT2 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Short stature and growth delay",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria: ocular manifestations and skeletal abnormalities, with or without genetic confirmation",
    "notes": "Genetic testing supports diagnosis but is not mandatory if clinical features are definitive."
  },
