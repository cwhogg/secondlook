  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Criteria for Granuloma Annulare",
    "criteria": [
      {
        "id": "annular-plaques",
        "description": "Presence of annular, smooth, skin-colored to erythematous plaques with central clearing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "typical-location",
        "description": "Lesions predominantly located on the dorsal hands and feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing palisading granulomas with mucin deposition and necrobiotic collagen",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-infection",
        "description": "No evidence of infectious etiology on special stains and cultures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic annular plaques in typical locations plus confirmatory histopathology",
    "notes": "Diagnosis is primarily clinical supported by histopathology; exclusion of infectious granulomatous diseases is essential."
  },
