  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Imaging Diagnostic Criteria for Persistent Fetal Vasculature",
    "criteria": [
      {
        "id": "leukocoria",
        "description": "Presence of leukocoria (white pupillary reflex)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microphthalmia",
        "description": "Unilateral or bilateral microphthalmia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "persistent-hyaloid-artery",
        "description": "Visualization of persistent hyaloid artery or fibrovascular stalk on imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vitreoretinal-traction",
        "description": "Vitreoretinal traction or retinal folds on clinical exam or imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-typical-regression",
        "description": "Failure of regression of fetal hyaloid vascular system confirmed by ultrasound or MRI",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of leukocoria plus imaging evidence of persistent hyaloid artery or fibrovascular stalk",
    "notes": "Diagnosis is primarily clinical supported by imaging modalities such as ultrasound and MRI."
  },
