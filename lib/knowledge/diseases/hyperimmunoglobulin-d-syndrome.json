  "keyFindings": {
    "laboratory": [
      "Elevated serum IgD > 100 IU/mL (present in ~80%; not specific; IgD can be elevated in other autoinflammatory diseases)",
      "Elevated serum IgA",
      "Elevated urinary mevalonic acid during attacks",
      "Elevated ESR, CRP, SAA during attacks",
      "Leukocytosis during attacks"
    ],
    "imaging": [
      "No specific diagnostic imaging findings",
      "Abdominal imaging may show hepatosplenomegaly, lymphadenopathy during attacks"
    ],
    "genetic": [
      "MVK (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "MVK enzyme activity assay in lymphocytes or fibroblasts",
      "Mevalonic acid in urine (collected during attack)",
      "Genetic testing is the gold standard for diagnosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "familial-mediterranean-fever",
      "distinguishingFeatures": [
        "FMF attacks are shorter (1-3 days) without prominent lymphadenopathy",
