  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Early-onset X-linked Optic Atrophy",
    "criteria": [
      {
        "id": "optic-nerve-atrophy",
        "description": "Bilateral optic nerve atrophy confirmed by ophthalmological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset-visual-impairment",
        "description": "Visual impairment presenting in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history-x-linked",
        "description": "Positive family history consistent with X-linked inheritance pattern",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variant in the OPA3 gene or other associated loci",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "electrophysiology",
        "description": "Abnormal visual evoked potentials supporting optic nerve dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral optic nerve atrophy with early-onset visual impairment and a family history consistent with X-linked inheritance",
    "notes": "Genetic confirmation is supportive but not mandatory if clinical criteria are met."
  },
