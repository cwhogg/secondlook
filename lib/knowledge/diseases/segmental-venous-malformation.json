  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiologic Diagnostic Criteria for Venous Malformations",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of soft, compressible, bluish subcutaneous or mucosal lesion with segmental distribution",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-characteristics",
        "description": "MRI showing slow-flow venous channels with characteristic phleboliths and absence of arterial flow",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological confirmation of dilated, thin-walled venous channels lined by endothelium",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-arteriovenous-shunting",
        "description": "No evidence of arteriovenous malformation on angiography",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of typical clinical presentation plus confirmatory MRI findings",
    "notes": "Histopathology is supportive but not mandatory if imaging and clinical features are conclusive."
  },
