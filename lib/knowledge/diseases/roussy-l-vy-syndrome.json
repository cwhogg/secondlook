  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electrophysiological Diagnostic Criteria for Roussy-Lévy Syndrome",
    "criteria": [
      {
        "id": "progressive-distal-muscle-weakness",
        "description": "Progressive distal muscle weakness and atrophy predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "areflexia",
        "description": "Areflexia or hyporeflexia in affected limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiological-evidence",
        "description": "Electrophysiological studies showing demyelinating peripheral neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "pes-cavus",
        "description": "Presence of pes cavus (high-arched foot deformity)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal muscle weakness and atrophy with areflexia plus electrophysiological evidence of demyelinating neuropathy",
    "notes": "Genetic testing for PMP22 or MPZ mutations supports diagnosis but is not mandatory"
  },
