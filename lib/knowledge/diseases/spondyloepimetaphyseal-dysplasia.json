  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiographic Diagnostic Criteria for Spondyloepimetaphyseal Dysplasia",
    "criteria": [
      {
        "id": "short-stature",
        "description": "Presence of disproportionate short stature with short trunk",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-spinal-epimetaphyseal-changes",
        "description": "Radiographic evidence of abnormalities in spine, epiphyses, and metaphyses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in COL2A1 or other related genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Additional clinical features such as joint laxity, scoliosis, or early-onset osteoarthritis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Disproportionate short stature with characteristic radiographic changes in spine, epiphyses, and metaphyses; genetic confirmation supportive but not mandatory",
    "notes": "Genetic heterogeneity exists; clinical and radiographic correlation is essential"
  },
