  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Classification of Thymic Epithelial Tumors",
    "criteria": [
      {
        "id": "imaging-detection",
        "description": "Presence of anterior mediastinal mass on chest imaging (CT or MRI)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology-confirmation",
        "description": "Histopathological confirmation of thymic epithelial tumor via biopsy or surgical specimen",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry-profile",
        "description": "Immunohistochemical staining consistent with thymic epithelial origin (e.g., cytokeratin positivity)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Radiological evidence of anterior mediastinal mass plus histopathological confirmation of thymic epithelial tumor",
    "notes": "Diagnosis requires exclusion of metastatic disease and other mediastinal tumors."
  },
