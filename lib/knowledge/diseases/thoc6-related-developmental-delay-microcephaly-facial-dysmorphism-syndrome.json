  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed diagnostic criteria for THOC6-related syndrome",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Congenital microcephaly with head circumference below the 3rd percentile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Global developmental delay or intellectual disability ranging from moderate to severe",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including broad nasal bridge, hypertelorism, and thin upper lip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the THOC6 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "additional-features",
        "description": "Presence of additional neurological or skeletal anomalies such as hypotonia or clinodactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microcephaly, intellectual disability, characteristic facial dysmorphism, and confirmed biallelic THOC6 pathogenic variants",
    "notes": "Diagnosis relies heavily on genetic confirmation due to phenotypic overlap with other neurodevelopmental disorders."
  },
