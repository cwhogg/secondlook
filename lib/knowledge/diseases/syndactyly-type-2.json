  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnosis of Syndactyly type 2",
    "criteria": [
      {
        "id": "webbed-digits",
        "description": "Presence of cutaneous and/or bony syndactyly primarily affecting the third and fourth fingers and/or fourth and fifth toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "polydactyly",
        "description": "Associated presence of postaxial polydactyly (extra digits) in hands or feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the HOXD13 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiographic-findings",
        "description": "Radiographic evidence of bony fusion or duplication of phalanges",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic syndactyly and polydactyly with genetic confirmation of HOXD13 mutation or consistent family history",
    "notes": "Genetic testing is critical for confirmation due to phenotypic overlap with other syndactyly types."
  },
