        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-hypoplasia",
        "description": "Hypoplasia of ocular structures such as optic nerve or globe abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogonadotropic-hypogonadism",
        "description": "Clinical and biochemical evidence of hypogonadotropic hypogonadism with low gonadotropins and sex steroids",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hyposmia, nasal hypoplasia, ocular hypoplasia, and hypogonadotropic hypogonadism",
    "notes": "Diagnosis is clinical and supported by imaging and hormonal studies; genetic testing may assist if causative mutations identified"
