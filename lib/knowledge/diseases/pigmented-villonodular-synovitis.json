  "keyFindings": {
    "laboratory": [
      "Non-specific inflammatory markers may be mildly elevated (ESR, CRP)",
      "Synovial fluid analysis typically shows non-inflammatory or mildly inflammatory profile"
    ],
    "imaging": [
      "MRI: Synovial hypertrophy with low T2 signal intensity due to hemosiderin",
      "X-ray: May show joint effusion, bone erosions in advanced cases",
      "Ultrasound: Synovial thickening and joint effusion"
    ],
    "genetic": [
      "TWIST2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Histopathology: Villous or nodular synovial proliferation with hemosiderin-laden macrophages and multinucleated giant cells"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "rheumatoid-arthritis",
      "distinguishingFeatures": [
        "Polyarticular involvement",
        "Positive rheumatoid factor or anti-CCP antibodies",
        "Symmetric joint involvement"
      ]
    },
    {
      "diseaseId": "synovial-chondromatosis",
      "distinguishingFeatures": [
        "Presence of multiple intra-articular cartilaginous loose bodies",
        "Calcified bodies visible on imaging",
        "Lack of hemosiderin deposition"
      ]
    },
    {
      "diseaseId": "hemophilic-arthropathy",
      "distinguishingFeatures": [
        "History of bleeding disorder",
        "Recurrent hemarthroses",
        "Coagulation studies abnormal"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive joint destruction",
