  "diagnosticCriteria": {
    "formalCriteriaName": "PAGOD Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "pulmonary-artery-hypoplasia",
        "description": "Congenital hypoplasia or stenosis of the pulmonary arteries",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glucose-metabolism-abnormalities",
        "description": "Evidence of abnormal glucose metabolism or insulin resistance in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphology",
        "description": "Characteristic craniofacial dysmorphic features including micrognathia and cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-malformations",
        "description": "Associated congenital cardiac malformations other than pulmonary artery anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: pulmonary artery hypoplasia, glucose metabolism abnormalities, and craniofacial dysmorphology",
    "notes": "Diagnosis is clinical supported by imaging and metabolic studies; genetic testing may be supportive but no specific gene identified."
  },
