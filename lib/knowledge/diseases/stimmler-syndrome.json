  "diagnosticCriteria": {
    "formalCriteriaName": "Stimmler Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "short-stature",
        "description": "Severe short stature with disproportionate limb shortening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metaphyseal-dysplasia",
        "description": "Radiographic evidence of metaphyseal dysplasia with irregular metaphyseal flaring",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia and prominent forehead",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development despite skeletal abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe disproportionate short stature with metaphyseal dysplasia on radiographs plus at least one additional clinical feature such as characteristic facial dysmorphism",
    "notes": "Genetic testing for mutations in the gene encoding the causative protein can support diagnosis."
  },
