{
  "id": "dubin-johnson-syndrome",
  "name": "Dubin-Johnson syndrome",
  "aliases": [
    "Conjugated hyperbilirubinemia type 2",
    "Chronic idiopathic jaundice"
  ],
  "icd10Codes": [
    "E80.6"
  ],
  "omimId": "237500",
  "orphanetId": "ORPHA:234",
  "prevalence": {
    "estimate": "1 in 100,000",
    "classification": "rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 10,
      "max": 65,
      "peak": 14
    },
    "sexPredilection": "equal",
    "ethnicAssociations": [
      "Ashkenazi Jewish population",
      "Iranian Jews"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Dubin-Johnson Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-conjugated-hyperbilirubinemia",
        "description": "Persistent conjugated hyperbilirubinemia with normal liver enzymes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepatic-pigment-deposition",
        "description": "Presence of dark melanin-like pigment in hepatocytes on liver biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-coproporphyrin-excretion",
        "description": "Increased urinary coproporphyrin I isomer excretion (>80% of total coproporphyrin)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-hepatocellular-damage",
        "description": "No evidence of hepatocellular injury or inflammation on histology",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent conjugated hyperbilirubinemia plus either characteristic hepatic pigment deposition on biopsy or abnormal urinary coproporphyrin I excretion",
    "notes": "Genetic testing for ABCC2 mutations can confirm diagnosis but is not mandatory."
  },
