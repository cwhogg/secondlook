  "keyFindings": {
    "laboratory": [
      "Ganglionic acetylcholine receptor (gAChR) antibodies positive (~50% of cases)",
      "Antibody titers correlate with severity (>0.20 nmol/L suggestive, >1.0 nmol/L highly specific)",
      "May have other autoimmune markers (ANA, thyroid antibodies)"
    ],
    "imaging": [
      "Normal brain MRI",
      "CT abdomen may show dilated bowel loops in severe GI dysmotility"
    ],
    "genetic": [
      "ATM (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Autonomic reflex testing: severe combined sympathetic, parasympathetic, and sudomotor failure",
      "Thermoregulatory sweat test: diffuse anhidrosis",
      "QSART: absent or markedly reduced sweat output"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pure-autonomic-failure",
      "distinguishingFeatures": [
        "PAF has gradual onset over years, not subacute",
        "PAF is a synucleinopathy, not autoimmune",
        "PAF does not respond to immunotherapy"
      ]
    },
    {
      "diseaseId": "multiple-system-atrophy",
      "distinguishingFeatures": [
        "MSA has prominent motor features (parkinsonism or cerebellar ataxia)",
        "MSA is not antibody-mediated"
      ]
    },
    {
      "diseaseId": "diabetic-autonomic-neuropathy",
      "distinguishingFeatures": [
        "Diabetic neuropathy develops gradually with longstanding diabetes",
        "AAG has subacute onset regardless of diabetes status"
      ]
    }
  ],
  "redFlags": [
    "Subacute onset of severe pandysautonomia (consider paraneoplastic cause)",
    "Associated malignancy (especially small cell lung cancer) should be excluded",
    "Concurrent sensory neuropathy or encephalopathy (expand antibody testing)",
    "Failure to respond to immunotherapy (reconsider diagnosis)"
  ],
