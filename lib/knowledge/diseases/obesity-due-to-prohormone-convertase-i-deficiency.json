        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-prohormone-processing",
        "description": "Laboratory evidence of impaired prohormone processing (e.g., abnormal proinsulin to insulin ratio)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biallelic pathogenic variants in PCSK1 gene plus early-onset obesity and at least one endocrine abnormality",
    "notes": "Diagnosis is confirmed by genetic testing; clinical features support suspicion."
