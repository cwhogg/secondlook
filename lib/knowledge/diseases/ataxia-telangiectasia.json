  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Ataxia-Telangiectasia",
    "criteria": [
      {
        "id": "cerebellar-ataxia",
        "description": "Progressive cerebellar ataxia usually presenting in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-telangiectasia",
        "description": "Presence of conjunctival and bulbar telangiectasias typically appearing after age 3",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Laboratory evidence of immunodeficiency including low IgA and IgG subclasses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ataxia-telangiectasia-mutated-gene",
        "description": "Identification of biallelic pathogenic variants in the ATM gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-alpha-fetoprotein",
        "description": "Elevated serum alpha-fetoprotein (AFP) levels after infancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia and ocular telangiectasia with immunodeficiency or confirmed ATM gene mutation",
    "notes": "Diagnosis is clinical but supported by genetic testing and laboratory findings."
  },
