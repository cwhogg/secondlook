  "diagnosticCriteria": {
    "formalCriteriaName": "Movement Disorder Society Criteria for PSP",
    "criteria": [
      {
        "id": "vertical-gaze-palsy",
        "description": "Progressive supranuclear vertical gaze palsy, especially downgaze",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "postural-instability",
        "description": "Early postural instability with falls within the first year of symptom onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "akinetic-rigid-syndrome",
        "description": "Symmetric akinetic-rigid parkinsonism unresponsive to levodopa",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cognitive-dysfunction",
        "description": "Frontal cognitive dysfunction including executive dysfunction and apathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-support",
        "description": "Midbrain atrophy on MRI (hummingbird sign or morning glory sign)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of vertical supranuclear gaze palsy and early postural instability with falls",
    "notes": "Diagnosis is clinical; imaging and supportive features aid confirmation"
  },
