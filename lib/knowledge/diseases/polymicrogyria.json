  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Genetic testing may reveal mutations in genes such as TUBB2B, PIK3R2, or WDR62"
    ],
    "imaging": [
      "MRI showing multiple small, irregular gyri with abnormal cortical lamination",
      "Possible associated white matter abnormalities"
    ],
    "genetic": [
      "Mutations in genes involved in neuronal migration and cortical development (e.g., TUBB2B, PIK3R2, WDR62, GPR56)"
    ],
    "other": [
      "Electroencephalogram (EEG) abnormalities consistent with epilepsy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "lissencephaly",
      "distinguishingFeatures": [
        "Smooth brain surface with absent or reduced gyri",
        "More severe cortical thickening"
      ]
    },
    {
      "diseaseId": "pachygyria",
      "distinguishingFeatures": [
        "Broad, thick gyri rather than excessive small gyri",
        "Less irregular cortical surface"
      ]
    },
    {
      "diseaseId": "focal cortical dysplasia",
      "distinguishingFeatures": [
        "Focal cortical thickening with abnormal neurons",
        "Usually localized rather than widespread malformation"
      ]
    }
  ],
