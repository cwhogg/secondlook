  "diagnosticCriteria": {
    "formalCriteriaName": "CEDNIK Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cerebral-dysgenesis",
        "description": "Presence of cerebral dysgenesis evidenced by neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ichthyosis-keratoderma",
        "description": "Congenital ichthyosis with palmoplantar keratoderma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peripheral-neuropathy",
        "description": "Sensorimotor peripheral neuropathy confirmed by electrophysiological studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in SNAP29 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Severe psychomotor developmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: cerebral dysgenesis, ichthyosis with keratoderma, and peripheral neuropathy",
    "notes": "Genetic testing for SNAP29 mutations supports diagnosis but is not mandatory if clinical criteria are met."
  },
