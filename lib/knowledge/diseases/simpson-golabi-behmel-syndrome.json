  "diagnosticCriteria": {
    "formalCriteriaName": "Simpson-Golabi-Behmel Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "overgrowth",
        "description": "Pre- and postnatal macrosomia or generalized overgrowth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive craniofacial features including macroglossia, broad nasal bridge, and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "organomegaly",
        "description": "Visceral organ enlargement such as hepatomegaly or nephromegaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tumor-risk",
        "description": "Increased risk of embryonal tumors (e.g., Wilms tumor, hepatoblastoma)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic variant in GPC3 gene on X chromosome",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of overgrowth, characteristic facial features, organomegaly, and either genetic confirmation or tumor risk",
    "notes": "Diagnosis is primarily clinical but supported by molecular genetic testing of GPC3."
  },
  "symptoms": {
