  "diagnosticCriteria": {
    "formalCriteriaName": "Institute of Medicine (IOM) Criteria for Fetal Alcohol Syndrome",
    "criteria": [
      {
        "id": "facial-dysmorphology",
        "description": "Presence of characteristic facial features including short palpebral fissures, smooth philtrum, and thin upper lip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-deficiency",
        "description": "Prenatal and/or postnatal growth retardation (height or weight below the 10th percentile)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "central-nervous-system-abnormalities",
        "description": "Structural, neurological, or functional brain abnormalities including microcephaly, developmental delay, or cognitive impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "confirmed-prenatal-alcohol-exposure",
        "description": "Confirmed history of prenatal alcohol exposure",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (facial dysmorphology, growth deficiency, and CNS abnormalities) must be present; confirmed prenatal alcohol exposure supports diagnosis but is not mandatory.",
    "notes": "Diagnosis can be challenging without confirmed prenatal alcohol exposure; clinical judgment is essential."
  },
