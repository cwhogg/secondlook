  "diagnosticCriteria": {
    "formalCriteriaName": "Delphi Consensus Diagnostic Criteria for Pyoderma Gangrenosum",
    "criteria": [
      {
        "id": "rapid-ulceration",
        "description": "Rapid progression of a painful, necrolytic cutaneous ulcer with an irregular, undermined violaceous border",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-infection",
        "description": "Exclusion of infectious causes of cutaneous ulceration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pathergy",
        "description": "History of pathergy or development of new lesions at sites of trauma",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "associated-disease",
        "description": "Presence of associated systemic diseases such as inflammatory bowel disease, arthritis, or hematologic malignancy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Histopathologic findings consistent with neutrophilic dermatosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Both major criteria plus at least two minor or supportive criteria",
    "notes": "Diagnosis is clinical and by exclusion; biopsy is supportive but not definitive."
  },
