  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnosis of Penile Agenesis",
    "criteria": [
      {
        "id": "absence-penis",
        "description": "Complete congenital absence of the penis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-scrotum",
        "description": "Presence of normally developed scrotum and testes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-urinary-meatus",
        "description": "Ectopic or absent urethral meatus on perineum or perianal region",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-other-genital-anomalies",
        "description": "No other major external genital malformations aside from penile absence",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Complete absence of the penis with presence of normally developed scrotum and testes",
    "notes": "Diagnosis is primarily clinical and confirmed by physical examination and imaging to exclude other anomalies."
  },
