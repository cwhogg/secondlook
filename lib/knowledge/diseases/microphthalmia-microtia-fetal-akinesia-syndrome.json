  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Microphthalmia-Microtia-Fetal Akinesia Syndrome",
    "criteria": [
      {
        "id": "microphthalmia",
        "description": "Presence of microphthalmia or anophthalmia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microtia",
        "description": "External ear malformations consistent with microtia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fetal-akinesia",
        "description": "Evidence of fetal akinesia sequence including decreased fetal movements and joint contractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Additional craniofacial anomalies such as cleft palate or micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-compromise",
        "description": "Respiratory difficulties at birth due to pulmonary hypoplasia or airway anomalies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: microphthalmia, microtia, and fetal akinesia sequence",
    "notes": "Diagnosis is clinical and supported by imaging and genetic testing when available."
  },
