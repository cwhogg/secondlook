  "keyFindings": {
    "laboratory": [
      "Hypophosphatemia with low tubular phosphate reabsorption",
      "Elevated serum alkaline phosphatase",
      "Normal serum 25-hydroxyvitamin D",
      "Elevated 1,25-dihydroxyvitamin D",
      "Hypercalciuria on 24-hour urine collection"
    ],
    "imaging": [
      "Radiographic evidence of rickets (metaphyseal cupping and fraying)",
      "Nephrocalcinosis on renal ultrasound"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Family history consistent with autosomal recessive inheritance"
    ]
  },
