  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for HH-RP Syndrome",
    "criteria": [
      {
        "id": "hypogonadotropic-hypogonadism",
        "description": "Presence of hypogonadotropic hypogonadism characterized by low gonadotropin and sex steroid levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "retinitis-pigmentosa",
        "description": "Clinical and ophthalmological evidence of retinitis pigmentosa with characteristic retinal degeneration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with HH-RP syndrome (e.g., PNPLA6 mutations)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "additional-neurological-features",
        "description": "Presence of neurological symptoms such as cerebellar ataxia or peripheral neuropathy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both hypogonadotropic hypogonadism and retinitis pigmentosa clinical features, with or without genetic confirmation",
    "notes": "Genetic testing supports diagnosis but is not mandatory if clinical criteria are met."
  },
