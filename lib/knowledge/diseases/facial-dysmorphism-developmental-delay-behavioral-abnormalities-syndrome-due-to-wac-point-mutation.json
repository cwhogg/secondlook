  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for WAC-Related Neurodevelopmental Disorder",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including broad forehead, hypertelorism, and thin upper lip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability evident in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-abnormalities",
        "description": "Presence of behavioral abnormalities such as autism spectrum disorder traits, hyperactivity, or anxiety",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic WAC point mutation by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-features",
        "description": "Additional features such as hypotonia, seizures, or feeding difficulties",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic facial dysmorphism, developmental delay, behavioral abnormalities, and confirmation of pathogenic WAC point mutation",
    "notes": "Diagnosis relies heavily on genetic confirmation due to phenotypic overlap with other neurodevelopmental disorders."
  },
