  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Autosomal Spastic Paraplegia",
    "criteria": [
      {
        "id": "progressive-spasticity",
        "description": "Progressive lower limb spasticity and weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the CYP2U1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of spastic paraplegia by clinical and laboratory evaluation",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "additional-neurological-signs",
        "description": "Presence of additional neurological features such as mild cognitive impairment or cerebellar signs",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive lower limb spasticity with genetic confirmation of CYP2U1 mutation and exclusion of other causes",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical presentation may vary."
  },
