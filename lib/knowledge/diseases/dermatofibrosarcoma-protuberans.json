  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological and molecular diagnostic criteria for DFSP",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of spindle-shaped tumor cells arranged in a storiform pattern in dermis and subcutis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Strong diffuse CD34 positivity in tumor cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-fusion",
        "description": "Detection of COL1A1-PDGFB gene fusion by molecular testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Slow-growing protuberant cutaneous mass often on trunk or proximal extremities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation with CD34 positivity and/or detection of COL1A1-PDGFB fusion",
    "notes": "Molecular testing is confirmatory but diagnosis can be made with histopathology and immunohistochemistry."
  },
