  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Congenital Hydrocephalus",
    "criteria": [
      {
        "id": "ventriculomegaly",
        "description": "Enlargement of cerebral ventricles detected by prenatal or postnatal imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "macrocephaly",
        "description": "Abnormally increased head circumference greater than the 97th percentile for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-signs",
        "description": "Presence of signs of increased intracranial pressure such as bulging fontanelle, sunset eyes, and irritability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with congenital hydrocephalus (e.g., L1CAM mutations)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of ventriculomegaly on imaging plus clinical signs of increased intracranial pressure or macrocephaly",
    "notes": "Diagnosis is primarily clinical supported by neuroimaging; genetic testing may aid in etiological classification."
  },
