  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological and Clinical Diagnostic Criteria for SRUS",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of fibromuscular obliteration of the lamina propria with distorted crypt architecture on rectal biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Chronic rectal bleeding, mucous discharge, and straining during defecation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "endoscopic-findings",
        "description": "Solitary or multiple ulcer(s) or erythematous lesions in the anterior rectal wall on endoscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "defecography",
        "description": "Evidence of rectal intussusception or mucosal prolapse on defecography",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation plus compatible clinical presentation and endoscopic findings",
    "notes": "Diagnosis requires exclusion of malignancy and inflammatory bowel disease."
  },
