  "keyFindings": {
    "laboratory": [
      "CSF analysis typically normal but may show elevated protein if arachnoiditis present"
    ],
    "imaging": [
      "MRI of the spine showing fluid-filled syrinx cavity within the spinal cord",
      "Evidence of underlying cause such as spinal cord trauma, tumor, or arachnoid scarring"
    ],
    "genetic": [
      "No known genetic mutations associated with secondary syringomyelia"
    ],
    "other": [
      "Electrophysiological studies may show segmental motor and sensory deficits"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "primary-syringomyelia",
      "distinguishingFeatures": [
        "Congenital origin often associated with Chiari malformation",
        "No preceding trauma or acquired cause",
        "Different clinical progression and imaging findings"
      ]
    },
    {
      "diseaseId": "multiple-sclerosis",
      "distinguishingFeatures": [
        "Demyelinating plaques on MRI rather than syrinx cavity",
        "Relapsing-remitting neurological symptoms",
        "CSF oligoclonal bands present"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive neurological deficits",
    "New onset bladder or bowel dysfunction",
    "Signs of spinal cord compression or acute deterioration"
  ],
