  "diagnosticCriteria": {
    "formalCriteriaName": "Beta-Mannosidosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficient beta-mannosidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic mutations in the MANBA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of developmental delay, hearing loss, and recurrent infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-oligosaccharides",
        "description": "Elevated urinary excretion of mannose-rich oligosaccharides",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient beta-mannosidase enzyme activity plus either pathogenic MANBA gene mutation or characteristic clinical features",
    "notes": "Diagnosis confirmed by enzyme assay and genetic testing; clinical features support diagnosis."
  },
