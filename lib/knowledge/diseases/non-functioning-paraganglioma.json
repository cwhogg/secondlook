  "diagnosticCriteria": {
    "formalCriteriaName": "Paraganglioma Diagnostic Criteria",
    "criteria": [
      {
        "id": "imaging-characteristics",
        "description": "Presence of a well-defined mass on MRI or CT scan in typical paraganglionic sites without biochemical evidence of catecholamine hypersecretion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-assessment",
        "description": "Normal plasma and urinary catecholamine and metanephrine levels confirming non-functioning status",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological confirmation of paraganglioma with immunohistochemical staining positive for chromogranin and synaptophysin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in SDHx genes may support diagnosis but is not mandatory",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Imaging evidence of paraganglioma plus normal catecholamine levels and histopathological confirmation",
    "notes": "Exclusion of functioning paragangliomas by biochemical testing is essential to classify as non-functioning."
  },
