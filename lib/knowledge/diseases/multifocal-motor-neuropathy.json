  "diagnosticCriteria": {
    "formalCriteriaName": "EFNS/PNS Diagnostic Criteria for Multifocal Motor Neuropathy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive, asymmetric distal limb weakness without sensory loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiological-conduction-block",
        "description": "Motor conduction block on nerve conduction studies in at least one motor nerve",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anti-gm1-antibodies",
        "description": "Presence of anti-GM1 IgM antibodies in serum (supportive but not mandatory)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-sensory-involvement",
        "description": "No clinical or electrophysiological evidence of sensory nerve involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-ivig",
        "description": "Clinical improvement with intravenous immunoglobulin therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive asymmetric distal limb weakness without sensory loss plus motor conduction block on nerve conduction studies",
    "notes": "Anti-GM1 antibodies support diagnosis but are not required; response to IVIG is typical"
  },
