  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiographic Diagnostic Criteria for Dentinogenesis Imperfecta",
    "criteria": [
      {
        "id": "clinical-appearance",
        "description": "Opalescent, discolored teeth with amber, blue-gray, or brownish hue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-features",
        "description": "Bulbous crowns, cervical constriction, obliterated pulp chambers and root canals on dental X-rays",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "dentin-morphology",
        "description": "Histological evidence of abnormal dentin structure with irregular dentinal tubules",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical appearance and radiographic features",
    "notes": "Genetic testing for DSPP mutations can support diagnosis but is not mandatory"
  },
