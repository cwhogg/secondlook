  "differentialDiagnoses": [
    {
      "diseaseId": "posterior-uveitis",
      "distinguishingFeatures": [
        "Inflammation primarily involves choroid and retina rather than vitreous",
        "More prominent chorioretinal lesions",
        "Different etiologies including infections and systemic autoimmune diseases"
      ]
    },
    {
      "diseaseId": "anterior-uveitis",
      "distinguishingFeatures": [
        "Predominant inflammation in anterior chamber",
        "More pronounced anterior chamber cells and flare",
        "Less vitreous involvement"
      ]
    },
    {
