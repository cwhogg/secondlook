  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Epidermolysis Bullosa Simplex with Pyloric Atresia",
    "criteria": [
      {
        "id": "clinical-blistering",
        "description": "Presence of skin blistering and fragility predominantly on hands and feet from birth or neonatal period",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pyloric-atresia-confirmation",
        "description": "Radiological or surgical confirmation of pyloric atresia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in ITGB4 or ITGA6 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Immunofluorescence showing reduced or absent integrin α6β4 expression in skin biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy demonstrating intraepidermal cleavage consistent with epidermolysis bullosa simplex",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical blistering and pyloric atresia confirmed by imaging or surgery plus identification of pathogenic variants in ITGB4 or ITGA6 genes",
    "notes": "Genetic testing is critical for definitive diagnosis; skin biopsy and immunofluorescence are supportive."
  },
