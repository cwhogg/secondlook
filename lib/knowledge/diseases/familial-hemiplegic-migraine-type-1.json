  "diagnosticCriteria": {
    "formalCriteriaName": "International Classification of Headache Disorders (ICHD-3) Criteria for Familial Hemiplegic Migraine",
    "criteria": [
      {
        "id": "family-history",
        "description": "At least one first- or second-degree relative with hemiplegic migraine",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "motor-aura",
        "description": "Presence of fully reversible motor weakness (hemiparesis) during aura",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "migraine-headache",
        "description": "Headache fulfilling migraine criteria with aura",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic CACNA1A gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of hemiparesis and migraine-like symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of motor aura with hemiparesis, migraine headache with aura, and positive family history",
    "notes": "Genetic testing for CACNA1A mutations supports diagnosis but is not mandatory."
  },
