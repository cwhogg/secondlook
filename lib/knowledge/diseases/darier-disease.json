  "diagnosticCriteria": {
    "formalCriteriaName": "Darier Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-papules",
        "description": "Presence of greasy, crusted, hyperkeratotic papules primarily in seborrheic areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological evidence of suprabasal acantholysis and dyskeratosis with corps ronds and grains",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nail-changes",
        "description": "Characteristic nail abnormalities including V-shaped notching and longitudinal ridging",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of typical clinical papules in seborrheic areas plus histopathological confirmation",
    "notes": "Genetic testing for ATP2A2 mutations can support diagnosis but is not mandatory"
  },
