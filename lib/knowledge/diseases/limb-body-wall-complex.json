  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "body-wall-defect",
        "description": "Large ventral body wall defect involving thorax and/or abdomen",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-abnormalities",
        "description": "Severe limb defects including clubfoot, absent or hypoplastic limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "umbilical-cord-anomaly",
        "description": "Short or absent umbilical cord with persistent extraembryonic coelom",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-defects",
        "description": "Craniofacial anomalies such as facial clefts or encephalocele",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of large ventral body wall defect plus at least two of the following: severe limb abnormalities and umbilical cord anomalies",
    "notes": "Diagnosis is primarily clinical and supported by prenatal imaging findings."
  },
