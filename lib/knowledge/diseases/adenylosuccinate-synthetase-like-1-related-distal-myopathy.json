  "diagnosticCriteria": {
    "formalCriteriaName": "ASL1-Related Distal Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive distal muscle weakness predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing myopathic changes with rimmed vacuoles and fiber size variation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the ASL1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "EMG demonstrating myopathic motor unit potentials",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-neuropathy",
        "description": "Exclusion of peripheral neuropathy by nerve conduction studies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal muscle weakness with confirmatory muscle biopsy findings and pathogenic ASL1 gene mutation",
    "notes": "Diagnosis requires integration of clinical, histopathological, and genetic data."
  },
