  "diagnosticCriteria": {
    "formalCriteriaName": "Microvillous Inclusion Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of characteristic microvillous inclusions in enterocytes on electron microscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Severe, intractable neonatal diarrhea with malabsorption",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in MYO5B or STX3 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Abnormal localization of brush border proteins (e.g., CD10, villin) in enterocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe neonatal diarrhea with histopathological confirmation of microvillous inclusions and/or pathogenic mutations in MYO5B or STX3 genes",
    "notes": "Diagnosis often requires combined clinical, histological, and genetic evidence."
  },
