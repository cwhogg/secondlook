        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Expression of desmin, EMA, and CD68 with variable positivity for CD99",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "molecular-genetics",
        "description": "Detection of characteristic gene fusions involving EWSR1 or FUS (e.g., EWSR1-CREB1, EWSR1-ATF1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Slow-growing superficial soft tissue mass, often painless",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological features plus either immunohistochemical profile or molecular genetic confirmation",
    "notes": "Molecular confirmation is increasingly considered essential due to overlapping histological features with other soft tissue tumors."
