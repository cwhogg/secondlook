        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Generalized muscle hypotonia observed clinically",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-skeletal-anomalies",
        "description": "Lack of other major skeletal malformations differentiating from syndromic synostoses",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-chromosomal-analysis",
        "description": "Normal karyotype and absence of chromosomal abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital radioulnar synostosis plus developmental delay and hypotonia",
    "notes": "Diagnosis is clinical and radiological; genetic testing may be inconclusive."
  },
