  "keyFindings": {
    "laboratory": [
      "High-titer anti-U1 RNP antibodies (defining serologic feature)",
      "Positive ANA (speckled pattern)",
      "Anti-dsDNA usually negative or low titer",
      "Anti-Sm typically negative",
      "Elevated CK if myositis present",
      "Elevated ESR and CRP during active disease",
      "Hypergammaglobulinemia common"
    ],
    "imaging": [
      "Chest CT: ground-glass opacities or fibrosis if ILD present",
      "Echocardiography: screening for pulmonary hypertension (elevated RVSP)",
      "Right heart catheterization for confirmed pulmonary hypertension",
      "Hand radiographs may show erosive or non-erosive arthropathy",
      "Esophageal manometry: distal esophageal dysmotility"
    ],
    "genetic": [
      "HLA-DR4 association reported",
      "No specific single-gene cause; polygenic susceptibility",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Pulmonary function tests (reduced DLCO in pulmonary hypertension/ILD)",
      "Nailfold capillaroscopy may show dilated or dropout capillaries",
      "EMG/nerve conduction if myositis or neuropathy suspected"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "scleroderma-systemic",
      "distinguishingFeatures": [
        "SSc has diffuse or limited skin thickening beyond fingers",
        "SSc has anti-Scl-70 or anti-centromere antibodies",
        "MCTD has high-titer anti-U1 RNP as defining feature"
      ]
    },
    {
      "diseaseId": "dermatomyositis",
      "distinguishingFeatures": [
        "DM has characteristic skin rashes (heliotrope, Gottron's)",
        "DM has more prominent proximal weakness",
        "DM has anti-Mi-2, anti-MDA5, anti-TIF1-gamma antibodies"
      ]
    },
    {
      "diseaseId": "fibromyalgia",
      "distinguishingFeatures": [
        "FM has normal autoimmune markers",
        "FM lacks Raynaud's and swollen hands",
        "FM has no objective inflammatory findings"
      ]
    }
  ],
  "redFlags": [
    "Progressive dyspnea on exertion (pulmonary hypertension - leading cause of death)",
    "Declining DLCO on pulmonary function tests",
    "Renal involvement (proteinuria, rising creatinine)",
    "Evolution of features toward a more defined CTD (SLE, SSc, polymyositis)",
    "Scleroderma renal crisis features (hypertension, AKI)"
  ],
  "specialistType": [
    "Rheumatologist",
    "Pulmonologist",
    "Cardiologist",
    "Gastroenterologist",
    "Neurologist"
  ],
