  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Kernicterus",
    "criteria": [
      {
        "id": "hyperbilirubinemia",
        "description": "History of significant neonatal hyperbilirubinemia with serum bilirubin levels exceeding neurotoxic thresholds",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-dysfunction",
        "description": "Presence of characteristic neurological signs including dystonia, choreoathetosis, and sensorineural hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "MRI evidence of bilateral basal ganglia and brainstem abnormalities consistent with bilirubin toxicity",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "audiological-assessment",
        "description": "Confirmed sensorineural hearing loss on audiometry",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of neonatal hyperbilirubinemia plus characteristic neurological dysfunction signs",
    "notes": "Diagnosis is clinical supported by imaging and audiological studies; exclusion of other causes of neonatal encephalopathy is essential."
  },
