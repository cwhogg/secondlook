  "diagnosticCriteria": {
    "formalCriteriaName": "No standardized formal criteria; diagnosis based on overlap features",
    "criteria": [
      {
        "id": "systemic-sclerosis-features",
        "description": "Presence of clinical features consistent with systemic sclerosis (e.g., skin thickening, Raynaud phenomenon)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "inflammatory-myopathy",
        "description": "Evidence of inflammatory myopathy demonstrated by elevated muscle enzymes, EMG, or muscle biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoantibodies",
        "description": "Presence of specific autoantibodies such as anti-PM/Scl, anti-Ku, or anti-U1-RNP",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nailfold-capillaroscopy",
        "description": "Abnormal nailfold capillaroscopy findings typical of systemic sclerosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of systemic sclerosis features plus inflammatory myopathy confirmed by clinical, laboratory, or histopathological evidence",
    "notes": "Diagnosis relies on clinical overlap and exclusion of other connective tissue diseases"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Skin thickening and sclerosis",
        "frequency": 0.85,
        "bodySystem": "dermatological",
        "notes": "Typically involves fingers and hands",
        "searchTerms": [
          "thickened skin",
          "hardening of skin",
          "skin tightening"
        ]
      },
      {
        "symptomName": "Proximal muscle weakness",
        "frequency": 0.8,
        "bodySystem": "musculoskeletal",
        "notes": "Symmetric and progressive",
        "searchTerms": [
          "weakness in upper arm and thigh muscles",
          "proximal muscle weakness",
          "difficulty lifting objects"
        ]
      },
      {
        "symptomName": "Raynaud phenomenon",
        "frequency": 0.75,
        "bodySystem": "cardiovascular",
        "notes": "Episodic digital ischemia triggered by cold or stress"
      }
    ],
    "common": [
      {
        "symptomName": "Dysphagia due to esophageal dysmotility",
        "frequency": 0.65,
        "bodySystem": "gastrointestinal",
        "notes": "Often associated with gastroesophageal reflux",
        "searchTerms": [
          "difficulty swallowing",
          "swallowing problems due to esophagus"
        ]
      },
      {
        "symptomName": "Arthralgia or arthritis",
        "frequency": 0.6,
        "bodySystem": "musculoskeletal",
        "notes": "Non-erosive joint involvement",
        "searchTerms": [
          "joint pain or swelling",
          "arthritis symptoms",
          "painful or inflamed joints"
        ]
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.6,
        "bodySystem": "constitutional",
        "notes": "Common and debilitating"
      },
      {
        "symptomName": "Interstitial lung disease",
        "frequency": 0.55,
        "bodySystem": "respiratory",
        "notes": "Variable severity",
        "searchTerms": [
          "lung tissue scarring",
          "interstitial lung inflammation",
          "thickened lung tissue"
        ]
      },
      {
        "symptomName": "Calcinosis cutis",
        "frequency": 0.5,
        "bodySystem": "dermatological",
        "notes": "Subcutaneous calcium deposits"
