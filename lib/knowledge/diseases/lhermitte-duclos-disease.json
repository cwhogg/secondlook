  "diagnosticCriteria": {
    "formalCriteriaName": "Lhermitte-Duclos Diagnostic Criteria",
    "criteria": [
      {
        "id": "imaging-characteristic",
        "description": "Presence of a thickened, dysplastic cerebellar folium with a striated or tiger-striped pattern on MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological confirmation showing dysplastic gangliocytoma with enlarged cerebellar ganglion cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Symptoms of cerebellar dysfunction such as ataxia and cranial nerve deficits",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pten-mutation",
        "description": "Identification of PTEN gene mutation or association with Cowden syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "MRI evidence of characteristic cerebellar lesion plus histopathological confirmation or clinical features consistent with cerebellar dysfunction in presence of typical imaging",
    "notes": "Genetic testing for PTEN mutations can support diagnosis and identify syndromic association."
  },
