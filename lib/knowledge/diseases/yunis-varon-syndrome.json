  "diagnosticCriteria": {
    "formalCriteriaName": "No formal diagnostic criteria established",
    "criteria": [
      {
        "id": "absent-clavicles",
        "description": "Congenital absence or hypoplasia of the clavicles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including brachycephaly, prominent forehead, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-anomalies",
        "description": "Severe skeletal abnormalities including hypoplastic or absent thumbs and terminal phalanges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-impairment",
        "description": "Developmental delay and hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-malformations",
        "description": "Congenital heart defects such as ventricular septal defect",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital absence or hypoplasia of clavicles plus characteristic craniofacial dysmorphism and skeletal anomalies",
    "notes": "Diagnosis is primarily clinical supported by radiographic findings and genetic testing of FIG4 gene mutations"
  },
