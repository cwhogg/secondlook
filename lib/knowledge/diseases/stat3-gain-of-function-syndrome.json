  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (ESR, CRP)",
      "Autoantibodies (ANA, anti-thyroid antibodies)",
      "Hypogammaglobulinemia or dysregulated immunoglobulin levels",
      "Cytopenias on complete blood count"
    ],
    "imaging": [
      "Lymphadenopathy and hepatosplenomegaly on ultrasound or CT",
      "Interstitial lung disease on chest CT",
      "Pulmonary hypertension on echocardiogram"
    ],
    "genetic": [
      "STAT3 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Abnormal lymphocyte subset analysis",
      "Histopathology of lymphoid tissue showing hyperplasia"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autoimmune-lymphoproliferative-syndrome",
      "distinguishingFeatures": [
        "Mutations in FAS pathway genes",
        "Prominent lymphadenopathy with defective lymphocyte apoptosis",
        "Less frequent endocrinopathies"
      ]
    },
    {
      "diseaseId": "common-variable-immunodeficiency",
      "distinguishingFeatures": [
        "Hypogammaglobulinemia without STAT3 mutations",
        "Predominantly recurrent infections without autoimmunity",
        "Later onset in many cases"
      ]
    }
  ],
  "redFlags": [
    "Early onset multi-organ autoimmunity",
    "Severe or recurrent infections despite normal immunoglobulin levels",
    "Progressive lymphoproliferation with organomegaly"
  ],
