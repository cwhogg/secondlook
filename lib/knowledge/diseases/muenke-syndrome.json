  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Muenke Syndrome",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Coronal craniosynostosis (unilateral or bilateral)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fgfr3-p250r-mutation",
        "description": "Presence of FGFR3 p.Pro250Arg mutation confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midface-hypoplasia",
        "description": "Midface hypoplasia with characteristic facial features",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural or conductive hearing loss",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of coronal craniosynostosis plus identification of FGFR3 p.Pro250Arg mutation",
    "notes": "Genetic testing is essential to confirm diagnosis due to phenotypic overlap with other craniosynostosis syndromes."
  },
