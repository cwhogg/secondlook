        "requiredForDiagnosis": true
      },
      {
        "id": "malabsorption-evidence",
        "description": "Evidence of malabsorption including steatorrhea and nutrient deficiencies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "small-bowel-biopsy",
        "description": "Small intestinal biopsy showing villous atrophy and mucosal inflammation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of malabsorption such as celiac disease and infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-antibiotics",
        "description": "Clinical improvement with antibiotic therapy and folate supplementation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All major criteria must be met including chronic diarrhea, evidence of malabsorption, characteristic biopsy findings, and exclusion of other causes",
    "notes": "Diagnosis is clinical supported by histology and response to treatment; other malabsorption syndromes must be ruled out."
  },
