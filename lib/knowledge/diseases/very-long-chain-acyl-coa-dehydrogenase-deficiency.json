  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for VLCAD deficiency",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced VLCAD enzyme activity in fibroblasts or lymphocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the ACADVL gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acylcarnitine-profile",
        "description": "Elevated C14:1 and other long-chain acylcarnitines on plasma acylcarnitine analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of hypoketotic hypoglycemia, cardiomyopathy, or rhabdomyolysis episodes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Identification of pathogenic ACADVL variants or reduced VLCAD enzyme activity combined with characteristic acylcarnitine profile",
    "notes": "Newborn screening programs often detect elevated C14:1 acylcarnitine levels prompting further confirmatory testing."
  },
