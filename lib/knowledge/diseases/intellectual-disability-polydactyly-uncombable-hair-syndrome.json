  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Intellectual Disability-Polydactyly-Uncombable Hair Syndrome",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of intellectual disability confirmed by standardized cognitive testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "polydactyly",
        "description": "Presence of postaxial or preaxial polydactyly confirmed by physical examination or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "uncombable-hair",
        "description": "Characteristic uncombable hair phenotype with spangled, dry, and frizzy hair resistant to combing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Presence of mild facial dysmorphic features such as broad nasal bridge or low-set ears",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay in early childhood",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (intellectual disability, polydactyly, and uncombable hair) must be present for diagnosis.",
    "notes": "Genetic testing may support diagnosis but is not mandatory due to limited data on causative mutations."
  },
