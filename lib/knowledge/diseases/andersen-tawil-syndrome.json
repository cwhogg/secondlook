  "diagnosticCriteria": {
    "formalCriteriaName": "Andersen-Tawil Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "periodic-paralysis",
        "description": "Recurrent episodes of periodic paralysis or muscle weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-arrhythmias",
        "description": "Presence of ventricular arrhythmias including prolonged QT interval or ventricular ectopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic dysmorphic facial features such as low-set ears, hypertelorism, and broad forehead",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of Andersen-Tawil Syndrome or related symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "KCNJ2-mutation",
        "description": "Identification of pathogenic mutation in KCNJ2 gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (periodic paralysis, cardiac arrhythmias, and distinctive facial features) or identification of a pathogenic KCNJ2 mutation with at least two clinical features",
    "notes": "Genetic testing for KCNJ2 mutations is supportive but not mandatory for diagnosis."
  },
