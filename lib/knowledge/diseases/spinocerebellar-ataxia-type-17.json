        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of autosomal dominant cerebellar ataxia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of TBP gene expansion plus progressive cerebellar ataxia",
    "notes": "Diagnosis relies heavily on genetic testing; clinical features support but are not definitive alone."
