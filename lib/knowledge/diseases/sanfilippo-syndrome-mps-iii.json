  "diagnosticCriteria": {
    "formalCriteriaName": "Sanfilippo Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of one of the four lysosomal enzymes involved in heparan sulfate degradation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-gags",
        "description": "Elevated urinary excretion of heparan sulfate glycosaminoglycans",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Progressive neurodegeneration with developmental delay and behavioral abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in SGSH, NAGLU, HGSNAT, or GNS genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of enzyme deficiency or elevated urinary heparan sulfate plus characteristic clinical features",
    "notes": "Genetic testing is confirmatory and useful for subtype classification"
  },
