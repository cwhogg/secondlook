  "keyFindings": {
    "laboratory": [
      "Routine blood tests typically normal",
      "Exclusion of metabolic or inflammatory causes"
    ],
    "imaging": [
      "MRI showing asymmetric cerebral atrophy or signal changes contralateral to hemiatrophy",
      "Dopamine transporter (DAT) SPECT imaging may show decreased uptake on affected side"
    ],
    "genetic": [
      "No consistent genetic mutations identified; mostly sporadic cases"
    ],
    "other": [
      "Electromyography may show chronic denervation in hemiatrophic limb"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "unilateral-parkinsonism-secondary-to-stroke",
      "distinguishingFeatures": [
        "History of acute stroke",
        "Imaging evidence of vascular lesion",
        "Rapid onset of symptoms"
      ]
    },
    {
      "diseaseId": "corticobasal-degeneration",
      "distinguishingFeatures": [
        "Progressive asymmetric rigidity with cortical sensory loss",
        "Apraxia and alien limb phenomenon",
        "More rapid progression"
      ]
    },
    {
      "diseaseId": "primary-progressive-hemiparkinsonism",
      "distinguishingFeatures": [
        "Lack of hemiatrophy",
        "Progressive neurodegeneration",
        "Different imaging patterns"
      ]
    }
  ],
