  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible elevated lactate in some cases"
    ],
    "imaging": [
      "Brain MRI showing corpus callosum thinning",
      "White matter abnormalities in periventricular regions"
    ],
    "genetic": [
      "HACE1 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electroencephalogram (EEG) showing epileptiform activity",
      "Neurophysiology studies may show upper motor neuron involvement"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hereditary-spastic-paraplegia",
      "distinguishingFeatures": [
        "Usually milder or absent developmental delay",
        "Later onset of spasticity",
        "Less frequent epilepsy"
      ]
    },
    {
      "diseaseId": "early-infantile-epileptic-encephalopathy",
      "distinguishingFeatures": [
        "Prominent epileptic seizures with severe encephalopathy",
        "Less prominent spastic paraplegia",
        "Distinct genetic causes"
      ]
    },
    {
      "diseaseId": "cerebral-palsy-spastic-type",
      "distinguishingFeatures": [
        "Non-progressive course",
        "History of perinatal insult",
        "Absence of genetic mutations typical for SP-SDDE syndrome"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of spasticity and developmental regression",
    "Refractory epilepsy with multiple seizure types",
    "Onset of symptoms in infancy with severe global delay"
