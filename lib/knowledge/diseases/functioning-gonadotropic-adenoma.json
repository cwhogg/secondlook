  "keyFindings": {
    "laboratory": [
      "Elevated serum LH and/or FSH levels",
      "Normal or mildly elevated prolactin levels",
      "Normal or low serum alpha-subunit levels"
    ],
    "imaging": [
      "Pituitary MRI showing sellar mass with possible suprasellar extension",
      "No cavernous sinus invasion in most cases"
    ],
    "genetic": [
      "No well-established genetic mutations associated"
    ],
    "other": [
      "Histopathology positive for gonadotropin subunits (LH, FSH) by immunohistochemistry"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "prolactin-secreting-pituitary-adenoma",
      "distinguishingFeatures": [
        "Markedly elevated prolactin levels",
        "Responsive to dopamine agonists",
        "Different immunohistochemical profile"
      ]
    },
    {
      "diseaseId": "non-functioning-pituitary-adenoma",
      "distinguishingFeatures": [
        "Absence of clinical hormone hypersecretion",
        "Normal gonadotropin levels",
        "Mass effect symptoms predominate"
      ]
    },
    {
      "diseaseId": "gonadotropin-independent-ovarian-hyperstimulation",
      "distinguishingFeatures": [
        "No pituitary adenoma on imaging",
        "Ovarian hyperstimulation due to exogenous factors or other etiologies"
      ]
    }
  ],
  "redFlags": [
