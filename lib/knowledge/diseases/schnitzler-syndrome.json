  "keyFindings": {
    "laboratory": [
      "Monoclonal IgM or IgG gammopathy on serum protein electrophoresis",
      "Elevated CRP and ESR",
      "Leukocytosis with neutrophilia"
    ],
    "imaging": [
      "Bone scintigraphy showing increased uptake in long bones",
      "X-ray or MRI showing bone remodeling or hyperostosis"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy showing neutrophilic urticarial dermatosis"
    ]
  },
