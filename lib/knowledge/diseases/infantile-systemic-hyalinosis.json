  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Diagnostic Criteria for Infantile Systemic Hyalinosis",
    "criteria": [
      {
        "id": "cutaneous-hyaline-deposits",
        "description": "Presence of widespread cutaneous and subcutaneous hyaline material deposits confirmed by biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-contractures",
        "description": "Progressive painful joint contractures involving multiple large and small joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gastrointestinal-symptoms",
        "description": "Severe gastrointestinal involvement including chronic diarrhea and failure to thrive",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consanguinity or affected siblings suggesting autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the ANTXR2 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (cutaneous hyaline deposits, progressive joint contractures, and severe gastrointestinal symptoms) supported by histopathology and/or genetic testing",
    "notes": "Diagnosis is primarily clinical supported by histopathological confirmation and genetic analysis."
  },
