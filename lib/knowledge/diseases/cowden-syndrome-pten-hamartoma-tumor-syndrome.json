  "diagnosticCriteria": {
    "formalCriteriaName": "International Cowden Consortium Diagnostic Criteria",
    "criteria": [
      {
        "id": "pathognomonic-lesions",
        "description": "Facial trichilemmomas, acral keratoses, and papillomatous papules",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "breast-cancer",
        "description": "Personal history of breast cancer",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "thyroid-cancer",
        "description": "Personal history of thyroid cancer (especially follicular type)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "macrocephaly",
        "description": "Macrocephaly (head circumference >97th percentile)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "endometrial-cancer",
        "description": "Personal history of endometrial cancer",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "lipomas",
        "description": "Multiple lipomas",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathognomonic mucocutaneous lesions or two major criteria or one major and three minor criteria",
    "notes": "Genetic testing for PTEN mutations supports diagnosis but is not mandatory."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Facial trichilemmomas",
        "frequency": 0.85,
        "bodySystem": "dermatological",
        "notes": "Multiple small, flesh-colored papules on the face"
      },
      {
        "symptomName": "Acral keratoses",
        "frequency": 0.75,
        "bodySystem": "dermatological",
        "notes": "Keratotic papules on the dorsal hands and feet"
      },
      {
        "symptomName": "Papillomatous papules",
        "frequency": 0.7,
        "bodySystem": "dermatological",
        "notes": "Small wart-like lesions on mucous membranes and skin"
      }
    ],
    "common": [
      {
        "symptomName": "Macrocephaly",
        "frequency": 0.75,
        "bodySystem": "constitutional",
        "notes": "Head circumference above 97th percentile"
      },
      {
        "symptomName": "Breast fibroadenomas",
        "frequency": 0.65,
        "bodySystem": "reproductive",
        "notes": "Benign breast tumors common in females"
      },
      {
        "symptomName": "Thyroid nodules",
        "frequency": 0.6,
        "bodySystem": "endocrine",
        "notes": "Benign or malignant thyroid growths"
      },
      {
        "symptomName": "Gastrointestinal hamartomatous polyps",
        "frequency": 0.55,
        "bodySystem": "gastrointestinal",
        "notes": "Polyps throughout the GI tract"
      },
      {
        "symptomName": "Lipomas",
        "frequency": 0.5,
        "bodySystem": "dermatological",
        "notes": "Benign fatty tumors"
      }
    ],
    "occasional": [
      {
        "symptomName": "Endometrial hyperplasia",
        "frequency": 0.4,
        "bodySystem": "reproductive",
        "notes": "Precursor lesion to endometrial cancer"
      },
      {
        "symptomName": "Lhermitte-Duclos disease (dysplastic cerebellar gangliocytoma)",
        "frequency": 0.3,
        "bodySystem": "neurological",
        "notes": "Rare cerebellar tumor associated with PTEN mutations"
      },
      {
        "symptomName": "Mucosal neuromas",
        "frequency": 0.25,
        "bodySystem": "otolaryngological",
        "notes": "Benign nerve tumors in oral mucosa"
      },
      {
        "symptomName": "Vascular malformations",
        "frequency": 0.2,
        "bodySystem": "cardiovascular",
        "notes": "Capillary or venous malformations"
      },
      {
        "symptomName": "Thyroid follicular adenomas",
        "frequency": 0.15,
        "bodySystem": "endocrine",
        "notes": "Benign thyroid tumors"
      }
    ],
    "rare": [
      {
        "symptomName": "Renal cell carcinoma",
        "frequency": 0.08,
        "bodySystem": "renal",
        "notes": "Malignant kidney tumor associated with PTEN mutations"
      },
      {
        "symptomName": "Melanoma",
        "frequency": 0.05,
        "bodySystem": "dermatological",
        "notes": "Skin cancer occasionally reported"
      },
      {
        "symptomName": "Lymphoid malignancies",
        "frequency": 0.03,
        "bodySystem": "hematological",
        "notes": "Rare blood cancers"
      }
    ]
  },
