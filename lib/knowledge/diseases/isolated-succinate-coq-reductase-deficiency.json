  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria established",
    "criteria": [
      {
        "id": "enzyme-activity-deficiency",
        "description": "Demonstration of isolated deficiency of succinate-CoQ reductase (complex II) enzyme activity in muscle or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes encoding complex II subunits (e.g., SDHA, SDHB, SDHC, SDHD)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical features consistent with mitochondrial complex II deficiency such as neurodevelopmental delay and muscle weakness",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Definitive diagnosis requires demonstration of isolated complex II enzyme deficiency plus pathogenic genetic variants in complex II subunit genes",
    "notes": "Muscle biopsy and biochemical assays are critical; genetic testing confirms diagnosis"
  },
