  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Acromesomelic Dysplasia, Maroteaux Type",
    "criteria": [
      {
        "id": "short-limbs",
        "description": "Disproportionate shortening of the middle and distal segments of the limbs (acromesomelic shortening)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-bone-changes",
        "description": "Characteristic radiographic abnormalities including shortened and malformed tubular bones, particularly in the forearms and lower legs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the NPR2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-organ-malformations",
        "description": "No major visceral or organ malformations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of disproportionate acromesomelic limb shortening with characteristic radiological findings and confirmation by genetic testing for NPR2 mutations",
    "notes": "Diagnosis is primarily clinical and radiological, confirmed by molecular genetic testing."
  },
