  "keyFindings": {
    "laboratory": [
      "Reduced tear and saliva production on functional testing",
      "Normal routine blood tests"
    ],
    "imaging": [
      "MRI or ultrasound showing aplasia or hypoplasia of lacrimal and salivary glands",
      "Radiographs revealing dental anomalies and digital bone abnormalities"
    ],
    "genetic": [
      "FGF10 (causative)",
      "FGFR3 (causative)",
      "FGFR2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Audiometry confirming conductive hearing loss",
      "Clinical examination revealing characteristic facial and digital features"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "agenesis-of-lacrimal-and-salivary-glands",
      "distinguishingFeatures": [
        "Isolated lacrimal and salivary gland aplasia without dental or digital anomalies"
      ]
    },
    {
      "diseaseId": "apert-syndrome",
      "distinguishingFeatures": [
        "Craniosynostosis with syndactyly but lacks lacrimal and salivary gland aplasia"
      ]
    },
    {
      "diseaseId": "ectrodactyly-ectodermal-dysplasia-clefting-syndrome",
      "distinguishingFeatures": [
        "Presence of cleft lip/palate and ectodermal dysplasia features absent in LADD"
      ]
    }
  ],
  "redFlags": [
    "Severe dry eyes leading to corneal ulceration",
    "Recurrent respiratory infections due to glandular hypoplasia",
    "Progressive hearing loss impacting development"
  ],
