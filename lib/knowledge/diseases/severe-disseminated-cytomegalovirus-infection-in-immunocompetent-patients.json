      "Thrombocytopenia",
      "Elevated inflammatory markers (CRP, ESR)"
    ],
    "imaging": [
      "Chest X-ray or CT showing bilateral interstitial infiltrates",
      "Abdominal ultrasound demonstrating hepatosplenomegaly",
      "MRI brain in cases with neurological involvement showing focal lesions"
    ],
    "genetic": [
      "No specific genetic markers identified"
    ],
    "other": [
      "Histopathology showing CMV inclusion bodies in affected tissues",
      "Serology may show CMV IgM positivity but less reliable in disseminated disease"
    ]
  },
