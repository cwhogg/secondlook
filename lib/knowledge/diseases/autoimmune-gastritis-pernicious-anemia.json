  "keyFindings": {
    "laboratory": [
      "Macrocytic anemia with elevated mean corpuscular volume (MCV)",
      "Low serum vitamin B12 levels",
      "Positive anti-parietal cell antibodies",
      "Elevated methylmalonic acid and homocysteine levels",
      "Presence of intrinsic factor antibodies (variable)"
    ],
    "imaging": [
      "Endoscopic findings of gastric mucosal atrophy in the corpus and fundus",
      "Possible gastric intestinal metaplasia on biopsy"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology showing loss of parietal cells and lymphocytic infiltration",
      "Schilling test historically used to confirm B12 malabsorption (rarely used now)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "h-pylori-associated-chronic-gastritis",
      "distinguishingFeatures": [
        "Presence of Helicobacter pylori infection",
        "Antral predominant gastritis rather than corpus",
        "Negative intrinsic factor antibodies"
      ]
    },
    {
      "diseaseId": "dietary-vitamin-b12-deficiency",
      "distinguishingFeatures": [
        "History of inadequate dietary intake (e.g., veganism)",
        "No gastric mucosal atrophy",
        "Negative anti-parietal cell and intrinsic factor antibodies"
      ]
    },
    {
      "diseaseId": "other-causes-of-megaloblastic-anemia",
      "distinguishingFeatures": [
        "Folate deficiency",
        "Drug-induced causes (e.g., methotrexate)",
        "No autoimmune markers"
      ]
    }
  ],
  "redFlags": [
    "Severe neurological deficits including ataxia and spasticity",
    "Marked anemia with hemodynamic instability",
    "Development of gastric neoplasia (carcinoid or adenocarcinoma)"
  ],
