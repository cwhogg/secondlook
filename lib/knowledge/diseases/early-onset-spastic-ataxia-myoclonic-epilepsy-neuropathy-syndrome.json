  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Early-onset Spastic Ataxia-Myoclonic Epilepsy-Neuropathy Syndrome",
    "criteria": [
      {
        "id": "spastic-ataxia",
