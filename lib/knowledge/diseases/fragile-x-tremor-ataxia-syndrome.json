  "keyFindings": {
    "laboratory": [
      "Detection of FMR1 premutation via PCR and Southern blot",
      "Elevated FMR1 mRNA levels in blood"
    ],
    "imaging": [
      "MRI showing T2 hyperintensity in middle cerebellar peduncles (MCP sign)",
      "Cerebral and cerebellar atrophy"
    ],
    "genetic": [
      "FMR1 gene premutation with 55-200 CGG trinucleotide repeats"
    ],
    "other": [
      "Neuropsychological testing showing executive dysfunction",
      "Electromyography indicating peripheral neuropathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "multiple-system-atrophy",
      "distinguishingFeatures": [
        "Absence of FMR1 premutation",
        "More rapid progression",
        "Prominent autonomic failure"
      ]
    },
    {
      "diseaseId": "essential-tremor",
      "distinguishingFeatures": [
        "No ataxia or cognitive decline",
        "No FMR1 premutation",
        "Tremor primarily postural and kinetic"
      ]
    },
    {
      "diseaseId": "spinocerebellar-ataxia",
      "distinguishingFeatures": [
        "Family history with autosomal dominant inheritance",
        "Genetic testing negative for FMR1 premutation",
        "Variable age of onset"
      ]
    }
  ],
  "redFlags": [
