  "differentialDiagnoses": [
    {
      "diseaseId": "pyknodysostosis",
      "distinguishingFeatures": [
        "Absent acro-osteolysis",
        "Characteristic osteosclerosis",
        "Short stature with delayed closure of cranial sutures"
      ]
    },
    {
      "diseaseId": "leriche-syndrome",
      "distinguishingFeatures": [
        "Peripheral arterial disease symptoms",
        "Absent craniofacial abnormalities",
        "No acro-osteolysis"
      ]
    },
    {
      "diseaseId": "multicentric-carpal-metacarpal-osteolysis",
      "distinguishingFeatures": [
        "Osteolysis limited to carpal and metacarpal bones",
        "No generalized osteoporosis",
        "Distinct genetic mutations"
      ]
    }
  ],
