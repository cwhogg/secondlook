  "keyFindings": {
    "laboratory": [
      "Low serum testosterone and gonadotropin levels indicating hypogonadotropic hypogonadism",
      "Normal or mildly elevated serum prolactin"
    ],
    "imaging": [
      "Retinal pigmentary changes on fundus photography",
      "Optical coherence tomography showing photoreceptor layer loss",
      "Brain MRI may show nonspecific mild cerebral atrophy"
    ],
    "genetic": [
      "Mutations in genes associated with syndromic retinitis pigmentosa (e.g., RPGR, USH2A) or novel loci",
      "Autosomal recessive inheritance pattern"
    ],
    "other": [
      "Audiometric confirmation of bilateral sensorineural hearing loss",
      "Delayed bone age on radiographs consistent with hypogonadism"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "usher-syndrome",
      "distinguishingFeatures": [
        "Usher syndrome typically lacks hypogonadism",
        "More prominent vestibular dysfunction",
        "Different genetic mutations (e.g., USH1, USH2 genes)"
      ]
    },
    {
      "diseaseId": "bardet-biedl-syndrome",
      "distinguishingFeatures": [
        "Presence of polydactyly and obesity",
        "Renal anomalies more frequent and severe",
        "Hypogonadism present but intellectual disability less consistent"
      ]
    }
  ],
  "redFlags": [
