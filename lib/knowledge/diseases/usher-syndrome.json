  "keyFindings": {
    "laboratory": [
      "Audiometry showing bilateral sensorineural hearing loss",
      "Electroretinography (ERG) demonstrating reduced rod and cone function"
    ],
    "imaging": [
      "Optical coherence tomography (OCT) showing retinal degeneration",
      "Brain MRI may show vestibular nerve hypoplasia in some cases"
    ],
    "genetic": [
      "Pathogenic variants in MYO7A, USH2A, CDH23, PCDH15, and other Usher-related genes",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Vestibular function tests showing areflexia or hyporeflexia",
      "Visual field testing showing concentric constriction"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "nonsyndromic-sensorineural-hearing-loss",
      "distinguishingFeatures": [
        "Hearing loss without retinal degeneration or vestibular dysfunction",
        "No progressive vision loss"
      ]
    },
    {
      "diseaseId": "bardet-biedl-syndrome",
      "distinguishingFeatures": [
        "Presence of polydactyly, obesity, renal anomalies",
        "Retinal dystrophy but with additional systemic features"
      ]
    },
    {
      "diseaseId": "alport-syndrome",
      "distinguishingFeatures": [
        "Sensorineural hearing loss with renal disease and hematuria",
        "No retinitis pigmentosa"
      ]
    }
  ],
  "redFlags": [
    "Early onset bilateral sensorineural hearing loss",
    "Progressive night blindness and peripheral vision loss",
    "Balance difficulties or delayed motor milestones in infancy"
  ],
