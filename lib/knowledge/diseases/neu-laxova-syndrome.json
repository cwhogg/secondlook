  "diagnosticCriteria": {
    "formalCriteriaName": "Neu-Laxova Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "severe-iugr",
        "description": "Severe intrauterine growth restriction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "microcephaly",
        "description": "Marked microcephaly with brain malformations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ichthyosis",
        "description": "Congenital ichthyosiform erythroderma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including proptosis, flat nose, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-contractures",
        "description": "Arthrogryposis multiplex congenita with limb contractures",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "central-nervous-system-malformations",
        "description": "CNS malformations such as agenesis of corpus callosum or lissencephaly",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe intrauterine growth restriction, microcephaly with brain malformations, congenital ichthyosis, and characteristic facial dysmorphism",
    "notes": "Genetic testing for mutations in PHGDH, PSAT1, or PSPH genes can confirm diagnosis."
  },
