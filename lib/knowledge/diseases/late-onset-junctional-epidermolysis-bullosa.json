  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Junctional Epidermolysis Bullosa",
    "criteria": [
      {
        "id": "clinical-blistering",
        "description": "Presence of skin blistering and erosions predominantly at sites of trauma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence-mapping",
        "description": "Immunofluorescence mapping showing reduced or absent expression of laminin-332 or other basement membrane zone proteins",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes encoding laminin-332 subunits (LAMA3, LAMB3, LAMC2)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing cleavage within the lamina lucida of the basement membrane zone",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical blistering plus either immunofluorescence mapping abnormalities or pathogenic genetic variants",
    "notes": "Late-onset forms may have milder clinical presentation and delayed blistering onset compared to classic JEB."
  },
