  "diagnosticCriteria": {
    "formalCriteriaName": "Hemodynamic Criteria for Cardiogenic Shock",
    "criteria": [
      {
        "id": "hypotension",
        "description": "Systolic blood pressure <90 mmHg for at least 30 minutes or requiring vasopressors to maintain ≥90 mmHg",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "signs-of-hypoperfusion",
        "description": "Clinical signs of end-organ hypoperfusion such as cold extremities, oliguria, altered mental status",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-filling-pressures",
        "description": "Elevated left ventricular filling pressures evidenced by pulmonary congestion or elevated pulmonary capillary wedge pressure (>15 mmHg)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "reduced-cardiac-index",
        "description": "Cardiac index <2.2 L/min/m² measured by invasive hemodynamic monitoring",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "evidence-of-myocardial-dysfunction",
        "description": "Echocardiographic evidence of severe left ventricular systolic dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypotension plus signs of hypoperfusion and evidence of elevated filling pressures or reduced cardiac output",
    "notes": "Diagnosis is clinical and supported by hemodynamic measurements and imaging."
  },
