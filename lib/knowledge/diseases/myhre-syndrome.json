  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; no specific biochemical markers",
      "Possible mild anemia or immunological abnormalities"
    ],
    "imaging": [
      "Echocardiography showing restrictive cardiomyopathy or pulmonary artery stenosis",
      "Skeletal X-rays revealing brachydactyly and thickened bones",
      "MRI brain may show nonspecific findings in intellectual disability cases"
    ],
    "genetic": [
      "SMAD4 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Skin biopsy may show dermal fibrosis resembling scleroderma",
      "Audiometry confirming sensorineural or conductive hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "loeys-dietz-syndrome",
      "distinguishingFeatures": [
        "Presence of arterial aneurysms and tortuosity",
        "Mutations in TGFBR1 or TGFBR2 genes",
        "More pronounced vascular fragility"
      ]
    },
    {
      "diseaseId": "shprintzen-goldberg-syndrome",
      "distinguishingFeatures": [
        "Craniosynostosis and marfanoid habitus",
        "Mutations in SKI gene",
        "Distinctive intellectual disability and skeletal anomalies"
      ]
    }
  ],
  "redFlags": [
    "Progressive joint contractures leading to severe mobility impairment",
    "Development of restrictive cardiomyopathy or pulmonary artery stenosis",
    "Severe skin thickening causing functional limitations"
  ],
