  "differentialDiagnoses": [
    {
      "diseaseId": "charcot-marie-tooth-disease-type-2b",
      "distinguishingFeatures": [
        "Dominant inheritance pattern",
        "Mutations in RAB7A gene but different clinical severity and onset",
        "More prominent ulcerations and distal sensory loss"
      ]
    },
    {
      "diseaseId": "hereditary-motor-and-sensory-neuropathy-type-2",
      "distinguishingFeatures": [
        "Variable genetic causes other than RAB7A",
        "Typically autosomal dominant inheritance",
        "Less severe sensory loss compared to CMT2B1"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of weakness over weeks to months",
    "Respiratory insufficiency or difficulty breathing",
    "Severe autonomic dysfunction such as syncope or orthostatic hypotension"
  ],
