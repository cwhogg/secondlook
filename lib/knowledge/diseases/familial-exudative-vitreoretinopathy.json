        "description": "Presence of retinal detachment or exudative changes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in FEVR-associated genes (e.g., FZD4, LRP5, TSPAN12)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of peripheral retinal avascularity and abnormal retinal vessel development, with or without family history or genetic confirmation",
    "notes": "Diagnosis is primarily clinical supported by imaging and genetic testing when available."
