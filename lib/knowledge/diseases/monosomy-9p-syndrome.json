  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Monosomy 9p Syndrome",
    "criteria": [
      {
        "id": "chromosomal-deletion",
        "description": "Presence of terminal or interstitial deletion involving the short arm of chromosome 9 (9p) confirmed by cytogenetic or molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including trigonocephaly, flat nasal bridge, and upward slanting palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital heart defects such as atrial or ventricular septal defects",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia and feeding difficulties",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed 9p deletion by genetic testing plus presence of characteristic craniofacial features and developmental delay",
    "notes": "Diagnosis relies heavily on genetic confirmation; clinical features support but are variable."
  },
