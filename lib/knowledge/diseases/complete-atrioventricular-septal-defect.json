  "keyFindings": {
    "laboratory": [
      "Elevated brain natriuretic peptide (BNP) in heart failure",
      "Polycythemia secondary to chronic hypoxia (in some cases)"
    ],
    "imaging": [
      "Echocardiography showing common AV valve, atrial and ventricular septal defects",
      "Chest X-ray showing cardiomegaly and increased pulmonary vascular markings",
      "Cardiac MRI for detailed anatomical assessment (optional)"
    ],
    "genetic": [
      "Association with trisomy 21 (Down syndrome)",
      "No single gene mutation identified; multifactorial etiology"
    ],
    "other": [
      "Electrocardiogram may show left axis deviation and atrioventricular conduction abnormalities"
    ]
  },
