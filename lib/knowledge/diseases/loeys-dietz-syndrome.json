  "keyFindings": {
    "laboratory": [
      "No specific laboratory biomarkers",
      "Elevated IgE or eosinophilia in some subtypes"
    ],
    "imaging": [
      "Echocardiography: aortic root measurement (Z-score)",
      "CT or MR angiography from head to pelvis for full arterial assessment",
      "Arterial tortuosity visible on angiographic imaging",
      "Cervical spine imaging for instability"
    ],
    "genetic": [
      "TGFB2 (causative)",
      "TGFB3 (causative)",
      "SMAD2 (causative)",
      "SMAD3 (causative)",
      "IPO8 (causative, loss-of-function)",
      "TGFBR1 (causative)",
      "TGFBR2 (causative)",
      "Autosomal dominant inheritance; variable expressivity",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Annual head-to-pelvis vascular imaging recommended",
      "Surgical thresholds may be lower than Marfan (aortic root >= 4.0-4.2 cm in adults)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "marfan-syndrome",
      "distinguishingFeatures": [
        "Marfan has ectopia lentis (absent in LDS)",
        "Marfan lacks bifid uvula and hypertelorism",
        "Marfan has FBN1 mutations",
        "Marfan usually dissects at larger aortic diameters"
      ]
    },
