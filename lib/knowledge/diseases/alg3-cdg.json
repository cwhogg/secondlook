  "diagnosticCriteria": {
    "formalCriteriaName": "ALG3-CDG Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypotonia",
        "description": "Congenital hypotonia presenting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Characteristic facial dysmorphism including micrognathia, broad nasal bridge, and low-set ears",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "abnormal-glycosylation",
        "description": "Abnormal serum transferrin glycosylation pattern detected by isoelectric focusing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pathogenic-alg3-variants",
        "description": "Biallelic pathogenic variants in the ALG3 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-involvement",
        "description": "Developmental delay and seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features (hypotonia and dysmorphic features), abnormal transferrin glycosylation, and confirmation of biallelic pathogenic ALG3 variants",
    "notes": "Diagnosis is confirmed by molecular genetic testing; biochemical screening is supportive."
  },
