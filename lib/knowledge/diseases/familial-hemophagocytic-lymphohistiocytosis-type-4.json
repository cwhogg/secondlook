  "keyFindings": {
    "laboratory": [
      "Elevated ferritin (>500 ng/mL, often >10,000 ng/mL)",
      "Cytopenias affecting ≥2 lineages",
      "Hypertriglyceridemia and/or hypofibrinogenemia",
      "Elevated liver transaminases",
      "Low or absent NK cell activity"
    ],
    "imaging": [
      "Hepatosplenomegaly on abdominal ultrasound or CT",
      "Lymphadenopathy on imaging",
      "Brain MRI showing demyelination or cerebral edema in advanced cases"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Hemophagocytosis observed in bone marrow, spleen, or lymph node biopsy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "familial-hemophagocytic-lymphohistiocytosis-type-2",
      "distinguishingFeatures": [
        "Mutations in PRF1 gene",
        "Earlier onset in some cases",
        "Similar clinical presentation but different genetic etiology"
      ]
    },
    {
      "diseaseId": "secondary-hemophagocytic-lymphohistiocytosis",
      "distinguishingFeatures": [
        "Triggered by infections, malignancies, or autoimmune diseases",
        "No underlying genetic mutation",
        "Often older age at onset"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive cytopenias",
    "Unremitting high fever despite antibiotics",
    "Neurological deterioration with seizures or altered consciousness"
  ],
