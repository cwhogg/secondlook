  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus criteria for Posterior Cortical Atrophy",
    "criteria": [
      {
        "id": "visual-dysfunction",
        "description": "Progressive visuospatial and visuoperceptual deficits disproportionate to memory impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging-posterior-atrophy",
        "description": "Neuroimaging evidence of predominant atrophy or hypometabolism in posterior cortical regions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-early-memory-loss",
        "description": "Relative preservation of episodic memory in early stages",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of cortical visual impairment such as stroke or tumor",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of progressive visuospatial deficits with neuroimaging evidence of posterior cortical atrophy and exclusion of other causes",
    "notes": "Diagnosis is clinical supported by imaging and neuropsychological testing; biomarkers for Alzheimer's disease pathology may support diagnosis."
  },
