  "diagnosticCriteria": {
    "formalCriteriaName": "2010 Revised Task Force Criteria for ARVC",
    "criteria": [
      {
        "id": "global-right-ventricular-dysfunction",
        "description": "Regional right ventricular akinesia, dyskinesia or aneurysm with global RV dilatation or reduced ejection fraction on imaging",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "tissue-characterization",
        "description": "Fibrofatty replacement of myocardium on endomyocardial biopsy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ecg-repolarization-abnormalities",
        "description": "Inverted T waves in right precordial leads (V1-V3) in individuals >14 years old without right bundle branch block",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ventricular-arrhythmias",
        "description": "Sustained or nonsustained ventricular tachycardia of left bundle branch block morphology",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Confirmed pathogenic mutation in ARVC-related gene or family history of ARVC",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Diagnosis requires 2 major criteria or 1 major plus 2 minor criteria or 4 minor criteria from different categories",
    "notes": "Diagnosis is based on a combination of structural, histological, electrocardiographic, arrhythmic, and genetic factors."
  },
