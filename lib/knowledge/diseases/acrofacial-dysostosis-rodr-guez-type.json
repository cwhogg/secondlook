  "diagnosticCriteria": {
    "formalCriteriaName": "Rodríguez Type Acrofacial Dysostosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-malformations",
        "description": "Presence of characteristic craniofacial anomalies including micrognathia, malar hypoplasia, and downslanting palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-malformations",
        "description": "Bilateral limb abnormalities such as hypoplasia or aplasia of the thumbs and radial anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ear-anomalies",
        "description": "External ear malformations including microtia or anotia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Pre- and postnatal growth retardation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria: characteristic craniofacial malformations and bilateral limb abnormalities",
    "notes": "Genetic testing may support diagnosis but is not always definitive."
  },
