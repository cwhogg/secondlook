  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for PUPPP",
    "criteria": [
      {
        "id": "onset-third-trimester",
        "description": "Onset of pruritic rash in the third trimester of pregnancy or immediate postpartum period",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lesion-characteristics",
        "description": "Presence of urticarial papules and plaques beginning within striae distensae",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-systemic-involvement",
        "description": "No systemic symptoms or fetal compromise",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology-supportive",
        "description": "Skin biopsy showing superficial perivascular infiltrate with eosinophils",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pruritic urticarial papules and plaques in the third trimester with typical lesion distribution and absence of systemic involvement",
    "notes": "Diagnosis is primarily clinical; biopsy is rarely required and used to exclude other dermatoses."
  },
