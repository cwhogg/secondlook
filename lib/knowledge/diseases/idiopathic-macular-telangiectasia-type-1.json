        "requiredForDiagnosis": true
      },
      {
        "id": "fluorescein-leakage",
        "description": "Fluorescein angiography showing early hyperfluorescence and late leakage from telangiectatic vessels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-secondary-cause",
        "description": "Exclusion of secondary causes such as diabetic retinopathy or retinal vein occlusion",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of telangiectatic retinal vessels with macular edema and characteristic fluorescein angiography findings, excluding secondary causes",
    "notes": "Diagnosis is primarily clinical supported by imaging modalities such as OCT and fluorescein angiography."
