  "diagnosticCriteria": {
    "formalCriteriaName": "Histidinuria-Renal Tubular Defect Diagnostic Criteria",
    "criteria": [
      {
        "id": "histidinuria",
        "description": "Persistent elevated urinary excretion of histidine (histidinuria)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-tubular-dysfunction",
        "description": "Evidence of proximal renal tubular dysfunction including aminoaciduria and glycosuria",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-serum-histidine",
        "description": "Normal or mildly elevated serum histidine levels despite urinary losses",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-metabolic-disorders",
        "description": "Exclusion of other causes of aminoaciduria and renal tubular defects",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of persistent histidinuria with documented proximal renal tubular dysfunction and exclusion of other metabolic disorders",
    "notes": "Diagnosis requires biochemical confirmation and renal function assessment; genetic testing may support diagnosis if available"
  },
