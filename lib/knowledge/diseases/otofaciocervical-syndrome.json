  "diagnosticCriteria": {
    "formalCriteriaName": "Otofaciocervical Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphism including long face, prominent nose, and downslanting palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "branchial-anomalies",
        "description": "Presence of branchial cleft cysts or fistulas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-loss",
        "description": "Congenital sensorineural hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clavicular-hypoplasia",
        "description": "Hypoplasia or aplasia of the clavicles",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "cervical-spine-anomalies",
        "description": "Cervical vertebral anomalies including fusion or hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: characteristic facial dysmorphism, branchial anomalies, and congenital sensorineural hearing loss",
    "notes": "Genetic testing for mutations in the PAX1 gene may support diagnosis"
  },
