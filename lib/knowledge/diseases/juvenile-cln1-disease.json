    "formalCriteriaName": "Juvenile Neuronal Ceroid Lipofuscinosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive cognitive decline and motor deterioration beginning in mid-childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-deficiency",
        "description": "Reduced palmitoyl-protein thioesterase 1 (PPT1) enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the CLN1 (PPT1) gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electron-microscopy",
        "description": "Presence of granular osmiophilic deposits in skin or conjunctival biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing cerebral and cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive neurodegenerative clinical presentation plus either enzyme deficiency or biallelic pathogenic CLN1 variants",
    "notes": "Diagnosis is confirmed by genetic testing and enzyme assay; biopsy findings and imaging support diagnosis."
  },
