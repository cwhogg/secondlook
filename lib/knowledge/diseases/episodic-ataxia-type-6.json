  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Episodic Ataxia Type 6",
    "criteria": [
      {
        "id": "episodic-ataxia",
        "description": "Recurrent episodes of cerebellar ataxia lasting minutes to hours",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the FGF14 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "interictal-nystagmus",
        "description": "Presence of interictal gaze-evoked nystagmus or other cerebellar signs",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-other-causes",
        "description": "Exclusion of other causes of episodic ataxia and cerebellar dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Recurrent episodic ataxia plus pathogenic FGF14 variant identified by genetic testing",
    "notes": "Diagnosis relies heavily on genetic confirmation due to overlapping clinical features with other episodic ataxias."
  },
