  "diagnosticCriteria": {
    "formalCriteriaName": "International League Against Epilepsy (ILAE) Criteria for Myoclonic-Atonic Epilepsy",
    "criteria": [
      {
        "id": "clinical-seizure-type",
        "description": "Presence of myoclonic-atonic seizures characterized by sudden muscle jerks followed by loss of muscle tone",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-of-onset",
        "description": "Onset of seizures typically between 1 and 6 years of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroencephalogram-findings",
        "description": "EEG showing generalized spike-and-wave or polyspike-and-wave discharges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-development-prior",
        "description": "Normal psychomotor development prior to seizure onset",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-of-other-epilepsies",
        "description": "Exclusion of other epilepsy syndromes by clinical and EEG features",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of myoclonic-atonic seizures with typical age of onset and characteristic EEG findings",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
