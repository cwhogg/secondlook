  "keyFindings": {
    "laboratory": [
      "Elevated fasting insulin and glucose levels indicating insulin resistance",
      "Dyslipidemia with elevated triglycerides and low HDL cholesterol"
    ],
    "imaging": [
      "Radiographic evidence of acro-osteolysis of distal phalanges",
      "Delayed cranial suture closure on skull X-rays",
      "Hepatic steatosis on abdominal ultrasound or MRI"
    ],
    "genetic": [
      "ZMPSTE24 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Clinical observation of generalized lipodystrophy and mandibular hypoplasia"
    ]
