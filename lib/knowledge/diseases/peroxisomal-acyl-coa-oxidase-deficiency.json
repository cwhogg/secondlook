  "diagnosticCriteria": {
    "formalCriteriaName": "Peroxisomal Acyl-CoA Oxidase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Markedly reduced or absent acyl-CoA oxidase enzyme activity in fibroblasts or liver tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-profile",
        "description": "Elevated very long chain fatty acids (VLCFAs) and branched-chain fatty acids in plasma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the ACOX1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of progressive hypotonia and developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced acyl-CoA oxidase activity plus elevated VLCFAs and/or pathogenic ACOX1 variants",
    "notes": "Diagnosis often requires integration of biochemical, enzymatic, and genetic data."
  },
