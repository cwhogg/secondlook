  "diagnosticCriteria": {
    "formalCriteriaName": "Pierpont Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including full cheeks, broad nasal bridge, and prominent philtrum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distal-limb-anomalies",
        "description": "Broad distal phalanges of fingers and toes with thickened soft tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "feeding-difficulties",
        "description": "Neonatal feeding difficulties and failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Generalized hypotonia in infancy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: characteristic facial dysmorphism, developmental delay, and distal limb anomalies",
    "notes": "Genetic testing for TBL1XR1 mutations can support diagnosis but is not mandatory"
  },
