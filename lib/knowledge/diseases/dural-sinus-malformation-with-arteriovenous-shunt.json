  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; coagulation profile may be assessed to exclude thrombophilia"
    ],
    "imaging": [
      "MRI/MRA showing dilated dural venous sinus with arteriovenous shunting",
      "Digital subtraction angiography (DSA) confirming arteriovenous fistula",
      "CT scan may show hydrocephalus or hemorrhage"
    ],
    "genetic": [
      "No known specific genetic mutations identified; sporadic occurrence"
    ],
    "other": [
      "Echocardiography may reveal high-output cardiac failure in severe cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "vein-of-galen-malformation",
      "distinguishingFeatures": [
        "Midline arteriovenous malformation involving median prosencephalic vein",
        "Typically presents in neonates with high-output cardiac failure",
        "Different anatomical location and venous drainage pattern"
      ]
    },
    {
      "diseaseId": "cerebral-arteriovenous-malformation",
      "distinguishingFeatures": [
        "Parenchymal nidus of abnormal vessels rather than dural sinus involvement",
        "Usually presents with hemorrhage or seizures in older children or adults",
        "Absence of dural sinus dilation"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive hydrocephalus",
    "Signs of increased intracranial pressure (vomiting, papilledema)",
    "New onset seizures or focal neurological deficits"
  ],
