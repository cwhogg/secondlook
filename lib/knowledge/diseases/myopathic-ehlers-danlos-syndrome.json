  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed diagnostic criteria for Myopathic Ehlers-Danlos Syndrome",
    "criteria": [
      {
        "id": "muscle-weakness",
        "description": "Congenital or early-onset proximal muscle weakness with hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-hyperextensibility",
        "description": "Marked skin hyperextensibility with soft, velvety skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-hypermobility",
        "description": "Generalized joint hypermobility with recurrent dislocations or subluxations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing type 1 fiber predominance and mild myopathic changes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (muscle weakness, skin hyperextensibility, and joint hypermobility) with supportive findings",
    "notes": "Genetic testing may identify mutations in COL12A1 or related genes but is not always diagnostic."
  },
