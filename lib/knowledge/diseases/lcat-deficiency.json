  "diagnosticCriteria": {
    "formalCriteriaName": "LCAT Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "low-lcat-activity",
        "description": "Markedly reduced or absent plasma LCAT enzyme activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypoalphalipoproteinemia",
        "description": "Severe reduction in HDL cholesterol levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "corneal-opacification",
        "description": "Bilateral corneal clouding or opacification (fish eye appearance)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-dysfunction",
        "description": "Proteinuria and progressive renal insufficiency",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the LCAT gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of markedly reduced LCAT enzyme activity plus at least two major clinical features (hypoalphalipoproteinemia and corneal opacification) or confirmed pathogenic LCAT gene mutation.",
    "notes": "Diagnosis is supported by biochemical assays and genetic testing; renal biopsy may show characteristic lipid deposits."
  },
