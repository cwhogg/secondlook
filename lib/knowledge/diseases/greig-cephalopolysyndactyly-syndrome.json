  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Greig Cephalopolysyndactyly Syndrome",
    "criteria": [
      {
        "id": "macrocephaly",
        "description": "Presence of macrocephaly (enlarged head circumference)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "preaxial-polydactyly",
        "description": "Preaxial polydactyly of hands or feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "syndactyly",
        "description": "Cutaneous or osseous syndactyly (fusion of digits)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "GLI3-mutation",
        "description": "Identification of pathogenic GLI3 gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of macrocephaly plus either preaxial polydactyly or syndactyly, or identification of a pathogenic GLI3 mutation",
    "notes": "Genetic testing for GLI3 mutations can confirm diagnosis but is not always necessary if clinical criteria are met."
  },
