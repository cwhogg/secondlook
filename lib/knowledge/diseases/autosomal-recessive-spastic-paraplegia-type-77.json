  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of metabolic causes of spastic paraplegia"
    ],
    "imaging": [
      "Brain MRI typically normal or nonspecific white matter changes",
      "Spinal cord MRI usually unremarkable"
    ],
    "genetic": [
      "FARS2 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography (EMG) may show mild distal axonal neuropathy",
      "Nerve conduction studies typically normal or mildly reduced sensory nerve action potentials"
    ]
  },
