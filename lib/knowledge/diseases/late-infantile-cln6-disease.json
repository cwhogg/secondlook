    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive psychomotor regression with onset between 2 and 6 years of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in the CLN6 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "storage-material",
        "description": "Detection of characteristic autofluorescent ceroid lipopigment accumulation in peripheral tissues or skin biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuroimaging",
        "description": "Brain MRI showing cerebral and cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive psychomotor regression with onset in late infancy and confirmation of biallelic pathogenic CLN6 variants",
    "notes": "Skin biopsy and neuroimaging findings support diagnosis but are not mandatory if genetic testing is conclusive."
  },
