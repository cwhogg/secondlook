  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild hypothyroidism on thyroid function tests"
    ],
    "imaging": [
      "Ocular ultrasound confirming cataracts",
      "Brain MRI usually normal",
      "Echocardiogram may reveal minor septal defects"
    ],
    "genetic": [
      "No specific gene identified; suspected autosomal recessive inheritance"
    ],
    "other": [
      "Audiometry confirming sensorineural hearing loss",
      "Growth charts showing postnatal growth retardation"
    ]
  },
