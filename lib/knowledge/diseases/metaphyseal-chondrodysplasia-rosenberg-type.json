  "diagnosticCriteria": {
    "formalCriteriaName": "Rosenberg Type Metaphyseal Chondrodysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "metaphyseal-abnormalities",
        "description": "Radiographic evidence of metaphyseal irregularities and cupping predominantly affecting the long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "short-limbs",
        "description": "Disproportionate short stature with shortening of the limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development and intelligence",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of metaphyseal abnormalities on imaging plus disproportionate short stature",
    "notes": "Genetic testing may aid diagnosis but is not always conclusive."
  },
