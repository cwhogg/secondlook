  "keyFindings": {
    "laboratory": [
      "Elevated fasting glucose and insulin levels indicating insulin resistance",
      "Dyslipidemia with elevated LDL cholesterol",
      "Mild anemia in some cases"
    ],
    "imaging": [
      "Premature atherosclerotic changes on vascular imaging",
      "Osteopenia or osteoporosis on bone densitometry",
      "Soft tissue calcifications on X-ray"
    ],
    "genetic": [
      "LMNA (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Skin biopsy showing dermal fibrosis and loss of elastic fibers",
      "Electromyography showing peripheral neuropathy in some patients"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "classical-werner-syndrome",
      "distinguishingFeatures": [
        "WRN gene mutations instead of LMNA/POLD1",
        "Onset typically in third to fourth decade",
        "More prominent cataracts and skin ulcers"
      ]
    },
    {
      "diseaseId": "hutchinson-gilford-progeria-syndrome",
      "distinguishingFeatures": [
        "Early childhood onset",
        "LMNA mutations but distinct clinical phenotype",
        "Severe growth retardation and characteristic facial features"
      ]
    },
    {
      "diseaseId": "mandibuloacral-dysplasia",
      "distinguishingFeatures": [
        "Mutations in LMNA or ZMPSTE24 genes",
        "Prominent skeletal abnormalities including mandibular hypoplasia",
        "Delayed onset and less severe metabolic complications"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of scleroderma-like skin changes",
    "Early onset bilateral cataracts before age 40",
    "Presence of insulin resistance with progeroid features"
  ],
