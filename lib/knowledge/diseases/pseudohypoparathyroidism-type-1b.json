  "diagnosticCriteria": {
    "formalCriteriaName": "PHP Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypocalcemia",
        "description": "Hypocalcemia with elevated serum parathyroid hormone (PTH) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-pth-resistance",
        "description": "Evidence of renal resistance to PTH (e.g., elevated phosphate, low calcium despite high PTH)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gsa-methylation-defect",
        "description": "Methylation abnormalities at the GNAS locus without Albright hereditary osteodystrophy (AHO) phenotype",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-ahophenotype",
        "description": "Lack of Albright hereditary osteodystrophy features (e.g., brachydactyly, short stature)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-gsa-coding-sequence",
        "description": "No coding mutations in GNAS gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypocalcemia with elevated PTH and evidence of renal PTH resistance combined with methylation defects at the GNAS locus without AHO phenotype",
    "notes": "Diagnosis is confirmed by molecular testing showing epigenetic defects at the GNAS locus; absence of AHO phenotype distinguishes type 1B from other PHP subtypes."
  },
