  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for COFS syndrome",
    "criteria": [
      {
        "id": "neurological-deterioration",
        "description": "Progressive neurodegeneration with severe developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-anomalies",
        "description": "Congenital cataracts and microphthalmia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including micrognathia and prominent nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Arthrogryposis multiplex congenita and joint contractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Intrauterine growth retardation and postnatal failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "brain-imaging-abnormalities",
        "description": "Cerebral atrophy and hypomyelination on MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive neurodegeneration, congenital ocular anomalies, characteristic facial dysmorphism, and skeletal abnormalities",
    "notes": "Genetic testing confirming mutations in ERCC6 or related genes supports diagnosis"
  },
