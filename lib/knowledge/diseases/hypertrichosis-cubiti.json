  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Hypertrichosis cubiti",
    "criteria": [
      {
        "id": "localized-hypertrichosis",
        "description": "Presence of dense, long, fine vellus or terminal hair localized predominantly to the extensor surfaces of the elbows",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset",
        "description": "Onset of hypertrichosis during infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-systemic-involvement",
        "description": "No evidence of systemic disease or generalized hypertrichosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of localized hypertrichosis or autosomal dominant inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of localized hypertrichosis on the elbows with onset in early childhood, excluding systemic causes",
    "notes": "Diagnosis is primarily clinical; biopsy and genetic testing may be used to exclude other causes"
  },
