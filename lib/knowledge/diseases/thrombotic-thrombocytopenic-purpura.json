  "diagnosticCriteria": {
    "formalCriteriaName": "International Society on Thrombosis and Haemostasis (ISTH) Guidelines",
    "criteria": [
      {
        "id": "ttp-c1",
        "description": "Microangiopathic hemolytic anemia (schistocytes, elevated LDH, low haptoglobin)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ttp-c2",
        "description": "Thrombocytopenia (often severe, <30,000/µL)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ttp-c3",
        "description": "Severely deficient ADAMTS13 activity (<10%)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ttp-c4",
        "description": "ADAMTS13 inhibitor (autoantibody) detected",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ttp-c5",
        "description": "Neurological symptoms (confusion, focal deficits, seizures)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ttp-c6",
        "description": "Renal involvement (mild; elevated creatinine)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ttp-c7",
        "description": "Fever",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "MAHA plus thrombocytopenia; ADAMTS13 activity <10% confirms diagnosis. Treatment should not be delayed pending ADAMTS13 results.",
    "notes": "Classic pentad (MAHA, thrombocytopenia, neurological symptoms, renal failure, fever) is seen in minority of cases. PLASMIC score helps predict ADAMTS13 deficiency."
  },
