  "diagnosticCriteria": {
    "formalCriteriaName": "Kahn criteria for SAPHO syndrome",
    "criteria": [
      {
        "id": "osteitis",
        "description": "Chronic recurrent multifocal osteitis or hyperostosis involving anterior chest wall, spine, or long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skin-lesions",
        "description": "Presence of characteristic dermatological manifestations such as palmoplantar pustulosis or severe acne",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-infection",
        "description": "Exclusion of infectious osteomyelitis and other causes of osteitis",
        "category": "minor",
        "requiredForDiagnosis": true
      },
      {
        "id": "synovitis",
        "description": "Synovitis or arthritis involving peripheral joints",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiologic-findings",
        "description": "Characteristic radiologic findings including hyperostosis and osteitis on imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of osteitis or hyperostosis plus characteristic skin lesions with exclusion of infectious causes",
    "notes": "Diagnosis is clinical and radiological; biopsy may be required to exclude infection or malignancy."
  },
