  "diagnosticCriteria": {
    "formalCriteriaName": "Marden-Walker Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "multiple-joint-contractures",
        "description": "Presence of multiple congenital joint contractures (arthrogryposis multiplex congenita)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial features including blepharophimosis, micrognathia, and mask-like facies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay and intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-difficulties",
        "description": "Respiratory complications including apnea and feeding difficulties",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: multiple congenital joint contractures, distinctive facial features, and developmental delay",
    "notes": "Genetic testing may support diagnosis but is not always definitive due to genetic heterogeneity."
  },
