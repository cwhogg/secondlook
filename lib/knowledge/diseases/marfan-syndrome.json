  "keyFindings": {
    "laboratory": [
      "No specific laboratory biomarkers",
      "TGF-beta levels may be elevated (research setting)"
    ],
    "imaging": [
      "Echocardiography: aortic root measurement at sinuses of Valsalva with Z-score calculation",
      "CT/MR angiography for comprehensive aortic assessment",
      "Slit-lamp examination for ectopia lentis",
      "MRI lumbosacral spine for dural ectasia",
      "Skeletal radiographs for protrusio acetabuli assessment"
    ],
    "genetic": [
      "FBN1 (fibrillin-1) mutations: identified in >95% of cases meeting revised Ghent criteria",
      "Over 3,000 FBN1 variants reported",
      "Autosomal dominant; ~25% de novo mutations",
      "TGFBR1/TGFBR2 testing to exclude Loeys-Dietz syndrome"
    ],
    "other": [
      "Revised Ghent systemic score calculation",
      "Beighton hypermobility assessment",
      "Annual ophthalmologic examination",
      "Annual echocardiography for aortic monitoring"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "loeys-dietz-syndrome",
      "distinguishingFeatures": [
        "LDS has widespread arterial tortuosity and aneurysms",
        "LDS may feature bifid uvula/cleft palate and hypertelorism",
        "LDS lacks ectopia lentis",
        "LDS caused by TGFBR1/TGFBR2/SMAD3/TGFB2/TGFB3"
      ]
    },
    {
      "diseaseId": "ehlers-danlos-vascular",
      "distinguishingFeatures": [
        "vEDS has thin translucent skin",
        "vEDS involves medium-sized arterial rupture",
        "vEDS lacks tall stature and ectopia lentis",
        "vEDS caused by COL3A1"
      ]
    },
    {
      "diseaseId": "ehlers-danlos-hypermobile",
      "distinguishingFeatures": [
        "hEDS lacks aortic root dilation and ectopia lentis",
        "hEDS more pain-predominant",
        "hEDS does not feature marfanoid habitus"
      ]
    },
    {
      "diseaseId": "stickler-syndrome",
      "distinguishingFeatures": [
        "Stickler has vitreoretinal degeneration and retinal detachment",
        "Stickler features midface hypoplasia and hearing loss",
        "Stickler caused by COL2A1, COL11A1, COL11A2"
      ]
    }
  ],
  "redFlags": [
    "Acute severe chest or back pain (suspect aortic dissection - emergency)",
    "Sudden vision loss (retinal detachment or lens dislocation)",
    "Rapid aortic root growth > 5mm/year",
    "Aortic root diameter approaching 5 cm (surgical threshold)",
    "Family history of aortic dissection or sudden cardiac death"
  ],
