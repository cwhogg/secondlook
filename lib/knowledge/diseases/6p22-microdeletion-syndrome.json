  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible mild immunological abnormalities",
      "Metabolic screening usually normal"
    ],
    "imaging": [
      "Echocardiography revealing septal defects or other congenital heart anomalies",
      "Brain MRI may show nonspecific white matter changes or delayed myelination"
    ],
    "genetic": [
      "Heterozygous microdeletion involving 6p22 region detected by chromosomal microarray analysis or FISH",
      "Deletion size varies, typically encompassing multiple genes"
    ],
    "other": [
      "Developmental assessments confirming intellectual disability",
      "Audiological evaluation may reveal sensorineural or conductive hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "wolf-hirschhorn-syndrome",
      "distinguishingFeatures": [
        "Deletion on chromosome 4p16.3",
        "More severe growth retardation and seizures",
        "Distinctive 'Greek warrior helmet' facial appearance"
      ]
    },
    {
      "diseaseId": "cri-du-chat-syndrome",
      "distinguishingFeatures": [
        "Deletion on chromosome 5p",
        "Characteristic high-pitched cat-like cry in infancy",
        "Microcephaly and severe intellectual disability"
      ]
    },
    {
      "diseaseId": "22q11-deletion-syndrome",
      "distinguishingFeatures": [
        "Deletion on chromosome 22q11.2",
        "Characteristic cardiac defects and palatal abnormalities",
        "Immunodeficiency and hypocalcemia common"
      ]
    }
  ],
