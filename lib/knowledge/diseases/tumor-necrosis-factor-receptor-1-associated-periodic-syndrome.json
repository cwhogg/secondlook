  "keyFindings": {
    "laboratory": [
      "Elevated C-reactive protein (CRP) and erythrocyte sedimentation rate (ESR) during attacks",
      "Leukocytosis with neutrophilia during febrile episodes",
      "Elevated serum amyloid A (SAA) protein"
    ],
    "imaging": [
      "Echocardiography may reveal pericardial effusion",
      "MRI may show muscle edema during attacks"
    ],
    "genetic": [
      "TNFRSF1A (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Skin biopsy during rash may show perivascular inflammatory infiltrate",
      "Amyloid deposits in renal biopsy in advanced cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "familial-mediterranean-fever",
      "distinguishingFeatures": [
        "Shorter febrile episodes (1-3 days)",
        "MEFV gene mutations",
        "Serositis more prominent than migratory myalgia"
      ]
    },
    {
      "diseaseId": "hyperimmunoglobulinemia-d-syndrome",
      "distinguishingFeatures": [
        "Elevated IgD levels",
        "Shorter fever episodes",
        "Different genetic mutations (MVK gene)"
      ]
    },
    {
      "diseaseId": "cryopyrin-associated-periodic-syndrome",
      "distinguishingFeatures": [
        "Urticarial rash rather than migratory rash",
        "NLRP3 gene mutations",
        "Neurological involvement more common"
      ]
    }
  ],
  "redFlags": [
    "Development of amyloidosis with renal failure",
    "Persistent high-grade fever with systemic inflammation",
    "Recurrent pericarditis or pleuritis causing chest pain"
