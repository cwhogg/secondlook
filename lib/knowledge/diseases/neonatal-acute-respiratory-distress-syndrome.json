  "keyFindings": {
    "laboratory": [
      "Arterial blood gas showing hypoxemia and respiratory acidosis",
      "Elevated inflammatory markers (e.g., CRP) if secondary infection present"
    ],
    "imaging": [
      "Chest X-ray with bilateral diffuse alveolar infiltrates",
      "Possible ground-glass opacities on lung ultrasound or CT"
    ],
    "genetic": [
      "SFTPB (causative, loss-of-function)",
      "ABCA3 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Exclusion of congenital heart disease by echocardiography",
      "Assessment of oxygenation index for severity grading"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "neonatal-respiratory-distress-syndrome",
      "distinguishingFeatures": [
        "Occurs primarily in preterm infants due to surfactant deficiency",
        "Radiographic findings show ground-glass appearance with air bronchograms",
        "Improvement with surfactant therapy"
      ]
    },
    {
      "diseaseId": "meconium-aspiration-syndrome",
      "distinguishingFeatures": [
        "History of meconium-stained amniotic fluid",
        "Patchy infiltrates with hyperinflation on chest X-ray",
        "Often presents with airway obstruction and air trapping"
      ]
    }
  ],
