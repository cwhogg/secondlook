  "diagnosticCriteria": {
    "formalCriteriaName": "TRMA Diagnostic Criteria",
    "criteria": [
      {
        "id": "megaloblastic-anemia",
        "description": "Presence of megaloblastic anemia responsive to thiamine supplementation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "diabetes-mellitus",
        "description": "Early-onset diabetes mellitus not explained by autoimmune causes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-deafness",
        "description": "Bilateral sensorineural hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "SLC19A2-mutation",
        "description": "Identification of biallelic pathogenic variants in SLC19A2 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-thiamine",
        "description": "Improvement of hematological and diabetic symptoms upon thiamine therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical features (megaloblastic anemia, diabetes mellitus, sensorineural deafness) with supportive genetic or therapeutic response evidence",
    "notes": "Genetic testing for SLC19A2 mutations is confirmatory; early diagnosis improves prognosis with thiamine therapy."
  },
