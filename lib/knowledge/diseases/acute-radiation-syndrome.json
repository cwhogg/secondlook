  "diagnosticCriteria": {
    "formalCriteriaName": "CDC Acute Radiation Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "exposure-history",
        "description": "Documented or suspected exposure to a significant dose of ionizing radiation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "prodromal-symptoms",
        "description": "Presence of prodromal symptoms such as nausea, vomiting, and diarrhea within hours to days after exposure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hematopoietic-syndrome",
        "description": "Evidence of bone marrow suppression including leukopenia, thrombocytopenia, or anemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "latency-phase",
        "description": "Latent period following initial symptoms before onset of manifest illness",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "dose-estimation",
        "description": "Estimated radiation dose exceeding 1 Gy based on clinical or laboratory data",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Documented radiation exposure plus presence of prodromal symptoms and hematopoietic abnormalities",
    "notes": "Diagnosis is clinical and supported by laboratory and exposure history; bone marrow biopsy may aid in severity assessment."
  },
