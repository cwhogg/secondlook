  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and biochemical diagnostic criteria for generalized PHA1",
    "criteria": [
      {
        "id": "hyponatremia",
        "description": "Persistent hyponatremia despite adequate sodium intake",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyperkalemia",
        "description": "Elevated serum potassium levels refractory to treatment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-aldosterone-renin",
        "description": "Markedly elevated plasma renin activity and aldosterone levels indicating mineralocorticoid resistance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in genes encoding epithelial sodium channel subunits (SCNN1A, SCNN1B, SCNN1G)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-presentation",
        "description": "Neonatal salt-wasting crisis with dehydration and failure to thrive",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of neonatal salt-wasting crisis with hyponatremia, hyperkalemia, elevated aldosterone and renin levels, and exclusion of other causes of mineralocorticoid deficiency or resistance",
    "notes": "Genetic testing is confirmatory but not mandatory for diagnosis."
  },
