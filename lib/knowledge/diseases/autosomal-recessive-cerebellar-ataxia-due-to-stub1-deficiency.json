  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for STUB1-Related ARCA",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the STUB1 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-ataxias",
        "description": "Exclusion of other known causes of cerebellar ataxia including acquired and metabolic etiologies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-neuroimaging",
        "description": "MRI evidence of cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "supportive-neuropathy",
        "description": "Presence of peripheral neuropathy on electrophysiological studies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia plus biallelic pathogenic STUB1 variants with exclusion of other causes",
    "notes": "Genetic testing is essential for definitive diagnosis; neuroimaging and electrophysiology provide supportive evidence."
  },
