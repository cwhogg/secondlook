  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Molecular genetic testing confirming paternal uniparental disomy 14 or epigenetic alterations at 14q32"
    ],
    "imaging": [
      "Chest X-ray showing small bell-shaped thorax with characteristic coat-hanger ribs",
      "Abdominal ultrasound for associated anomalies"
    ],
    "genetic": [
      "Paternal uniparental disomy of chromosome 14 (UPD(14)pat)",
      "Epimutations or microdeletions affecting the 14q32 imprinted region",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Prenatal ultrasound may show polyhydramnios and thoracic abnormalities"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pierre-robin-sequence",
      "distinguishingFeatures": [
