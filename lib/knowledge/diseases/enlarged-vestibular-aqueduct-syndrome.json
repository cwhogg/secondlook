  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "CT or MRI showing vestibular aqueduct diameter >1.5 mm",
      "Absence of other cochlear or vestibular malformations"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Audiometric evidence of progressive sensorineural hearing loss",
      "Vestibular function testing may show hypofunction"
    ]
  },
  "differentialDiagnoses": [
