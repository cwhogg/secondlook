  "diagnosticCriteria": {
    "formalCriteriaName": "Gardner-Diamond Diagnostic Criteria",
    "criteria": [
      {
        "id": "autoerythrocyte-sensitivity-test",
        "description": "Positive intradermal injection of autologous erythrocytes causing localized painful ecchymosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-painful-ecchymoses",
        "description": "Recurrent spontaneous painful bruising without identifiable trauma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-coagulopathies",
        "description": "Exclusion of hematological disorders and coagulation abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "psychological-assessment",
        "description": "Presence of underlying psychological or psychiatric disorder",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent painful ecchymoses, positive autoerythrocyte sensitization test, and exclusion of coagulation disorders",
    "notes": "Diagnosis is clinical and requires exclusion of other causes of bruising; psychological evaluation is important for management."
  },
