  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; occasional hypothyroidism detected by thyroid function tests"
    ],
    "imaging": [
      "Brain MRI showing polymicrogyria, pachygyria, and other cortical malformations",
      "Occasional spinal imaging showing scoliosis"
    ],
    "genetic": [
      "RTTN (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Growth charts showing postnatal short stature",
      "Neurodevelopmental assessments indicating global delay"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "microcephaly-primary-autosomal-recessive",
      "distinguishingFeatures": [
        "Lack of cortical malformations on MRI",
        "Different genetic etiology without RTTN mutations"
      ]
    },
    {
      "diseaseId": "cobblestone-lissencephaly",
      "distinguishingFeatures": [
        "Distinct cobblestone cortex pattern on imaging",
        "Associated muscular dystrophy features absent in RTTN deficiency"
      ]
    }
  ],
