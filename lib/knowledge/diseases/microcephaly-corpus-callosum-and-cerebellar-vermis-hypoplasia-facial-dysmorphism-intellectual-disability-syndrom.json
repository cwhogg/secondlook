        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-vermis-hypoplasia",
        "description": "Hypoplasia of the cerebellar vermis identified on brain MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features including broad nasal bridge, epicanthal folds, and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay and intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of congenital microcephaly, corpus callosum hypoplasia, cerebellar vermis hypoplasia on imaging, and intellectual disability",
    "notes": "Diagnosis is primarily clinical supported by neuroimaging findings; genetic testing may assist but no specific gene identified yet."
