  "diagnosticCriteria": {
    "formalCriteriaName": "Juvenile Polyposis Diagnostic Criteria",
    "criteria": [
      {
        "id": "multiple-polyps",
        "description": "Presence of multiple juvenile polyps throughout the gastrointestinal tract",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset-symptoms",
        "description": "Onset of symptoms within the first two years of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of juvenile polyposis syndrome or related polyposis disorders",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Histological confirmation of juvenile (hamartomatous) polyps",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of multiple juvenile polyps with histopathological confirmation and symptom onset in infancy",
    "notes": "Genetic testing for SMAD4 or BMPR1A mutations may support diagnosis but is not mandatory"
  },
