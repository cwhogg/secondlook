  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Diagnostic Criteria for Mastocytosis",
    "criteria": [
      {
        "id": "major",
        "description": "Multifocal, dense infiltrates of mast cells (≥15 mast cells in aggregates) detected in bone marrow biopsy sections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "minor-1",
        "description": "Presence of KIT D816V mutation in bone marrow or blood",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "minor-2",
        "description": "Mast cells in bone marrow showing abnormal morphology (spindle-shaped or atypical)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "minor-3",
        "description": "Aberrant expression of CD25 and/or CD2 on mast cells in bone marrow",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "minor-4",
        "description": "Serum tryptase level persistently >20 ng/mL",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of the major criterion plus at least one minor criterion, or at least three minor criteria in the absence of the major criterion",
    "notes": "Diagnosis requires exclusion of systemic involvement outside the bone marrow."
  },
