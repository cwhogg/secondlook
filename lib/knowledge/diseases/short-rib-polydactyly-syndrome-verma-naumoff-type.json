  "diagnosticCriteria": {
    "formalCriteriaName": "Verma-Naumoff SRPS Diagnostic Criteria",
    "criteria": [
      {
        "id": "criterion-1",
        "description": "Presence of markedly shortened ribs with narrow thorax",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-2",
        "description": "Postaxial polydactyly of hands and/or feet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-3",
        "description": "Severe micromelia affecting all limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-4",
        "description": "Characteristic facial dysmorphism including hypertelorism and cleft lip/palate",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "criterion-5",
        "description": "Polycystic or dysplastic kidneys",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (short ribs with narrow thorax, postaxial polydactyly, and severe micromelia)",
    "notes": "Diagnosis is primarily clinical and supported by radiographic findings; genetic testing may assist but is not definitive."
  },
