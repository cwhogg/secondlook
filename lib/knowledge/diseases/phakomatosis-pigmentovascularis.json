  "diagnosticCriteria": {
    "formalCriteriaName": "Happle's Classification Criteria for Phakomatosis Pigmentovascularis",
    "criteria": [
      {
        "id": "nevus-flammeus",
        "description": "Presence of extensive nevus flammeus (port-wine stain) typically involving large body areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pigmentary-nevus",
        "description": "Coexistence of pigmentary nevi such as dermal melanocytosis (Mongolian spots), nevus spilus, or nevus of Ota",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "systemic-involvement",
        "description": "Presence of extracutaneous manifestations including vascular malformations or neurological abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both extensive nevus flammeus and pigmentary nevus on physical examination",
    "notes": "Classification into subtypes depends on the type of pigmentary nevus and associated systemic involvement"
  },
