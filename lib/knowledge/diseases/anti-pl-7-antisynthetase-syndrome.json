  "differentialDiagnoses": [
    {
      "diseaseId": "anti-pl-12-antisynthetase-syndrome",
      "distinguishingFeatures": [
        "Presence of anti-PL-12 antibodies instead of anti-PL-7",
        "More predominant lung involvement with less myositis"
      ]
    },
    {
      "diseaseId": "dermatomyositis",
      "distinguishingFeatures": [
        "Characteristic heliotrope rash and Gottron papules",
        "Different autoantibody profile (e.g., anti-Mi-2, anti-MDA5)"
      ]
    },
    {
      "diseaseId": "idiopathic pulmonary fibrosis",
      "distinguishingFeatures": [
        "Absence of myositis and antisynthetase antibodies",
        "Progressive lung fibrosis without systemic autoimmune features"
      ]
    }
