  "diagnosticCriteria": {
    "formalCriteriaName": "Hypomelanosis of Ito Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypopigmented-streaks",
        "description": "Presence of hypopigmented skin streaks or patches following the lines of Blaschko",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-abnormalities",
        "description": "Associated neurological abnormalities such as seizures, intellectual disability, or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "musculoskeletal-anomalies",
        "description": "Presence of musculoskeletal abnormalities including limb asymmetry or scoliosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-mosaicism",
        "description": "Evidence of chromosomal mosaicism or genetic abnormalities in skin or blood samples",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypopigmented skin lesions along Blaschko lines plus at least one neurological abnormality",
    "notes": "Diagnosis is clinical; genetic testing may support but is not always conclusive due to mosaicism."
  },
