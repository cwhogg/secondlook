  "diagnosticCriteria": {
    "formalCriteriaName": "Cantú Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypertrichosis",
        "description": "Congenital generalized hypertrichosis (excessive hair growth)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiomegaly",
        "description": "Cardiomegaly with or without pericardial effusion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Distinctive skeletal abnormalities including osteochondrodysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features such as coarse facial appearance and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in ABCC9 or KCNJ8 genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital generalized hypertrichosis, cardiomegaly, and skeletal abnormalities; genetic confirmation supports diagnosis",
    "notes": "Genetic testing for ABCC9 or KCNJ8 mutations is confirmatory but not mandatory if clinical criteria are met"
  },
