  "keyFindings": {
    "laboratory": [
      "CSF analysis typically normal or nonspecific; may show mild inflammatory changes post-encephalitis"
    ],
    "imaging": [
      "MRI may show basal ganglia lesions or atrophy consistent with prior encephalitic damage",
      "Functional imaging (DAT scan) may show reduced dopaminergic uptake"
    ],
    "genetic": [
      "No known genetic mutations specifically associated"
    ],
    "other": [
      "History of encephalitis lethargica or similar viral encephalitis",
      "Poor or variable response to levodopa therapy compared to idiopathic Parkinson's disease"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "idiopathic-parkinsons-disease",
      "distinguishingFeatures": [
        "No preceding encephalitic illness",
        "Better and more sustained response to dopaminergic therapy",
        "Typical age of onset usually later (>50 years)"
      ]
    },
    {
      "diseaseId": "multiple-system-atrophy",
      "distinguishingFeatures": [
        "Rapid progression",
        "Prominent autonomic failure",
        "Poor levodopa response",
        "Characteristic MRI findings (hot cross bun sign)"
      ]
    },
    {
      "diseaseId": "drug-induced-parkinsonism",
      "distinguishingFeatures": [
        "History of exposure to dopamine-blocking agents",
        "Symmetrical symptoms",
        "Improvement after drug withdrawal"
      ]
    }
  ],
