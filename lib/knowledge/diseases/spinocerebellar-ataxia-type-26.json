  "diagnosticCriteria": {
    "formalCriteriaName": "Spinocerebellar Ataxia Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in EEF2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-ataxias",
        "description": "Exclusion of other spinocerebellar ataxias by genetic testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia plus genetic confirmation of EEF2 mutation",
    "notes": "Diagnosis relies heavily on genetic testing due to phenotypic overlap with other SCAs."
  },
