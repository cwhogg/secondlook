  "diagnosticCriteria": {
    "formalCriteriaName": "No universally accepted formal criteria; diagnosis based on clinical features and genetic testing",
    "criteria": [
      {
        "id": "ocular-manifestations",
        "description": "Presence of characteristic ocular abnormalities including high myopia, vitreoretinal degeneration, and risk of retinal detachment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midfacial-hypoplasia",
        "description": "Midfacial underdevelopment with flat nasal bridge and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "arthropathy",
        "description": "Early-onset arthropathy with joint hypermobility and premature osteoarthritis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural or conductive hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variant in COL2A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of at least three major criteria including ocular manifestations, midfacial hypoplasia, arthropathy, and/or genetic confirmation",
    "notes": "Genetic testing for COL2A1 mutations is confirmatory; clinical variability exists"
  },
