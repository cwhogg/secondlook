  "diagnosticCriteria": {
    "formalCriteriaName": "Somatomammotropinoma Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of clinical signs of both acromegaly and hyperprolactinemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-evidence",
        "description": "Elevated serum growth hormone (GH) and prolactin levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Pituitary adenoma visible on MRI with features consistent with mixed hormone secretion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Immunohistochemical confirmation of GH and prolactin co-secreting tumor cells",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical signs of acromegaly and hyperprolactinemia plus elevated serum GH and prolactin levels with pituitary adenoma on imaging",
    "notes": "Histopathological confirmation is supportive but not mandatory for diagnosis."
  },
