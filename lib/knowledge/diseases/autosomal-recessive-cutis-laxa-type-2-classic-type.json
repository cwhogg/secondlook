      "Radiographs showing metaphyseal widening and skeletal dysplasia",
      "Echocardiography revealing congenital heart defects"
    ],
    "genetic": [
      "ATP6V1E1 (causative)",
      "ATP6V1A (causative)",
      "ATP6V0A2 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Skin biopsy demonstrating fragmented and reduced elastic fibers"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autosomal-recessive-cutis-laxa-type-1",
      "distinguishingFeatures": [
        "ATP7A mutations instead of ATP6V0A2",
        "Presence of severe neurological involvement and occipital horn formation"
      ]
    },
    {
      "diseaseId": "wrinkly-skin-syndrome",
      "distinguishingFeatures": [
        "Mutations in ATP6V0A2 but with milder skin laxity and absence of severe glycosylation defects",
        "Distinct facial features and less severe growth retardation"
      ]
    }
  ],
