  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests unless bleeding or anemia present",
      "Possible anemia if hemangiomas bleed"
    ],
    "imaging": [
      "Radiographs showing multiple enchondromas with characteristic radiolucent lesions and endosteal scalloping",
      "MRI demonstrating soft tissue hemangiomas and extent of bone lesions",
      "Bone scans may show increased uptake in affected areas"
    ],
    "genetic": [
      "Somatic mosaic mutations in IDH1 and IDH2 genes detected in affected tissues"
    ],
    "other": [
      "Histopathology confirms enchondromas and hemangiomas",
      "Malignant transformation requires biopsy confirmation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ollier-disease",
      "distinguishingFeatures": [
        "Presence of multiple enchondromas without soft tissue hemangiomas",
        "Lower risk of vascular lesions"
      ]
    },
    {
      "diseaseId": "blue-rubber-bleb-nevus-syndrome",
      "distinguishingFeatures": [
        "Multiple venous malformations without enchondromas",
        "Primarily vascular lesions without skeletal involvement"
      ]
    }
  ],
  "redFlags": [
    "Rapid increase in size of enchondromas or hemangiomas",
    "New onset of severe bone pain",
    "Signs of malignant transformation such as swelling, ulceration, or neurological deficits"
  ],
  "specialistType": [
