  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Elevated creatine kinase levels may be mild or absent"
    ],
    "imaging": [
      "MRI may show muscle atrophy in distal limbs",
      "Spinal imaging may reveal scoliosis"
    ],
    "genetic": [
      "Pathogenic variants in MFN2, MPZ, GJB1, and other CMT2-associated genes"
    ],
    "other": [
      "Nerve conduction studies showing reduced compound muscle action potential amplitudes with normal or mildly reduced conduction velocities",
      "Electromyography demonstrating chronic denervation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "charcot-marie-tooth-disease-type-1",
      "distinguishingFeatures": [
        "Demyelinating neuropathy with markedly reduced nerve conduction velocities",
        "Onset typically earlier in life",
        "More prominent sensory loss"
      ]
    },
    {
      "diseaseId": "hereditary-neuropathy-with-liability-to-pressure-palsies",
      "distinguishingFeatures": [
        "Recurrent focal neuropathies at entrapment sites",
        "Usually normal nerve conduction velocities between episodes",
        "Distinct clinical course with episodic symptoms"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive weakness or sensory loss",
    "Bulbar muscle involvement",
    "Respiratory compromise"
  ],
