  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Wiedemann-Steiner Syndrome",
    "criteria": [
      {
        "id": "hypertrichosis",
        "description": "Presence of hypertrichosis cubiti (excessive hair growth on the elbows)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-features",
        "description": "Distinctive facial features including long eyelashes, thick eyebrows, and downslanting palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic variant in KMT2A gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-delay",
        "description": "Postnatal growth retardation or short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypertrichosis cubiti, intellectual disability, and distinctive facial features; genetic confirmation supports diagnosis",
    "notes": "Genetic testing for KMT2A mutations is recommended to confirm diagnosis."
  },
