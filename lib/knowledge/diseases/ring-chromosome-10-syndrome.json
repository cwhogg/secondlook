        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital malformations such as cardiac defects or renal anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of ring chromosome 10 plus at least two major clinical features including developmental delay and characteristic dysmorphic features",
    "notes": "Diagnosis relies heavily on cytogenetic analysis; clinical features are supportive."
