  "keyFindings": {
    "laboratory": [
      "Normal serum creatine kinase or mildly elevated",
      "Normal metabolic panel"
    ],
    "imaging": [
      "Muscle MRI may show mild hypertrophy or fatty infiltration in Becker type"
    ],
    "genetic": [
      "Pathogenic variants in CLCN1 gene (chloride channel gene)",
      "Autosomal dominant inheritance in Thomsen type",
      "Autosomal recessive inheritance in Becker type"
    ],
    "other": [
      "Electromyography showing characteristic myotonic discharges",
      "Muscle biopsy generally nonspecific"
    ]
  },
