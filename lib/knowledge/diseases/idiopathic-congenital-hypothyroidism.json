  "keyFindings": {
    "laboratory": [
      "Elevated serum TSH",
      "Low free T4",
      "Normal or absent thyroid autoantibodies"
    ],
    "imaging": [
      "Normal thyroid gland size and location on ultrasound or scintigraphy"
    ],
    "genetic": [
      "No known causative mutations identified in idiopathic cases; genetic testing typically negative for dyshormonogenesis or dysgenesis genes"
    ],
    "other": [
      "Newborn screening programs detect elevated TSH or low T4"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "thyroid-dysgenesis",
      "distinguishingFeatures": [
        "Absent or ectopic thyroid gland on imaging",
        "Often permanent hypothyroidism"
      ]
    },
    {
      "diseaseId": "transient-neonatal-hypothyroidism",
      "distinguishingFeatures": [
        "Normalization of thyroid function within weeks to months",
        "Often related to maternal antibodies or iodine exposure"
      ]
    }
  ],
  "redFlags": [
    "Failure to thrive despite adequate nutrition",
    "Developmental delay or intellectual disability if untreated",
    "Persistent hypotonia and feeding difficulties"
  ],
