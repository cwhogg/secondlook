  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria established",
    "criteria": [
      {
        "id": "biochemical-deficiency",
        "description": "Demonstration of isolated complex II enzymatic deficiency in muscle or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in SDHA, SDHB, SDHC, or SDHD genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of neurodegenerative symptoms, cardiomyopathy, or metabolic crises consistent with mitochondrial disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biochemical deficiency plus genetic confirmation or clinical features consistent with mitochondrial disease",
    "notes": "Muscle biopsy and enzymatic assays are critical; genetic testing confirms diagnosis"
  },
