        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in known associated genes (e.g., FGFR2, FGFR3, TWIST1)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of premature craniosynostosis plus at least one major clinical feature or genetic confirmation",
