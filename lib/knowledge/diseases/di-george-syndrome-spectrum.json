  "keyFindings": {
    "laboratory": [
      "Hypocalcemia with low parathyroid hormone levels",
      "Lymphopenia with reduced T-cell counts"
    ],
    "imaging": [
      "Echocardiogram showing conotruncal cardiac defects",
      "Chest X-ray or CT showing absent or hypoplastic thymus",
      "Renal ultrasound detecting structural anomalies"
    ],
    "genetic": [
      "Fluorescence in situ hybridization (FISH) or microarray confirming 22q11.2 deletion",
      "Sequencing identifying TBX1 gene mutations"
    ],
    "other": [
      "Speech and language evaluation for velopharyngeal insufficiency",
      "Neuropsychological assessment for cognitive and psychiatric evaluation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "velo-cardio-facial-syndrome",
      "distinguishingFeatures": [
        "Considered part of the DiGeorge spectrum but may lack thymic hypoplasia",
        "More prominent palatal and facial features"
      ]
    },
    {
      "diseaseId": "shprintzen-digeorge-syndrome",
      "distinguishingFeatures": [
        "Overlap with DiGeorge but includes additional craniosynostosis",
        "Distinct genetic mutations outside 22q11.2 deletion"
      ]
    },
    {
      "diseaseId": "alagille-syndrome",
      "distinguishingFeatures": [
        "Cholestatic liver disease and characteristic facial features",
        "Pulmonary stenosis but no thymic hypoplasia or 22q11.2 deletion"
      ]
    }
  ],
  "redFlags": [
    "Neonatal hypocalcemic seizures",
    "Severe congenital heart defects requiring urgent intervention",
    "Recurrent severe infections due to immunodeficiency"
  ],
