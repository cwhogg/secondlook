  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of metabolic or inflammatory causes"
    ],
    "imaging": [
      "Normal echocardiogram without structural abnormalities",
      "Cardiac MRI showing absence of fibrosis or infiltrative disease"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "ECG showing progressive conduction delays (e.g., PR prolongation, bundle branch blocks)",
      "Holter monitoring demonstrating intermittent conduction block"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "lenegre-disease",
      "distinguishingFeatures": [
        "Age-related fibrosis of conduction system",
        "Typically older patients without family history"
      ]
    },
    {
      "diseaseId": "cardiac-infiltrative-disease",
      "distinguishingFeatures": [
        "Presence of structural heart disease on imaging",
        "Systemic signs of infiltrative disorders (e.g., amyloidosis, sarcoidosis)"
      ]
    },
    {
      "diseaseId": "ischemic-heart-disease",
      "distinguishingFeatures": [
        "Evidence of coronary artery disease",
        "Regional wall motion abnormalities on imaging"
      ]
    }
  ],
