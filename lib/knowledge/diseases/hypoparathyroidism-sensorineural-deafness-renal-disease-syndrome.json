  "keyFindings": {
    "laboratory": [
      "Hypocalcemia with low serum parathyroid hormone (PTH)",
      "Hyperphosphatemia",
      "Elevated serum creatinine or evidence of renal tubular acidosis"
    ],
    "imaging": [
      "Renal ultrasound showing dysplasia, hypoplasia, or nephrocalcinosis",
      "Audiometry confirming bilateral sensorineural hearing loss",
      "Brain imaging may be normal or show calcifications"
    ],
    "genetic": [
      "GATA3 (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Family history consistent with autosomal dominant inheritance"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "barakat-syndrome",
      "distinguishingFeatures": [
        "This is the same disease; included for clarity"
      ]
    },
    {
      "diseaseId": "di-gedi-syndrome",
      "distinguishingFeatures": [
        "Includes hypoparathyroidism and deafness but lacks renal disease",
        "Caused by mutations in GATA3 is absent"
      ]
    },
    {
      "diseaseId": "autoimmune-polyglandular-syndrome-type-1",
      "distinguishingFeatures": [
        "Includes hypoparathyroidism but accompanied by candidiasis and adrenal insufficiency",
        "No sensorineural deafness or renal dysplasia"
      ]
    }
  ],
  "redFlags": [
    "Severe hypocalcemia with tetany or seizures",
    "Progressive sensorineural hearing loss in a child",
    "Renal impairment or structural renal abnormalities on imaging"
