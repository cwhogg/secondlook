  "keyFindings": {
    "laboratory": [
      "Persistent proteinuria on urinalysis",
      "Elevated serum creatinine in progressive renal failure",
      "Possible hypothyroidism thyroid function tests"
    ],
    "imaging": [
      "Pelvic radiographs showing bilateral iliac horns",
      "Knee and elbow X-rays demonstrating patellar and radial head hypoplasia"
    ],
    "genetic": [
      "Heterozygous pathogenic variants in LMX1B gene"
    ],
    "other": [
      "Family history consistent with autosomal dominant inheritance",
      "Ophthalmologic evaluation revealing glaucoma or ocular hypertension"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "focal-segmental-glomerulosclerosis",
      "distinguishingFeatures": [
        "Renal involvement without skeletal or nail abnormalities",
        "No iliac horns on imaging"
      ]
    },
    {
      "diseaseId": "multiple-exostoses-syndrome",
      "distinguishingFeatures": [
        "Presence of multiple osteochondromas rather than iliac horns",
        "No nail dysplasia"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive proteinuria or nephrotic syndrome",
    "Severe joint instability causing functional impairment",
    "Development of end-stage renal disease"
  ],
