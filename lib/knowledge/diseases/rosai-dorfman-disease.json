  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP",
      "Polyclonal hypergammaglobulinemia",
      "Mild anemia and leukocytosis"
    ],
    "imaging": [
      "CT or MRI showing massive lymphadenopathy",
      "Extranodal masses in affected organs",
      "Possible hepatosplenomegaly on abdominal imaging"
    ],
    "genetic": [
      "No consistent genetic mutations identified",
      "Somatic mutations occasionally reported but not diagnostic"
    ],
    "other": [
      "Histopathology showing large histiocytes with emperipolesis",
      "Immunohistochemistry positive for S100 and CD68, negative for CD1a"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hodgkin-lymphoma",
      "distinguishingFeatures": [
        "Presence of Reed-Sternberg cells",
        "B symptoms more prominent",
        "Different immunophenotype on biopsy"
      ]
    },
    {
      "diseaseId": "langerhans-cell-histiocytosis",
      "distinguishingFeatures": [
        "CD1a and Langerin positive histiocytes",
        "Birbeck granules on electron microscopy",
        "More common bone lesions"
      ]
    },
    {
      "diseaseId": "tuberculous-lymphadenitis",
      "distinguishingFeatures": [
        "Caseating granulomas on biopsy",
        "Positive acid-fast bacilli staining",
        "History or evidence of tuberculosis infection"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive lymphadenopathy with systemic symptoms",
    "Neurological deficits indicating CNS involvement",
    "Signs of organ failure due to extranodal infiltration"
  ],
