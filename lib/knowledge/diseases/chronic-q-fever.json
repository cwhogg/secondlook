  "diagnosticCriteria": {
    "formalCriteriaName": "Duke Criteria Modified for Q Fever",
    "criteria": [
      {
        "id": "serology",
        "description": "High phase I IgG antibody titer against Coxiella burnetii (≥1:800)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "echocardiography",
        "description": "Echocardiographic evidence of endocarditis or vascular infection",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Compatible clinical features such as prolonged fever, vascular infection, or endocarditis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "molecular-detection",
        "description": "Detection of Coxiella burnetii DNA by PCR in blood or tissue",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of two major criteria or one major plus three minor criteria",
    "notes": "Diagnosis often requires integration of serology, imaging, and clinical features due to nonspecific presentation."
  },
