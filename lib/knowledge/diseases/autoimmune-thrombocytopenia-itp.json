  "keyFindings": {
    "laboratory": [
      "Isolated thrombocytopenia with platelet count <100 x 10^9/L",
      "Normal hemoglobin and white blood cell counts",
      "Peripheral blood smear showing large platelets",
      "Bone marrow showing normal or increased megakaryocytes"
    ],
    "imaging": [
      "Brain imaging (CT/MRI) if intracranial hemorrhage suspected"
    ],
    "genetic": [
      "No specific genetic markers identified"
    ],
    "other": [
      "Positive platelet-associated IgG antibodies in some cases"
    ]
  },
  "differentialDiagnoses": [
    {
