  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for ND-CD-CD-SA Syndrome",
    "criteria": [
      {
        "id": "neurodevelopmental-delay",
        "description": "Global developmental delay or intellectual disability evident in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-defect",
        "description": "Presence of congenital cardiac anomalies such as ventricular septal defect or atrial septal defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-anomalies",
        "description": "Skeletal abnormalities including clinodactyly, scoliosis, or joint contractures",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic point mutation in the causative gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical features (neurodevelopmental delay, craniofacial dysmorphism, cardiac defect) plus genetic confirmation of a pathogenic point mutation",
    "notes": "Diagnosis should be supported by multidisciplinary evaluation including genetics, cardiology, and developmental pediatrics."
  },
