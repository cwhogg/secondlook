  "diagnosticCriteria": {
    "formalCriteriaName": "Coats Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "telangiectatic-vessels",
        "description": "Presence of retinal telangiectatic and aneurysmal vessels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intraretinal-exudation",
        "description": "Intraretinal and subretinal lipid-rich exudation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "retinal-detachment",
        "description": "Exudative retinal detachment without traction or rhegmatogenous cause",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "unilateral-involvement",
        "description": "Typically unilateral disease presentation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of retinal telangiectatic vessels and intraretinal/subretinal exudation",
    "notes": "Diagnosis is primarily clinical supported by imaging; exclusion of other causes of retinal exudation is essential."
  },
