  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for MOPD I/III",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Severe congenital microcephaly with significant reduction in head circumference",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-dysplasia",
        "description": "Characteristic osteodysplastic changes including metaphyseal abnormalities and delayed bone age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "primordial-dwarfism",
        "description": "Severe prenatal and postnatal growth retardation resulting in extreme short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features including prominent nasal bridge, micrognathia, and large eyes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-impairment",
        "description": "Developmental delay and intellectual disability of variable severity",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: severe microcephaly, osteodysplastic skeletal abnormalities, and primordial dwarfism",
    "notes": "Genetic testing can support diagnosis but is not always definitive due to genetic heterogeneity."
  },
