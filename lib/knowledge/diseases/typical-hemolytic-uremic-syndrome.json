  "keyFindings": {
    "laboratory": [
      "Schistocytes on peripheral blood smear",
      "Elevated lactate dehydrogenase (LDH)",
      "Decreased haptoglobin",
      "Thrombocytopenia",
      "Elevated serum creatinine and blood urea nitrogen (BUN)",
      "Hematuria and proteinuria on urinalysis",
      "Positive stool test for Shiga toxin or culture for E. coli O157:H7"
    ],
    "imaging": [
      "Renal ultrasound showing normal or enlarged kidneys",
      "Brain imaging (CT/MRI) if neurological symptoms present"
    ],
    "genetic": [
      "No primary genetic mutations typically associated; differs from atypical HUS"
    ],
