  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Radiographic evidence of partial or complete absence of the ulna",
      "X-ray showing hypoplasia or aplasia of ulnar digits",
      "MRI may demonstrate soft tissue and muscle hypoplasia"
    ],
    "genetic": [
      "No consistent genetic mutation identified in isolated cases",
      "Genetic testing to exclude syndromic associations such as Holt-Oram syndrome"
    ],
    "other": [
      "Clinical examination revealing radial deviation and limb shortening"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "radial-ray-deficiency",
      "distinguishingFeatures": [
        "Absence or hypoplasia of the radius rather than the ulna",
        "More frequent thumb anomalies",
        "Often associated with cardiac defects in syndromic cases"
      ]
    },
    {
      "diseaseId": "humeroradial-synostosis",
      "distinguishingFeatures": [
        "Fusion of humerus and radius bones",
        "Limited elbow flexion and extension",
        "Normal ulna presence"
      ]
    }
  ],
  "redFlags": [
    "Presence of cardiac anomalies suggesting syndromic association",
    "Severe functional impairment of the affected limb",
    "Progressive deformity or worsening limb length discrepancy"
  ],
