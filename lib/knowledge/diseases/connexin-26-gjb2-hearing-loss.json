  "diagnosticCriteria": {
    "formalCriteriaName": "Genetic Diagnosis of GJB2-Related Hearing Loss",
    "criteria": [
      {
        "id": "clinical-hearing-loss",
        "description": "Bilateral nonsyndromic sensorineural hearing loss confirmed by audiometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the GJB2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-syndromic",
        "description": "Absence of clinical features suggesting syndromic hearing loss",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral nonsyndromic sensorineural hearing loss plus identification of biallelic pathogenic GJB2 variants",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical presentation alone is insufficient."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Bilateral congenital sensorineural hearing loss",
        "frequency": 0.95,
        "bodySystem": "otolaryngological",
        "notes": "Typically non-progressive or slowly progressive"
      },
      {
        "symptomName": "Absence of vestibular dysfunction",
        "frequency": 0.85,
        "bodySystem": "neurological",
        "notes": "Vestibular symptoms are generally not present"
      }
    ],
    "common": [
      {
        "symptomName": "Mild to profound hearing impairment",
        "frequency": 0.75,
        "bodySystem": "otolaryngological",
        "notes": "Severity varies among affected individuals"
      },
      {
        "symptomName": "Speech delay secondary to hearing loss",
        "frequency": 0.7,
        "bodySystem": "neurological",
        "notes": "Common in untreated cases"
      },
      {
        "symptomName": "Normal otoscopic examination",
        "frequency": 0.8,
        "bodySystem": "otolaryngological",
        "notes": "No middle ear abnormalities"
      },
      {
        "symptomName": "No associated systemic abnormalities",
        "frequency": 0.7,
        "bodySystem": "constitutional",
        "notes": "Hearing loss is nonsyndromic"
      }
    ],
    "occasional": [
      {
        "symptomName": "Progressive worsening of hearing loss",
        "frequency": 0.3,
        "bodySystem": "otolaryngological",
        "notes": "Occurs in a subset of patients"
      },
      {
        "symptomName": "Tinnitus",
        "frequency": 0.25,
        "bodySystem": "otolaryngological",
        "notes": "Reported occasionally"
      },
      {
        "symptomName": "Mild vestibular hypofunction",
        "frequency": 0.15,
        "bodySystem": "neurological",
        "notes": "Rarely observed"
      },
      {
        "symptomName": "Delayed language acquisition",
        "frequency": 0.4,
        "bodySystem": "neurological",
        "notes": "Secondary to hearing impairment"
      }
    ],
    "rare": [
      {
        "symptomName": "Unilateral hearing loss",
        "frequency": 0.05,
        "bodySystem": "otolaryngological",
        "notes": "Rare presentation"
      },
      {
        "symptomName": "Mild skin abnormalities (e.g., palmoplantar keratoderma)",
        "frequency": 0.02,
        "bodySystem": "dermatological",
        "notes": "Very rare, associated with specific GJB2 variants"
      },
      {
        "symptomName": "Vestibular symptoms such as vertigo",
        "frequency": 0.03,
        "bodySystem": "neurological",
        "notes": "Rarely reported"
      }
    ]
  },
