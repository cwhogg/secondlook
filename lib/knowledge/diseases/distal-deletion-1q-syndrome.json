  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Distal 1q Deletion Syndrome",
    "criteria": [
      {
        "id": "chromosomal-deletion",
        "description": "Confirmed deletion involving the distal 1q43-q44 region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Presence of moderate to severe intellectual disability or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "corpus-callosum-anomaly",
        "description": "Neuroimaging evidence of corpus callosum hypoplasia or agenesis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic craniofacial dysmorphisms including microcephaly, hypertelorism, and broad nasal bridge",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "History of seizures or epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed distal 1q deletion by genetic testing plus intellectual disability or developmental delay",
    "notes": "Diagnosis relies heavily on genetic confirmation; clinical features support but are variable."
  },
