        "symptomName": "Paracentral scotomas",
        "frequency": 0.85,
        "bodySystem": "ophthalmological",
        "notes": "Localized blind spots near the center of vision"
      },
      {
        "symptomName": "Loss of retinal transparency in juxtafoveal region",
        "frequency": 0.9,
        "bodySystem": "ophthalmological"
      },
      {
        "symptomName": "Right-angle venules",
        "frequency": 0.75,
        "bodySystem": "ophthalmological",
        "notes": "Characteristic vascular abnormality seen on imaging"
      }
    ],
    "common": [
      {
        "symptomName": "Mild central vision loss",
        "frequency": 0.7,
        "bodySystem": "ophthalmological"
      },
      {
        "symptomName": "Metamorphopsia",
        "frequency": 0.65,
        "bodySystem": "ophthalmological",
        "notes": "Visual distortion of images"
      },
      {
        "symptomName": "Crystalline deposits in macula",
        "frequency": 0.6,
        "bodySystem": "ophthalmological"
      },
      {
        "symptomName": "Macular pigment loss",
        "frequency": 0.55,
        "bodySystem": "ophthalmological"
      },
      {
        "symptomName": "Mild photophobia",
        "frequency": 0.5,
        "bodySystem": "ophthalmological"
      }
    ],
    "occasional": [
      {
        "symptomName": "Intraretinal cavitations",
        "frequency": 0.4,
        "bodySystem": "ophthalmological",
