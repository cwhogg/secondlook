  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Atrial Standstill Diagnostic Criteria",
    "criteria": [
      {
        "id": "absence-atrial-activity",
        "description": "Electrocardiographic evidence of absence of atrial electrical activity (no P waves)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bradycardia",
        "description": "Persistent bradycardia with junctional or ventricular escape rhythm",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of atrial standstill or sudden cardiac death",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "atrial-non-capture",
        "description": "Failure to capture atrial myocardium on pacing attempts",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-atrial-contraction",
        "description": "Echocardiographic evidence of absent atrial contraction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: absence of atrial electrical activity on ECG, persistent bradycardia with escape rhythm, and positive family history",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
