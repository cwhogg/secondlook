  "diagnosticCriteria": {
    "formalCriteriaName": "GM1 Gangliosidosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficient beta-galactosidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic mutations in the GLB1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features such as neurodegeneration, hepatosplenomegaly, and skeletal dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Brain MRI showing cerebral atrophy and white matter changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient beta-galactosidase enzyme activity plus either pathogenic GLB1 mutations or characteristic clinical features",
    "notes": "Diagnosis is confirmed by enzymatic assay and molecular genetic testing."
  },
