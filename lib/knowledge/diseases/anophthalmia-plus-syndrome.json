  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests unless secondary complications present",
      "Endocrine panel may reveal hormone deficiencies"
    ],
    "imaging": [
      "Orbital MRI or CT confirming absence of ocular structures",
      "Echocardiography identifying congenital heart defects",
      "Renal ultrasound showing hypoplasia or agenesis"
    ],
    "genetic": [
      "Mutations in SOX2, OTX2, or other genes implicated in ocular and systemic development",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Clinical examination revealing craniofacial anomalies",
      "Audiological testing for hearing impairment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "microphthalmia-syndrome",
