  "diagnosticCriteria": {
    "formalCriteriaName": "WHO 2022 Diagnostic Criteria for Essential Thrombocythemia",
    "criteria": [
      {
        "id": "et-c1",
        "description": "Platelet count >= 450,000/µL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "et-c2",
        "description": "Bone marrow biopsy showing proliferation mainly of the megakaryocyte lineage with increased numbers of enlarged, mature megakaryocytes with hyperlobulated nuclei; no significant increase in granulopoiesis or erythropoiesis and very rarely minor increase in reticulin fibers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "et-c3",
        "description": "Not meeting WHO criteria for BCR-ABL1+ CML, PV, PMF, MDS, or other myeloid neoplasm",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "et-c4",
        "description": "Presence of JAK2, CALR, or MPL mutation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "et-c5",
        "description": "Presence of a clonal marker or absence of evidence for reactive thrombocytosis",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All 4 major criteria, OR first 3 major criteria plus the minor criterion",
    "notes": "JAK2 V617F found in ~55% of ET, CALR mutations in ~25%, MPL mutations in ~3%. Triple-negative ET (~15%) requires exclusion of reactive causes."
  },
