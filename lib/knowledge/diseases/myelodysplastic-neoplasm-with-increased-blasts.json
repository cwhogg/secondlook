  "keyFindings": {
    "laboratory": [
      "Peripheral blood cytopenias (anemia, neutropenia, thrombocytopenia)",
      "Bone marrow biopsy showing 5-19% myeloblasts",
      "Dysplastic changes in erythroid, myeloid, and megakaryocytic lineages",
      "Abnormal cytogenetics such as del(5q), del(7q), or complex karyotype"
    ],
    "imaging": [
      "Occasional splenomegaly on abdominal ultrasound or CT"
    ],
    "genetic": [
      "Somatic mutations in genes such as SF3B1, ASXL1, TET2, and TP53",
      "Cytogenetic abnormalities associated with MDS"
    ],
    "other": [
      "Elevated serum erythropoietin levels in anemia",
      "Increased lactate dehydrogenase (LDH) in some cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "acute-myeloid-leukemia",
