        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy-dystrophic-changes",
        "description": "Muscle biopsy showing dystrophic changes with fibrosis and fatty infiltration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "emery-nelson-genetic-mutation",
        "description": "Identification of pathogenic mutation in the LMNA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-conduction-abnormalities",
        "description": "Presence of cardiac conduction defects or arrhythmias",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography-myopathic-pattern",
        "description": "Electromyography demonstrating myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital muscle weakness with dystrophic muscle biopsy findings and confirmed LMNA gene mutation",
    "notes": "Genetic testing is critical for definitive diagnosis; cardiac evaluation recommended due to risk of conduction defects."
  },
