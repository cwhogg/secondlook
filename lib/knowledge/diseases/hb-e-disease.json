  "diagnosticCriteria": {
    "formalCriteriaName": "Hemoglobin E Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "hbe-homozygosity",
        "description": "Presence of homozygous Hemoglobin E mutation confirmed by hemoglobin electrophoresis or HPLC",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mild-microcytic-anemia",
        "description": "Mild anemia with microcytosis (low MCV) on complete blood count",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-severe-symptoms",
        "description": "Lack of severe hemolysis or transfusion dependence",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Homozygous Hb E mutation plus mild microcytic anemia",
    "notes": "Diagnosis is often incidental during screening or anemia workup in endemic populations."
  },
