  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for GNE Myopathy",
    "criteria": [
      {
        "id": "clinical-distal-weakness",
        "description": "Adult-onset distal muscle weakness predominantly affecting the tibialis anterior muscle",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy-rimmed-vacuoles",
        "description": "Muscle biopsy showing rimmed vacuoles and muscle fiber atrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the GNE gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-sensory-loss",
        "description": "No significant sensory neuropathy on clinical or electrophysiological testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "slow-progressive-course",
        "description": "Slowly progressive muscle weakness over years",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of adult-onset distal muscle weakness with rimmed vacuoles on muscle biopsy plus identification of pathogenic GNE mutations",
    "notes": "Genetic testing is essential to confirm diagnosis and differentiate from other distal myopathies."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Distal lower limb muscle weakness (especially tibialis anterior)",
        "frequency": 0.95,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Rimmed vacuoles observed in muscle biopsy",
        "frequency": 0.9,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Foot drop due to selective anterior tibialis muscle involvement",
        "frequency": 0.85,
        "bodySystem": "musculoskeletal"
      }
    ],
    "common": [
      {
        "symptomName": "Progressive weakness of hand intrinsic muscles",
        "frequency": 0.75,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Mild proximal muscle weakness",
        "frequency": 0.7,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Muscle atrophy in distal limbs",
        "frequency": 0.7,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Fatigue on exertion",
        "frequency": 0.65,
        "bodySystem": "constitutional"
      },
      {
        "symptomName": "Normal sensory examination",
        "frequency": 0.6,
        "bodySystem": "neurological"
      }
    ],
    "occasional": [
      {
        "symptomName": "Mild scapular winging",
        "frequency": 0.4,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Mild dysphagia",
        "frequency": 0.3,
        "bodySystem": "gastrointestinal"
      },
      {
        "symptomName": "Mild respiratory muscle weakness",
        "frequency": 0.25,
        "bodySystem": "respiratory"
      },
      {
        "symptomName": "Muscle cramps",
        "frequency": 0.2,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Joint contractures",
        "frequency": 0.15,
        "bodySystem": "musculoskeletal"
      }
    ],
    "rare": [
      {
        "symptomName": "Cardiac involvement (rare cardiomyopathy)",
