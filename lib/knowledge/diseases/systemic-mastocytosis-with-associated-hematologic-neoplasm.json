  "diagnosticCriteria": {
    "formalCriteriaName": "WHO 2016 Diagnostic Criteria for Systemic Mastocytosis",
    "criteria": [
      {
        "id": "major",
        "description": "Multifocal, dense infiltrates of mast cells (≥15 mast cells in aggregates) detected in bone marrow biopsies or other extracutaneous organs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "minor-1",
        "description": "More than 25% of mast cells in infiltrates are spindle-shaped or have atypical morphology",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "minor-2",
        "description": "Detection of KIT codon 816 mutation in bone marrow, blood, or other extracutaneous organs",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "minor-3",
        "description": "Mast cells expressing CD2 and/or CD25 by flow cytometry or immunohistochemistry",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "minor-4",
        "description": "Serum total tryptase level persistently >20 ng/mL (unless associated hematologic neoplasm elevates tryptase)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ahn-criterion",
        "description": "Presence of a clonal hematologic non-mast cell lineage disease (e.g., myelodysplastic syndrome, chronic myelomonocytic leukemia, acute myeloid leukemia)",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Diagnosis requires the major criterion plus one minor criterion for systemic mastocytosis, plus evidence of an associated hematologic neoplasm.",
    "notes": "The associated hematologic neoplasm must be diagnosed according to WHO criteria for the specific hematologic disorder."
  },
