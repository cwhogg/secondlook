  "keyFindings": {
    "laboratory": [
      "Normal platelet count (distinguishes from thrombocytopenic purpura)",
      "Elevated serum IgA (30-50%)",
      "Elevated ESR and CRP",
      "Normal coagulation studies",
      "Urinalysis: hematuria, proteinuria, RBC casts",
      "Elevated serum creatinine in severe nephritis",
      "Fecal occult blood positive"
    ],
    "imaging": [
      "Abdominal ultrasound: bowel wall thickening, intussusception",
      "CT abdomen: bowel wall edema, mesenteric lymphadenopathy",
      "Testicular ultrasound: increased flow (epididymo-orchitis vs. torsion)"
    ],
    "genetic": [
      "HLA-DRB1*01 association",
      "HLA-B35 association reported",
      "Complement factor H-related gene variants"
    ],
    "other": [
      "Skin biopsy: leukocytoclastic vasculitis with IgA deposition on immunofluorescence",
      "Renal biopsy: mesangial IgA deposition (similar to IgA nephropathy), crescents in severe cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "immune-thrombocytopenic-purpura",
      "distinguishingFeatures": [
        "Low platelet count",
        "Non-palpable petechiae",
        "No abdominal/joint symptoms"
      ]
    },
    {
      "diseaseId": "microscopic-polyangiitis",
      "distinguishingFeatures": [
        "ANCA positive",
        "Pauci-immune GN (no IgA)",
        "Adults",
        "Pulmonary-renal syndrome"
      ]
    },
    {
      "diseaseId": "cryoglobulinemic-vasculitis",
      "distinguishingFeatures": [
        "Cryoglobulins present",
        "HCV association",
        "Complement consumption",
        "Peripheral neuropathy"
      ]
    },
    {
      "diseaseId": "meningococcemia",
      "distinguishingFeatures": [
        "Rapidly progressive",
        "Fever and meningismus",
        "Blood cultures positive",
        "Purpura fulminans"
      ]
    }
  ],
  "redFlags": [
    "Progressive renal insufficiency (especially in adults)",
    "Nephrotic-range proteinuria",
    "Massive GI hemorrhage",
    "Signs of intussusception (colicky pain, currant jelly stool)",
    "Acute scrotum (must exclude testicular torsion)",
    "Recurrence beyond 6 months (consider renal monitoring)"
  ],
