  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for 12q14 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "microdeletion-confirmation",
        "description": "Confirmed microdeletion involving the 12q14 chromosomal region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation with short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including broad forehead, hypertelorism, and prominent nasal bridge",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-anomalies",
        "description": "Presence of skeletal anomalies such as clinodactyly or brachydactyly",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of confirmed 12q14 microdeletion plus at least two major clinical features (growth retardation and developmental delay)",
    "notes": "Diagnosis requires molecular confirmation; clinical features may vary in severity."
  },
