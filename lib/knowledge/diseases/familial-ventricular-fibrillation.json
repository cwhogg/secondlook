  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Ventricular Fibrillation Diagnostic Criteria",
    "criteria": [
      {
        "id": "vf-episode",
        "description": "Documented episode(s) of ventricular fibrillation without structural heart disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of sudden cardiac death or ventricular fibrillation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-structural",
        "description": "Absence of structural heart disease confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variant in genes associated with familial ventricular fibrillation (e.g., DPP6)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of documented ventricular fibrillation episodes without structural heart disease plus a positive family history",
    "notes": "Genetic testing can support diagnosis but is not mandatory."
  },
