  "keyFindings": {
    "laboratory": [
      "Elevated anti-GAD65 antibodies in serum and/or cerebrospinal fluid",
      "Occasionally anti-amphiphysin antibodies"
    ],
    "imaging": [
      "Brain MRI usually normal or nonspecific",
      "Spinal MRI may show mild nonspecific changes"
    ],
    "genetic": [
      "No consistent genetic mutations identified; primarily autoimmune etiology"
    ],
    "other": [
      "Electromyography showing continuous motor unit activity at rest",
      "Positive response to benzodiazepines or baclofen treatment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "multiple-sclerosis",
      "distinguishingFeatures": [
        "Demyelinating lesions on MRI",
        "Relapsing-remitting course",
        "Absence of anti-GAD antibodies"
      ]
    },
    {
      "diseaseId": "tetanus",
      "distinguishingFeatures": [
        "History of wound or infection",
        "Generalized muscle spasms with trismus",
        "Rapid progression and systemic toxicity"
      ]
    },
    {
      "diseaseId": "parkinsonism",
      "distinguishingFeatures": [
        "Bradykinesia and resting tremor",
        "Response to dopaminergic therapy",
        "Lack of stimulus-induced spasms"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive rigidity and spasms",
    "Respiratory muscle involvement causing breathing difficulty",
    "New onset seizures or altered mental status"
  ],
