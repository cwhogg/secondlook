  "diagnosticCriteria": {
    "formalCriteriaName": "Eurofever/PRINTO Classification Criteria (2019)",
    "criteria": [
      {
        "id": "hids-maj1",
        "description": "Recurrent febrile episodes (typically 3-7 days) starting before age 2",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hids-maj2",
        "description": "Confirmed pathogenic MVK gene mutations",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hids-min1",
        "description": "Elevated serum IgD > 100 IU/mL (present in ~80%)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hids-min2",
        "description": "Elevated urinary mevalonic acid during attacks",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hids-min3",
        "description": "Cervical lymphadenopathy during attacks",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hids-min4",
        "description": "GI symptoms (vomiting, diarrhea, abdominal pain) during attacks",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical picture of recurrent febrile episodes with elevated IgD and/or mevalonic aciduria, confirmed by MVK gene mutations. Eurofever criteria require genetic confirmation plus compatible features.",
    "notes": "MKD is a spectrum: HIDS is milder, mevalonic aciduria (MA) is severe with neurological involvement. MVK enzyme activity: HIDS has 1-10% residual activity; MA has <1%."
  },
