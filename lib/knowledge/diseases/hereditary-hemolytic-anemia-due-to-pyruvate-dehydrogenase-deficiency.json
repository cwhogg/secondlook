  "diagnosticCriteria": {
    "formalCriteriaName": "PDH Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced pyruvate dehydrogenase complex enzyme activity in blood or tissue samples",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemolytic-anemia",
        "description": "Presence of chronic hemolytic anemia confirmed by laboratory evidence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-impairment",
        "description": "Neurological symptoms including developmental delay or hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in PDHA1 or related PDH complex genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "lactate-elevation",
        "description": "Elevated blood or CSF lactate levels indicating mitochondrial dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced PDH enzyme activity, chronic hemolytic anemia, and neurological impairment",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if enzyme assay and clinical features are definitive."
  },
