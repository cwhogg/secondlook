  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Thanatophoric Dysplasia Type 1",
    "criteria": [
      {
        "id": "micromelia",
        "description": "Severe shortening of the limbs (micromelia) with bowed femurs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "macrocephaly",
        "description": "Macrocephaly with frontal bossing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "narrow-thorax",
        "description": "Narrow thorax with short ribs leading to respiratory insufficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-findings",
        "description": "Characteristic radiologic features including telephone receiver-shaped femora and flattened vertebral bodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic FGFR3 mutations associated with TD Type 1",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe micromelia with bowed femurs, macrocephaly, narrow thorax, and characteristic radiologic findings",
    "notes": "Genetic testing for FGFR3 mutations can confirm diagnosis but is not mandatory if clinical and radiologic criteria are met."
  },
