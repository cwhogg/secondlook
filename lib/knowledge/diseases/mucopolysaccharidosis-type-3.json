  "diagnosticCriteria": {
    "formalCriteriaName": "Sanfilippo Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive neurodegeneration with developmental delay and behavioral abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-gags",
        "description": "Elevated urinary heparan sulfate glycosaminoglycans",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-assay",
        "description": "Deficient activity of one of the four enzymes involved in heparan sulfate degradation (SGSH, NAGLU, HGSNAT, GNS)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in MPS III-related genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive neurodegeneration with elevated urinary heparan sulfate and deficient enzyme activity",
    "notes": "Genetic testing confirms diagnosis and subtype"
  },
