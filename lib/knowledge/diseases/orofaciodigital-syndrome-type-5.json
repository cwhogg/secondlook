  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Orofaciodigital Syndrome Type 5",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Presence of characteristic facial dysmorphic features including hypertelorism, broad nasal bridge, and cleft lip/palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digital-malformations",
        "description": "Digital anomalies such as brachydactyly, syndactyly, and clinodactyly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oral-anomalies",
        "description": "Oral cavity abnormalities including lobulated tongue and oral frenulae",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cognitive-development",
        "description": "Variable intellectual disability or developmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiological-findings",
        "description": "Radiographic evidence of skeletal anomalies in hands and feet",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: characteristic facial dysmorphism, digital malformations, and oral anomalies",
    "notes": "Genetic testing may support diagnosis but is not always available."
  },
