  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Usher Syndrome",
    "criteria": [
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral congenital sensorineural hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "retinitis-pigmentosa",
        "description": "Progressive retinitis pigmentosa leading to night blindness and peripheral vision loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vestibular-dysfunction",
        "description": "Vestibular areflexia or dysfunction causing balance problems",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in known Usher syndrome genes (e.g., MYO7A, USH2A)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral congenital sensorineural hearing loss and retinitis pigmentosa; vestibular dysfunction supports diagnosis; genetic confirmation is supportive but not mandatory.",
    "notes": "Usher syndrome is classified into types I, II, and III based on severity and presence of vestibular symptoms."
  },
