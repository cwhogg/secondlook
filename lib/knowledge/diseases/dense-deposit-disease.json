  "diagnosticCriteria": {
    "formalCriteriaName": "Dense Deposit Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Electron microscopy showing dense intramembranous deposits in the glomerular basement membrane",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "complement-abnormalities",
        "description": "Evidence of alternative complement pathway dysregulation (e.g., low C3 with normal C4)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Nephrotic syndrome or nephritic syndrome with proteinuria and hematuria",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-glomerulopathies",
        "description": "Exclusion of other causes of C3 glomerulopathy and immune complex-mediated glomerulonephritis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of dense intramembranous deposits on electron microscopy plus clinical evidence of nephrotic/nephritic syndrome and complement abnormalities",
    "notes": "Diagnosis requires renal biopsy with electron microscopy and complement studies."
  },
