  "diagnosticCriteria": {
    "formalCriteriaName": "Permanent Neonatal Diabetes Diagnostic Criteria",
    "criteria": [
      {
        "id": "onset-age",
        "description": "Onset of diabetes mellitus within the first 6 months of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "persistent-hyperglycemia",
        "description": "Persistent hyperglycemia requiring insulin therapy beyond 18 months of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-autoantibodies",
        "description": "Absence of pancreatic autoantibodies (e.g., GAD65, IA-2)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in genes associated with permanent neonatal diabetes (e.g., KCNJ11, ABCC8)",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Onset of diabetes before 6 months of age with persistent insulin dependence beyond 18 months and exclusion of autoimmune diabetes",
    "notes": "Genetic testing is strongly recommended to confirm diagnosis and guide therapy."
  },
