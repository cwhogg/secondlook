  "keyFindings": {
    "laboratory": [
      "Monoclonal protein spike (M protein) on serum or urine electrophoresis",
      "Elevated serum free light chain ratio",
      "Anemia with normocytic normochromic features",
      "Elevated serum calcium",
      "Elevated creatinine indicating renal impairment"
    ],
    "imaging": [
      "Lytic bone lesions on skeletal survey or CT",
      "MRI showing focal bone marrow lesions",
      "PET-CT for extramedullary disease detection"
    ],
    "genetic": [
      "CCND1 (susceptibility)"
    ],
    "other": [
      "Bone marrow biopsy showing clonal plasma cell infiltration",
      "Serum beta-2 microglobulin elevation as a prognostic marker"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "monoclonal-gammopathy-of-undetermined-significance",
      "distinguishingFeatures": [
        "Lower plasma cell percentage (<10%)",
        "Absence of CRAB features",
        "No end-organ damage"
      ]
    },
    {
      "diseaseId": "waldenstrom-macroglobulinemia",
      "distinguishingFeatures": [
        "IgM monoclonal gammopathy instead of IgG or IgA",
        "Lymphoplasmacytic infiltration rather than plasma cell predominance",
        "Hyperviscosity symptoms more prominent"
      ]
    }
  ],
  "redFlags": [
    "New onset bone pain with lytic lesions on imaging",
