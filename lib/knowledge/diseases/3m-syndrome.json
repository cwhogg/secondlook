  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for 3M Syndrome",
    "criteria": [
      {
        "id": "growth-retardation",
        "description": "Severe pre- and postnatal growth retardation with proportionate short stature",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including a triangular face, prominent forehead, and fleshy nasal tip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Radiological evidence of slender long bones and tall vertebral bodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic variants in CUL7, OBSL1, or CCDC8 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe growth retardation, characteristic facial features, skeletal abnormalities, and confirmation of pathogenic variants in associated genes",
    "notes": "Diagnosis is confirmed by genetic testing; clinical features guide initial suspicion."
  },
