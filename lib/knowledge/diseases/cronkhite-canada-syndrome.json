  "diagnosticCriteria": {
    "formalCriteriaName": "Cronkhite-Canada Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "diffuse-gi-polyposis",
        "description": "Presence of diffuse gastrointestinal hamartomatous polyposis confirmed by endoscopy and histology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ectodermal-abnormalities",
        "description": "Ectodermal changes including alopecia, onychodystrophy, and skin hyperpigmentation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chronic-diarrhea",
        "description": "Chronic watery diarrhea lasting more than 4 weeks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "weight-loss",
        "description": "Unintentional weight loss",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypoproteinemia",
        "description": "Laboratory evidence of hypoproteinemia or hypoalbuminemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of diffuse GI polyposis plus at least two of the following: ectodermal abnormalities and chronic diarrhea",
    "notes": "Diagnosis is clinical supported by endoscopic and histopathologic findings; no standardized formal criteria universally accepted."
  },
