  "differentialDiagnoses": [
    {
      "diseaseId": "myotonic-dystrophy-type-1",
      "distinguishingFeatures": [
        "CTG repeat expansion in DMPK gene",
        "Distal muscle weakness predominant",
        "More prominent multisystem involvement including frontal balding and cardiac conduction defects"
      ]
    },
    {
      "diseaseId": "limb-girdle-muscular-dystrophy",
      "distinguishingFeatures": [
        "Absence of myotonia",
        "Different genetic mutations depending on subtype",
        "Predominantly proximal muscle weakness without myotonic discharges on EMG"
      ]
    }
  ],
  "redFlags": [
