  "keyFindings": {
    "laboratory": [
      "Severe pancytopenia with aplastic anemia",
      "Markedly shortened telomere length on flow-FISH or qPCR"
    ],
    "imaging": [
      "Bilateral exudative retinopathy on fundoscopic exam and fluorescein angiography",
      "Intracranial calcifications on CT or MRI brain",
      "Cerebellar hypoplasia on brain MRI"
    ],
    "genetic": [
      "Pathogenic heterozygous mutations in TINF2 gene"
    ],
    "other": [
      "Skin and nail abnormalities consistent with telomere biology disorders"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dyskeratosis-congenita",
      "distinguishingFeatures": [
        "Classic triad of nail dystrophy, oral leukoplakia, and reticulated skin pigmentation",
        "Less frequent intracranial calcifications",
        "More variable retinal involvement"
      ]
    },
    {
      "diseaseId": "coats-disease",
      "distinguishingFeatures": [
        "Unilateral exudative retinopathy",
        "No bone marrow failure or intracranial calcifications",
        "Usually sporadic and isolated ocular disease"
      ]
    }
  ],
  "redFlags": [
    "Early onset bilateral exudative retinopathy",
    "Progressive bone marrow failure in infancy or early childhood",
    "Intracranial calcifications with neurological symptoms"
  ],
