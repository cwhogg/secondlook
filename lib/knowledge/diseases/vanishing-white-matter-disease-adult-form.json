  "diagnosticCriteria": {
    "formalCriteriaName": "Vanishing White Matter Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive neurological decline with episodes triggered by stressors such as fever or head trauma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-mri",
        "description": "Characteristic MRI findings showing diffuse white matter rarefaction and cystic degeneration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic biallelic mutations in EIF2B1-5 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-of-onset",
        "description": "Adult onset typically after adolescence",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive neurological decline with stress-induced episodes, characteristic MRI findings, and confirmation of biallelic EIF2B mutations",
    "notes": "Diagnosis requires integration of clinical, radiological, and genetic data."
  },
