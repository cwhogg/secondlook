  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Coffin-Siris Syndrome",
    "criteria": [
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fifth-digit-nail-hypoplasia",
        "description": "Hypoplasia or aplasia of the fifth digit nails or distal phalanges",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Coarse facial features including thick eyebrows, wide nasal bridge, and thick lips",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "BAF-complex-mutation",
        "description": "Pathogenic mutation in genes encoding the BAF chromatin remodeling complex",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-delay",
        "description": "Postnatal growth retardation or short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "feeding-difficulties",
        "description": "Early feeding difficulties or failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of developmental delay, fifth-digit nail hypoplasia, and distinctive facial features; genetic confirmation supports diagnosis",
    "notes": "Genetic testing for mutations in ARID1B and other BAF complex genes is recommended to confirm diagnosis."
  },
