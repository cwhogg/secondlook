  "diagnosticCriteria": {
    "formalCriteriaName": "2022 ACR/EULAR Classification Criteria for GPA",
    "criteria": [
      {
        "id": "gpa-1",
        "description": "Nasal involvement: bloody discharge, crusting, nasal ulceration, or septal perforation/saddle nose deformity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gpa-2",
        "description": "Cartilaginous involvement: nasal septal perforation/saddle nose, hearing loss (conductive or sensorineural), or laryngeal/tracheal stenosis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gpa-3",
        "description": "PR3-ANCA (c-ANCA) positivity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gpa-4",
        "description": "Pulmonary nodules, masses, or cavities on imaging",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gpa-5",
        "description": "Granulomatous inflammation on biopsy (extravascular)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gpa-6",
        "description": "Pauci-immune glomerulonephritis (crescentic or necrotizing)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gpa-7",
        "description": "Positive c-ANCA or PR3-ANCA by immunoassay",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gpa-8",
        "description": "Retro-orbital mass or inflammation",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Diagnosis of small- or medium-vessel vasculitis plus total weighted score >= 5 on the classification criteria",
    "notes": "Must first establish a diagnosis of vasculitis. The 2022 criteria use a weighted scoring system. Biopsy showing necrotizing granulomatous inflammation is highly supportive."
  },
