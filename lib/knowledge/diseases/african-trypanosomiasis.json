  "diagnosticCriteria": {
    "formalCriteriaName": "WHO Diagnostic Criteria for African Trypanosomiasis",
    "criteria": [
      {
        "id": "parasite-detection",
        "description": "Identification of Trypanosoma brucei parasites in blood, lymph node aspirate, or cerebrospinal fluid",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical signs such as intermittent fever, lymphadenopathy, and neurological symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "csf-analysis",
        "description": "Cerebrospinal fluid examination showing elevated white cell count and/or presence of trypanosomes",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Detection of Trypanosoma brucei parasites in blood or lymph node aspirate plus compatible clinical features",
    "notes": "Serological tests (CATT) support diagnosis but require parasitological confirmation."
  },
