  "diagnosticCriteria": {
    "formalCriteriaName": "DADA2 Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the ADA2 (CECR1) gene identified by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vasculopathy",
        "description": "Clinical evidence of systemic vasculopathy including ischemic or hemorrhagic strokes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Recurrent infections or laboratory evidence of immunodeficiency (e.g., hypogammaglobulinemia)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "systemic-inflammation",
        "description": "Elevated inflammatory markers (e.g., ESR, CRP) and systemic inflammation signs",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic ADA2 mutations plus clinical evidence of vasculopathy (stroke or vasculitis)",
    "notes": "Diagnosis is confirmed by genetic testing; clinical presentation can be variable."
  },
