  "keyFindings": {
    "laboratory": [
      "Histopathology showing intraepidermal cleavage",
      "Normal routine blood tests unless secondary complications"
    ],
    "imaging": [
      "Dental radiographs showing hypodontia or anodontia",
      "Occasional esophagogram if strictures suspected"
    ],
    "genetic": [
      "Pathogenic variants in KRT5 or KRT14 genes"
    ],
    "other": [
      "Skin biopsy immunofluorescence mapping confirming intraepidermal blistering"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "junctional-epidermolysis-bullosa",
      "distinguishingFeatures": [
        "Blistering occurs at the level of lamina lucida",
        "More severe mucosal involvement",
        "Different genetic mutations (e.g., LAMB3, LAMC2)"
      ]
    },
    {
      "diseaseId": "dystrophic-epidermolysis-bullosa",
      "distinguishingFeatures": [
        "Blistering below the basement membrane",
        "Scarring and milia formation common",
        "Mutations in COL7A1 gene"
      ]
    }
  ],
  "redFlags": [
    "Extensive mucosal involvement causing feeding difficulties",
    "Signs of secondary infection or sepsis",
    "Severe dental agenesis impacting nutrition and development"
  ],
