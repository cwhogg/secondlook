  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Slit-Lamp Diagnostic Criteria for PPCD",
    "criteria": [
      {
        "id": "vesicular-lesions",
        "description": "Presence of vesicular, band-like, or geographic lesions on the posterior corneal surface observed by slit-lamp examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "corneal-endothelial-changes",
        "description": "Abnormal corneal endothelial cell morphology with epithelial-like transformation on specular microscopy or confocal microscopy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "secondary-glaucoma",
        "description": "Development of secondary open-angle or angle-closure glaucoma associated with endothelial dysfunction",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic vesicular or band-like posterior corneal lesions plus endothelial cell abnormalities on imaging",
    "notes": "Genetic testing for mutations in the ZEB1 gene may support diagnosis but is not mandatory."
  },
