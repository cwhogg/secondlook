  "diagnosticCriteria": {
    "formalCriteriaName": "Phosphorylase Kinase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced phosphorylase kinase enzyme activity in liver and/or muscle biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in PHKA1 or PHKA2 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of hepatomegaly and/or muscle weakness consistent with glycogen storage disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Reduced enzyme activity plus pathogenic genetic variant identification or characteristic clinical features with enzyme deficiency",
    "notes": "Liver biopsy enzyme assay remains gold standard; genetic testing confirms diagnosis."
  },
