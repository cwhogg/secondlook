  "differentialDiagnoses": [
    {
      "diseaseId": "junctional-epidermolysis-bullosa-classic",
      "distinguishingFeatures": [
        "Blistering predominantly on trauma-exposed areas rather than flexural",
        "More extensive mucosal involvement",
        "Different genetic mutations (e.g., COL17A1)"
      ]
    },
    {
      "diseaseId": "epidermolysis-bullosa-simplex",
      "distinguishingFeatures": [
        "Intraepidermal blistering rather than subepidermal",
        "Blistering mainly on hands and feet",
        "Mutations in keratin genes (KRT5, KRT14)"
      ]
    }
  ],
  "redFlags": [
