  "diagnosticCriteria": {
    "formalCriteriaName": "Xp21 Deletion Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of contiguous gene deletion involving the Xp21 region by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical features consistent with Duchenne muscular dystrophy, adrenal hypoplasia congenita, and glycerol kinase deficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Family history of X-linked recessive disorders involving the Xp21 region",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Molecular confirmation of Xp21 deletion plus presence of characteristic clinical features",
    "notes": "Diagnosis relies heavily on genetic testing due to overlapping phenotypes with individual component disorders"
  },
