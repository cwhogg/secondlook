  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Biochemical Diagnostic Criteria for 17-alpha-hydroxylase Deficiency",
    "criteria": [
      {
        "id": "hypertension-hypokalemia",
        "description": "Presence of hypertension with hypokalemia due to mineralocorticoid excess",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-cortisol-and-sex-steroids",
        "description": "Low serum cortisol and sex steroids (androgens and estrogens) with elevated 11-deoxycorticosterone and corticosterone",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the CYP17A1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Sexual infantilism or ambiguous genitalia in genetic males and delayed puberty in genetic females",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypertension with hypokalemia, biochemical evidence of steroidogenesis defects, and confirmation by genetic testing",
    "notes": "Diagnosis requires integration of clinical, biochemical, and genetic data."
  },
