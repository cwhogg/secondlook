    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Sudden onset of severe headache often described as 'thunderclap headache'",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-confirmation",
        "description": "Detection of subarachnoid blood on non-contrast CT scan",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "angiographic-evidence",
        "description": "Identification of cerebral aneurysm on cerebral angiography or CT angiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lumbar-puncture",
        "description": "Xanthochromia in cerebrospinal fluid if CT is negative but suspicion remains high",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Sudden severe headache plus imaging confirmation of subarachnoid hemorrhage and identification of aneurysm on angiography",
    "notes": "Diagnosis is primarily clinical supported by imaging; lumbar puncture is reserved for CT-negative cases with high suspicion."
  },
