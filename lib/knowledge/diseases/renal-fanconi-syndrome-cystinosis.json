{
  "id": "renal-fanconi-syndrome-cystinosis",
  "name": "Renal Fanconi Syndrome Associated with Cystinosis",
  "aliases": [
    "Cystinosis-associated Fanconi Syndrome",
    "Infantile Nephropathic Cystinosis"
  ],
  "icd10Codes": [
    "E72.0"
