  "keyFindings": {
    "laboratory": [
      "Presence of circulating anti-desmoglein 3 and/or desmoglein 1 IgG autoantibodies by ELISA",
      "Elevated inflammatory markers (ESR, CRP) in active disease"
    ],
    "imaging": [
      "Not routinely used for diagnosis"
    ],
    "genetic": [
      "HLA-DR4 and HLA-DR14 associations reported"
    ],
    "other": [
      "Histopathology showing suprabasal acantholysis",
      "Direct immunofluorescence demonstrating intercellular IgG and C3 deposits"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "bullous-pemphigoid",
      "distinguishingFeatures": [
