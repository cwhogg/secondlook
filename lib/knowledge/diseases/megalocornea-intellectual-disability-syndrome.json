  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "No specific biochemical markers identified"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter changes",
      "Echocardiogram to evaluate for cardiac defects"
    ],
    "genetic": [
      "No definitive gene identified; suspected X-linked inheritance pattern"
    ],
    "other": [
      "Ophthalmologic examination confirming corneal enlargement and thinning",
      "Neurodevelopmental assessment confirming intellectual disability"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "megalocornea",
      "distinguishingFeatures": [
        "Isolated megalocornea without intellectual disability",
        "Normal neurodevelopment"
      ]
    },
    {
      "diseaseId": "aniridia-intellectual-disability-syndrome",
      "distinguishingFeatures": [
        "Presence of aniridia (absence of iris)",
        "Distinct genetic mutations (PAX6 gene)"
      ]
    }
  ],
