  "diagnosticCriteria": {
    "formalCriteriaName": "American Thyroid Association (ATA) Guidelines for Medullary Thyroid Carcinoma",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Histological confirmation of medullary thyroid carcinoma with characteristic amyloid stroma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "calcitonin-elevation",
        "description": "Elevated serum calcitonin levels indicative of C-cell tumor activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ret-mutation",
        "description": "Detection of pathogenic RET proto-oncogene mutation in germline or tumor DNA",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "carcinoembryonic-antigen",
        "description": "Elevated serum carcinoembryonic antigen (CEA) levels supporting diagnosis and prognosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation plus elevated serum calcitonin levels",
    "notes": "Genetic testing for RET mutations is recommended for all patients and family members due to hereditary forms."
  },
