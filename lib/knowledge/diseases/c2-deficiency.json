  "diagnosticCriteria": {
    "formalCriteriaName": "Complement Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "low-c2-levels",
        "description": "Demonstration of decreased or absent serum complement component 2 levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-bacterial-infections",
        "description": "History of recurrent infections with encapsulated bacteria such as Streptococcus pneumoniae or Neisseria species",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "autoimmune-features",
        "description": "Presence of autoimmune manifestations, particularly systemic lupus erythematosus-like symptoms",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of complement deficiency or related immunodeficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Low or absent serum C2 levels plus recurrent bacterial infections",
    "notes": "Genetic testing for C2 gene mutations can confirm diagnosis"
  },
