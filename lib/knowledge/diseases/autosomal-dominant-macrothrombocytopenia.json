  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Autosomal Dominant Macrothrombocytopenia",
    "criteria": [
      {
        "id": "macrothrombocytes",
        "description": "Presence of abnormally large platelets (macrothrombocytes) on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thrombocytopenia",
        "description": "Mild to moderate thrombocytopenia with platelet counts typically between 50,000 and 150,000/µL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance pattern",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with platelet formation (e.g., MYH9, ACTN1)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "bleeding-history",
        "description": "History of mild mucocutaneous bleeding symptoms such as epistaxis or easy bruising",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of thrombocytopenia with macrothrombocytes on blood smear plus a compatible family history",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory if clinical and hematological features are consistent."
  },
