  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for SPG77",
    "criteria": [
      {
        "id": "progressive-spasticity",
        "description": "Progressive lower limb spasticity and weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the CAPN1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of hereditary spastic paraplegia",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "Normal or nonspecific brain MRI findings",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or affected siblings consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive lower limb spasticity and weakness plus genetic confirmation of biallelic CAPN1 pathogenic variants",
    "notes": "Diagnosis relies heavily on genetic testing due to overlapping clinical features with other hereditary spastic paraplegias."
  },
