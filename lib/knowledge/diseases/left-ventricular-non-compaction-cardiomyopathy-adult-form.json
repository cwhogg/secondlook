        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-cardiac-abnormalities",
        "description": "No coexisting cardiac abnormalities that could explain the phenotype",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Presence of heart failure symptoms, arrhythmias, or thromboembolic events",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Both major criteria (noncompacted-to-compacted ratio > 2.0 and prominent trabeculations with deep recesses) must be present; supportive criteria aid diagnosis.",
