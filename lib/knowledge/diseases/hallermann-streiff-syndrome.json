  "diagnosticCriteria": {
    "formalCriteriaName": "Hallermann-Streiff Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-anomalies",
        "description": "Characteristic craniofacial features including bird-like facies, micrognathia, and hypoplastic mandible",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ocular-abnormalities",
        "description": "Congenital cataracts and microphthalmia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-abnormalities",
        "description": "Dental anomalies such as hypodontia, enamel hypoplasia, and delayed eruption",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotrichosis",
        "description": "Sparse scalp hair and eyelashes",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skin-thinness",
        "description": "Thin, atrophic skin with visible veins",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: craniofacial anomalies, ocular abnormalities, and dental abnormalities",
    "notes": "Diagnosis is primarily clinical; genetic testing is not definitive as causative gene is unknown."
  },
