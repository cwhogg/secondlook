  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Ulerythema ophryogenesis",
    "criteria": [
      {
        "id": "facial-erythema",
        "description": "Persistent erythematous follicular papules primarily affecting the lateral eyebrows and cheeks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eyebrow-alopecia",
        "description": "Progressive scarring alopecia of the lateral eyebrows",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "follicular-hyperkeratosis",
        "description": "Follicular hyperkeratosis with keratotic papules on the face and sometimes scalp",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-systemic-involvement",
        "description": "No evidence of systemic disease or other dermatological conditions",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: facial erythematous follicular papules, progressive lateral eyebrow alopecia, and follicular hyperkeratosis",
    "notes": "Diagnosis is clinical; biopsy may support but is not mandatory."
  },
