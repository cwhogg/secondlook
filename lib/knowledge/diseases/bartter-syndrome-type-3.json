  "keyFindings": {
    "laboratory": [
      "Hypokalemia with renal potassium wasting",
      "Metabolic alkalosis",
      "Elevated plasma renin and aldosterone",
      "Normal to low serum magnesium (may be low)",
      "Elevated urinary chloride"
    ],
    "imaging": [
      "Nephrocalcinosis on renal ultrasound (occasionally present)"
    ],
    "genetic": [
      "Pathogenic mutations in the CLCNKB gene"
    ],
    "other": [
      "Normal or low blood pressure despite elevated renin-angiotensin-aldosterone system activity"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "bartter-syndrome-type-1",
      "distinguishingFeatures": [
        "Mutations in SLC12A1 gene",
        "More severe antenatal presentation",
        "Polyhydramnios and premature birth more common"
      ]
    },
    {
      "diseaseId": "gitelman-syndrome",
      "distinguishingFeatures": [
        "Mutations in SLC12A3 gene",
        "Hypocalciuria and hypomagnesemia more prominent",
        "Usually presents in adolescence or adulthood"
      ]
    }
  ],
  "redFlags": [
    "Severe hypokalemia causing cardiac arrhythmias",
    "Failure to thrive or growth retardation in children",
    "Progressive nephrocalcinosis leading to renal impairment"
  ],
