      ]
    },
    {
      "diseaseId": "cohen-syndrome",
      "distinguishingFeatures": [
        "Neutropenia",
        "Characteristic facial gestalt with prominent nasal bridge and thick hair",
        "VPS13B gene mutations"
      ]
    }
  ],
