  "keyFindings": {
    "laboratory": [
      "Elevated serum alkaline phosphatase",
      "Normal or mildly elevated liver enzymes",
      "Normal calcium and phosphate levels"
    ],
    "imaging": [
      "Skeletal radiographs showing brachydactyly and other bone abnormalities",
      "Brain MRI may show nonspecific findings related to developmental delay"
    ],
    "genetic": [
      "PIGV (causative)",
      "PIGL (causative)",
      "PIGO (causative)",
      "PGAP2 (causative)",
      "PGAP3 (causative, loss-of-function)",
      "PIGW (causative)",
      "PIGY (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electroencephalogram abnormalities in patients with seizures",
      "Developmental assessments confirming intellectual disability"
    ]
  },
