  "differentialDiagnoses": [
    {
      "diseaseId": "epidermolysis-bullosa",
      "distinguishingFeatures": [
        "Blistering skin lesions appearing after birth rather than congenital absence",
        "Positive family history of blistering disorders",
        "Histopathology showing skin fragility"
      ]
    },
    {
      "diseaseId": "traumatic-skin-loss-neonate",
      "distinguishingFeatures": [
        "History of birth trauma or instrumentation",
        "Irregular lesion margins inconsistent with congenital absence",
        "No associated congenital anomalies"
      ]
    },
    {
      "diseaseId": "nevus-sebaceus",
      "distinguishingFeatures": [
        "Presence of yellowish, hairless plaque rather than absent skin",
        "Lesion develops postnatally",
        "Histology showing sebaceous gland hyperplasia"
      ]
    }
  ],
  "redFlags": [
