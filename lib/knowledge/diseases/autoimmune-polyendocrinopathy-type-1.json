  "keyFindings": {
    "laboratory": [
      "Hypocalcemia with low parathyroid hormone levels",
      "Hyponatremia and hyperkalemia consistent with adrenal insufficiency",
      "Presence of autoantibodies against interferon-ω and interferon-α",
      "Positive anti-adrenal and anti-parathyroid antibodies"
    ],
    "imaging": [
      "Adrenal gland atrophy on CT or MRI",
      "Dental radiographs showing enamel hypoplasia"
    ],
    "genetic": [
      "Biallelic pathogenic mutations in the AIRE gene on chromosome 21"
    ],
    "other": [
      "Histopathology of affected glands showing lymphocytic infiltration",
      "Positive fungal cultures or biopsy confirming chronic candidiasis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autoimmune-polyendocrinopathy-type-2",
      "distinguishingFeatures": [
        "Polygenic inheritance",
        "Later onset (typically adulthood)",
        "Absence of chronic mucocutaneous candidiasis"
      ]
    },
    {
      "diseaseId": "immunodeficiency-with-chronic-candidiasis",
      "distinguishingFeatures": [
        "Primary immunodeficiency with recurrent infections",
        "Lack of endocrine gland failure",
        "Different genetic mutations (e.g., STAT1 gain-of-function)"
      ]
    }
  ],
  "redFlags": [
    "Early onset chronic mucocutaneous candidiasis refractory to antifungal therapy",
    "Multiple endocrine gland failures in a pediatric patient",
    "Family history of autoimmune polyendocrinopathy or consanguinity"
  ],
