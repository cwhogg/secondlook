        "requiredForDiagnosis": true
      },
      {
        "id": "ebv-positivity",
        "description": "Detection of Epstein-Barr virus (EBV) encoded RNA by in situ hybridization",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Involvement of nasal cavity and/or paranasal sinuses with destructive lesions",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation with immunophenotyping and EBV positivity",
    "notes": "Diagnosis requires integration of clinical, histological, immunophenotypic, and virological findings."
  },
