  "diagnosticCriteria": {
    "formalCriteriaName": "Sandhoff Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of both beta-hexosaminidase A and B enzyme activities in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive neurodegeneration with developmental regression starting in infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the HEXB gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing cerebral and cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical neurodegeneration plus confirmed deficiency of beta-hexosaminidase A and B enzyme activities or pathogenic HEXB mutations",
    "notes": "Enzyme assay and genetic testing are gold standards for diagnosis."
  },
