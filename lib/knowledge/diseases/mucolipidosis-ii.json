  "keyFindings": {
    "laboratory": [
      "Elevated lysosomal hydrolases in plasma",
      "Normal or decreased lysosomal enzyme activity in cultured fibroblasts",
      "Presence of inclusion bodies (I-cells) in peripheral blood or fibroblasts"
    ],
    "imaging": [
      "Radiographs showing dysostosis multiplex (e.g., thickened ribs, oar-shaped clavicles, vertebral anomalies)",
      "Cardiac echocardiography demonstrating valvular thickening or cardiomyopathy"
    ],
    "genetic": [
      "Pathogenic variants in GNPTAB gene causing deficiency of N-acetylglucosamine-1-phosphotransferase"
    ],
    "other": [
      "Histopathology showing cytoplasmic inclusion bodies in fibroblasts",
      "Coarse facial features and skeletal abnormalities on clinical examination"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "mucopolysaccharidosis-type-ih",
      "distinguishingFeatures": [
        "Presence of urinary glycosaminoglycan accumulation",
        "Different enzyme deficiency (alpha-L-iduronidase)",
        "Less severe skeletal involvement in early infancy"
      ]
    },
    {
      "diseaseId": "mucolipidosis-iii",
      "distinguishingFeatures": [
        "Later onset and milder clinical course",
        "Partial deficiency of mannose-6-phosphate tagging enzyme",
        "Less severe developmental delay"
      ]
    }
  ],
  "redFlags": [
    "Severe developmental delay in infancy",
    "Progressive skeletal deformities with dysostosis multiplex",
    "Markedly elevated plasma lysosomal enzyme levels"
  ],
