  "diagnosticCriteria": {
    "formalCriteriaName": "Galactosialidosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of combined deficiency of beta-galactosidase and neuraminidase enzyme activities in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic mutations in the CTSA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features including coarse facial features, cherry-red macular spots, and skeletal dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Lysosomal vacuolation and storage material accumulation in biopsy specimens",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Combined demonstration of enzyme deficiency and identification of CTSA gene mutation along with characteristic clinical features",
    "notes": "Molecular genetic testing is confirmatory; enzyme assays are essential for initial diagnosis."
  },
