  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Holoprosencephaly",
    "criteria": [
      {
        "id": "midline-fusion",
        "description": "Failure of the forebrain (prosencephalon) to properly divide into two cerebral hemispheres",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-anomalies",
        "description": "Presence of characteristic midline facial anomalies such as cyclopia, proboscis, or cleft lip/palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "Brain MRI or CT showing absence or incomplete separation of the cerebral hemispheres",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with HPE (e.g., SHH, ZIC2, SIX3)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of midline forebrain fusion confirmed by neuroimaging plus at least one characteristic midline facial anomaly",
    "notes": "Genetic testing supports diagnosis but is not mandatory; clinical presentation and imaging are primary."
  },
