  "differentialDiagnoses": [
    {
      "diseaseId": "oculopharyngeal-muscular-dystrophy",
      "distinguishingFeatures": [
        "Predominant eyelid ptosis and proximal muscle weakness",
        "Later onset typically after 40 years",
        "Genetic testing positive for PABPN1 mutations"
      ]
    },
    {
      "diseaseId": "inclusion-body-myopathy",
      "distinguishingFeatures": [
        "Presence of rimmed vacuoles but more widespread muscle involvement",
        "Often associated with Paget disease of bone and frontotemporal dementia",
        "Genetic mutations in VCP or related genes"
      ]
    }
  ],
