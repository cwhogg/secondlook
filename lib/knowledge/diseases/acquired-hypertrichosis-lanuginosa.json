  "keyFindings": {
    "laboratory": [
      "Elevated tumor markers depending on underlying malignancy",
      "Possible anemia of chronic disease",
      "Hypercalcemia in some cases"
    ],
    "imaging": [
      "Imaging studies (CT, MRI) to identify underlying malignancy",
      "Chest X-ray or abdominal ultrasound abnormalities related to neoplasm"
    ],
    "genetic": [
      "No known genetic mutations associated; condition is acquired"
    ],
    "other": [
      "Skin biopsy showing increased lanugo hair follicles without inflammation",
      "Negative drug screen to exclude medication-induced hypertrichosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-hypertrichosis",
      "distinguishingFeatures": [
        "Onset at birth or early childhood",
        "Generalized thick hair including terminal hair",
        "Family history positive"
      ]
    },
    {
      "diseaseId": "drug-induced-hypertrichosis",
      "distinguishingFeatures": [
        "History of exposure to causative medications (e.g., minoxidil, phenytoin)",
        "Reversible upon drug withdrawal",
        "Usually terminal hair rather than lanugo"
      ]
    },
    {
      "diseaseId": "malnutrition-associated-hypertrichosis",
      "distinguishingFeatures": [
        "Associated with severe malnutrition or anorexia nervosa",
        "Lanugo hair growth but with nutritional deficiency signs",
        "Improves with nutritional rehabilitation"
      ]
    }
  ],
