        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Presence of characteristic craniofacial dysmorphisms including prominent forehead, hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital malformations such as cardiac defects, skeletal abnormalities, or renal anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of trisomy 8q plus at least two major clinical features",
    "notes": "Diagnosis relies heavily on cytogenetic analysis combined with clinical presentation."
