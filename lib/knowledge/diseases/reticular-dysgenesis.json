  "diagnosticCriteria": {
    "formalCriteriaName": "Reticular Dysgenesis Diagnostic Criteria",
    "criteria": [
      {
        "id": "absent-lymphocytes",
        "description": "Profound lymphopenia with absent T and B lymphocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-neutropenia",
        "description": "Severe congenital neutropenia with absolute neutrophil count < 500/µL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ak2-mutation",
        "description": "Biallelic pathogenic mutations in the AK2 gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-hypoplasia",
        "description": "Bone marrow hypoplasia with absence of myeloid precursors",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absent-thymic-shadow",
        "description": "Absent or hypoplastic thymic shadow on chest imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of profound lymphopenia and severe neutropenia combined with confirmed biallelic AK2 mutations",
    "notes": "Diagnosis is confirmed by genetic testing; clinical and laboratory findings support diagnosis."
  },
