  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Elevated creatine kinase may be mild or absent"
    ],
    "imaging": [
      "MRI may show muscle atrophy in distal limbs",
      "Nerve ultrasound may show nerve enlargement in some cases"
    ],
    "genetic": [
      "VCP (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography showing chronic denervation and reinnervation",
      "Nerve conduction studies consistent with axonal sensorimotor neuropathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "autosomal-dominant-charcot-marie-tooth-disease-type-2a",
      "distinguishingFeatures": [
        "MFN2 gene mutations",
        "Earlier onset in childhood",
        "More prominent motor involvement"
      ]
    },
    {
      "diseaseId": "hereditary-sensory-and-autonomic-neuropathy-type-1",
      "distinguishingFeatures": [
        "Predominant sensory loss with ulcerations",
        "Autonomic dysfunction",
        "Different genetic mutations (e.g., SPTLC1)"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of weakness over weeks",
    "Respiratory insufficiency or difficulty breathing",
    "Bulbar symptoms such as dysphagia or dysarthria"
  ],
