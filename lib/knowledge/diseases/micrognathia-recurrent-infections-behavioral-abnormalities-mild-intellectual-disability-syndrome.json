  "keyFindings": {
    "laboratory": [
      "Reduced serum immunoglobulin levels (IgG, IgA, or IgM)",
      "Lymphocyte subset abnormalities",
      "Normal or mildly elevated inflammatory markers"
    ],
    "imaging": [
      "Radiographic evidence of micrognathia on craniofacial imaging",
      "Chest X-ray showing recurrent pneumonia or bronchiectasis"
    ],
    "genetic": [
      "TRIO (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Neuropsychological testing confirming mild intellectual disability",
      "Behavioral assessment documenting psychiatric abnormalities"
    ]
  },
