  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for GM2 Gangliosidosis AB Variant",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of GM2 activator protein activity demonstrated by biochemical assay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive neurodegenerative symptoms including developmental regression and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the GM2A gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-hexosaminidase-deficiency",
        "description": "Normal Hexosaminidase A and B enzyme activity differentiating from Tay-Sachs and Sandhoff disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive neurodegenerative clinical features plus biochemical confirmation of GM2 activator protein deficiency or pathogenic GM2A gene mutations",
    "notes": "Diagnosis requires exclusion of Hexosaminidase A and B deficiencies to differentiate from other GM2 gangliosidoses."
  },
