  "diagnosticCriteria": {
    "formalCriteriaName": "Mitochondrial trifunctional protein deficiency diagnostic criteria",
    "criteria": [
      {
        "id": "enzyme-activity",
        "description": "Reduced mitochondrial trifunctional protein enzyme activity in fibroblasts or lymphocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in HADHA or HADHB genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of hypoketotic hypoglycemia, cardiomyopathy, or skeletal myopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acylcarnitine-profile",
        "description": "Characteristic elevation of long-chain hydroxyacylcarnitines on plasma acylcarnitine profile",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Histological evidence of lipid accumulation in muscle biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced enzyme activity or pathogenic variants in HADHA/HADHB genes plus compatible clinical features",
    "notes": "Molecular genetic testing is considered the gold standard for diagnosis."
  },
