# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (but keep .env.example)
.env*
!.env.example

# embeddings index (generated via: node scripts/embed-diseases.js)
lib/knowledge/embeddings-meta.json
lib/knowledge/embeddings-vectors.bin

# compiled KB (generated via: node scripts/compile-kb.js)
lib/knowledge/diseases-compiled.json

# expansion script artifacts
scripts/expansion-screening.json
scripts/expansion-rejected.json

# Orphanet data files (download via enrich-from-orphanet.js)
scripts/orphanet-data/

# Mondo ontology files (download via build-mondo-assets.mjs).
# Heavy intermediate ontology data lives offline only; the slim derived
# assets needed at runtime (mondo-labels.json, mondo-credited-sets.json)
# are committed in lib/grading/.
scripts/mondo-data/

# Benchmark data: ignore everything in this dir except the source dataset,
# which is bundled into the eval-case serverless function for production.
scripts/benchmark-data/*
!scripts/benchmark-data/en.jsonl

# test case data
/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# macOS Finder metadata
.DS_Store

# backup files created during ad-hoc edits
*.bak
