  "keyFindings": {
    "laboratory": [
      "Elevated cerebrospinal fluid lymphocytes (pleocytosis)",
      "Elevated inflammatory markers (ESR, CRP) during acute phase",
      "Negative infectious and other autoimmune serologies"
    ],
    "imaging": [
      "Fluorescein angiography showing multiple pinpoint leaks",
      "Optical coherence tomography (OCT) demonstrating serous retinal detachments",
      "MRI brain may show meningeal enhancement"
    ],
    "genetic": [
      "TWIST2 (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Audiometry may reveal sensorineural hearing loss",
      "Skin biopsy showing melanocyte loss in depigmented areas"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sympathetic-ophthalmia",
      "distinguishingFeatures": [
        "History of ocular trauma or surgery",
        "Unilateral onset progressing to fellow eye",
        "Absence of systemic neurological or integumentary symptoms"
      ]
    },
    {
      "diseaseId": "sarcoidosis",
      "distinguishingFeatures": [
        "Noncaseating granulomas on biopsy",
        "Pulmonary involvement with hilar lymphadenopathy",
        "Serum ACE elevation"
      ]
    },
    {
      "diseaseId": "multiple-sclerosis",
      "distinguishingFeatures": [
        "Demyelinating lesions on MRI",
        "Optic neuritis without granulomatous uveitis",
        "Predominantly neurological symptoms without integumentary signs"
      ]
    }
  ],
  "redFlags": [
    "Rapid bilateral vision loss",
    "Signs of meningeal irritation (neck stiffness, severe headache)",
    "Sensorineural hearing loss progressing rapidly"
  ],
  "specialistType": [
