    "laboratory": [
      "Renal function tests may show impaired function in cases with renal hypoplasia",
      "Urinalysis may reveal proteinuria or hematuria"
    ],
    "imaging": [
      "Spinal X-rays showing vertebral segmentation defects",
      "Renal ultrasound demonstrating hypoplasia or dysplasia",
      "CT or MRI of temporal bones revealing ossicular chain malformations"
    ],
    "genetic": [
      "CDH11 (causative, loss-of-function)",
      "Autosomal recessive inheritance",
      "X-linked dominant inheritance"
    ],
    "other": [
      "Audiometric testing confirming sensorineural or conductive hearing loss",
      "Physical examination revealing branchial cleft anomalies and preauricular pits"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "branchio-oto-renal-syndrome",
      "distinguishingFeatures": [
        "More prominent renal anomalies including cystic dysplasia",
        "Mutations in EYA1 gene rather than SIX1",
        "More frequent hearing loss and ear malformations"
      ]
    },
    {
      "diseaseId": "goldenhar-syndrome",
      "distinguishingFeatures": [
        "Unilateral facial microsomia and ocular dermoids",
        "Absence of genitourinary malformations",
        "No branchial cleft cysts or fistulas"
      ]
    }
  ],
