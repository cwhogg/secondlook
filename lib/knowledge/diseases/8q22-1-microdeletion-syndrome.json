        "description": "Presence of developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including hypertelorism and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-anomalies",
        "description": "Presence of skeletal abnormalities such as joint contractures or scoliosis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-heart-defects",
        "description": "Identification of congenital cardiac malformations",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed 8q22.1 microdeletion plus developmental delay and at least one characteristic craniofacial or skeletal anomaly",
    "notes": "Diagnosis relies heavily on genetic testing combined with clinical features due to phenotypic variability."
  },
