  "keyFindings": {
    "laboratory": [
      "Mild lymphopenia in some cases",
      "Normal metabolic screening"
    ],
    "imaging": [
      "Echocardiogram showing conotruncal heart defects",
      "Renal ultrasound revealing structural anomalies",
      "Brain MRI may show nonspecific white matter changes"
    ],
    "genetic": [
      "BCR (phenotype modifier)",
      "MAPK1 (phenotype modifier)",
      "CRKL (phenotype modifier)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Neurodevelopmental assessment showing cognitive impairment",
      "Audiological evaluation for hearing loss"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "22q11-2-deletion-syndrome",
      "distinguishingFeatures": [
        "Proximal 22q11.2 deletion rather than distal",
        "More frequent palatal anomalies and immune deficiency",
        "Characteristic facial features differ"
      ]
    },
    {
      "diseaseId": "velo-cardio-facial-syndrome",
      "distinguishingFeatures": [
        "Overlaps with proximal 22q11.2 deletion syndrome",
        "Distinctive palatal and speech abnormalities",
        "Different deletion region confirmed by genetic testing"
      ]
    }
  ],
  "redFlags": [
    "Severe congenital heart defect requiring early intervention",
    "Rapid developmental regression or loss of milestones",
    "Recurrent severe infections suggestive of immunodeficiency"
  ],
