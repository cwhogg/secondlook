  "diagnosticCriteria": {
    "formalCriteriaName": "Idiopathic Uveal Effusion Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "exclusion-of-secondary-causes",
        "description": "Exclusion of secondary causes of uveal effusion such as inflammation, trauma, or neoplasm",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "presence-of-serous-choroidal-effusion",
        "description": "Presence of serous choroidal effusion or detachment confirmed by clinical examination and imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-scleral-thickening-or-inflammation",
        "description": "Absence of scleral thickening or inflammatory signs on imaging and histopathology",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-intraocular-pressure",
        "description": "Normal or mildly elevated intraocular pressure without evidence of glaucoma",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of serous choroidal effusion with exclusion of secondary causes is required; absence of scleral inflammation supports diagnosis.",
    "notes": "Diagnosis is primarily clinical and by exclusion; imaging studies such as ultrasound and fluorescein angiography are essential."
  },
