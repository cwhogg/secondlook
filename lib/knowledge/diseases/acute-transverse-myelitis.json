  "keyFindings": {
    "laboratory": [
      "CSF pleocytosis with elevated protein",
      "Oligoclonal bands usually absent",
      "Negative infectious studies"
    ],
    "imaging": [
      "MRI showing T2 hyperintense lesion spanning ≥3 vertebral segments",
      "Gadolinium enhancement of spinal cord lesion"
    ],
    "genetic": [],
    "other": [
      "Evoked potentials may show delayed conduction",
      "Exclusion of compressive lesions by imaging"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "multiple-sclerosis",
      "distinguishingFeatures": [
        "Multiple discrete CNS lesions on MRI",
        "Oligoclonal bands positive in CSF",
        "Relapsing-remitting course"
      ]
    },
    {
      "diseaseId": "spinal-cord-compression",
      "distinguishingFeatures": [
        "Imaging shows compressive mass or lesion",
        "Rapid improvement after decompression",
        "No inflammatory CSF findings"
      ]
    },
    {
      "diseaseId": "neuromyelitis-optica-spectrum-disorder",
      "distinguishingFeatures": [
        "Presence of anti-AQP4 antibodies",
        "Severe optic neuritis",
        "Longitudinally extensive transverse myelitis"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression to paralysis within hours",
    "Respiratory failure due to high cervical lesion",
    "Loss of sphincter control with urinary retention"
  ],
