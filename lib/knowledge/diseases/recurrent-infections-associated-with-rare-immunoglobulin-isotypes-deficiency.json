  "keyFindings": {
    "laboratory": [
      "Reduced serum levels of specific rare immunoglobulin isotypes (e.g., IgG2, IgG4, IgA subclasses)",
      "Normal or near-normal total IgG concentration",
      "Impaired antibody response to polysaccharide vaccines",
      "Normal complete blood count except during infection episodes"
    ],
    "imaging": [
      "Chest radiographs or CT showing bronchiectasis or recurrent pneumonia",
      "Sinus CT demonstrating chronic sinusitis"
    ],
    "genetic": [
      "IGHG2 (causative)",
      "IGKC (causative)"
    ],
    "other": [
      "Poor response to standard antibiotic therapy without immunoglobulin replacement",
      "Improvement with immunoglobulin replacement therapy in some cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "common-variable-immunodeficiency",
