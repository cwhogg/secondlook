  "keyFindings": {
    "laboratory": [
      "Elevated serum phosphate with normal serum calcium",
      "Normal renal function tests",
      "Elevated serum alkaline phosphatase"
    ],
    "imaging": [
      "Radiographs showing lobulated, well-demarcated periarticular calcified masses",
      "CT or MRI demonstrating soft tissue calcifications without bone involvement"
    ],
    "genetic": [
      "Pathogenic mutations in FGF23, GALNT3, or KL genes confirmed by molecular testing",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology showing calcified amorphous deposits surrounded by fibrous tissue and giant cells"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "secondary-tumoral-calcinosis",
