  "diagnosticCriteria": {
    "formalCriteriaName": "Gollob Criteria for Short QT Syndrome",
    "criteria": [
      {
        "id": "criterion-1",
        "description": "QTc interval ≤ 330 ms on ECG",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-2",
        "description": "Pathogenic mutation in known SQTS-associated genes (e.g., KCNH2, KCNQ1, KCNJ2)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "criterion-3",
        "description": "History of ventricular arrhythmias or sudden cardiac arrest",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "criterion-4",
        "description": "Family history of SQTS or sudden cardiac death at young age",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "QTc interval ≤ 330 ms plus either a pathogenic mutation or clinical history of ventricular arrhythmia/sudden cardiac arrest",
    "notes": "Diagnosis may be supported by family history and genetic testing; clinical context is essential."
  },
