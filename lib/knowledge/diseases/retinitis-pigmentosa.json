  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electrophysiological Diagnostic Criteria for Retinitis Pigmentosa",
    "criteria": [
      {
        "id": "nyctalopia",
        "description": "Progressive night blindness (nyctalopia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "visual-field-constriction",
        "description": "Concentric visual field constriction documented by perimetry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fundus-pigmentary-changes",
        "description": "Characteristic fundus changes including bone spicule pigmentation, attenuated retinal vessels, and optic disc pallor",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroretinogram",
        "description": "Reduced or extinguished rod and cone responses on electroretinogram (ERG)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in known RP-associated genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive night blindness, characteristic fundus changes, and abnormal ERG findings",
    "notes": "Genetic testing supports diagnosis and classification but is not mandatory"
  },
