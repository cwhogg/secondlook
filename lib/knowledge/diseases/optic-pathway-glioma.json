  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Optic Pathway Glioma",
    "criteria": [
      {
        "id": "clinical-vision-loss",
        "description": "Progressive visual impairment or visual field defects consistent with optic pathway involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-mri",
        "description": "MRI evidence of a gliomatous lesion involving the optic nerve, chiasm, or optic tract",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological confirmation of low-grade astrocytoma when biopsy is performed",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurofibromatosis1-association",
        "description": "Presence of Neurofibromatosis type 1 (NF1) features or genetic confirmation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical symptoms plus MRI evidence of optic pathway glioma",
    "notes": "Biopsy is not always required due to characteristic imaging and clinical presentation, especially in NF1 patients."
  },
