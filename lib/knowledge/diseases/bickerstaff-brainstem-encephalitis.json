  "keyFindings": {
    "laboratory": [
      "Elevated protein with normal cell count in cerebrospinal fluid (albuminocytologic dissociation)",
      "Presence of anti-GQ1b IgG antibodies in serum or CSF"
    ],
    "imaging": [
      "MRI brain showing hyperintense lesions in the brainstem on T2-weighted and FLAIR sequences"
    ],
    "genetic": [],
    "other": [
      "Nerve conduction studies may show features of demyelination",
      "Electroencephalogram (EEG) may show diffuse slowing"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "guillain-barre-syndrome",
      "distinguishingFeatures": [
        "Predominantly peripheral neuropathy without altered consciousness",
        "Absence of brainstem lesions on MRI",
        "Less frequent ophthalmoplegia"
      ]
    },
    {
      "diseaseId": "miller-fisher-syndrome",
      "distinguishingFeatures": [
        "Triad of ophthalmoplegia, ataxia, and areflexia without impaired consciousness",
        "Usually no brainstem MRI abnormalities",
        "Anti-GQ1b antibodies positive but no encephalopathy"
      ]
    },
    {
      "diseaseId": "brainstem-stroke",
      "distinguishingFeatures": [
        "Sudden onset focal neurological deficits",
        "MRI shows ischemic infarction rather than inflammatory lesions",
        "No anti-GQ1b antibodies"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression to coma or respiratory failure",
    "New onset seizures in the context of brainstem symptoms",
    "Failure to respond to immunotherapy within expected timeframe"
  ],
