  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Microcephaly-lymphedema-chorioretinopathy syndrome",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Congenital microcephaly with head circumference below the 3rd percentile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphedema",
        "description": "Congenital or early-onset lymphedema, typically affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chorioretinopathy",
        "description": "Bilateral chorioretinal atrophy or scarring detected by ophthalmologic examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Variable intellectual disability or developmental delay",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent nasal bridge and micrognathia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: microcephaly, lymphedema, and chorioretinopathy",
    "notes": "Genetic testing may support diagnosis but is not always available."
  },
