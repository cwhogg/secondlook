  "differentialDiagnoses": [
    {
      "diseaseId": "craniometaphyseal-dysplasia",
      "distinguishingFeatures": [
        "More pronounced metaphyseal involvement",
        "Hyperostosis primarily of craniofacial bones",
        "Possible cranial nerve compression symptoms"
      ]
    },
    {
      "diseaseId": "osteopetrosis",
      "distinguishingFeatures": [
        "Generalized increased bone density",
        "Hematological abnormalities (anemia, thrombocytopenia)",
        "Frequent fractures and bone marrow failure"
      ]
    },
    {
      "diseaseId": "cleidocranial-dysplasia",
      "distinguishingFeatures": [
        "Clavicular hypoplasia or aplasia",
        "Delayed closure of cranial sutures without wormian bones prominence",
        "Dental anomalies with supernumerary teeth"
      ]
    }
  ],
