  "diagnosticCriteria": {
    "formalCriteriaName": "Alpha-thalassemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "microcytic-anemia",
        "description": "Presence of microcytic hypochromic anemia with low mean corpuscular volume (MCV)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemoglobin-electrophoresis",
        "description": "Hemoglobin electrophoresis showing decreased or absent alpha-globin chains and presence of HbH or Hb Bart's",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Detection of deletions or mutations in alpha-globin genes (HBA1 and HBA2) by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of alpha-thalassemia or related hemoglobinopathies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "reticulocytosis",
        "description": "Elevated reticulocyte count indicating compensatory erythropoiesis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microcytic anemia plus confirmatory hemoglobin electrophoresis or genetic testing",
    "notes": "Diagnosis may require combination of hematological, electrophoretic, and molecular genetic findings."
  },
