  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Neonatal Adrenoleukodystrophy",
    "criteria": [
      {
        "id": "elevated-vlcfa",
        "description": "Elevated very long chain fatty acids (VLCFA) in plasma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Early onset neurological deterioration including hypotonia and seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Pathogenic mutation in the ABCD1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "adrenal-insufficiency",
        "description": "Evidence of primary adrenal insufficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "brain-mri",
        "description": "Characteristic demyelination pattern on brain MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated VLCFA, clinical neurological symptoms consistent with neonatal onset, and identification of pathogenic ABCD1 mutation",
    "notes": "Diagnosis may be supported by adrenal function testing and neuroimaging findings."
  },
