  "diagnosticCriteria": {
    "formalCriteriaName": "Comprehensive Diagnostic Criteria for IgG4-Related Disease",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Characteristic histopathological features including dense lymphoplasmacytic infiltrate rich in IgG4-positive plasma cells, storiform fibrosis, and obliterative phlebitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "serum-igg4",
        "description": "Elevated serum IgG4 concentration (>135 mg/dL)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging",
        "description": "Imaging evidence of retroperitoneal soft tissue mass or fibrosis encasing ureters or vessels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-steroids",
        "description": "Clinical and radiological improvement with corticosteroid therapy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic histopathology plus either elevated serum IgG4 or typical imaging findings",
    "notes": "Diagnosis requires exclusion of malignancy and other causes of retroperitoneal fibrosis"
  },
