  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Spinocerebellar Ataxias",
    "criteria": [
      {
        "id": "progressive-cerebellar-ataxia",
        "description": "Progressive cerebellar ataxia with gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "heterozygous-elp2-mutation",
        "description": "Identification of heterozygous pathogenic mutation in the ELP2 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-ataxia-causes",
        "description": "Exclusion of other acquired or genetic causes of ataxia",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "retinopathy",
        "description": "Presence of pigmentary maculopathy or retinal degeneration",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "mild-pyramidal-signs",
        "description": "Occasional mild pyramidal tract signs such as hyperreflexia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive cerebellar ataxia plus identification of a pathogenic ELP2 mutation with exclusion of other causes",
    "notes": "Genetic testing is essential for definitive diagnosis; retinal examination may support clinical suspicion."
  },
