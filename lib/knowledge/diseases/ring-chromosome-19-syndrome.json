        "description": "Characteristic craniofacial dysmorphic features including microcephaly and facial asymmetry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or failure to thrive",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or skeletal abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of ring chromosome 19 plus at least two major clinical features",
    "notes": "Diagnosis relies heavily on cytogenetic analysis; clinical features support but are variable."
  },
