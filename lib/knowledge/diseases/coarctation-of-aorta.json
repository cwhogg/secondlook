  "keyFindings": {
    "laboratory": [
      "Elevated serum brain natriuretic peptide (BNP) in heart failure",
      "Normal routine blood tests"
    ],
    "imaging": [
      "Echocardiography showing aortic narrowing and left ventricular hypertrophy",
      "MRI or CT angiography demonstrating discrete aortic coarctation",
      "Chest X-ray showing rib notching due to collateral circulation"
    ],
    "genetic": [
      "Association with Turner syndrome (45,X) and other chromosomal abnormalities",
      "NOTCH1 gene mutations reported in some familial cases"
    ],
