  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and genetic diagnosis criteria for Williams-Beuren Syndrome",
    "criteria": [
      {
        "id": "facial-features",
        "description": "Characteristic facial features including broad forehead, periorbital fullness, stellate iris pattern, full cheeks, and wide mouth with a prominent chin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiovascular-anomaly",
        "description": "Presence of supravalvular aortic stenosis or other arterial stenoses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Detection of microdeletion at chromosome 7q11.23 by FISH or microarray",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cognitive-profile",
        "description": "Distinctive cognitive profile with mild to moderate intellectual disability and strong verbal abilities",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-phenotype",
        "description": "Overfriendly personality and heightened sociability",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic facial features, cardiovascular anomaly, and genetic confirmation of 7q11.23 microdeletion",
    "notes": "Diagnosis is confirmed by genetic testing; clinical features support diagnosis especially in infancy and early childhood."
  },
