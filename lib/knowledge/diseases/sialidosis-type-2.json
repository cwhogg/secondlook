  "keyFindings": {
    "laboratory": [
      "Reduced neuraminidase enzyme activity in leukocytes or fibroblasts",
      "Elevated urinary sialylated oligosaccharides"
    ],
    "imaging": [
      "Skeletal X-rays showing dysostosis multiplex",
      "Brain MRI may show cerebral atrophy"
    ],
    "genetic": [
      "Pathogenic mutations in the NEU1 gene on chromosome 6p21.3",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electron microscopy revealing lysosomal storage material in fibroblasts"
    ]
  },
