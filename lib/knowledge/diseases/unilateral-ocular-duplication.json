  "diagnosticCriteria": {
    "formalCriteriaName": "Unilateral Ocular Duplication Diagnostic Criteria",
    "criteria": [
      {
        "id": "ocular-duplication-visualization",
        "description": "Presence of two distinct ocular globes on one side confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anatomical-separation",
        "description": "Anatomical separation of duplicated eyes with independent extraocular muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-contralateral-duplication",
        "description": "No duplication of ocular structures on the contralateral side",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "associated-craniofacial-anomalies",
        "description": "Presence of craniofacial malformations such as hypertelorism or midline defects",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of two distinct ocular globes on one side with anatomical separation confirmed by imaging",
    "notes": "Diagnosis is primarily clinical and radiological; genetic testing may assist in differential diagnosis."
  },
