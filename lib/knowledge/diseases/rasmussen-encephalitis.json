  "diagnosticCriteria": {
    "formalCriteriaName": "Bien Diagnostic Criteria for Rasmussen Encephalitis",
    "criteria": [
      {
        "id": "unilateral-seizures",
        "description": "Focal seizures, often epilepsia partialis continua, affecting one hemisphere",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "unilateral-atrophy",
        "description": "Progressive unilateral hemispheric atrophy on neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "T-cell dominated encephalitis with microglial nodules on brain biopsy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-deterioration",
        "description": "Progressive neurological deficits including hemiparesis and cognitive decline",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-other-causes",
        "description": "Exclusion of other causes such as infection, tumor, or vascular disease",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive focal seizures with unilateral hemispheric atrophy on imaging, plus exclusion of other causes",
    "notes": "Brain biopsy is supportive but not always required if clinical and imaging criteria are met"
  },
