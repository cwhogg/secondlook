  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible elevated creatine kinase if muscle involvement is severe"
    ],
    "imaging": [
      "X-ray showing joint contractures and bone abnormalities",
      "MRI brain may show delayed myelination or structural abnormalities",
      "Airway imaging demonstrating glossoptosis and mandibular hypoplasia"
    ],
    "genetic": [
      "No single gene identified; possible heterogeneous genetic causes",
      "Genetic testing may reveal mutations in genes associated with Pierre Robin sequence or arthrogryposis"
    ],
    "other": [
      "Polysomnography to assess severity of airway obstruction",
      "Developmental assessments for cognitive and motor delay"
    ]
  },
