  "diagnosticCriteria": {
    "formalCriteriaName": "Rotor Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-conjugated-hyperbilirubinemia",
        "description": "Chronic, predominantly conjugated hyperbilirubinemia without evidence of hemolysis or liver enzyme elevation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-hepatic-function-tests",
        "description": "Normal liver function tests aside from elevated bilirubin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-hemolysis",
        "description": "No signs of hemolysis or other causes of hyperbilirubinemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired-hepatocellular-bilirubin-uptake",
        "description": "Demonstration of impaired hepatic bilirubin uptake on specialized tests (e.g., bromsulphthalein clearance)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in SLCO1B1 and SLCO1B3 genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic conjugated hyperbilirubinemia with normal liver enzymes and absence of hemolysis",
    "notes": "Diagnosis is often confirmed by exclusion and genetic testing"
  },
