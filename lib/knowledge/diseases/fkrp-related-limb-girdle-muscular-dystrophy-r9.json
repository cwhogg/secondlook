  "differentialDiagnoses": [
    {
      "diseaseId": "dysferlinopathy-lgmd2b",
      "distinguishingFeatures": [
        "Later onset in some cases",
        "Absent dysferlin protein on muscle biopsy",
        "Different genetic mutation (DYSF gene)"
      ]
    },
    {
      "diseaseId": "calpainopathy-lgmd2a",
      "distinguishingFeatures": [
        "Predominantly affects proximal muscles but with earlier contractures",
        "Calpain-3 deficiency on muscle biopsy",
        "Mutations in CAPN3 gene"
      ]
    },
    {
      "diseaseId": "dystroglycanopathies-other-than-fkrp",
      "distinguishingFeatures": [
        "Similar alpha-dystroglycan abnormalities but different gene mutations (e.g. POMT1, POMT2)",
        "Often associated with brain malformations or eye abnormalities"
      ]
    }
  ],
