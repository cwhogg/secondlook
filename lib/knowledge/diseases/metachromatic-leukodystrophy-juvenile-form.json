  "diagnosticCriteria": {
    "formalCriteriaName": "Metachromatic Leukodystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "ar-sa-deficiency",
        "description": "Deficiency of arylsulfatase A enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the ARSA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mri-leukodystrophy",
        "description": "Characteristic symmetric demyelination pattern on brain MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Progressive neurological deterioration with motor and cognitive decline",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of arylsulfatase A deficiency or pathogenic ARSA mutations plus characteristic MRI findings",
    "notes": "Pseudodeficiency alleles must be excluded to confirm diagnosis"
  },
