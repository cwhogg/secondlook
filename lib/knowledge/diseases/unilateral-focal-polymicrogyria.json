  "diagnosticCriteria": {
    "formalCriteriaName": "Neuroimaging-based diagnostic criteria for polymicrogyria",
    "criteria": [
      {
        "id": "imaging-evidence",
        "description": "MRI demonstrating abnormal cortical lamination with excessive small gyri localized unilaterally",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-seizures",
        "description": "Presence of focal seizures consistent with cortical malformation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-deficits",
        "description": "Focal neurological deficits corresponding to the affected hemisphere",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "MRI evidence of unilateral focal polymicrogyria plus at least one clinical feature such as focal seizures or neurological deficits",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
