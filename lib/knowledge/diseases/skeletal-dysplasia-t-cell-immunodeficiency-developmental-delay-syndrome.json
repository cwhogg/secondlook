    ],
    "imaging": [
      "Metaphyseal irregularities and dysplasia on X-ray",
      "Osteopenia on bone density scans"
    ],
    "genetic": [
      "EXTL3 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Developmental assessment confirming global delay",
      "Exclusion of other immunodeficiency syndromes"
    ]
  },
