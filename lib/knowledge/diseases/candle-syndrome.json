  "keyFindings": {
    "laboratory": [
      "Elevated type I interferon signature",
      "Elevated acute phase reactants (CRP, ESR)",
      "Anemia and mild cytopenias"
    ],
    "imaging": [
      "MRI showing lipodystrophy and muscle inflammation",
      "Chest imaging may reveal pulmonary hypertension"
    ],
    "genetic": [
      "CUX2 (causative)",
