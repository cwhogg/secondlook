  "keyFindings": {
    "laboratory": [
      "Low plasma free carnitine concentration",
      "Hypoketotic hypoglycemia during metabolic crisis",
      "Elevated liver transaminases",
      "Elevated creatine kinase"
    ],
    "imaging": [
      "Echocardiogram showing dilated or hypertrophic cardiomyopathy",
      "MRI brain may show nonspecific changes in severe cases"
    ],
    "genetic": [
      "Pathogenic variants in SLC22A5 gene encoding OCTN2 carnitine transporter"
    ],
    "other": [
      "Reduced carnitine uptake in cultured fibroblasts or lymphocytes",
      "Positive response to oral carnitine supplementation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "medium-chain-acyl-coa-dehydrogenase-deficiency",
      "distinguishingFeatures": [
        "Normal plasma carnitine levels",
        "Deficiency in MCAD enzyme activity",
        "Different genetic mutations (ACADM gene)"
      ]
    },
    {
      "diseaseId": "multiple-acyl-coa-dehydrogenase-deficiency",
      "distinguishingFeatures": [
        "Elevated multiple acylcarnitines on metabolic screening",
        "Riboflavin-responsive in some cases",
        "Different genetic causes (ETFA, ETFB, ETFDH genes)"
      ]
    }
  ],
  "redFlags": [
