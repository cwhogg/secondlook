  "keyFindings": {
    "laboratory": [
      "Elevated urinary 3-hydroxy-3-methylglutaric acid and related metabolites",
      "Hypoketotic hypoglycemia during metabolic crises",
      "Metabolic acidosis with elevated anion gap",
      "Hyperammonemia in some cases"
    ],
    "imaging": [
      "Brain MRI may show white matter changes or cerebral atrophy after repeated crises",
      "Echocardiography may reveal cardiomyopathy in rare cases"
    ],
    "genetic": [
      "HMGCL (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Reduced 3-hydroxy-3-methylglutaryl-CoA lyase enzyme activity in liver or fibroblasts"
    ]
  },
