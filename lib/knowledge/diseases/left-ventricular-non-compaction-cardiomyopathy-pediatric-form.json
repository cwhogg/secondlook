  "keyFindings": {
    "laboratory": [
      "Elevated brain natriuretic peptide (BNP) or NT-proBNP in heart failure",
      "Possible elevated troponin in myocardial injury"
    ],
    "imaging": [
      "Echocardiography showing prominent trabeculations and non-compacted to compacted myocardium ratio >2:1",
      "Cardiac MRI confirming trabeculations and recesses with delayed gadolinium enhancement",
      "Color Doppler demonstrating blood flow within recesses"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electrocardiogram abnormalities including ventricular arrhythmias, conduction delays",
      "Holter monitoring for arrhythmia detection"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dilated-cardiomyopathy-pediatric",
      "distinguishingFeatures": [
        "Absence of prominent trabeculations",
        "More uniform ventricular dilation",
        "Different genetic mutations"
      ]
    },
    {
      "diseaseId": "hypertrophic-cardiomyopathy-pediatric",
      "distinguishingFeatures": [
        "Asymmetric septal hypertrophy",
        "No deep intertrabecular recesses",
        "Different echocardiographic appearance"
      ]
    }
  ],
  "redFlags": [
    "Sudden onset of syncope or presyncope",
    "Ventricular tachyarrhythmias on ECG or Holter",
    "Rapid progression of heart failure symptoms"
  ],
