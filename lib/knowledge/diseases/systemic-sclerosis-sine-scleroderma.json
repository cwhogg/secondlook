    "laboratory": [
      "Positive anti-centromere antibodies",
      "Positive anti-topoisomerase I (Scl-70) antibodies",
      "Positive anti-RNA polymerase III antibodies",
      "Elevated ESR and CRP (variable)"
    ],
    "imaging": [
      "High-resolution CT showing interstitial lung disease",
      "Echocardiogram indicating pulmonary hypertension",
      "Nailfold capillaroscopy showing capillary dropout and dilatation"
    ],
    "genetic": [
      "No single causative gene; HLA associations (e.g., HLA-DRB1*11)"
    ],
    "other": [
      "Abnormal pulmonary function tests with restrictive pattern",
      "Renal biopsy in scleroderma renal crisis showing thrombotic microangiopathy"
    ]
