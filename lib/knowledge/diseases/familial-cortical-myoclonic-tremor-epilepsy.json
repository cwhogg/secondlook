  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Familial Cortical Myoclonic Tremor with Epilepsy",
    "criteria": [
      {
        "id": "cortical-myoclonic-tremor",
        "description": "Presence of adult-onset cortical myoclonic tremor confirmed by electrophysiological studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "epilepsy-history",
        "description": "History of adult-onset epilepsy with generalized or focal seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiological-findings",
        "description": "Electroencephalogram (EEG) showing cortical reflex myoclonus and epileptiform discharges",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-neuroimaging",
        "description": "Normal brain MRI excluding structural lesions",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (cortical myoclonic tremor, epilepsy history, and positive family history) must be met",
    "notes": "Electrophysiological confirmation is important to differentiate from other myoclonic disorders"
  },
