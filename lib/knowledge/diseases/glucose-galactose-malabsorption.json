  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnosis of Glucose-Galactose Malabsorption",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Severe watery diarrhea and dehydration starting in the neonatal period upon ingestion of glucose or galactose-containing feeds",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oral-glucose-galactose-challenge",
        "description": "Resolution of diarrhea upon removal of glucose and galactose from the diet",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the SLC5A1 gene encoding the sodium/glucose cotransporter 1 (SGLT1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intestinal-biopsy",
        "description": "Normal intestinal mucosa on biopsy excluding other causes of malabsorption",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of neonatal onset diarrhea triggered by glucose/galactose ingestion with symptom resolution on dietary exclusion plus identification of pathogenic SLC5A1 mutations",
    "notes": "Genetic confirmation is considered definitive; clinical response to dietary modification is critical for diagnosis."
  },
