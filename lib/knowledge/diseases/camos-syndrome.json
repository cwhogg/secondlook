        "requiredForDiagnosis": true
      },
      {
        "id": "multisystem-involvement",
        "description": "Involvement of at least two organ systems such as musculoskeletal and cardiovascular abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variant in CAMOS-associated gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Presence of global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria: characteristic craniofacial anomalies and multisystem involvement",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory."
