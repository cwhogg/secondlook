  "diagnosticCriteria": {
    "formalCriteriaName": "Landy and Donnai Diagnostic Criteria for Incontinentia Pigmenti",
    "criteria": [
      {
        "id": "blistering-stage",
        "description": "Presence of vesicular and bullous lesions in the neonatal period",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "verrucous-stage",
        "description": "Development of verrucous hyperkeratotic lesions following blistering stage",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hyperpigmentation-stage",
        "description": "Linear or whorled hyperpigmented streaks appearing after verrucous lesions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-abnormalities",
        "description": "Presence of delayed dentition, hypodontia, or conical teeth",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least three major criteria including characteristic skin lesion stages",
    "notes": "Diagnosis is primarily clinical; genetic testing for NEMO/IKBKG mutations can support diagnosis"
  },
