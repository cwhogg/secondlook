{
  "id": "fazio-londe-syndrome",
  "name": "Fazio-Londe Syndrome",
  "aliases": [
    "Progressive Bulbar Palsy of Childhood",
    "Juvenile Bulbar Palsy"
  ],
  "icd10Codes": [
    "G12.2"
  ],
  "omimId": "211360",
  "orphanetId": "284",
  "prevalence": {
    "estimate": "1 in 1,000,000",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 1,
      "max": 15,
      "peak": 5
    },
    "sexPredilection": "equal",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Fazio-Londe Syndrome",
    "criteria": [
      {
        "id": "progressive-bulbar-palsy",
        "description": "Progressive weakness of bulbar muscles leading to dysarthria and dysphagia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-sensory-involvement",
        "description": "No sensory nerve involvement or sensory deficits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "childhood-onset",
        "description": "Onset of symptoms during childhood or adolescence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyography showing motor neuron degeneration without sensory abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in SLC52A3 or related genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive bulbar palsy in childhood without sensory involvement, supported by EMG and/or genetic testing",
    "notes": "Diagnosis is clinical but supported by electrophysiological and genetic studies; exclusion of other motor neuron diseases is essential."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Progressive bulbar muscle weakness",
        "frequency": 0.95,
        "bodySystem": "neurological",
        "notes": "Leads to dysarthria and dysphagia"
      },
      {
        "symptomName": "Dysphagia due to bulbar palsy",
        "frequency": 0.9,
        "bodySystem": "gastrointestinal",
        "notes": "Difficulty swallowing is a hallmark"
      },
      {
        "symptomName": "Dysarthria",
        "frequency": 0.85,
        "bodySystem": "neurological",
        "notes": "Speech impairment from bulbar muscle involvement"
      }
    ],
    "common": [
      {
        "symptomName": "Tongue fasciculations",
        "frequency": 0.75,
        "bodySystem": "neurological",
        "notes": "Visible muscle twitching of the tongue"
      },
      {
        "symptomName": "Respiratory muscle weakness",
        "frequency": 0.7,
        "bodySystem": "respiratory",
        "notes": "May lead to respiratory insufficiency"
      },
      {
        "symptomName": "Facial muscle weakness",
        "frequency": 0.65,
        "bodySystem": "neurological",
        "notes": "Involvement of facial nerve muscles"
      },
      {
        "symptomName": "Weight loss due to feeding difficulties",
        "frequency": 0.6,
        "bodySystem": "constitutional",
        "notes": "Secondary to dysphagia"
      }
    ],
    "occasional": [
      {
        "symptomName": "Limb weakness",
        "frequency": 0.4,
        "bodySystem": "musculoskeletal",
        "notes": "May occur in advanced stages"
      },
      {
        "symptomName": "Sialorrhea (excessive salivation)",
        "frequency": 0.35,
        "bodySystem": "gastrointestinal",
        "notes": "Due to impaired swallowing"
      },
      {
        "symptomName": "Hoarseness",
        "frequency": 0.3,
        "bodySystem": "otolaryngological",
        "notes": "Resulting from vocal cord involvement"
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.25,
        "bodySystem": "constitutional",
        "notes": "Generalized tiredness"
      }
    ],
    "rare": [
      {
        "symptomName": "Respiratory failure",
        "frequency": 0.08,
        "bodySystem": "respiratory",
        "notes": "May require ventilatory support"
      },
      {
        "symptomName": "Aspiration pneumonia",
        "frequency": 0.07,
        "bodySystem": "respiratory",
        "notes": "Secondary to dysphagia"
      },
      {
        "symptomName": "Cognitive impairment",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Uncommon, may indicate alternative diagnosis"
      }
    ]
  },
  "systemsAffected": [
    "neurological",
    "gastrointestinal",
    "respiratory",
    "musculoskeletal",
    "constitutional",
    "otolaryngological"
  ],
  "keyFindings": {
    "laboratory": [
      "Normal sensory nerve conduction studies",
      "Elevated creatine kinase in some cases"
    ],
    "imaging": [
      "MRI brain typically normal or nonspecific",
      "No structural abnormalities in bulbar region"
    ],
    "genetic": [
      "Mutations in SLC52A3 gene (riboflavin transporter deficiency)",
      "Other related gene mutations (e.g., SLC52A2)"
    ],
    "other": [
      "Electromyography showing denervation and motor neuron loss",
      "Absence of sensory nerve involvement"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "juvenile-amyotrophic-lateral-sclerosis",
      "distinguishingFeatures": [
        "Involvement of both upper and lower motor neurons",
        "Possible sensory involvement absent",
        "Later onset compared to Fazio-Londe"
      ]
    },
    {
      "diseaseId": "brown-vialetto-van-laere-syndrome",
      "distinguishingFeatures": [
        "Similar bulbar palsy with sensorineural deafness",
        "Associated with riboflavin transporter mutations",
        "Hearing loss distinguishes from Fazio-Londe"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of bulbar weakness",
    "Onset before age 15 with no sensory symptoms",
    "Respiratory distress or failure"
  ],
  "specialistType": [
    "Neurologist",
    "Pediatric Neurologist",
    "Geneticist"
  ],
  "lastUpdated": "2026-02-17",
  "references": [
