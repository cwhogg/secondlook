  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for EOPE-SASM Syndrome",
    "criteria": [
      {
        "id": "criterion-encephalopathy",
        "description": "Early-onset progressive encephalopathy with developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-spastic-ataxia",
        "description": "Presence of spasticity combined with cerebellar ataxia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-distal-sma",
        "description": "Distal spinal muscular atrophy evidenced by distal muscle weakness and atrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-genetic-confirmation",
        "description": "Identification of pathogenic variants in associated gene(s)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "criterion-neuroimaging",
        "description": "Brain MRI showing cerebellar atrophy and white matter abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (early-onset progressive encephalopathy, spastic ataxia, and distal spinal muscular atrophy) with supportive findings from genetic testing or neuroimaging.",
    "notes": "Genetic testing is recommended to confirm diagnosis and exclude phenotypically overlapping disorders."
  },
