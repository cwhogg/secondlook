        "Earlier onset with rapid progression"
      ]
    },
    {
      "diseaseId": "renal-tubular-acidosis-type-1",
      "distinguishingFeatures": [
        "Isolated renal tubular acidosis without bone abnormalities",
        "Normal bone density on imaging"
      ]
    },
    {
      "diseaseId": "pyknodysostosis",
      "distinguishingFeatures": [
        "Short stature with acro-osteolysis",
        "Characteristic facial features",
        "Normal renal function"
      ]
    }
  ],
