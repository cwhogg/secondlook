  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible hypothyroidism on thyroid function tests"
    ],
    "imaging": [
      "Brain MRI showing microcephaly with simplified gyral pattern",
      "Hypoplasia or agenesis of corpus callosum",
      "Ocular ultrasound confirming microphthalmia"
    ],
    "genetic": [
      "RAB3GAP1 (causative, loss-of-function)",
      "RAB3GAP2 (causative, loss-of-function)",
      "RAB18 (causative, loss-of-function)",
      "TBC1D20 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Clinical examination revealing hypoplastic genitalia",
      "Developmental assessment confirming severe intellectual disability"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "warburg-micro-syndrome",
