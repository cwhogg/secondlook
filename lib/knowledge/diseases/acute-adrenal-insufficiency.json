  "keyFindings": {
    "laboratory": [
      "Low serum cortisol levels during crisis",
      "Elevated plasma ACTH levels",
      "Hyponatremia and hyperkalemia",
      "Hypoglycemia",
      "Metabolic acidosis"
    ],
    "imaging": [
      "Adrenal gland imaging may show atrophy or hemorrhage in some cases"
    ],
    "genetic": [
      "Mutations in genes causing primary adrenal insufficiency (e.g., autoimmune polyglandular syndrome genes) may predispose",
      "Autosomal recessive inheritance",
      "X-linked dominant inheritance"
    ],
    "other": [
      "Rapid clinical improvement after administration of intravenous hydrocortisone and fluids"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "septic-shock",
