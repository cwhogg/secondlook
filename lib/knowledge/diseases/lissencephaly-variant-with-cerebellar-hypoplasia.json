  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Lissencephaly Variant with Cerebellar Hypoplasia",
    "criteria": [
      {
        "id": "neuronal-migration-defect",
        "description": "Evidence of abnormal neuronal migration resulting in smooth cerebral cortex (agyria or pachygyria)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-hypoplasia",
        "description": "Underdevelopment or hypoplasia of the cerebellum confirmed by neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "severe-neurological-deficits",
        "description": "Presence of severe developmental delay and neurological impairment including hypotonia and seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with Lissencephaly variant with cerebellar hypoplasia (e.g., RELN, VLDLR)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (neuronal migration defect and cerebellar hypoplasia) plus clinical neurological deficits",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory."
  },
