  "diagnosticCriteria": {
    "formalCriteriaName": "Oculoauriculofrontonasal Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "ocular-malformations",
        "description": "Presence of hypertelorism and telecanthus with ocular anomalies such as coloboma or microphthalmia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "auricular-anomalies",
        "description": "Malformed or low-set ears with preauricular tags or pits",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "frontonasal-dysplasia",
        "description": "Midline frontonasal defects including broad nasal root and frontal bossing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Additional craniofacial abnormalities such as cleft lip/palate or nasal clefts",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: ocular malformations, auricular anomalies, and frontonasal dysplasia",
    "notes": "Genetic testing may support diagnosis but is not definitive due to limited data."
  },
