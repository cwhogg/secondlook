  "diagnosticCriteria": {
    "formalCriteriaName": "Pelvis-Shoulder Dysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "pelvic-dysmorphism",
        "description": "Radiographic evidence of abnormal pelvic bone morphology including hypoplasia or dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "scapular-hypoplasia",
        "description": "Clinical or imaging confirmation of scapular hypoplasia or malformation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-length-discrepancy",
        "description": "Presence of limb length discrepancy affecting upper and/or lower limbs",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "restricted-shoulder-mobility",
        "description": "Reduced range of motion in shoulder joints due to structural abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both major criteria (pelvic dysmorphism and scapular hypoplasia) confirmed by clinical and radiographic evaluation",
    "notes": "Genetic testing may support diagnosis but is not definitive; diagnosis primarily clinical and radiological"
  },
