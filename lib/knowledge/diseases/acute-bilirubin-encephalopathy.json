  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Laboratory Diagnostic Criteria for Acute Bilirubin Encephalopathy",
    "criteria": [
      {
        "id": "hyperbilirubinemia",
        "description": "Serum total bilirubin level significantly elevated above age-specific thresholds",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-signs",
        "description": "Presence of characteristic neurological signs such as lethargy, hypotonia, and high-pitched cry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of neonatal encephalopathy such as infection or hypoxic-ischemic injury",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-support",
        "description": "Neuroimaging findings consistent with bilirubin toxicity (e.g., MRI showing basal ganglia involvement)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated serum bilirubin above threshold plus characteristic neurological signs with exclusion of other causes",
    "notes": "Diagnosis is primarily clinical supported by laboratory and imaging findings; early recognition is critical."
  },
