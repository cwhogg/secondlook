  "keyFindings": {
    "laboratory": [
      "Elevated interferon-alpha levels in cerebrospinal fluid",
      "Chronic lymphocytosis in cerebrospinal fluid",
      "Mild thrombocytopenia or anemia in some cases"
    ],
    "imaging": [
      "Basal ganglia and deep white matter intracranial calcifications on CT",
      "White matter abnormalities and cerebral atrophy on MRI"
    ],
    "genetic": [
      "PTS (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Presence of chilblain-like skin lesions on acral surfaces",
      "Elevated interferon-stimulated gene expression signature in blood"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-infections",
      "distinguishingFeatures": [
        "History of maternal infection",
        "Widespread intracranial calcifications including cortex",
        "Positive infectious serologies"
      ]
    },
    {
      "diseaseId": "cerebral-palsy",
      "distinguishingFeatures": [
        "Non-progressive neurological deficits",
        "Absence of intracranial calcifications",
        "No interferonopathy or skin lesions"
      ]
    },
    {
      "diseaseId": "chilblain-lupus",
      "distinguishingFeatures": [
        "Autoimmune serologies positive",
        "Later onset of skin lesions",
        "No basal ganglia calcifications"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive neurological decline in infancy",
    "Presence of basal ganglia calcifications on neuroimaging",
    "Chilblain-like skin lesions in a neonate or infant"
  ],
