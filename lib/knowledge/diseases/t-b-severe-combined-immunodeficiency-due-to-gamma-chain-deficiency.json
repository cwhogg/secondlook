  "diagnosticCriteria": {
    "formalCriteriaName": "ESID Diagnostic Criteria for SCID",
    "criteria": [
      {
        "id": "lymphopenia",
        "description": "Profound T-cell lymphopenia with absent or very low CD3+ T cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bcell_absence",
        "description": "Absent or markedly reduced B cells (CD19+ or CD20+)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "il2rg_mutation",
        "description": "Pathogenic mutation in the IL2RG gene encoding the common gamma chain",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "impaired_lymphocyte_function",
        "description": "Absent or severely impaired T-cell proliferative response to mitogens",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical_presentation",
        "description": "Severe, recurrent infections in early infancy including opportunistic infections",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of profound T-cell lymphopenia and absent B cells with confirmed pathogenic IL2RG mutation",
    "notes": "Genetic confirmation is critical for definitive diagnosis; newborn screening may detect T-cell receptor excision circles (TRECs) deficiency."
  },
