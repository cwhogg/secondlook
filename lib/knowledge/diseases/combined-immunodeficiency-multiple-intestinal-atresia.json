  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for CID-MIA",
    "criteria": [
      {
        "id": "intestinal-atresia",
        "description": "Presence of multiple intestinal atresias confirmed by imaging or surgery",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "combined-immunodeficiency",
        "description": "Laboratory evidence of combined immunodeficiency including T-cell and B-cell dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in genes associated with CID-MIA (e.g., TTC7A)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-infections",
        "description": "History of recurrent severe infections in early infancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "failure-to-thrive",
        "description": "Clinical evidence of failure to thrive or malnutrition",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple intestinal atresias plus laboratory-confirmed combined immunodeficiency and/or pathogenic mutation in associated gene",
    "notes": "Genetic testing is critical for definitive diagnosis; early diagnosis improves management outcomes."
  },
