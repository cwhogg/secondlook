  "keyFindings": {
    "laboratory": [
      "Suppressed serum TSH",
      "Elevated free T4 and free T3",
      "Normal or elevated hCG levels",
      "Negative thyroid autoantibodies (TSI, TPO Ab) in many cases"
    ],
    "imaging": [
      "Thyroid ultrasound showing diffuse gland enlargement without nodules",
      "Doppler ultrasound demonstrating increased thyroid vascularity"
    ],
    "genetic": [
      "TSHR (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Family history of gestational hyperthyroidism",
      "Refractoriness to standard antithyroid drug therapy during pregnancy"
    ]
  },
