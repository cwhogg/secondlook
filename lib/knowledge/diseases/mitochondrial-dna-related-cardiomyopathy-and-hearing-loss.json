      ]
    },
    {
      "diseaseId": "kearns-sayre-syndrome",
      "distinguishingFeatures": [
        "Progressive external ophthalmoplegia and pigmentary retinopathy",
        "Onset before age 20 with cardiac conduction defects rather than cardiomyopathy"
      ]
    }
  ],
