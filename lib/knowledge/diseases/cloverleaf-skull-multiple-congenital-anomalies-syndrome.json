  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests unless secondary complications",
      "Thyroid function tests may reveal hypothyroidism"
    ],
    "imaging": [
      "CT or MRI showing trilobed cloverleaf skull deformity",
      "Radiographs revealing craniosynostosis and limb anomalies",
      "Brain imaging may show hydrocephalus or structural abnormalities"
    ],
    "genetic": [
      "Pathogenic variants in FGFR2 gene commonly identified",
      "Occasional mutations in FGFR1 or FGFR3 genes",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Prenatal ultrasound may detect cranial and limb anomalies",
      "Clinical examination critical for early diagnosis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "craniosynostosis-syndrome-apos",
      "distinguishingFeatures": [
        "Absence of trilobed cloverleaf skull deformity",
        "Less severe midface hypoplasia",
        "Different genetic mutations (e.g., TWIST1)"
      ]
    },
    {
      "diseaseId": "pfeiffer-syndrome",
      "distinguishingFeatures": [
        "Broad thumbs and big toes",
        "Less pronounced cloverleaf skull morphology",
        "FGFR1 or FGFR2 mutations with distinct phenotype"
      ]
    }
  ],
  "redFlags": [
    "Severe cranial deformity causing increased intracranial pressure",
    "Respiratory distress due to airway obstruction",
    "Progressive hydrocephalus leading to neurological deterioration"
  ],
