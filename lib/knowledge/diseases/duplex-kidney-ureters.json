  "diagnosticCriteria": {
    "formalCriteriaName": "Radiologic and Clinical Diagnostic Criteria for Duplex Kidney",
    "criteria": [
      {
        "id": "imaging-duplication",
        "description": "Imaging evidence of duplicated renal pelvis and/or ureters on ultrasound, CT, or MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-tract-infection",
        "description": "Recurrent urinary tract infections associated with duplicated collecting system",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "voiding-cystourethrogram",
        "description": "Voiding cystourethrogram demonstrating vesicoureteral reflux in one or both ureters",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of imaging-confirmed duplicated renal pelvis or ureters plus either recurrent urinary tract infections or vesicoureteral reflux",
    "notes": "Diagnosis is primarily radiologic; clinical symptoms support but are not mandatory."
  },
