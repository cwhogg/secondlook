  "keyFindings": {
    "laboratory": [
      "Elevated cerebrospinal fluid protein may be present but nonspecific"
    ],
    "imaging": [
      "Nerve ultrasound may show nerve enlargement",
      "MRI may show muscle atrophy in distal limbs"
    ],
    "genetic": [
      "NEFL (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Nerve conduction studies demonstrating uniformly slowed conduction velocities",
      "Nerve biopsy showing demyelination and onion bulb formations"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "charcot-marie-tooth-disease-type-1a",
      "distinguishingFeatures": [
        "CMT1A caused by PMP22 gene duplication",
        "More common than CMT1F",
        "Similar clinical presentation but different genetic cause"
      ]
    },
    {
      "diseaseId": "hereditary-neuropathy-with-liability-to-pressure-palsies",
      "distinguishingFeatures": [
        "Recurrent focal neuropathies",
        "PMP22 gene deletion",
        "Less uniform slowing of nerve conduction velocities"
      ]
    },
    {
      "diseaseId": "chronic-inflammatory-demyelinating-polyneuropathy",
      "distinguishingFeatures": [
        "Acquired demyelinating neuropathy",
        "Responds to immunotherapy",
        "CSF protein elevated with inflammation"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of weakness over weeks to months",
    "Respiratory difficulty or signs of respiratory muscle involvement",
    "Bulbar symptoms such as dysphagia or vocal cord paresis"
