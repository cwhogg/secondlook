  "diagnosticCriteria": {
    "formalCriteriaName": "MNGIE Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-gastrointestinal-dysmotility",
        "description": "Progressive gastrointestinal dysmotility with symptoms such as chronic diarrhea, nausea, vomiting, and abdominal pain",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "leukoencephalopathy-on-mri",
        "description": "Diffuse leukoencephalopathy visible on brain MRI without significant clinical encephalopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peripheral-neuropathy",
        "description": "Sensorimotor peripheral neuropathy confirmed by nerve conduction studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-plasma-thymidine",
        "description": "Elevated plasma thymidine and deoxyuridine levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "TYMP-gene-mutation",
        "description": "Biallelic pathogenic mutations in the TYMP gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of gastrointestinal dysmotility, leukoencephalopathy on MRI, peripheral neuropathy, and confirmed biallelic TYMP mutations",
    "notes": "Diagnosis can be supported by elevated plasma thymidine and deoxyuridine levels and muscle biopsy findings."
  },
