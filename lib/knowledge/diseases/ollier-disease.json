  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Ollier Disease",
    "criteria": [
      {
        "id": "multiple-enchondromas",
        "description": "Presence of multiple enchondromas predominantly in the metaphyseal regions of long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "asymmetric-distribution",
        "description": "Asymmetric distribution of enchondromas leading to unilateral or asymmetric skeletal involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-family-history",
        "description": "No family history of enchondromatosis, supporting nonhereditary nature",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiographic-bone-deformities",
        "description": "Radiographic evidence of bone deformities and cortical thinning associated with enchondromas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pathologic-fractures",
        "description": "History or presence of pathologic fractures in affected bones",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple enchondromas with asymmetric distribution and characteristic radiographic bone deformities",
    "notes": "Genetic testing may support diagnosis but is not required; diagnosis primarily clinical and radiological."
  },
