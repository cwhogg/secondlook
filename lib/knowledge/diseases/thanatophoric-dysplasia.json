  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Prenatal ultrasound showing severe limb shortening and narrow thorax",
      "Radiographs demonstrating short ribs, micromelia, and characteristic skull abnormalities",
      "MRI or CT may show craniosynostosis and cloverleaf skull"
    ],
    "genetic": [
      "Pathogenic mutations in FGFR3 gene, commonly missense mutations",
      "Molecular genetic testing confirms diagnosis"
    ],
    "other": [
      "Perinatal lethality due to respiratory insufficiency",
      "Characteristic clinical phenotype at birth"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "achondroplasia",
      "distinguishingFeatures": [
        "Less severe limb shortening",
        "Normal thoracic size",
        "Survivable beyond neonatal period"
      ]
    },
    {
      "diseaseId": "osteogenesis-imperfecta-type-ii",
      "distinguishingFeatures": [
        "Multiple fractures in utero",
        "Blue sclerae",
        "Bone fragility rather than primarily limb shortening"
      ]
    },
    {
      "diseaseId": "campomelic-dysplasia",
      "distinguishingFeatures": [
        "Bowing of long bones",
        "Sex reversal in some cases",
        "Less severe thoracic constriction"
      ]
    }
  ],
