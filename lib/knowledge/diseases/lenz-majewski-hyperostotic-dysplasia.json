  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "No specific biochemical markers identified"
    ],
    "imaging": [
      "Radiographs showing generalized cortical hyperostosis of skull and long bones",
      "Bone sclerosis with thickened cortical bone"
    ],
    "genetic": [
      "PTDSS1 (causative, gain-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Skin biopsy showing hypertrichosis with thickened dermis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "van-buchem-disease",
