  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild hypothyroidism on thyroid function tests"
    ],
    "imaging": [
      "Echocardiogram showing ventricular and/or atrial septal defects",
      "Skeletal X-rays demonstrating clinodactyly or scoliosis",
      "Brain MRI may show nonspecific delayed myelination"
    ],
    "genetic": [
      "HNRNPK (causative, loss-of-function)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Developmental assessment confirming global developmental delay",
      "Dysmorphology evaluation confirming craniofacial anomalies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "noonan-syndrome",
      "distinguishingFeatures": [
        "Characteristic facial features including low-set ears and webbed neck",
        "Pulmonary valve stenosis more common than septal defects",
        "PTPN11 or related gene mutations"
      ]
    },
    {
      "diseaseId": "kabuki-syndrome",
      "distinguishingFeatures": [
        "Distinctive facial features including arched eyebrows and long palpebral fissures",
        "Postnatal growth retardation",
        "Mutations in KMT2D or KDM6A genes"
      ]
    }
  ],
  "redFlags": [
    "Severe congenital heart defects requiring early surgical intervention",
    "Progressive neurological deterioration",
    "Failure to thrive with feeding difficulties"
  ],
