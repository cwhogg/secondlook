  "diagnosticCriteria": {
    "formalCriteriaName": "Ring Chromosome 7 Diagnostic Criteria",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Identification of ring chromosome 7 by karyotyping or molecular cytogenetics",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Prenatal and postnatal growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial anomalies including microcephaly and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "limb-malformations",
        "description": "Presence of limb anomalies such as syndactyly or clinodactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of ring chromosome 7 confirmed by cytogenetic analysis plus at least two major clinical features",
    "notes": "Diagnosis relies heavily on cytogenetic confirmation due to phenotypic variability."
  },
