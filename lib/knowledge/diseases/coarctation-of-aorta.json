  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Imaging Diagnostic Criteria for Coarctation of the Aorta",
    "criteria": [
      {
        "id": "upper-limb-hypertension",
        "description": "Elevated blood pressure in upper extremities compared to lower extremities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brachial-femoral-pulse-delay",
        "description": "Delayed or diminished femoral pulses compared to brachial pulses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-evidence",
        "description": "Imaging confirmation of aortic narrowing via echocardiography, MRI, or CT angiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "systolic-murmur",
        "description": "Presence of a systolic murmur heard best over the back or left infrascapular area",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "left-ventricular-hypertrophy",
        "description": "Evidence of left ventricular hypertrophy on ECG or imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of upper limb hypertension and brachial-femoral pulse delay with imaging confirmation of aortic narrowing",
    "notes": "Diagnosis is primarily clinical supported by imaging studies; blood pressure discrepancies are key diagnostic clues."
  },
