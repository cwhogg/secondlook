  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Elevated creatine kinase (mild, if any)"
    ],
    "imaging": [
      "Muscle MRI showing distal muscle atrophy",
      "Nerve ultrasound may show nerve enlargement"
    ],
    "genetic": [
      "NEFL (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography showing chronic denervation and reinnervation",
      "Nerve conduction studies demonstrating axonal neuropathy with normal or mildly reduced conduction velocities"
    ]
