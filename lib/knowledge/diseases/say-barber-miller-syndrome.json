  "diagnosticCriteria": {
    "formalCriteriaName": "Say-Barber-Miller syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial dysmorphism including microcephaly, prominent nasal bridge, and hypertelorism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-anomalies",
        "description": "Skeletal abnormalities such as clinodactyly and joint contractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: characteristic craniofacial dysmorphism, intellectual disability, and skeletal anomalies",
    "notes": "Diagnosis is clinical; genetic testing may assist but causative gene not definitively identified."
  },
