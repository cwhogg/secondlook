  "keyFindings": {
    "laboratory": [
      "Detection of primary mitochondrial DNA mutations (m.11778G>A, m.3460G>A, m.14484T>C) via genetic testing"
    ],
    "imaging": [
      "Optical coherence tomography (OCT) showing retinal nerve fiber layer thinning",
      "MRI brain usually normal but may show optic nerve changes"
    ],
    "genetic": [
      "Mitochondrial DNA point mutations in MT-ND1, MT-ND4, or MT-ND6 genes"
    ],
    "other": [
      "Visual evoked potentials (VEP) showing delayed latency",
      "Fundoscopy revealing optic nerve pallor or atrophy"
    ]
  },
