  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Fuchs Heterochromic Iridocyclitis",
    "criteria": [
      {
        "id": "heterochromia",
        "description": "Unilateral iris heterochromia or subtle iris stromal atrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "stellate-keratic-precipitates",
        "description": "Presence of fine, stellate keratic precipitates diffusely distributed on the corneal endothelium",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-posterior-synechiae",
        "description": "Lack of posterior synechiae despite chronic anterior uveitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "low-grade-anterior-chamber-inflammation",
        "description": "Chronic low-grade anterior chamber inflammation",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "vitreous-opacities",
        "description": "Mild vitreous opacities or cells",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: iris heterochromia or stromal atrophy, stellate keratic precipitates, and absence of posterior synechiae",
    "notes": "Diagnosis is clinical; laboratory tests are generally not diagnostic but used to exclude other causes of uveitis."
  },
