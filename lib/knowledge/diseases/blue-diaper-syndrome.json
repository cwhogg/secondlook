        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "indicanuria",
        "description": "Elevated urinary indican levels detected by biochemical analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "tryptophan-malabsorption",
        "description": "Evidence of intestinal tryptophan malabsorption or abnormal metabolism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-impairment",
        "description": "Signs of renal tubular dysfunction or failure",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of blue diaper discoloration with confirmed elevated urinary indican and evidence of tryptophan malabsorption",
    "notes": "Diagnosis is primarily clinical supported by biochemical urinary analysis and exclusion of other causes of blue diaper discoloration."
  },
