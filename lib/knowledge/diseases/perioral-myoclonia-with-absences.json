  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Perioral Myoclonia with Absences",
    "criteria": [
      {
        "id": "clinical-seizure-pattern",
        "description": "Presence of brief, repetitive perioral myoclonic jerks often associated with absence seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eeg-characteristics",
        "description": "Generalized 3-4 Hz spike-and-wave discharges on EEG during absence seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "age-of-onset",
        "description": "Onset of seizures typically in early childhood or adolescence",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-treatment",
        "description": "Positive response to valproate or ethosuximide treatment",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical seizure pattern with EEG evidence of generalized spike-and-wave discharges",
    "notes": "Diagnosis is clinical supported by EEG findings; genetic testing may be considered but is not diagnostic."
  },
