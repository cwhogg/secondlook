  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for congenital bile acid synthesis defects",
    "criteria": [
      {
        "id": "biochemical-abnormalities",
        "description": "Detection of abnormal bile acid metabolites in urine by mass spectrometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the HSD3B7 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Neonatal or infantile cholestasis with normal or low serum bile acids",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-biopsy",
        "description": "Histological evidence of cholestasis and giant cell hepatitis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of abnormal bile acid metabolites plus pathogenic HSD3B7 mutations with compatible clinical presentation",
    "notes": "Early diagnosis is critical to prevent progressive liver disease."
  },
