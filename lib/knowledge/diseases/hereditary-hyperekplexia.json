        "symptomName": "Exaggerated startle response to auditory or tactile stimuli",
        "frequency": 0.95,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Generalized neonatal muscle stiffness (hypertonia)",
        "frequency": 0.9,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Transient neonatal apnea triggered by startle",
        "frequency": 0.75,
        "bodySystem": "respiratory",
