  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Early-onset Familial Hypoaldosteronism",
    "criteria": [
      {
        "id": "hypoaldosteronism-confirmation",
        "description": "Biochemical confirmation of hypoaldosteronism with low serum aldosterone levels and elevated plasma renin activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset-hyponatremia",
        "description": "Onset of hyponatremia and hyperkalemia during infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of hypoaldosteronism or related mineralocorticoid deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in CYP11B2 gene or related genes involved in aldosterone synthesis",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of biochemical hypoaldosteronism with early-onset electrolyte abnormalities plus either genetic confirmation or positive family history",
    "notes": "Genetic testing is recommended to confirm diagnosis and differentiate from other causes of hypoaldosteronism."
  },
