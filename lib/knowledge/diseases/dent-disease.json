  "keyFindings": {
    "laboratory": [
      "Low molecular weight proteinuria (e.g., elevated β2-microglobulin or retinol-binding protein in urine)",
      "Hypercalciuria on 24-hour urine collection",
      "Hypophosphatemia",
      "Elevated serum creatinine in advanced disease"
    ],
    "imaging": [
      "Renal ultrasound showing nephrocalcinosis",
      "CT scan or X-ray demonstrating nephrolithiasis"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Family history consistent with X-linked inheritance pattern"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "fanconi-syndrome",
      "distinguishingFeatures": [
        "Generalized proximal tubular dysfunction with glucosuria, aminoaciduria, and phosphaturia",
        "Often caused by acquired conditions or other inherited disorders"
      ]
    },
    {
      "diseaseId": "primary-hyperoxaluria",
      "distinguishingFeatures": [
        "Excessive oxalate production leading to recurrent kidney stones",
        "Elevated urinary oxalate levels",
        "No low molecular weight proteinuria"
      ]
    },
    {
      "diseaseId": "bartter-syndrome",
      "distinguishingFeatures": [
        "Hypokalemic metabolic alkalosis",
        "Normal or low urinary calcium excretion",
        "No low molecular weight proteinuria"
      ]
    }
  ],
  "redFlags": [
    "Early onset nephrocalcinosis in a male patient",
    "Persistent low molecular weight proteinuria despite normal glomerular function",
    "Family history of kidney stones or renal failure with X-linked inheritance pattern"
  ],
