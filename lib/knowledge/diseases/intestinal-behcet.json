  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP during flares",
      "No specific serologic marker (unlike IBD: p-ANCA/ASCA typically negative)",
      "Positive pathergy test in ~50% (more common in Middle Eastern/Asian patients)",
      "HLA-B51 positive in ~60% (varies by ethnicity)"
    ],
    "imaging": [
      "CT enterography: mural thickening, ulcerations predominantly in ileocecal region",
      "CT may show complications: perforation, fistula, abscess"
    ],
    "genetic": [
      "IL10 (susceptibility)",
      "HLA-B (susceptibility)",
      "FAS (susceptibility)",
      "UBAC2 (susceptibility)",
      "IL23R (susceptibility)",
      "MEFV (susceptibility)",
      "STAT4 (susceptibility)",
      "C4A (susceptibility)",
      "IL12A (susceptibility)",
      "TLR4 (susceptibility)",
      "CCR1 (susceptibility)",
      "KLRC4 (susceptibility)",
      "IL12A-AS1 (susceptibility)",
      "ERAP1 (susceptibility)",
      "IFNGR1 (susceptibility)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Colonoscopy: deep, round/oval, well-demarcated ulcers (fewer in number than Crohn's, with less cobblestoning)",
      "Pathergy test: papular/pustular response at needle prick site at 24-48 hours",
      "Biopsy: nonspecific inflammation; vasculitis may be seen but not always"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "crohn-disease",
      "distinguishingFeatures": [
        "Crohn's has longitudinal ulcers, cobblestoning, skip lesions throughout GI tract",
        "Crohn's more commonly has ASCA positivity",
        "Crohn's has granulomas on biopsy; Behcet typically does not",
        "Behcet has oral/genital ulcers and uveitis"
      ]
    },
    {
      "diseaseId": "tuberculosis-intestinal",
      "distinguishingFeatures": [
        "TB has transverse ulcers, caseating granulomas",
        "Positive TB testing (Quantiferon, PPD)"
      ]
    },
    {
      "diseaseId": "nsaid-enteropathy",
      "distinguishingFeatures": [
        "NSAID ulcers resolve with drug withdrawal",
        "No systemic Behcet features"
      ]
    }
  ],
  "redFlags": [
    "Acute abdomen suggesting intestinal perforation",
    "Massive GI hemorrhage",
    "Severe visual changes suggesting posterior uveitis (risk of blindness)",
    "Neurological symptoms suggesting neuro-Behcet (CNS vasculitis)",
    "Deep venous thrombosis or arterial aneurysm (vascular Behcet)"
  ],
