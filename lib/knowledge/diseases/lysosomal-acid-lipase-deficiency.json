  "keyFindings": {
    "laboratory": [
      "Reduced lysosomal acid lipase enzyme activity in leukocytes or fibroblasts",
      "Elevated serum transaminases (ALT, AST)",
      "Dyslipidemia with elevated LDL and decreased HDL cholesterol",
      "Elevated serum ferritin"
    ],
    "imaging": [
      "Hepatomegaly and splenomegaly on abdominal ultrasound or MRI",
      "Adrenal gland calcifications on abdominal CT",
      "Interstitial lung disease findings on chest CT"
    ],
    "genetic": [
      "Pathogenic variants in the LIPA gene confirmed by molecular genetic testing",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Liver biopsy showing microvesicular steatosis and lipid-laden macrophages (foam cells)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "gaucher-disease",
      "distinguishingFeatures": [
        "Glucocerebrosidase deficiency rather than LAL deficiency",
        "Presence of Gaucher cells on biopsy",
        "Different genetic mutations in GBA gene"
      ]
    },
    {
      "diseaseId": "niemann-pick-disease-type-c",
      "distinguishingFeatures": [
        "Cholesterol trafficking defect with NPC1 or NPC2 mutations",
        "Neurological symptoms more prominent and earlier",
        "Filipin staining positive in fibroblasts"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive hepatosplenomegaly in infancy",
    "Severe dyslipidemia resistant to standard lipid-lowering therapy",
    "Adrenal calcifications in a young child"
  ],
