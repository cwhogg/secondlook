  "diagnosticCriteria": {
    "formalCriteriaName": "Chronic Granulomatous Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "dihydrorhodamine-test",
        "description": "Abnormal dihydrorhodamine (DHR) flow cytometry test showing defective oxidative burst in neutrophils",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in NADPH oxidase complex genes (e.g., CYBB, NCF1, NCF2, NCF4)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-history",
        "description": "Recurrent, severe bacterial and fungal infections with granuloma formation",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "nitroblue-tetrazolium-test",
        "description": "Abnormal nitroblue tetrazolium (NBT) test indicating defective neutrophil oxidative metabolism",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of abnormal oxidative burst test (DHR or NBT) plus clinical history of recurrent infections or identification of pathogenic NADPH oxidase mutations",
    "notes": "Genetic testing is confirmatory and useful for family counseling."
  },
