  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Adult Refsum Disease",
    "criteria": [
      {
        "id": "phytanic-acid-elevation",
        "description": "Elevated plasma phytanic acid concentration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features including retinitis pigmentosa, peripheral neuropathy, and cerebellar ataxia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in PHYH or PEX7 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-conduction-study",
        "description": "Electrophysiological evidence of sensorimotor peripheral neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Elevated plasma phytanic acid plus either characteristic clinical features or pathogenic variants in PHYH/PEX7 genes",
    "notes": "Diagnosis is confirmed by biochemical and genetic testing; clinical presentation may vary."
  },
