  "diagnosticCriteria": {
    "formalCriteriaName": "None established",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of one or more cranial sutures confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "osteosclerosis",
        "description": "Generalized increased bone density demonstrated on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay evident in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including midface hypoplasia and frontal bossing",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-abnormalities",
        "description": "Presence of hypotonia or seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis, osteosclerosis on imaging, and developmental delay",
    "notes": "Diagnosis is clinical supported by radiological findings; genetic testing may assist but no specific gene identified"
  },
