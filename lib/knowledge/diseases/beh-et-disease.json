  "keyFindings": {
    "laboratory": [
      "Elevated inflammatory markers (ESR, CRP)",
      "HLA-B51 allele association",
      "Negative autoantibodies (ANA, RF) differentiating from other autoimmune diseases"
    ],
    "imaging": [
      "MRI brain showing CNS vasculitis or thrombosis",
      "Doppler ultrasound for venous thrombosis",
      "CT angiography for pulmonary artery aneurysms"
    ],
    "genetic": [
      "IL10 (susceptibility)",
      "HLA-B (susceptibility)",
      "FAS (susceptibility)",
      "UBAC2 (susceptibility)",
      "IL23R (susceptibility)",
      "MEFV (susceptibility)",
      "STAT4 (susceptibility)",
      "C4A (susceptibility)",
      "IL12A (susceptibility)",
      "TLR4 (susceptibility)",
      "CCR1 (susceptibility)",
      "KLRC4 (susceptibility)",
      "IL12A-AS1 (susceptibility)",
      "ERAP1 (susceptibility)",
      "IFNGR1 (susceptibility)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
