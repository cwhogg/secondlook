  "diagnosticCriteria": {
    "formalCriteriaName": "Revised Rett Syndrome Diagnostic Criteria (Neul et al., 2010)",
    "criteria": [
      {
        "id": "loss-acquired-skills",
        "description": "Partial or complete loss of purposeful hand skills and spoken language",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "stereotypic-hand-movements",
        "description": "Repetitive, stereotypic hand movements such as hand wringing, clapping, or mouthing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-disturbances",
        "description": "Severe behavioral disturbances including anxiety, mood instability, and autistic features",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "MECP2-mutation",
        "description": "Presence of pathogenic MECP2 gene mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "gait-abnormalities",
        "description": "Impaired or abnormal gait including ataxia or apraxia",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria with or without confirmed MECP2 mutation",
    "notes": "Behavioral variant may present with more prominent psychiatric symptoms compared to classic Rett syndrome."
  },
