  "diagnosticCriteria": {
    "formalCriteriaName": "Verloes Diagnostic Criteria for Blepharophimosis-Intellectual Disability Syndrome",
    "criteria": [
      {
        "id": "blepharophimosis",
        "description": "Presence of blepharophimosis characterized by narrowed horizontal palpebral fissures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability confirmed by neuropsychological assessment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ptosis",
        "description": "Bilateral congenital ptosis affecting eyelid elevation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "telecanthus",
        "description": "Increased distance between the medial canthi without hypertelorism",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypoplastic-nasal-bridge",
        "description": "Hypoplasia of the nasal bridge with characteristic facial dysmorphism",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of blepharophimosis, intellectual disability, and bilateral congenital ptosis",
    "notes": "Diagnosis is clinical; genetic testing may support but is not definitive."
  },
