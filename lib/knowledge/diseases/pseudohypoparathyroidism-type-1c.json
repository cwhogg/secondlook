  "keyFindings": {
    "laboratory": [
      "Elevated parathyroid hormone (PTH) levels",
      "Hypocalcemia",
      "Hyperphosphatemia",
      "Normal or mildly reduced Gs alpha protein activity in erythrocytes"
    ],
    "imaging": [
      "Subcutaneous ossifications on X-ray",
      "Brachydactyly evident on hand and foot radiographs",
      "Basal ganglia calcifications on CT brain (rare)"
    ],
    "genetic": [
      "GNAS (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Clinical diagnosis supported by phenotype and biochemical findings",
      "Resistance to multiple hormones may be present"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pseudohypoparathyroidism-type-1a",
      "distinguishingFeatures": [
        "Reduced Gs alpha protein activity",
        "Similar AHO phenotype but with molecular GNAS mutations",
        "More frequent multi-hormone resistance"
      ]
    },
    {
      "diseaseId": "pseudopseudohypoparathyroidism",
      "distinguishingFeatures": [
        "AHO phenotype without hormone resistance",
        "Normal calcium and phosphate levels",
        "No biochemical evidence of PTH resistance"
      ]
    }
  ],
  "redFlags": [
    "Severe hypocalcemia causing tetany or seizures",
    "Progressive subcutaneous ossifications limiting joint mobility",
    "Early onset hypothyroidism or multi-hormonal resistance"
  ],
