{
  "id": "22q11-deletion-syndrome",
  "name": "22q11.2 Deletion Syndrome",
  "aliases": [
    "DiGeorge Syndrome",
    "Velocardiofacial Syndrome",
    "VCFS",
    "Shprintzen Syndrome",
    "Conotruncal Anomaly Face Syndrome",
    "CATCH22"
  ],
  "icd10Codes": [
    "D82.1",
    "Q93.81"
  ],
  "omimId": "188400",
  "orphanetId": "567",
  "prevalence": {
    "estimate": "1-5 in 10,000",
    "range": "1-5 / 10 000",
    "classification": "uncommon"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 120,
      "peak": 60
    },
    "sexPredilection": "equal",
    "ethnicAssociations": [
      "No strong ethnic predilection",
      "Occurs across all ethnicities"
    ]
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnosis confirmed by genetic testing",
    "criteria": [
      {
        "id": "dg-c1",
        "description": "Hemizygous deletion of chromosome 22q11.2 detected by FISH, MLPA, chromosomal microarray, or other molecular method",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dg-c2",
        "description": "Conotruncal cardiac defect (tetralogy of Fallot, interrupted aortic arch, truncus arteriosus, VSD)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "dg-c3",
        "description": "Palatal abnormalities (velopharyngeal insufficiency, cleft palate, submucous cleft)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "dg-c4",
        "description": "Characteristic facial features (long face, hooded eyelids, bulbous nasal tip, small ears)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "dg-c5",
        "description": "Hypocalcemia from hypoparathyroidism",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "dg-c6",
        "description": "Thymic hypoplasia/aplasia with T-cell immunodeficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Detection of 22q11.2 deletion by molecular genetics. Clinical suspicion based on typical features triggers testing.",
    "notes": "Most common microdeletion syndrome in humans. ~90% have a ~3 Mb deletion; ~8% have a ~1.5 Mb deletion. TBX1 is the critical gene. ~90-95% are de novo; ~5-10% inherited from an affected parent."
  },
