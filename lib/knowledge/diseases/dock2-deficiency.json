  "diagnosticCriteria": {
    "formalCriteriaName": "DOCK2 Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Biallelic pathogenic variants in the DOCK2 gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotyping",
        "description": "Severe combined immunodeficiency phenotype with impaired lymphocyte migration and function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Early onset severe recurrent viral and bacterial infections",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "laboratory-findings",
        "description": "Lymphopenia with reduced T, B, and NK cell counts and impaired chemotaxis assays",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic DOCK2 variants plus clinical immunodeficiency phenotype with recurrent severe infections",
    "notes": "Genetic confirmation is essential; functional assays support diagnosis."
  },
