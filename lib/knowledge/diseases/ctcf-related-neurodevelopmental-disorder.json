  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for CTCF-related Neurodevelopmental Disorder",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic or likely pathogenic variant in the CTCF gene identified by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability of variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Presence of characteristic craniofacial dysmorphisms including microcephaly, prominent nasal bridge, and thin upper lip",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "behavioral-issues",
        "description": "Behavioral abnormalities such as autism spectrum disorder traits or attention deficit hyperactivity disorder",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-abnormalities",
        "description": "Postnatal growth retardation or short stature",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of a pathogenic CTCF variant plus global developmental delay or intellectual disability",
    "notes": "Diagnosis is primarily genetic; clinical features support but are variable."
  },
