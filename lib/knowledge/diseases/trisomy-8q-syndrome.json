  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Trisomy 8q Syndrome",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Detection of partial or full trisomy of the long arm of chromosome 8 by karyotyping or chromosomal microarray",
