      ]
    },
    {
      "diseaseId": "marfan-syndrome",
      "distinguishingFeatures": [
        "Tall stature with arachnodactyly",
        "Ectopia lentis and aortic root dilation",
        "FBN1 mutations",
        "Normal testes and fertility typically"
      ]
    },
    {
      "diseaseId": "secondary-hypogonadism",
      "distinguishingFeatures": [
        "Low FSH/LH (hypogonadotropic)",
        "Normal karyotype",
        "Pituitary or hypothalamic cause",
        "Potentially reversible"
      ]
    }
  ],
