  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Short Bowel Syndrome",
    "criteria": [
      {
        "id": "criterion-1",
        "description": "History of extensive small intestine resection resulting in less than 200 cm of functional small bowel",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-2",
        "description": "Evidence of malabsorption including nutrient deficiencies and steatorrhea",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "criterion-3",
        "description": "Dependence on parenteral nutrition for maintenance of hydration and nutrition",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of history of extensive small bowel resection with clinical and laboratory evidence of malabsorption",
    "notes": "Diagnosis is clinical and supported by imaging and nutritional assessment"
  },
