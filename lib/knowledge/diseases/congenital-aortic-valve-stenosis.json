  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible elevated BNP in heart failure",
      "Blood cultures if infective endocarditis suspected"
    ],
    "imaging": [
      "Echocardiography showing valve morphology and pressure gradients",
      "Cardiac MRI for detailed valve and ventricular assessment",
      "Chest X-ray showing cardiomegaly or pulmonary congestion"
    ],
    "genetic": [
      "Mutations in NOTCH1 gene associated with bicuspid aortic valve and stenosis"
    ],
    "other": [
      "Electrocardiogram showing left ventricular hypertrophy or arrhythmias",
      "Cardiac catheterization for hemodynamic assessment if noninvasive tests inconclusive"
    ]
  },
