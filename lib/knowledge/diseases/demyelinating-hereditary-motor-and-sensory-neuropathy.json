  "diagnosticCriteria": {
    "formalCriteriaName": "European CMT Consortium Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of distal muscle weakness and atrophy predominantly in lower limbs with sensory loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nerve-conduction-velocity",
        "description": "Motor nerve conduction velocity in upper limbs less than 38 m/s indicating demyelination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in PMP22, MPZ, or other related genes",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus reduced nerve conduction velocity or pathogenic genetic mutation",
    "notes": "Nerve biopsy may be used in atypical cases; genetic testing is confirmatory."
  },
