  "keyFindings": {
    "laboratory": [
      "Marked peripheral eosinophilia (often >1500/mm3, can be >10,000)",
      "MPO-ANCA (p-ANCA) positive (~40%)",
      "Elevated IgE",
      "Elevated ESR and CRP",
      "Elevated troponin and BNP in cardiac involvement",
      "Elevated serum eosinophilic cationic protein"
    ],
    "imaging": [
      "Chest CT: migratory patchy pulmonary infiltrates, ground-glass opacities",
      "Cardiac MRI: myocardial inflammation/fibrosis (late gadolinium enhancement)",
      "Echocardiography: reduced EF in eosinophilic myocarditis",
      "Sinus CT: mucosal thickening, polyps"
    ],
    "genetic": [
      "HLA-DRB4 association reported",
      "IL-5 pathway gene variants"
    ],
    "other": [
      "Tissue biopsy: extravascular eosinophilic granulomas and necrotizing vasculitis",
      "Nerve biopsy: eosinophilic infiltration, epineural vasculitis",
      "Endomyocardial biopsy: eosinophilic myocarditis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "granulomatosis-with-polyangiitis",
      "distinguishingFeatures": [
        "No asthma or eosinophilia",
        "PR3-ANCA predominant",
        "Cavitating pulmonary nodules",
        "ENT destruction (saddle nose)"
      ]
    },
    {
      "diseaseId": "hypereosinophilic-syndrome",
      "distinguishingFeatures": [
        "No vasculitis on biopsy",
        "No asthma history",
        "ANCA negative",
        "May have FIP1L1-PDGFRA fusion"
      ]
    },
    {
      "diseaseId": "allergic-bronchopulmonary-aspergillosis",
      "distinguishingFeatures": [
        "Aspergillus sensitization",
        "Central bronchiectasis",
        "No vasculitis",
        "Elevated Aspergillus-specific IgE"
      ]
    },
    {
      "diseaseId": "microscopic-polyangiitis",
      "distinguishingFeatures": [
        "No eosinophilia or asthma",
        "MPO-ANCA positive",
        "Pauci-immune GN"
      ]
    }
  ],
  "redFlags": [
    "Cardiac involvement (eosinophilic myocarditis) - leading cause of death",
    "Rapidly progressive heart failure",
    "GI hemorrhage or perforation",
    "Acute mononeuritis multiplex with foot/wrist drop",
    "Severe eosinophilia (>5000/mm3) with organ damage"
  ],
