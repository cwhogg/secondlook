  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Carpenter Syndrome",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of cranial sutures leading to abnormal skull shape",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "polysyndactyly",
        "description": "Presence of extra digits combined with syndactyly (fusion of digits)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "obesity",
        "description": "Postnatal onset of obesity typically developing in infancy or early childhood",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-heart-defects",
        "description": "Presence of congenital cardiac malformations such as ventricular septal defect",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis and polysyndactyly is required; additional features such as obesity, congenital heart defects, or developmental delay support diagnosis",
    "notes": "Genetic testing for mutations in RAB23 gene can confirm diagnosis"
  },
