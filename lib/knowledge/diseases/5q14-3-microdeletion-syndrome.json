  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for 5q14.3 Microdeletion Syndrome",
    "criteria": [
      {
        "id": "microdeletion-confirmation",
        "description": "Detection of heterozygous microdeletion at chromosome 5q14.3 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurodevelopmental-delay",
        "description": "Presence of global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "History of infantile or childhood-onset seizures or epilepsy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "brain-malformations",
        "description": "Neuroimaging evidence of periventricular nodular heterotopia or other cortical malformations",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "dysmorphic-features",
        "description": "Presence of characteristic craniofacial dysmorphisms such as microcephaly and prominent forehead",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed 5q14.3 microdeletion plus neurodevelopmental delay; seizures and brain malformations support diagnosis",
    "notes": "Diagnosis relies on genetic confirmation combined with clinical features; brain MRI is recommended"
  },
