  "diagnosticCriteria": {
    "formalCriteriaName": "Hereditary ATTR Amyloidosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of the V122I mutation in the transthyretin (TTR) gene by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-amyloid-deposition",
        "description": "Evidence of amyloid deposits in cardiac tissue by biopsy or non-invasive imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-cardiomyopathy",
        "description": "Presence of restrictive cardiomyopathy with heart failure symptoms",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-light-chain-amyloidosis",
        "description": "Exclusion of AL amyloidosis by serum and urine immunofixation and free light chain assay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of V122I mutation plus evidence of cardiac amyloid deposition and clinical cardiomyopathy",
    "notes": "Diagnosis requires exclusion of other amyloidosis types, especially AL amyloidosis."
  },
