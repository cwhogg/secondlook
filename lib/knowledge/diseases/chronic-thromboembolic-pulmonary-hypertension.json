  "keyFindings": {
    "laboratory": [
      "Elevated brain natriuretic peptide (BNP) or NT-proBNP indicating right ventricular strain",
      "D-dimer may be elevated but nonspecific"
    ],
    "imaging": [
      "Ventilation/perfusion (V/Q) lung scan showing mismatched perfusion defects",
      "CT pulmonary angiography demonstrating chronic thromboembolic obstructions",
      "Right heart catheterization confirming elevated pulmonary artery pressures",
      "Echocardiography showing right ventricular hypertrophy and dysfunction"
    ],
    "genetic": [
      "No specific genetic markers identified; thrombophilia screening may reveal underlying hypercoagulable states"
    ],
    "other": [
      "Pulmonary angiography demonstrating webs, bands, or stenoses in pulmonary arteries"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pulmonary-arterial-hypertension",
      "distinguishingFeatures": [
        "Absence of chronic thromboembolic obstruction on imaging",
        "Different hemodynamic profile on right heart catheterization",
        "No mismatched perfusion defects on V/Q scan"
      ]
    },
    {
      "diseaseId": "pulmonary-embolism-acute",
      "distinguishingFeatures": [
        "Sudden onset symptoms",
        "Imaging shows fresh thrombi rather than chronic changes",
        "Normal or mildly elevated pulmonary pressures early on"
      ]
    }
  ],
  "redFlags": [
    "Progressive exertional dyspnea with syncope",
    "Signs of right heart failure such as peripheral edema and jugular venous distension",
    "Hemoptysis in the context of pulmonary hypertension"
  ],
