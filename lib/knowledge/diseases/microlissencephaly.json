  "diagnosticCriteria": {
    "formalCriteriaName": "Microlissencephaly Diagnostic Criteria",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Head circumference significantly below the mean for age and sex (microcephaly)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lissencephaly",
        "description": "Smooth cerebral cortex with absent or reduced gyri and sulci (lissencephaly) on neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Severe global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "Early onset epileptic seizures",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with microlissencephaly (e.g., RELN, WDR62)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of microcephaly and lissencephaly on neuroimaging plus severe developmental delay",
    "notes": "Genetic testing can confirm diagnosis but is not mandatory."
  },
