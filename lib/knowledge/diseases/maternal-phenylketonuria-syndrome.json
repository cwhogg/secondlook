  "diagnosticCriteria": {
    "formalCriteriaName": "Maternal Phenylketonuria Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "maternal-pku-history",
        "description": "Maternal history of untreated or poorly controlled phenylketonuria during pregnancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fetal-malformations",
        "description": "Presence of characteristic fetal malformations including microcephaly, congenital heart defects, and growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-phenylalanine",
        "description": "Elevated maternal serum phenylalanine levels during pregnancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neonatal-developmental-delay",
        "description": "Neonatal developmental delay or intellectual disability consistent with phenylalanine toxicity",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-causes",
        "description": "Exclusion of other causes of congenital anomalies and developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Maternal history of untreated PKU during pregnancy plus presence of characteristic fetal malformations and elevated maternal phenylalanine levels",
    "notes": "Diagnosis is clinical and supported by biochemical and maternal history data."
  },
