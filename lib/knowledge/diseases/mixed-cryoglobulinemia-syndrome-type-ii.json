  "keyFindings": {
    "laboratory": [
      "Presence of mixed cryoglobulins (type II) in serum",
      "Low complement levels, especially C4",
      "Positive rheumatoid factor",
      "Elevated liver enzymes in hepatitis C-associated cases"
    ],
    "imaging": [
      "Nerve conduction studies showing peripheral neuropathy",
      "Renal ultrasound may show enlarged kidneys in nephritis"
    ],
    "genetic": [
      "No specific genetic mutations identified"
    ],
    "other": [
      "Skin or renal biopsy showing leukocytoclastic vasculitis with immune complex deposition"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "essential-mixed-cryoglobulinemia-type-i",
      "distinguishingFeatures": [
        "Type I cryoglobulinemia involves monoclonal immunoglobulins only",
        "Often associated with hematologic malignancies",
        "Lacks polyclonal IgG component"
      ]
    },
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "Presence of ANA and anti-dsDNA antibodies",
        "Multisystem involvement with different autoantibody profile",
        "Hypocomplementemia but different clinical presentation"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive glomerulonephritis",
    "Severe peripheral neuropathy with motor deficits",
    "Central nervous system vasculitis manifestations"
  ],
  "specialistType": [
