  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Choreoacanthocytosis",
    "criteria": [
      {
        "id": "acanthocytosis",
        "description": "Presence of acanthocytes in peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chorea",
        "description": "Progressive choreiform movements predominantly affecting limbs and face",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vps13a-mutation",
        "description": "Pathogenic mutations in the VPS13A gene confirmed by genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing atrophy of the caudate nucleus and putamen",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuropsychiatric",
        "description": "Presence of neuropsychiatric symptoms such as obsessive-compulsive behavior or depression",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acanthocytosis, chorea, and pathogenic VPS13A mutation",
    "notes": "Diagnosis is confirmed by genetic testing; blood smear and clinical features support diagnosis."
  },
