  "diagnosticCriteria": {
    "formalCriteriaName": "ISCL/EORTC Diagnostic Criteria for Mycosis Fungoides",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of persistent, progressive patches, plaques, or tumors on the skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Epidermotropism of atypical cerebriform T-lymphocytes on skin biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotyping",
        "description": "Loss of pan-T-cell markers (e.g., CD7) and CD4+ T-cell predominance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "molecular-clonality",
        "description": "Detection of T-cell receptor gene rearrangement clonality",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-duration",
        "description": "Chronicity of skin lesions typically over months to years",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic clinical features plus histopathological confirmation and immunophenotyping consistent with MF",
    "notes": "Molecular studies support diagnosis but are not mandatory."
  },
