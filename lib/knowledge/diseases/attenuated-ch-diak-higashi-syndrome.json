  "diagnosticCriteria": {
    "formalCriteriaName": "Attenuated Chédiak-Higashi Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "giant-granules",
        "description": "Presence of giant lysosomal granules in peripheral blood leukocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "partial-albinism",
        "description": "Hypopigmentation or partial oculocutaneous albinism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-infections",
        "description": "Recurrent bacterial infections with impaired neutrophil function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the LYST gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-features",
        "description": "Mild neurological symptoms including ataxia or peripheral neuropathy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of giant lysosomal granules in leukocytes plus either partial albinism or recurrent infections",
    "notes": "Genetic confirmation supports diagnosis but is not mandatory if clinical and laboratory criteria are met."
  },
