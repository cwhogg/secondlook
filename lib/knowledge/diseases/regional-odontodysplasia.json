  "diagnosticCriteria": {
    "formalCriteriaName": "Regional Odontodysplasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "radiographic-ghost-teeth",
        "description": "Presence of 'ghost teeth' appearance on radiographs characterized by thin enamel and dentin with large pulp chambers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-enamel-hypoplasia",
        "description": "Clinically evident enamel hypoplasia and hypocalcification localized to a region of teeth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "localized-involvement",
        "description": "Involvement limited to a contiguous group of teeth in one quadrant or region of the jaw",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "delayed-eruption",
        "description": "Delayed or failed eruption of affected teeth",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "soft-tissue-inflammation",
        "description": "Associated gingival inflammation or swelling over affected teeth",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (radiographic ghost teeth, clinical enamel hypoplasia, and localized involvement) must be present for diagnosis.",
    "notes": "Diagnosis is primarily clinical and radiographic; biopsy is rarely required."
  },
