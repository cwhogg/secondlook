  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Congenital Dyserythropoietic Anemia Type I",
    "criteria": [
      {
        "id": "bone-marrow-abnormalities",
        "description": "Presence of characteristic binucleated erythroblasts and chromatin bridges in bone marrow aspirate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ineffective-erythropoiesis",
        "description": "Evidence of ineffective erythropoiesis with anemia and reticulocytopenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in CDAN1 or C15orf41 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemolysis-markers",
        "description": "Elevated serum lactate dehydrogenase and indirect hyperbilirubinemia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "iron-overload",
        "description": "Evidence of secondary iron overload in liver or spleen",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic bone marrow abnormalities plus either genetic confirmation or clinical evidence of ineffective erythropoiesis with anemia",
    "notes": "Genetic testing is strongly recommended to confirm diagnosis and differentiate from other congenital anemias."
  },
