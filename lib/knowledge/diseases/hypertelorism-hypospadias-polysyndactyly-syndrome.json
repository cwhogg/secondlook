  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Hypertelorism-hypospadias-polysyndactyly syndrome",
    "criteria": [
      {
        "id": "hypertelorism",
        "description": "Increased distance between the orbits (hypertelorism)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypospadias",
        "description": "Abnormal ventral placement of the urethral meatus (hypospadias)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "polysyndactyly",
        "description": "Presence of extra digits combined with fusion of digits (polysyndactyly)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Additional facial anomalies such as broad nasal bridge or cleft lip/palate",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: hypertelorism, hypospadias, and polysyndactyly",
    "notes": "Diagnosis is clinical; genetic testing may assist but no specific gene identified"
  },
