  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Dysspondyloenchondromatosis",
    "criteria": [
      {
        "id": "enchondromatous-lesions",
        "description": "Presence of multiple enchondromatous lesions predominantly affecting the vertebrae and long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vertebral-malformations",
        "description": "Dysplastic vertebral anomalies including platyspondyly and irregular vertebral bodies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "limb-shortening",
        "description": "Asymmetric limb shortening and deformities due to enchondromas",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "radiographic-pattern",
        "description": "Characteristic radiographic pattern of enchondromatosis with irregular ossification centers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with enchondromatosis (if available)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple enchondromatous lesions with vertebral malformations and characteristic radiographic findings",
    "notes": "Genetic testing may support diagnosis but is not mandatory; clinical and radiological correlation is essential."
  },
