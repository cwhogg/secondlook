  "diagnosticCriteria": {
    "formalCriteriaName": "Kuskokwim Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "congenital-muscle-weakness",
        "description": "Congenital onset of muscle weakness predominantly affecting proximal muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-contractures",
        "description": "Presence of joint contractures, especially in elbows and knees",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy-findings",
        "description": "Muscle biopsy showing myopathic changes with fiber size variability and fibrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "Electromyography demonstrating myopathic pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (congenital proximal muscle weakness, joint contractures, and characteristic muscle biopsy findings)",
    "notes": "Genetic testing may support diagnosis but causative gene remains unidentified."
  },
