  "keyFindings": {
    "laboratory": [
      "Peripheral blood smear showing neutrophils lacking specific granules",
      "Normal or mildly decreased neutrophil count",
      "Impaired neutrophil oxidative burst and bactericidal activity"
    ],
    "imaging": [
      "Chest X-ray showing recurrent pneumonia or lung abscesses",
      "MRI or bone scans indicating osteomyelitis in rare cases"
    ],
    "genetic": [
      "Mutations in CEBPE gene",
      "Other mutations affecting neutrophil granule biogenesis"
    ],
    "other": [
      "Electron microscopy confirming absence of specific granules in neutrophils"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "chronic-granulomatous-disease",
      "distinguishingFeatures": [
        "Defective NADPH oxidase leading to impaired oxidative burst",
        "Presence of normal neutrophil granules",
        "Positive nitroblue tetrazolium (NBT) test abnormality"
      ]
    },
    {
      "diseaseId": "lazy-leukocyte-syndrome",
      "distinguishingFeatures": [
        "Normal granules but defective neutrophil chemotaxis",
        "Recurrent infections with impaired neutrophil migration",
        "Normal granule staining on microscopy"
      ]
    }
  ],
  "redFlags": [
    "Recurrent severe bacterial infections from infancy",
    "Poor response to standard antibiotic therapy",
    "Absence of neutrophil specific granules on microscopy"
  ],
