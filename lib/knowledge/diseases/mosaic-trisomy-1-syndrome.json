      "diseaseId": "mosaic-trisomy-8-syndrome",
      "distinguishingFeatures": [
        "Mosaic trisomy 8 detected cytogenetically",
        "Distinctive facial features and deep plantar creases",
        "Variable intellectual disability and skeletal anomalies"
      ]
    }
  ],
