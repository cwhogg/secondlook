  "diagnosticCriteria": {
    "formalCriteriaName": "International League of Associations for Rheumatology (ILAR) Criteria for Juvenile Idiopathic Arthritis",
    "criteria": [
      {
        "id": "arthritis-duration",
        "description": "Arthritis in one or more joints persisting for at least 6 weeks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "psoriasis-or-family-history",
        "description": "Presence of psoriasis in the patient or a first-degree relative",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dactylitis",
        "description": "Presence of dactylitis (sausage digits)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "nail-pitting",
        "description": "Nail pitting or onycholysis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "negative-rf",
        "description": "Negative rheumatoid factor (RF) on at least two occasions",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Arthritis lasting at least 6 weeks plus psoriasis in the patient or a first-degree relative; supportive features such as dactylitis or nail changes strengthen diagnosis",
    "notes": "Exclusion of other juvenile idiopathic arthritis categories and other causes of arthritis is essential"
  },
