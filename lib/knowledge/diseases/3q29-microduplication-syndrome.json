  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild metabolic abnormalities in some cases"
    ],
    "imaging": [
      "Brain MRI may show nonspecific findings such as mild white matter abnormalities",
      "Echocardiogram to assess for congenital heart defects"
    ],
    "genetic": [
      "Microduplication of approximately 1.6 Mb at chromosome 3q29 detected by chromosomal microarray",
      "FISH or MLPA can confirm duplication",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Neuropsychological testing revealing cognitive impairment",
      "Behavioral assessments for autism spectrum disorder and ADHD"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "3q29-microdeletion-syndrome",
      "distinguishingFeatures": [
        "Microdeletion rather than duplication at 3q29",
        "More severe intellectual disability and higher risk of schizophrenia",
        "Distinct facial features"
      ]
    },
    {
      "diseaseId": "22q11-deletion-syndrome",
      "distinguishingFeatures": [
        "Deletion at chromosome 22q11.2",
        "Characteristic cardiac defects and immunodeficiency",
        "Distinct facial dysmorphism"
      ]
    }
  ],
