    "musculoskeletal"
  ],
  "keyFindings": {
    "laboratory": [
      "Reduced protein C activity and antigen levels",
      "Normal or elevated D-dimer during acute thrombosis",
      "Prolonged clotting times may be absent"
    ],
    "imaging": [
      "Ultrasound Doppler showing venous thrombosis",
      "CT pulmonary angiography for pulmonary embolism",
      "MRI/MRV for cerebral venous sinus thrombosis"
    ],
    "genetic": [
      "Mutations in PROC gene on chromosome 2",
      "Heterozygous or homozygous variants affecting protein C function"
    ],
    "other": [
      "Family history of thrombophilia",
      "Warfarin-induced skin necrosis on anticoagulation initiation"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "factor-v-leiden-thrombophilia",
      "distinguishingFeatures": [
        "Presence of Factor V Leiden mutation",
        "Activated protein C resistance assay positive",
        "Normal protein C activity"
      ]
    },
    {
      "diseaseId": "antithrombin-deficiency",
      "distinguishingFeatures": [
