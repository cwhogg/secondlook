        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electrophysiological evidence of axonal neuropathy with reduced compound muscle action potentials",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the HSPB1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "sensory-loss",
        "description": "Distal sensory loss and impaired proprioception",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal muscle weakness and atrophy with electrophysiological evidence of axonal neuropathy plus identification of pathogenic HSPB1 mutation",
    "notes": "Genetic confirmation is critical due to phenotypic overlap with other CMT subtypes."
