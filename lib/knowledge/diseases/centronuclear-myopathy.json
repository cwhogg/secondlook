  "differentialDiagnoses": [
    {
      "diseaseId": "myotonic-dystrophy",
      "distinguishingFeatures": [
        "Presence of myotonia",
        "Multisystem involvement including cataracts and cardiac conduction defects",
        "Genetic testing positive for DMPK or CNBP expansions"
      ]
    },
    {
      "diseaseId": "central-core-disease",
      "distinguishingFeatures": [
        "Muscle biopsy showing central cores rather than central nuclei",
        "Predominantly RYR1 mutations",
        "Usually presents with malignant hyperthermia susceptibility"
      ]
    },
    {
      "diseaseId": "nemaline-myopathy",
      "distinguishingFeatures": [
        "Presence of nemaline rods on muscle biopsy",
        "Different genetic mutations (e.g., NEB, ACTA1)",
        "Distinct clinical presentation with facial weakness and hypotonia"
      ]
    }
  ],
