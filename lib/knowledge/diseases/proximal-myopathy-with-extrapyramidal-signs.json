  "diagnosticCriteria": {
    "formalCriteriaName": "Proximal Myopathy with Extrapyramidal Signs Diagnostic Criteria",
    "criteria": [
      {
        "id": "proximal-muscle-weakness",
        "description": "Progressive proximal muscle weakness affecting limb girdle muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "extrapyramidal-motor-signs",
        "description": "Presence of extrapyramidal signs including rigidity, bradykinesia, or tremor",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy-findings",
        "description": "Muscle biopsy showing myopathic changes with or without mitochondrial abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in associated genes if known",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuroimaging",
        "description": "Brain MRI showing basal ganglia abnormalities consistent with extrapyramidal involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal muscle weakness plus extrapyramidal motor signs and supportive muscle biopsy findings",
    "notes": "Diagnosis may be supported by genetic testing and neuroimaging but is primarily clinical and histopathological."
  },
