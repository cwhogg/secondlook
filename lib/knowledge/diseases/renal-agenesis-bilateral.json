  "keyFindings": {
    "laboratory": [
      "Absent or severely reduced amniotic fluid volume (oligohydramnios) on amniocentesis",
      "Normal maternal serum markers unless associated anomalies present"
    ],
    "imaging": [
      "Prenatal ultrasound showing absent kidneys and urinary bladder",
      "MRI may confirm absence of renal tissue and pulmonary hypoplasia",
      "Postnatal autopsy or imaging confirms bilateral renal agenesis"
    ],
    "genetic": [
      "WNT9B (causative, loss-of-function)",
      "GREB1L (causative, loss-of-function)",
      "RET (causative, loss-of-function)",
      "ITGA8 (causative)",
      "FGF20 (causative, loss-of-function)",
      "GFRA1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Characteristic Potter sequence features due to oligohydramnios",
      "Perinatal lethality due to pulmonary hypoplasia"
    ]
  },
  "differentialDiagnoses": [
