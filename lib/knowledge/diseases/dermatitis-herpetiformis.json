  "differentialDiagnoses": [
    {
      "diseaseId": "bullous-pemphigoid",
      "distinguishingFeatures": [
        "Tense blisters on flexural surfaces",
        "Linear IgG and C3 deposits on basement membrane zone",
        "Older age group predominance"
      ]
    },
    {
      "diseaseId": "linear-igg-dermatosis",
      "distinguishingFeatures": [
        "Linear IgG deposits along basement membrane",
        "Less pruritic lesions",
        "No association with gluten sensitivity"
      ]
    },
    {
      "diseaseId": "eczema",
      "distinguishingFeatures": [
        "Non-vesicular erythematous plaques",
        "No IgA deposits on immunofluorescence",
        "Variable pruritus without blistering"
      ]
    }
  ],
  "redFlags": [
    "Rapidly spreading blistering lesions",
