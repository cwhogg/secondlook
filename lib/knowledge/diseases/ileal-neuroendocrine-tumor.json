  "keyFindings": {
    "laboratory": [
      "Elevated serum chromogranin A",
      "Increased 24-hour urinary 5-HIAA",
      "Possible mild anemia or electrolyte abnormalities"
    ],
    "imaging": [
      "CT or MRI showing ileal mass and mesenteric lymphadenopathy",
      "Somatostatin receptor scintigraphy (Octreoscan) or 68Ga-DOTATATE PET showing tumor localization",
      "Echocardiography demonstrating right-sided valvular lesions"
    ],
    "genetic": [
      "No consistent germline mutations; mostly sporadic",
      "Rare association with multiple endocrine neoplasia type 1 (MEN1)"
    ],
    "other": [
      "Histopathology with immunohistochemical staining positive for chromogranin A, synaptophysin, and Ki-67 proliferation index for grading"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "gastrointestinal-adenocarcinoma",
      "distinguishingFeatures": [
        "Histology showing adenocarcinoma cells rather than neuroendocrine cells",
        "Lack of hormone-related symptoms such as carcinoid syndrome",
        "Different immunohistochemical profile"
      ]
    },
    {
      "diseaseId": "gastrointestinal-lymphoma",
      "distinguishingFeatures": [
        "Lymphoid cell markers on biopsy",
        "Absence of neuroendocrine markers",
        "Different clinical presentation with systemic B symptoms"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset of carcinoid crisis with severe flushing, hypotension, and bronchospasm",
    "Signs of right-sided heart failure indicating carcinoid heart disease",
    "Acute bowel obstruction or ischemia due to mesenteric fibrosis"
  ],
