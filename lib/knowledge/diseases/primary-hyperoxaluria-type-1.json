  "diagnosticCriteria": {
    "formalCriteriaName": "Primary Hyperoxaluria Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in the AGXT gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-urinary-oxalate",
        "description": "Markedly increased urinary oxalate excretion (>0.7 mmol/1.73 m²/day)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hepatic-glyoxylate-aminotransferase-deficiency",
        "description": "Demonstration of deficient AGT enzyme activity in liver biopsy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "clinical-features",
        "description": "Recurrent nephrolithiasis and nephrocalcinosis in infancy or childhood",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic AGXT mutations plus elevated urinary oxalate excretion",
    "notes": "Liver biopsy for enzyme assay is rarely performed due to availability of genetic testing."
  },
