  "diagnosticCriteria": {
    "formalCriteriaName": "Ménétrier Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enlarged-gastric-folds",
        "description": "Endoscopic evidence of markedly enlarged gastric rugal folds predominantly in the body and fundus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypoproteinemia",
        "description": "Hypoalbuminemia due to protein-losing gastropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Gastric mucosal biopsy showing foveolar hyperplasia with glandular atrophy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-malignancy",
        "description": "Exclusion of gastric malignancy and other causes of hypertrophic gastropathy",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of enlarged gastric folds on endoscopy, hypoalbuminemia, and characteristic histopathology with exclusion of malignancy",
    "notes": "Diagnosis requires correlation of clinical, endoscopic, and histopathologic findings."
  },
