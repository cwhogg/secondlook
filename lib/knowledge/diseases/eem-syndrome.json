  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for EEM Syndrome",
    "criteria": [
      {
        "id": "ectodermal-dysplasia",
        "description": "Presence of ectodermal dysplasia features including abnormal hair, teeth, and nails",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ectrodactyly",
        "description": "Split hand/foot malformation (ectrodactyly) affecting one or more limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "macular-dystrophy",
        "description": "Progressive macular dystrophy leading to visual impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of mutations in the TP63 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: ectodermal dysplasia, ectrodactyly, and macular dystrophy",
    "notes": "Genetic testing for TP63 mutations can support diagnosis but is not mandatory."
  },
