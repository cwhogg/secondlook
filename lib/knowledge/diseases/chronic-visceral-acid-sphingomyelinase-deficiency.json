  "diagnosticCriteria": {
    "formalCriteriaName": "Acid Sphingomyelinase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of reduced acid sphingomyelinase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the SMPD1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of hepatosplenomegaly with or without pulmonary involvement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-foam-cells",
        "description": "Bone marrow biopsy showing foamy macrophages (Niemann-Pick cells)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "differential-exclusion",
        "description": "Exclusion of Niemann-Pick Disease Type A by clinical and enzymatic criteria",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Reduced acid sphingomyelinase activity plus pathogenic SMPD1 variants and clinical evidence of visceral involvement",
    "notes": "Diagnosis relies heavily on enzymatic and genetic testing due to overlapping clinical features with other lysosomal storage diseases."
  },
