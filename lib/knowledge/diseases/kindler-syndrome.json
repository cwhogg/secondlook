  "diagnosticCriteria": {
    "formalCriteriaName": "Kindler Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "blistering-early-life",
        "description": "Congenital or early infancy onset of skin blistering, especially on trauma-exposed areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "photosensitivity",
        "description": "Marked photosensitivity with skin fragility and blistering on sun-exposed areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-poikiloderma",
        "description": "Development of poikiloderma (skin atrophy, telangiectasia, and pigmentary changes) over time",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "kindlin-1-mutation",
        "description": "Identification of biallelic pathogenic variants in the FERMT1 (Kindlin-1) gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mucosal-involvement",
        "description": "Presence of mucosal fragility and stenosis (oral, esophageal, or genital)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing mixed level cleavage and epidermal atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical criteria (early blistering, photosensitivity, progressive poikiloderma) plus identification of FERMT1 mutation or consistent histopathology",
    "notes": "Diagnosis can be challenging due to overlap with other epidermolysis bullosa subtypes; genetic testing is confirmatory."
  },
