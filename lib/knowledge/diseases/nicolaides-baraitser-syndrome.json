  "diagnosticCriteria": {
    "formalCriteriaName": "Nicolaides-Baraitser syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Moderate to severe intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial features including triangular face, sparse scalp hair, thick eyebrows, and prominent nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distal-limb-hypoplasia",
        "description": "Hypoplasia or absence of distal phalanges and prominent interphalangeal joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizures",
        "description": "Epileptic seizures of variable severity",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-delay",
        "description": "Postnatal growth retardation and short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of moderate to severe intellectual disability, characteristic facial features, and distal limb hypoplasia",
    "notes": "Molecular confirmation by identification of pathogenic variants in the SMARCA2 gene supports diagnosis"
  },
