  "keyFindings": {
    "laboratory": [
      "Normal or mildly elevated serum creatine kinase",
      "Electromyography showing myopathic changes"
    ],
    "imaging": [
      "Muscle MRI may show selective muscle involvement but is nonspecific"
    ],
    "genetic": [
      "DBH (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy demonstrating selective type 1 fiber hypotrophy with normal fiber type distribution"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "nemaline-myopathy",
