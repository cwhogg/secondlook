  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Echocardiographic Criteria for Single Ventricle Physiology",
    "criteria": [
      {
        "id": "ventricular-morphology",
        "description": "Presence of only one functional ventricular chamber supporting systemic and pulmonary circulation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "echocardiographic-findings",
        "description": "Echocardiographic evidence of absent or hypoplastic second ventricle",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Cyanosis and signs of congestive heart failure in neonatal period",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-catheterization",
        "description": "Hemodynamic assessment confirming single ventricle physiology and pulmonary blood flow",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of one functional ventricle confirmed by imaging plus clinical signs consistent with single ventricle physiology",
    "notes": "Diagnosis is primarily based on imaging modalities including echocardiography and cardiac MRI."
  },
