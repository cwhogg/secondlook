    "formalCriteriaName": "Proposed Diagnostic Criteria for NET Deficiency-Associated POTS",
    "criteria": [
      {
        "id": "orthostatic-tachycardia",
        "description": "Sustained increase in heart rate ≥30 bpm within 10 minutes of standing or head-up tilt without orthostatic hypotension",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "net-genetic-confirmation",
        "description": "Identification of pathogenic variants in the SLC6A2 gene encoding the norepinephrine transporter",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "symptom-duration",
        "description": "Symptoms of orthostatic intolerance present for at least 6 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-secondary-causes",
        "description": "Exclusion of other causes of orthostatic tachycardia such as dehydration, anemia, or medication effects",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of sustained orthostatic tachycardia, pathogenic SLC6A2 variant, and symptoms lasting ≥6 months",
    "notes": "Diagnosis requires genetic confirmation due to overlap with other POTS etiologies."
  },
