  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase is usually normal or mildly elevated",
      "Electromyography showing myopathic changes"
    ],
    "imaging": [
      "Muscle MRI showing selective muscle involvement and fatty infiltration",
      "Chest X-ray may show atelectasis or hypoventilation-related changes"
    ],
    "genetic": [
      "ACTA1 (causative)",
      "NEB (causative)",
      "KLHL40 (causative, loss-of-function)",
      "KLHL41 (causative, loss-of-function)",
      "LMOD3 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy demonstrating nemaline rods with Gomori trichrome stain",
      "Respiratory function tests showing restrictive pattern"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "congenital-myotonic-dystrophy",
      "distinguishingFeatures": [
        "Presence of myotonia",
        "Characteristic CTG repeat expansion in DMPK gene",
        "Multisystem involvement including cardiac conduction defects"
      ]
    },
    {
      "diseaseId": "central-core-disease",
      "distinguishingFeatures": [
        "Muscle biopsy showing central cores instead of nemaline rods",
        "Usually milder clinical course",
        "Mutations in RYR1 gene"
      ]
    },
    {
      "diseaseId": "congenital-muscular-dystrophy",
      "distinguishingFeatures": [
        "Muscle biopsy showing dystrophic changes",
        "Elevated creatine kinase levels",
        "Genetic mutations in dystrophin or laminin genes"
      ]
    }
  ],
