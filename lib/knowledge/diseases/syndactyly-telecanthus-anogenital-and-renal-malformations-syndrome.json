  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Syndactyly-Telecanthus-Anogenital and Renal Malformations Syndrome",
    "criteria": [
      {
        "id": "telecanthus",
        "description": "Presence of telecanthus (increased distance between medial canthi of the eyes)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "syndactyly",
        "description": "Syndactyly affecting fingers and/or toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anogenital-malformations",
        "description": "Congenital malformations of the anogenital region (e.g., hypospadias, ambiguous genitalia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-malformations",
        "description": "Structural renal anomalies such as renal hypoplasia or dysplasia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Additional facial dysmorphic features including broad nasal bridge and low-set ears",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: telecanthus, syndactyly, and anogenital malformations",
    "notes": "Renal malformations support diagnosis but are not mandatory."
  },
