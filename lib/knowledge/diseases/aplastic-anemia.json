  "diagnosticCriteria": {
    "formalCriteriaName": "Camitta Criteria",
    "criteria": [
      {
        "id": "pancytopenia",
        "description": "Presence of pancytopenia with at least two of the following: hemoglobin <10 g/dL, absolute neutrophil count <1.5 x 10^9/L, platelet count <50 x 10^9/L",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-hypocellularity",
        "description": "Bone marrow biopsy showing hypocellularity (<25% cellularity) without abnormal infiltration or fibrosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other causes of pancytopenia such as myelodysplastic syndrome, leukemia, or marrow infiltration",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "reticulocyte-count",
        "description": "Low reticulocyte count indicating decreased marrow production",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Pancytopenia with at least two cytopenias plus hypocellular bone marrow and exclusion of other causes",
    "notes": "Diagnosis requires bone marrow biopsy and comprehensive hematologic evaluation"
  },
