  "diagnosticCriteria": {
    "formalCriteriaName": "Echocardiographic and clinical diagnostic criteria for TAPVR",
    "criteria": [
      {
        "id": "anomalous-pulmonary-vein-connection",
        "description": "All pulmonary veins connect anomalously to systemic venous circulation instead of left atrium",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "atrial-septal-defect-presence",
        "description": "Presence of an atrial septal defect or patent foramen ovale allowing right-to-left shunting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-venous-obstruction",
        "description": "Evidence of pulmonary venous obstruction on imaging or clinical signs",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of anomalous pulmonary venous connection with an atrial septal defect or patent foramen ovale",
    "notes": "Diagnosis is primarily confirmed by echocardiography and cardiac MRI or CT angiography"
  },
