  "keyFindings": {
    "laboratory": [
      "Elevated fasting insulin and glucose levels indicating insulin resistance",
      "Hypertriglyceridemia with elevated serum triglycerides",
      "Elevated liver enzymes consistent with hepatic steatosis"
    ],
    "imaging": [
      "MRI or CT showing selective loss of subcutaneous fat in limbs and trunk",
      "Ultrasound or MRI evidence of hepatic steatosis"
    ],
    "genetic": [
      "LMNA (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Muscle biopsy rarely performed but may show normal muscle histology",
      "Family pedigree consistent with autosomal dominant inheritance"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "generalized-lipodystrophy",
      "distinguishingFeatures": [
        "Complete loss of adipose tissue rather than partial",
        "Earlier onset in infancy or childhood",
        "Different genetic mutations (e.g., AGPAT2, BSCL2)"
      ]
    },
    {
      "diseaseId": "mandibuloacral-dysplasia",
      "distinguishingFeatures": [
        "Presence of skeletal abnormalities including mandibular hypoplasia",
        "Distinct facial features and skin changes",
        "Mutations in LMNA but with additional systemic involvement"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of insulin resistance despite standard therapy",
    "Severe hypertriglyceridemia with risk of pancreatitis",
    "Early onset cardiovascular disease or cardiomyopathy"
  ],
