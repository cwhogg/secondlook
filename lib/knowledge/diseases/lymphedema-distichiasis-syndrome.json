  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Lymphedema-distichiasis syndrome",
    "criteria": [
      {
        "id": "distichiasis",
        "description": "Presence of an extra row of eyelashes (distichiasis)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lymphedema-lower-extremities",
        "description": "Chronic lymphedema primarily affecting the lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "FOXC2-mutation",
        "description": "Pathogenic mutation in the FOXC2 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "varicose-veins",
        "description": "Presence of varicose veins or venous insufficiency",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both distichiasis and lymphedema, with or without FOXC2 mutation confirmation",
    "notes": "Genetic testing for FOXC2 mutations supports diagnosis but is not mandatory if clinical features are definitive."
  },
