  "diagnosticCriteria": {
    "formalCriteriaName": "8p11.2 Deletion Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of a heterozygous deletion involving the 8p11.2 chromosomal region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial features including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-heart-defect",
        "description": "Identification of congenital heart defects such as atrial or ventricular septal defects",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-anomalies",
        "description": "Presence of skeletal abnormalities including short stature and limb anomalies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 8p11.2 deletion plus at least one major clinical feature",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support but are variable."
  },
