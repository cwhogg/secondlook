  "diagnosticCriteria": {
    "formalCriteriaName": "No formal diagnostic criteria established",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "digital-anomalies",
        "description": "Presence of brachydactyly and clinodactyly affecting fingers and toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genital-abnormalities",
        "description": "Hypoplastic or malformed external genitalia in affected males",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Consanguinity or affected siblings consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the causative gene (not yet fully characterized)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (facial dysmorphism, digital anomalies, and genital abnormalities) with supportive family history or genetic confirmation if available",
    "notes": "Diagnosis is primarily clinical; genetic testing may aid but causative gene is not definitively identified"
  },
