  "diagnosticCriteria": {
    "formalCriteriaName": "Hydranencephaly Diagnostic Criteria",
    "criteria": [
      {
        "id": "imaging-absence-cerebral-hemispheres",
        "description": "Complete or near-complete absence of cerebral hemispheres replaced by cerebrospinal fluid on neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "preserved-brainstem-function",
        "description": "Preserved brainstem and cerebellar structures with intact reflexes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Severe developmental delay or absence of developmental milestones with hypotonia or hypertonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-malformations",
        "description": "Exclusion of other causes of cerebral destruction such as severe hydrocephalus or porencephaly",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic neuroimaging findings with clinical evidence of severe neurological impairment and preserved brainstem function",
    "notes": "Diagnosis is primarily based on neuroimaging (MRI or CT) combined with clinical features."
  },
