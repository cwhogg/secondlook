        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Presence of characteristic craniofacial dysmorphisms such as broad nasal bridge and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both ulna hypoplasia and intellectual disability criteria are required for diagnosis; supportive and minor criteria aid confirmation.",
