  "keyFindings": {
    "laboratory": [
      "Peripheral eosinophilia >10%",
      "Elevated ESR and CRP",
      "Positive ANCA (usually p-ANCA/MPO) in ~40% of cases"
    ],
    "imaging": [
      "Chest X-ray or CT showing transient, patchy pulmonary infiltrates",
      "Sinus CT showing mucosal thickening and polyps"
    ],
    "genetic": [
      "No specific genetic mutation identified; possible HLA associations"
    ],
    "other": [
      "Histopathology showing eosinophilic-rich granulomatous inflammation and necrotizing vasculitis of small to medium vessels"
    ]
  },
  "differentialDiagnoses": [
