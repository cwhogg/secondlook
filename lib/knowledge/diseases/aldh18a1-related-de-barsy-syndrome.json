  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and molecular diagnostic criteria for ALDH18A1-related De Barsy syndrome",
    "criteria": [
      {
        "id": "cutis-laxa",
        "description": "Congenital cutis laxa with loose, wrinkled, and inelastic skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progeroid-facies",
        "description": "Characteristic progeroid facial appearance including prominent forehead, thin nose, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aldh18a1-mutation",
        "description": "Biallelic pathogenic variants in the ALDH18A1 gene confirmed by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuromotor-delay",
        "description": "Developmental delay and hypotonia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ophthalmological-features",
        "description": "Corneal clouding or opacities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital cutis laxa and progeroid facial features plus confirmation of biallelic ALDH18A1 pathogenic variants",
    "notes": "Diagnosis is supported by clinical features and confirmed by molecular genetic testing."
  },
