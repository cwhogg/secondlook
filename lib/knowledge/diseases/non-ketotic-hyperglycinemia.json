  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Non-Ketotic Hyperglycinemia",
    "criteria": [
      {
        "id": "elevated-csf-glycine",
        "description": "Elevated glycine concentration in cerebrospinal fluid (CSF) with increased CSF-to-plasma glycine ratio",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-neonatal-encephalopathy",
        "description": "Severe neonatal encephalopathy with hypotonia, lethargy, and seizures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in glycine cleavage system genes (e.g., GLDC, AMT, GCSH)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-ketosis",
        "description": "Absence of ketosis despite metabolic decompensation",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electroencephalogram-pattern",
        "description": "Burst suppression pattern on EEG in neonatal period",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated CSF glycine with increased CSF-to-plasma glycine ratio plus clinical neonatal encephalopathy and genetic confirmation of glycine cleavage system mutation",
    "notes": "Early diagnosis is critical for management and genetic counseling."
  },
