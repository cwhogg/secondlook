  "keyFindings": {
    "laboratory": [
      "Prolonged bleeding time",
      "Abnormal coagulation profile (e.g., decreased clotting factors)",
      "Iron deficiency anemia",
      "Thrombocytopenia in some cases"
    ],
    "imaging": [
      "Contrast echocardiography showing pulmonary AVMs",
      "CT/MRI revealing cerebral and hepatic AVMs",
      "Angiography confirming arteriovenous malformations"
    ],
    "genetic": [
      "Mutations in ENG (endoglin) gene",
      "Mutations in ACVRL1 (ALK1) gene",
      "Mutations in SMAD4 gene in combined juvenile polyposis-HHT syndrome"
    ],
    "other": [
      "Positive family history consistent with autosomal dominant inheritance",
      "Nasal endoscopy showing telangiectasias"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "idiopathic-telangiectasia",
      "distinguishingFeatures": [
        "Absence of visceral AVMs",
        "No family history",
        "Lack of recurrent epistaxis"
      ]
    },
    {
      "diseaseId": "von-willebrand-disease",
      "distinguishingFeatures": [
        "Coagulation defect without vascular malformations",
        "Normal mucocutaneous telangiectasias",
        "Laboratory evidence of vWF deficiency"
      ]
    }
  ],
  "redFlags": [
    "Sudden onset neurological symptoms indicating cerebral AVM hemorrhage",
    "Massive hemoptysis from pulmonary AVMs",
    "Signs of high-output cardiac failure due to hepatic AVMs"
  ],
