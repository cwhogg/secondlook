  "diagnosticCriteria": {
    "formalCriteriaName": "Seckel Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Severe microcephaly with head circumference significantly below the mean for age and sex",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "primordial-dwarfism",
        "description": "Prenatal and postnatal growth retardation resulting in primordial dwarfism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bird-like-facies",
        "description": "Characteristic bird-like facial appearance including beaked nose and receding chin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal anomalies such as clinodactyly and delayed bone age",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (severe microcephaly, primordial dwarfism, and bird-like facies) with supportive minor criteria",
    "notes": "Genetic testing for mutations in genes such as ATR, RBBP8, or CEP152 can support diagnosis"
  },
