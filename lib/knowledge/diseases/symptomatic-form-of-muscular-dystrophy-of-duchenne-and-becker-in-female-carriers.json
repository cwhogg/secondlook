  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Symptomatic Female Carriers of Duchenne and Becker Muscular Dystrophy",
    "criteria": [
      {
        "id": "clinical-muscle-weakness",
