  "keyFindings": {
    "laboratory": [
      "Marked eosinophilia in peripheral blood",
      "Elevated liver transaminases (AST, ALT)",
      "Presence of atypical lymphocytes",
      "Elevated inflammatory markers (ESR, CRP)",
      "Possible renal function abnormalities (elevated creatinine)"
    ],
    "imaging": [
      "Chest X-ray or CT showing interstitial infiltrates in pneumonitis",
      "Echocardiogram findings consistent with myocarditis",
      "Ultrasound or CT for lymphadenopathy"
    ],
    "genetic": [
      "Association with HLA alleles such as HLA-B*58:01 (allopurinol-induced cases)",
      "HLA-A*31:01 linked to carbamazepine-induced DRESS"
    ],
    "other": [
      "Skin biopsy showing interface dermatitis with eosinophilic infiltration",
      "Improvement upon withdrawal of offending drug"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "stevens-johnson-syndrome",
      "distinguishingFeatures": [
        "More severe mucosal involvement",
        "Extensive epidermal necrosis and detachment",
        "Less prominent eosinophilia"
      ]
    },
    {
      "diseaseId": "acute-generalized-exanthematous-pustulosis",
      "distinguishingFeatures": [
        "Rapid onset pustular rash",
        "Neutrophilia rather than eosinophilia",
        "Shorter duration and quicker resolution"
      ]
    },
    {
      "diseaseId": "hypereosinophilic-syndrome",
      "distinguishingFeatures": [
        "Chronic eosinophilia without drug exposure",
        "Lack of acute rash and systemic symptoms",
        "Different organ involvement pattern"
      ]
    }
  ],
