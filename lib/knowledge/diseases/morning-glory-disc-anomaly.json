  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Morning Glory Disc Anomaly",
    "criteria": [
      {
        "id": "enlarged-excavated-optic-disc",
        "description": "Presence of an enlarged, funnel-shaped excavated optic disc",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "surrounding-pigmentary-changes",
        "description": "Peripapillary pigmentary changes or chorioretinal pigmentary disturbance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "central-glial-tissue",
        "description": "Central white glial tuft or membrane over the optic disc",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vascular-abnormalities",
        "description": "Abnormal radial pattern of retinal vessels emerging from disc margin",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (enlarged excavated optic disc, surrounding pigmentary changes, and central glial tissue) must be present",
    "notes": "Diagnosis is primarily clinical based on fundoscopic examination; imaging may assist in confirmation."
  },
