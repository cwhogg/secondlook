  "diagnosticCriteria": {
    "formalCriteriaName": "Diamond-Blackfan Anemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "pure-red-cell-aplasia",
        "description": "Normocytic or macrocytic anemia with reticulocytopenia and selective absence of erythroid precursors in bone marrow",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as craniofacial, upper limb, or cardiac defects",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-erythrocyte-adenosine-deaminase",
        "description": "Elevated erythrocyte adenosine deaminase (eADA) activity",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic mutation in ribosomal protein genes (e.g., RPS19, RPL5)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pure red cell aplasia with reticulocytopenia and exclusion of other causes of anemia; genetic testing and elevated eADA support diagnosis",
    "notes": "Diagnosis is clinical and laboratory-based; genetic confirmation is supportive but not mandatory."
  },
