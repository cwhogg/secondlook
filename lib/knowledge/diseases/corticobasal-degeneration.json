  "keyFindings": {
    "laboratory": [
      "Routine labs typically normal; used to exclude other causes"
    ],
    "imaging": [
      "MRI showing asymmetric cortical atrophy, especially frontoparietal regions",
      "FDG-PET demonstrating hypometabolism in affected cortical areas"
    ],
    "genetic": [
      "No consistent genetic mutation; some cases linked to MAPT gene variants",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Definitive diagnosis by postmortem neuropathology showing tau-positive astrocytic plaques and ballooned neurons"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "progressive-supranuclear-palsy",
      "distinguishingFeatures": [
        "Vertical gaze palsy",
        "Early postural instability",
        "Symmetric rigidity"
      ]
    },
    {
      "diseaseId": "parkinson-disease",
      "distinguishingFeatures": [
        "Resting tremor common",
        "Good response to levodopa",
        "Symmetric onset less common"
      ]
    },
    {
      "diseaseId": "alzheimer-disease",
      "distinguishingFeatures": [
        "Predominant memory impairment",
        "Symmetric cortical atrophy",
        "Absence of asymmetric rigidity or apraxia early"
      ]
    }
  ],
