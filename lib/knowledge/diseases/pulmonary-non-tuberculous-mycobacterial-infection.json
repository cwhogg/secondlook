  "keyFindings": {
    "laboratory": [
      "Positive acid-fast bacilli (AFB) smear and culture from respiratory specimens",
      "Elevated inflammatory markers (ESR, CRP) in some cases"
    ],
    "imaging": [
      "Chest X-ray showing nodular or cavitary lesions",
      "High-resolution CT scan demonstrating multifocal bronchiectasis and small nodules"
    ],
    "genetic": [
      "No specific genetic markers identified; however, underlying genetic predisposition to bronchiectasis may be present"
    ],
    "other": [
      "Exclusion of Mycobacterium tuberculosis complex by molecular testing",
      "Histopathology showing granulomatous inflammation in lung tissue biopsy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "pulmonary-tuberculosis",
      "distinguishingFeatures": [
        "Positive Mycobacterium tuberculosis culture or PCR",
        "More frequent cavitary lesions in upper lobes",
        "History of exposure to tuberculosis"
      ]
    },
    {
      "diseaseId": "bronchiectasis-secondary-to-cystic-fibrosis",
      "distinguishingFeatures": [
        "CFTR gene mutation testing positive",
        "Pancreatic insufficiency and other systemic features of cystic fibrosis",
        "Early onset in childhood"
      ]
    },
    {
      "diseaseId": "pulmonary-fungal-infection",
      "distinguishingFeatures": [
        "Positive fungal cultures or serology",
        "Different radiographic patterns such as fungal balls or halo sign",
        "Response to antifungal therapy"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of cavitary lung lesions",
