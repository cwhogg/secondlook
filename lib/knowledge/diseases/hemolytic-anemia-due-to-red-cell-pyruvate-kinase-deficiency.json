        "requiredForDiagnosis": true
      },
      {
        "id": "hemolytic-anemia",
        "description": "Clinical evidence of chronic hemolytic anemia with reticulocytosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of hemolytic anemia such as G6PD deficiency or autoimmune hemolysis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced pyruvate kinase enzyme activity and identification of pathogenic PKLR mutations with clinical evidence of hemolytic anemia",
    "notes": "Diagnosis is confirmed by enzymatic assay and genetic testing; family history may support diagnosis."
