  "diagnosticCriteria": {
    "formalCriteriaName": "Ravine Criteria",
    "criteria": [
      {
        "id": "renal-cysts-age-dependent",
        "description": "Presence of multiple bilateral renal cysts detected by ultrasound or imaging, with number of cysts adjusted for patient age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of ADPKD in a first-degree relative",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "extrarenal-manifestations",
        "description": "Presence of extrarenal cysts (e.g., hepatic cysts) or intracranial aneurysms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "At least two renal cysts in one kidney and at least two cysts in the contralateral kidney in individuals aged 30 years or older with a positive family history",
    "notes": "Imaging modalities include ultrasound, CT, or MRI. Genetic testing may support diagnosis but is not mandatory."
  },
