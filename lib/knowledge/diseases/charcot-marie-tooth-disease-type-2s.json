  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Charcot-Marie-Tooth Disease",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive distal muscle weakness and atrophy predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Nerve conduction studies showing axonal neuropathy with normal or mildly reduced conduction velocities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the HSPB1 gene associated with CMT2S",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing neurogenic atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal muscle weakness and atrophy with electrophysiological evidence of axonal neuropathy plus identification of pathogenic HSPB1 mutation",
    "notes": "Diagnosis is confirmed by genetic testing; electrophysiology and clinical features support diagnosis."
  },
