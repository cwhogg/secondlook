  "keyFindings": {
    "laboratory": [
      "Elevated serum lactate and pyruvate levels",
      "Muscle biopsy showing ragged-red fibers and cytochrome c oxidase (COX) negative fibers"
    ],
    "imaging": [
      "MRI brain may show mild cerebral atrophy",
      "Muscle MRI demonstrating fatty infiltration and muscle atrophy"
    ],
    "genetic": [
      "MGME1 (causative, loss-of-function)",
      "Multiple mitochondrial DNA deletions or depletion detected by molecular genetic testing",
      "Mutations in POLG, TWNK, or other mitochondrial maintenance genes",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Electromyography showing myopathic changes",
      "Cardiac conduction studies revealing arrhythmias or conduction blocks"
    ]
  },
