  "diagnosticCriteria": {
    "formalCriteriaName": "20q11.2 Microdeletion Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of a heterozygous microdeletion involving the 20q11.2 chromosomal region by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Presence of global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial dysmorphic features including hypertelorism, broad nasal bridge, and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies such as cardiac defects or skeletal abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 20q11.2 microdeletion plus presence of developmental delay",
    "notes": "Diagnosis relies primarily on genetic testing; clinical features support but are variable."
  },
