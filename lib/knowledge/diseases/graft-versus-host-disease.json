  "keyFindings": {
    "laboratory": [
      "Elevated liver function tests (ALT, AST, ALP, bilirubin)",
      "Cytopenias due to bone marrow involvement",
      "Elevated inflammatory markers (CRP, ESR)"
    ],
    "imaging": [
      "Chest CT showing air trapping and bronchiectasis in bronchiolitis obliterans",
      "Abdominal ultrasound showing hepatomegaly or biliary abnormalities"
    ],
    "genetic": [
      "No specific genetic markers; HLA mismatch between donor and recipient is a risk factor"
    ],
    "other": [
      "Histopathology of skin or mucosal biopsy showing basal cell vacuolization and lymphocytic infiltration",
      "Pulmonary function tests showing obstructive pattern"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "drug-induced-skin-reaction",
      "distinguishingFeatures": [
        "Temporal relation to drug exposure",
        "Lack of systemic organ involvement typical of GVHD",
        "Histopathology inconsistent with GVHD"
      ]
    },
    {
      "diseaseId": "acute-infectious-hepatitis",
      "distinguishingFeatures": [
        "Positive viral serologies",
        "Absence of skin or mucosal involvement",
        "Different histopathological features on liver biopsy"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of liver failure",
    "Severe gastrointestinal bleeding or malabsorption",
    "Respiratory failure due to bronchiolitis obliterans"
  ],
