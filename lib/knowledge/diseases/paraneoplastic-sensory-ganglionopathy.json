  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Paraneoplastic Sensory Ganglionopathy",
    "criteria": [
      {
        "id": "clinical-sensory-neuronopathy",
        "description": "Subacute onset of asymmetric, non-length-dependent sensory deficits predominantly affecting the dorsal root ganglia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "paraneoplastic-antibodies",
        "description": "Presence of paraneoplastic antibodies such as anti-Hu (ANNA-1) in serum or CSF",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "underlying-malignancy",
        "description": "Identification of an underlying malignancy, commonly small cell lung carcinoma or other neuroendocrine tumors",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiological-findings",
        "description": "Electrophysiological studies showing absent or severely reduced sensory nerve action potentials with preserved motor responses",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes of sensory neuropathy such as metabolic, toxic, or infectious etiologies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria (clinical sensory neuronopathy, paraneoplastic antibodies, and underlying malignancy) must be met for diagnosis.",
    "notes": "Early diagnosis is critical for cancer detection and management; antibody testing and electrophysiology aid confirmation."
  },
