  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Spasmus Nutans",
    "criteria": [
      {
        "id": "nystagmus",
        "description": "Presence of high-frequency, low-amplitude, pendular or jerky nystagmus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "head-nodding",
        "description": "Characteristic intermittent head nodding or bobbing movements",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "torticollis",
        "description": "Associated torticollis or abnormal head posture",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-neuroimaging",
        "description": "Absence of intracranial pathology on neuroimaging",
        "category": "supportive",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic nystagmus and head nodding with normal neuroimaging",
    "notes": "Diagnosis requires exclusion of serious intracranial pathology such as optic pathway gliomas or other tumors."
  },
