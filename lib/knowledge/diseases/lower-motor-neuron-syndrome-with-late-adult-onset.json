  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Late-Onset Lower Motor Neuron Syndrome",
    "criteria": [
      {
        "id": "lmn-signs",
        "description": "Presence of progressive lower motor neuron signs including muscle weakness, atrophy, and fasciculations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-umn-signs",
        "description": "Absence of upper motor neuron signs such as spasticity or hyperreflexia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electrophysiology",
        "description": "Electromyography demonstrating denervation and reinnervation consistent with lower motor neuron pathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-course",
        "description": "Progressive course of symptoms over months to years without significant sensory involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of alternative diagnoses such as motor neuron disease with upper motor neuron involvement or peripheral neuropathies",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive lower motor neuron signs with absence of upper motor neuron signs and supportive electrophysiological evidence",
    "notes": "Diagnosis requires careful exclusion of other motor neuron diseases and peripheral neuropathies."
  },
