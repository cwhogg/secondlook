      "Bone marrow aspirate showing binucleated and multinucleated erythroblasts"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hereditary-spherocytosis",
      "distinguishingFeatures": [
        "Spherocytes on peripheral smear",
        "Positive osmotic fragility test",
        "No hypoglycosylation of erythrocyte membrane proteins"
      ]
    },
    {
      "diseaseId": "thalassemia",
      "distinguishingFeatures": [
        "Microcytic hypochromic anemia",
        "Hemoglobin electrophoresis abnormalities",
        "No multinucleated erythroblasts in marrow"
      ]
    },
    {
      "diseaseId": "congenital-dyserythropoietic-anemia-type-i",
      "distinguishingFeatures": [
        "Distinct bone marrow morphology with internuclear chromatin bridges",
        "Different genetic mutations (CDAN1 gene)",
        "More severe anemia and ineffective erythropoiesis"
      ]
    }
  ],
  "redFlags": [
    "Severe anemia refractory to standard treatment",
    "Progressive splenomegaly",
    "Signs of iron overload despite no transfusions"
  ],
