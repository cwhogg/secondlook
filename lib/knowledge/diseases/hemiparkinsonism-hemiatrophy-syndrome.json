  "diagnosticCriteria": {
    "formalCriteriaName": "Hemiparkinsonism-hemiatrophy diagnostic criteria",
    "criteria": [
      {
        "id": "unilateral-parkinsonism",
        "description": "Presence of unilateral parkinsonian motor symptoms (rigidity, bradykinesia, resting tremor)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "contralateral-hemiatrophy",
        "description": "Unilateral hemiatrophy affecting limbs or trunk contralateral to parkinsonism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-secondary-causes",
        "description": "Exclusion of secondary causes such as stroke, trauma, or neurodegenerative diseases",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-imaging",
        "description": "Neuroimaging showing asymmetric brain changes corresponding to clinical findings",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "slow-progression",
        "description": "Slow progression of symptoms over years without rapid deterioration",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of unilateral parkinsonism and contralateral hemiatrophy with exclusion of secondary causes",
    "notes": "Diagnosis is clinical supported by imaging and exclusion of mimics"
  },
