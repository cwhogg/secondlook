      ]
    },
    {
      "diseaseId": "spinal-muscular-atrophy-type-iii",
      "distinguishingFeatures": [
        "Progressive muscle weakness without epilepsy",
        "SMN1 gene mutations"
      ]
    },
    {
      "diseaseId": "lafora-disease",
      "distinguishingFeatures": [
        "Rapidly progressive myoclonic epilepsy with cognitive decline but no spinal muscular atrophy",
        "Presence of Lafora bodies on biopsy"
      ]
    }
  ],
