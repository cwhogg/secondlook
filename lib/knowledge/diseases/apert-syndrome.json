  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Apert Syndrome",
    "criteria": [
      {
        "id": "craniosynostosis",
        "description": "Premature fusion of coronal sutures leading to brachycephaly or acrocephaly",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "syndactyly",
        "description": "Complex syndactyly of hands and feet involving fusion of bones and soft tissues",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fgfr2-mutation",
        "description": "Presence of pathogenic FGFR2 gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "midface-hypoplasia",
        "description": "Midfacial retrusion or hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "intellectual-disability",
        "description": "Variable degrees of intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of craniosynostosis, syndactyly of hands and feet, and confirmed FGFR2 mutation",
    "notes": "Diagnosis is primarily clinical supported by genetic testing; prenatal diagnosis possible via molecular analysis."
  },
