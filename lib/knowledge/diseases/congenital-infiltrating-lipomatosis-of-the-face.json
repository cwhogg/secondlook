  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Congenital Infiltrating Lipomatosis of the Face",
    "criteria": [
      {
        "id": "unilateral-facial-lipomatous-infiltration",
        "description": "Presence of unilateral, diffuse, infiltrating adipose tissue proliferation in the facial region",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "soft-tissue-hypertrophy",
        "description": "Soft tissue hypertrophy of the affected side of the face including muscles and subcutaneous tissues",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-encapsulation",
        "description": "Lack of encapsulation of the lipomatous tissue on histopathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "early-onset",
        "description": "Congenital or early infancy onset of facial swelling",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "bony-hypertrophy",
        "description": "Associated bony hypertrophy of the facial skeleton on imaging",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of unilateral infiltrating adipose tissue proliferation with soft tissue hypertrophy and absence of encapsulation confirmed by histopathology",
    "notes": "Diagnosis is primarily clinical supported by imaging and histopathology; genetic testing is not routinely diagnostic."
  },
