  "diagnosticCriteria": {
    "formalCriteriaName": "SANDO Diagnostic Criteria",
    "criteria": [
      {
        "id": "sensory-ataxia",
        "description": "Presence of sensory ataxia evidenced by impaired proprioception and gait disturbance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysarthria",
        "description": "Progressive dysarthria affecting speech articulation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ophthalmoparesis",
        "description": "Chronic progressive external ophthalmoplegia with limited eye movement",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mitochondrial-dna-mutation",
        "description": "Identification of pathogenic mitochondrial DNA mutations (e.g., POLG gene mutations)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electrophysiology",
        "description": "Electrophysiological evidence of sensory neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: sensory ataxia, dysarthria, and ophthalmoparesis",
    "notes": "Genetic testing and electrophysiological studies support diagnosis but are not mandatory"
  },
