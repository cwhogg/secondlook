  "diagnosticCriteria": {
    "formalCriteriaName": "2013 ACR/EULAR Classification Criteria for Systemic Sclerosis",
    "criteria": [
      {
        "id": "skin-thickening",
        "description": "Skin thickening of the fingers of both hands extending proximal to the metacarpophalangeal joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sclerodactyly",
        "description": "Skin thickening limited to the fingers (sclerodactyly)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "digital-pitting-scars",
        "description": "Digital tip ulcers or pitting scars",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "telangiectasia",
        "description": "Presence of telangiectasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "abnormal-nailfold-capillaries",
        "description": "Abnormal nailfold capillaries detected by capillaroscopy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pulmonary-arterial-hypertension",
        "description": "Pulmonary arterial hypertension or interstitial lung disease",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "autoantibodies",
        "description": "Presence of specific autoantibodies (anticentromere, anti-topoisomerase I, anti-RNA polymerase III)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Skin thickening of the fingers extending proximal to the MCP joints OR a total score of ≥9 from the weighted criteria",
    "notes": "Criteria combine clinical features, capillaroscopy, and serology to improve diagnostic accuracy."
  },
