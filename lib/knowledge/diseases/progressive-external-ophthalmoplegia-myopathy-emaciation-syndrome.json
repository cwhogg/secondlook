  "diagnosticCriteria": {
    "formalCriteriaName": "Progressive External Ophthalmoplegia Diagnostic Criteria",
    "criteria": [
      {
        "id": "external-ophthalmoplegia",
        "description": "Progressive bilateral external ophthalmoplegia characterized by limitation of eye movements",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-myopathy",
        "description": "Presence of proximal skeletal muscle weakness and histopathological evidence of mitochondrial myopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "emaciation",
        "description": "Progressive severe weight loss and muscle wasting not explained by other causes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mitochondrial-dna-abnormalities",
        "description": "Detection of multiple mitochondrial DNA deletions or depletion in muscle biopsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of mitochondrial disorders or similar phenotype",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: progressive external ophthalmoplegia, skeletal myopathy, and emaciation",
    "notes": "Genetic testing and muscle biopsy are essential for confirmation"
  },
