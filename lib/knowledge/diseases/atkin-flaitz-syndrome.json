  "diagnosticCriteria": {
    "formalCriteriaName": "Atkin-Flaitz Diagnostic Criteria",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Presence of characteristic craniofacial dysmorphic features including hypertelorism and midface hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "progressive-neurological-decline",
        "description": "Progressive neurological deterioration with developmental delay and hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Radiological evidence of skeletal abnormalities such as scoliosis and joint contractures",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the AFS1 gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "supportive-features",
        "description": "Presence of supportive clinical features including seizures and feeding difficulties",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical criteria (craniofacial dysmorphism, progressive neurological decline, and skeletal abnormalities) or genetic confirmation with two major clinical features",
    "notes": "Genetic testing is recommended to confirm diagnosis but is not mandatory if clinical criteria are fully met."
  },
