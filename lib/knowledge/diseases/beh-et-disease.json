  "diagnosticCriteria": {
    "formalCriteriaName": "International Criteria for Behçet's Disease (ICBD)",
    "criteria": [
      {
        "id": "oral-ulcers",
        "description": "Recurrent oral aphthous ulcers observed at least three times in 12 months",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genital-ulcers",
        "description": "Recurrent genital ulcers",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-inflammation",
        "description": "Anterior or posterior uveitis, or retinal vasculitis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "skin-lesions",
        "description": "Erythema nodosum, pseudofolliculitis, or papulopustular lesions",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "positive-pathergy-test",
        "description": "Positive pathergy skin hypersensitivity test",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "vascular-involvement",
        "description": "Venous thrombosis or arterial aneurysms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent oral ulcers plus at least two other criteria including genital ulcers, ocular inflammation, skin lesions, or positive pathergy test",
    "notes": "Diagnosis is clinical; no definitive laboratory test exists."
  },
