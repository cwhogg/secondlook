    "formalCriteriaName": "Spinocerebellar Ataxia Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with gait and limb coordination impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in KCND3 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected family members",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-ataxias",
        "description": "Exclusion of other causes of ataxia by clinical and laboratory evaluation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia plus genetic confirmation of KCND3 mutation",
    "notes": "Genetic testing is essential for definitive diagnosis due to phenotypic overlap with other SCAs."
  },
