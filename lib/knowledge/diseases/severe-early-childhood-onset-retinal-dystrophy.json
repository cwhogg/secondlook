  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electroretinographic Diagnostic Criteria for Severe Early-Childhood-Onset Retinal Dystrophy",
    "criteria": [
      {
        "id": "early-onset-vision-loss",
        "description": "Onset of severe visual impairment within the first 5 years of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electroretinogram-non-detectable",
        "description": "Non-detectable or severely reduced electroretinogram (ERG) responses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fundus-abnormalities",
        "description": "Characteristic fundus changes including retinal pigment epithelium atrophy and vascular attenuation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with early-onset retinal dystrophies (e.g., RPE65, CRB1)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-systemic-features",
        "description": "Lack of systemic or syndromic manifestations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset severe visual impairment with non-detectable ERG and characteristic fundus abnormalities",
    "notes": "Genetic testing is recommended to confirm diagnosis and guide prognosis."
  },
