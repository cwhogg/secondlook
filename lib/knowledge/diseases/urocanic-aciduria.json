    "formalCriteriaName": "Urocanic Aciduria Diagnostic Criteria",
    "criteria": [
      {
        "id": "elevated-urocanic-acid",
        "description": "Elevated levels of urocanic acid in urine detected by metabolic screening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urocanase-enzyme-deficiency",
        "description": "Demonstration of reduced or absent urocanase enzyme activity in fibroblasts or liver tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the UROC1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of mild developmental delay or neurological symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of elevated urocanic acid in urine plus either confirmed urocanase enzyme deficiency or pathogenic UROC1 gene variants",
    "notes": "Diagnosis is primarily biochemical and genetic; clinical symptoms may be mild or absent."
