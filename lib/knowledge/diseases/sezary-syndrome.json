  "differentialDiagnoses": [
    {
      "diseaseId": "mycosis-fungoides",
      "distinguishingFeatures": [
        "Patch and plaque stage skin lesions without significant blood involvement",
        "Absence or low levels of circulating Sezary cells",
        "Slower progression compared to Sezary syndrome"
      ]
    },
    {
      "diseaseId": "psoriasis",
      "distinguishingFeatures": [
        "Well-demarcated erythematous plaques with silvery scale",
        "No circulating malignant T cells",
        "Lack of generalized lymphadenopathy"
      ]
    },
    {
      "diseaseId": "atopic-dermatitis",
      "distinguishingFeatures": [
        "History of atopy and allergic conditions",
        "Localized or generalized eczema without malignant cells",
        "No lymphadenopathy or blood involvement"
      ]
    }
