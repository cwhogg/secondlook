  "diagnosticCriteria": {
    "formalCriteriaName": "Multiminicore Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of multiple small cores with reduced oxidative enzyme activity on muscle biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Congenital or early childhood onset of axial and proximal muscle weakness with hypotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with multiminicore myopathy (e.g., SEPN1, RYR1)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "Myopathic changes on electromyography supportive of diagnosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-involvement",
        "description": "Evidence of restrictive respiratory insufficiency",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic muscle biopsy findings plus compatible clinical presentation; genetic confirmation supports diagnosis",
    "notes": "Genetic testing is recommended but not mandatory; respiratory assessment is important for management."
  },
