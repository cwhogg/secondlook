  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Exclusion of metabolic causes of neuropathy"
    ],
    "imaging": [
      "MRI may show muscle atrophy in distal limbs",
      "Spine imaging to assess scoliosis if present"
    ],
    "genetic": [
      "MFN2 (causative)",
      "Autosomal dominant inheritance pattern"
    ],
    "other": [
      "Electromyography showing chronic denervation",
      "Nerve biopsy demonstrating axonal degeneration"
    ]
  },
  "differentialDiagnoses": [
