  "keyFindings": {
    "laboratory": [
      "Elevated serum creatinine and blood urea nitrogen indicating renal impairment",
      "Positive ANCA serology (MPO-ANCA or PR3-ANCA)",
      "Active urinary sediment with hematuria and red blood cell casts",
      "Mild to moderate proteinuria"
    ],
    "imaging": [
      "Chest X-ray or CT may show pulmonary infiltrates or hemorrhage in systemic involvement"
    ],
    "genetic": [
      "No specific genetic markers; some HLA associations reported in ANCA-associated vasculitis"
    ],
    "other": [
      "Renal biopsy showing necrotizing glomerulonephritis with minimal immune deposits (pauci-immune pattern)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "anti-glomerular-basement-membrane-disease",
      "distinguishingFeatures": [
        "Presence of anti-GBM antibodies",
        "Linear IgG deposits on renal biopsy immunofluorescence",
        "Often more aggressive pulmonary hemorrhage"
      ]
    },
    {
      "diseaseId": "immune-complex-glomerulonephritis",
      "distinguishingFeatures": [
        "Immune complex deposits visible on immunofluorescence or electron microscopy",
        "Associated with systemic lupus erythematosus or infections",
        "Different serologic markers (e.g., ANA, complement levels)"
      ]
    }
  ],
  "redFlags": [
    "Rapidly worsening renal function over days to weeks",
    "Presence of pulmonary hemorrhage or respiratory distress",
    "Severe hypertension with signs of hypertensive emergency"
  ],
