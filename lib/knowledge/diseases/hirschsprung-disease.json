  "diagnosticCriteria": {
    "formalCriteriaName": "Standard Diagnostic Criteria for Hirschsprung Disease",
    "criteria": [
      {
        "id": "aganglionosis",
        "description": "Histopathological confirmation of absence of enteric ganglion cells in rectal biopsy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "functional-obstruction",
        "description": "Clinical evidence of functional intestinal obstruction with delayed meconium passage",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-transition-zone",
        "description": "Radiologic identification of transition zone on contrast enema",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "anorectal-manometry",
        "description": "Absence of rectoanal inhibitory reflex on anorectal manometry",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of aganglionosis plus clinical evidence of functional obstruction",
    "notes": "Rectal suction biopsy is gold standard; imaging and manometry support diagnosis"
  },
