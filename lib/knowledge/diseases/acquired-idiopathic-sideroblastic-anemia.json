  "diagnosticCriteria": {
    "formalCriteriaName": "Sideroblastic Anemia Diagnostic Criteria",
    "criteria": [
      {
        "id": "ringed-sideroblasts",
        "description": "Presence of ringed sideroblasts in bone marrow iron stain",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "anemia",
        "description": "Macrocytic or normocytic anemia with ineffective erythropoiesis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-secondary-causes",
        "description": "Exclusion of secondary causes such as alcohol, drugs, or toxins",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "iron-overload",
        "description": "Evidence of systemic iron overload without hereditary hemochromatosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "normal-karyotype",
        "description": "Absence of clonal cytogenetic abnormalities associated with myelodysplastic syndromes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of ringed sideroblasts in bone marrow and anemia with exclusion of secondary causes",
    "notes": "Diagnosis requires bone marrow biopsy with iron staining and clinical exclusion of other causes."
  },
