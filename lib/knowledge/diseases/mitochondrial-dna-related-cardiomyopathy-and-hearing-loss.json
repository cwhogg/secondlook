  "diagnosticCriteria": {
    "formalCriteriaName": "Mitochondrial Cardiomyopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "cardiomyopathy",
        "description": "Presence of cardiomyopathy confirmed by echocardiography or cardiac MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss documented by audiometry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mtDNA-mutation",
        "description": "Identification of pathogenic mitochondrial DNA mutation associated with cardiomyopathy and hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing ragged-red fibers or cytochrome c oxidase deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Maternal inheritance pattern consistent with mitochondrial DNA mutation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of cardiomyopathy, bilateral sensorineural hearing loss, and a pathogenic mtDNA mutation",
    "notes": "Diagnosis may be supported by muscle biopsy findings and maternal family history."
  },
