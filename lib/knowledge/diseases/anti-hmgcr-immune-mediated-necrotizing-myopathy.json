        "Presence of myositis-specific autoantibodies other than anti-HMGCR"
      ]
    },
    {
      "diseaseId": "polymyositis",
      "distinguishingFeatures": [
        "More prominent endomysial inflammation on biopsy",
        "Absence of anti-HMGCR antibodies",
        "Less frequent necrosis compared to IMNM"
      ]
    },
    {
      "diseaseId": "statin-induced toxic myopathy",
      "distinguishingFeatures": [
        "Improvement after statin discontinuation without immunosuppressive therapy",
        "Absence of anti-HMGCR antibodies",
        "Lack of muscle necrosis on biopsy"
      ]
    }
