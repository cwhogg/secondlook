  "diagnosticCriteria": {
    "formalCriteriaName": "NARP Diagnostic Criteria",
    "criteria": [
      {
        "id": "sensory-neuropathy",
        "description": "Presence of sensory neuropathy confirmed by clinical and electrophysiological studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-ataxia",
        "description": "Clinical evidence of cerebellar ataxia including gait and limb coordination abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "retinitis-pigmentosa",
        "description": "Pigmentary retinopathy demonstrated by ophthalmological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mtDNA-mutation",
        "description": "Detection of pathogenic mitochondrial DNA mutation, commonly m.8993T>G or m.8993T>C",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history consistent with mitochondrial inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: sensory neuropathy, cerebellar ataxia, and retinitis pigmentosa",
    "notes": "Genetic testing for mitochondrial DNA mutations supports diagnosis but is not mandatory if clinical criteria are met."
  },
