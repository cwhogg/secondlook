  "diagnosticCriteria": {
    "formalCriteriaName": "Schinzel-Giedion Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "midface-retraction",
        "description": "Characteristic midface retraction with prominent forehead",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-anomalies",
        "description": "Multiple skeletal anomalies including broad ribs and vertebral abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurodevelopmental-delay",
        "description": "Severe neurodevelopmental delay and intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "increased-tumor-risk",
        "description": "Increased risk of embryonal tumors such as neuroblastoma and Wilms tumor",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "seizures",
        "description": "Recurrent seizures or epilepsy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (midface retraction, skeletal anomalies, and neurodevelopmental delay) with or without supportive features",
    "notes": "Genetic confirmation of SETBP1 mutation supports diagnosis but is not mandatory"
  },
