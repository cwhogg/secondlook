        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-cholestatic-diseases",
        "description": "Exclusion of other causes of cholestasis including viral hepatitis, autoimmune liver disease, and obstructive causes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent intrahepatic cholestasis episodes with pruritus and jaundice, normal liver function between episodes, and identification of ABCB11 gene mutations",
    "notes": "Liver biopsy is generally not required but may show canalicular cholestasis during episodes."
