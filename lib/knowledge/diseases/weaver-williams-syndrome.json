  "diagnosticCriteria": {
    "formalCriteriaName": "Weaver-Williams Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "accelerated-growth",
        "description": "Postnatal accelerated growth with advanced bone age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facies",
        "description": "Distinctive craniofacial features including broad forehead, large ears, and prominent chin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurodevelopmental-delay",
        "description": "Global developmental delay with hypotonia and motor skill impairment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "camptodactyly",
        "description": "Camptodactyly or clinodactyly of fingers",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "scoliosis",
        "description": "Presence of scoliosis or other skeletal abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: accelerated growth, characteristic facies, and neurodevelopmental delay",
    "notes": "Genetic testing for EZH2 mutations can support diagnosis but is not mandatory"
  },
