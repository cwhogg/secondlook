  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria established",
    "criteria": [
      {
        "id": "multifocal-cutaneous-vascular-lesions",
        "description": "Presence of multifocal cutaneous vascular tumors characterized by lymphangioendotheliomatosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thrombocytopenia",
        "description": "Persistent thrombocytopenia often associated with platelet trapping in vascular lesions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathological-confirmation",
        "description": "Histopathological confirmation of lymphangioendotheliomatosis from biopsy specimens",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-coagulopathy-or-infection",
        "description": "Exclusion of other causes of thrombocytopenia such as coagulopathy or infection",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "imaging-demonstrating-multifocal-lesions",
        "description": "Imaging evidence of multifocal vascular lesions in skin and/or internal organs",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multifocal cutaneous vascular lesions with thrombocytopenia and histopathological confirmation of lymphangioendotheliomatosis",
    "notes": "Diagnosis is clinical and histopathological; genetic testing is not currently established."
  },
