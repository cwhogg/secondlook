      "Anemia of chronic disease"
    ],
    "imaging": [
      "Radiographs showing spondyloepiphyseal dysplasia",
      "Brain MRI may show ischemic changes",
      "Renal ultrasound showing small echogenic kidneys"
    ],
    "genetic": [
      "SMARCAL1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Characteristic facial features",
      "Progressive growth failure"
    ]
  },
