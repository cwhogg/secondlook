  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Fluorescein angiography showing telangiectatic capillaries and late leakage",
      "Optical coherence tomography (OCT) revealing intraretinal cavitations and retinal thinning",
      "Fundus autofluorescence demonstrating macular pigment loss"
    ],
    "genetic": [
      "No definitive genetic mutation identified; possible familial aggregation reported"
    ],
    "other": [
      "Clinical examination revealing loss of retinal transparency and right-angle venules"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "diabetic-retinopathy",
      "distinguishingFeatures": [
        "Presence of systemic diabetes mellitus",
        "Diffuse retinal hemorrhages and microaneurysms",
        "Widespread retinal ischemia rather than juxtafoveal telangiectasia"
      ]
    },
    {
      "diseaseId": "retinal-vein-occlusion",
      "distinguishingFeatures": [
        "Sudden vision loss onset",
        "Retinal hemorrhages in a vascular distribution",
        "Absence of characteristic right-angle venules"
      ]
    }
  ],
  "redFlags": [
