  "keyFindings": {
    "laboratory": [
      "Elevated free thyroxine (T4) and triiodothyronine (T3)",
      "Suppressed thyroid-stimulating hormone (TSH)",
      "Positive thyroid-stimulating immunoglobulins (TSI) or TSH receptor antibodies"
    ],
    "imaging": [
      "Diffuse increased uptake on radioactive iodine thyroid scan",
      "Ultrasound showing diffusely enlarged thyroid gland without nodules",
      "Orbital MRI or CT showing extraocular muscle enlargement in ophthalmopathy"
    ],
    "genetic": [
      "Association with HLA-DR3 and other autoimmune susceptibility genes"
    ],
    "other": [
      "Elevated heart rate on ECG",
      "Possible presence of Graves ophthalmopathy signs on clinical exam"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "hashimoto-thyroiditis",
      "distinguishingFeatures": [
        "Presence of hypothyroidism rather than hyperthyroidism",
        "Positive anti-thyroid peroxidase (TPO) antibodies",
        "Typically no diffuse goiter with hyperactivity"
      ]
    },
    {
      "diseaseId": "toxic-nodular-goiter",
      "distinguishingFeatures": [
        "Presence of nodules on thyroid imaging",
        "Radioactive iodine uptake localized to nodules rather than diffuse",
        "Usually occurs in older children or adults"
      ]
    },
    {
      "diseaseId": "thyroiditis (subacute or silent)",
      "distinguishingFeatures": [
        "Painful or tender thyroid gland (subacute)",
        "Transient hyperthyroidism followed by hypothyroidism",
        "Low or absent radioactive iodine uptake"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset of severe tachycardia or arrhythmia",
    "Signs of thyroid storm including hyperthermia and altered mental status",
    "Severe ophthalmopathy with vision changes"
  ],
