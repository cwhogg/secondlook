  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible hypothyroidism on thyroid panel"
    ],
    "imaging": [
      "Brain MRI may show nonspecific white matter abnormalities",
      "Echocardiogram may reveal congenital heart defects"
    ],
    "genetic": [
      "Triplication of distal 15q region detected by chromosomal microarray or FISH",
      "No known single gene mutation; chromosomal structural abnormality"
    ],
    "other": [
      "Neurodevelopmental assessment confirming intellectual disability",
      "EEG abnormalities consistent with epilepsy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "15q11-q13-duplication-syndrome",
      "distinguishingFeatures": [
        "Duplication involves proximal 15q11-q13 region rather than distal 15q",
        "More frequent seizures and autism spectrum disorder",
        "Different facial dysmorphisms"
      ]
    },
    {
      "diseaseId": "prader-willi-syndrome",
      "distinguishingFeatures": [
        "Deletion or uniparental disomy of 15q11-q13",
        "Characteristic neonatal hypotonia with feeding difficulties followed by hyperphagia and obesity",
        "Distinct behavioral phenotype"
      ]
    }
  ],
  "redFlags": [
