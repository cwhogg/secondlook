  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible metabolic acidosis in some cases"
    ],
    "imaging": [
      "Radiographs showing bowing and cortical thickening of long bones",
      "Osteopenia on bone density scans"
    ],
    "genetic": [
      "LIFR (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Abnormal autonomic function tests",
      "Electrocardiogram may show arrhythmias"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "camurati-engelmann-disease",
      "distinguishingFeatures": [
        "Progressive diaphyseal dysplasia with adult onset",
        "Absence of autonomic dysfunction",
        "Different genetic mutations (TGFB1 gene)"
      ]
    },
    {
      "diseaseId": "craniodiaphyseal-dysplasia",
      "distinguishingFeatures": [
        "Severe craniofacial hyperostosis",
        "No autonomic instability",
        "Distinct radiographic skull changes"
      ]
    },
    {
      "diseaseId": "caffey-disease",
      "distinguishingFeatures": [
        "Infantile cortical hyperostosis with soft tissue swelling",
        "Self-limited course",
        "No autonomic dysfunction"
      ]
    }
  ],
  "redFlags": [
    "Severe respiratory distress in neonatal period",
    "Temperature instability with risk of hyperthermia",
    "Multiple long bone fractures with bowing at birth"
  ],
