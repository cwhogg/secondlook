  "diagnosticCriteria": {
    "formalCriteriaName": "Bartsocas-Papas syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "facial-clefts",
        "description": "Presence of bilateral or unilateral orofacial clefts including cleft lip and/or palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "popliteal-pterygia",
        "description": "Popliteal pterygia causing webbing behind the knees",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "syndactyly",
        "description": "Syndactyly or fusion of fingers and/or toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genital-anomalies",
        "description": "Genital malformations such as cryptorchidism or hypoplastic genitalia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Prenatal and postnatal growth retardation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: orofacial clefts, popliteal pterygia, and syndactyly",
    "notes": "Genetic testing for RIPK4 mutations can confirm diagnosis"
  },
