    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Presence of ambiguous or female external genitalia in 46,XY individuals with normal female internal genitalia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hormonal-profile",
        "description": "Elevated serum luteinizing hormone (LH) levels with low or absent testosterone production",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in the LHCGR gene confirming LH receptor loss-of-function",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-findings",
        "description": "Hypoplastic or absent Leydig cells on testicular biopsy or imaging evidence of gonadal hypoplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Clinical presentation consistent with Leydig cell hypoplasia plus elevated LH and low testosterone levels, confirmed by genetic testing of LHCGR mutations",
    "notes": "Diagnosis requires exclusion of other causes of 46,XY disorders of sex development."
