  "diagnosticCriteria": {
    "formalCriteriaName": "No standardized formal criteria; diagnosis based on clinical, laboratory, and genetic findings",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutation in XIAP (BIRC4) gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hlh-clinical-features",
        "description": "Clinical features consistent with hemophagocytic lymphohistiocytosis (HLH), including fever, splenomegaly, cytopenias",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunologic-dysregulation",
        "description": "Evidence of immune dysregulation such as hypogammaglobulinemia or defective apoptosis assays",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic XIAP mutation plus clinical features consistent with HLH or immune dysregulation",
    "notes": "Diagnosis requires integration of genetic testing with clinical and laboratory findings due to phenotypic variability."
  },
