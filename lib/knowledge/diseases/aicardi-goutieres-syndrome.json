  "diagnosticCriteria": {
    "formalCriteriaName": "Aicardi-Goutieres Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "early-onset-encephalopathy",
        "description": "Early-onset progressive encephalopathy with developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intracranial-calcifications",
        "description": "Basal ganglia and other intracranial calcifications on neuroimaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chronic-csf-lymphocytosis",
        "description": "Chronic lymphocytosis and elevated interferon-alpha in cerebrospinal fluid",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "chilblain-lesions",
        "description": "Presence of chilblain-like skin lesions",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic mutations in AGS-associated genes (e.g., TREX1, RNASEH2A-D, SAMHD1, ADAR1, IFIH1)",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset encephalopathy, intracranial calcifications, chronic CSF lymphocytosis or elevated interferon-alpha, plus genetic confirmation or characteristic skin lesions",
    "notes": "Diagnosis is supported by neuroimaging, CSF studies, and genetic testing; clinical presentation may vary."
  },
