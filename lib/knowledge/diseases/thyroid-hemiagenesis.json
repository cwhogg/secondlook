  "diagnosticCriteria": {
    "formalCriteriaName": "Ultrasound and scintigraphy-based diagnostic criteria for thyroid hemiagenesis",
    "criteria": [
      {
        "id": "unilateral-absence",
        "description": "Absence of one thyroid lobe confirmed by high-resolution ultrasound",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "contralateral-lobe-presence",
        "description": "Presence of a normally or hypertrophically developed contralateral thyroid lobe",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-thyroid-tissue-on-scintigraphy",
        "description": "No functional thyroid tissue detected on the side of agenesis by radionuclide thyroid scintigraphy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-thyroid-function",
        "description": "Euthyroid or compensated thyroid function in most cases",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of unilateral thyroid lobe absence on ultrasound and absence of functional tissue on scintigraphy with confirmation of contralateral lobe presence",
    "notes": "Diagnosis is primarily imaging-based; genetic testing is not routinely performed."
  },
