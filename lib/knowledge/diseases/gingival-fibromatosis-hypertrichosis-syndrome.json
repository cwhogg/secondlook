  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Gingival Fibromatosis-Hypertrichosis Syndrome",
    "criteria": [
      {
        "id": "gingival-fibromatosis",
        "description": "Presence of generalized gingival fibromatosis characterized by firm, non-hemorrhagic gingival overgrowth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypertrichosis",
        "description": "Excessive terminal hair growth (hypertrichosis) involving the face, extremities, and sometimes trunk",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-mental-retardation",
        "description": "Normal cognitive development without intellectual disability",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Mild facial dysmorphic features including coarse facial appearance and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of generalized gingival fibromatosis and hypertrichosis with or without family history",
    "notes": "Diagnosis is primarily clinical; genetic testing may assist but no specific gene identified"
  },
