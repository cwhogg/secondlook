  "keyFindings": {
    "laboratory": [
      "Microscopic or macroscopic hematuria on urinalysis",
      "Orthostatic proteinuria",
      "Anemia secondary to chronic blood loss"
    ],
    "imaging": [
      "Doppler ultrasound showing left renal vein compression and elevated velocity ratio",
      "CT angiography demonstrating left renal vein entrapment between the superior mesenteric artery and aorta",
      "Venography confirming elevated pressure gradient across the left renal vein"
    ],
    "genetic": [],
    "other": [
      "Pelvic venography showing pelvic varices in females",
      "Physical exam revealing varicocele in males"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "renal-vein-thrombosis",
      "distinguishingFeatures": [
        "Presence of thrombus in renal vein on imaging",
        "Acute onset flank pain with hematuria",
        "Absence of left renal vein compression by SMA"
      ]
    },
    {
      "diseaseId": "glomerulonephritis",
      "distinguishingFeatures": [
        "Urinalysis showing red blood cell casts",
        "Elevated serum creatinine and abnormal serologies",
        "No evidence of vascular compression on imaging"
      ]
    },
    {
      "diseaseId": "pelvic-congestion-syndrome",
      "distinguishingFeatures": [
        "Pelvic pain without renal vein compression",
        "Varices localized to pelvic veins",
        "More prominent in multiparous women"
      ]
    }
  ],
  "redFlags": [
    "Severe macroscopic hematuria with clot retention",
    "Progressive renal function decline",
    "Uncontrolled hypertension secondary to renal ischemia"
  ],
