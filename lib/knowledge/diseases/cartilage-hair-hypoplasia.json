  "keyFindings": {
    "laboratory": [
      "Lymphopenia with decreased T-cell counts",
      "Anemia with variable severity",
      "Hypogammaglobulinemia in some patients"
    ],
    "imaging": [
      "Metaphyseal dysplasia visible on long bone X-rays",
      "Shortened tubular bones with flared metaphyses"
    ],
    "genetic": [
      "RMRP (causative)",
      "Pathogenic mutations in the RMRP gene (RNA component of mitochondrial RNA processing endoribonuclease)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Bone marrow biopsy may show hypoplastic marrow",
      "Hair microscopy reveals thin, sparse hair shafts"
    ]
  },
