  "diagnosticCriteria": {
    "formalCriteriaName": "Multiminicore Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-myopathy",
        "description": "Presence of proximal muscle weakness with predominant involvement of hand muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy-cores",
        "description": "Muscle biopsy demonstrating multiple small areas of sarcomeric disorganization (minicores)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in RYR1 or SEPN1 genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "Electromyographic evidence of myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-involvement",
        "description": "Evidence of restrictive respiratory insufficiency",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical myopathy with hand involvement plus muscle biopsy showing minicores; genetic confirmation supports diagnosis",
    "notes": "Genetic testing is recommended but not mandatory if clinical and histopathological features are definitive."
  },
