  "diagnosticCriteria": {
    "formalCriteriaName": "McAdam Criteria (modified by Damiani and Levine)",
    "criteria": [
      {
        "id": "auricular-chondritis",
        "description": "Recurrent inflammation of the auricular cartilage",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "nasal-chondritis",
        "description": "Nasal cartilage inflammation causing saddle-nose deformity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-tract-chondritis",
        "description": "Inflammation of tracheal and/or bronchial cartilage with symptoms such as cough, dyspnea, or stridor",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-inflammation",
        "description": "Conjunctivitis, scleritis, or episcleritis",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "non-erosive-arthritis",
        "description": "Inflammatory arthritis without joint erosion",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "histologic-confirmation",
        "description": "Biopsy showing cartilage inflammation and destruction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of three or more of the major criteria, or one or more major plus two or more minor criteria, or positive biopsy with two major criteria",
    "notes": "Respiratory tract involvement is a critical feature for this variant and may require imaging and endoscopic confirmation."
  },
