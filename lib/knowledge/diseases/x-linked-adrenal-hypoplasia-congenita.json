  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for X-linked Adrenal Hypoplasia Congenita",
    "criteria": [
      {
        "id": "clinical-adrenal-insufficiency",
        "description": "Presence of primary adrenal insufficiency symptoms including salt-wasting crisis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogonadotropic-hypogonadism",
        "description": "Evidence of hypogonadotropic hypogonadism manifesting as delayed or absent puberty",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dax1-nr0b1-mutation",
        "description": "Identification of pathogenic mutation or deletion in the NR0B1 (DAX1) gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history-x-linked",
        "description": "Family history consistent with X-linked inheritance pattern",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "adrenal-imaging",
        "description": "Imaging showing adrenal hypoplasia or atrophy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of primary adrenal insufficiency and hypogonadotropic hypogonadism with confirmed NR0B1 gene mutation",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical presentation may vary in severity."
  },
