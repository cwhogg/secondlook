  "keyFindings": {
    "laboratory": [
      "Abnormal serum transferrin isoelectric focusing pattern indicating type I glycosylation defect",
      "Elevated liver enzymes (AST, ALT)",
      "Coagulation factor deficiencies (e.g., factor XI, antithrombin III)"
    ],
    "imaging": [
      "Brain MRI may show cerebral and cerebellar atrophy or hypoplasia",
      "Echocardiography may reveal cardiomyopathy"
    ],
    "genetic": [
      "DPM1 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Reduced dolichol-phosphate mannose synthase enzyme activity in patient fibroblasts or leukocytes"
    ]
  },
