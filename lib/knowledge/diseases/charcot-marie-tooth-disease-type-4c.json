  "keyFindings": {
    "laboratory": [
      "Nerve conduction studies showing markedly slowed conduction velocities consistent with demyelination",
      "Elevated cerebrospinal fluid protein in some cases"
    ],
    "imaging": [
      "Spinal X-rays demonstrating scoliosis",
      "MRI may show nerve root hypertrophy"
    ],
    "genetic": [
      "SH3TC2 (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Muscle biopsy showing secondary axonal loss and demyelination"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "charcot-marie-tooth-disease-type-1a",
      "distinguishingFeatures": [
        "CMT1A caused by PMP22 duplication",
        "Usually later onset than CMT4C",
        "Less frequent scoliosis"
      ]
    },
    {
      "diseaseId": "hereditary neuropathy-with-liability-to-pressure-palsies",
      "distinguishingFeatures": [
        "Recurrent focal neuropathies",
        "Usually normal nerve conduction velocities between episodes",
        "No scoliosis"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of weakness or sensory loss",
    "Respiratory compromise due to scoliosis or muscle weakness",
    "Early severe scoliosis causing cardiopulmonary complications"
  ],
