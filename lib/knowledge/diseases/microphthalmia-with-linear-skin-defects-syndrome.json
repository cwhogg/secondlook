  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for MLS syndrome",
    "criteria": [
      {
        "id": "microphthalmia",
        "description": "Presence of unilateral or bilateral microphthalmia or anophthalmia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "linear-skin-defects",
        "description": "Linear skin defects along the face and neck, typically following Blaschko lines",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "X-linked-inheritance",
        "description": "X-linked dominant inheritance pattern with male lethality",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "additional-ocular-anomalies",
        "description": "Additional ocular anomalies such as coloboma or cataracts",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-features",
        "description": "Neurological abnormalities including developmental delay or seizures",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of both microphthalmia (unilateral or bilateral) and characteristic linear skin defects",
    "notes": "Genetic testing for HCCS mutations can confirm diagnosis"
  },
