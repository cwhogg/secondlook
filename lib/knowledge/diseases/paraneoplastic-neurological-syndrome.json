        "requiredForDiagnosis": true
      },
      {
        "id": "onconeural-antibodies",
        "description": "Presence of well-characterized onconeural antibodies in serum or CSF",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Classical neurological syndrome plus detection of cancer within 5 years, or non-classical syndrome with onconeural antibodies and cancer",
    "notes": "Diagnosis requires exclusion of other causes and supportive antibody testing when available"
  },
