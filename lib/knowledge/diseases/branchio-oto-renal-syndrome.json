  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 10,
      "peak": 1
    },
    "sexPredilection": "equal",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Chang et al. Diagnostic Criteria for BOR Syndrome",
    "criteria": [
      {
        "id": "branchial-anomalies",
        "description": "Presence of branchial cleft cysts, fistulas, or sinuses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural, conductive, or mixed hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-anomalies",
        "description": "Structural or functional renal abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "preauricular-pits",
        "description": "Presence of preauricular pits or tags",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "external-ear-malformations",
        "description": "Malformed pinnae or external ear anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "First-degree relative with BOR syndrome",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of at least three major criteria or two major plus two minor criteria",
    "notes": "Genetic testing for EYA1, SIX1, or SIX5 mutations can support diagnosis"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Branchial cleft cysts or fistulas",
        "frequency": 0.85,
        "bodySystem": "dermatological",
        "notes": "Typically located on the lateral neck"
      },
      {
        "symptomName": "Sensorineural or mixed hearing loss",
        "frequency": 0.8,
        "bodySystem": "otolaryngological",
        "notes": "Variable severity, often bilateral"
      },
      {
        "symptomName": "Renal structural anomalies",
        "frequency": 0.75,
        "bodySystem": "renal",
        "notes": "Includes renal hypoplasia, agenesis, or dysplasia"
      }
    ],
    "common": [
      {
        "symptomName": "Preauricular pits or tags",
        "frequency": 0.65,
        "bodySystem": "dermatological",
        "notes": "Small skin indentations or appendages near the ear"
      },
      {
        "symptomName": "External ear malformations",
        "frequency": 0.6,
        "bodySystem": "otolaryngological",
        "notes": "Includes cup-shaped or malformed pinnae"
      },
      {
        "symptomName": "Conductive hearing loss",
        "frequency": 0.55,
        "bodySystem": "otolaryngological",
        "notes": "Often due to ossicular chain anomalies"
      },
      {
        "symptomName": "Branchial sinus tracts",
        "frequency": 0.55,
        "bodySystem": "dermatological",
        "notes": "May drain intermittently"
      }
    ],
    "occasional": [
      {
        "symptomName": "Facial nerve palsy",
        "frequency": 0.3,
        "bodySystem": "neurological",
        "notes": "Rarely observed due to branchial arch involvement"
      },
      {
        "symptomName": "Cervical lymphadenopathy",
        "frequency": 0.25,
        "bodySystem": "immunological",
        "notes": "Reactive enlargement due to branchial anomalies"
      },
      {
        "symptomName": "Recurrent neck infections",
        "frequency": 0.2,
        "bodySystem": "dermatological",
        "notes": "Secondary to branchial cleft cysts or fistulas"
      },
      {
        "symptomName": "Mixed conductive and sensorineural hearing loss",
        "frequency": 0.15,
        "bodySystem": "otolaryngological",
        "notes": "Combination of ossicular and cochlear defects"
      }
    ],
    "rare": [
      {
        "symptomName": "Renal failure",
        "frequency": 0.08,
        "bodySystem": "renal",
        "notes": "Progressive loss of renal function in severe cases"
      },
      {
        "symptomName": "Cleft palate",
        "frequency": 0.05,
        "bodySystem": "gastrointestinal",
        "notes": "Occasionally reported in association"
      },
      {
        "symptomName": "Cardiac anomalies",
        "frequency": 0.04,
        "bodySystem": "cardiovascular",
        "notes": "Rarely reported, includes septal defects"
      }
    ]
  },
  "systemsAffected": [
    "dermatological",
    "otolaryngological",
    "renal",
    "neurological",
    "immunological",
    "gastrointestinal",
    "cardiovascular"
  ],
  "keyFindings": {
    "laboratory": [
      "Renal function tests may show elevated creatinine in advanced disease",
      "Urinalysis may reveal proteinuria or hematuria"
    ],
    "imaging": [
      "Ultrasound or MRI showing renal hypoplasia, agenesis, or cystic changes",
      "CT or MRI of the neck demonstrating branchial cleft cysts or fistulas",
      "Audiometry confirming sensorineural or conductive hearing loss"
    ],
    "genetic": [
      "Pathogenic variants in EYA1 gene (~40% cases)",
      "Mutations in SIX1 or SIX5 genes in some patients"
    ],
    "other": [
      "Family history consistent with autosomal dominant inheritance",
      "Physical exam findings of preauricular pits and external ear malformations"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "goldenhar-syndrome",
      "distinguishingFeatures": [
        "Unilateral facial microsomia",
        "Ocular dermoids",
        "Vertebral anomalies"
      ]
    },
    {
      "diseaseId": "treacher-collins-syndrome",
      "distinguishingFeatures": [
        "Bilateral mandibulofacial dysostosis",
        "Downslanting palpebral fissures",
        "Absent or malformed zygomatic arches"
      ]
    }
  ],
  "redFlags": [
    "Progressive renal insufficiency or failure",
    "Severe bilateral sensorineural hearing loss",
    "Recurrent neck infections or abscess formation"
  ],
  "specialistType": [
    "Geneticist",
    "Nephrologist",
    "Otolaryngologist",
    "Audiologist"
  ],
  "lastUpdated": "2026-02-17",
  "references": [
    "Chang EH, et al. Diagnostic criteria for branchio-oto-renal syndrome. Am J Med Genet A. 2004.",
    "Smith RJH, et al. Branchio-oto-renal syndrome. GeneReviews. 2020.",
    "Friedman TB, et al. Genetics of hearing loss and branchio-oto-renal syndrome. Otolaryngol Clin North Am. 2017."
  ],
