  "diagnosticCriteria": {
    "formalCriteriaName": "Hypoglossia-Hypodactyly Diagnostic Criteria",
    "criteria": [
      {
        "id": "hypoglossia",
        "description": "Congenital hypoplasia or agenesis of the tongue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypodactyly",
        "description": "Congenital hypoplasia or absence of fingers or toes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oromandibular-malformations",
        "description": "Associated oromandibular anomalies such as micrognathia or mandibular hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "limb-malformations",
        "description": "Additional limb anomalies including syndactyly or brachydactyly",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital hypoglossia and hypodactyly with or without additional oromandibular or limb anomalies",
    "notes": "Diagnosis is clinical and supported by imaging and genetic testing when available."
  },
