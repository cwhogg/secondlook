  "diagnosticCriteria": {
    "formalCriteriaName": "PEHO syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "progressive-encephalopathy",
        "description": "Progressive neurodegeneration with developmental delay and regression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "optic-atrophy",
        "description": "Bilateral optic atrophy confirmed by ophthalmological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypsarrhythmia",
        "description": "Hypsarrhythmia pattern on electroencephalogram (EEG)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebral-edema",
        "description": "Cerebral edema or brain swelling evident on neuroimaging",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "early-onset-seizures",
        "description": "Seizures beginning in infancy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: progressive encephalopathy, bilateral optic atrophy, and hypsarrhythmia on EEG",
    "notes": "Diagnosis is clinical supported by neuroimaging and EEG findings; genetic testing may assist but is not definitive."
  },
