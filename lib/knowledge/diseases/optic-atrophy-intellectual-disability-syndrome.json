  "diagnosticCriteria": {
    "formalCriteriaName": "Optic Atrophy-Intellectual Disability Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "optic-atrophy",
        "description": "Bilateral optic nerve atrophy confirmed by ophthalmological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Developmental delay or intellectual disability confirmed by neuropsychological assessment",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-neurological-disorders",
        "description": "Exclusion of other neurological or metabolic disorders causing optic atrophy and cognitive impairment",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in associated genes if available",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral optic atrophy and intellectual disability with exclusion of other causes",
    "notes": "Diagnosis is primarily clinical supported by imaging and genetic testing when available."
  },
