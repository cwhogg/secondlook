  "diagnosticCriteria": {
    "formalCriteriaName": "Branchioskeletogenital syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "branchial-arch-anomalies",
        "description": "Presence of branchial arch anomalies such as branchial cleft cysts or fistulas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Skeletal malformations including vertebral anomalies and limb abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genitourinary-malformations",
        "description": "Genitourinary tract malformations such as hypospadias or renal hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural or conductive hearing loss",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including preauricular pits or tags",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: branchial arch anomalies, skeletal abnormalities, and genitourinary malformations",
    "notes": "Genetic testing for mutations in the SIX1 gene can support diagnosis"
  },
