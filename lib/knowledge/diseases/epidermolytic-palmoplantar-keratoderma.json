  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Histopathological Diagnostic Criteria for Epidermolytic Palmoplantar Keratoderma",
    "criteria": [
      {
        "id": "clinical-palmoplantar-hyperkeratosis",
        "description": "Diffuse thickening and hyperkeratosis of the palms and soles with erythema",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology-epidermolytic-changes",
        "description": "Histological evidence of epidermolytic hyperkeratosis with vacuolar degeneration of the suprabasal keratinocytes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing-krt1-krt9",
        "description": "Identification of pathogenic variants in KRT1 or KRT9 genes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical palmoplantar hyperkeratosis with histopathological confirmation of epidermolytic changes; genetic testing and family history supportive but not mandatory.",
    "notes": "Diagnosis is primarily clinical supported by histopathology; genetic testing aids confirmation and counseling."
  },
