  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Electroretinogram showing reduced rod and cone responses"
    ],
    "imaging": [
      "Radiographs showing brachydactyly with shortened phalanges",
      "Delayed bone age on hand/wrist X-rays",
      "Optical coherence tomography (OCT) showing retinal pigment epithelium degeneration"
    ],
    "genetic": [
      "CWC27 (causative)",
      "Autosomal recessive inheritance pattern suspected"
    ],
    "other": [
      "Visual field testing demonstrating concentric peripheral vision loss",
      "Electrocardiogram (ECG) may reveal conduction defects in rare cases"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "bardet-biedl-syndrome",
      "distinguishingFeatures": [
        "Polydactyly instead of brachydactyly",
        "Obesity and renal anomalies more prominent",
        "Cognitive impairment more frequent"
      ]
    },
    {
      "diseaseId": "alstrom-syndrome",
      "distinguishingFeatures": [
        "Cardiomyopathy and sensorineural hearing loss common",
        "Obesity and insulin resistance present",
        "Retinitis pigmentosa with cone-rod dystrophy pattern"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of visual field loss leading to blindness",
    "Severe short stature with failure to thrive",
    "Onset of cardiac conduction abnormalities"
  ],
