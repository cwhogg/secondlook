    "formalCriteriaName": "NIDDK Criteria for Interstitial Cystitis",
    "criteria": [
      {
        "id": "chronic-pelvic-pain",
        "description": "Chronic pelvic pain, pressure, or discomfort perceived to be related to the urinary bladder",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-frequency",
        "description": "Urinary urgency and frequency (typically >8 voids per day)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-infection",
        "description": "Absence of urinary tract infection or other identifiable causes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cystoscopic-findings",
        "description": "Cystoscopic findings such as glomerulations or Hunner lesions (supportive but not required)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "negative-urine-cytology",
        "description": "Negative urine cytology to exclude malignancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic pelvic pain related to bladder, urinary frequency/urgency, and exclusion of infection or other causes",
    "notes": "Diagnosis is primarily clinical and by exclusion; cystoscopy may aid but is not mandatory."
  },
