  "keyFindings": {
    "laboratory": [
      "Elevated serum creatinine and blood urea nitrogen indicating renal insufficiency",
      "Proteinuria on urinalysis",
      "Anemia of chronic disease"
    ],
    "imaging": [
      "Small kidneys with reduced cortical thickness on ultrasound or MRI",
      "Absence of cystic changes or other dysplastic features"
    ],
    "genetic": [
      "Mutations in genes associated with nephron development (e.g., PAX2, EYA1) reported in some cases",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Histopathology showing reduced nephron number and enlarged glomeruli"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "renal-hypoplasia",
      "distinguishingFeatures": [
        "Renal hypoplasia typically shows reduced kidney size without glomerulomegaly",
        "May have fewer but normal-sized nephrons"
      ]
    },
    {
      "diseaseId": "congenital-renal-dysplasia",
      "distinguishingFeatures": [
        "Presence of cystic or dysplastic renal tissue on imaging and histology",
        "Often associated with urinary tract malformations"
      ]
    },
    {
      "diseaseId": "focal-segmental-glomerulosclerosis",
      "distinguishingFeatures": [
        "Histology shows segmental sclerosis rather than reduced nephron number",
        "Usually presents later in childhood or adulthood"
      ]
    }
  ],
