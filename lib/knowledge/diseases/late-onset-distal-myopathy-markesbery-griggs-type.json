  "diagnosticCriteria": {
    "formalCriteriaName": "Markesbery-Griggs distal myopathy diagnostic criteria",
    "criteria": [
      {
        "id": "clinical-distal-weakness",
        "description": "Progressive distal muscle weakness predominantly affecting lower limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy-rimmed-vacuoles",
        "description": "Muscle biopsy showing rimmed vacuoles and myopathic changes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the dysferlin gene (DYSF)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography-myopathic-pattern",
        "description": "Electromyography demonstrating myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-sensory-neuropathy",
        "description": "Lack of sensory nerve involvement on clinical and electrophysiological testing",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal muscle weakness with muscle biopsy showing rimmed vacuoles and confirmation by genetic testing identifying pathogenic DYSF mutations",
    "notes": "Diagnosis requires exclusion of other distal myopathies and muscular dystrophies"
  },
