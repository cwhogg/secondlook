  "diagnosticCriteria": {
    "formalCriteriaName": "Beta-Ketothiolase Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "ketoacidotic-episodes",
        "description": "Recurrent ketoacidotic metabolic crises triggered by illness or fasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-organic-acids",
        "description": "Elevated urinary excretion of 2-methyl-3-hydroxybutyric acid, tiglylglycine, and 2-methylacetoacetic acid",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acylcarnitine-profile",
        "description": "Characteristic acylcarnitine profile with elevated C5:1 and C5-OH species",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the ACAT1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-assay",
        "description": "Reduced beta-ketothiolase enzyme activity in fibroblasts or leukocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent ketoacidotic episodes plus confirmatory biochemical abnormalities and/or pathogenic ACAT1 mutations",
    "notes": "Diagnosis is often confirmed by molecular genetic testing and biochemical analysis during acute episodes."
  },
