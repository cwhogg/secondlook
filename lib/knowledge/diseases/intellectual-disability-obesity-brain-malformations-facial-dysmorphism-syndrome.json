  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Intellectual Disability-Obesity-Brain Malformations-Facial Dysmorphism Syndrome",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of global developmental delay or intellectual disability confirmed by standardized cognitive testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "obesity",
        "description": "Early-onset obesity developing in infancy or early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-malformations",
        "description": "Neuroimaging evidence of brain malformations such as ventriculomegaly, corpus callosum hypoplasia, or cortical dysplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Distinctive facial features including broad nasal bridge, hypertelorism, and thin upper lip",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-features",
        "description": "Additional features such as hypotonia, speech delay, or behavioral abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of intellectual disability, early-onset obesity, brain malformations on imaging, and characteristic facial dysmorphism",
    "notes": "Diagnosis is clinical and supported by neuroimaging; genetic testing may be inconclusive due to limited data."
  },
