        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes with reduced or abnormal titin protein expression",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
