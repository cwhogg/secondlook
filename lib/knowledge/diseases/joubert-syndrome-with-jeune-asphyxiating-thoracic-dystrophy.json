      "Polydactyly on physical examination",
      "Respiratory insufficiency requiring supportive care in infancy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "joubert-syndrome",
      "distinguishingFeatures": [
        "Absence of thoracic dystrophy",
        "Less severe respiratory compromise",
        "No narrow bell-shaped thorax on imaging"
      ]
    },
    {
      "diseaseId": "jeune-asphyxiating-thoracic-dystrophy",
      "distinguishingFeatures": [
        "Lack of molar tooth sign on brain MRI",
        "Predominant skeletal and respiratory features without neurological involvement"
      ]
    },
    {
      "diseaseId": "meckel-gruber-syndrome",
      "distinguishingFeatures": [
        "Presence of encephalocele",
        "Polydactyly with cystic kidneys",
        "More severe and lethal neonatal course"
      ]
    }
  ],
  "redFlags": [
    "Severe neonatal respiratory distress with thoracic insufficiency",
    "Developmental delay with hypotonia and abnormal eye movements",
    "Progressive renal impairment or hepatic fibrosis"
  ],
