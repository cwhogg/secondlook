  "diagnosticCriteria": {
    "formalCriteriaName": "Duchenne Muscular Dystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive proximal muscle weakness with onset in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-ck",
        "description": "Markedly elevated serum creatine kinase (CK) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in the DMD gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing absence or severe reduction of dystrophin protein",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive proximal muscle weakness in early childhood, elevated serum CK, and confirmation of DMD gene mutation",
    "notes": "Genetic testing is the gold standard for diagnosis; muscle biopsy is used when genetic testing is inconclusive."
  },
