  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Molecular Diagnostic Criteria for Acromicric Dysplasia",
    "criteria": [
      {
        "id": "short-stature",
        "description": "Severe short stature with disproportionate short limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "characteristic-facies",
        "description": "Distinctive facial features including round face, full cheeks, and bulbous nose",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Radiological evidence of delayed bone age, short tubular bones, and cone-shaped epiphyses",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fibrillin-1-mutation",
        "description": "Identification of pathogenic FBN1 gene mutation",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "mild-joint-contractures",
        "description": "Presence of limited joint mobility or contractures",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe disproportionate short stature with characteristic facial features and skeletal abnormalities, supported by genetic testing if available",
    "notes": "Genetic testing for FBN1 mutations can confirm diagnosis but is not mandatory if clinical criteria are met."
  },
