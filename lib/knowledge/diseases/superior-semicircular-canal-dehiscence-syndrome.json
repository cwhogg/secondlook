  "keyFindings": {
    "laboratory": [
      "Vestibular-evoked myogenic potentials (VEMP) with lowered thresholds and increased amplitudes"
    ],
    "imaging": [
      "High-resolution computed tomography (CT) of temporal bone showing bony dehiscence over superior semicircular canal"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Audiometry showing conductive hearing loss with normal tympanic membrane",
      "Clinical examination revealing Tullio phenomenon and Hennebert sign"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "menieres-disease",
      "distinguishingFeatures": [
        "Fluctuating sensorineural hearing loss",
        "Episodic vertigo lasting 20 minutes to several hours",
        "No bony dehiscence on CT imaging"
      ]
    },
    {
      "diseaseId": "perilymphatic-fistula",
      "distinguishingFeatures": [
        "History of trauma or barotrauma",
        "Vertigo triggered by pressure changes",
        "No superior canal dehiscence on imaging"
      ]
    }
  ],
  "redFlags": [
    "Sudden onset of severe vertigo with hearing loss",
    "Neurological deficits such as facial weakness or numbness",
    "Progressive sensorineural hearing loss"
  ],
