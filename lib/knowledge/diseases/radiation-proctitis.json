  "diagnosticCriteria": {
    "formalCriteriaName": "Radiation Proctitis Diagnostic Criteria",
    "criteria": [
      {
        "id": "history-radiation",
        "description": "History of pelvic radiation therapy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-symptoms",
        "description": "Presence of rectal bleeding, tenesmus, or mucous discharge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "endoscopic-findings",
        "description": "Endoscopic evidence of mucosal inflammation, telangiectasia, or ulceration in the rectum",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Biopsy showing radiation-induced mucosal changes (optional supportive)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "History of pelvic radiation plus compatible clinical symptoms and endoscopic findings",
    "notes": "Biopsy is not mandatory but can help exclude other causes"
  },
