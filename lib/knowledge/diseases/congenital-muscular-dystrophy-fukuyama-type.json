  "diagnosticCriteria": {
    "formalCriteriaName": "Fukuyama CMD Diagnostic Criteria",
    "criteria": [
      {
        "id": "muscle-weakness",
        "description": "Congenital hypotonia and progressive muscle weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-malformation",
        "description": "Characteristic brain malformations including cobblestone lissencephaly on MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the FKTN gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-ck",
        "description": "Elevated serum creatine kinase levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ocular-abnormalities",
        "description": "Ocular abnormalities such as myopia and retinal dysplasia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital muscle weakness with characteristic brain MRI findings and confirmed pathogenic FKTN mutation",
    "notes": "Muscle biopsy and immunohistochemistry may support diagnosis but are not mandatory."
  },
