  "diagnosticCriteria": {
    "formalCriteriaName": "No formal standardized criteria",
    "criteria": [
      {
        "id": "cutaneous-xanthomas",
        "description": "Presence of multiple yellow-brown papules and nodules predominantly on the face, trunk, and flexural areas",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mucosal-involvement",
        "description": "Involvement of mucous membranes including oral and respiratory tract lesions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing foamy histiocytes and Touton giant cells without lipid metabolism abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-lipid-profile",
        "description": "Normal serum lipid levels excluding hyperlipidemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic disseminated xanthomatous skin lesions with mucosal involvement and confirmatory histopathology",
    "notes": "Diagnosis is clinical and histopathological; lipid profile is typically normal distinguishing it from other xanthomatoses"
  },
