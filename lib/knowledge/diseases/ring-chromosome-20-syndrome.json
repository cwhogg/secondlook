  "diagnosticCriteria": {
    "formalCriteriaName": "Ring Chromosome 20 Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Presence of ring chromosome 20 detected by karyotyping or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "refractory-seizures",
        "description": "Refractory focal seizures, often nocturnal, resistant to standard antiepileptic drugs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cognitive-decline",
        "description": "Progressive cognitive impairment or decline following seizure onset",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ictal-eeg-pattern",
        "description": "Characteristic prolonged ictal EEG patterns with frontal or temporal lobe involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-genetic-epilepsy",
        "description": "Exclusion of other known genetic epilepsy syndromes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of ring chromosome 20 plus refractory seizures and cognitive decline",
    "notes": "Diagnosis relies heavily on cytogenetic analysis combined with clinical features and EEG findings."
  },
