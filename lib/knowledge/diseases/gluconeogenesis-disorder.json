        "requiredForDiagnosis": true
      },
      {
        "id": "lactic-acidosis",
        "description": "Presence of lactic acidosis during metabolic decompensation episodes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of deficient activity or mutation in key gluconeogenic enzymes (e.g., fructose-1,6-bisphosphatase)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ketone-body-levels",
        "description": "Low or absent ketone bodies during hypoglycemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes encoding gluconeogenic enzymes",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of recurrent fasting hypoglycemia with lactic acidosis plus either enzyme deficiency confirmation or pathogenic genetic variant identification",
    "notes": "Diagnosis requires exclusion of other causes of hypoglycemia and metabolic acidosis."
  },
