  "diagnosticCriteria": {
    "formalCriteriaName": "Enamel-Renal Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "amelogenesis-imperfecta",
        "description": "Presence of hypoplastic amelogenesis imperfecta with enamel agenesis or severe enamel hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nephrocalcinosis",
        "description": "Bilateral nephrocalcinosis detected by renal ultrasound or CT scan",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "famn20a-mutation",
        "description": "Identification of biallelic pathogenic variants in the FAM20A gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "gingival-hyperplasia",
        "description": "Generalized gingival fibromatosis or hyperplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "pulmonary-calcifications",
        "description": "Occasional ectopic calcifications in soft tissues including lungs",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of hypoplastic amelogenesis imperfecta plus nephrocalcinosis; genetic confirmation supports diagnosis",
    "notes": "Genetic testing for FAM20A mutations is recommended to confirm diagnosis but not mandatory if clinical features are definitive."
  },
