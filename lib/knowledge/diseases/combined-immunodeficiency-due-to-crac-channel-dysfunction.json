  "diagnosticCriteria": {
    "formalCriteriaName": "CRAC Channel Dysfunction Combined Immunodeficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "impaired-tcell-function",
        "description": "Demonstration of impaired T-cell activation and proliferation due to defective calcium influx",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biallelic-orai1-stim1-mutation",
        "description": "Identification of biallelic pathogenic variants in ORAI1 or STIM1 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-severe-infections",
        "description": "History of recurrent, severe bacterial, viral, or fungal infections in early infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "reduced-lymphocyte-counts",
        "description": "Laboratory evidence of lymphopenia, especially affecting CD4+ and CD8+ T cells",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "impaired-store-operated-calcium-entry",
        "description": "Functional assays showing defective store-operated calcium entry (SOCE) in immune cells",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of biallelic pathogenic variants in ORAI1 or STIM1 plus impaired T-cell function and recurrent severe infections",
    "notes": "Genetic confirmation is critical; functional assays support diagnosis"
  },
