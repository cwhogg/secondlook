        "Kidney located abnormally but not fused",
        "No isthmus connecting kidneys"
      ]
    },
    {
      "diseaseId": "crossed-fused-renal-ectopia",
      "distinguishingFeatures": [
        "Both kidneys located on same side of abdomen",
        "Fusion present but different anatomical configuration"
      ]
    }
  ],
  "redFlags": [
