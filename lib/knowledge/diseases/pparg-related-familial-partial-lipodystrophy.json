  "keyFindings": {
    "laboratory": [
      "Elevated fasting insulin and glucose levels indicating insulin resistance",
      "Hypertriglyceridemia with triglyceride levels often >500 mg/dL",
      "Elevated liver enzymes consistent with hepatic steatosis"
    ],
    "imaging": [
      "MRI or DEXA scan showing selective loss of subcutaneous fat in limbs and gluteal region",
      "Ultrasound or MRI evidence of hepatic steatosis"
    ],
    "genetic": [
      "PPARG (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Skin biopsy may show reduced adipocyte size and number in affected areas",
      "Family history consistent with autosomal dominant inheritance"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "lmna-related-familial-partial-lipodystrophy",
      "distinguishingFeatures": [
        "Mutations in LMNA gene instead of PPARG",
        "More prominent fat loss in limbs and trunk with relative facial sparing",
        "Earlier onset in adolescence"
      ]
    },
    {
      "diseaseId": "acquired-partial-lipodystrophy",
      "distinguishingFeatures": [
        "No genetic mutation identified",
        "Progressive fat loss often starting in childhood or adolescence",
        "Associated with complement abnormalities and autoimmune features"
      ]
    }
  ],
  "redFlags": [
    "Rapid onset of severe insulin resistance in young adult",
    "Severe hypertriglyceridemia refractory to standard treatment",
    "Family history of partial lipodystrophy or early-onset diabetes"
  ],
