  "keyFindings": {
    "laboratory": [],
    "imaging": [
      "Dynamic bronchoscopy showing expiratory tracheal collapse >50%",
      "CT or MRI demonstrating tracheal wall weakness or malacia"
    ],
    "genetic": [
      "Usually sporadic; rare associations with connective tissue disorders"
    ],
    "other": [
      "Pulmonary function tests may show variable extrathoracic airway obstruction"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "acquired-tracheomalacia",
      "distinguishingFeatures": [
        "History of prolonged intubation or external airway compression",
        "Later onset compared to congenital form"
      ]
    },
    {
      "diseaseId": "laryngomalacia",
      "distinguishingFeatures": [
        "Inspiratory stridor rather than expiratory",
        "Supraglottic airway collapse on laryngoscopy"
      ]
    },
    {
      "diseaseId": "vascular-ring-syndrome",
      "distinguishingFeatures": [
        "Imaging shows vascular anomaly compressing trachea",
        "May have feeding difficulties and biphasic stridor"
      ]
    }
  ],
