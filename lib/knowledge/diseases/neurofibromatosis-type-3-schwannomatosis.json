  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 20,
      "max": 60,
      "peak": 30
    },
    "sexPredilection": "slight-female",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Schwannomatosis",
    "criteria": [
      {
        "id": "multiple-schwannomas",
        "description": "Presence of two or more non-intradermal schwannomas confirmed by pathology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-vestibular-tumors",
        "description": "No evidence of vestibular schwannomas on high-quality MRI after age 30",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pain-syndrome",
        "description": "Chronic localized or generalized pain associated with schwannomas",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in SMARCB1 or LZTR1 genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Two or more pathologically confirmed schwannomas without vestibular tumors on MRI and exclusion of NF2",
    "notes": "Genetic testing can support diagnosis but is not mandatory; exclusion of NF2 is critical."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Multiple non-vestibular schwannomas",
        "frequency": 0.85,
        "bodySystem": "neurological",
        "notes": "Typically peripheral nerve schwannomas"
      },
      {
        "symptomName": "Chronic neuropathic pain localized to schwannoma sites",
        "frequency": 0.75,
        "bodySystem": "neurological",
        "notes": "Pain often severe and disabling"
      },
      {
        "symptomName": "Absence of vestibular schwannomas",
        "frequency": 0.95,
        "bodySystem": "neurological",
        "notes": "Distinguishes from NF2"
      }
    ],
    "common": [
      {
        "symptomName": "Paresthesia or numbness in affected nerve distribution",
        "frequency": 0.65,
        "bodySystem": "neurological",
        "notes": "Sensory disturbances common"
      },
      {
        "symptomName": "Palpable peripheral nerve tumors",
        "frequency": 0.6,
        "bodySystem": "musculoskeletal",
        "notes": "Firm, mobile nodules along nerves"
      },
      {
        "symptomName": "Muscle weakness in affected limbs",
        "frequency": 0.55,
        "bodySystem": "neurological",
        "notes": "Due to nerve compression"
      },
      {
        "symptomName": "Cutaneous schwannomas",
        "frequency": 0.5,
        "bodySystem": "dermatological",
        "notes": "Less common than in NF1"
      }
    ],
    "occasional": [
      {
        "symptomName": "Hearing loss unrelated to vestibular schwannomas",
        "frequency": 0.3,
        "bodySystem": "neurological",
        "notes": "May occur due to other nerve involvement"
      },
      {
        "symptomName": "Balance difficulties",
        "frequency": 0.25,
        "bodySystem": "neurological",
        "notes": "Not caused by vestibular tumors"
      },
      {
        "symptomName": "Musculoskeletal pain unrelated to tumors",
        "frequency": 0.2,
        "bodySystem": "musculoskeletal",
        "notes": "Possibly secondary to chronic pain syndrome"
      },
      {
        "symptomName": "Fatigue",
        "frequency": 0.15,
        "bodySystem": "constitutional",
        "notes": "Common in chronic pain conditions"
      }
    ],
    "rare": [
      {
        "symptomName": "Cranial nerve palsies other than vestibular nerve",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "Due to schwannomas on other cranial nerves"
      },
      {
        "symptomName": "Spinal cord compression symptoms",
        "frequency": 0.03,
        "bodySystem": "neurological",
        "notes": "From intraspinal schwannomas"
      },
      {
        "symptomName": "Hydrocephalus",
        "frequency": 0.02,
        "bodySystem": "neurological",
        "notes": "Very rare complication"
      }
    ]
  },
