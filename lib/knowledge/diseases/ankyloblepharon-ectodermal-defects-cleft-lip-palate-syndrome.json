  "diagnosticCriteria": {
    "formalCriteriaName": "Hay-Wells Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "ankyloblepharon",
        "description": "Presence of ankyloblepharon filiforme adnatum (partial or complete eyelid fusion)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ectodermal-defects",
        "description": "Ectodermal abnormalities including scalp erosions, sparse hair, nail dystrophy, and dental anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cleft-lip-palate",
        "description": "Cleft lip and/or cleft palate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "additional-features",
        "description": "Additional features such as hypohidrosis, respiratory infections, or lacrimal duct anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: ankyloblepharon, ectodermal defects, and cleft lip/palate",
    "notes": "Genetic testing for TP63 mutations supports diagnosis"
  },
