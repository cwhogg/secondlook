  "keyFindings": {
    "laboratory": [
      "Generally nonspecific; may show anemia if bleeding occurs"
    ],
    "imaging": [
      "MRI and MR angiography demonstrating fast-flow arteriovenous malformations",
      "Doppler ultrasound showing high-flow vascular lesions",
      "Conventional angiography for detailed vascular mapping"
    ],
    "genetic": [
      "Pathogenic variants in RASA1 gene",
      "Pathogenic variants in EPHB4 gene",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Clinical observation of multiple capillary malformations",
      "Family history consistent with autosomal dominant inheritance"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sturge-weber-syndrome",
      "distinguishingFeatures": [
        "Presence of leptomeningeal angiomas",
        "Glaucoma and neurological deficits",
        "Port-wine stain typically involving trigeminal nerve distribution"
      ]
    },
    {
      "diseaseId": "hereditary-hemorrhagic-telangiectasia",
      "distinguishingFeatures": [
        "Mucocutaneous telangiectasias rather than capillary malformations",
        "Recurrent epistaxis and arteriovenous malformations in multiple organs",
        "Mutations in ENG, ACVRL1 genes"
      ]
    }
  ],
  "redFlags": [
