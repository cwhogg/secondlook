  "keyFindings": {
    "laboratory": [
      "Marked peripheral eosinophilia (often >1500/mm3, can be >10,000)",
      "MPO-ANCA (p-ANCA) positive (~40%)",
      "Elevated IgE",
      "Elevated ESR and CRP",
      "Elevated troponin and BNP in cardiac involvement",
      "Elevated serum eosinophilic cationic protein"
    ],
    "imaging": [
      "Chest CT: migratory patchy pulmonary infiltrates, ground-glass opacities",
      "Cardiac MRI: myocardial inflammation/fibrosis (late gadolinium enhancement)",
      "Echocardiography: reduced EF in eosinophilic myocarditis",
      "Sinus CT: mucosal thickening, polyps"
    ],
    "genetic": [
      "HLA-DRB4 association reported",
      "IL-5 pathway gene variants"
    ],
    "other": [
      "Tissue biopsy: extravascular eosinophilic granulomas and necrotizing vasculitis",
      "Nerve biopsy: eosinophilic infiltration, epineural vasculitis",
      "Endomyocardial biopsy: eosinophilic myocarditis"
    ]
  },
