  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and biochemical diagnostic criteria for Sjogren-Larsson Syndrome",
    "criteria": [
      {
        "id": "ichthyosis",
        "description": "Congenital ichthyosis presenting as generalized dry, scaly skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "spasticity",
        "description": "Spastic diplegia or quadriplegia with increased muscle tone and hyperreflexia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "fatty-alcohol-dehydrogenase-deficiency",
        "description": "Deficiency of fatty aldehyde dehydrogenase enzyme activity in fibroblasts or leukocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the ALDH3A2 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital ichthyosis, spasticity, and intellectual disability with supportive biochemical or genetic confirmation",
    "notes": "Diagnosis is primarily clinical supported by biochemical enzyme assay and genetic testing."
  },
