  "diagnosticCriteria": {
    "formalCriteriaName": "PHACE Syndrome Consensus Diagnostic Criteria",
    "criteria": [
      {
        "id": "large-facial-hemangioma",
        "description": "Presence of a large segmental facial hemangioma greater than 5 cm",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "posterior-fossa-brain-anomalies",
        "description": "Structural brain anomalies including posterior fossa malformations",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "arterial-anomalies",
        "description": "Cerebral or cervical arterial anomalies such as dysplasia or agenesis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "cardiac-anomalies",
        "description": "Congenital heart defects, especially coarctation of the aorta",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "eye-anomalies",
        "description": "Structural ocular anomalies including microphthalmia or coloboma",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ventral-neck-hemangioma",
        "description": "Presence of hemangiomas on the ventral neck or upper chest",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Large segmental facial hemangioma plus one major criterion or two minor criteria",
    "notes": "Diagnosis is clinical and supported by imaging and specialist evaluation."
  },
