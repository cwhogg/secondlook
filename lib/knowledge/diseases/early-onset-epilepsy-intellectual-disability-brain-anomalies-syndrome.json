        "description": "Presence of global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "brain-anomalies",
        "description": "Neuroimaging evidence of structural brain anomalies such as cortical dysplasia or hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in associated genes (if available)",
