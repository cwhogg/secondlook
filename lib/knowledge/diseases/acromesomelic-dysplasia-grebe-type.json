        "requiredForDiagnosis": true
      },
      {
        "id": "hand-foot-malformations",
        "description": "Severe brachydactyly with hypoplastic or absent phalanges and metacarpals/metatarsals",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-findings",
        "description": "Characteristic radiographic abnormalities including hypoplastic or absent bones in hands and feet and shortened long bones",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-intelligence",
        "description": "Normal cognitive development and intelligence",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of severe acromesomelic limb shortening with characteristic hand and foot malformations confirmed by radiographic findings",
    "notes": "Genetic testing for mutations in the GDF5 gene can confirm diagnosis"
  },
