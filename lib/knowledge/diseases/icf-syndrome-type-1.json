  "keyFindings": {
    "laboratory": [
      "Hypogammaglobulinemia (low IgG, IgA, and/or IgM)",
      "Lymphopenia",
      "Elevated serum IgE in some cases"
    ],
    "imaging": [
      "Chest X-ray showing recurrent pneumonia or bronchiectasis",
      "Abdominal ultrasound may show hepatosplenomegaly"
    ],
    "genetic": [
      "Pathogenic mutations in DNMT3B gene",
      "Centromeric instability involving chromosomes 1, 9, and 16"
    ],
    "other": [
      "Cytogenetic analysis revealing multiradial chromosomes",
      "Flow cytometry showing abnormal B and T cell subsets"
    ]
  },
