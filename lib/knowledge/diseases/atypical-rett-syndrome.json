  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible elevated lactate in some cases"
    ],
    "imaging": [
      "MRI may show cerebral atrophy or delayed myelination",
      "Scoliosis visible on spinal X-rays"
    ],
    "genetic": [
      "MECP2 (causative)",
      "NTNG1 (causative)",
      "CDKL5 (causative)",
      "SMC1A (causative)",
      "GABBR2 (causative)",
      "Autosomal dominant inheritance",
      "X-linked dominant inheritance"
    ],
    "other": [
      "Abnormal EEG with epileptiform activity",
      "Abnormal breathing patterns observed during sleep studies"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "classic-rett-syndrome",
      "distinguishingFeatures": [
        "More consistent fulfillment of classic diagnostic criteria",
        "Earlier and more uniform regression phase",
        "Typical MECP2 mutations"
      ]
    },
    {
      "diseaseId": "cdkl5-deficiency-epileptic-encephalopathy",
      "distinguishingFeatures": [
        "Early-onset refractory epilepsy",
        "Severe developmental delay without typical hand stereotypies",
        "CDKL5 gene mutations"
      ]
    },
    {
      "diseaseId": "foxg1-syndrome",
      "distinguishingFeatures": [
        "Congenital onset with severe microcephaly",
        "Absent or minimal regression phase",
        "FOXG1 gene mutations"
      ]
    }
  ],
  "redFlags": [
    "Loss of purposeful hand skills after normal development",
    "Onset of hand stereotypies in early childhood",
    "Regression of spoken language and social engagement"
  ],
