  "diagnosticCriteria": {
    "formalCriteriaName": "Miyoshi Myopathy Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Early adult onset of distal muscle weakness and atrophy predominantly affecting posterior calf muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes with reduced or absent dysferlin protein expression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the DYSF gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ck-elevation",
        "description": "Elevated serum creatine kinase (CK) levels, often 10-20 times above normal",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography",
        "description": "Electromyography showing myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of typical clinical presentation plus either muscle biopsy findings or genetic confirmation",
    "notes": "Genetic testing is considered definitive; muscle biopsy may be required if genetic testing is inconclusive."
  },
