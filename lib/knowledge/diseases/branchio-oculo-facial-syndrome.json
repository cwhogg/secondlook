  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Renal function tests may show abnormalities if renal involvement present"
    ],
    "imaging": [
      "Ultrasound or MRI of neck showing branchial cleft cysts or fistulas",
      "Ocular imaging demonstrating coloboma or microphthalmia",
      "Renal ultrasound for structural anomalies",
      "CT or MRI of facial bones for cleft and craniofacial abnormalities"
    ],
    "genetic": [
      "TFAP2A (causative)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Audiometry confirming sensorineural or conductive hearing loss",
      "Ophthalmological examination for lacrimal duct anomalies and ocular malformations"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "branchio-oto-renal-syndrome",
      "distinguishingFeatures": [
        "Presence of renal anomalies more common and severe",
        "Hearing loss with branchial cleft anomalies but without typical facial clefting",
        "Mutations in EYA1, SIX1, or SIX5 genes"
      ]
    },
    {
      "diseaseId": "goldenhar-syndrome",
      "distinguishingFeatures": [
        "Hemifacial microsomia with ear and ocular anomalies",
        "Absence of branchial cleft cysts or fistulas",
        "No cleft lip or palate typical"
      ]
    }
  ],
  "redFlags": [
    "Recurrent neck infections or abscesses due to branchial cleft cysts",
    "Severe ocular malformations threatening vision",
    "Significant hearing loss impacting speech development"
  ],
