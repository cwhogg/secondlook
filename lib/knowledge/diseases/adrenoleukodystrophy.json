      "MRI showing symmetric demyelination of parieto-occipital white matter",
      "Contrast enhancement at lesion margins in active disease"
    ],
    "genetic": [
      "SLC39A4 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology showing demyelination and inflammatory infiltrates",
      "Nerve conduction studies showing peripheral neuropathy"
    ]
  },
