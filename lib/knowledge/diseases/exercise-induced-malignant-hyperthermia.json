  "keyFindings": {
    "laboratory": [
      "Elevated serum creatine kinase (CK) levels",
      "Hyperkalemia",
      "Metabolic acidosis",
      "Myoglobinuria"
    ],
    "imaging": [
      "Muscle edema on MRI during acute episodes (rarely performed)"
    ],
    "genetic": [
      "RYR1 (susceptibility)",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Positive in vitro contracture test (IVCT) or caffeine-halothane contracture test (CHCT)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "classic-malignant-hyperthermia",
      "distinguishingFeatures": [
        "Triggered primarily by volatile anesthetics or succinylcholine rather than exercise",
        "Usually occurs in perioperative setting"
      ]
    },
    {
      "diseaseId": "exertional-heat-stroke",
      "distinguishingFeatures": [
        "Hyperthermia due to environmental heat exposure and exertion without underlying genetic susceptibility",
        "Lacks muscle rigidity and elevated CK typical of malignant hyperthermia"
      ]
    },
    {
      "diseaseId": "central-core-disease",
      "distinguishingFeatures": [
        "Congenital myopathy with muscle weakness and cores on muscle biopsy",
        "May share RYR1 mutations but presents differently"
      ]
    }
  ],
  "redFlags": [
    "Rapidly rising core body temperature >40°C during exercise",
    "Generalized muscle rigidity or masseter spasm",
    "Marked elevation of serum creatine kinase post-exercise",
    "Signs of rhabdomyolysis or acute kidney injury",
    "Family history of malignant hyperthermia or sudden unexplained death during anesthesia"
  ],
