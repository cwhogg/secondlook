  "keyFindings": {
    "laboratory": [
      "Elevated serum chromogranin A levels",
      "Anemia on complete blood count due to chronic bleeding"
    ],
    "imaging": [
      "MRI or CT showing mass localized to anal canal",
      "Endoscopic ultrasound demonstrating tumor depth and local invasion",
      "Somatostatin receptor scintigraphy (Octreoscan) or PET-CT for metastatic evaluation"
    ],
    "genetic": [
      "No specific germline mutations identified; sporadic mutations in MEN1 or other neuroendocrine tumor-associated genes possible"
    ],
    "other": [
      "Histopathological confirmation with immunohistochemical staining for synaptophysin and chromogranin A",
      "Ki-67 proliferation index for tumor grading"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "anal-squamous-cell-carcinoma",
