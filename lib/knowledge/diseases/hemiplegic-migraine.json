  "keyFindings": {
    "laboratory": [
      "Generally normal; used to exclude other causes"
    ],
    "imaging": [
      "Brain MRI typically normal between attacks",
      "Transient cortical edema or diffusion abnormalities may be seen during attacks"
    ],
    "genetic": [
      "Mutations in CACNA1A, ATP1A2, or SCN1A genes in familial cases"
    ],
    "other": [
      "Electroencephalogram (EEG) may show slowing during attacks"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ischemic-stroke",
      "distinguishingFeatures": [
        "Permanent neurological deficits",
        "Imaging evidence of infarction",
        "Absence of migraine aura symptoms"
      ]
    },
    {
      "diseaseId": "epileptic-seizure",
      "distinguishingFeatures": [
        "Paroxysmal electrical discharges on EEG",
        "Brief motor symptoms without typical migraine headache",
        "Postictal confusion"
      ]
    },
    {
      "diseaseId": "transient-ischemic-attack",
      "distinguishingFeatures": [
        "Sudden onset neurological deficits",
        "No migraine headache",
        "Risk factors for vascular disease"
      ]
    }
  ],
