  "diagnosticCriteria": {
    "formalCriteriaName": "Kasai Diagnostic Criteria for Biliary Atresia",
    "criteria": [
      {
        "id": "persistent-neonatal-jaundice",
        "description": "Persistent conjugated hyperbilirubinemia beyond 2 weeks of age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absent-extrahepatic-bile-ducts",
        "description": "Intraoperative cholangiography showing absence or discontinuity of extrahepatic bile ducts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "liver-biopsy-findings",
        "description": "Liver biopsy demonstrating bile duct proliferation, portal fibrosis, and bile plugs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ultrasound-findings",
        "description": "Ultrasound showing absent or abnormal gallbladder and triangular cord sign",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Persistent conjugated hyperbilirubinemia plus either absent extrahepatic bile ducts on cholangiography or characteristic liver biopsy findings",
    "notes": "Early diagnosis is critical for timely surgical intervention (Kasai portoenterostomy)."
  },
