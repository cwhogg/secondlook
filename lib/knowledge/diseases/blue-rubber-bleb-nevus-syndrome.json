  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria",
    "criteria": [
      {
        "id": "cutaneous-venous-malformations",
        "description": "Presence of multiple characteristic blue, compressible venous malformations on the skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "gastrointestinal-venous-malformations",
        "description": "Venous malformations involving the gastrointestinal tract confirmed by endoscopy or imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-bleeding",
        "description": "Recurrent gastrointestinal bleeding leading to anemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histopathological confirmation of venous malformations if biopsy performed",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of multiple characteristic cutaneous venous malformations plus gastrointestinal venous malformations with or without recurrent bleeding",
    "notes": "Diagnosis is clinical supported by imaging and endoscopic findings; genetic testing is not routinely diagnostic."
  },
