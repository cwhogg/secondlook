  "diagnosticCriteria": {
    "formalCriteriaName": "Chromosomal Microdeletion Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Detection of a heterozygous microdeletion at chromosome 16p13.11 by chromosomal microarray or FISH",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurodevelopmental-features",
        "description": "Presence of neurodevelopmental disorders such as intellectual disability, developmental delay, or autism spectrum disorder",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital anomalies including cardiac defects or dysmorphic features",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history of 16p13.11 microdeletion or related neuropsychiatric disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Genetic confirmation of 16p13.11 microdeletion plus presence of at least one major clinical feature such as neurodevelopmental disorder or congenital anomaly",
    "notes": "Phenotypic variability is common; some individuals may be asymptomatic carriers."
  },
