  "diagnosticCriteria": {
    "formalCriteriaName": "HLH-2004 Diagnostic Criteria (Histiocyte Society)",
    "criteria": [
      {
        "id": "hlh-c1",
        "description": "Fever >= 38.5°C",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hlh-c2",
        "description": "Splenomegaly",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hlh-c3",
        "description": "Cytopenias affecting >= 2 of 3 lineages (hemoglobin <9 g/dL, platelets <100,000/µL, neutrophils <1,000/µL)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hlh-c4",
        "description": "Hypertriglyceridemia (fasting triglycerides >= 265 mg/dL) and/or hypofibrinogenemia (fibrinogen <= 150 mg/dL)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hlh-c5",
        "description": "Hemophagocytosis in bone marrow, spleen, or lymph nodes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hlh-c6",
        "description": "Low or absent NK cell activity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hlh-c7",
        "description": "Ferritin >= 500 ng/mL",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hlh-c8",
        "description": "Elevated soluble CD25 (soluble IL-2 receptor >= 2,400 U/mL)",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Five of 8 criteria must be fulfilled, OR a molecular diagnosis consistent with HLH (PRF1, UNC13D, STX11, STXBP2, RAB27A, etc.)",
    "notes": "HScore is an alternative scoring system. Ferritin >10,000 ng/mL has high specificity for HLH. MAS is the rheumatologic variant associated with autoimmune diseases."
  },
