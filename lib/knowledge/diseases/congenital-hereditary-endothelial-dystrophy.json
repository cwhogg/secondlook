  "diagnosticCriteria": {
    "formalCriteriaName": "CHED Diagnostic Criteria",
    "criteria": [
      {
        "id": "bilateral-corneal-clouding",
        "description": "Presence of bilateral diffuse corneal clouding from birth or early infancy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "endothelial-cell-abnormalities",
        "description": "Histopathologic or specular microscopy evidence of endothelial cell abnormalities and thickened Descemet membrane",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive or dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-inflammation",
        "description": "No signs of corneal inflammation or scarring",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Bilateral corneal clouding from birth or early infancy plus endothelial cell abnormalities on microscopy",
    "notes": "Genetic testing for SLC4A11 mutations can support diagnosis"
  },
