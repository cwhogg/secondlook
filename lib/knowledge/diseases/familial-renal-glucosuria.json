  "diagnosticCriteria": {
    "formalCriteriaName": "Familial Renal Glucosuria Diagnostic Criteria",
    "criteria": [
      {
        "id": "isolated-glucosuria",
        "description": "Persistent renal glucosuria without hyperglycemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-blood-glucose",
        "description": "Normal fasting and postprandial blood glucose levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sglt2-mutation",
        "description": "Identification of pathogenic SGLT2 gene mutation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-renal-disease",
        "description": "Exclusion of other causes of glucosuria and renal tubular dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent isolated glucosuria with normal blood glucose and identification of SGLT2 mutation",
    "notes": "Diagnosis requires exclusion of diabetes mellitus and other renal tubular disorders."
  },
