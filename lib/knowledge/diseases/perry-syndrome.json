  "diagnosticCriteria": {
    "formalCriteriaName": "Perry Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "parkinsonism",
        "description": "Progressive parkinsonism characterized by bradykinesia, rigidity, and tremor",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypoventilation",
        "description": "Central hypoventilation leading to respiratory insufficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "weight-loss",
        "description": "Unexplained severe weight loss",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "depression-apathy",
        "description": "Prominent psychiatric symptoms including depression and apathy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "dctn1-mutation",
        "description": "Presence of pathogenic mutations in the DCTN1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive parkinsonism and central hypoventilation with either a positive family history or DCTN1 mutation",
    "notes": "Diagnosis is clinical and supported by genetic testing; respiratory symptoms often lead to mortality."
  },
