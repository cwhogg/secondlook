  "diagnosticCriteria": {
    "formalCriteriaName": "Hereditary Stomatocytosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "peripheral-blood-smear",
        "description": "Presence of stomatocytes on peripheral blood smear",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "increased-rbc-membrane-permeability",
        "description": "Increased red blood cell membrane permeability to sodium and potassium demonstrated by ion flux studies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemolytic-anemia",
        "description": "Evidence of chronic hemolytic anemia with reticulocytosis and elevated lactate dehydrogenase",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in genes such as PIEZO1 or KCNN4",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of stomatocytes on peripheral blood smear, evidence of hemolytic anemia, and demonstration of increased RBC membrane permeability",
    "notes": "Genetic testing can support diagnosis but is not mandatory"
  },
