  "diagnosticCriteria": {
    "formalCriteriaName": "AASLD/EASL Diagnostic Criteria for PBC",
    "criteria": [
      {
        "id": "pbc-1",
        "description": "Elevated alkaline phosphatase (ALP) and/or GGT indicating cholestasis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pbc-2",
        "description": "Positive anti-mitochondrial antibody (AMA) >= 1:40 or AMA-M2 positive",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pbc-3",
        "description": "Liver biopsy showing non-suppurative destructive cholangitis (florid duct lesion) and granulomatous destruction of interlobular bile ducts",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "pbc-4",
        "description": "PBC-specific ANA (anti-sp100, anti-gp210) in AMA-negative patients",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "At least 2 of 3: cholestatic biochemistry, positive AMA (or PBC-specific ANA), and compatible liver histology",
    "notes": "Diagnosis can often be made without liver biopsy if AMA is positive and cholestatic liver enzymes are present. AMA-negative PBC (~5%) may have PBC-specific ANA (anti-sp100, anti-gp210)."
  },
