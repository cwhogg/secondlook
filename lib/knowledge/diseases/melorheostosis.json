  "diagnosticCriteria": {
    "formalCriteriaName": "Melorheostosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "radiographic-flowing-hyperostosis",
        "description": "Characteristic flowing hyperostosis along the cortex of long bones on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-pain-deformity",
        "description": "Presence of localized bone pain and deformity in affected limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology-sclerosing-bone",
        "description": "Histopathological evidence of sclerosing bone dysplasia with thickened cortical bone",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-sclerosing-dysplasias",
        "description": "Exclusion of other sclerosing bone dysplasias such as osteopathia striata or osteopoikilosis",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Radiographic flowing hyperostosis plus clinical symptoms of pain or deformity, with exclusion of other sclerosing bone dysplasias",
    "notes": "Genetic testing may assist but no definitive mutation identified in all cases; diagnosis primarily clinical and radiographic"
  },
