  "diagnosticCriteria": {
    "formalCriteriaName": "Cystic Fibrosis Foundation Consensus Guidelines",
    "criteria": [
      {
        "id": "positive-sweat-test",
        "description": "Elevated sweat chloride concentration ≥60 mmol/L on two separate occasions",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cftr-mutation",
        "description": "Identification of pathogenic CFTR mutations on both alleles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features such as chronic sinopulmonary disease, pancreatic insufficiency, or elevated immunoreactive trypsinogen in newborn screening",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "nasal-potential-difference",
        "description": "Abnormal nasal potential difference measurement consistent with CFTR dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical features consistent with CF plus either a positive sweat chloride test or identification of two CFTR mutations",
    "notes": "Newborn screening and genetic testing have improved early diagnosis; sweat chloride remains the gold standard diagnostic test."
  },
