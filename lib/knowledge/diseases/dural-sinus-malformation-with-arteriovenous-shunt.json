  "diagnosticCriteria": {
    "formalCriteriaName": "No formal consensus criteria established",
    "criteria": [
      {
        "id": "imaging-evidence",
        "description": "Presence of dilated dural venous sinus with abnormal arteriovenous shunting on MRI/MRA or angiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Neurological symptoms consistent with venous hypertension such as seizures or hydrocephalus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-malformations",
        "description": "Exclusion of other intracranial vascular malformations such as vein of Galen malformation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "supportive-neuroimaging",
        "description": "Evidence of venous congestion or brain parenchymal changes secondary to venous hypertension",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Imaging evidence of dural sinus malformation with arteriovenous shunting plus clinical symptoms consistent with venous hypertension, excluding other vascular malformations",
    "notes": "Diagnosis relies heavily on neuroimaging and clinical correlation; no standardized diagnostic criteria currently exist."
  },
