  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic Criteria for Multiminicore Myopathy with Arthrogryposis",
    "criteria": [
      {
        "id": "clinical-features",
        "description": "Presence of congenital arthrogryposis multiplex congenita with multiple joint contractures at birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing multiple small cores with reduced oxidative enzyme activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with multiminicore myopathy (e.g., SEPN1, RYR1)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Electromyographic evidence of myopathic changes",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital arthrogryposis multiplex congenita, characteristic muscle biopsy findings, and pathogenic genetic variants",
    "notes": "Diagnosis requires integration of clinical, histopathological, and genetic data."
  },
