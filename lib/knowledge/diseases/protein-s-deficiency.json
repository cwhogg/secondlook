  "diagnosticCriteria": {
    "formalCriteriaName": "Protein S Deficiency Diagnostic Criteria",
    "criteria": [
      {
        "id": "low-protein-s-activity",
        "description": "Reduced free and/or total protein S activity levels confirmed by functional assays",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history-thrombosis",
        "description": "Positive family history of venous thromboembolism or known protein S deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "recurrent-thrombotic-events",
        "description": "History of recurrent venous thromboembolism without other identifiable risk factors",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the PROS1 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of reduced protein S activity levels plus either recurrent thrombotic events or family history of thrombosis",
    "notes": "Functional assays should be performed off anticoagulation and after exclusion of acquired causes."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Recurrent venous thromboembolism",
        "frequency": 0.85,
        "bodySystem": "hematological",
        "notes": "Includes deep vein thrombosis and pulmonary embolism"
      },
      {
        "symptomName": "Venous thrombosis at unusual sites",
        "frequency": 0.75,
        "bodySystem": "hematological",
        "notes": "Such as cerebral venous sinus thrombosis or mesenteric vein thrombosis"
      }
    ],
    "common": [
      {
        "symptomName": "Deep vein thrombosis",
        "frequency": 0.7,
        "bodySystem": "hematological",
        "notes": "Typically in lower extremities"
      },
      {
        "symptomName": "Pulmonary embolism",
        "frequency": 0.65,
        "bodySystem": "respiratory",
        "notes": "May present with dyspnea and chest pain"
      },
      {
        "symptomName": "Leg swelling and pain",
        "frequency": 0.6,
        "bodySystem": "musculoskeletal",
        "notes": "Due to venous obstruction"
      },
      {
        "symptomName": "Skin necrosis at warfarin initiation",
        "frequency": 0.55,
        "bodySystem": "dermatological",
        "notes": "Rare but characteristic complication"
      }
    ],
    "occasional": [
      {
        "symptomName": "Transient ischemic attacks or stroke",
        "frequency": 0.3,
        "bodySystem": "neurological",
        "notes": "Due to paradoxical embolism"
      },
      {
        "symptomName": "Superficial thrombophlebitis",
        "frequency": 0.25,
        "bodySystem": "hematological",
        "notes": "Inflammation of superficial veins"
      },
      {
        "symptomName": "Chronic venous insufficiency",
        "frequency": 0.2,
        "bodySystem": "musculoskeletal",
        "notes": "Due to recurrent venous thrombosis"
      },
      {
        "symptomName": "Pregnancy complications including fetal loss",
        "frequency": 0.15,
        "bodySystem": "reproductive",
        "notes": "Associated with thrombophilia"
      }
    ],
    "rare": [
      {
        "symptomName": "Arterial thrombosis",
        "frequency": 0.05,
        "bodySystem": "cardiovascular",
        "notes": "Less common than venous thrombosis"
      },
      {
        "symptomName": "Heparin-induced skin necrosis",
        "frequency": 0.03,
        "bodySystem": "dermatological",
        "notes": "Rare complication in protein S deficiency"
      },
      {
        "symptomName": "Purpura fulminans in neonates",
        "frequency": 0.02,
        "bodySystem": "dermatological",
        "notes": "Severe neonatal presentation"
      }
    ]
  },
