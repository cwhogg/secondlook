  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for SCA12",
    "criteria": [
      {
        "id": "progressive-cerebellar-ataxia",
        "description": "Presence of progressive cerebellar ataxia characterized by gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intention-tremor",
        "description": "Intention tremor predominantly affecting upper limbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cag-repeat-expansion",
        "description": "Detection of expanded CAG trinucleotide repeats in the PPP2R2B gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-other-causes",
        "description": "Exclusion of other causes of ataxia by clinical and laboratory evaluation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia and intention tremor with confirmed pathogenic CAG repeat expansion in PPP2R2B gene",
    "notes": "Genetic testing is definitive; clinical features guide testing decisions."
  },
