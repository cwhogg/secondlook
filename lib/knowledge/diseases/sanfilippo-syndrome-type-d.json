        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "heparan-sulfate-accumulation",
        "description": "Elevated urinary excretion of heparan sulfate glycosaminoglycans",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the GNS gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of progressive neurodegeneration with behavioral disturbances and developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of alpha-N-acetylglucosamine-6-sulfatase enzyme activity plus elevated urinary heparan sulfate or pathogenic GNS gene mutations",
    "notes": "Diagnosis is confirmed by enzymatic assay and/or molecular genetic testing."
  },
