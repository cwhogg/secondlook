  "keyFindings": {
    "laboratory": [
      "Mild anemia and thrombocytopenia on complete blood count",
      "Normal to mildly elevated serum calcium and phosphate",
      "Elevated alkaline phosphatase in some cases"
    ],
    "imaging": [
      "Generalized osteosclerosis with 'bone within bone' and 'sandwich vertebrae' appearance on X-rays",
      "CT/MRI may show cranial nerve foramina narrowing"
    ],
    "genetic": [
      "TCIRG1 (causative)",
      "CLCN7 (causative)",
      "PLEKHM1 (causative)",
      "Autosomal recessive inheritance pattern"
    ],
    "other": [
      "Bone marrow biopsy showing reduced marrow space with increased bone trabeculae"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "infantile-malignant-osteopetrosis",
      "distinguishingFeatures": [
        "Earlier onset with severe hematological failure",
        "Marked cranial nerve compression symptoms",
        "More aggressive clinical course"
      ]
    },
    {
      "diseaseId": "benign-autosomal-dominant-osteopetrosis",
      "distinguishingFeatures": [
        "Milder symptoms with later onset",
        "Normal or mildly affected hematological parameters",
        "Autosomal dominant inheritance"
      ]
    }
  ],
  "redFlags": [
    "Progressive cranial nerve deficits (vision or hearing loss)",
    "Severe anemia or thrombocytopenia requiring transfusions",
    "Pathologic fractures with minimal trauma"
  ],
