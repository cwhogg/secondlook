  "diagnosticCriteria": {
    "formalCriteriaName": "Ohtahara Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "early-onset-seizures",
        "description": "Onset of seizures within the first 3 months of life",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "suppression-burst-pattern",
        "description": "EEG showing characteristic suppression-burst pattern",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-arrest",
        "description": "Severe developmental delay or arrest",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "refractory-epilepsy",
        "description": "Seizures refractory to standard antiepileptic treatments",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "neuroimaging-abnormalities",
        "description": "Brain MRI showing structural abnormalities or atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset seizures, suppression-burst EEG pattern, and developmental arrest",
    "notes": "Diagnosis is primarily clinical supported by EEG findings; genetic testing may aid in identifying underlying etiology."
  },
