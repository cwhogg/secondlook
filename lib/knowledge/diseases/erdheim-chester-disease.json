  "diagnosticCriteria": {
    "criteria": [
      {
        "id": "ecd-maj1",
        "description": "Histological confirmation: foamy histiocytes (lipid-laden macrophages) positive for CD68 and CD163, negative for CD1a and langerin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ecd-maj2",
        "description": "Bilateral symmetric osteosclerosis of long bone diaphyses/metaphyses on imaging",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ecd-min1",
        "description": "BRAF V600E mutation or other MAPK pathway mutation in lesional tissue",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ecd-min2",
        "description": "Characteristic perinephric/periaortic soft tissue infiltration ('coated aorta' or 'hairy kidney')",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ecd-sup1",
        "description": "Exophthalmos, xanthelasma, or retro-orbital infiltration",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histological confirmation with appropriate immunophenotype (CD68+, CD1a-) combined with compatible clinical and radiographic features. BRAF testing should be performed in all cases.",
    "notes": "Classified as a neoplastic histiocytic disorder (WHO 2016 revision). BRAF V600E mutation present in ~55-70% of cases. May overlap with LCH ('mixed histiocytosis')."
  },
