  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Acute Infantile Liver Failure-Cerebellar Ataxia-Peripheral Sensory Motor Neuropathy Syndrome",
    "criteria": [
      {
        "id": "acute-liver-failure",
        "description": "Onset of acute liver failure in infancy characterized by coagulopathy and elevated transaminases",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebellar-ataxia",
        "description": "Clinical evidence of cerebellar ataxia including gait disturbance and limb dysmetria",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "peripheral-neuropathy",
        "description": "Electrophysiological or clinical evidence of peripheral sensory motor neuropathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-causes",
        "description": "Exclusion of other metabolic, infectious, or genetic causes of liver failure and neuropathy",
        "category": "supportive",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in associated genes if known",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of acute infantile liver failure, cerebellar ataxia, and peripheral sensory motor neuropathy with exclusion of other causes",
    "notes": "Diagnosis is clinical and supported by laboratory and electrophysiological findings; genetic markers may be identified in some cases."
  },
