  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and hematological criteria for beta-thalassemia intermedia",
    "criteria": [
      {
        "id": "hemoglobin-levels",
        "description": "Moderate anemia with hemoglobin levels typically between 7-10 g/dL",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "transfusion-independence",
        "description": "Absence of regular transfusion requirement or transfusion independence",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of beta-globin gene mutations consistent with intermediate phenotype",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-expansion",
        "description": "Evidence of bone marrow expansion on imaging or clinical examination",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "hemoglobin-electrophoresis",
        "description": "Elevated HbF and HbA2 levels on hemoglobin electrophoresis",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of moderate anemia (Hb 7-10 g/dL), transfusion independence, and genetic confirmation of beta-globin mutations consistent with intermedia phenotype",
    "notes": "Diagnosis requires exclusion of beta-thalassemia major and minor; clinical severity varies widely."
  },
