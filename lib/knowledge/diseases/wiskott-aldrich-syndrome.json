  "diagnosticCriteria": {
    "formalCriteriaName": "Wiskott-Aldrich Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "thrombocytopenia",
        "description": "Persistent thrombocytopenia with small platelets",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eczema",
        "description": "Chronic eczema or atopic dermatitis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "recurrent-infections",
        "description": "Recurrent bacterial, viral, or fungal infections due to immunodeficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "was-gene-mutation",
        "description": "Identification of pathogenic mutation in the WAS gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of thrombocytopenia with small platelets, eczema, recurrent infections, and/or identification of WAS gene mutation",
    "notes": "Diagnosis is confirmed by genetic testing for WAS gene mutations."
  },
