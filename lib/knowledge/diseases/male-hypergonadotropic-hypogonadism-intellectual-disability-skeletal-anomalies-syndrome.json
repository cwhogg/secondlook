  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Male Hypergonadotropic Hypogonadism-Intellectual Disability-Skeletal Anomalies Syndrome",
    "criteria": [
      {
        "id": "hypergonadotropic-hypogonadism",
        "description": "Elevated gonadotropin levels with low testosterone indicating primary testicular failure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "intellectual-disability",
        "description": "Mild to moderate intellectual disability confirmed by neuropsychological testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-anomalies",
        "description": "Presence of skeletal abnormalities including clinodactyly, short stature, and vertebral anomalies",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features such as hypertelorism and broad nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "delayed-pubertal-development",
        "description": "Delayed or absent secondary sexual characteristics consistent with hypogonadism",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: hypergonadotropic hypogonadism, intellectual disability, and skeletal anomalies",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
