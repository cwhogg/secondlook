  "keyFindings": {
    "laboratory": [
      "Elevated liver enzymes indicating cholestasis",
      "Abnormal liver function tests"
    ],
    "imaging": [
      "Ultrasound or cholangiography showing biliary hypoplasia or atresia",
      "Echocardiogram revealing cardiac septal defects",
      "Skeletal X-rays demonstrating vertebral or limb anomalies"
    ],
    "genetic": [
      "MED12 (causative, loss-of-function)",
      "Possible autosomal recessive inheritance pattern suggested",
      "X-linked dominant inheritance"
    ],
    "other": [
      "Histopathology of liver biopsy showing bile duct paucity"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "alagille-syndrome",
      "distinguishingFeatures": [
        "Presence of butterfly vertebrae",
        "Characteristic facial features differ (prominent forehead, pointed chin)",
        "JAG1 or NOTCH2 gene mutations"
      ]
    },
    {
      "diseaseId": "biliary-atresia",
      "distinguishingFeatures": [
        "Isolated biliary obstruction without craniofacial anomalies",
        "Typically presents with jaundice in infancy",
        "No associated cardiac or ocular anomalies"
      ]
    }
  ],
  "redFlags": [
    "Progressive cholestasis leading to liver failure",
    "Severe congenital heart defects causing hemodynamic instability",
    "Airway compromise related to craniofacial malformations"
  ],
