  "keyFindings": {
    "laboratory": [
      "Presence of anti-neuronal antibodies (e.g., anti-Ri, anti-Hu)",
      "Elevated cerebrospinal fluid (CSF) protein and lymphocytic pleocytosis",
      "Elevated inflammatory markers (ESR, CRP) in some cases"
    ],
    "imaging": [
      "MRI brain may show cerebellar atrophy or normal findings",
      "PET scan may reveal hypermetabolism in cerebellum or brainstem"
    ],
    "genetic": [
      "No specific genetic mutations identified; primarily autoimmune etiology"
    ],
    "other": [
      "Association with neuroblastoma in pediatric cases",
      "Response to immunotherapy supports autoimmune pathogenesis"
    ]
  },
