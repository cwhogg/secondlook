  "diagnosticCriteria": {
    "formalCriteriaName": "Ataxia-Telangiectasia Diagnostic Criteria",
    "criteria": [
      {
        "id": "ataxia",
        "description": "Progressive cerebellar ataxia presenting in early childhood",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "telangiectasia",
        "description": "Oculocutaneous telangiectasia, especially conjunctival telangiectasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunodeficiency",
        "description": "Combined immunodeficiency with low IgA and IgG subclasses and lymphopenia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "atm-mutation",
        "description": "Biallelic pathogenic mutations in the ATM gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "elevated-alpha-fetoprotein",
        "description": "Elevated serum alpha-fetoprotein levels after infancy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia and oculocutaneous telangiectasia with immunodeficiency, supported by ATM gene mutation or elevated alpha-fetoprotein",
    "notes": "Genetic testing for ATM mutations is confirmatory; immunological workup is essential for diagnosis and management."
  },
