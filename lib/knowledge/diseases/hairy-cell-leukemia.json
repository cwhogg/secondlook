  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Hairy Cell Leukemia",
    "criteria": [
      {
        "id": "morphology",
        "description": "Presence of characteristic 'hairy' cytoplasmic projections on peripheral blood smear or bone marrow aspirate",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunophenotyping",
        "description": "Expression of CD19, CD20, CD22, CD11c, CD25, CD103, and annexin A1 on leukemic cells by flow cytometry or immunohistochemistry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-fibrosis",
        "description": "Bone marrow biopsy showing reticulin fibrosis and infiltration by hairy cells",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "braf-v600e-mutation",
        "description": "Detection of BRAF V600E mutation in leukemic cells",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of characteristic hairy cells on morphology plus confirmatory immunophenotyping and bone marrow biopsy findings",
    "notes": "BRAF V600E mutation testing supports diagnosis but is not mandatory"
  },
