        "Different genetic mutations",
        "Variable MRI patterns without cystic degeneration"
      ]
    },
    {
      "diseaseId": "multiple-sclerosis",
      "distinguishingFeatures": [
        "Relapsing-remitting course",
        "MRI lesions with contrast enhancement",
        "Presence of oligoclonal bands in CSF"
      ]
    }
  ],
