  "keyFindings": {
    "laboratory": [
      "Anemia of chronic disease",
      "Elevated lactate dehydrogenase (LDH)",
      "Possible mild leukocytosis"
    ],
    "imaging": [
      "Multiple peritoneal soft tissue masses on CT or MRI",
      "Ascites and omental caking",
      "Occasional pleural effusions"
    ],
    "genetic": [
      "WT1 (fusion gene)",
      "EWSR1 (fusion gene)"
    ],
    "other": [
      "Histopathology showing nests of small round blue cells with desmoplastic stroma",
      "Immunohistochemistry positive for cytokeratin, desmin (dot-like pattern), and vimentin"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "ewing-sarcoma",
      "distinguishingFeatures": [
        "EWSR1-FLI1 gene fusion instead of EWSR1-WT1",
        "Lack of desmoplastic stroma",
        "Different immunohistochemical profile (usually CD99 positive)"
      ]
    },
    {
      "diseaseId": "rhabdomyosarcoma",
      "distinguishingFeatures": [
        "Expression of myogenic markers (myogenin, MyoD1)",
        "Absence of EWSR1-WT1 fusion",
        "Different histologic appearance without desmoplastic stroma"
      ]
    }
  ],
