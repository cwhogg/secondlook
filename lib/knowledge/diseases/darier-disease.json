  "differentialDiagnoses": [
    {
      "diseaseId": "seborrheic-dermatitis",
      "distinguishingFeatures": [
        "Lacks histological acantholysis and dyskeratosis",
        "Lesions less hyperkeratotic and greasy",
        "No characteristic nail changes"
      ]
    },
    {
      "diseaseId": "hailey-hailey-disease",
      "distinguishingFeatures": [
        "Histology shows suprabasal acantholysis without dyskeratosis",
        "Lesions typically in intertriginous areas",
        "Different genetic mutation (ATP2C1 gene)"
      ]
    }
  ],
  "redFlags": [
