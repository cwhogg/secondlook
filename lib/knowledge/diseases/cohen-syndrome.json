  "keyFindings": {
    "laboratory": [
      "Persistent neutropenia with normal bone marrow cellularity",
      "Normal or mildly elevated inflammatory markers",
      "Normal metabolic panel"
    ],
    "imaging": [
      "Retinal imaging showing pigmentary retinopathy",
      "Brain MRI may show mild cortical atrophy",
      "Skeletal X-rays may reveal scoliosis or joint laxity"
    ],
    "genetic": [
      "VPS13B (causative)",
      "Confirmed autosomal recessive inheritance pattern"
    ],
    "other": [
      "Electroretinogram abnormalities consistent with retinal dystrophy",
      "Neutrophil functional assays may show impaired chemotaxis"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "angelman-syndrome",
      "distinguishingFeatures": [
        "Severe intellectual disability with ataxia",
        "Characteristic happy demeanor",
        "Absence of neutropenia and retinal dystrophy"
      ]
    },
    {
      "diseaseId": "bardet-biedl-syndrome",
      "distinguishingFeatures": [
        "Polydactyly and renal anomalies",
        "Obesity with retinal dystrophy",
        "No neutropenia or characteristic facial features of Cohen syndrome"
      ]
    },
    {
      "diseaseId": "prader-willi-syndrome",
      "distinguishingFeatures": [
        "Hypotonia and hyperphagia leading to obesity",
        "Distinct facial features different from Cohen syndrome",
        "No neutropenia or retinal dystrophy"
      ]
    }
  ],
  "redFlags": [
