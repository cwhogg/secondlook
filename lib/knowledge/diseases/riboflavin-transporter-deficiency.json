  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Riboflavin Transporter Deficiency",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Progressive pontobulbar palsy with sensorineural hearing loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of biallelic pathogenic variants in SLC52A2 or SLC52A3 genes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-marker",
        "description": "Low plasma riboflavin or flavin adenine dinucleotide (FAD) levels",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive pontobulbar palsy with sensorineural hearing loss plus biallelic pathogenic variants in SLC52A2 or SLC52A3",
    "notes": "Early diagnosis is critical for treatment with high-dose riboflavin supplementation."
  },
