  "diagnosticCriteria": {
    "formalCriteriaName": "Endocrine Society Clinical Practice Guideline for Cushing Syndrome",
    "criteria": [
      {
        "id": "hypercortisolism-confirmation",
        "description": "Elevated 24-hour urinary free cortisol or elevated late-night salivary cortisol",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "lack-of-cortisol-suppression",
        "description": "Failure to suppress serum cortisol after low-dose dexamethasone suppression test",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "elevated-acth",
        "description": "Inappropriately normal or elevated plasma ACTH indicating ACTH-dependent hypercortisolism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pituitary-mri",
        "description": "Detection of pituitary adenoma on MRI",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "inferior-petrosal-sinus-sampling",
        "description": "Central to peripheral ACTH gradient confirming pituitary source",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of biochemical evidence of hypercortisolism with elevated or inappropriately normal ACTH levels consistent with ACTH-dependent Cushing syndrome, plus pituitary source confirmation by imaging or inferior petrosal sinus sampling",
    "notes": "Diagnosis requires exclusion of ectopic ACTH secretion and adrenal causes"
  },
