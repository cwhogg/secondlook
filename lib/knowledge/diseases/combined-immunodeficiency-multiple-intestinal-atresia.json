  "keyFindings": {
    "laboratory": [
      "Severe lymphopenia with reduced CD3+ and CD19+ cells",
      "Hypogammaglobulinemia",
      "Elevated inflammatory markers during infections"
    ],
    "imaging": [
      "Radiologic evidence of multiple intestinal atresias on abdominal X-ray or contrast studies",
      "Ultrasound showing bowel dilatation proximal to atresias"
    ],
    "genetic": [
      "TTC7A (causative, loss-of-function)",
      "PI4KA (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Histopathology of resected bowel showing mucosal abnormalities and inflammation",
      "Bone marrow biopsy may show hypocellularity"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "severe-combined-immunodeficiency",
      "distinguishingFeatures": [
        "Absence of multiple intestinal atresias",
        "More generalized immunodeficiency without gastrointestinal structural anomalies"
      ]
    },
    {
      "diseaseId": "isolated-multiple-intestinal-atresia",
      "distinguishingFeatures": [
        "Lack of combined immunodeficiency",
        "Normal immune function tests"
      ]
    },
    {
      "diseaseId": "tetratricopeptide-repeat-domain-7a-deficiency",
      "distinguishingFeatures": [
        "Genetic confirmation of TTC7A mutation",
        "Overlap with CID-MIA but may have variable immunological phenotype"
      ]
    }
  ],
  "redFlags": [
    "Neonatal bowel obstruction with failure to pass meconium",
    "Severe recurrent infections in early infancy",
    "Rapid clinical deterioration despite standard surgical and medical interventions"
  ],
