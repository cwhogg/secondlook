  "diagnosticCriteria": {
    "formalCriteriaName": "Krabbe Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficient galactocerebrosidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Progressive neurological deterioration including irritability, spasticity, and developmental regression",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing demyelination predominantly in the cerebral white matter and corticospinal tracts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the GALC gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of deficient galactocerebrosidase enzyme activity plus compatible clinical presentation and supportive neuroimaging findings",
    "notes": "Newborn screening and genetic testing are increasingly used for early diagnosis."
  },
