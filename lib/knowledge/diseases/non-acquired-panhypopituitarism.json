  "diagnosticCriteria": {
    "formalCriteriaName": "Consensus Diagnostic Criteria for Panhypopituitarism",
    "criteria": [
      {
        "id": "hormone-deficiency",
        "description": "Deficiency of at least three anterior pituitary hormones confirmed by biochemical testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pituitary-hypoplasia",
        "description": "MRI evidence of hypoplastic or absent anterior pituitary gland",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of clinical features consistent with multiple pituitary hormone deficiencies (e.g., growth failure, hypothyroidism, adrenal insufficiency)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in pituitary development genes (optional supportive)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Biochemical confirmation of deficiency in at least three anterior pituitary hormones plus MRI evidence of pituitary hypoplasia or aplasia",
    "notes": "Genetic testing may support diagnosis but is not mandatory."
  },
