  "diagnosticCriteria": {
    "formalCriteriaName": "Schöpf-Schulz-Passarge syndrome diagnostic criteria",
    "criteria": [
      {
        "id": "palmoplantar-keratoderma",
        "description": "Diffuse palmoplantar keratoderma with hyperkeratosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "eyelid-cysts",
        "description": "Multiple apocrine hidrocystomas of the eyelids",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypotrichosis",
        "description": "Congenital hypotrichosis or sparse scalp hair",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypodontia",
        "description": "Hypodontia or oligodontia with enamel hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "nail-dystrophy",
        "description": "Nail dystrophy including brittle or dystrophic nails",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: palmoplantar keratoderma, multiple eyelid apocrine hidrocystomas, and hypotrichosis",
    "notes": "Genetic testing for WNT10A mutations can support diagnosis"
  },
