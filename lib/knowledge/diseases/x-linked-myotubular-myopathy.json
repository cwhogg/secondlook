  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for X-linked Myotubular Myopathy",
    "criteria": [
      {
        "id": "clinical-presentation",
        "description": "Severe generalized muscle weakness and hypotonia presenting in male neonates or infants",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing centrally placed nuclei in muscle fibers (centronuclear myopathy pattern)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutation in the MTM1 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "respiratory-failure",
        "description": "Early respiratory insufficiency requiring ventilatory support",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with X-linked inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical presentation plus either muscle biopsy findings or genetic confirmation of MTM1 mutation",
    "notes": "Genetic testing is considered the gold standard for definitive diagnosis."
  },
