  "diagnosticCriteria": {
    "formalCriteriaName": "Emery-Dreifuss Muscular Dystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "early-joint-contractures",
        "description": "Early-onset contractures of the elbows, Achilles tendons, and posterior cervical muscles",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "humeroperoneal-muscle-weakness",
        "description": "Progressive humeroperoneal muscle weakness and wasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cardiac-conduction-defects",
        "description": "Cardiac conduction defects including atrioventricular block and arrhythmias",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "emery-dreifuss-genetic-testing",
        "description": "Identification of pathogenic variants in the LMNA gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of early joint contractures, humeroperoneal muscle weakness, cardiac conduction defects, and pathogenic LMNA mutation or compatible family history",
    "notes": "Genetic testing is critical for confirmation; cardiac evaluation is essential due to risk of sudden cardiac death."
  },
