  "diagnosticCriteria": {
    "formalCriteriaName": "Neuroimaging-based diagnostic criteria for polymicrogyria",
    "criteria": [
      {
        "id": "imaging-pattern",
        "description": "Presence of excessive small, irregular gyri with abnormal cortical lamination on MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Neurological symptoms including epilepsy and developmental delay",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-of-other-malformations",
        "description": "Exclusion of other cortical malformations such as lissencephaly or pachygyria",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "MRI evidence of characteristic cortical malformation plus compatible clinical features such as epilepsy or developmental impairment",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
