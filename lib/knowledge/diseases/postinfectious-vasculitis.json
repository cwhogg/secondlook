  "keyFindings": {
    "laboratory": [
      "Elevated ESR and CRP",
      "Normal or negative ANCA and ANA",
      "Leukocytosis with neutrophilia"
    ],
    "imaging": [
      "Angiography may show vessel irregularities in medium-sized vessels",
      "MRI for CNS involvement if suspected"
    ],
    "genetic": [],
    "other": [
      "Skin or organ biopsy confirming leukocytoclastic or necrotizing vasculitis",
      "Evidence of recent infection (positive cultures, serology)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "primary-systemic-vasculitis",
      "distinguishingFeatures": [
        "Lack of preceding infection",
        "Presence of specific autoantibodies (e.g., ANCA)",
        "Chronic relapsing course"
      ]
    },
    {
      "diseaseId": "hypersensitivity-vasculitis",
      "distinguishingFeatures": [
        "Often drug-induced",
        "More limited cutaneous involvement",
        "Less systemic symptoms"
      ]
    },
    {
      "diseaseId": "infective-endocarditis-associated-vasculitis",
      "distinguishingFeatures": [
        "Positive blood cultures",
        "Cardiac murmur",
        "Vegetations on echocardiogram"
      ]
    }
  ],
  "redFlags": [
    "Rapid progression of skin necrosis or ulceration",
    "Signs of organ failure (renal, neurological)",
    "Uncontrolled systemic infection"
  ],
