  "keyFindings": {
    "laboratory": [
      "Hyperchloremic metabolic acidosis with normal anion gap",
      "Hypokalemia",
      "Elevated urine pH >5.5 despite systemic acidemia",
      "Low serum bicarbonate",
      "Normal or mildly reduced GFR"
    ],
    "imaging": [
      "Renal ultrasound showing nephrocalcinosis or nephrolithiasis",
      "Bone X-rays showing signs of rickets or osteomalacia in children"
    ],
    "genetic": [
      "Mutations in ATP6V1B1 or ATP6V0A4 genes (autosomal recessive distal RTA)",
      "SLC4A1 gene mutations (autosomal dominant distal RTA)"
    ],
    "other": [
      "Urine acidification test demonstrating failure to lower urine pH after acid load"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "renal-tubular-acidosis-type-2",
      "distinguishingFeatures": [
        "Proximal tubular defect with low urine pH",
        "Generalized proximal tubule dysfunction (Fanconi syndrome)",
        "More prominent bicarbonate wasting"
      ]
    },
    {
      "diseaseId": "primary-hyperparathyroidism",
      "distinguishingFeatures": [
        "Hypercalcemia rather than hypocalcemia",
        "Elevated parathyroid hormone levels",
        "Different acid-base disturbance"
      ]
    },
    {
      "diseaseId": "medullary-cystic-kidney-disease",
      "distinguishingFeatures": [
        "Progressive renal failure",
        "Medullary cysts on imaging",
        "No primary acidification defect"
      ]
    }
  ],
  "redFlags": [
    "Severe hypokalemia causing paralysis or arrhythmias",
    "Progressive nephrocalcinosis leading to renal failure",
    "Failure to thrive or growth retardation in children"
  ],
  "specialistType": [
    "Nephrologist",
