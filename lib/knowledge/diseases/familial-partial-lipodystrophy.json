  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Genetic Diagnostic Criteria for Familial Partial Lipodystrophy",
    "criteria": [
      {
        "id": "regional-adipose-loss",
        "description": "Progressive loss of subcutaneous adipose tissue in the limbs and trunk with relative fat accumulation in face and neck",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "metabolic-complications",
        "description": "Presence of insulin resistance, diabetes mellitus, or dyslipidemia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes such as LMNA, PPARG, or AKT2",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "muscle-hypertrophy",
        "description": "Clinical evidence of muscular hypertrophy in affected regions",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of regional adipose tissue loss plus metabolic complications, with or without genetic confirmation",
    "notes": "Genetic testing can confirm diagnosis but is not always necessary if clinical features are typical."
  },
