  "diagnosticCriteria": {
    "formalCriteriaName": "International Amyloidosis Society Consensus Criteria",
    "criteria": [
      {
        "id": "al-c1",
        "description": "Tissue biopsy showing amyloid deposits (Congo red stain with apple-green birefringence under polarized light)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "al-c2",
        "description": "Typing of amyloid deposits as light chain origin (mass spectrometry, immunoelectron microscopy, or immunohistochemistry)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "al-c3",
        "description": "Evidence of plasma cell dyscrasia (monoclonal protein in serum/urine, abnormal free light chain ratio, or clonal plasma cells in marrow)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "al-c4",
        "description": "Evidence of amyloid-related organ dysfunction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Tissue-proven amyloid (Congo red positive), typed as AL, plus evidence of underlying plasma cell clone",
    "notes": "Amyloid typing is critical; misclassification of amyloid type leads to incorrect treatment. Mass spectrometry-based proteomics is the gold standard for typing. Fat pad aspiration is ~80% sensitive."
  },
