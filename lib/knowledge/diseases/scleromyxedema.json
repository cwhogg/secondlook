  "keyFindings": {
    "laboratory": [
      "Serum protein electrophoresis showing monoclonal IgG lambda gammopathy",
      "Elevated ESR and inflammatory markers",
      "Normal thyroid function tests"
    ],
    "imaging": [
      "Chest X-ray or CT showing pulmonary fibrosis or restrictive lung disease",
      "Echocardiogram may reveal myocardial involvement or heart failure"
    ],
    "genetic": [
      "No known genetic mutations associated"
    ],
    "other": [
      "Skin biopsy demonstrating dermal mucin deposition, fibroblast proliferation, and fibrosis",
      "Electromyography showing myopathic changes"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "systemic-sclerosis",
      "distinguishingFeatures": [
        "Presence of specific autoantibodies (e.g. anti-Scl-70)",
        "Raynaud phenomenon common",
        "Absence of monoclonal gammopathy"
      ]
    },
    {
      "diseaseId": "thyroid-myxedema",
      "distinguishingFeatures": [
        "Associated with hypothyroidism",
        "Elevated TSH and low thyroid hormone levels",
        "Skin changes localized and non-papular"
      ]
    },
    {
      "diseaseId": "lichen-myxedematosus-localized",
      "distinguishingFeatures": [
        "Localized papular lesions without systemic involvement",
        "No monoclonal gammopathy",
        "Less extensive skin induration"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive skin induration with systemic symptoms",
    "Development of cardiac or pulmonary complications",
    "Neurological deterioration including seizures or encephalopathy"
  ],
