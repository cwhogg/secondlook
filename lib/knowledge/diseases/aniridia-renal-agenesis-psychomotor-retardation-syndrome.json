        "Genitourinary anomalies distinct from renal agenesis",
        "PAX6 gene deletion identifiable"
      ]
    },
    {
      "diseaseId": "isolated-aniridia",
      "distinguishingFeatures": [
        "Absence of renal anomalies",
        "Normal psychomotor development",
        "Often familial inheritance pattern"
      ]
    },
