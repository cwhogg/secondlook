  "diagnosticCriteria": {
    "formalCriteriaName": "Spinocerebellar Ataxia Diagnostic Criteria",
    "criteria": [
      {
        "id": "progressive-cerebellar-ataxia",
        "description": "Progressive cerebellar ataxia manifesting as gait and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the PDYN gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-ataxias",
        "description": "Exclusion of other causes of ataxia by clinical and laboratory evaluation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Progressive cerebellar ataxia with positive family history and genetic confirmation of PDYN mutation",
    "notes": "Genetic testing is essential for definitive diagnosis due to phenotypic overlap with other SCAs."
  },
