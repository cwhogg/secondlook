  "diagnosticCriteria": {
    "formalCriteriaName": "Pachyonychia Congenita Clinical Diagnostic Criteria",
    "criteria": [
      {
        "id": "nail-thickening",
        "description": "Presence of hypertrophic nail dystrophy affecting fingernails and toenails",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "plantar-keratoderma",
        "description": "Painful focal plantar keratoderma with callus formation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "oral-leukokeratosis",
        "description": "Oral leukokeratosis presenting as white plaques on oral mucosa",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "follicular-hyperkeratosis",
        "description": "Follicular hyperkeratosis with keratotic papules on extensor surfaces",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in keratin genes KRT6A, KRT6B, KRT16, or KRT17",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of hypertrophic nail dystrophy and plantar keratoderma plus genetic confirmation or clinical features consistent with PC in absence of genetic testing",
    "notes": "Genetic testing is recommended for confirmation but diagnosis can be clinical based on characteristic features."
  },
