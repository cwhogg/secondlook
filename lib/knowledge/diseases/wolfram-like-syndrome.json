  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Wolfram-like Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "diabetes-mellitus",
        "description": "Early-onset insulin-dependent diabetes mellitus",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "optic-atrophy",
        "description": "Bilateral progressive optic atrophy confirmed by ophthalmological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "sensorineural-hearing-loss",
        "description": "Bilateral sensorineural hearing loss documented by audiometry",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "diabetes-insipidus",
        "description": "Central diabetes insipidus confirmed by water deprivation test",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in CISD2 or related genes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of early-onset insulin-dependent diabetes mellitus and bilateral optic atrophy, with or without sensorineural hearing loss or diabetes insipidus, supported by genetic testing if available.",
    "notes": "Diagnosis is clinical but supported by genetic confirmation when possible."
  },
