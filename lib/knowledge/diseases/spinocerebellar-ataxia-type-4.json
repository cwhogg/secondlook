  "diagnosticCriteria": {
    "formalCriteriaName": "SCA Diagnostic Criteria",
    "criteria": [
      {
        "id": "clinical-ataxia",
        "description": "Progressive cerebellar ataxia with gait disturbance and limb incoordination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Autosomal dominant inheritance pattern with affected first-degree relatives",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic CAG repeat expansion in the ATXN4 gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-ataxias",
        "description": "Exclusion of other causes of ataxia by clinical and laboratory evaluation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive cerebellar ataxia, positive family history consistent with autosomal dominant inheritance, and confirmatory genetic testing for ATXN4 mutation",
    "notes": "Genetic testing is essential for definitive diagnosis due to phenotypic overlap with other SCAs."
  },
