  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Lowe syndrome",
    "criteria": [
      {
        "id": "ocular-anomalies",
        "description": "Bilateral congenital cataracts present at birth",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-tubulopathy",
        "description": "Proximal renal tubular dysfunction with aminoaciduria, phosphaturia, and bicarbonate loss",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-features",
        "description": "Hypotonia and intellectual disability with delayed psychomotor development",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "OCRL1-mutation",
        "description": "Pathogenic variant in the OCRL gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "facial-features",
        "description": "Characteristic facial dysmorphism including prominent forehead and deep-set eyes",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of bilateral congenital cataracts, proximal renal tubular dysfunction, and neurological features consistent with hypotonia and intellectual disability",
    "notes": "Genetic testing for OCRL mutations confirms diagnosis"
  },
