  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Oculo-palato-cerebral syndrome",
    "criteria": [
      {
        "id": "ocular-motility-defects",
        "description": "Congenital or early-onset ophthalmoplegia with ptosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "palatal-weakness",
        "description": "Palatal and pharyngeal muscle weakness causing dysphagia and nasal speech",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cerebral-involvement",
        "description": "Neurological abnormalities including hypotonia, developmental delay, and cerebellar signs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features such as elongated face and micrognathia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "electromyography-findings",
        "description": "Electromyographic evidence of muscle involvement",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: ophthalmoplegia, palatal weakness, and neurological involvement",
    "notes": "Genetic testing may support diagnosis but is not always conclusive."
  },
