  "prevalence": {
    "estimate": "1 in 1,000,000",
    "classification": "ultra-rare"
  },
  "demographics": {
    "typicalOnsetAge": {
      "min": 0,
      "max": 40,
      "peak": 15
    },
    "sexPredilection": "slight-male",
    "ethnicAssociations": []
  },
  "diagnosticCriteria": {
    "formalCriteriaName": "Dyskeratosis Congenita Diagnostic Criteria",
    "criteria": [
      {
        "id": "mucocutaneous-triad",
        "description": "Presence of the classic mucocutaneous triad: abnormal skin pigmentation, nail dystrophy, and oral leukoplakia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-marrow-failure",
        "description": "Evidence of bone marrow failure (e.g., aplastic anemia, pancytopenia)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "telomere-length",
        "description": "Shortened telomere length below the first percentile for age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with inheritance patterns (X-linked, autosomal dominant, or autosomal recessive)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic mutation in known DKC-related genes (e.g., DKC1, TERC, TERT)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of the mucocutaneous triad plus bone marrow failure and shortened telomere length",
    "notes": "Genetic testing and family history support diagnosis but are not mandatory if clinical criteria are met."
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Nail dystrophy",
        "frequency": 0.85,
        "bodySystem": "dermatological"
      },
      {
        "symptomName": "Reticular hyperpigmentation of the skin",
        "frequency": 0.8,
        "bodySystem": "dermatological"
      },
      {
        "symptomName": "Oral leukoplakia",
        "frequency": 0.75,
        "bodySystem": "otolaryngological"
      }
    ],
    "common": [
      {
        "symptomName": "Bone marrow failure leading to pancytopenia",
        "frequency": 0.75,
        "bodySystem": "hematological"
      },
      {
        "symptomName": "Epiphora (excessive tearing)",
        "frequency": 0.6,
        "bodySystem": "ophthalmological"
      },
      {
        "symptomName": "Pulmonary fibrosis",
        "frequency": 0.55,
        "bodySystem": "respiratory"
      },
      {
        "symptomName": "Mucosal leukoplakia beyond oral cavity",
        "frequency": 0.55,
        "bodySystem": "otolaryngological"
      },
      {
        "symptomName": "Dental abnormalities (e.g., hypodontia, early tooth loss)",
        "frequency": 0.5,
        "bodySystem": "otolaryngological"
      }
    ],
    "occasional": [
      {
        "symptomName": "Esophageal strictures",
        "frequency": 0.3,
        "bodySystem": "gastrointestinal"
      },
      {
        "symptomName": "Liver fibrosis or cirrhosis",
        "frequency": 0.25,
        "bodySystem": "gastrointestinal"
      },
      {
        "symptomName": "Increased risk of malignancies (e.g., squamous cell carcinoma)",
        "frequency": 0.4,
        "bodySystem": "constitutional",
        "notes": "Often develops in mucocutaneous sites"
      },
      {
        "symptomName": "Avascular necrosis of bone",
        "frequency": 0.15,
        "bodySystem": "musculoskeletal"
      },
      {
        "symptomName": "Growth retardation",
        "frequency": 0.2,
        "bodySystem": "constitutional"
      }
    ],
    "rare": [
      {
        "symptomName": "Neurological abnormalities (e.g., developmental delay, cognitive impairment)",
        "frequency": 0.05,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Immunodeficiency with recurrent infections",
        "frequency": 0.07,
        "bodySystem": "immunological"
      },
      {
        "symptomName": "Pulmonary arteriovenous malformations",
        "frequency": 0.03,
        "bodySystem": "respiratory"
      }
    ]
  },
  "systemsAffected": [
    "dermatological",
