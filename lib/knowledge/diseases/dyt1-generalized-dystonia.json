  "diagnosticCriteria": {
    "formalCriteriaName": "DYT1 Dystonia Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Presence of pathogenic TOR1A gene mutation (ΔGAG deletion)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Early-onset dystonia with initial limb involvement progressing to generalized dystonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Positive family history of dystonia or related movement disorders",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of secondary causes of dystonia such as drug-induced or structural lesions",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Pathogenic TOR1A mutation plus characteristic clinical presentation with exclusion of secondary causes",
    "notes": "Genetic testing is essential for definitive diagnosis; clinical variability exists even within families."
  },
