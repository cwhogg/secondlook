  "diagnosticCriteria": {
    "formalCriteriaName": "Schindler Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-activity-deficiency",
        "description": "Demonstration of deficient alpha-N-acetylgalactosaminidase enzyme activity in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-mutation",
        "description": "Identification of pathogenic mutations in the NAGA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic neurological and dermatological manifestations consistent with type 2 phenotype",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "biochemical-markers",
        "description": "Elevated urinary excretion of glycopeptides and oligosaccharides",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient enzyme activity plus either pathogenic NAGA gene mutations or consistent clinical features",
    "notes": "Molecular genetic testing is recommended to confirm diagnosis and for family counseling."
  },
