  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Paroxysmal Kinesigenic Dyskinesia",
    "criteria": [
      {
        "id": "triggered-attacks",
        "description": "Sudden attacks of involuntary movements triggered by sudden voluntary motion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "attack-duration",
        "description": "Brief duration of attacks, typically lasting seconds to a few minutes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-neurological-exam",
        "description": "Normal neurological examination between attacks",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "response-to-medication",
        "description": "Good response to anticonvulsant therapy such as carbamazepine",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history of similar attacks in some cases",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of sudden, brief attacks triggered by motion with normal neurological exam between attacks",
    "notes": "Genetic testing for PRRT2 mutations may support diagnosis but is not mandatory"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Sudden brief attacks of chorea, dystonia, or athetosis triggered by sudden movement",
        "frequency": 0.95,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Preserved consciousness during attacks",
        "frequency": 0.9,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Normal neurological status between attacks",
        "frequency": 0.85,
        "bodySystem": "neurological"
      }
    ],
    "common": [
      {
        "symptomName": "Unilateral or bilateral limb involvement during attacks",
        "frequency": 0.8,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Brief duration of attacks lasting seconds to 2 minutes",
        "frequency": 0.75,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Frequent attacks occurring multiple times daily",
        "frequency": 0.7,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Triggers include sudden voluntary movements or startle",
        "frequency": 0.7,
        "bodySystem": "neurological"
      }
    ],
    "occasional": [
      {
        "symptomName": "Aura or sensory warning prior to attacks",
        "frequency": 0.4,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Mild headache following attacks",
        "frequency": 0.3,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Transient speech disturbance during attacks",
        "frequency": 0.2,
        "bodySystem": "neurological"
      },
      {
        "symptomName": "Anxiety related to attack anticipation",
        "frequency": 0.15,
        "bodySystem": "psychiatric"
      }
    ],
    "rare": [
      {
        "symptomName": "Generalized tonic-clonic seizures",
        "frequency": 0.05,
        "bodySystem": "neurological",
        "notes": "May occur in some familial cases with PRRT2 mutations"
      },
      {
        "symptomName": "Sleep disturbances",
        "frequency": 0.04,
