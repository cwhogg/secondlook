  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; possible mild immunological abnormalities",
      "Metabolic screening typically normal"
    ],
    "imaging": [
      "Brain MRI may show mild structural abnormalities or be normal",
      "Echocardiogram revealing congenital heart defects",
      "Renal ultrasound may detect structural anomalies"
    ],
    "genetic": [
      "Heterozygous microdeletion at chromosome 1q21.1 detected by chromosomal microarray analysis",
      "FISH or MLPA can confirm deletion",
      "Parental testing to determine inheritance pattern",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Neuropsychological assessment revealing intellectual disability and behavioral disorders",
      "Developmental evaluation for motor and speech delays"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "1q21-1-microduplication-syndrome",
      "distinguishingFeatures": [
        "Presence of microduplication rather than microdeletion at 1q21.1",
        "Often associated with macrocephaly rather than microcephaly",
        "Different neurodevelopmental and behavioral profile"
      ]
    },
    {
      "diseaseId": "22q11-2-deletion-syndrome",
      "distinguishingFeatures": [
        "Deletion at chromosome 22q11.2",
        "Characteristic facial features distinct from 1q21.1 microdeletion",
        "More frequent cardiac anomalies like tetralogy of Fallot"
      ]
    }
  ],
  "redFlags": [
