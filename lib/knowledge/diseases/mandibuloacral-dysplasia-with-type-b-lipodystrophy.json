  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical Diagnostic Criteria for Mandibuloacral Dysplasia Type B",
    "criteria": [
      {
        "id": "lipodystrophy",
        "description": "Generalized loss of subcutaneous fat predominantly affecting the limbs and trunk",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mandibular-hypoplasia",
        "description": "Mandibular hypoplasia with micrognathia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "acro-osteolysis",
        "description": "Acro-osteolysis of distal phalanges confirmed by radiography",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "cutaneous-pigmentation",
        "description": "Mottled cutaneous pigmentation and skin atrophy",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation and short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-confirmation",
        "description": "Pathogenic variants in the ZMPSTE24 gene",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (generalized lipodystrophy, mandibular hypoplasia, and acro-osteolysis) with or without genetic confirmation",
    "notes": "Genetic testing for ZMPSTE24 mutations is confirmatory but not mandatory if clinical criteria are met."
  },
