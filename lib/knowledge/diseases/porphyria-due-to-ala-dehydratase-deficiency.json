  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for ALA dehydratase deficiency porphyria",
    "criteria": [
      {
        "id": "elevated-ala",
        "description": "Markedly elevated urinary delta-aminolevulinic acid (ALA) levels",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ala-dehydratase-activity",
        "description": "Reduced erythrocyte ALA dehydratase enzyme activity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the ALAD gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of acute neurovisceral attacks with abdominal pain and neurological symptoms",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of markedly elevated urinary ALA, reduced erythrocyte ALA dehydratase activity, and pathogenic ALAD gene mutations",
    "notes": "Diagnosis requires biochemical confirmation and genetic testing due to overlap with other acute porphyrias."
  },
