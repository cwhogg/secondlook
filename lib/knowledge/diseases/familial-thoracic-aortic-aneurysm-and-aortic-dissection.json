  "keyFindings": {
    "laboratory": [
      "Elevated D-dimer in acute aortic dissection",
      "Normal inflammatory markers (usually no systemic inflammation)"
    ],
    "imaging": [
      "CT angiography showing thoracic aortic aneurysm or dissection",
      "MRI angiography for detailed aortic wall assessment",
      "Echocardiography demonstrating aortic root dilation and valve regurgitation"
    ],
