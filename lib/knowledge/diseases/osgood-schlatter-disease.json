  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiographic Diagnostic Criteria for Osgood-Schlatter Disease",
    "criteria": [
      {
        "id": "localized-tibial-tubercle-tenderness",
        "description": "Tenderness and swelling localized over the tibial tubercle",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "activity-related-anterior-knee-pain",
        "description": "Anterior knee pain exacerbated by activities such as running, jumping, or kneeling",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiographic-tibial-tubercle-fragmentation",
        "description": "Radiographic evidence of fragmentation or irregularity of the tibial tubercle apophysis",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "absence-of-infection-or-tumor",
        "description": "Exclusion of infectious, neoplastic, or other inflammatory causes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of localized tibial tubercle tenderness and activity-related anterior knee pain, with supportive radiographic findings if available",
    "notes": "Diagnosis is primarily clinical; imaging is used to support diagnosis and exclude other conditions."
  },
