  "diagnosticCriteria": {
    "formalCriteriaName": "Lung Agenesis-Heart Defect-Thumb Anomalies Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "lung-agenesis",
        "description": "Unilateral or bilateral pulmonary agenesis or severe hypoplasia confirmed by imaging",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "congenital-heart-defect",
        "description": "Presence of congenital heart defects such as ventricular septal defect, atrial septal defect, or tetralogy of Fallot",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thumb-anomalies",
        "description": "Congenital thumb anomalies including hypoplasia, aplasia, or triphalangeal thumbs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "additional-skeletal-malformations",
        "description": "Presence of other skeletal abnormalities such as radial ray defects",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-distress",
        "description": "Neonatal respiratory distress related to pulmonary agenesis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pulmonary agenesis or severe hypoplasia plus congenital heart defect and thumb anomaly",
    "notes": "Diagnosis is primarily clinical supported by imaging and physical examination; genetic testing may assist in differential diagnosis."
  },
