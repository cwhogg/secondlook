  "keyFindings": {
    "laboratory": [
      "Ferritin markedly elevated (often >10,000 ng/mL; >10,000 has ~90% sensitivity for HLH)",
      "Elevated soluble IL-2 receptor (sCD25)",
      "Hypertriglyceridemia",
      "Hypofibrinogenemia",
      "Elevated LDH and transaminases",
      "Pancytopenia or bicytopenia",
      "Elevated D-dimer and evidence of DIC",
      "Low or absent NK cell cytotoxic function"
    ],
    "imaging": [
      "Abdominal imaging showing hepatosplenomegaly",
      "Brain MRI may show leptomeningeal enhancement or parenchymal lesions in CNS-HLH",
      "Chest imaging may show pulmonary infiltrates"
    ],
    "genetic": [
      "PRF1 (perforin) mutations - FHL type 2 (most common familial form)",
      "UNC13D (Munc13-4) mutations - FHL type 3",
      "STX11 mutations - FHL type 4",
      "STXBP2 mutations - FHL type 5",
      "RAB27A mutations (Griscelli syndrome type 2)",
      "SH2D1A or XIAP mutations (X-linked lymphoproliferative disease)"
    ],
    "other": [
      "Bone marrow biopsy showing hemophagocytosis",
      "HScore calculation (probability of HLH)",
      "Perforin expression by flow cytometry on NK cells"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "sepsis",
      "distinguishingFeatures": [
        "Sepsis has identifiable infectious source",
        "Ferritin elevated but usually not to HLH levels",
        "Blood cultures or source identification",
        "Responds to antibiotics"
      ]
    },
    {
      "diseaseId": "lymphoma",
      "distinguishingFeatures": [
        "Lymphoma can trigger secondary HLH",
        "Tissue biopsy shows malignant lymphoid cells",
        "HLH may coexist with lymphoma (important to evaluate)"
      ]
    },
    {
      "diseaseId": "systemic-lupus-erythematosus",
      "distinguishingFeatures": [
        "SLE has specific autoantibodies (ANA, anti-dsDNA)",
        "MAS can occur in SLE as secondary HLH",
        "Complement levels typically low in SLE"
      ]
    },
    {
      "diseaseId": "adult-onset-stills-disease",
      "distinguishingFeatures": [
        "Quotidian fever pattern",
        "Evanescent salmon-colored rash",
        "Very high ferritin but glycosylated fraction <20%",
        "Can trigger secondary MAS/HLH"
      ]
    }
  ],
