  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; metabolic screening usually unremarkable"
    ],
    "imaging": [
      "MRI demonstrating bilateral parasagittal polymicrogyria predominantly in parieto-occipital regions with abnormal cortical lamination and thickened cortex"
    ],
    "genetic": [
      "FIG4 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "EEG showing epileptiform discharges correlating with seizure activity"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "bilateral-parieto-occipital-lissencephaly",
      "distinguishingFeatures": [
        "Smooth brain surface without polymicrogyria",
        "More severe global cortical malformation",
        "Different genetic mutations (e.g., LIS1)"
      ]
    },
    {
      "diseaseId": "focal-cortical-dysplasia",
      "distinguishingFeatures": [
        "Localized cortical malformation rather than bilateral parasagittal distribution",
        "Often associated with refractory focal epilepsy",
        "Distinct histopathological features"
      ]
    }
  ],
  "redFlags": [
