  "diagnosticCriteria": {
    "formalCriteriaName": "MCAP Diagnostic Criteria",
    "criteria": [
      {
        "id": "megalencephaly",
        "description": "Progressive megalencephaly or macrocephaly documented by head circumference measurements",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "capillary-malformations",
        "description": "Presence of extensive cutaneous capillary malformations, often with a reticulated or blotchy pattern",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "polymicrogyria",
        "description": "Neuroradiological evidence of polymicrogyria, especially perisylvian or diffuse",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "connective-tissue-signs",
        "description": "Connective tissue abnormalities such as joint hypermobility or soft skin",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "vascular-anomalies",
        "description": "Additional vascular anomalies including venous malformations or lymphatic abnormalities",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: megalencephaly, capillary malformations, and polymicrogyria",
    "notes": "Genetic testing for mutations in the PI3K-AKT pathway genes can support diagnosis"
  },
