    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Tetrasomy X Syndrome",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Presence of an extra two X chromosomes confirmed by karyotype or chromosomal microarray",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay or intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dysmorphic-features",
        "description": "Characteristic facial dysmorphisms including epicanthal folds, hypertelorism, and micrognathia",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hypotonia",
        "description": "Neonatal hypotonia or decreased muscle tone",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "growth-delay",
        "description": "Postnatal growth retardation or short stature",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of tetrasomy X plus at least one major clinical feature such as developmental delay or characteristic dysmorphic features",
    "notes": "Diagnosis relies primarily on chromosomal analysis; clinical features support but are variable."
  },
