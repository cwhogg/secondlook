  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Cerebrofaciothoracic Dysplasia",
    "criteria": [
      {
        "id": "craniofacial-dysmorphism",
        "description": "Characteristic craniofacial features including brachycephaly, prominent forehead, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "thoracic-abnormalities",
        "description": "Thoracic skeletal abnormalities such as short ribs and narrow thorax",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neurological-impairment",
        "description": "Developmental delay or intellectual disability with variable severity",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiological-findings",
        "description": "Radiographic evidence of vertebral anomalies and rib abnormalities",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the TMCO1 gene",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major clinical features (craniofacial dysmorphism, thoracic abnormalities, and neurological impairment) with supportive radiological findings or confirmed TMCO1 mutation",
    "notes": "Genetic testing for TMCO1 mutations can confirm diagnosis but is not always available."
  },
