  "diagnosticCriteria": {
    "criteria": [
      {
        "id": "aag-1",
        "description": "Subacute or acute onset of widespread autonomic failure (orthostatic hypotension, gastrointestinal dysmotility, anhidrosis, urinary retention)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aag-2",
        "description": "Positive ganglionic acetylcholine receptor (gAChR) antibodies",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "aag-3",
        "description": "No alternative explanation for autonomic failure",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aag-4",
        "description": "Response to immunotherapy (IVIG, plasma exchange, or immunosuppression)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "aag-5",
        "description": "Sicca symptoms (dry eyes, dry mouth)",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Subacute/acute onset pandysautonomia with positive gAChR antibodies; seronegative forms exist and are diagnosed by clinical criteria and exclusion",
    "notes": "gAChR antibodies are found in ~50% of cases. Seronegative AAG can still respond to immunotherapy. Antibody levels correlate with disease severity."
  },
