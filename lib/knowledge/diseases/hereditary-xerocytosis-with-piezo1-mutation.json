  "diagnosticCriteria": {
    "formalCriteriaName": "Hereditary Xerocytosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic PIEZO1 mutation by molecular genetic testing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "erythrocyte-dehydration",
        "description": "Evidence of erythrocyte dehydration demonstrated by decreased osmotic fragility and altered red cell indices",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hemolytic-anemia",
        "description": "Presence of chronic hemolytic anemia with reticulocytosis and elevated indirect bilirubin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-other-hemolytic-disorders",
        "description": "Exclusion of other causes of hemolytic anemia such as hereditary spherocytosis or autoimmune hemolytic anemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "peripheral-blood-smear",
        "description": "Peripheral blood smear showing stomatocytes and dehydrated erythrocytes",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of pathogenic PIEZO1 mutation plus clinical and laboratory evidence of erythrocyte dehydration and hemolytic anemia",
    "notes": "Diagnosis requires molecular confirmation due to phenotypic overlap with other hemolytic anemias."
  },
