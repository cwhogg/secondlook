  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; D-dimer may be elevated if thrombosis present"
    ],
    "imaging": [
      "Doppler ultrasound showing venous malformations",
      "MRI or CT angiography demonstrating vascular anomalies and soft tissue hypertrophy",
      "Lymphoscintigraphy for lymphatic malformations"
    ],
    "genetic": [
      "Somatic mutations in PIK3CA gene identified in affected tissues"
    ],
    "other": [
      "Clinical examination revealing port-wine stain and limb asymmetry"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "parkes-weber-syndrome",
      "distinguishingFeatures": [
        "Presence of high-flow arteriovenous malformations",
        "More prominent arterial involvement",
        "Usually absence of significant limb hypertrophy"
      ]
    },
    {
      "diseaseId": "proteus-syndrome",
      "distinguishingFeatures": [
        "Progressive asymmetric overgrowth involving multiple tissues",
        "Cerebriform connective tissue nevi",
        "No typical port-wine stain"
      ]
    }
  ],
  "redFlags": [
    "Rapidly worsening limb swelling or pain suggesting thrombosis",
    "Signs of pulmonary embolism (e.g., sudden dyspnea, chest pain)",
    "Ulceration or bleeding from vascular malformations"
  ],
