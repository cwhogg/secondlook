  "keyFindings": {
    "laboratory": [
      "Persistent neutrophilia with normal or elevated leukocyte counts",
      "Absence or severe reduction of sialyl-Lewis X antigen on leukocytes by flow cytometry",
      "Normal neutrophil oxidative burst and phagocytosis assays"
    ],
    "imaging": [
      "Chest X-ray showing recurrent pneumonia",
      "Ultrasound may reveal hepatosplenomegaly"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Delayed umbilical cord separation",
      "Absence of pus formation despite infection"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "leukocyte-adhesion-deficiency-type-i",
