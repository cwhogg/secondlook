  "diagnosticCriteria": {
    "formalCriteriaName": "Sagliker Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic craniofacial abnormalities including midface hypoplasia and maxillary retrusion",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-deformities",
        "description": "Severe skeletal deformities including short stature, scoliosis, and limb abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "renal-dysfunction",
        "description": "Evidence of chronic kidney disease or renal tubular dysfunction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "dental-anomalies",
        "description": "Dental abnormalities such as hypodontia and enamel hypoplasia",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-impairment",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria (facial dysmorphism, skeletal deformities, and renal dysfunction)",
    "notes": "Diagnosis is clinical and supported by genetic testing when available"
  },
