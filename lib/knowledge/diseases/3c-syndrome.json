    ],
    "imaging": [
      "Echocardiography showing dilated or hypertrophic cardiomyopathy",
      "Ophthalmologic slit-lamp exam confirming cataracts"
    ],
    "genetic": [
      "VPS35L (causative)",
      "DPYSL5 (causative)",
      "WASHC5 (causative)",
      "CCDC22 (causative, loss-of-function)",
      "Autosomal recessive inheritance",
      "X-linked recessive inheritance"
    ],
    "other": [
      "Small bowel biopsy showing villous atrophy consistent with celiac disease"
    ]
  },
  "differentialDiagnoses": [
