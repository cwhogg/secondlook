  "differentialDiagnoses": [
    {
      "diseaseId": "dominant-generalized-dystrophic-epidermolysis-bullosa",
      "distinguishingFeatures": [
        "Autosomal dominant inheritance pattern",
        "Less severe blistering and scarring",
        "Presence of type VII collagen with abnormal function rather than absence"
      ]
    },
    {
      "diseaseId": "junctional-epidermolysis-bullosa",
      "distinguishingFeatures": [
        "Blistering occurs within lamina lucida",
        "Mutations in genes such as LAMB3, LAMC2, or COL17A1",
        "Usually no scarring or milia formation"
      ]
    }
  ],
