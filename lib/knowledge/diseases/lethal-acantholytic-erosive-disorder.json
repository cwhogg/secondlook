  "diagnosticCriteria": {
    "formalCriteriaName": "Proposed Diagnostic Criteria for Lethal Acantholytic Erosive Disorder",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of widespread acantholysis with erosive skin lesions on histopathological examination",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Rapidly progressive erosive mucocutaneous lesions with poor healing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "exclusion-other-diseases",
        "description": "Exclusion of other acantholytic dermatoses such as pemphigus vulgaris and Hailey-Hailey disease",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunofluorescence",
        "description": "Negative direct immunofluorescence for autoantibodies",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in genes associated with epidermal adhesion defects",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "All three major criteria must be met for diagnosis",
    "notes": "Diagnosis relies heavily on histopathological confirmation and exclusion of autoimmune blistering diseases."
  },
