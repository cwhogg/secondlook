  "diagnosticCriteria": {
    "formalCriteriaName": "Histopathological and Immunohistochemical Diagnostic Criteria for Rhabdomyosarcoma",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of small round to spindle-shaped tumor cells with rhabdomyoblastic differentiation on histology",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "immunohistochemistry",
        "description": "Positive immunostaining for muscle-specific markers such as desmin, myogenin, and MyoD1",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "molecular-genetics",
        "description": "Absence of PAX3-FOXO1 or PAX7-FOXO1 fusion genes (which are characteristic of alveolar rhabdomyosarcoma)",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathological confirmation of rhabdomyoblastic differentiation with positive muscle marker immunohistochemistry and exclusion of alveolar subtype by molecular testing",
    "notes": "Molecular testing is important to differentiate embryonal from alveolar rhabdomyosarcoma due to prognostic implications."
  },
