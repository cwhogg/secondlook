  "diagnosticCriteria": {
    "formalCriteriaName": "2022 ACR/EULAR Classification Criteria for MPA",
    "criteria": [
      {
        "id": "mpa-1",
        "description": "MPO-ANCA (p-ANCA) positivity",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "mpa-2",
        "description": "Pauci-immune glomerulonephritis on biopsy",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "mpa-3",
        "description": "Pulmonary fibrosis or interstitial lung disease on imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "mpa-4",
        "description": "Absence of nasal/paranasal sinus involvement (negative predictor for GPA)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "mpa-5",
        "description": "Peripheral neuropathy or mononeuritis multiplex",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "mpa-6",
        "description": "Palpable purpura or skin vasculitis on biopsy",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Diagnosis of small-vessel vasculitis plus weighted score meeting MPA classification threshold",
    "notes": "MPA is distinguished from GPA by the absence of granulomatous inflammation. PR3-ANCA positivity weighs against MPA classification."
  },
