  "diagnosticCriteria": {
    "formalCriteriaName": "Wilms Tumor Diagnostic Criteria",
    "criteria": [
      {
        "id": "abdominal-mass",
        "description": "Palpable abdominal mass typically unilateral",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "imaging-characteristics",
        "description": "Renal mass with characteristic features on ultrasound, CT, or MRI",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Histological confirmation of triphasic pattern (blastemal, stromal, epithelial cells)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Detection of WT1 gene mutations or loss of heterozygosity at 11p13",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of a renal mass with characteristic imaging features plus histopathological confirmation",
    "notes": "Genetic testing supports diagnosis and prognosis but is not mandatory"
  },
  "symptoms": {
    "pathognomonic": [
      {
        "symptomName": "Palpable abdominal mass",
        "frequency": 0.85,
        "bodySystem": "gastrointestinal",
        "notes": "Typically painless and unilateral"
      },
      {
        "symptomName": "Hematuria",
        "frequency": 0.75,
        "bodySystem": "renal"
      }
    ],
    "common": [
