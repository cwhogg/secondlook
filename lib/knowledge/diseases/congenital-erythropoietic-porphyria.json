  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Congenital Erythropoietic Porphyria",
    "criteria": [
      {
        "id": "uroporphyrin-excretion",
        "description": "Markedly increased urinary excretion of uroporphyrin I and coproporphyrin I isomers",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-photosensitivity",
        "description": "Severe cutaneous photosensitivity with blistering and scarring on sun-exposed skin",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "uroporphyrinogen-iii-synthase-deficiency",
        "description": "Demonstration of deficient uroporphyrinogen III synthase enzyme activity in erythrocytes or genetic confirmation of UROS mutations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "erythrodontia",
        "description": "Red-brown discoloration of teeth (erythrodontia) visible under UV light",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hemolytic-anemia",
        "description": "Presence of chronic hemolytic anemia with reticulocytosis",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of major criteria including elevated urinary porphyrins, clinical photosensitivity, and deficient UROS enzyme activity or genetic confirmation",
    "notes": "Diagnosis is confirmed by biochemical and genetic testing; clinical features support diagnosis."
  },
