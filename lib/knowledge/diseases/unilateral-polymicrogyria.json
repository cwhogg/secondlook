  "diagnosticCriteria": {
    "formalCriteriaName": "Neuroimaging-based Diagnostic Criteria for Polymicrogyria",
    "criteria": [
      {
        "id": "imaging-confirmation",
        "description": "MRI demonstrating abnormal cortical lamination with excessive small gyri confined to one cerebral hemisphere",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-focal-neurological-signs",
        "description": "Presence of focal neurological deficits corresponding to the affected hemisphere",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "seizure-history",
        "description": "History of focal seizures or epilepsy consistent with unilateral cortical malformation",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "MRI evidence of unilateral polymicrogyria plus at least one clinical feature such as focal neurological signs or seizures",
    "notes": "Genetic testing may support diagnosis but is not mandatory."
  },
