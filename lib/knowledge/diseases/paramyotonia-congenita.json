  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Electrophysiological Diagnostic Criteria for Paramyotonia Congenita",
    "criteria": [
      {
        "id": "clinical-myotonia",
        "description": "Presence of paradoxical myotonia worsened by cold exposure and exercise",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "Electromyographic evidence of myotonic discharges with characteristic paradoxical myotonia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the SCN4A gene",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Positive family history consistent with autosomal dominant inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of clinical paradoxical myotonia with confirmatory electromyography findings; genetic testing supportive but not mandatory",
    "notes": "Genetic testing can confirm diagnosis but clinical and EMG findings are primary."
  },
