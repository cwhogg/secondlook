  "keyFindings": {
    "laboratory": [
      "Anemia with iron deficiency",
      "Elevated inflammatory markers during infections"
    ],
    "imaging": [
      "Barium swallow showing esophageal strictures",
      "Radiographs showing pseudosyndactyly"
    ],
    "genetic": [
      "Pathogenic variants in LAMA3, LAMB3, LAMC2 (laminin-332 genes)",
      "Mutations in COL17A1 (type XVII collagen gene)",
      "Mutations in ITGA6 and ITGB4 (integrin subunits)"
    ],
    "other": [
      "Immunofluorescence antigen mapping demonstrating cleavage within lamina lucida",
      "Skin biopsy histopathology showing subepidermal blister"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dystrophic-epidermolysis-bullosa",
      "distinguishingFeatures": [
        "Blistering below the lamina densa",
        "Mutations in COL7A1 gene",
        "More prominent scarring and milia formation"
      ]
    },
    {
      "diseaseId": "epidermolysis-bullosa-simplex",
      "distinguishingFeatures": [
        "Blistering within basal keratinocytes",
        "Mutations in KRT5 or KRT14 genes",
        "Usually milder phenotype with less mucosal involvement"
      ]
    }
  ],
  "redFlags": [
    "Severe generalized blistering at birth with mucosal involvement",
    "Failure to thrive due to feeding difficulties",
    "Recurrent infections and sepsis from skin barrier disruption"
  ],
