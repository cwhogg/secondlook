      "Elevated serum creatinine in advanced disease"
    ],
    "imaging": [
      "Renal ultrasound showing nephrolithiasis",
      "Non-contrast CT scan revealing radiolucent stones"
    ],
    "genetic": [
      "MTHFR (causative)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Stone analysis confirming 2,8-dihydroxyadenine composition"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "primary-hyperoxaluria",
      "distinguishingFeatures": [
        "Calcium oxalate stones instead of 2,8-dihydroxyadenine",
