  "diagnosticCriteria": {
    "formalCriteriaName": "International Classification of Headache Disorders (ICHD-3) Criteria for Hemiplegic Migraine",
    "criteria": [
      {
        "id": "motor-weakness",
        "description": "Fully reversible motor weakness (hemiparesis) during aura",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "migraine-headache",
        "description": "Headache fulfilling migraine criteria, occurring during or following aura",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "aura-duration",
        "description": "Aura symptoms lasting between 5 minutes and 72 hours",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "family-history",
        "description": "Presence of similar attacks in first- or second-degree relatives (for familial cases)",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "exclusion-other-causes",
        "description": "Exclusion of other causes such as stroke, epilepsy, or structural brain lesions",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of fully reversible motor weakness during aura, migraine headache fulfilling criteria, aura duration between 5 minutes and 72 hours, and exclusion of other causes",
    "notes": "Genetic testing may support diagnosis but is not mandatory"
  },
