  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests; inflammatory markers usually normal or mildly elevated"
    ],
    "imaging": [
      "MRI of brachial plexus may show nerve inflammation or edema",
      "Chest X-ray or fluoroscopy to assess diaphragmatic function if phrenic nerve involved"
    ],
    "genetic": [
      "SEPTIN9 (susceptibility)",
      "Autosomal dominant inheritance"
    ],
    "other": [
      "Electromyography showing denervation and reduced motor unit recruitment in affected muscles",
      "Nerve conduction studies showing axonal loss in brachial plexus distribution"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "cervical-radiculopathy",
      "distinguishingFeatures": [
        "Pain and weakness follow dermatomal/myotomal pattern",
        "MRI shows cervical spine pathology",
        "No acute severe onset pain typical of neuralgic amyotrophy"
      ]
    },
    {
      "diseaseId": "rotator-cuff-tear",
      "distinguishingFeatures": [
        "Mechanical shoulder pain worsened by specific movements",
        "Imaging shows tendon tears",
        "No neurological deficits or muscle atrophy typical of neuralgic amyotrophy"
      ]
    },
    {
      "diseaseId": "multifocal-motor-neuropathy",
      "distinguishingFeatures": [
        "Progressive weakness without significant pain",
        "Electrodiagnostic studies show conduction block",
        "No acute onset or sensory symptoms"
      ]
    }
  ],
  "redFlags": [
    "Rapidly progressive weakness beyond typical distribution",
    "Signs of systemic infection or malignancy",
    "Respiratory distress indicating phrenic nerve involvement"
  ],
