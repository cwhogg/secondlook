  "keyFindings": {
    "laboratory": [
      "Low serum C3 complement levels",
      "Normal or mildly decreased C4 complement levels",
      "Proteinuria and hematuria on urinalysis",
      "Elevated serum creatinine in advanced disease"
    ],
    "imaging": [
      "Renal ultrasound showing normal or increased echogenicity",
      "No specific imaging hallmark; used to exclude obstruction"
    ],
    "genetic": [
      "Mutations in complement regulatory genes such as CFH, CFI, MCP",
      "Presence of C3 nephritic factor autoantibody",
      "Multigenic/multifactorial inheritance"
    ],
    "other": [
      "Kidney biopsy showing dominant C3 deposits by immunofluorescence",
      "Electron microscopy revealing electron-dense deposits in glomerular basement membrane or mesangium"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "post-infectious-glomerulonephritis",
      "distinguishingFeatures": [
        "Presence of immunoglobulin deposits along with C3",
