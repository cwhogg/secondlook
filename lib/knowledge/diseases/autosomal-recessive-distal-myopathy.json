        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of biallelic pathogenic variants in genes associated with autosomal recessive distal myopathy",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "electromyography",
        "description": "EMG demonstrating myopathic motor unit potentials",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Consanguinity or affected siblings consistent with autosomal recessive inheritance",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of progressive distal muscle weakness with confirmatory muscle biopsy and biallelic pathogenic variants in relevant genes",
    "notes": "Diagnosis requires exclusion of other distal myopathies and neuromuscular disorders."
