  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Echocardiographic Diagnostic Criteria for Tetralogy of Fallot",
    "criteria": [
      {
        "id": "ventricular-septal-defect",
        "description": "Presence of a large, non-restrictive ventricular septal defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pulmonary-stenosis",
        "description": "Right ventricular outflow tract obstruction or pulmonary stenosis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "overriding-aorta",
        "description": "Aortic root overriding the ventricular septal defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "right-ventricular-hypertrophy",
        "description": "Right ventricular hypertrophy evident on imaging or ECG",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cyanosis",
        "description": "Clinical evidence of cyanosis or hypoxemia",
        "category": "major",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all four major anatomical abnormalities (VSD, pulmonary stenosis, overriding aorta, right ventricular hypertrophy) confirmed by imaging or surgical history",
    "notes": "Diagnosis in adults often relies on history of childhood repair and current imaging findings due to variable presentation."
  },
