  "diagnosticCriteria": {
    "formalCriteriaName": "Fumaric Aciduria Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Demonstration of fumarase enzyme deficiency in cultured fibroblasts or tissues",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "urinary-fumarate-elevation",
        "description": "Elevated fumaric acid levels in urine organic acid analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic mutations in the FH gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of severe neurological impairment including developmental delay and hypotonia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of fumarase enzyme deficiency or pathogenic FH gene mutations combined with elevated urinary fumarate",
    "notes": "Molecular genetic testing is confirmatory; enzyme assay remains gold standard."
  },
