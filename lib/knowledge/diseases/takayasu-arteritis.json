  "diagnosticCriteria": {
    "formalCriteriaName": "2022 ACR/EULAR Classification Criteria for Takayasu Arteritis",
    "criteria": [
      {
        "id": "ta-1",
        "description": "Age at onset <= 60 years",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "ta-2",
        "description": "Female sex",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "ta-3",
        "description": "Angina or ischemic cardiac pain",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ta-4",
        "description": "Arm or leg claudication",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ta-5",
        "description": "Vascular bruit (subclavian, aortic)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ta-6",
        "description": "Reduced peripheral pulse",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ta-7",
        "description": "Blood pressure asymmetry (>10 mmHg systolic between arms)",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "ta-8",
        "description": "Number of affected vascular territories on imaging",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ta-9",
        "description": "Paired vascular involvement (bilateral subclavian, bilateral renal, bilateral carotid)",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "ta-10",
        "description": "Abdominal aorta involvement on imaging",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Established diagnosis of large-vessel vasculitis, age <= 60, plus total weighted score >= 5",
    "notes": "Angiographic classification: Type I (aortic arch branches), Type IIa (ascending aorta and arch), Type IIb (ascending aorta, arch, and thoracic descending aorta), Type III (thoracic descending aorta, abdominal aorta, renal arteries), Type IV (abdominal aorta and/or renal arteries), Type V (combined features)."
  },
