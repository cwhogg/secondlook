  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild hormonal imbalances related to gonadal function"
    ],
    "imaging": [
      "Brain MRI may show nonspecific findings or be normal",
      "Echocardiography to evaluate for congenital heart defects"
    ],
    "genetic": [
      "Karyotype analysis showing 48,XYYY chromosomal complement",
      "Fluorescence in situ hybridization (FISH) confirming presence of extra Y chromosomes"
    ],
    "other": [
      "Neuropsychological testing revealing intellectual disability and developmental delays"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "47-xxy-klinefelter-syndrome",
      "distinguishingFeatures": [
        "Presence of only one extra Y chromosome (47,XYY) instead of two",
        "Typically milder intellectual disability",
        "Less frequent dysmorphic features"
      ]
    },
    {
      "diseaseId": "48-xxxy-syndrome",
      "distinguishingFeatures": [
        "Additional X chromosomes rather than Y chromosomes",
        "More pronounced hypogonadism and gynecomastia",
        "Different neurodevelopmental profile"
      ]
    }
  ],
