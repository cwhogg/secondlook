  "keyFindings": {
    "laboratory": [
      "Elevated ESR, CRP, SAA during attacks",
      "Leukocytosis during attacks",
      "Elevated ferritin during attacks",
      "Low soluble TNF receptor 1 levels (impaired shedding) - specialized test",
      "Proteinuria if AA amyloidosis present"
    ],
    "imaging": [
      "MRI of affected muscle: fascial edema/enhancement during attacks",
      "No specific imaging findings"
    ],
    "genetic": [
      "TNFRSF1A (causative)",
      "Autosomal dominant inheritance with variable penetrance"
    ],
    "other": [
      "Skin/muscle biopsy during attack: monocytic/lymphocytic perivascular infiltrate",
      "Response to anti-IL-1 therapy (anakinra, canakinumab) supports diagnosis",
      "Poor response to colchicine (unlike FMF)"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "familial-mediterranean-fever",
      "distinguishingFeatures": [
        "FMF attacks are shorter (1-3 days vs 1-4 weeks in TRAPS)",
        "FMF responds to colchicine; TRAPS does not",
        "FMF confirmed by MEFV mutations"
      ]
    },
    {
      "diseaseId": "hyperimmunoglobulin-d-syndrome",
      "distinguishingFeatures": [
        "HIDS has elevated IgD levels",
        "HIDS attacks last 3-7 days",
        "HIDS confirmed by MVK mutations"
      ]
    },
    {
      "diseaseId": "adult-onset-still-disease",
      "distinguishingFeatures": [
        "AOSD has quotidian fever, salmon rash, markedly elevated ferritin",
        "AOSD lacks migratory myalgia pattern"
      ]
    }
  ],
  "redFlags": [
    "Proteinuria developing in TRAPS patient (AA amyloidosis risk ~10%)",
    "Failure to respond to corticosteroids (may need IL-1 blockade)",
    "Very prolonged attacks (> 6 weeks) suggesting alternative diagnosis",
    "New diagnosis of cysteine-residue mutation (higher amyloidosis risk)"
  ],
