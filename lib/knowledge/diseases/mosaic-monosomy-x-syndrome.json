    "laboratory": [
      "Elevated FSH and LH indicating gonadal failure",
      "Thyroid function tests showing hypothyroidism",
      "Autoantibody panels for autoimmune diseases"
    ],
    "imaging": [
      "Echocardiogram showing bicuspid aortic valve or coarctation",
      "Renal ultrasound revealing horseshoe kidney",
      "Pelvic ultrasound demonstrating streak ovaries"
    ],
    "genetic": [
      "Karyotype showing mosaic 45,X cell line",
      "Fluorescence in situ hybridization (FISH) confirming mosaicism",
      "Array comparative genomic hybridization (aCGH) for X chromosome abnormalities"
    ],
    "other": [
      "Physical examination revealing webbed neck and cubitus valgus",
      "Growth charts documenting short stature"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "classic-turner-syndrome",
      "distinguishingFeatures": [
        "Non-mosaic 45,X karyotype",
        "More severe phenotypic features",
        "Absence of mosaic cell lines"
      ]
    },
    {
      "diseaseId": "noonan-syndrome",
      "distinguishingFeatures": [
        "Normal karyotype",
        "Similar features like short stature and webbed neck",
        "Distinct genetic mutations (PTPN11, SOS1)"
      ]
    }
  ],
  "redFlags": [
