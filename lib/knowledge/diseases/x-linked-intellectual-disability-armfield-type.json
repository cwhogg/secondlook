  "diagnosticCriteria": {
    "formalCriteriaName": "Armfield X-linked Intellectual Disability Diagnostic Criteria",
    "criteria": [
      {
        "id": "intellectual-disability",
        "description": "Presence of moderate to severe intellectual disability",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent supraorbital ridges, broad nasal bridge, and deep-set eyes",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "behavioral-phenotype",
        "description": "Behavioral abnormalities such as autistic features and hyperactivity",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "X-linked inheritance pattern with affected males and carrier females",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic variants in the ARX gene",
        "category": "major",
        "requiredForDiagnosis": true
      }
    ],
    "minimumForDiagnosis": "Presence of intellectual disability, characteristic facial dysmorphism, and either positive family history consistent with X-linked inheritance or pathogenic ARX gene variant",
    "notes": "Genetic testing is confirmatory; clinical diagnosis relies on combination of intellectual disability, facial features, and inheritance pattern."
  },
