  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Radiological Diagnostic Criteria for Osteoglosphonic Dysplasia",
    "criteria": [
      {
        "id": "osteosclerosis",
        "description": "Diffuse osteosclerosis with increased bone density on radiographs",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "glossoptosis",
        "description": "Presence of glossoptosis causing airway obstruction",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "craniofacial-abnormalities",
        "description": "Characteristic craniofacial dysmorphism including macrocephaly and frontal bossing",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "bone-fractures",
        "description": "Recurrent pathological fractures despite increased bone density",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hematologic-abnormalities",
        "description": "Mild anemia or pancytopenia due to bone marrow space reduction",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of diffuse osteosclerosis, glossoptosis, and characteristic craniofacial abnormalities",
    "notes": "Genetic testing for mutations in the TNFRSF11A gene may support diagnosis"
  },
