  "diagnosticCriteria": {
    "formalCriteriaName": "Dauber Type Microcephalic Primordial Dwarfism Diagnostic Criteria",
    "criteria": [
      {
        "id": "microcephaly",
        "description": "Severe congenital microcephaly with head circumference significantly below the 3rd percentile",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "primordial-dwarfism",
        "description": "Severe prenatal and postnatal growth retardation resulting in primordial dwarfism",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features including prominent nose, micrognathia, and midface hypoplasia",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Radiological evidence of skeletal dysplasia including short long bones and delayed bone age",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "neurological-impairment",
        "description": "Developmental delay or intellectual disability of variable severity",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: severe congenital microcephaly, primordial dwarfism, and characteristic facial dysmorphism",
    "notes": "Genetic testing may support diagnosis but is not mandatory; clinical and radiological features are key."
  },
