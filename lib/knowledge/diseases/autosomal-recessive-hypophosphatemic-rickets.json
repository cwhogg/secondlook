  "diagnosticCriteria": {
    "formalCriteriaName": "Diagnostic criteria for Autosomal Recessive Hypophosphatemic Rickets",
    "criteria": [
      {
        "id": "hypophosphatemia",
        "description": "Persistent hypophosphatemia due to renal phosphate wasting",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-rickets",
        "description": "Clinical and radiological evidence of rickets including bone deformities and growth retardation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in genes associated with autosomal recessive hypophosphatemic rickets (e.g., DMP1, ENPP1, FAM20C)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "normal-calcium",
        "description": "Normal serum calcium levels with elevated alkaline phosphatase",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "low-1-25-vitamin-d",
        "description": "Inappropriately low or normal 1,25-dihydroxyvitamin D levels despite hypophosphatemia",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of persistent hypophosphatemia with clinical/radiological evidence of rickets plus genetic confirmation of pathogenic variants",
    "notes": "Diagnosis requires exclusion of other causes of hypophosphatemic rickets such as X-linked hypophosphatemia."
  },
