  "keyFindings": {
    "laboratory": [
      "Thrombocytopenia and hypofibrinogenemia indicating consumptive coagulopathy",
      "Elevated D-dimer and low fibrinogen levels",
      "Anemia of chronic disease"
    ],
    "imaging": [
      "MRI showing multifocal infiltrative lymphatic anomalies in thorax and abdomen",
      "CT demonstrating pleural and pericardial effusions with lymphatic masses",
      "Lymphangiography revealing abnormal lymphatic channels"
    ],
    "genetic": [
      "No consistent germline mutations identified; somatic mutations in lymphatic endothelial cells under investigation"
    ],
    "other": [
      "Histopathology demonstrating kaposiform spindle cell proliferation with lymphatic endothelial markers (e.g., D2-40, PROX1)",
      "Evidence of Kasabach-Merritt phenomenon-like consumptive coagulopathy"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "kaposiform-hemangioendothelioma",
      "distinguishingFeatures": [
        "Usually presents as a localized vascular tumor rather than diffuse lymphatic infiltration",
        "More common in infants and young children",
        "Typically lacks extensive lymphatic involvement seen in kaposiform lymphangiomatosis"
      ]
    },
    {
      "diseaseId": "generalized-lymphatic- anomaly",
      "distinguishingFeatures": [
        "Diffuse lymphatic malformations without kaposiform spindle cell proliferation",
        "Usually lacks consumptive coagulopathy",
        "Histopathology differs with absence of kaposiform features"
      ]
    }
  ],
