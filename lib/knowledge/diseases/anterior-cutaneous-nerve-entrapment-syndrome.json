  "diagnosticCriteria": {
    "formalCriteriaName": "ACNES Diagnostic Criteria",
    "criteria": [
      {
        "id": "localized-tenderness",
        "description": "Localized tenderness over the anterior abdominal wall at the site of the entrapped nerve",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "positive-carnett-sign",
        "description": "Positive Carnett's sign indicating abdominal wall origin of pain",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-visceral-cause",
        "description": "Exclusion of visceral causes of abdominal pain by appropriate investigations",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "pain-characteristics",
        "description": "Chronic, localized, burning or stabbing abdominal pain",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "response-to-local-anesthetic",
        "description": "Temporary pain relief following local anesthetic injection at the entrapment site",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of localized tenderness with positive Carnett's sign and exclusion of visceral causes",
    "notes": "Diagnosis is primarily clinical supported by response to local anesthetic injection"
  },
