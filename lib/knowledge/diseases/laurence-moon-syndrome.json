  "keyFindings": {
    "laboratory": [
      "Hormonal assays showing low gonadotropins and sex steroids",
      "Normal metabolic panels excluding secondary causes"
    ],
    "imaging": [
      "MRI brain may show corticospinal tract abnormalities",
      "Spinal imaging may reveal scoliosis or spinal cord atrophy"
    ],
    "genetic": [
      "PNPLA6 (causative, loss-of-function)",
      "Autosomal recessive inheritance pattern"
    ],
    "other": [
      "Electroretinography showing reduced retinal response",
      "Nerve conduction studies may reveal peripheral neuropathy"
    ]
  },
