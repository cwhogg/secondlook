  "keyFindings": {
    "laboratory": [
      "Normal routine blood tests",
      "Possible mild anemia secondary to chronic disease"
    ],
    "imaging": [
      "Radiographs showing multiple osteochondromas",
      "Cone-shaped epiphyses on hand X-rays",
      "Scoliosis on spinal imaging"
    ],
    "genetic": [
      "Contiguous gene deletion involving TRPS1 and EXT1 genes on chromosome 8q24",
      "Confirmed by chromosomal microarray or FISH"
    ],
    "other": [
      "Developmental assessment showing intellectual disability",
      "Audiological evaluation for hearing impairment"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "trichorhinophalangeal-syndrome-type-i",
      "distinguishingFeatures": [
        "Absence of multiple exostoses",
        "Milder intellectual disability",
        "Different genetic deletion (TRPS1 gene only)"
      ]
    },
    {
      "diseaseId": "multiple-hereditary-exostoses",
      "distinguishingFeatures": [
        "Multiple exostoses without facial dysmorphism",
        "Normal intellect",
        "EXT1 or EXT2 gene mutations without TRPS1 involvement"
      ]
    }
  ],
  "redFlags": [
    "Rapidly enlarging or painful exostoses suggesting malignant transformation",
    "Severe developmental delay or regression",
    "Signs of spinal cord compression from exostoses"
  ],
