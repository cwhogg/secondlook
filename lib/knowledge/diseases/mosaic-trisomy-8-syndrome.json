  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for Mosaic Trisomy 8 Syndrome",
    "criteria": [
      {
        "id": "cytogenetic-confirmation",
        "description": "Detection of trisomy 8 mosaicism in peripheral blood or fibroblast karyotyping",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Presence of characteristic craniofacial anomalies including prominent forehead, deep-set eyes, broad nasal bridge, and prominent chin",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "musculoskeletal-anomalies",
        "description": "Presence of joint contractures, camptodactyly, and vertebral anomalies",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "developmental-delay",
        "description": "Mild to moderate intellectual disability or developmental delay",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "congenital-anomalies",
        "description": "Presence of congenital heart defects or renal malformations",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Cytogenetic confirmation of trisomy 8 mosaicism plus at least one major clinical feature",
    "notes": "Diagnosis requires cytogenetic testing due to variable phenotypic expression and mosaicism levels."
  },
