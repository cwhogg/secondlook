  "diagnosticCriteria": {
    "formalCriteriaName": "Pompe Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficient acid alpha-glucosidase enzyme activity in blood, fibroblasts, or muscle tissue",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-confirmation",
        "description": "Identification of pathogenic variants in the GAA gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Presence of characteristic clinical features such as progressive proximal muscle weakness and respiratory insufficiency",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing glycogen accumulation and vacuolar myopathy",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficient acid alpha-glucosidase enzyme activity plus either pathogenic GAA gene variants or characteristic clinical features",
    "notes": "Early diagnosis is critical for treatment initiation; newborn screening is available in some regions."
  },
