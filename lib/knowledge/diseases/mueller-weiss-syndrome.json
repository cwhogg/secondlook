  "diagnosticCriteria": {
    "formalCriteriaName": "Mueller-Weiss Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "chronic-midfoot-pain",
        "description": "Chronic midfoot pain localized to the dorsal and medial aspect of the foot",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "navicular-bone-sclerosis",
        "description": "Radiographic evidence of navicular bone sclerosis and fragmentation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "navicular-bone-deformity",
        "description": "Radiographic deformity including collapse or compression of the navicular bone",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-trauma",
        "description": "No history of acute trauma to the foot",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "progressive-foot-deformity",
        "description": "Progressive foot deformity with medial arch collapse",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of chronic midfoot pain with radiographic evidence of navicular sclerosis and deformity",
    "notes": "Diagnosis is primarily clinical supported by characteristic imaging findings; exclusion of other causes of navicular pathology is essential."
  },
