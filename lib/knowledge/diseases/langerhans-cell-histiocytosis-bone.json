  "diagnosticCriteria": {
    "formalCriteriaName": "Langerhans Cell Histiocytosis Diagnostic Criteria",
    "criteria": [
      {
        "id": "histopathology",
        "description": "Presence of clonal Langerhans cells with characteristic Birbeck granules on electron microscopy or CD1a/S100 positivity on immunohistochemistry",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "radiologic-bone-lesions",
        "description": "Radiographic evidence of lytic bone lesions with well-defined punched-out appearance",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-presentation",
        "description": "Localized bone pain or swelling consistent with LCH bone involvement",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Histopathologic confirmation of Langerhans cells plus radiologic evidence of bone lesions",
    "notes": "Diagnosis requires biopsy with immunohistochemical confirmation; clinical and radiologic findings support diagnosis."
  },
