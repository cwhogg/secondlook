  "diagnosticCriteria": {
    "formalCriteriaName": "RegiSCAR Diagnostic Criteria for Toxic Epidermal Necrolysis",
    "criteria": [
      {
        "id": "skin-detachment",
        "description": "Epidermal detachment involving >30% of body surface area",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "mucosal-involvement",
        "description": "Involvement of at least two mucous membranes (oral, ocular, genital)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathology",
        "description": "Skin biopsy showing full-thickness epidermal necrosis with minimal dermal inflammation",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "drug-exposure",
        "description": "Recent exposure to high-risk medications within 1-3 weeks prior to onset",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of epidermal detachment >30% BSA, involvement of at least two mucous membranes, and supportive histopathology",
    "notes": "Diagnosis requires exclusion of other blistering disorders and confirmation by skin biopsy."
  },
