  "diagnosticCriteria": {
    "formalCriteriaName": "Sandhoff Disease Diagnostic Criteria",
    "criteria": [
      {
        "id": "enzyme-deficiency",
        "description": "Deficiency of both beta-hexosaminidase A and B enzyme activities in leukocytes or fibroblasts",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "clinical-features",
        "description": "Progressive neurodegeneration with motor regression, ataxia, and cognitive decline in juvenile age",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "genetic-testing",
        "description": "Identification of pathogenic biallelic mutations in the HEXB gene",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "neuroimaging",
        "description": "MRI showing cerebral and cerebellar atrophy",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "cherry-red-spot",
        "description": "Presence of cherry-red spot in the macula on ophthalmological exam",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Deficiency of beta-hexosaminidase A and B enzyme activities plus compatible clinical features and/or biallelic HEXB mutations",
    "notes": "Enzyme assay and genetic testing are essential for definitive diagnosis."
  },
