      {
        "id": "mucocutaneous-pigmentation",
        "description": "Presence of mucocutaneous melanin pigmentation on lips, buccal mucosa, fingers, or toes",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "hamartomatous-polyps",
        "description": "Multiple hamartomatous polyps in the gastrointestinal tract confirmed by histology",
        "category": "major",
        "requiredForDiagnosis": false
      },
      {
        "id": "family-history",
        "description": "Family history of Peutz-Jeghers syndrome in a first-degree relative",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of any two of the following: characteristic mucocutaneous pigmentation, multiple hamartomatous gastrointestinal polyps, or a family history of Peutz-Jeghers syndrome",
    "notes": "Genetic testing for STK11 mutations can support diagnosis but is not mandatory"
  },
