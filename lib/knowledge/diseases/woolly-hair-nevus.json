  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical diagnostic criteria for Woolly Hair Nevus",
    "criteria": [
      {
        "id": "localized-woolly-hair",
        "description": "Presence of a localized patch of tightly curled, fine, and hypopigmented hair differing from surrounding scalp hair",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "absence-of-systemic-involvement",
        "description": "No evidence of systemic or syndromic associations such as cardiomyopathy or keratoderma",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "histopathological-confirmation",
        "description": "Histopathology showing abnormal hair shaft morphology consistent with woolly hair",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "early-childhood-onset",
        "description": "Onset of localized woolly hair patch in infancy or early childhood",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of localized woolly hair patch with exclusion of systemic involvement",
    "notes": "Diagnosis is primarily clinical supported by histopathology; genetic testing is not routinely performed."
  },
