  "diagnosticCriteria": {
    "formalCriteriaName": "Ulrich Congenital Muscular Dystrophy Diagnostic Criteria",
    "criteria": [
      {
        "id": "muscle-weakness",
        "description": "Congenital onset of generalized muscle weakness",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "joint-contractures",
        "description": "Presence of multiple joint contractures, especially distal joints",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "collagen-vi-deficiency",
        "description": "Deficiency or mutation in collagen VI genes (COL6A1, COL6A2, COL6A3)",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "muscle-biopsy",
        "description": "Muscle biopsy showing dystrophic changes with collagen VI deficiency",
        "category": "supportive",
        "requiredForDiagnosis": false
      },
      {
        "id": "respiratory-insufficiency",
        "description": "Early onset respiratory insufficiency",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of congenital muscle weakness and joint contractures with confirmed collagen VI gene mutation or deficiency",
    "notes": "Genetic testing is critical for definitive diagnosis."
  },
