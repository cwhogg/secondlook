  "diagnosticCriteria": {
    "formalCriteriaName": "Cardiospondylocarpofacial Syndrome Diagnostic Criteria",
    "criteria": [
      {
        "id": "cardiac-anomalies",
        "description": "Presence of congenital cardiac defects such as atrial septal defect or ventricular septal defect",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "vertebral-malformations",
        "description": "Spondylocarpal dysplasia characterized by vertebral segmentation defects and carpal bone abnormalities",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "distinctive-facial-features",
        "description": "Characteristic facial dysmorphisms including cleft palate, hypertelorism, and broad nasal bridge",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "growth-retardation",
        "description": "Postnatal growth retardation or short stature",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "hearing-loss",
        "description": "Sensorineural or conductive hearing loss",
        "category": "supportive",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Presence of all three major criteria: congenital cardiac defects, vertebral and carpal bone malformations, and distinctive facial features",
    "notes": "Genetic testing for MAP3K7 mutations can support diagnosis"
  },
