  "diagnosticCriteria": {
    "formalCriteriaName": "Clinical and Cytogenetic Diagnostic Criteria for 49,XXXXY Syndrome",
    "criteria": [
      {
        "id": "chromosomal-abnormality",
        "description": "Presence of 49,XXXXY karyotype confirmed by chromosomal analysis",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "hypogonadism",
        "description": "Clinical evidence of hypergonadotropic hypogonadism with small testes and low testosterone",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "developmental-delay",
        "description": "Global developmental delay including speech and motor delays",
        "category": "major",
        "requiredForDiagnosis": true
      },
      {
        "id": "facial-dysmorphism",
        "description": "Characteristic facial features such as hypertelorism, upslanting palpebral fissures, and flat nasal bridge",
        "category": "minor",
        "requiredForDiagnosis": false
      },
      {
        "id": "skeletal-abnormalities",
        "description": "Presence of radioulnar synostosis or other skeletal anomalies",
        "category": "minor",
        "requiredForDiagnosis": false
      }
    ],
    "minimumForDiagnosis": "Confirmed 49,XXXXY karyotype plus clinical features including hypogonadism and developmental delay",
    "notes": "Diagnosis is primarily confirmed by chromosomal analysis; clinical features support the diagnosis."
  },
