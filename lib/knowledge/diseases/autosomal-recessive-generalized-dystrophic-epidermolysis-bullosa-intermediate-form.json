  "keyFindings": {
    "laboratory": [
      "Anemia of chronic disease or iron deficiency anemia",
      "Elevated inflammatory markers during wound infection"
    ],
    "imaging": [
      "Barium swallow showing esophageal strictures",
      "X-ray or MRI showing pseudosyndactyly and contractures"
    ],
    "genetic": [
      "COL7A1 (causative, loss-of-function)",
      "Autosomal recessive inheritance"
    ],
    "other": [
      "Immunofluorescence mapping showing reduced or absent type VII collagen",
      "Electron microscopy demonstrating sublamina densa cleavage"
    ]
  },
  "differentialDiagnoses": [
    {
      "diseaseId": "dominant-dystrophic-epidermolysis-bullosa",
      "distinguishingFeatures": [
        "Autosomal dominant inheritance pattern",
        "Less severe scarring and blistering",
        "Different COL7A1 mutations"
      ]
    },
    {
      "diseaseId": "junctional-epidermolysis-bullosa",
      "distinguishingFeatures": [
        "Blistering occurs within lamina lucida",
        "Mutations in genes such as LAMB3, LAMC2",
        "Usually more severe mucosal involvement"
      ]
    }
  ],
  "redFlags": [
    "Rapidly enlarging non-healing ulcer in chronic wound (possible squamous cell carcinoma)",
    "Severe dysphagia with weight loss indicating esophageal stricture",
    "Signs of systemic infection in chronic wounds"
